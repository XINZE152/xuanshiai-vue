import { PORTRAIT_CHART_THEME as T } from '@/utils/portrait-chart-theme.uts'
import type { PortraitChartDimension } from '@/utils/portrait-report-data.uts'
import type { PortraitMetricPoint } from '@/api/ai-profile-metrics.uts'

export async function createPortraitCanvas(id: string, component: any, width: number, height: number): Promise<any> {
	const context: any = await new Promise<any>((resolve, reject) => {
		uni.createCanvasContextAsync({ id: id, component: component, success: resolve, fail: reject })
	})
	const ctx = context.getContext('2d')
	if (ctx == null) throw new Error('无法读取画布，请重试')
	ctx.canvas.width = width * 2
	ctx.canvas.height = height * 2
	ctx.scale(2, 2)
	ctx.fillStyle = T.paper
	ctx.fillRect(0, 0, width, height)
	ctx.lineWidth = 1
	ctx.font = '12px sans-serif'
	ctx.textBaseline = 'middle'
	ctx.lineJoin = 'round'
	ctx.lineCap = 'round'
	return ctx
}
function dot(ctx: any, x: number, y: number, color: string = T.accent2) {
	ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI * 2); ctx.fillStyle = color; ctx.fill(); ctx.strokeStyle = T.paper; ctx.lineWidth = 2; ctx.stroke()
}
function axis(ctx: any, x: number, y: number, radius: number, index: number): any {
	const angle = -Math.PI / 2 + index * Math.PI / 3
	return { x: x + Math.cos(angle) * radius, y: y + Math.sin(angle) * radius }
}
export function drawPortraitRadar(ctx: any, width: number, dimensions: PortraitChartDimension[]) {
	const x = width / 2, y = 116, radius = Math.min(80, width / 2 - 46)
	for (const scale of [0.5, 1]) {
		ctx.beginPath()
		for (let i = 0; i < 6; i++) { const point = axis(ctx, x, y, radius * scale, i); if (i == 0) ctx.moveTo(point.x, point.y); else ctx.lineTo(point.x, point.y) }
		ctx.closePath(); ctx.strokeStyle = T.line; ctx.lineWidth = 1; ctx.stroke()
	}
	for (let i = 0; i < 6; i++) {
		const end = axis(ctx, x, y, radius, i)
		ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(end.x, end.y); ctx.strokeStyle = T.line; ctx.lineWidth = 1; ctx.stroke()
		const label = axis(ctx, x, y, radius + 18, i)
		ctx.fillStyle = T.ink2; ctx.textAlign = 'center'; ctx.fillText(String(i + 1), label.x, label.y)
	}
	const complete = dimensions.length == 6 && dimensions.every((dim: PortraitChartDimension): boolean => dim.percent != null)
	if (complete) {
		ctx.beginPath()
		for (let i = 0; i < 6; i++) {
			const p = axis(ctx, x, y, radius * Number(dimensions[i].percent) / 100, i)
			if (i == 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y)
		}
		ctx.closePath(); ctx.strokeStyle = T.accent2; ctx.lineWidth = 2; ctx.stroke()
	}
	for (let i = 0; i < dimensions.length; i++) {
		const percent = dimensions[i].percent
		if (percent == null) continue
		const color = percent == 100 ? T.accent2 : (percent == 50 ? T.soft : T.ink2)
		const p = axis(ctx, x, y, radius * percent / 100, i); dot(ctx, p.x, p.y, color)
	}
	ctx.fillStyle = T.ink2; ctx.textAlign = 'center'; ctx.fillText('外圈 100% · 内圈 50% · 中心 0%', x, 235)
}
export function drawPortraitRing(ctx: any, width: number, percent: number | null) {
	if (percent == null) return
	const x = width / 2, y = 100, r = 62
	ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.strokeStyle = T.line; ctx.lineWidth = 10; ctx.stroke()
	if (percent > 0) { ctx.beginPath(); ctx.arc(x, y, r, -Math.PI / 2, -Math.PI / 2 + percent / 100 * Math.PI * 2); ctx.strokeStyle = T.accent2; ctx.lineWidth = 10; ctx.stroke() }
	ctx.fillStyle = T.ink; ctx.font = '28px sans-serif'; ctx.textAlign = 'center'; ctx.fillText(percent.toFixed(1) + '%', x, y)
	ctx.font = '12px sans-serif'; ctx.fillStyle = T.ink2; ctx.fillText('六维理解覆盖度', x, y + 28)
}
export function portraitLineX(index: number, count: number, width: number): number {
	return count <= 1 ? width / 2 : 36 + index * (width - 56) / (count - 1)
}
export function drawPortraitLine(ctx: any, width: number, series: PortraitMetricPoint[], selected: number = -1) {
	for (const tick of [0, 50, 100]) {
		const y = 176 - tick * 1.4
		ctx.strokeStyle = T.line; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(36, y); ctx.lineTo(width - 20, y); ctx.stroke()
		ctx.fillStyle = T.ink2; ctx.textAlign = 'left'; ctx.fillText(String(tick), 3, y)
	}
	let drawing = false
	ctx.beginPath()
	for (let i = 0; i < series.length; i++) {
		const percent = series[i].overall_percent
		if (percent == null) { drawing = false; continue }
		const x = portraitLineX(i, series.length, width), y = 176 - percent * 1.4
		if (drawing) ctx.lineTo(x, y); else ctx.moveTo(x, y)
		drawing = true
	}
	ctx.strokeStyle = T.accent2; ctx.lineWidth = 2; ctx.stroke()
	for (let i = 0; i < series.length; i++) {
		const percent = series[i].overall_percent
		if (percent != null) dot(ctx, portraitLineX(i, series.length, width), 176 - percent * 1.4)
	}
	if (selected >= 0 && selected < series.length) {
		const x = portraitLineX(selected, series.length, width)
		ctx.beginPath(); ctx.moveTo(x, 26); ctx.lineTo(x, 176); ctx.lineWidth = 1; ctx.strokeStyle = T.ink2; ctx.stroke()
	}
	if (series.length > 0) {
		ctx.fillStyle = T.ink2; ctx.textAlign = 'left'; ctx.fillText('v' + series[0].revision_no, 36, 200)
		ctx.textAlign = 'right'; ctx.fillText('v' + series[series.length - 1].revision_no, width - 20, 200)
	}
}
