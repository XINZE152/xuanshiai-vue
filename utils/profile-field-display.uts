// 画像结构化字段的裸值 → 中文展示映射（#18）。
// 后端旅程 master 草稿的 display_value 直接下发编码值（如 city_code='330100'、
// education_level=4、income_band=2、marriage_status='single'、occupation_group=
// 'technology'），前端确认卡与协商中心若原样展示会漏裸码。这里集中一份与后端
// 冻结字典（app/schemas/ai_profile.py）及 PRODUCT.md 收入档位口径对齐的词典，
// 供展示层兜底。枚举值一旦后端调整，需同步此处。
import locationJson from '@/data/location.json'

/** 婚姻状态：后端 frozenset({single,divorced,widowed}) */
const MARRIAGE_STATUS_LABELS: Map<string, string> = new Map()
MARRIAGE_STATUS_LABELS.set('single', '未婚')
MARRIAGE_STATUS_LABELS.set('divorced', '离异')
MARRIAGE_STATUS_LABELS.set('widowed', '丧偶')

/**
 * 学历（**AI 画像刻度**，1-6）：与后端 app/schemas/ai_profile.py 的抽取契约一致
 * —— `_RANGE_FIELDS` 里 education_level 区间 (1,6)，注释明写「1=初中及以下…6=博士」。
 * 仅用于 ai_profile 旅程字段（master 草稿 / 结果页）的展示，**不要**拿它渲染 user_profile。
 * 用户资料口径见下面的 USER_EDUCATION_LABELS。
 */
const EDUCATION_LEVEL_LABELS: Map<string, string> = new Map()
EDUCATION_LEVEL_LABELS.set('1', '初中及以下')
EDUCATION_LEVEL_LABELS.set('2', '高中/中专')
EDUCATION_LEVEL_LABELS.set('3', '大专')
EDUCATION_LEVEL_LABELS.set('4', '本科')
EDUCATION_LEVEL_LABELS.set('5', '硕士')
EDUCATION_LEVEL_LABELS.set('6', '博士')

/**
 * 学历（**用户资料刻度**，1-5）：与后端 app/services/discovery.py 的
 * `_EDUCATION_LABELS` 一致 —— 1 高中及以下 / 2 大专 / 3 本科 / 4 硕士 / 5 博士。
 * 这是首页、详情、编辑页的唯一字典；后端 schemas/auth.py 放行到 8，6-8 为未启用档位，按「博士」兜底。
 */
const USER_EDUCATION_LABELS: Map<string, string> = new Map()
USER_EDUCATION_LABELS.set('1', '高中及以下')
USER_EDUCATION_LABELS.set('2', '大专')
USER_EDUCATION_LABELS.set('3', '本科')
USER_EDUCATION_LABELS.set('4', '硕士')
USER_EDUCATION_LABELS.set('5', '博士')
USER_EDUCATION_LABELS.set('6', '博士')
USER_EDUCATION_LABELS.set('7', '博士')
USER_EDUCATION_LABELS.set('8', '博士')

/** 用户资料学历选择项（index = 存储值，0 为未选择）。编辑页 picker 必须复用它，禁止再写字面量。 */
export const USER_EDUCATION_OPTIONS: string[] = ['未选择', '高中及以下', '大专', '本科', '硕士', '博士']

/** 用户资料学历裸值 → 展示文案。空值「未填写」；非数字原样返回；6-8 按「博士」兜底。 */
export function educationLabel(raw: any): string {
	if (raw == null) return '未填写'
	const text = ('' + raw).trim()
	if (text == '') return '未填写'
	const level = Number(text)
	if (!isNaN(level)) {
		const mapped = mapLookup(USER_EDUCATION_LABELS, text)
		return mapped != '' ? mapped : '未填写'
	}
	return text
}

/** 收入档位：PRODUCT.md 2026-09-03 口径，个人月收入、左闭右开、0-6 */
const INCOME_BAND_LABELS: Map<string, string> = new Map()
INCOME_BAND_LABELS.set('0', '无收入/暂不固定')
INCOME_BAND_LABELS.set('1', '5千以下')
INCOME_BAND_LABELS.set('2', '5千-1万')
INCOME_BAND_LABELS.set('3', '1万-2万')
INCOME_BAND_LABELS.set('4', '2万-3万5')
INCOME_BAND_LABELS.set('5', '3万5-5万')
INCOME_BAND_LABELS.set('6', '5万以上')

/** 职业大类：后端 frozenset({technology,education,healthcare,finance,public_service,other}) */
const OCCUPATION_GROUP_LABELS: Map<string, string> = new Map()
OCCUPATION_GROUP_LABELS.set('technology', '互联网/技术')
OCCUPATION_GROUP_LABELS.set('education', '教育')
OCCUPATION_GROUP_LABELS.set('healthcare', '医疗')
OCCUPATION_GROUP_LABELS.set('finance', '金融')
OCCUPATION_GROUP_LABELS.set('public_service', '公职')
OCCUPATION_GROUP_LABELS.set('other', '其他')

/** 关系期待：后端 frozenset({marriage,dating,friendship}) */
const RELATIONSHIP_GOAL_LABELS: Map<string, string> = new Map()
RELATIONSHIP_GOAL_LABELS.set('marriage', '以结婚为目标')
RELATIONSHIP_GOAL_LABELS.set('dating', '认真交往')
RELATIONSHIP_GOAL_LABELS.set('friendship', '先做朋友')

function mapLookup(dict: Map<string, string>, raw: any): string {
	const key = '' + raw
	const hit = dict.get(key)
	return hit != null ? hit : ''
}

/** 城市码 → 城市名。匹配市/区/省级码；直辖市「市辖区」回落省名。 */
export function cityNameByCode(code: any): string {
	const target = '' + code
	if (target == '') return ''
	const provinces = Array.isArray(locationJson) ? locationJson as any[] : []
	for (const province of provinces) {
		const cities = Array.isArray(province.city) ? province.city as any[] : []
		for (const city of cities) {
			if ('' + city.code == target) {
				const cityName = '' + city.name
				return cityName == '市辖区' ? ('' + province.name) : cityName
			}
			const areas = Array.isArray(city.area) ? city.area as any[] : []
			for (const area of areas) {
				if ('' + area.code == target) return '' + area.name
			}
		}
		if ('' + province.code == target) return '' + province.name
	}
	return ''
}

/**
 * 省/市/区编码 → "省 市 区" 展示串。
 * 任一编码查不到时只退化到已有层级，**绝不把裸编码当名字返回**——
 * 首页名片曾直接回显 city_code（如 110100），与编辑页的"北京市 市辖区 东城区"对不上。
 */
export function locationDisplayByCodes(provinceCode: any, cityCode: any, districtCode: any): string {
	const provinceName = cityNameByCode(provinceCode)
	const cityName = cityNameByCode(cityCode)
	const districtName = cityNameByCode(districtCode)
	const parts: string[] = []
	if (provinceName != '') parts.push(provinceName)
	if (cityName != '' && cityName != provinceName) parts.push(cityName)
	if (districtName != '' && districtName != cityName) parts.push(districtName)
	return parts.join(' ')
}

/**
 * 收入数值 → 展示串（全站唯一口径）。
 * 登录问卷存的是数值（50000/150000/400000/750000/1000000），必须反查回枚举文案；
 * 首页曾单独实现成 "15w"，与详情页 "10-20w"、编辑页枚举三处不一致，这里统一。
 */
export function incomeDisplayText(raw: any): string {
	if (raw == null) return '未填写'
	const text = ('' + raw).trim()
	if (text == '') return '未填写'
	const amount = Number(text)
	if (isNaN(amount)) return text.replace('万', 'w')
	if (amount <= 0) return '未填写'
	if (amount == 50000) return '小于10w'
	if (amount == 150000) return '10-20w'
	if (amount == 400000) return '30-50w'
	if (amount == 750000) return '50-100w'
	if (amount >= 1000000) return '100w以上'
	const wan = Math.round(amount / 1000) / 10
	return (wan % 1 == 0 ? '' + Math.round(wan) : '' + wan) + 'w'
}

/** 标签数组 → 顿号连接（值多为中文标签本身，直接拼接）。 */function tagsText(value: any): string {
	if (Array.isArray(value)) {
		const parts = value as any[]
		const texts: string[] = []
		for (const item of parts) {
			const text = '' + item
			if (text != '') texts.push(text)
		}
		return texts.join('、')
	}
	return '' + value
}

/**
 * 把画像字段的裸值翻译成中文展示串。
 * 优先返回映射结果；无映射时回落服务端 display_value，再回落原值字符串。
 * 数组（标签/多选）统一顿号连接。
 */
export function displayFieldValue(fieldKey: string, value: any, displayValue?: string): string {
	if (value == null) {
		return displayValue != null && displayValue != '' ? displayValue : ''
	}
	let translated = ''
	switch (fieldKey) {
		case 'marriage_status':
			translated = mapLookup(MARRIAGE_STATUS_LABELS, value)
			break
		case 'education_level':
			translated = mapLookup(EDUCATION_LEVEL_LABELS, value)
			break
		case 'income_band':
			translated = mapLookup(INCOME_BAND_LABELS, value)
			break
		case 'occupation_group':
			translated = mapLookup(OCCUPATION_GROUP_LABELS, value)
			break
		case 'relationship_goal':
			translated = mapLookup(RELATIONSHIP_GOAL_LABELS, value)
			break
		case 'city_code':
			translated = cityNameByCode(value)
			break
		case 'age':
			translated = '' + value + '岁'
			break
		case 'height_cm':
			translated = '' + value + 'cm'
			break
		case 'interest_tags':
		case 'lifestyle_tags':
			translated = tagsText(value)
			break
		default:
			translated = ''
	}
	if (translated != '') return translated
	if (displayValue != null && displayValue != '') return displayValue
	return Array.isArray(value) ? tagsText(value) : '' + value
}
