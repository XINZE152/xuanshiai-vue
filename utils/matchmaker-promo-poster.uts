/**
 * 红娘推广海报：把红娘头像、称呼与平台首页二维码画成一张可保存的竖版海报。
 * 二维码内容固定为平台首页地址，点阵离线生成后内嵌：字节模式 + 纠错等级 M + 自动版本（两串都是 25x25），
 * 用 node_modules/qrcode-terminal 内置的 Kazuhiko Arase 编码器生成，再用 qrcode-reader 独立回读校验过内容。
 * 换域名时需按同样参数重新生成 HOME_QR_* 两串，运行期只按格子画方块，不在小程序里塞 QR 编码器。
 */

import { API_BASE_URL, resolveMediaUrl } from '@/api/config.uts'

const TEST_HOME_URL = 'https://xhztest.xyz'
const PROD_HOME_URL = 'https://www.xuanshiai.com'

/** 海报二维码指向的平台首页：release 指向正式域名，其余环境统一指向可访问的测试域名。 */
export const PLATFORM_HOME_URL = API_BASE_URL == PROD_HOME_URL ? PROD_HOME_URL : TEST_HOME_URL

export interface PromoPosterData {
  name: string
  avatar: string
}

export interface PromoPosterStyle {
  key: string
  name: string
  topFrom: string
  topTo: string
  glow: string
  band: string
  bandDeep: string
  ring: string
  heart: string
  heartSoft: string
  nameColor: string
  sloganColor: string
  sloganSoft: string
  qrBorder: string
  hintText: string
}

