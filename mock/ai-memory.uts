/**
 * Memory Kernel v1 / Phase 3 的端侧 Mock。
 *
 * 这里刻意不使用 uni storage：记忆文本属于用户数据，Mock 只在当前运行时
 * 保留状态，避免把真实记忆误写入本地持久化空间。状态机与真实接口保持同一
 * 个边界：双主体、乐观锁 revision、幂等重放、纠正新 Claim、删除墓碑以及
 * 授权撤回历史。
 */

function clone(value: any): any {
	if (value == null) return value
	return JSON.parse(JSON.stringify(value))
}

function fail(code: string, message: string): void {
	const error: any = new Error(code + ': ' + message)
	error.code = code
	error.status = code == 'MEMORY_REVISION_CONFLICT' || code == 'MEMORY_IDEMPOTENCY_CONFLICT' ? 409 : (code == 'MEMORY_CLAIM_NOT_FOUND' || code == 'MEMORY_GRANT_NOT_FOUND' ? 404 : 422)
	throw error
}

function isoNow(): string {
	return new Date().toISOString().replace('Z', '')
}

