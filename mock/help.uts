function buildMessageId(): string {
  return 'ai-' + Date.now()
}

export function getMockAiSupportReply(content: string): any {
  const question = (content != null ? '' + content : '').toLowerCase()
  let reply = '我可以帮你了解平台功能、举报入口和安全设置。你可以描述遇到的问题，我会给出操作建议。'
  if (question.indexOf('举报') >= 0 || question.indexOf('违规') >= 0) {
    reply = '如果需要举报，请前往相关内容或用户卡片上方的举报入口提交。AI 客服只提供操作指引，不会替你提交举报。'
  } else if (question.indexOf('拉黑') >= 0 || question.indexOf('屏蔽') >= 0) {
    reply = '你可以在相关用户卡片或资料页的操作菜单中选择拉黑；之后也可以在安全中心查看黑名单并解除拉黑。'
  } else if (question.indexOf('诈骗') >= 0 || question.indexOf('借钱') >= 0 || question.indexOf('转账') >= 0) {
    reply = '请先停止转账或继续提供隐私信息，保留必要记录，并通过相关内容或用户卡片上方的举报入口反馈；涉及现实人身或财产风险时，请及时联系当地警方。'
  }
  return { id: buildMessageId(), role: 'assistant', content: reply }
}

export function submitMockFeedback(content: string): any {
  return { success: true, data: { submitted: true, content: content } }
}
