  introduction: '29 岁 · 南京 · 产品经理',
  remainApply: 2,
  tasksPending: 2
}

const MOCK_ME_MBTI_TYPES: string[] = [
  'ENFJ', 'ENFP', 'ENTJ', 'ENTP',
  'ESFJ', 'ESFP', 'ESTJ', 'ESTP',
  'INFJ', 'INFP', 'INTJ', 'INTP',
  'ISFJ', 'ISFP', 'ISTJ', 'ISTP'
]

const MOCK_ME_MBTI_STORAGE_PREFIX = 'xsa_mock_me_mbti_profile_v1:'
const mockMeMbtiProfilesBySubject: any = {}

function cloneMockMeValue(value: any): any {
  if (value == null) return value
  return JSON.parse(JSON.stringify(value))
}

function normalizeMockMeSubject(subjectId: string): string {
  return subjectId != null ? String(subjectId).trim() : ''
}

function readMockMeMbtiSource(subjectId: string): any {
  const key = normalizeMockMeSubject(subjectId)
  if (key == '') return null
  if (mockMeMbtiProfilesBySubject[key] != null) {
    return cloneMockMeValue(mockMeMbtiProfilesBySubject[key])
  }
  try {
    const stored = uni.getStorageSync(MOCK_ME_MBTI_STORAGE_PREFIX + encodeURIComponent(key))
    if (stored != null && typeof stored == 'object') {
      mockMeMbtiProfilesBySubject[key] = cloneMockMeValue(stored)
      return cloneMockMeValue(stored)
    }
  } catch (error) {}
  return null
}

function writeMockMeMbtiSource(subjectId: string, profileSource: any): void {
  const key = normalizeMockMeSubject(subjectId)
  if (key == '') throw new Error('MOCK_PROFILE_SUBJECT_REQUIRED: 缺少资料所属账号')
  const storageKey = MOCK_ME_MBTI_STORAGE_PREFIX + encodeURIComponent(key)
  if (profileSource == null) {
    delete mockMeMbtiProfilesBySubject[key]
    try {
      uni.removeStorageSync(storageKey)
    } catch (error) {}
    return
  }
  const snapshot = cloneMockMeValue(profileSource)
  const previousSnapshot = mockMeMbtiProfilesBySubject[key] != null
    ? cloneMockMeValue(mockMeMbtiProfilesBySubject[key])
    : null
  mockMeMbtiProfilesBySubject[key] = snapshot
  try {
    uni.setStorageSync(storageKey, snapshot)
  } catch (error) {
    if (previousSnapshot != null) {
      mockMeMbtiProfilesBySubject[key] = previousSnapshot
    } else {
      delete mockMeMbtiProfilesBySubject[key]
    }
    throw error
  }
}

/** Return the visible Mock profile for one authenticated subject. */
export function getMockMeMbtiProfileData(subjectId: string = ''): any {
  const profile: any = cloneMockMeValue(mockMeProfile)
  const profileSource = readMockMeMbtiSource(subjectId)
  if (profileSource == null) {
    profile.mbti = ''
    profile.mbtiSource = null
    profile.mbtiProfileSource = null
    return profile
  }
  profile.mbti = profileSource.mbtiType
  profile.mbtiSource = profileSource.source
  profile.mbtiProfileSource = cloneMockMeValue(profileSource)
  return profile
}

/** 情感实验室写入“我的资料”的唯一 Mock 数据边界。 */
export function syncMockMeMbtiProfileData(profileSource: any, subjectId: string = ''): any {
  const key = normalizeMockMeSubject(subjectId)
  if (key == '') throw new Error('MOCK_PROFILE_SUBJECT_REQUIRED: 缺少资料所属账号')
  if (profileSource == null) {
    writeMockMeMbtiSource(key, null)
    return {
      mbti: '',
      mbtiSource: null,
      mbtiProfileSource: null
    }
  }

  const mbtiType = profileSource.mbtiType != null ? '' + profileSource.mbtiType : ''
  const source = profileSource.source != null ? '' + profileSource.source : ''
  if (MOCK_ME_MBTI_TYPES.indexOf(mbtiType) < 0) {
    throw new Error('MBTI_TYPE_INVALID: MBTI 类型无效')
  }
  if (source != 'assessment' && source != 'self_reported') {
    throw new Error('PROFILE_SOURCE_INVALID: 资料来源无效')
  }

  writeMockMeMbtiSource(key, profileSource)
  return {
    mbti: mbtiType,
    mbtiSource: source,
    mbtiProfileSource: cloneMockMeValue(profileSource)
  }
}
