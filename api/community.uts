export async function getThreadedComments(dynamicId: number, cursor: string = '', pageSize: number = 20) {
  if (USE_MOCK) {
    const post = findDynamic(dynamicId)
    const all = post != null && post.comments != null ? post.comments as any[] : []
    const roots: any[] = []
    for (let i = 0; i < all.length; i++) {
      const row = all[i]
      if (row.replyTo == null && row.parent_id == null) {
        const root = mapComment(row)
        const previews: any[] = []
        for (let j = 0; j < all.length && previews.length < 3; j++) {
          const reply = all[j]
          if (reply.replyTo == row.id || reply.parent_id == row.id || reply.rootId == row.id) previews.push(mapComment(reply))
        }
        root.replies = previews
        root.replyCount = previews.length
        roots.push(root)
      }
    }
    return okRes({ items: roots.slice(0, pageSize), next_cursor: null, has_more: false })
  }
  const res = await request({ url: '/community/posts/' + dynamicId + '/comments/page', method: 'GET', data: { cursor: cursor == '' ? null : cursor, page_size: pageSize } })
  if (!res.success || res.data == null) return res
  const raw = res.data as any
  const rawItems = raw.items != null ? raw.items as any[] : []
  const items: any[] = []
  for (let i = 0; i < rawItems.length; i++) {
    const comment = mapComment(rawItems[i])
    const previews = rawItems[i].replies != null ? rawItems[i].replies as any[] : []
    for (let j = 0; j < previews.length; j++) comment.replies.push(mapComment(previews[j]))
    items.push(comment)
  }
  return okRes({ items, next_cursor: raw.next_cursor != null ? raw.next_cursor : null, has_more: raw.has_more == true })
}

export async function getCommentReplies(commentId: number, cursor: string = '', pageSize: number = 20) {
  if (USE_MOCK) return okRes({ items: [], next_cursor: null, has_more: false })
  const res = await request({ url: '/community/comments/' + commentId + '/replies', method: 'GET', data: { cursor: cursor == '' ? null : cursor, page_size: pageSize } })
  if (!res.success || res.data == null) return res
  const raw = res.data as any
  const rawItems = raw.items != null ? raw.items as any[] : []
  const items: any[] = []
  for (let i = 0; i < rawItems.length; i++) items.push(mapComment(rawItems[i]))
  return okRes({ items, next_cursor: raw.next_cursor != null ? raw.next_cursor : null, has_more: raw.has_more == true })
}
