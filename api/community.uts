export async function getCurrentCity() {
  if (USE_MOCK) {
    return request({
      url: '/community/city',
      cloudFunctionName: 'community',
      action: 'getCurrentCity',
      method: 'GET',
      mockData: mockCurrentCity
    })
  }

  const res = await request({
    url: '/community/city',
    method: 'GET'
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    name: raw != null && raw.name != null ? raw.name : '未设置',
    code: raw != null && raw.code != null ? raw.code : null
  })
}

/** Mock 同城偏好上次变更时间（ms）；对齐 BE 一周限改 */
		let mockCommunityCityUpdatedAt: number = 0
		const MOCK_CITY_COOLDOWN_MS: number = 7 * 24 * 60 * 60 * 1000

		/**
		 * 设置同城城市。code 可选；缺省时按 COMMUNITY_CITY_OPTIONS / 名称推断 6 位市码。
		 * 兼容旧调用 setCurrentCity(name)。Mock/真路径均拒空与「未设置」；一周内换城失败。
		 */
		export async function setCurrentCity(name: string, code: string = '') {
		  const cityName = normalizeCityName(name)
		  let cityCode = normalizeCityCode(code)
		  if (cityCode == '' && cityName != '') {
		    cityCode = cityCodeFromName(cityName)
		  }
		  if (USE_MOCK) {
		    if (cityName == '') {
		      return failRes('城市名称不能为空', 422)
		    }
		    const prevName = mockCurrentCity.name != null ? normalizeCityName(mockCurrentCity.name) : ''
		    const prevCode = mockCurrentCity.code != null ? normalizeCityCode(mockCurrentCity.code) : ''
		    const same =
		      prevName == cityName &&
		      (prevCode == cityCode || (prevCode == '' && cityCode == '') || prevCode == cityCode)
		    if (!same && mockCommunityCityUpdatedAt > 0) {
		      const elapsed = Date.now() - mockCommunityCityUpdatedAt
		      if (elapsed < MOCK_CITY_COOLDOWN_MS) {
		        return failRes('同城城市一周内仅可更换一次', 429)
		      }
		    }
		    if (!same || prevName == '') {
		      mockCurrentCity.name = cityName
		      if (cityCode != '') {
		        mockCurrentCity.code = cityCode
		      }
		      mockCommunityCityUpdatedAt = Date.now()
		    }
		    return request({
		      url: '/community/city/set',
		      cloudFunctionName: 'community',
		      action: 'setCurrentCity',
		      method: 'POST',
		      data: { name: cityName, code: cityCode },
		      mockData: { success: true, city: { name: mockCurrentCity.name, code: mockCurrentCity.code } }
		    })
		  }

		  if (cityName == '') {
		    return failRes('城市名称不能为空', 422)
		  }
		  const body: any = { name: cityName }
		  if (cityCode != '') {
		    body.code = cityCode
		  }
		  const res = await request({
		    url: '/community/city',
		    method: 'PUT',
		    data: body
		  })
		  if (!res.success) return res
		  const raw = res.data
		  return okRes({
		    success: true,
		    city: {
		      name: raw != null && raw.name != null ? raw.name : cityName,
		      code: raw != null && raw.code != null ? raw.code : (cityCode != '' ? cityCode : null)
		    }
		  })
		}


// ─── 媒体上传 / 纸飞机匿名会话 ───────────────────────────────

const mockPlaneConversations: any[] = []
const mockPlaneMessages: any = {}

function ensureMockPlaneConversation(conversationId: number, planeId: number, firstContent: string) {
  let found = false
  for (let i = 0; i < mockPlaneConversations.length; i++) {
    if (mockPlaneConversations[i].id == conversationId) {
      found = true
      mockPlaneConversations[i].lastMessage = firstContent
      mockPlaneConversations[i].unreadCount = 1
    }
  }
  if (!found) {
    mockPlaneConversations.unshift({
      id: conversationId,
      planeId: planeId,
      status: 1,
      lastMessage: firstContent,
      unreadCount: 1,
      peerLabel: '纸飞机主人',
      planeContent: ''
    })
  }
  const key = '' + conversationId
  if (mockPlaneMessages[key] == null) mockPlaneMessages[key] = []
  ;(mockPlaneMessages[key] as any[]).push({
    id: Date.now(),
    conversationId: conversationId,
    fromUserId: mockMeProfile.id,
    content: firstContent,
    type: 1,
    mediaUrl: '',
    voiceDurationSec: 0,
    mine: true,
    timeText: '刚刚'
  })
}

function paperPlaneTimeText(rawTime: any): string {
  const time = rawTime != null ? Number(rawTime) : 0
  if (time <= 0) return ''
  const diff = Math.max(0, Date.now() - time)
  const minute = Math.floor(diff / 60000)
  if (minute < 1) return '刚刚'
  if (minute < 60) return minute + ' 分钟前'
  const hour = Math.floor(minute / 60)
  if (hour < 24) return hour + ' 小时前'
  const day = Math.floor(hour / 24)
  if (day < 7) return day + ' 天前'
  return '更早'
}

function getPaperPlanePeerName(plane: any): string {
  if (plane != null && plane.name != null && ('' + plane.name).length > 0) {
    return '' + plane.name
  }
  if (plane != null && plane.gender == '男') return '一位认真生活的男生'
  return '一位认真生活的女生'
}

/** 回复纸飞机后，同步到「我的纸飞机」消息列表（PR 前端会话卡）。 */
function upsertPaperPlaneConversation(plane: any, content: string, conversationId: number = 0) {
  const list = mockPaperPlaneConversations as any[]
  let conversation: any = null
  for (let i = 0; i < list.length; i++) {
    if (list[i].planeId == plane.id) {
      conversation = list[i]
      break
    }
  }

  if (conversation == null) {
    conversation = {
      id: conversationId > 0 ? conversationId : Date.now(),
      planeId: plane.id,
      userId: plane.userId != null ? plane.userId : 0,
      name: getPaperPlanePeerName(plane),
      avatar: '/static/portraits/profile-woman-alt.webp',
      planeType: plane.type == 'voice' || plane.voiceUrl != null ? '语音纸飞机' : '文字纸飞机',
      lastMessage: '',
      time: Date.now(),
      timeText: '刚刚',
      unreadCount: 0
    }
    list.unshift(conversation)
  }

  if (conversationId > 0) conversation.id = conversationId
  conversation.lastMessage = '我：' + content
  conversation.time = Date.now()
  conversation.timeText = '刚刚'
  conversation.unreadCount = 0
}

function mapPlaneConversation(row: any): any {
  if (row == null) return null
  return {
    id: row.id,
    planeId: row.plane_id != null ? row.plane_id : row.planeId,
    ownerId: row.owner_id != null ? row.owner_id : row.ownerId,
    replierId: row.replier_id != null ? row.replier_id : row.replierId,
    status: row.status != null ? row.status : 1,
    lastMessage: row.last_message != null ? row.last_message : (row.lastMessage != null ? row.lastMessage : ''),
    lastMessageAt: row.last_message_at != null ? row.last_message_at : null,
    unreadCount: row.unread_count != null ? row.unread_count : (row.unreadCount != null ? row.unreadCount : 0),
    peerLabel: getPaperPlaneConversationPeerName(row),
    planeContent: row.plane_content != null ? row.plane_content : (row.planeContent != null ? row.planeContent : ''),
    createdAt: row.created_at != null ? row.created_at : null
  }
}

function mapPlaneMessage(row: any, myId: number = 0): any {
  if (row == null) return null
  const fromId = row.from_user_id != null ? row.from_user_id : row.fromUserId
  return {
    id: row.id,
    conversationId: row.conversation_id != null ? row.conversation_id : row.conversationId,
    fromUserId: fromId,
    content: row.content != null ? row.content : '',
    type: row.type != null ? row.type : 1,
    mediaUrl: row.media_url != null ? resolveMediaUrl(row.media_url) : (row.mediaUrl != null ? resolveMediaUrl(row.mediaUrl) : ''),
    voiceDurationSec: row.voice_duration_sec != null ? row.voice_duration_sec : (row.voiceDurationSec != null ? row.voiceDurationSec : 0),
    mine: row.mine === true || (myId > 0 && fromId == myId),
    timeText: row.created_at != null ? timeTextFrom(row.created_at) : (row.timeText != null ? row.timeText : '')
  }
}

function getPaperPlaneConversationPeerName(row: any): string {
  if (row == null) return '匿名用户'
  const candidates = [
    row.peer_label,
    row.peerLabel,
    row.peer_name,
    row.peerName,
    row.sender_name,
    row.senderName
  ]
  for (let i = 0; i < candidates.length; i++) {
    if (candidates[i] != null && ('' + candidates[i]).trim() != '') return '' + candidates[i]
  }
  return '匿名用户'
}

/** 对真实接口返回的同一会话按 id 覆盖，避免轮询或分页重复。 */
function upsertRemotePaperPlaneConversation(list: any[], row: any) {
  if (row == null) return
  const id = row.id != null ? row.id : 0
  for (let i = 0; i < list.length; i++) {
    const currentId = list[i] != null && list[i].id != null ? list[i].id : 0
    if (id != 0 && currentId == id) {
      list[i] = row
      return
    }
  }
  list.push(row)
}

function extractUploadDetail(data: any): string {
  if (data == null) return '上传失败'
  if (typeof data === 'string') return data
  if (data.detail != null) {
    if (typeof data.detail === 'string') return '' + data.detail
    if (Array.isArray(data.detail) && data.detail.length > 0) {
      const first = data.detail[0]
      if (first != null && first.msg != null) return '' + first.msg
      return JSON.stringify(data.detail)
    }
  }
  if (data.message != null) return '' + data.message
  return '上传失败'
}

function mapCommunityMedia(row: any): any {
  if (row == null) return null
  return {
    id: row.id != null ? row.id : 0,
    purpose: row.purpose != null ? row.purpose : '',
    mediaType: row.media_type != null ? row.media_type : (row.mediaType != null ? row.mediaType : ''),
    url: row.url != null ? resolveMediaUrl(row.url) : '',
    thumbnailUrl: row.thumbnail_url != null ? resolveMediaUrl(row.thumbnail_url) : (row.thumbnailUrl != null ? resolveMediaUrl(row.thumbnailUrl) : ''),
    fileSize: row.file_size != null ? row.file_size : (row.fileSize != null ? row.fileSize : 0),
    durationSeconds: row.duration_seconds != null ? row.duration_seconds : (row.durationSeconds != null ? row.durationSeconds : null),
    status: row.status != null ? row.status : '',
    moderationStatus: row.moderation_status != null ? row.moderation_status : (row.moderationStatus != null ? row.moderationStatus : '')
  }
}

/**
 * 社区媒体上传（帖子图/视频、纸飞机图）
 * purpose: post | paper_plane
 */
export async function uploadCommunityMedia(filePath: string, purpose: string) {
  if (filePath == null || ('' + filePath).length == 0) {
    return failRes('请选择要上传的文件', 'EMPTY_FILE')
  }
  const purposeVal = purpose != null ? ('' + purpose) : 'post'
  if (purposeVal != 'post' && purposeVal != 'paper_plane') {
    return failRes('不支持的媒体用途', 'INVALID_MEDIA_PURPOSE')
  }
  if (USE_MOCK) {
    const id = Date.now() + Math.floor(Math.random() * 1000)
    const mediaType = guessMockMediaType(filePath)
    const url = '' + filePath
    mockCommunityMediaById['' + id] = {
      url: url,
      mediaType: mediaType,
      purpose: purposeVal
    }
    return okRes({
      id: id,
      purpose: purposeVal,
      mediaType: mediaType,
      url: url,
      thumbnailUrl: url,
      fileSize: 0,
      durationSeconds: null,
      status: 'ready'
    })
  }
  const token = getAccessToken()
  const url = buildApiUrl('/community/media/uploads')
  return await new Promise<any>((resolve) => {
    uni.uploadFile({
      url: url,
      filePath: filePath,
      name: 'file',
      formData: { purpose: purposeVal },
      header: token != '' ? { Authorization: 'Bearer ' + token } : {},
      success: (res) => {
        if (res.statusCode == 401) clearAuthTokens()
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve(failRes('上传响应解析失败', res.statusCode))
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve(okRes(mapCommunityMedia(data)))
        } else {
          resolve(failRes(extractUploadDetail(data), res.statusCode))
        }
      },
      fail: (err) => {
        const message = err != null && err.errMsg != null ? ('' + err.errMsg) : '上传失败，请重试'
        resolve(failRes(message, 'UPLOAD_FAILED'))
      }
    })
  })
}

export async function getCommunityMediaStatus(mediaId: number) {
  if (mediaId == null || mediaId <= 0) return failRes('无效的媒体 ID', 'INVALID_MEDIA_ID')
  if (USE_MOCK) return okRes({ id: mediaId, status: 'ready', moderationStatus: 'approved' })
  const res = await request({ url: '/community/media/' + mediaId, method: 'GET' })
  if (!res.success || res.data == null) return res
  return okRes(mapCommunityMedia(res.data))
}

/** 删除未绑定的社区媒体 */
export async function deleteCommunityMedia(mediaId: number) {
  if (mediaId == null || mediaId <= 0) {
    return failRes('无效的媒体 ID', 'INVALID_MEDIA_ID')
  }
  if (USE_MOCK) {
    try {
      delete mockCommunityMediaById['' + mediaId]
    } catch (e) {}
    return okRes({ success: true })
  }
  return request({
    url: '/community/media/' + mediaId,
    method: 'DELETE'
  })
}

export async function uploadMedia(filePath: string, purpose: string = 'paper_plane_voice') {
  if (filePath == null || ('' + filePath).length == 0) {
    return failRes('请选择要上传的文件', 'EMPTY_FILE')
  }
  const purposeVal = purpose != null ? ('' + purpose).trim() : ''
  if (purposeVal == '') return failRes('媒体用途不能为空', 'INVALID_MEDIA_PURPOSE')
  if (USE_MOCK) {
    return request({
      url: '/media/uploads',
      cloudFunctionName: 'community',
      action: 'uploadMedia',
      method: 'POST',
      data: { purpose: purposeVal },
      mockData: {
        url: 'mock://voice/' + Date.now() + '.mp3',
        content_type: 'audio/mpeg',
        size: 1024,
        purpose: purposeVal
      }
    })
  }
  return new Promise<any>((resolve) => {
    const token = getAccessTokenLocal()
    const url = buildApiUrlLocal('/media/uploads')
    uni.uploadFile({
      url: url,
      filePath: filePath,
      name: 'file',
      formData: { purpose: purposeVal },
      header: token != '' ? { Authorization: 'Bearer ' + token } : {},
      success: (res) => {
        if (res.statusCode == 401) clearAuthTokens()
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve(failRes('上传响应解析失败', res.statusCode))
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve(okRes(data))
        } else {
          resolve(failRes(extractUploadDetail(data), res.statusCode))
        }
      },
      fail: (err) => {
        const message = err != null && err.errMsg != null ? ('' + err.errMsg) : '上传失败，请检查网络'
        resolve(failRes(message, -1))
      }
    })
  })
}

function buildApiUrlLocal(path: string): string {
  return buildApiUrl(path)
}

function getAccessTokenLocal(): string {
  return getAccessToken()
}

/** 获取由纸飞机回复形成的聊天列表（PR 消息页形状）。 */
export async function getPaperPlaneConversations() {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const list = cloneList(mockPaperPlaneConversations as any[])
    list.forEach((item: any) => {
      item.timeText = paperPlaneTimeText(item.time)
      item.unreadCount = item.unreadCount != null ? Math.max(0, item.unreadCount as number) : 0
    })
    list.sort((a: any, b: any) => Number(b.time) - Number(a.time))
    return request({
      url: '/community/paper-planes/conversations',
      cloudFunctionName: 'community',
      action: 'getPaperPlaneConversations',
      method: 'GET',
      mockData: list
    })
  }
  const res = await request({
    url: '/paper-plane-conversations',
    method: 'GET',
    data: { page: 1, page_size: 50 }
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? res.data : []
  const uniqueRows: any[] = []
  for (let i = 0; i < arr.length; i++) {
    upsertRemotePaperPlaneConversation(uniqueRows, arr[i])
  }
  const viewerId = await readPaperPlaneViewerId()
  const list: any[] = []
  for (let i = 0; i < uniqueRows.length; i++) {
    const mapped = mapPlaneConversation(uniqueRows[i])
    if (mapped == null) continue
    list.push({
      id: mapped.id,
      planeId: mapped.planeId,
      userId: resolvePaperPlaneTargetUserId(mapped, viewerId),
      name: mapped.peerLabel != null ? mapped.peerLabel : '匿名用户',
      avatar: '/static/portraits/profile-woman-alt.webp',
      planeType: '文字纸飞机',
      lastMessage: mapped.lastMessage,
      time: Date.now(),
      timeText: '',
      unreadCount: mapped.unreadCount
    })
  }
  return okRes(list)
}

/** 获取当前用户最近五天扔出的纸飞机。 */
export async function getSentPaperPlanes() {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const cutoff = Date.now() - 5 * 24 * 60 * 60 * 1000
    const list = (mockPaperPlanes as any[]).filter((plane: any) => {
      return plane.userId == mockMeProfile.id && Number(plane.time) >= cutoff
    })
    list.forEach((plane: any) => {
      plane.timeText = paperPlaneTimeText(plane.time)
    })
    list.sort((a: any, b: any) => Number(b.time) - Number(a.time))
    return request({
      url: '/community/paper-planes/sent',
      cloudFunctionName: 'community',
      action: 'getSentPaperPlanes',
      method: 'GET',
      mockData: cloneList(list)
    })
  }
  const res = await request({
    url: '/paper-planes/mine',
    method: 'GET',
    data: { page: 1, page_size: 50 }
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? res.data : []
  return okRes(arr)
}

/** 获取纸飞机聊天列表的未读消息总数。 */
export async function getPaperPlaneUnreadCount() {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const list = mockPaperPlaneConversations as any[]
    let count = 0
    for (let i = 0; i < list.length; i++) {
      count += list[i].unreadCount != null ? Math.max(0, list[i].unreadCount as number) : 0
    }
    return request({
      url: '/community/paper-planes/conversations/unread',
      cloudFunctionName: 'community',
      action: 'getPaperPlaneUnreadCount',
      method: 'GET',
      mockData: { count }
    })
  }
  const res = await getPaperPlaneConversations()
  if (!res.success || res.data == null || !Array.isArray(res.data)) {
    return okRes({ count: 0 })
  }
  let count = 0
  const list = res.data as any[]
  for (let i = 0; i < list.length; i++) {
    count += list[i].unreadCount != null ? Math.max(0, list[i].unreadCount as number) : 0
  }
  return okRes({ count })
}

/** 查看会话后清除该会话的未读数。 */
export async function markPaperPlaneConversationRead(conversationId: number) {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const list = mockPaperPlaneConversations as any[]
    for (let i = 0; i < list.length; i++) {
      if (list[i].id == conversationId) {
        list[i].unreadCount = 0
        break
      }
    }
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) {
        mockPlaneConversations[i].unreadCount = 0
      }
    }
    savePaperPlaneState()
    return request({
      url: '/community/paper-planes/conversations/read',
      cloudFunctionName: 'community',
      action: 'markPaperPlaneConversationRead',
      method: 'POST',
      data: { conversationId },
      mockData: { success: true }
    })
  }
  return await readPaperPlaneConversation(conversationId)
}

export async function getPaperPlaneMessages(conversationId: number) {
  if (USE_MOCK) {
    const key = '' + conversationId
    const list = mockPlaneMessages[key] != null ? mockPlaneMessages[key] : []
    return request({
      url: '/paper-plane-conversations/' + conversationId + '/messages',
      method: 'GET',
      mockData: list
    })
  }
  const res = await request({
    url: '/paper-plane-conversations/' + conversationId + '/messages',
    method: 'GET',
    data: { page: 1, page_size: 50 }
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? res.data : []
  const list: any[] = []
  for (let i = 0; i < arr.length; i++) list.push(mapPlaneMessage(arr[i]))
  list.reverse()
  return okRes(list)
}

export async function sendPaperPlaneMessage(conversationId: number, content: string, suppliedCreateKey: string = '') {
  const textContent = content != null ? ('' + content).trim() : ''
  if (textContent.length == 0) return failRes('请输入消息', 'EMPTY_CONTENT')
  if (USE_MOCK) {
    const key = '' + conversationId
    if (mockPlaneMessages[key] == null) mockPlaneMessages[key] = []
    const msg = {
      id: Date.now(),
      conversationId: conversationId,
      fromUserId: mockMeProfile.id,
      content: textContent,
      type: 1,
      mediaUrl: '',
      voiceDurationSec: 0,
      mine: true,
      timeText: '刚刚'
    }
    ;(mockPlaneMessages[key] as any[]).push(msg)
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) {
        mockPlaneConversations[i].lastMessage = textContent
      }
    }
    return request({
      url: '/paper-plane-conversations/' + conversationId + '/messages',
      method: 'POST',
      data: { content: textContent },
      mockData: msg
    })
  }
  const key = idempotencyKey('paper-plane-message', suppliedCreateKey)
  const res = await request({
    url: '/paper-plane-conversations/' + conversationId + '/messages',
    method: 'POST',
    data: { content: textContent, type: 1 },
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) return res
  return okRes(mapPlaneMessage(res.data))
}

export async function sendPaperPlaneMediaMessage(conversationId: number, media: any, suppliedCreateKey: string = '') {
  const mediaId = media != null && media.id != null ? Number(media.id) : 0
  const mediaUrl = media != null && media.url != null ? ('' + media.url) : (typeof media == 'string' ? media : '')
  if (conversationId <= 0 || (mediaId <= 0 && mediaUrl.trim() == '')) return failRes('图片媒体无效', 'INVALID_MEDIA')
  if (USE_MOCK) {
    const key = '' + conversationId
    if (mockPlaneMessages[key] == null) mockPlaneMessages[key] = []
    const msg = { id: Date.now(), conversationId, fromUserId: mockMeProfile.id, content: '', type: 2, mediaUrl, voiceDurationSec: 0, mine: true, timeText: '刚刚' }
    ;(mockPlaneMessages[key] as any[]).push(msg)
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) mockPlaneConversations[i].lastMessage = '[图片]'
    }
    return request({ url: '/paper-plane-conversations/' + conversationId + '/messages', method: 'POST', data: { type: 2, media_id: mediaId, media_url: mediaUrl }, mockData: msg })
  }
  const key = idempotencyKey('paper-plane-image-message', suppliedCreateKey)
  const payload: any = { content: '', type: 2 }
  if (mediaId > 0) payload.media_id = mediaId
  else if (mediaUrl.trim() != '') payload.media_url = mediaUrl
  const res = await request({ url: '/paper-plane-conversations/' + conversationId + '/messages', method: 'POST', data: payload, headers: { 'Idempotency-Key': key } })
  if (!res.success) return res
  return okRes(mapPlaneMessage(res.data))
}

export async function createPaperPlaneContactExchange(conversationId: number, kind: string, suppliedIdempotencyKey: string = '') {
  if (conversationId <= 0 || (kind != 'wechat' && kind != 'phone')) return failRes('交换类型无效', 'INVALID_CONTACT_KIND')
  if (USE_MOCK) {
    return request({ url: '/paper-plane-conversations/' + conversationId + '/contact-exchanges', method: 'POST', data: { kind }, mockData: { id: Date.now(), conversation_id: conversationId, kind, status: 'PENDING', requester_user_id: mockMeProfile.id, target_user_id: 0, requester_consented_at: new Date().toISOString(), target_consented_at: null, responded_at: null, created_at: new Date().toISOString() } })
  }
  const key = idempotencyKey('paper-plane-contact-exchange', suppliedIdempotencyKey)
  return await request({ url: '/paper-plane-conversations/' + conversationId + '/contact-exchanges', method: 'POST', data: { kind }, headers: { 'Idempotency-Key': key } })
}

export async function respondPaperPlaneContactExchange(exchangeId: number, decision: string, suppliedIdempotencyKey: string = '') {
  if (exchangeId <= 0 || (decision != 'accept' && decision != 'reject' && decision != 'withdraw')) return failRes('交换申请操作无效', 'INVALID_CONTACT_DECISION')
  if (USE_MOCK) {
    return request({ url: '/paper-plane-contact-exchanges/' + exchangeId + '/respond', method: 'POST', data: { decision }, mockData: { id: exchangeId, status: decision == 'accept' ? 'APPROVED' : (decision == 'reject' ? 'REJECTED' : 'REVOKED') } })
  }
  const key = idempotencyKey('paper-plane-contact-response', suppliedIdempotencyKey)
  return await request({ url: '/paper-plane-contact-exchanges/' + exchangeId + '/respond', method: 'POST', data: { decision }, headers: { 'Idempotency-Key': key } })
}

export async function readPaperPlaneConversation(conversationId: number) {
  if (USE_MOCK) {
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) mockPlaneConversations[i].unreadCount = 0
    }
    return okRes({ success: true })
  }
  return await request({
    url: '/paper-plane-conversations/' + conversationId + '/read',
    method: 'POST',
    data: {}
  })
}

function readPaperPlaneProfileUnlockState(): any {
  try {
    const saved = uni.getStorageSync(PAPER_PLANE_PROFILE_UNLOCK_STORAGE_KEY) as any
    return saved != null && typeof saved == 'object' ? saved : { entitlements: {}, idempotency: {} }
  } catch (e) {
    return { entitlements: {}, idempotency: {} }
  }
}

function resolvePaperPlaneTargetUserId(conversation: any, viewerId: number): number {
  if (conversation == null || viewerId <= 0) return 0
  const ownerId = Number(conversation.ownerId != null ? conversation.ownerId : 0)
  const replierId = Number(conversation.replierId != null ? conversation.replierId : 0)
  if (ownerId == viewerId && replierId > 0) return replierId
  if (replierId == viewerId && ownerId > 0) return ownerId
  return 0
}

async function readPaperPlaneViewerId(): Promise<number> {
  if (USE_MOCK) {
    return mockMeProfile != null && mockMeProfile.id != null ? Number(mockMeProfile.id) : 0
  }
  try {
    const res = await getMeProfile()
    if (res != null && res.success && res.data != null) {
      const raw = res.data as any
      const candidate = raw.id != null ? raw.id : raw.user_id
      const parsed = Number(candidate)
      return Number.isNaN(parsed) ? 0 : parsed
    }
  } catch (e) {}
  return 0
}

function savePaperPlaneProfileUnlockState(state: any): void {
  try { uni.setStorageSync(PAPER_PLANE_PROFILE_UNLOCK_STORAGE_KEY, state) } catch (e) {}
}

function paperPlaneUnlockResult(targetUserId: number, unlocked: boolean): any {
  return {
    target_user_id: targetUserId,
    unlocked,
    points_cost: PAPER_PLANE_PROFILE_UNLOCK_COST,
    balance: Number(mockMeProfile.points || 0)
  }
}

/** 查询当前查看者针对某一目标用户的纸飞机资料解锁权益。 */
export async function getPaperPlaneProfileUnlock(targetUserId: number) {
  if (targetUserId <= 0) return failRes('缺少目标用户', 400)
  if (USE_MOCK) {
    const state = readPaperPlaneProfileUnlockState()
    const key = mockMeProfile.id + ':' + targetUserId
    const entry = state.entitlements != null ? state.entitlements[key] : null
    return okRes(paperPlaneUnlockResult(targetUserId, entry != null && entry.unlocked == true))
  }
  const res = await request({
    url: '/paper-plane/profile-unlocks/' + targetUserId,
    method: 'GET'
  })
  if (!res.success) return res
  const raw = res.data != null ? res.data : {}
  return okRes({
    target_user_id: raw.target_user_id != null ? Number(raw.target_user_id) : targetUserId,
    unlocked: raw.unlocked == true,
    points_cost: raw.points_cost != null ? Number(raw.points_cost) : PAPER_PLANE_PROFILE_UNLOCK_COST,
    balance: raw.balance != null ? Number(raw.balance) : 0
  })
}

/** 按查看者+目标用户原子解锁；客户端只缓存服务端确认的状态。 */
export async function unlockPaperPlaneProfile(targetUserId: number, suppliedIdempotencyKey: string = '') {
  if (targetUserId <= 0) return failRes('缺少目标用户', 400)
  const key = suppliedIdempotencyKey != null && suppliedIdempotencyKey != ''
    ? suppliedIdempotencyKey
    : createCommunityCreateKey('paper-plane-profile-unlock')
  if (USE_MOCK) {
    if (targetUserId == mockMeProfile.id) return failRes('不能解锁自己的资料', 403)
    const state = readPaperPlaneProfileUnlockState()
    if (state.idempotency == null) state.idempotency = {}
    if (state.entitlements == null) state.entitlements = {}
    const priorTarget = state.idempotency[key]
    if (priorTarget != null && Number(priorTarget) != targetUserId) return failRes('幂等键已用于其他目标', 409)
    const entitlementKey = mockMeProfile.id + ':' + targetUserId
    const existing = state.entitlements[entitlementKey]
    if (existing != null && existing.unlocked == true) {
      state.idempotency[key] = targetUserId
      savePaperPlaneProfileUnlockState(state)
      return okRes(paperPlaneUnlockResult(targetUserId, true))
    }
    if (Number(mockMeProfile.points || 0) < PAPER_PLANE_PROFILE_UNLOCK_COST) return failRes('积分不足', 402, paperPlaneUnlockResult(targetUserId, false))
    mockMeProfile.points = Number(mockMeProfile.points || 0) - PAPER_PLANE_PROFILE_UNLOCK_COST
    state.entitlements[entitlementKey] = { unlocked: true, pointsCost: PAPER_PLANE_PROFILE_UNLOCK_COST, unlockedAt: Date.now() }
    state.idempotency[key] = targetUserId
    savePaperPlaneProfileUnlockState(state)
    syncPaperPlanePoints()
    return okRes(paperPlaneUnlockResult(targetUserId, true))
  }
  const res = await request({
    url: '/paper-plane/profile-unlocks/' + targetUserId,
    method: 'POST',
    headers: { 'Idempotency-Key': key },
    data: {}
  })
  if (!res.success) return res
  const raw = res.data != null ? res.data : {}
  return okRes({
    target_user_id: raw.target_user_id != null ? Number(raw.target_user_id) : targetUserId,
    unlocked: raw.unlocked == true,
    points_cost: raw.points_cost != null ? Number(raw.points_cost) : PAPER_PLANE_PROFILE_UNLOCK_COST,
    balance: raw.balance != null ? Number(raw.balance) : 0
  })
}

export async function endPaperPlaneConversation(conversationId: number) {
  if (USE_MOCK) {
    for (let i = 0; i < mockPlaneConversations.length; i++) {
      if (mockPlaneConversations[i].id == conversationId) mockPlaneConversations[i].status = 2
    }
    return okRes({ success: true, status: 2 })
  }
  const res = await request({
    url: '/paper-plane-conversations/' + conversationId + '/end',
    method: 'POST',
    data: {}
  })
  if (!res.success) return res
  return okRes(mapPlaneConversation(res.data))
}

