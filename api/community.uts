export function ensureCommunityBanners(list: any[]): any[] {
  const next: any[] = list != null ? list.slice() : []
  const hasType = (type: string): boolean => {
    for (let i = 0; i < next.length; i++) {
      const b = next[i]
      if (b != null && b.type != null && ('' + b.type) == type) return true
    }
    return false
  }
  // 只补缺、不删多余：排序与同 type 去重仍由 community.uvue 的 loadBanners 负责。
  // 补位条目一律追加在数组末尾，页面层按 order 查找时后端真实配置优先命中。
  if (!hasType('plane')) next.push(getFixedCommunityBanner())
  if (!hasType('topic')) next.push(getFixedTopicBanner())
  if (!hasType('activity')) next.push(getFixedActivityBanner())
  return next
}

function mapQuotaItem(row: any): any {
  if (row == null) {
    return { total: 0, used: 0, remain: 0, pointsAvailable: false, pointsCost: 0 }
  }
  return {
    total: row.total != null ? row.total : 0,
    used: row.used != null ? row.used : 0,
    remain: row.remain != null ? row.remain : 0,
    // fail-closed：缺字段不当可加次
    pointsAvailable: row.points_available != null ? row.points_available == true : false,
    pointsCost: row.points_cost != null ? row.points_cost : 0
  }
}

function mapQuotas(row: any): any {
  if (row == null) return null
  return {
    applyDaily: mapQuotaItem(row.apply_daily),
    paperPlaneDaily: mapQuotaItem(row.paper_plane_daily)
  }
}

function mapPaperPlane(row: any): any {
  if (row == null) return null
  return {
    id: row.id,
    content: row.content != null ? row.content : '',
    anonymous: row.is_anonymous == true,
    scope: 'city',
    gender: '',
    age: 0,
    city: row.city != null ? row.city : '',
    userId: null,
    time: toMs(row.created_at),
    timeText: timeTextFrom(row.created_at),
    replyCount: row.reply_count != null ? row.reply_count : 0,
    replied: false,
    images: resolveMediaUrlList(row.images),
    tags: row.tags != null ? row.tags : [],
    voiceUrl: row.voice_url != null ? resolveMediaUrl(row.voice_url) : '',
    voiceDurationSec: row.voice_duration_sec != null ? row.voice_duration_sec : 0,
    conversationId: row.conversation_id != null ? row.conversation_id : 0
  }
}

const OFFICIAL_ACTIVITY_TYPES: string[] = ['official_activity', 'activity_registration', 'activity_review', 'activity_update', 'activity_cancel', 'activity_reminder', 'activity_check_in']
const OFFICIAL_ACTIVITY_QUERY = { official_only: true }

export function isOfficialActivity(row: any): boolean {
  if (row == null) return false
  const payload = row.payload != null && typeof row.payload === 'object' ? row.payload : {}
  const type = row.notification_type != null ? '' + row.notification_type : (row.type != null ? '' + row.type : '')
  const action = row.action != null ? '' + row.action : ''
  return row.is_official == true || row.isOfficial == true || row.isOfficialActivity == true || payload.is_official == true || OFFICIAL_ACTIVITY_TYPES.indexOf(type) >= 0 || OFFICIAL_ACTIVITY_TYPES.indexOf(action) >= 0
}

/** 用户级私有“我的喜欢”列表；帖子卡片不使用收藏/喜欢计数替代它。 */
export async function getMyLikedProfiles(page: number = 1, pageSize: number = 20) {
  return await getMyLikedProfilesFromUser(page, pageSize)
}

export function normalizeCommunityNotification(row: any): any {
  if (row == null) return null
  const payload = row.payload != null && typeof row.payload === 'object' ? row.payload : {}
  const targetType = row.target_type != null ? ('' + row.target_type) : (row.targetType != null ? ('' + row.targetType) : (payload.target_type != null ? ('' + payload.target_type) : ''))
  const targetId = row.target_id != null ? row.target_id : (row.targetId != null ? row.targetId : (payload.target_id != null ? payload.target_id : (row.related_id != null ? row.related_id : 0)))
  const rawType = row.notification_type != null ? '' + row.notification_type : (row.type != null ? '' + row.type : '')
  const rawAction = row.action != null ? '' + row.action : ''
  const commentLike = rawType == 'comment' || rawType == 'reply' || rawType == 'comment_reply' || rawAction == 'comment' || rawAction == 'reply'
  const likeLike = rawType == 'like' || rawType == 'post_like' || rawAction == 'like'
  const normalizedType = commentLike ? 'comment' : (likeLike ? 'like' : (isOfficialActivity(row) ? 'activity' : 'other'))
  const postId = row.post_id != null ? Number(row.post_id) : (row.postId != null ? Number(row.postId) : (payload.post_id != null ? Number(payload.post_id) : (targetType == 'post' ? Number(targetId) : 0)))
  const commentId = row.comment_id != null ? Number(row.comment_id) : (row.commentId != null ? Number(row.commentId) : (payload.comment_id != null ? Number(payload.comment_id) : (targetType == 'comment' ? Number(targetId) : 0)))
  return {
    id: row.id,
    type: normalizedType,
    rawType,
    title: row.title != null ? row.title : '',
    content: row.content != null ? row.content : '',
    timeText: row.timeText != null ? '' + row.timeText : timeTextFrom(row.created_at),
    read: row.is_read == true || row.read == true,
    targetType,
    targetId,
    payload,
    relatedUserId: row.related_user_id != null ? row.related_user_id : 0,
    actorUserId: row.actor_user_id != null ? row.actor_user_id : (row.related_user_id != null ? row.related_user_id : 0),
    action: row.action != null ? row.action : (row.notification_type != null ? row.notification_type : 'system'),
    postId,
    commentId,
    isOfficialActivity: isOfficialActivity(row)
  }
}

function mapNotification(row: any): any {
  return normalizeCommunityNotification(row)
}

function feedModeFromTab(tab: string, filter: string): any {
  // 返回 { mode, filter, sort, mergeLiked? }
  // mergeLiked 恒 false：并集走 BE mode=following_and_liked，禁止客户端假分页
  if (tab == 'follow') {
    if (filter == 'following') return { mode: 'following', filter: null, sort: 'latest', mergeLiked: false }
    if (filter == 'likedUsers') return { mode: 'liked_users', filter: null, sort: 'latest', mergeLiked: false }
    // 全部：关注 ∪ 用户级喜欢（BE following_and_liked）
    return { mode: 'following_and_liked', filter: null, sort: 'latest', mergeLiked: false }
  }
  if (tab == 'city') {
    let sort = 'latest'
    if (filter == 'hot') sort = 'hot'
    return { mode: 'city', filter: null, sort: sort, mergeLiked: false }
  }
  // discover
  let f: any = null
  if (filter == 'mbti' || filter == 'alumni' || filter == 'hometown') f = filter
  return { mode: 'latest', filter: f, sort: 'latest', mergeLiked: false }
}

/** 真路径拉一页帖子并 map */
async function fetchPostPage(params: any): Promise<any> {
  const res = await request({
    url: '/community/posts',
    method: 'GET',
    data: params
  })
  if (!res.success) return res
  const raw = res.data
  const items = raw != null && raw.items != null ? (raw.items as any[]) : []
  const list: any[] = []
  for (let i = 0; i < items.length; i++) {
    list.push(mapPost(items[i]))
  }
  const total = raw != null && raw.total != null ? (raw.total as number) : list.length
  return okRes({
    list: list,
    page: params.page,
    pageSize: params.page_size,
    total: total,
    rawTotal: total
  })
}

/** following ∪ liked_users 去重后按 time 降序，再本地分页 */
function mergeFollowAndLikedLists(a: any[], b: any[]): any[] {
  const seen: any = {}
  const out: any[] = []
  for (let i = 0; i < a.length; i++) {
    const id = a[i] != null ? a[i].id : 0
    if (id > 0 && seen['' + id] != true) {
      seen['' + id] = true
      out.push(a[i])
    }
  }
  for (let j = 0; j < b.length; j++) {
    const id2 = b[j] != null ? b[j].id : 0
    if (id2 > 0 && seen['' + id2] != true) {
      seen['' + id2] = true
      out.push(b[j])
    }
  }
  out.sort((x: any, y: any) => {
    const tx = x != null && x.time != null ? (x.time as number) : 0
    const ty = y != null && y.time != null ? (y.time as number) : 0
    return ty - tx
  })
  return out
}

// ─── 动态列表 / 详情 ────────────────────────────────────────

/**
 * 获取动态列表
 * 新签名：getDynamicList({ tab, filter, page, pageSize, city? })
 * 兼容：getDynamicList(tabNumber, page)
 * 返回 data: { list, page, pageSize, hasMore, total }
 */
export async function getDynamicList(queryOrTab: any = 'discover', pageArg: number = 1) {
  const q = normalizeListQuery(queryOrTab, pageArg)
  const page = q.page > 0 ? q.page : 1
  const pageSize = q.pageSize > 0 ? q.pageSize : 10

  if (USE_MOCK) {
    const filtered = filterDynamics(q.tab, q.filter, q.city)
    const start = (page - 1) * pageSize
    const end = start + pageSize
    const slice = filtered.slice(start, end)
    const hasMore = end < filtered.length
    return request({
      url: '/community/dynamic/list',
      cloudFunctionName: 'community',
      action: 'getDynamicList',
      method: 'GET',
      data: q,
      mockData: {
        list: cloneList(slice),
        page,
        pageSize,
        hasMore,
        total: filtered.length,
        tab: q.tab,
        filter: q.filter
      }
    })
  }

  const mf = feedModeFromTab(q.tab, q.filter)

// 遗留：mergeLiked 恒 false；并集已走 BE following_and_liked。勿再开启客户端假分页。
	  if (mf.mergeLiked == true) {
    const fetchSize = page * pageSize
    const common: any = { page: 1, page_size: fetchSize > 50 ? 50 : fetchSize, sort: 'latest' }
    const resA = await fetchPostPage({ mode: 'following', page: common.page, page_size: common.page_size, sort: common.sort })
    if (!resA.success) return resA
    const resB = await fetchPostPage({ mode: 'liked_users', page: common.page, page_size: common.page_size, sort: common.sort })
    if (!resB.success) return resB
    const merged = mergeFollowAndLikedLists(
      resA.data != null && resA.data.list != null ? (resA.data.list as any[]) : [],
      resB.data != null && resB.data.list != null ? (resB.data.list as any[]) : []
    )
    const start = (page - 1) * pageSize
    const end = start + pageSize
    const slice = merged.slice(start, end)
    const totalA = resA.data != null && resA.data.total != null ? (resA.data.total as number) : 0
    const totalB = resB.data != null && resB.data.total != null ? (resB.data.total as number) : 0
    const approxTotal = totalA + totalB
    const hasMoreMerge = end < merged.length || page * pageSize < approxTotal
    return okRes({
      list: slice,
      page: page,
      pageSize: pageSize,
      hasMore: hasMoreMerge,
      total: merged.length > approxTotal ? merged.length : approxTotal,
      tab: q.tab,
      filter: q.filter
    })
  }

const params: any = {
		    mode: mf.mode,
		    page: page,
		    page_size: pageSize,
		    sort: mf.sort
		  }
		  // 同城：传 name + city_code（市一级）；筛选在后端
		  const cityParam = normalizeCityName(q.city)
		  const cityCodeParam = normalizeCityCode(q.cityCode)
		  if (q.tab == 'city') {
		    if (cityParam != '') params.city = cityParam
		    if (cityCodeParam != '') params.city_code = cityCodeParam
		  }
		  if (mf.filter != null) {
		    params.filter = mf.filter
		  }
  const res = await request({
    url: '/community/posts',
    method: 'GET',
    data: params
  })
  if (!res.success) return res
  const raw = res.data
  const items = raw != null && raw.items != null ? (raw.items as any[]) : []
  const list: any[] = []
  for (let i = 0; i < items.length; i++) {
    list.push(mapPost(items[i]))
  }
  const total = raw != null && raw.total != null ? (raw.total as number) : list.length
  const hasMore = page * pageSize < total
  return okRes({
    list: list,
    page: page,
    pageSize: pageSize,
    hasMore: hasMore,
    total: total,
    tab: q.tab,
    filter: q.filter
  })
}

export async function getDynamicDetail(dynamicId: number) {
  if (USE_MOCK) {
    const item = findDynamic(dynamicId)
    if (item != null && item.user != null && isBlocked(item.user.id as number)) {
      return request({
        url: '/community/dynamic/detail',
        cloudFunctionName: 'community',
        action: 'getDynamicDetail',
        method: 'GET',
        data: { dynamicId },
        mockData: null
      })
    }
    if (item != null && item.user != null) {
      item.applyStatus = applyStatusForUser(item.user.id as number, item.applyStatus || 'none')
    }
    return request({
      url: '/community/dynamic/detail',
      cloudFunctionName: 'community',
      action: 'getDynamicDetail',
      method: 'GET',
      data: { dynamicId },
      mockData: item != null ? item : null
    })
  }

  const res = await request({
    url: '/community/posts/' + dynamicId,
    method: 'GET'
  })
  if (!res.success) return res
  const post = mapPost(res.data)
  // 附带评论：失败显式标记，不静默空列表
  const cRes = await request({
    url: '/community/posts/' + dynamicId + '/comments',
    method: 'GET',
    data: { page: 1, page_size: 50 }
  })
  const comments: any[] = []
  let commentsLoadError = false
  if (!cRes.success) {
    commentsLoadError = true
  } else if (cRes.data != null) {
    const arr =
      Array.isArray(cRes.data)
        ? (cRes.data as any[])
        : cRes.data.items != null && Array.isArray(cRes.data.items)
          ? (cRes.data.items as any[])
          : cRes.data.list != null && Array.isArray(cRes.data.list)
            ? (cRes.data.list as any[])
            : []
    for (let i = 0; i < arr.length; i++) {
      comments.push(mapComment(arr[i]))
    }
  }
  if (post != null) {
    post.comments = comments
    post.commentCount = comments.length > 0 ? comments.length : post.commentCount
    post.commentsLoadError = commentsLoadError
  }
  return okRes(post)
}

// ─── 话题 ───────────────────────────────────────────────────

export async function getTopics(sort: string = 'hot') {
  if (USE_MOCK) {
    let list = cloneList(mockTopics as any[])
    if (sort == 'new' || sort == 'latest') {
      list = sortTopicsByCreated(list)
    } else {
      list = sortTopicsByHeat(list)
    }
    return request({
      url: '/community/topics',
      cloudFunctionName: 'community',
      action: 'getTopics',
      method: 'GET',
      data: { sort },
      mockData: list
    })
  }

  const sortKey = sort == 'new' || sort == 'latest' ? 'latest' : 'hot'
  const res = await request({
    url: '/community/topics',
    method: 'GET',
    data: { sort: sortKey, page: 1, page_size: 50 }
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? (res.data as any[]) : []
  const list: any[] = []
  for (let i = 0; i < arr.length; i++) {
    list.push(mapTopic(arr[i]))
  }
  return okRes(list)
}

/**
 * 分页话题列表
 * getTopicList({ sort, page, pageSize, excludeIds })
 * 返回 { list, page, pageSize, total, hasMore }
 */
export async function getTopicList(query: any = null) {
  const sort = query != null && query.sort != null ? ('' + query.sort) : 'hot'
  const page = query != null && query.page != null && (query.page as number) > 0 ? (query.page as number) : 1
  const pageSize = query != null && query.pageSize != null && (query.pageSize as number) > 0 ? (query.pageSize as number) : 10
  const excludeIds = query != null ? query.excludeIds : null

  if (USE_MOCK) {
    let list = cloneList(mockTopics as any[])
    if (sort == 'new' || sort == 'latest') {
      list = sortTopicsByCreated(list)
    } else {
      list = sortTopicsByHeat(list)
    }
    list = excludeTopicIds(list, excludeIds)
    const total = list.length
    const start = (page - 1) * pageSize
    const end = start + pageSize
    const slice = list.slice(start, end)
    const hasMore = end < total
    return request({
      url: '/community/topics/list',
      cloudFunctionName: 'community',
      action: 'getTopicList',
      method: 'GET',
      data: { sort, page, pageSize, excludeIds },
      mockData: {
        list: slice,
        page,
        pageSize,
        total,
        hasMore
      }
    })
  }

  const sortKey = sort == 'new' || sort == 'latest' ? 'latest' : 'hot'
  const params: any = { sort: sortKey, page: page, page_size: pageSize }
  if (excludeIds != null && Array.isArray(excludeIds) && excludeIds.length > 0) {
    params.exclude_ids = excludeIds
  }
  const res = await request({
    url: '/community/topics/page',
    method: 'GET',
    data: params
  })
  if (!res.success) return res
  const raw = res.data
  const items = raw != null && raw.items != null ? (raw.items as any[]) : []
  const list: any[] = []
  for (let i = 0; i < items.length; i++) {
    list.push(mapTopic(items[i]))
  }
  const total = raw != null && raw.total != null ? (raw.total as number) : list.length
  return okRes({
    list: list,
    page: page,
    pageSize: pageSize,
    total: total,
    hasMore: page * pageSize < total
  })
}

export async function getTopicDetail(topicId: number, sort: string = 'hot', page: number = 1, pageSize: number = 20) {
  if (USE_MOCK) {
    const topic = findTopic(topicId)
    let posts = (mockDynamicList as any[]).filter((d: any) => {
      return d.topicId == topicId && notBlockedDynamic(d)
    })
    if (sort == 'latest' || sort == 'new') {
      posts = posts.slice().sort((a: any, b: any) => {
        return ((b.time as number) || 0) - ((a.time as number) || 0)
      })
    } else {
      posts = posts.slice().sort((a: any, b: any) => {
        return ((b.likeCount as number) || 0) - ((a.likeCount as number) || 0)
      })
    }
    const start = (page - 1) * pageSize
    const items = posts.slice(start, start + pageSize)
    return request({
      url: '/community/topic/detail',
      cloudFunctionName: 'community',
      action: 'getTopicDetail',
      method: 'GET',
      data: { topicId, sort, page, pageSize },
      mockData: {
        topic,
        posts: cloneList(items),
        sort,
        page: page,
        pageSize: pageSize,
        total: posts.length,
        hasMore: start + items.length < posts.length
      }
    })
  }

  const sortKey = sort == 'latest' || sort == 'new' ? 'latest' : 'hot'
  const res = await request({
    url: '/community/topics/' + topicId + '/detail',
    method: 'GET',
    data: { sort: sortKey, page: page, page_size: pageSize }
  })
  if (!res.success) return res
  const raw = res.data
  const topic = mapTopic(raw != null ? raw.topic : null)
  const postsPage = raw != null && raw.posts != null ? raw.posts : null
  const postsRaw = postsPage != null && postsPage.items != null ? (postsPage.items as any[]) : []
  const posts: any[] = []
  for (let i = 0; i < postsRaw.length; i++) {
    posts.push(mapPost(postsRaw[i]))
  }
  return okRes({
    topic: topic,
    posts: posts,
    sort: sortKey,
    page: postsPage != null && postsPage.page != null ? postsPage.page : page,
    pageSize: postsPage != null && postsPage.page_size != null ? postsPage.page_size : pageSize,
    total: postsPage != null && postsPage.total != null ? postsPage.total : posts.length,
    hasMore: postsPage != null && postsPage.total != null
      ? ((postsPage.page != null ? postsPage.page : page) * (postsPage.page_size != null ? postsPage.page_size : pageSize) < postsPage.total)
      : posts.length >= pageSize
  })
}

export async function joinTopic(topicId: number) {
  if (USE_MOCK) {
    const topic = findTopic(topicId)
    if (topic == null) {
      return failRes('话题不存在', 404)
    }
    markTopicParticipation(topic)
    const participantCount = topic.participantCount != null
      ? (topic.participantCount as number)
      : 0
    return request({
      url: '/community/topic/join',
      cloudFunctionName: 'community',
      action: 'joinTopic',
      method: 'POST',
      data: { topicId },
      mockData: { success: true, joined: true, topicId, participantCount }
    })
  }

  const res = await request({
    url: '/community/topics/' + topicId + '/join',
    method: 'POST',
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    // fail-closed：缺 joined 不当已加入
    joined: raw != null && raw.joined == true,
    topicId: raw != null && raw.topic_id != null ? raw.topic_id : topicId,
    participantCount: raw != null && raw.participant_count != null ? raw.participant_count : null
  })
}

export async function leaveTopic(topicId: number) {
  if (USE_MOCK) {
    const topic = findTopic(topicId)
    if (topic == null) {
      return failRes('话题不存在', 404)
    }
    unmarkTopicParticipation(topic)
    const participantCount = topic.participantCount != null
      ? (topic.participantCount as number)
      : 0
    return request({
      url: '/community/topic/leave',
      cloudFunctionName: 'community',
      action: 'leaveTopic',
      method: 'DELETE',
      data: { topicId },
      mockData: { success: true, joined: false, topicId, participantCount }
    })
  }

  const res = await request({
    url: '/community/topics/' + topicId + '/leave',
    method: 'DELETE',
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    // fail-closed：缺 joined=false 时仍视为未参与
    joined: raw != null && raw.joined == true,
    topicId: raw != null && raw.topic_id != null ? raw.topic_id : topicId,
    participantCount: raw != null && raw.participant_count != null ? raw.participant_count : null
  })
}

