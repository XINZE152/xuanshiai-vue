    } else if (filter == 'mine') {
      list = list.filter((a: any) => a.myStatus == 'joined' || a.myStatus == 'pending')
    }
    return request({
      url: '/community/activities',
      cloudFunctionName: 'community',
      action: 'getActivities',
      method: 'GET',
      data: { filter },
      mockData: list
    })
  }

  const f = filter == 'recruiting' || filter == 'mine' ? filter : 'all'
  const res = await request({
    url: '/community/activities',
    method: 'GET',
    data: { filter: f, page: 1, page_size: 50 }
  })
  if (!res.success) return res
  const items = res.data != null && res.data.items != null ? (res.data.items as any[]) : []
  const list: any[] = []
  for (let i = 0; i < items.length; i++) {
    list.push(mapActivity(items[i]))
  }
  return okRes(list)
}

