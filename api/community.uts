export async function getPaperPlanes() {
  if (USE_MOCK) {
    restorePaperPlaneState()
    const list = (mockPaperPlanes as any[]).filter((p: any) => {
      if (p.userId == null) return true
      return !isBlocked(p.userId as number)
    })
    list.forEach((p: any) => {
      p.timeText = timeTextFrom(p.time)
      if (p.userId == mockMeProfile.id && (p.gender == null || p.gender == '我')) {
        p.gender = mockMeProfile.gender == 1 ? '男' : '女'
      }
    })
    return request({
      url: '/community/paper-planes',
      cloudFunctionName: 'community',
      action: 'getPaperPlanes',
      method: 'GET',
      mockData: cloneList(list)
    })
  }

  const res = await request({
    url: '/paper-planes',
    method: 'GET',
    data: { page: 1, page_size: 20 }
  })
  if (!res.success) return res
  const arr = res.data != null && Array.isArray(res.data) ? (res.data as any[]) : []
  const list: any[] = []
  for (let i = 0; i < arr.length; i++) {
    list.push(mapPaperPlane(arr[i]))
  }
  return okRes(list)
}

