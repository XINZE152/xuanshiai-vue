  if (USE_MOCK) return okRes(values)
  return request({ url: '/users/me/privacy', method: 'PUT', data: values })
}

function mapBlockedUser(row: any): any {
  if (row == null) return { id: 0, user_id: 0, nickname: '已屏蔽用户', avatar: '' }
  return {
    id: row.id != null ? row.id : row.user_id,
    user_id: row.user_id != null ? row.user_id : row.id,
    nickname: row.nickname != null ? row.nickname : '已屏蔽用户',
    avatar: row.avatar != null ? resolveMediaUrl(row.avatar) : ''
  }
}

export async function getBlockedUsers() {
  if (USE_MOCK) return okRes((mockBlockedUserIds as number[]).map((id: number) => mapBlockedUser({ id })))
  const res = await request({ url: '/security/blocks', method: 'GET' })
  if (!res.success || res.data == null) return res
  const raw = res.data
  const rows: any[] = Array.isArray(raw) ? raw as any[] : (raw.items != null && Array.isArray(raw.items) ? raw.items as any[] : [])
  const items: any[] = []
  for (let i = 0; i < rows.length; i++) items.push(mapBlockedUser(rows[i]))
  return okRes(items)
}

export async function unblockUser(userId: number) {
  if (USE_MOCK) {
    const ids = mockBlockedUserIds as number[]
    const index = ids.indexOf(userId)
    if (index >= 0) ids.splice(index, 1)
    return okRes({ success: true })
  }
  return request({ url: '/security/blocks/' + userId, method: 'DELETE', data: {} })
}

