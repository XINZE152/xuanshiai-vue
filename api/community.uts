      url: '/community/quotas',
      cloudFunctionName: 'community',
      action: 'getQuotas',
      method: 'GET',
      mockData: mockCommunityQuotas
    })
  }

  const res = await request({
    url: '/community/quotas',
    method: 'GET'
  })
  if (!res.success) return res
  return okRes(mapQuotas(res.data))
}

/** 购买纸飞机次数（加次）。后端没有 /community/paper-planes/chances 路由，
 *  加次统一走积分兑换：POST /users/me/points/redeem，product_code = paper_plane_unlock。 */
export async function purchasePaperPlaneChance(type: string) {
  if (type != 'throw' && type != 'catch') {
    return failRes('无效的纸飞机次数类型', 'INVALID_TYPE')
  }
  return redeemPointProduct('paper_plane_unlock')
}

// ─── 发布 / 点赞 / 收藏 / 关注 / 评论 ───────────────────────

/**
 * 发布动态
 * 新签名：publishDynamic({ content, media?, location?, topicId?, visibility?, declaration? })
 * 兼容：publishDynamic(content, photos, location, topicId, visibility)
 */
export async function publishDynamic(
  contentOrPayload: any,
  photosArg: string[] = [],
  locationArg: string = '',
  topicIdArg: number = 0,
  visibilityArg: number = 0
) {
  let content = ''
  let photos: string[] = []
  let videos: string[] = []
  let location = ''
  let topicId = 0
  let visibility = 0
  let declaration = ''
  let suppliedCreateKey = ''
  let imageMediaIds: number[] = []
  let videoMediaId = 0

  if (contentOrPayload != null && typeof contentOrPayload === 'object' && !Array.isArray(contentOrPayload)) {
    content = contentOrPayload.content != null ? ('' + contentOrPayload.content).trim() : ''
    const media = contentOrPayload.media != null ? contentOrPayload.media : contentOrPayload.photos
    photos = media != null ? (media as string[]) : []
    const rawVideos = contentOrPayload.videos
    videos = rawVideos != null ? (rawVideos as string[]) : []
    location = contentOrPayload.location != null ? ('' + contentOrPayload.location) : ''
    topicId = contentOrPayload.topicId != null ? (contentOrPayload.topicId as number) : 0
    visibility = contentOrPayload.visibility != null ? (contentOrPayload.visibility as number) : 0
    declaration = contentOrPayload.declaration != null ? ('' + contentOrPayload.declaration) : ''
    suppliedCreateKey = contentOrPayload.idempotencyKey != null ? ('' + contentOrPayload.idempotencyKey) : ''
    const rawImageMediaIds = contentOrPayload.imageMediaIds != null ? contentOrPayload.imageMediaIds : contentOrPayload.image_media_ids
    if (rawImageMediaIds != null && Array.isArray(rawImageMediaIds)) {
      imageMediaIds = rawImageMediaIds as number[]
    }
    const rawVideoMediaId = contentOrPayload.videoMediaId != null ? contentOrPayload.videoMediaId : contentOrPayload.video_media_id
    if (rawVideoMediaId != null) {
      videoMediaId = rawVideoMediaId as number
    }
  } else {
    content = contentOrPayload != null ? ('' + contentOrPayload).trim() : ''
    photos = photosArg != null ? photosArg : []
    location = locationArg != null ? locationArg : ''
    topicId = topicIdArg
    visibility = visibilityArg
  }

  const hasImageMediaIds = imageMediaIds != null && imageMediaIds.length > 0
  const hasVideoMediaId = videoMediaId != null && videoMediaId > 0
  const hasPhotos = photos != null && photos.length > 0
  const hasVideos = videos != null && videos.length > 0
  if (content.length == 0 && !hasPhotos && !hasVideos && !hasImageMediaIds && !hasVideoMediaId) {
    return failRes('请添加正文或图片、视频后再发布', 'EMPTY_CONTENT')
  }
  if ((hasPhotos || hasImageMediaIds) && (hasVideos || hasVideoMediaId)) {
    return failRes('图片与视频不能同时发布，请只保留一种媒体', 'INVALID_MEDIA')
  }
  if (hasVideos && videos.length > 1) {
    videos = [videos[0]]
  }
  if (hasPhotos && photos.length > 9) {
    photos = photos.slice(0, 9)
  }
  if (hasImageMediaIds && imageMediaIds.length > 9) {
    imageMediaIds = imageMediaIds.slice(0, 9)
  }

  if (USE_MOCK) {
    let topicTitle = ''
    let topic: any = null
    if (topicId > 0) {
      topic = findTopic(topicId)
      if (topic == null) {
        return failRes('话题不存在', 404)
      }
      if (topic.title != null) {
        topicTitle = '' + topic.title
      }
    }
    // media ids 优先：从 mock 上传表解析 url，避免发布后 photos/videos 为空
    let finalPhotos: string[] = hasPhotos ? (photos != null ? photos : []) : []
    let finalVideos: string[] = hasVideos ? (videos != null ? videos : []) : []
    let mediaType = hasVideos ? 'video' : (hasPhotos ? 'image' : 'none')
    if (hasVideoMediaId) {
      const vEntry = resolveMockMediaEntry(videoMediaId)
      if (vEntry != null && vEntry.url != null && ('' + vEntry.url) != '') {
        finalVideos = ['' + vEntry.url]
        finalPhotos = []
        mediaType = 'video'
      }
    } else if (hasImageMediaIds) {
      const resolved = resolveMockMediaUrls(imageMediaIds)
      if (resolved.length > 0) {
        finalPhotos = resolved
        finalVideos = []
        mediaType = 'image'
      }
    }
    if (mediaType == 'video') {
      finalPhotos = []
    } else if (mediaType == 'image') {
      finalVideos = []
    }
    const dynamicId = Date.now()
    const cityName = location != '' ? ('' + location).split('·')[0].trim() : mockCurrentCity.name
    const item = {
      id: dynamicId,
      user: {
        id: 9001,
        avatar: '/static/portraits/profile-man-light.webp',
        name: '顾言澄',
        age: 29,
        gender: '男',
        birthYear: 1997,
        ipLocation: '江苏',
        income: '',
        city: mockCurrentCity.name,
        height: '178cm',
        job: '产品经理',
        education: '本科',
        verified: true,
        realNameStatus: 'passed',
        educationStatus: 'missing'
      },
      content: content,
      photos: finalPhotos,
      media: finalPhotos,
      videos: finalVideos,
      mediaType: mediaType,
      location: location,
      cityTag: cityName == mockCurrentCity.name,
      city: cityName,
      topicId: topicId > 0 ? topicId : null,
      topicTitle: topicTitle,
      relationTags: [],
      tags: declaration != '' ? [declaration] : [],
      declaration: declaration,
      time: Date.now(),
      timeText: '刚刚',
      likeCount: 0,
      commentCount: 0,
      collectCount: 0,
      liked: false,
      collected: false,
      followed: false,
      applyStatus: 'none',
      tabs: ['discover', cityName == mockCurrentCity.name ? 'city' : 'discover'],
      tab: 'discover',
      comments: [],
      visibility: visibility
    }
    ;(mockDynamicList as any[]).unshift(item)
    if (topicId > 0 && topic != null) {
      topic.postCount = ((topic.postCount as number) || 0) + 1
      markTopicParticipation(topic)
    }
    return request({
      url: '/community/dynamic/publish',
      cloudFunctionName: 'community',
      action: 'publishDynamic',
      method: 'POST',
      data: {
        content: content,
        photos: finalPhotos,
        videos: finalVideos,
        mediaType: mediaType,
        topicTitle: topicTitle,
        location: location,
        topicId: topicId,
        visibility: visibility,
        declaration: declaration
      },
      mockData: { success: true, dynamicId: dynamicId, dynamic: item }
    })
  }

  const body: any = {
    content: content,
    images: hasVideos || hasVideoMediaId ? [] : (photos != null ? photos : []),
    video: hasVideos && videos.length > 0 ? videos[0] : null,
    location: location != '' ? location : null,
    topic_id: topicId > 0 ? topicId : null,
    visibility: visibility,
    declaration: declaration
  }
  // 优先走已上传的 media ids；有 ids 时不硬拦临时路径
  if (hasImageMediaIds || hasVideoMediaId) {
    body.image_media_ids = hasImageMediaIds ? imageMediaIds : []
    body.video_media_id = hasVideoMediaId ? videoMediaId : null
    body.images = []
    body.video = null
    // media-only: content 允许空字符串（后端已支持）
    body.content = content
  } else {
    // 旧路径：若仍是临时路径则 MEDIA_UPLOAD_REQUIRED（应先 uploadCommunityMedia）
    const selectedMedia = hasVideos ? videos : photos
    for (let i = 0; i < selectedMedia.length; i++) {
      if (isTemporaryMediaPath(selectedMedia[i])) {
        return failRes('图片和视频上传服务尚未接入，暂不能发布媒体动态', 'MEDIA_UPLOAD_REQUIRED')
      }
    }
    if (content.length == 0) {
      body.content = hasVideos ? '[视频动态]' : '[图片动态]'
    }
  }
  const key = idempotencyKey('post', suppliedCreateKey)
  const res = await request({
    url: '/community/posts',
    method: 'POST',
    data: body,
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) {
    if (isConfirmedWriteRejection(res)) {
      return failRes(extractHttpMessage(res, '发布失败，请重试'), res.code, { idempotencyRejected: true })
    }
    return res
  }
  if (res.data != null && res.data.success == false) {
    return okRes({ success: false, idempotencyRejected: true, message: res.data.message != null ? res.data.message : '发布失败，请重试' })
  }
  const dynamic = mapPost(res.data)
  return okRes({
    success: true,
    dynamicId: dynamic != null ? dynamic.id : 0,
    dynamic: dynamic
  })
}

export async function likeDynamic(dynamicId: number) {
  if (USE_MOCK) {
    const item = findDynamic(dynamicId)
    if (item != null) {
      item.liked = !item.liked
      item.likeCount = (item.likeCount as number) + (item.liked ? 1 : -1)
    }
    return request({
      url: '/community/dynamic/like',
      cloudFunctionName: 'community',
      action: 'likeDynamic',
      method: 'POST',
      data: { dynamicId },
      mockData: {
        success: true,
        liked: item != null ? item.liked : true,
        likeCount: item != null ? item.likeCount : 0
      }
    })
  }

  // 先取当前状态再 toggle；详情预检失败不默认 PUT
  const detail = await request({
    url: '/community/posts/' + dynamicId,
    method: 'GET'
  })
  if (!detail.success || detail.data == null) {
    return failRes(extractHttpMessage(detail, '动态加载失败，无法点赞'), detail.code)
  }
  const currentlyLiked = detail.data.is_liked == true
  const method = currentlyLiked ? 'DELETE' : 'PUT'
  const res = await request({
    url: '/community/posts/' + dynamicId + '/like',
    method: method,
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    liked: raw != null && raw.is_liked == true,
    likeCount: raw != null && raw.like_count != null ? raw.like_count : 0
  })
}

/** 生成帖子分享内容；分享本身不改变帖子互动计数。 */
export async function shareDynamic(dynamicId: number) {
  if (dynamicId <= 0) return failRes('动态不存在', 404)
  if (USE_MOCK) {
    const item = findDynamic(dynamicId)
    if (item == null) return failRes('动态不存在', 404)
    return request({
      url: '/community/dynamic/share',
      cloudFunctionName: 'community',
      action: 'shareDynamic',
      method: 'POST',
      data: { dynamicId },
      mockData: { success: true, dynamicId, sharePath: '/pagesSub/community/post-detail?id=' + dynamicId }
    })
  }
  const res = await request({
    url: '/community/posts/' + dynamicId + '/share',
    method: 'POST',
    data: {}
  })
  if (!res.success) return res
  return okRes({
    success: true,
    dynamicId,
    sharePath: res.data != null && res.data.share_path != null ? res.data.share_path : '/pagesSub/community/post-detail?id=' + dynamicId
  })
}

export async function likeComment(commentId: number, currentlyLiked: boolean = false) {
  if (USE_MOCK) {
    const all = mockDynamicList as any[]
    let comment: any = null
    for (let i = 0; i < all.length && comment == null; i++) {
      const comments = all[i].comments != null ? (all[i].comments as any[]) : []
      for (let j = 0; j < comments.length; j++) {
        if (comments[j].id == commentId) {
          comment = comments[j]
          break
        }
      }
    }
    if (comment == null) return failRes('评论不存在', 404)

    const liked = !currentlyLiked
    const currentCount = comment.likeCount != null ? Number(comment.likeCount) : 0
    comment.liked = liked
    comment.likeCount = Math.max(0, currentCount + (liked ? 1 : -1))
    return request({
      url: '/community/comments/' + commentId + '/like',
      cloudFunctionName: 'community',
      action: 'likeComment',
      method: currentlyLiked ? 'DELETE' : 'PUT',
      data: { commentId },
      mockData: {
        success: true,
        liked: liked,
        likeCount: comment.likeCount,
        is_liked: liked,
        like_count: comment.likeCount,
        comment: comment
      }
    })
  }

  const method = currentlyLiked ? 'DELETE' : 'PUT'
  const res = await request({
    url: '/community/comments/' + commentId + '/like',
    method: method,
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    liked: raw != null && raw.is_liked == true,
    likeCount: raw != null && raw.like_count != null ? raw.like_count : 0,
    comment: raw != null ? mapComment(raw) : null
  })
}

/** 收藏动态；真实 API 先读取当前状态，避免重复写入导致计数漂移。 */
export async function collectDynamic(dynamicId: number) {
  if (dynamicId <= 0) return failRes('动态不存在', 404)
  if (USE_MOCK) {
    const item = findDynamic(dynamicId)
    if (item == null) return failRes('动态不存在', 404)
    item.collected = item.collected !== true
    const previous = item.collectCount != null ? Number(item.collectCount) : 0
    item.collectCount = Math.max(0, previous + (item.collected ? 1 : -1))
    return request({
      url: '/community/dynamic/collect',
      cloudFunctionName: 'community',
      action: 'collectDynamic',
      method: 'POST',
      data: { dynamicId },
      mockData: { success: true, collected: item.collected, collectCount: item.collectCount }
    })
  }

  const detail = await request({ url: '/community/posts/' + dynamicId, method: 'GET' })
  if (!detail.success || detail.data == null) {
    return failRes(extractHttpMessage(detail, '动态加载失败，无法收藏'), detail.code)
  }
  const currentlyCollected = detail.data.is_collected == true
  const method = currentlyCollected ? 'DELETE' : 'PUT'
  const res = await request({
    url: '/community/posts/' + dynamicId + '/collect',
    method,
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    collected: raw != null && raw.is_collected == true,
    collectCount: raw != null && raw.collect_count != null ? raw.collect_count : 0
  })
}

export async function followUserFromCommunity(userId: number) {
  if (USE_MOCK) {
    const all = mockDynamicList as any[]
    for (let i = 0; i < all.length; i++) {
      if (all[i].user != null && all[i].user.id == userId) {
        all[i].followed = true
        if (all[i].tabs != null && all[i].tabs.indexOf('follow') < 0) {
          ;(all[i].tabs as any[]).push('follow')
        }
      }
    }
    return request({
      url: '/community/follow',
      cloudFunctionName: 'community',
      action: 'followUser',
      method: 'POST',
      data: { userId },
      mockData: { success: true, followed: true }
    })
  }

  const res = await request({
    url: '/users/' + userId + '/follow',
    method: 'PUT',
    data: {}
  })
  if (!res.success) return res
  return okRes({ success: true, followed: true })
}

/** 取消关注 */
export async function unfollowUserFromCommunity(userId: number) {
  if (USE_MOCK) {
    const all = mockDynamicList as any[]
    for (let i = 0; i < all.length; i++) {
      if (all[i].user != null && all[i].user.id == userId) {
        all[i].followed = false
        if (all[i].tabs != null) {
          const followTabIndex = (all[i].tabs as any[]).indexOf('follow')
          if (followTabIndex >= 0) (all[i].tabs as any[]).splice(followTabIndex, 1)
        }
      }
    }
    return request({
      url: '/community/unfollow',
      cloudFunctionName: 'community',
      action: 'unfollowUser',
      method: 'POST',
      data: { userId },
      mockData: { success: true, followed: false }
    })
  }

  const res = await request({
    url: '/users/' + userId + '/follow',
    method: 'DELETE',
    data: {}
  })
  if (!res.success) return res
  return okRes({ success: true, followed: false })
}

/** 删除自己的动态 */
export async function deleteDynamic(dynamicId: number) {
  if (USE_MOCK) {
    const all = mockDynamicList as any[]
    let idx = -1
    for (let i = 0; i < all.length; i++) {
      if (all[i].id == dynamicId) {
        idx = i
        break
      }
    }
    if (idx >= 0) {
      all.splice(idx, 1)
    }
    return request({
      url: '/community/dynamic/delete',
      cloudFunctionName: 'community',
      action: 'deleteDynamic',
      method: 'POST',
      data: { dynamicId },
      mockData: { success: true, dynamicId: dynamicId }
    })
  }

  const res = await request({
    url: '/community/posts/' + dynamicId,
    method: 'DELETE',
    data: {}
  })
  if (!res.success) return res
  return okRes({ success: true, dynamicId: dynamicId })
}

/** 删除自己的评论 */
export async function deleteComment(commentId: number, dynamicId: number = 0) {
  if (USE_MOCK) {
    if (dynamicId > 0) {
      const item = findDynamic(dynamicId)
      if (item != null && item.comments != null) {
        const comments = item.comments as any[]
        let cidx = -1
        for (let i = 0; i < comments.length; i++) {
          if (comments[i].id == commentId) {
            cidx = i
            break
          }
        }
        if (cidx >= 0) {
          comments.splice(cidx, 1)
          item.commentCount = Math.max(0, (item.commentCount as number) - 1)
        }
      }
    } else {
      const all = mockDynamicList as any[]
      for (let i = 0; i < all.length; i++) {
        const item = all[i]
        if (item.comments == null) continue
        const comments = item.comments as any[]
        for (let j = 0; j < comments.length; j++) {
          if (comments[j].id == commentId) {
            comments.splice(j, 1)
            item.commentCount = Math.max(0, (item.commentCount as number) - 1)
            break
          }
        }
      }
    }
    return request({
      url: '/community/comment/delete',
      cloudFunctionName: 'community',
      action: 'deleteComment',
      method: 'POST',
      data: { commentId, dynamicId },
      mockData: { success: true, commentId: commentId }
    })
  }

  const res = await request({
    url: '/community/comments/' + commentId,
    method: 'DELETE',
    data: {}
  })
  if (!res.success) return res
  return okRes({ success: true, commentId: commentId })
}

/**
 * 评论动态
 * 新签名：commentDynamic({ dynamicId, content, replyToCommentId? })
 * 兼容：commentDynamic(dynamicId, content, replyToId)
 */
export async function commentDynamic(
  dynamicIdOrPayload: any,
  contentArg: string = '',
  replyToIdArg: number = 0
) {
  let dynamicId = 0
  let content = ''
  let replyToCommentId = 0
  let suppliedCreateKey = ''

  if (dynamicIdOrPayload != null && typeof dynamicIdOrPayload === 'object') {
    dynamicId = dynamicIdOrPayload.dynamicId != null ? (dynamicIdOrPayload.dynamicId as number) : 0
    content = dynamicIdOrPayload.content != null ? ('' + dynamicIdOrPayload.content).trim() : ''
    replyToCommentId =
      dynamicIdOrPayload.replyToCommentId != null
        ? (dynamicIdOrPayload.replyToCommentId as number)
        : dynamicIdOrPayload.replyToId != null
          ? (dynamicIdOrPayload.replyToId as number)
          : 0
    suppliedCreateKey = dynamicIdOrPayload.idempotencyKey != null ? ('' + dynamicIdOrPayload.idempotencyKey) : ''
  } else {
    dynamicId = dynamicIdOrPayload as number
    content = contentArg != null ? ('' + contentArg).trim() : ''
    replyToCommentId = replyToIdArg
  }

  if (content.length == 0) {
    return failRes('请输入评论内容', 'EMPTY_CONTENT')
  }

  if (USE_MOCK) {
    const item = findDynamic(dynamicId)
    const comment = {
      id: Date.now(),
      user: {
        id: 9001,
        name: '顾言澄',
        avatar: '/static/portraits/profile-man-light.webp',
        realNameStatus: 'passed'
      },
      content,
      timeText: '刚刚',
      likeCount: 0,
      liked: false,
      replyTo: replyToCommentId > 0 ? replyToCommentId : null,
      replyToCommentId: replyToCommentId > 0 ? replyToCommentId : null
    }
    if (item != null) {
      if (item.comments == null) item.comments = []
      ;(item.comments as any[]).push(comment)
      item.commentCount = (item.commentCount as number) + 1
    }

    const notes = mockCommunityNotifications as any[]
    notes.unshift({
      id: Date.now() + 1,
      type: 'comment',
      title: '有人评论了动态',
      content: content.length > 24 ? content.substring(0, 24) + '…' : content,
      timeText: '刚刚',
      read: false,
      targetType: 'post',
      targetId: dynamicId
    })

    return request({
      url: '/community/dynamic/comment',
      cloudFunctionName: 'community',
      action: 'commentDynamic',
      method: 'POST',
      data: { dynamicId, content, replyToCommentId },
      mockData: { success: true, comment }
    })
  }

  const body: any = { content: content }
  if (replyToCommentId > 0) {
    body.parent_id = replyToCommentId
  }
  const key = idempotencyKey('comment', suppliedCreateKey)
  const res = await request({
    url: '/community/posts/' + dynamicId + '/comments',
    method: 'POST',
    data: body,
    headers: { 'Idempotency-Key': key }
  })
  if (!res.success) return res
  if (res.data != null && res.data.success == false) {
    return okRes({ success: false, message: res.data.message != null ? res.data.message : '发送失败，请重试' })
  }
  return okRes({ success: true, comment: mapComment(res.data) })
}

// ─── 举报 / 屏蔽 / 城市 ─────────────────────────────────────

export async function reportContent(targetType: string, targetId: number, reasonId: string, detail: string = '') {
  // 统一命名：历史 UI 可能传 paperPlane
  let normalizedType = targetType != null ? targetType : 'user'
  if (normalizedType == 'paperPlane') {
    normalizedType = 'paper_plane'
  }

  if (USE_MOCK) {
    return request({
      url: '/community/report',
      cloudFunctionName: 'community',
      action: 'reportContent',
      method: 'POST',
      data: { targetType: normalizedType, targetId, reasonId, detail },
      mockData: {
        success: true,
        message: '举报已提交，我们会尽快处理'
      }
    })
  }

  const reason = reasonId != null && reasonId != '' ? reasonId : 'other'
  const description = detail != null ? detail : ''

  // 内容轨：post / comment / paper_plane → POST /community/reports
  if (normalizedType == 'post' || normalizedType == 'comment' || normalizedType == 'paper_plane') {
    if (targetId <= 0) {
      return okRes({ success: false, message: '无法举报：缺少内容信息' })
    }
    const res = await request({
      url: '/community/reports',
      method: 'POST',
      data: {
        target_type: normalizedType,
        target_id: targetId,
        reason_id: reason,
        description,
        images: []
      }
    })
    if (!res.success) return res
    return okRes({
      success: true,
      message: '举报已提交，我们会尽快处理'
    })
  }

  // 用户轨：POST /security/reports/{userId}
  const res = await request({
    url: '/security/reports/' + targetId,
    method: 'POST',
    data: {
      type: reason,
      description,
      images: []
    }
  })
  if (!res.success) return res
  return okRes({
    success: true,
    message: '举报已提交，我们会尽快处理'
  })
}

export async function blockUser(userId: number) {
  if (USE_MOCK) {
    const ids = mockBlockedUserIds as number[]
    let exists = false
    for (let i = 0; i < ids.length; i++) {
      if (ids[i] == userId) {
        exists = true
        break
      }
    }
    if (!exists) {
      ids.push(userId)
    }
    return request({
      url: '/community/block',
      cloudFunctionName: 'community',
      action: 'blockUser',
      method: 'POST',
      data: { userId },
      mockData: {
        success: true,
        message: '已屏蔽该用户，其内容将不再展示'
      }
    })
  }

  const res = await request({
    url: '/security/blocks/' + userId,
    method: 'PUT',
    data: {}
  })
  if (!res.success) return res
  return okRes({
    success: true,
    message: '已屏蔽该用户，其内容将不再展示'
  })
}

export async function getReportReasons() {
