/**
 * 社区相关 API
 * 主 Tab：follow / city / discover；二级 filter：
 * follow=all|following|likedUsers；city=all|hot|latest；discover=all|mbti|alumni
 * 互动门槛由页面侧 guardRealName 控制（仅实名）
 *
 * USE_MOCK=true 走本地 mock；false 时走 FastAPI `/api/v1`（见 config.uts）
 */

import { request } from './request.uts'
import { getMyLikedProfiles as getMyLikedProfilesFromUser, getMeProfile } from './user.uts'
import { USE_MOCK, API_BASE_URL, API_PREFIX, getAccessToken, clearAuthTokens, buildApiUrl, resolveMediaUrl } from './config.uts'
import { redeemPointProduct } from './points.uts'
import {
  mockDynamicList,
  mockTopics,
  mockPaperPlanes,
  mockPaperPlaneConversations,
  mockActivities,
  mockCommunityBanners,
  mockCommunityNotifications,
  mockReportReasons,
  mockBlockedUserIds,
  mockApplyStates,
  mockLikedUserIds,
  mockCurrentCity,
  mockMeProfile,
  mockCommunityQuotas
} from '@/mock'


const PAPER_PLANE_STORAGE_KEY = 'xsa_paper_plane_state_v1'
const PAPER_PLANE_PROFILE_UNLOCK_STORAGE_KEY = 'xsa_paper_plane_profile_unlocks_v1'
export const PAPER_PLANE_PROFILE_UNLOCK_COST = 80
const PAPER_PLANE_FREE_TIMES = 3
let paperPlaneStateLoaded = false
let paperPlaneStateDateKey = ''

/** mock 媒体 id → { url, mediaType, purpose }，供 publish/send 解析 */
const mockCommunityMediaById: any = {}

function guessMockMediaType(filePath: string): string {
  const p = (filePath != null ? ('' + filePath) : '').toLowerCase()
  if (
    p.indexOf('.mp4') >= 0 ||
    p.indexOf('.mov') >= 0 ||
    p.indexOf('.m4v') >= 0 ||
    p.indexOf('.webm') >= 0 ||
    p.indexOf('video') >= 0
  ) {
    return 'video'
  }
  return 'image'
}

function resolveMockMediaUrls(mediaIds: number[]): string[] {
  const urls: string[] = []
  if (mediaIds == null) return urls
  for (let i = 0; i < mediaIds.length; i++) {
    const id = mediaIds[i]
    if (id == null || id <= 0) continue
    const entry = mockCommunityMediaById['' + id]
    if (entry != null && entry.url != null && ('' + entry.url) != '') {
      urls.push('' + entry.url)
    }
  }
  return urls
}

function resolveMockMediaEntry(mediaId: number): any {
  if (mediaId == null || mediaId <= 0) return null
  const entry = mockCommunityMediaById['' + mediaId]
  return entry != null ? entry : null
}

function currentDateKey(): string {
  const now = new Date()
  const month = now.getMonth() + 1
  const day = now.getDate()
  const monthText = month < 10 ? '0' + month : '' + month
  const dayText = day < 10 ? '0' + day : '' + day
  return now.getFullYear() + '-' + monthText + '-' + dayText
}

function savePaperPlaneState() {
	const quotas = mockCommunityQuotas as any
	uni.setStorageSync(PAPER_PLANE_STORAGE_KEY, {
		dateKey: currentDateKey(),
		planes: mockPaperPlanes,
		conversations: mockPaperPlaneConversations,
		paperPlaneDaily: quotas.paperPlaneDaily,
		points: mockMeProfile.points
	})
}

function resetPaperPlaneDaily() {
	const daily = (mockCommunityQuotas as any).paperPlaneDaily
	daily.total = PAPER_PLANE_FREE_TIMES
	daily.used = 0
	daily.remain = PAPER_PLANE_FREE_TIMES
	daily.purchasedThrow = 0
	daily.purchasedCatch = 0
}

function syncPaperPlanePoints() {
	const points = mockMeProfile.points
	try {
		const chatSaved = uni.getStorageSync('xsa_chat_feature_unlocks_v1') as any
		const chatState = chatSaved != null && typeof chatSaved === 'object'
			? chatSaved
			: { album: false, camera: false, profile: false }
		chatState.points = points
		uni.setStorageSync('xsa_chat_feature_unlocks_v1', chatState)
	} catch (e) {
		console.error('同步纸飞机积分失败', e)
	}
}

function restorePaperPlaneState() {
  const today = currentDateKey()
	if (paperPlaneStateLoaded) {
		if (paperPlaneStateDateKey != today) {
			resetPaperPlaneDaily()
			paperPlaneStateDateKey = today
			savePaperPlaneState()
    }
    return
  }
  paperPlaneStateLoaded = true
  paperPlaneStateDateKey = today

  try {
    const saved = uni.getStorageSync(PAPER_PLANE_STORAGE_KEY) as any
    if (saved == null || typeof saved !== 'object') return

    if (saved.planes != null && Array.isArray(saved.planes)) {
      const target = mockPaperPlanes as any[]
      target.splice(0, target.length)
      ;(saved.planes as any[]).forEach((item: any) => target.push(item))
    }

    if (saved.conversations != null && Array.isArray(saved.conversations)) {
      const target = mockPaperPlaneConversations as any[]
      target.splice(0, target.length)
      ;(saved.conversations as any[]).forEach((item: any) => target.push(item))
    }

		const quotas = mockCommunityQuotas as any
		if (saved.dateKey == today && saved.paperPlaneDaily != null) {
			const daily = saved.paperPlaneDaily as any
			const purchasedThrow = daily.purchasedThrow != null ? Math.max(0, Number(daily.purchasedThrow)) : 0
			const purchasedCatch = daily.purchasedCatch != null ? Math.max(0, Number(daily.purchasedCatch)) : 0
			quotas.paperPlaneDaily.total = PAPER_PLANE_FREE_TIMES + purchasedThrow
			quotas.paperPlaneDaily.remain = daily.remain != null
				? Math.max(0, Math.min(quotas.paperPlaneDaily.total, Number(daily.remain)))
				: quotas.paperPlaneDaily.total
			quotas.paperPlaneDaily.used = quotas.paperPlaneDaily.total - quotas.paperPlaneDaily.remain
			quotas.paperPlaneDaily.purchasedThrow = purchasedThrow
			quotas.paperPlaneDaily.purchasedCatch = purchasedCatch
			if (saved.points != null && Number(saved.points) >= 0) {
				mockMeProfile.points = Number(saved.points)
				syncPaperPlanePoints()
			}
		} else {
			resetPaperPlaneDaily()
			savePaperPlaneState()
    }
  } catch (e) {
    console.error('恢复纸飞机本地状态失败', e)
  }
}

// ─── 通用工具 ───────────────────────────────────────────────

function cloneList(list: any[]): any[] {
  const out: any[] = []
  for (let i = 0; i < list.length; i++) {
    out.push(list[i])
  }
  return out
}

function toMs(raw: any): number {
  if (raw == null) return Date.now()
  if (typeof raw === 'number') {
    return raw < 100000000000 ? raw * 1000 : raw
  }
  const s = '' + raw
  const t = Date.parse(s)
  if (!isNaN(t)) return t
  return Date.now()
}

function timeTextFrom(raw: any): string {
  const ms = toMs(raw)
  const diff = Date.now() - ms
  if (diff < 60 * 1000) return '刚刚'
  if (diff < 60 * 60 * 1000) return Math.floor(diff / 60000) + ' 分钟前'
  if (diff < 24 * 60 * 60 * 1000) return Math.floor(diff / 3600000) + ' 小时前'
  if (diff < 7 * 24 * 60 * 60 * 1000) return Math.floor(diff / 86400000) + ' 天前'
  const d = new Date(ms)
  const m = d.getMonth() + 1
  const day = d.getDate()
  return m + '/' + day
}

function genderText(g: any): string {
  if (g == 1 || g == '1' || g == '男') return '男'
  if (g == 2 || g == '2' || g == '女') return '女'
  return ''
}

function failRes(message: string, code: any = -1, extra: any = null): any {
  const data: any = { success: false, code: code, message: message }
  if (extra != null) {
    const keys = Object.keys(extra)
    for (let i = 0; i < keys.length; i++) {
      data[keys[i]] = extra[keys[i]]
    }
  }
  return {
    success: false,
    data: data,
    code: code,
    message: message
  }
}

function okRes(data: any): any {
  return {
    success: true,
    data: data,
    code: 0,
    message: 'success'
  }
}

function extractHttpMessage(res: any, fallback: string): string {
  if (res == null) return fallback
  if (res.message != null && res.message != '' && res.message != '请求失败') {
    return '' + res.message
  }
  const raw = res.data
  if (raw != null && raw.detail != null) {
    if (typeof raw.detail === 'string') return '' + raw.detail
  }
  return fallback
}

export function createCommunityCreateKey(scope: string): string {
  return scope + '-' + Date.now() + '-' + Math.random().toString(36).substring(2)
}

export function discardCommunityCreateKey(key: string): void {
  if (key == null || key == '') return
}

function realNameStatusFrom(raw: any): string {
  const status = raw != null ? Number(raw) : 0
  if (status == 2) return 'passed'
  if (status == 1 || status == 4) return 'reviewing'
  if (status == 3) return 'rejected'
  if (status == 5) return 'revoked'
  return 'missing'
}

function idempotencyKey(scope: string, callerKey: string = ''): string {
  if (callerKey != '') return callerKey
  return createCommunityCreateKey(scope)
}

function isConfirmedWriteRejection(res: any): boolean {
  if (res == null) return false
  if (res.success == false) return res.code != null && res.code != -1
  return res.data != null && res.data.success == false
}

function isTemporaryMediaPath(value: string): boolean {
  return value.indexOf('wxfile://') == 0 || value.indexOf('file://') == 0 || value.indexOf('temp://') == 0 || value.indexOf('/') == 0 || /^[A-Za-z]:[\\/]/.test(value)
}

// ─── Mock helpers ───────────────────────────────────────────

function findDynamic(dynamicId: number): any {
  const all = mockDynamicList as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].id == dynamicId) return all[i]
  }
  return null
}

function findTopic(topicId: number): any {
  const all = mockTopics as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].id == topicId) return all[i]
  }
  return null
}

function markTopicParticipation(topic: any): void {
  if (topic == null || topic.joined == true) return
  topic.joined = true
  topic.participantCount = ((topic.participantCount as number) || 0) + 1
}

function unmarkTopicParticipation(topic: any): void {
  if (topic == null || topic.joined != true) return
  topic.joined = false
  topic.participantCount = Math.max(0, ((topic.participantCount as number) || 0) - 1)
}

function findActivity(activityId: number): any {
  const all = mockActivities as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].id == activityId) return all[i]
  }
  return null
}

function isBlocked(userId: number): boolean {
  const ids = mockBlockedUserIds as number[]
  for (let i = 0; i < ids.length; i++) {
    if (ids[i] == userId) return true
  }
  return false
}

function applyStatusForUser(userId: number, fallback: string = 'none'): string {
  const key = '' + userId
  const map = mockApplyStates as any
  if (map[key] != null) return map[key] as string
  return fallback
}

function syncApplyOnDynamics(userId: number, status: string) {
  const all = mockDynamicList as any[]
  for (let i = 0; i < all.length; i++) {
    if (all[i].user != null && all[i].user.id == userId) {
      all[i].applyStatus = status
    }
  }
}

function notBlockedDynamic(d: any): boolean {
  if (d == null || d.user == null) return true
  return !isBlocked(d.user.id as number)
}

function isLikedUser(userId: number): boolean {
  const ids = mockLikedUserIds as number[]
  for (let i = 0; i < ids.length; i++) {
    if (ids[i] == userId) return true
  }
  return false
}

function schoolKey(raw: any): string {
  if (raw == null) return ''
  let s = '' + raw
  const cut = s.indexOf(' · ')
  if (cut >= 0) s = s.substring(0, cut)
  return s.trim()
}

function meProfile(): any {
  return mockMeProfile as any
}

function sortTopicsByHeat(list: any[]): any[] {
  return list.slice().sort((a: any, b: any) => {
    const ha = a.heat != null ? (a.heat as number) : ((a.participantCount as number) || 0) * 10 + ((a.postCount as number) || 0)
    const hb = b.heat != null ? (b.heat as number) : ((b.participantCount as number) || 0) * 10 + ((b.postCount as number) || 0)
    return hb - ha
  })
}

function sortTopicsByCreated(list: any[]): any[] {
  return list.slice().sort((a: any, b: any) => {
    return ((b.createdAt as number) || 0) - ((a.createdAt as number) || 0)
  })
}

function excludeTopicIds(list: any[], excludeIds: any): any[] {
  if (excludeIds == null || !Array.isArray(excludeIds) || excludeIds.length == 0) return list
  const ban: any = {}
  for (let i = 0; i < excludeIds.length; i++) {
    ban['' + excludeIds[i]] = true
  }
  return list.filter((t: any) => ban['' + t.id] != true)
}

function resolveTabValue(raw: any): string {
  if (typeof raw === 'number') {
    if (raw == 2) return 'city'
    if (raw == 3) return 'follow'
    if (raw == 1) return 'liked'
    return 'discover'
  }
  if (typeof raw === 'string' && raw != '') {
    return raw
  }
  return 'discover'
}

function normalizeCityName(raw: any): string {
		  const name = raw != null ? ('' + raw).trim() : ''
		  if (name == '' || name == '未设置') return ''
		  return name
		}

		/** 市一级 6 位码；与 BE normalize_city_code / 硬编码城市表对齐 */
		function normalizeCityCode(raw: any): string {
			const c = raw != null ? ('' + raw).trim() : ''
			if (c == '' || c == 'null' || c == 'undefined') return ''
			if (c.length == 4 && /^\d+$/.test(c)) return c + '00'
			return c
		}

		/** 社区切换城市用：name + 6 位市码 */
		export const COMMUNITY_CITY_OPTIONS: any[] = [
			{ name: '南京', code: '320100' },
			{ name: '杭州', code: '330100' },
			{ name: '上海', code: '310100' },
			{ name: '苏州', code: '320500' },
			{ name: '宁波', code: '330200' }
		]

		function cityCodeFromName(name: string): string {
			const n = normalizeCityName(name)
			if (n == '') return ''
			for (let i = 0; i < COMMUNITY_CITY_OPTIONS.length; i++) {
				const opt = COMMUNITY_CITY_OPTIONS[i]
				if (opt != null && (opt.name == n || opt.name + '市' == n || n == opt.name + '市')) {
					return opt.code != null ? ('' + opt.code) : ''
				}
			}
			return ''
		}

		function normalizeListQuery(input: any, pageArg: number = 1): any {
		  if (input != null && typeof input === 'object' && !Array.isArray(input)) {
		    const tabName = resolveTabValue(input.tab)
		    const filterName = input.filter != null ? ('' + input.filter) : 'all'
		    const pageNum = input.page != null ? (input.page as number) : 1
		    const sizeNum = input.pageSize != null ? (input.pageSize as number) : 10
		    // 真路径缺省不传假城市；Mock 才回落 mockCurrentCity
		    let cityName = normalizeCityName(input.city)
		    let cityCode = normalizeCityCode(input.cityCode != null ? input.cityCode : input.city_code)
		    if (cityName == '' && USE_MOCK) {
		      cityName = mockCurrentCity.name
		    }
		    if (cityCode == '' && cityName != '') {
		      cityCode = cityCodeFromName(cityName)
		    }
		    if (cityCode == '' && USE_MOCK && mockCurrentCity.code != null) {
		      cityCode = normalizeCityCode(mockCurrentCity.code)
		    }
		    return {
		      tab: tabName,
		      filter: filterName,
		      page: pageNum,
		      pageSize: sizeNum,
		      city: cityName,
		      cityCode: cityCode
		    }
		  }
		  const tabName = resolveTabValue(input)
		  return {
		    tab: tabName,
		    filter: 'all',
		    page: pageArg > 0 ? pageArg : 1,
		    pageSize: 10,
		    city: USE_MOCK ? mockCurrentCity.name : '',
		    cityCode: USE_MOCK && mockCurrentCity.code != null ? normalizeCityCode(mockCurrentCity.code) : ''
		  }
	}

function filterDynamics(tab: string, filter: string, city: string): any[] {
  const all = (mockDynamicList as any[]).filter(notBlockedDynamic)
  for (let i = 0; i < all.length; i++) {
    if (all[i].user != null) {
      all[i].applyStatus = applyStatusForUser(all[i].user.id as number, all[i].applyStatus || 'none')
    }
  }

  const me = meProfile()
  const meSchool = schoolKey(me != null ? me.school : '')

  let filtered: any[] = all
  if (tab == 'follow') {
    if (filter == 'following') {
      filtered = all.filter((d: any) => {
        return d.followed == true || (d.tabs != null && d.tabs.indexOf('follow') >= 0)
      })
    } else if (filter == 'likedUsers') {
      filtered = all.filter((d: any) => {
        return d.user != null && isLikedUser(d.user.id as number)
      })
    } else {
      const map: any = {}
      const out: any[] = []
      for (let i = 0; i < all.length; i++) {
        const d = all[i]
        const followed = d.followed == true || (d.tabs != null && d.tabs.indexOf('follow') >= 0)
        const likedU = d.user != null && isLikedUser(d.user.id as number)
        if (!followed && !likedU) continue
        const key = '' + d.id
        if (map[key] == true) continue
        map[key] = true
        out.push(d)
      }
      filtered = out
    }
} else if (tab == 'city') {
	    // 与 BE 对齐：只按发帖 location/city 名，不用 cityTag/tabs 放宽
	    filtered = all.filter((d: any) => {
	      const loc = d.location != null ? ('' + d.location).trim() : ''
	      const dCity = d.city != null ? ('' + d.city).trim() : ''
	      if (city == '') return false
	      if (loc == city || dCity == city) return true
	      if (loc.indexOf(city) == 0) return true
	      return false
	    })
    if (filter == 'hot') {
      filtered = filtered.slice().sort((a: any, b: any) => {
        return ((b.likeCount as number) || 0) - ((a.likeCount as number) || 0)
      })
    } else if (filter == 'latest') {
      filtered = filtered.slice().sort((a: any, b: any) => {
        return ((b.time as number) || 0) - ((a.time as number) || 0)
      })
    }
  } else {
    filtered = all.filter((d: any) => {
      return (
        d.tab == 'discover' ||
        d.tab == null ||
        (d.tabs != null && d.tabs.indexOf('discover') >= 0)
      )
    })
    if (filtered.length == 0) filtered = all

    if (filter == 'mbti') {
      filtered = filtered.filter((d: any) => d.user != null && d.user.mbti != null && ('' + d.user.mbti) != '')
    } else if (filter == 'alumni') {
      filtered = filtered.filter((d: any) => {
        if (d.user == null) return false
        const s = schoolKey(d.user.school)
        return s != '' && meSchool != '' && s == meSchool
      })
    }
  }

  return filtered
}

// ─── Real API adapters (snake_case → 页面 camelCase) ────────

function resolveMediaUrlList(raw: any): string[] {
  const values = Array.isArray(raw) ? (raw as any[]) : []
  const urls: string[] = []
  for (let i = 0; i < values.length; i++) {
    const url = resolveMediaUrl(values[i])
    if (url != '') urls.push(url)
  }
  return urls
}

function mapPost(row: any): any {
  if (row == null) return null
  const video = row.video != null ? resolveMediaUrl(row.video) : ''
  const hasVideo = video != ''
  const photos: string[] = hasVideo ? [] : resolveMediaUrlList(row.images)
  const videos: string[] = hasVideo ? [video] : []
  const likeAvatars = resolveMediaUrlList(row.like_avatars != null ? row.like_avatars : row.likeAvatars)
  const created = row.created_at != null ? row.created_at : row.createdAt
  const city = row.residence != null ? ('' + row.residence) : (row.location != null ? ('' + row.location) : '')
  const realNameStatus = realNameStatusFrom(row.realname_status)
  return {
    id: row.id,
    user: {
      id: row.user_id != null ? row.user_id : row.userId,
      avatar: row.avatar != null ? resolveMediaUrl(row.avatar) : '',
      name: row.nickname != null ? row.nickname : '用户',
      age: row.age != null ? row.age : 0,
      city: city,
      height: '',
      job: '',
      education: '',
      school: row.school != null ? row.school : '',
      mbti: row.mbti != null ? row.mbti : '',
      hometown: row.hometown != null ? row.hometown : '',
      gender: genderText(row.gender),
      verified: realNameStatus == 'passed',
      realNameStatus: realNameStatus,
      educationStatus: 'missing'
    },
    content: row.content != null ? row.content : '',
    photos: photos,
    media: photos,
    videos: videos,
    mediaType: hasVideo ? 'video' : (photos.length > 0 ? 'image' : 'none'),
    location: row.location != null ? row.location : '',
    cityTag: false,
    city: city,
    topicId: row.topic_id != null ? row.topic_id : null,
    topicTitle: row.topic_name != null ? row.topic_name : '',
    relationTags: [],
    tags: [],
    declaration: row.declaration != null ? row.declaration : '',
    time: toMs(created),
    timeText: timeTextFrom(created),
    likeCount: row.like_count != null ? row.like_count : 0,
    commentCount: row.comment_count != null ? row.comment_count : 0,
    collectCount: row.collect_count != null ? row.collect_count : 0,
    liked: row.is_liked == true,
    collected: row.is_collected == true,
    followed: row.is_followed == true,
    applyStatus: 'none',
    likeAvatars: likeAvatars,
    tabs: ['discover'],
    tab: 'discover',
    comments: [],
    visibility: row.visibility != null ? row.visibility : 0
  }
}

function mapComment(row: any): any {
  if (row == null) return null
  const rawUser = row.user != null ? row.user : {}
  const replyToUser = row.reply_to_user != null ? row.reply_to_user : (row.replyToUser != null ? row.replyToUser : null)
  return {
    id: row.id,
    user: {
      id: row.user_id != null ? row.user_id : rawUser.id,
      name: row.nickname != null ? row.nickname : (rawUser.name != null ? rawUser.name : '用户'),
      avatar: row.avatar != null ? resolveMediaUrl(row.avatar) : (rawUser.avatar != null ? resolveMediaUrl(rawUser.avatar) : ''),
      realNameStatus: 'missing'
    },
    content: row.content != null ? row.content : '',
    timeText: row.timeText != null ? row.timeText : timeTextFrom(row.created_at),
    likeCount: row.like_count != null ? row.like_count : (row.likeCount != null ? row.likeCount : 0),
    liked: row.is_liked == true || row.liked == true,
    replyTo: row.parent_id != null ? row.parent_id : null,
    replyToCommentId: row.target_comment_id != null ? row.target_comment_id : (row.parent_id != null ? row.parent_id : null),
    rootId: row.root_id != null ? row.root_id : (row.rootId != null ? row.rootId : row.id),
    replyCount: row.reply_count != null ? row.reply_count : (row.replyCount != null ? row.replyCount : 0),
    isDeleted: row.is_deleted == true || row.isDeleted == true,
    canDelete: row.can_delete == true || row.canDelete == true,
    replyToUserId: row.target_user_id != null ? row.target_user_id : (row.replyToUserId != null ? row.replyToUserId : 0),
    replyToUserName: typeof replyToUser === 'string' ? replyToUser : (replyToUser != null && replyToUser.nickname != null ? replyToUser.nickname : (replyToUser != null && replyToUser.name != null ? replyToUser.name : '')),
    replies: []
  }
}

function mapTopic(row: any): any {
  if (row == null) return null
  const name = row.name != null ? ('' + row.name) : ''
  const title = name != '' ? name : '话题'
  return {
    id: row.id,
    tag: name.indexOf('#') == 0 ? name : '# ' + title,
    title: title,
    name: title,
    description: '',
    cover: row.icon != null ? resolveMediaUrl(row.icon) : '',
    icon: row.icon != null ? resolveMediaUrl(row.icon) : '',
    participantCount: row.participant_count != null ? row.participant_count : 0,
    postCount: row.post_count != null ? row.post_count : 0,
    viewCount: 0,
    heat: row.heat != null ? row.heat : 0,
    createdAt: toMs(row.created_at),
    isHot: (row.heat != null ? (row.heat as number) : 0) >= 5000,
    joined: row.joined == true,
    rules: [],
    sort: row.sort != null ? row.sort : 0
  }
}

function mapActivity(row: any): any {
  if (row == null) return null
  const start = row.start_time != null ? row.start_time : null
  const startMs = toMs(start)
  const d = new Date(startMs)
  const y = d.getFullYear()
  const m = (d.getMonth() + 1 < 10 ? '0' : '') + (d.getMonth() + 1)
  const day = (d.getDate() < 10 ? '0' : '') + d.getDate()
  const hh = (d.getHours() < 10 ? '0' : '') + d.getHours()
  const mm = (d.getMinutes() < 10 ? '0' : '') + d.getMinutes()
  const statusText = row.status_text != null ? ('' + row.status_text) : 'recruiting'
  const myStatusText = row.my_status_text != null ? ('' + row.my_status_text) : 'none'
  const city = row.city != null ? ('' + row.city) : ''
  const address = row.address != null ? ('' + row.address) : ''
  let location = city
  if (address != '') {
    location = city != '' ? city + ' · ' + address : address
  } else if (city != '') {
    location = city + '（审核通过后告知集合点）'
  }
  return {
    id: row.id,
    title: row.title != null ? row.title : '',
    description: row.description != null ? row.description : '',
    cover: row.cover != null ? resolveMediaUrl(row.cover) : '',
    date: y + '-' + m + '-' + day,
    time: hh + ':' + mm,
    location: location,
    participantCount: row.current_people != null ? row.current_people : 0,
    maxParticipants: row.max_people != null ? row.max_people : 0,
    tags: row.type != null && ('' + row.type) != '' ? ['' + row.type] : [],
    organizer: { name: '宣誓爱活动组', avatar: '' },
    price: row.price != null ? row.price : 0,
    status: statusText,
    kicker: 'OFFLINE',
    safetyNotes: ['仅面向已实名用户报名', '集合点审核通过后告知'],
    myStatus: myStatusText == 'none' || myStatusText == '' ? 'none' : myStatusText
  }
}

function mapBanner(row: any): any {
  if (row == null) return null
  // 库表 config_banner.link_type 的合法值是 activity / url / miniprogram / none，
  // 并不包含 topic / plane。历史上运营位多为空值，空值沿用"话题"语义以兼容已有配置；
  // url / miniprogram / none 这些明确的外链类型按普通运营位渲染，不再误当作"热门话题"面板。
  const linkType = row.link_type != null ? ('' + row.link_type).trim() : ''
  let type = 'topic'
  if (linkType == 'activity' || linkType == 'offline') type = 'activity'
  else if (linkType == 'plane' || linkType == 'paper_plane' || linkType == 'paper-plane') type = 'plane'
  else if (linkType == 'topic' || linkType == '') type = 'topic'
  else type = 'feature'
  let targetId = 0
  const lv = row.link_value
  if (lv != null) {
    const n = parseInt('' + lv, 10)
    if (!isNaN(n)) targetId = n
  }
  return {
    id: row.id,
    type: type,
    title: row.title != null ? row.title : '',
    subtitle: '',
    description: '',
    cta: type == 'activity' ? '查看活动' : type == 'plane' ? '去放飞' : (type == 'topic' ? '进入话题' : '查看详情'),
    kicker: type == 'activity' ? 'OFFLINE' : type == 'plane' ? 'PLANE' : (type == 'topic' ? 'TOPIC' : 'FEATURE'),
    cover: row.image_url != null ? resolveMediaUrl(row.image_url) : '',
    targetId: targetId
  }
}

