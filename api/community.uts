  if (USE_MOCK) return okRes({ hide_online_status: false, notify_like: true, notify_comment: true, notify_follow: true, notify_message: true, notify_match: true, notify_activity: true })
  return request({ url: '/users/me/privacy', method: 'GET' })
}

