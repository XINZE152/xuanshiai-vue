export async function signupActivity(activityId: number) {
  if (USE_MOCK) {
    const item = findActivity(activityId)
    if (item != null) {
      if (item.myStatus == 'none' || item.myStatus == null) {
        item.myStatus = 'pending'
        item.participantCount = (item.participantCount as number) + 1
      }
    }
    const notes = mockCommunityNotifications as any[]
    notes.unshift({
      id: Date.now(),
      type: 'activity',
      title: '活动报名已提交',
      content: item != null ? item.title : '报名审核中',
      timeText: '刚刚',
      read: false,
      targetType: 'activity',
      targetId: activityId
    })
    return request({
      url: '/community/activity/signup',
      cloudFunctionName: 'community',
      action: 'signupActivity',
      method: 'POST',
      data: { activityId },
      mockData: {
        success: true,
        myStatus: item != null ? item.myStatus : 'pending',
        message: '报名已提交，审核通过后告知集合信息'
      }
    })
  }

  const res = await request({
    url: '/community/activities/' + activityId + '/signup',
    method: 'POST',
    data: {}
  })
  if (!res.success) return res
  const raw = res.data
  return okRes({
    success: true,
    myStatus: raw != null && raw.my_status_text != null ? raw.my_status_text : 'pending',
    message: raw != null && raw.message != null ? raw.message : '报名已提交，审核通过后告知集合信息'
  })
}

