/**
 * 统一请求封装
 * - USE_MOCK=true：返回 mockData
 * - USE_MOCK=false：HTTP 调 FastAPI（Bearer）
 */

import {
  USE_MOCK,
  API_CONFIG,
  MOCK_DELAY,
  getAccessToken,
  clearAuthTokens,
  buildApiUrl
} from './config.uts'

/**
 * 统一请求方法
 * options:
 *  - url: string 路径（/community/posts 或完整 http）
 *  - method: GET|POST|PUT|DELETE
 *  - data: query 或 body
 *  - mockData: Mock 模式返回值
 *  - headers: 额外请求头
 *  - skipAuth: 跳过 Authorization
 *  - raw: true 时不包 success 层（少用）
 */
export async function request(options: any) {
  if (USE_MOCK) {
    return mockRequest(options)
  }
  return httpRequest(options)
}

async function mockRequest(options: any) {
  console.log('📦 [Mock Request]', options.url, options.data)
  await sleep(MOCK_DELAY)
  // 允许 mock 侧直接给出失败包
  if (
    options.mockData != null &&
    typeof options.mockData === 'object' &&
    options.mockData.success === false
  ) {
    return {
      success: false,
      data: options.mockData,
      code: options.mockData.code != null ? options.mockData.code : -1,
      message: options.mockData.message != null ? options.mockData.message : 'error'
    }
  }
  return {
    success: true,
    data: options.mockData,
    code: 0,
    message: 'success'
  }
}

function extractDetail(data: any): string {
  if (data == null) return '请求失败'
  if (typeof data === 'string') return data
  if (data.detail != null) {
    if (typeof data.detail === 'string') return data.detail
    if (Array.isArray(data.detail) && data.detail.length > 0) {
      const first = data.detail[0]
      if (first != null && first.msg != null) return '' + first.msg
      return JSON.stringify(data.detail)
    }
  }
  if (data.message != null) return '' + data.message
  return '请求失败'
}

async function httpRequest(options: any) {
  const methodRaw = options.method != null ? ('' + options.method).toUpperCase() : 'GET'
  const method = methodRaw
  const urlPath = options.url != null ? ('' + options.url) : ''
  let url = buildApiUrl(urlPath)
  const headers: any = {
    'Content-Type': 'application/json'
  }
  if (options.headers != null) {
    const extra = options.headers
    const keys = Object.keys(extra)
    for (let i = 0; i < keys.length; i++) {
      headers[keys[i]] = extra[keys[i]]
    }
  }
  if (options.skipAuth != true) {
    const token = getAccessToken()
    if (token != '') {
      headers['Authorization'] = 'Bearer ' + token
    }
  }

  let body: any = null
	const timeout = options.timeout != null ? Number(options.timeout) : API_CONFIG.timeout
  const data = options.data
  if (method == 'GET' || method == 'DELETE') {
    if (data != null && typeof data === 'object') {
      const parts: string[] = []
      const keys = Object.keys(data)
      for (let i = 0; i < keys.length; i++) {
        const k = keys[i]
        const v = data[k]
        if (v == null) continue
        if (Array.isArray(v)) {
          for (let j = 0; j < v.length; j++) {
            parts.push(encodeURIComponent(k) + '=' + encodeURIComponent('' + v[j]))
          }
        } else {
          parts.push(encodeURIComponent(k) + '=' + encodeURIComponent('' + v))
        }
      }
      if (parts.length > 0) {
        url = url + (url.indexOf('?') >= 0 ? '&' : '?') + parts.join('&')
      }
    }
  } else {
    body = data != null ? data : {}
  }

  console.log('🌐 [HTTP Request]', method, url)

  return new Promise((resolve) => {
    uni.request({
      url: url,
      method: method as any,
      data: body,
      header: headers,
      timeout: timeout,
      success: (res: any) => {
        const status = res.statusCode != null ? (res.statusCode as number) : 0
        const raw = res.data
        if (status == 204) {
          resolve({ success: true, data: null, code: 0, message: 'success' })
          return
        }
        if (status >= 200 && status < 300) {
          resolve({
            success: true,
            data: raw,
            code: 0,
            message: 'success'
          })
          return
        }
        if (status == 401) {
          clearAuthTokens()
        }
        const message = extractDetail(raw)
        resolve({
          success: false,
          data: raw,
          code: status,
          message: message
        })
      },
      fail: (err: any) => {
        console.error('❌ [HTTP Error]', err)
        resolve({
          success: false,
          data: null,
          code: -1,
          message: err != null && err.errMsg != null ? err.errMsg : '网络请求失败'
        })
      }
    })
  })
}

function sleep(ms: number) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}
