import { request } from './request.uts'
import { USE_MOCK } from './config.uts'

export type RecommendationView = 'i_like' | 'likes_me' | 'similar'

function normalizeView(view: string): RecommendationView {
  if (view == 'likes_me') return 'likes_me'
  if (view == 'similar') return 'similar'
  return 'i_like'
}

function normalizeLimit(limit: number): number {
  const value = Number(limit)
  if (isNaN(value)) return 20
  return Math.max(1, Math.min(50, Math.floor(value)))
}

function mapRecommendationCard(raw: any): any {
  const item = raw != null ? raw : {}
  const reasonCodes: string[] = item.reason_codes != null && Array.isArray(item.reason_codes)
    ? item.reason_codes as string[]
    : []
  const reasonTexts: string[] = item.reason_texts != null && Array.isArray(item.reason_texts)
    ? item.reason_texts as string[]
    : []
  return {
    targetUserId: Number(item.target_user_id != null ? item.target_user_id : 0),
    score: item.score != null ? Number(item.score) : null,
    coverage: item.coverage != null ? Number(item.coverage) : null,
    rankNo: item.rank_no != null ? Number(item.rank_no) : 0,
    engine: item.engine != null ? '' + item.engine : '',
    reasonCodes,
    reasonTexts,
    card: item.card != null ? item.card : null,
    raw: item
  }
}

/**
 * 三类推荐返回候选 ID、解释与可选公开名片；不会批量调用完整主页接口。
 * regenerating 仅作为后台重建状态返回，不附带 task_id，也不在客户端自行轮询。
 */
export async function getAiRecommendations(view: RecommendationView | string = 'i_like', limit: number = 20): Promise<any> {
  const normalizedView = normalizeView('' + view)
  const normalizedLimit = normalizeLimit(limit)
  const res = await request({
    url: '/ai/recommendations',
    method: 'GET',
    data: { view: normalizedView, limit: normalizedLimit, include_card: true },
    mockData: { view: normalizedView, items: [], regenerating: false }
  })
  if (!res.success) return res
  const body = res.data != null ? res.data : {}
  const rows = body.items != null && Array.isArray(body.items) ? body.items as any[] : []
  const items: any[] = []
  for (let i = 0; i < rows.length; i++) items.push(mapRecommendationCard(rows[i]))
  return {
    success: true,
    data: {
      view: body.view != null ? '' + body.view : normalizedView,
      items,
      regenerating: body.regenerating == true,
      isMock: USE_MOCK
    },
    code: res.code,
    message: res.message
  }
}
