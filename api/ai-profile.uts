/** 轮询异步任务状态 */
export async function pollTask(taskId: string): Promise<any> {
  return request({ url: '/ai/tasks/' + taskId, method: 'GET' })
}

/**
 * 通用任务终态轮询:queued/leased/running/retry_wait 按 poll_after_ms 等待,
 * 直到 succeeded/failed/cancelled/superseded 或超次。
 * 返回 { done, status, task, error }。
 */
export async function pollTaskUntilTerminal(taskId: string, maxAttempts: number = 40, shouldContinue: (() => boolean) | null = null): Promise<any> {
  for (let i = 0; i < maxAttempts; i++) {
    if (shouldContinue != null && !shouldContinue()) {
      return { done: false, status: 'aborted', task: null, error: '页面已退出' }
    }
    const taskRes = await pollTask(taskId)
    if (!taskRes.success || taskRes.data == null) {
      return { done: false, status: 'unknown', task: null, error: '任务状态查询失败' }
    }
    const status = String(taskRes.data.status != null ? taskRes.data.status : '')
    if (status == 'succeeded' || status == 'failed' || status == 'cancelled' || status == 'superseded') {
      let err = ''
      if (status == 'failed') {
        err = taskRes.data.error_message != null ? String(taskRes.data.error_message) : '任务失败,请重试'
      } else if (status == 'cancelled') {
        err = '任务已被取消'
      } else if (status == 'superseded') {
        err = '任务已被新任务取代'
      }
      return { done: true, status: status, task: taskRes.data, error: err }
    }
    const pollAfter = Number(taskRes.data.poll_after_ms != null ? taskRes.data.poll_after_ms : 1000)
    await sleep(Math.max(pollAfter, 1000))
  }
  return { done: false, status: 'timeout', task: null, error: '处理超时,请稍后查看结果' }
}

/**
 * 轮询抽取任务直到完成,然后拉取草稿。
 * 返回 { success, draft, error }
 */
export async function pollExtractionAndLoadDraft(taskId: string, draftId: string, maxAttempts: number = 30, shouldContinue: (() => boolean) | null = null): Promise<any> {
  for (let i = 0; i < maxAttempts; i++) {
    if (shouldContinue != null && !shouldContinue()) {
      return { success: false, draft: null, error: '页面已退出' }
    }
    const taskRes = await pollTask(taskId)
    if (!taskRes.success || taskRes.data == null) {
      return { success: false, draft: null, error: '任务状态查询失败' }
    }
    const status = String(taskRes.data.status != null ? taskRes.data.status : '')
    if (status == 'succeeded') {
      let resolvedDraftId = draftId
      const resultRef = taskRes.data.result_ref != null ? String(taskRes.data.result_ref) : ''
      if (resultRef.indexOf('profile-draft:') == 0) {
        resolvedDraftId = resultRef.substring('profile-draft:'.length)
      }
      if (resolvedDraftId == '') {
        return { success: false, draft: null, error: '草稿尚未生成,请稍后重试' }
      }
      const draftRes = await getProfileDraft(resolvedDraftId)
      if (!draftRes.success || draftRes.data == null) {
        return { success: false, draft: null, error: '草稿拉取失败' }
      }
      return { success: true, draft: draftRes.data, error: '' }
    }
    if (status == 'failed') {
      const msg = taskRes.data.error_message != null ? String(taskRes.data.error_message) : 'AI 抽取失败,请重新回答'
      return { success: false, draft: null, error: msg }
    }
    const pollAfter = Number(taskRes.data.poll_after_ms != null ? taskRes.data.poll_after_ms : 1000)
    await sleep(pollAfter)
  }
  return { success: false, draft: null, error: 'AI 处理超时,请稍后重试' }
}

/** 映射后端错误码到用户可读文案 */
export function mapProfileError(code: string, fallback: string): string {
  if (code == 'AI_FEATURE_DISABLED') return 'AI 画像功能当前不可用'
  if (code == 'AI_CONSENT_REQUIRED') return '需要授权后才能使用画像功能'
  if (code == 'AI_CONSENT_VERSION_CONFLICT') return '授权信息已更新,请重试'
  if (code == 'AI_INPUT_INVALID') return '输入内容有误,请检查后重试'
  if (code == 'PROFILE_SESSION_NOT_FOUND') return '画像会话不存在,请重新开始'
  if (code == 'PROFILE_SESSION_STALE') return '资料已更新,请重新创建画像会话'
  if (code == 'DRAFT_VERSION_CONFLICT') return '草稿已被更新,请刷新后合并'
  if (code == 'RESULT_STALE') return '草稿已发布或已失效,请刷新'
  if (code == 'AI_QUOTA_EXCEEDED') return 'AI 额度已用完,请稍后再试'
  if (code == 'AI_TEMPORARILY_UNAVAILABLE') return 'AI 服务暂时不可用,请稍后重试'
  if (code == 'AI_POLICY_DENIED') return '内容包含敏感信息,请修改后重试'
  return fallback
}

/**
 * 查询本人 AI 授权状态。
 * 返回 { consents: [{scope, version, policy_revision, granted_at}], privacy_revision }。
 */
export async function getAiConsents(): Promise<any> {
  return request({ url: '/ai/consents', method: 'GET' })
}

/**
 * 授予画像文字抽取授权(scope=profile_text_extract)。
 * consent_version / policy_revision 必须匹配服务端冻结值,否则 409。
 * X-Expected-Privacy-Revision 必须携带 GET /ai/consents 返回的当前 privacy_revision。
 */
export async function grantProfileTextConsent(expectedPrivacyRevision: number): Promise<any> {
  return request({
    url: '/ai/consents/profile_text_extract',
    method: 'PUT',
    data: { consent_version: 'profile-text-v1', policy_revision: 'ai-policy-2026-08-07-v1' },
    headers: {
      'Idempotency-Key': genIdempotencyKey(),
      'X-Expected-Privacy-Revision': '' + expectedPrivacyRevision
    }
  })
}

/**
 * 撤回画像文字抽取授权(202 异步清理)。
 * 撤回后画像相关功能将不可用,直到重新授权。
 */
export async function revokeProfileTextConsent(expectedPrivacyRevision: number): Promise<any> {
  return request({
    url: '/ai/consents/profile_text_extract',
    method: 'DELETE',
    headers: {
      'Idempotency-Key': genIdempotencyKey(),
      'X-Expected-Privacy-Revision': '' + expectedPrivacyRevision
    }
  })
}

/**
 * 纸飞机草稿 AI 润色预览。只提交当前输入，不保存、不发送，也不自动替换草稿。
 */
export async function polishPaperPlaneText(content: string, field: string, style: string = 'natural'): Promise<any> {
  const original = content != null ? ('' + content).trim() : ''
  if (original == '') return { success: false, data: null, code: 422, message: '请输入需要润色的内容' }
  const normalizedField = field == 'idealPartner' ? 'ideal_partner' : 'self_introduction'
  const res = await request({
    url: '/ai/profile/polish',
    method: 'POST',
    data: { content: original, field: normalizedField, style: style != '' ? style : 'natural', max_length: 300 },
    mockData: { original: original, polished: original, style: style != '' ? style : 'natural', changed_points: [] }
  })
  if (!res.success) {
    const code = res.code != null ? Number(res.code) : 0
    const message = code == 401
      ? '请先登录后再使用 AI 润色'
      : code == 402
        ? 'AI 润色次数已用完，请稍后再试'
        : code == 403
          ? '当前内容不符合 AI 润色规则，请修改后重试'
          : code == 503
            ? 'AI 服务暂时不可用，请稍后再试'
            : (res.message != null ? '' + res.message : 'AI 润色失败，请稍后再试')
    return { success: false, data: null, code: res.code, message }
  }
  const raw = res.data != null ? res.data : {}
  const polished = raw.polished != null && ('' + raw.polished).trim() != '' ? ('' + raw.polished).trim() : original
  return { success: true, data: { original: original, polished: polished, field: field, style: raw.style != null ? raw.style : style, changedPoints: raw.changed_points != null ? raw.changed_points : [] }, code: 0, message: 'success' }
}

/** AI 用心度评审待办条目 */
export interface ThoughtfulnessTodo {
  key: string
  label: string
  advice: string
  priority: string
}

/** AI 用心度评审结果 */
export interface ThoughtfulnessResult {
  score: number
  summary: string
  todos: ThoughtfulnessTodo[]
  generatedAt: string
}

/** 用心度待办 key 与显示名对照(与 buildProfilePayload 字段对齐,契约见 docs/ai-profile-thoughtfulness-api.md) */
export const THOUGHTFULNESS_KEY_LABELS: Map<string, string> = new Map()
THOUGHTFULNESS_KEY_LABELS.set('avatar', '头像')
THOUGHTFULNESS_KEY_LABELS.set('photos', '我的相册')
THOUGHTFULNESS_KEY_LABELS.set('self_intro', '自我介绍')
THOUGHTFULNESS_KEY_LABELS.set('interest_tags', '兴趣标签')
THOUGHTFULNESS_KEY_LABELS.set('personality_tags', '性格标签')
THOUGHTFULNESS_KEY_LABELS.set('qa_answers', '关于我问答')
THOUGHTFULNESS_KEY_LABELS.set('basic_info', '基础信息')
THOUGHTFULNESS_KEY_LABELS.set('mbti', 'MBTI')

/** 将后端 snake_case 数据规范化为 ThoughtfulnessResult(缓存读回时也复用) */
export function normalizeThoughtfulness(raw: any): ThoughtfulnessResult {
  const data = raw != null ? raw : {}
  const score = data.score != null ? Number(data.score) : 0
  const summary = data.summary != null ? '' + data.summary : ''
  const todosRaw: any[] = data.todos != null ? data.todos as any[] : []
  const todos: ThoughtfulnessTodo[] = []
  todosRaw.forEach((item) => {
    if (item == null) return
    const key = item.key != null ? '' + item.key : ''
    if (key == '') return
    const keyLabel = THOUGHTFULNESS_KEY_LABELS.get(key)
    todos.push({
      key: key,
      label: item.label != null ? ('' + item.label) : (keyLabel != null ? keyLabel : key),
      advice: item.advice != null ? '' + item.advice : '',
      priority: item.priority != null ? '' + item.priority : 'medium'
    })
  })
  return {
    score: score,
    summary: summary,
    todos: todos,
    generatedAt: data.generated_at != null ? '' + data.generated_at : ''
  }
}

/** 用心度接口统一错误文案(401/402/429/503 语义与 polishPaperPlaneText 一致) */
function thoughtfulnessErrorMessage(res: any, fallback: string): string {
  const code = res.code != null ? Number(res.code) : 0
  if (code == 401) return '请先登录后再使用 AI 用心度评审'
  if (code == 402) return 'AI 用心度分析次数已用完，请稍后再试'
  if (code == 429) return 'AI 分析请求较多，请稍后再试'
  if (code == 503) return 'AI 服务暂时不可用，请稍后再试'
  return res.message != null ? '' + res.message : fallback
}

/**
 * 获取最新一次 AI 用心度评审结果。
 * 后端未生成过评审时返回 404,此处归一为 success:true + data:null(「未评审」态)。
 */
export async function getLatestThoughtfulness(): Promise<any> {
  const res = await request({
    url: '/ai/profile/thoughtfulness',
    method: 'GET',
    mockData: {
      score: 76,
      summary: '你的资料整体真诚自然，但自我介绍偏短、兴趣标签偏少，用心程度还有提升空间。',
      todos: [
        { key: 'self_intro', label: '自我介绍', advice: '目前 42 字偏短，建议补充一个具体的生活场景或周末常态，让 TA 更容易找到共鸣话题。', priority: 'high' },
        { key: 'interest_tags', label: '兴趣标签', advice: '兴趣标签只有 2 个，建议补充到 5 个以上，推荐权重会明显提高。', priority: 'medium' },
        { key: 'qa_answers', label: '关于我问答', advice: '问答还有 2 题未回答，回答后 AI 分身才能替你更好地展示自己。', priority: 'medium' }
      ],
      generated_at: '2026-09-06T12:00:00+08:00'
    }
  })
  if (!res.success) {
    const code = res.code != null ? Number(res.code) : 0
    if (code == 404) return { success: true, data: null, code: 0, message: 'not_analyzed' }
    return { success: false, data: null, code: res.code, message: thoughtfulnessErrorMessage(res, '用心度评审获取失败，请稍后再试') }
  }
  return { success: true, data: normalizeThoughtfulness(res.data), code: 0, message: 'success' }
}

/**
 * 触发 AI 用心度(重)分析。后端读取库内最新资料自行评审,前端只传触发方式与本次编辑字段。
 * trigger: 'save'=保存后自动 | 'manual'=手动重新分析。
 */
export async function analyzeProfileThoughtfulness(trigger: string, editedKeys: string[]): Promise<any> {
  const normalizedTrigger = trigger == 'manual' ? 'manual' : 'save'
  const sourceKeys: string[] = editedKeys != null ? editedKeys : []
  const keys: string[] = []
  sourceKeys.forEach((k) => {
    const key = k != null ? ('' + k).trim() : ''
    if (key != '' && keys.indexOf(key) < 0) keys.push(key)
  })
  const res = await request({
    url: '/ai/profile/thoughtfulness',
    method: 'POST',
		// 后端会同步等待 DeepSeek；默认 15 秒不足以覆盖其 30 秒服务超时。
		timeout: 45000,
    headers: { 'Idempotency-Key': genIdempotencyKey() },
    data: {
      trigger: normalizedTrigger,
      edited_keys: keys,
      // 每次手动分析都是新的模型运行，避免代理/服务端误把它当成旧结果重放。
      analysis_run_id: genIdempotencyKey()
    },
    mockData: {
      score: 68,
      summary: '本次编辑的自我介绍比之前更具体了，值得肯定；不过基础信息还有缺项，整体用心度仍有提升空间。',
      todos: [
        { key: 'basic_info', label: '基础信息', advice: '家乡和收入还未填写，完整的基础信息能显著提高推荐精准度。', priority: 'high' },
        { key: 'self_intro', label: '自我介绍', advice: '可以再加一句你期待的关系状态，让目标更清晰。', priority: 'medium' },
        { key: 'photos', label: '我的相册', advice: '相册只有 1 张照片，建议补充到 3 张以上，展示更立体的生活。', priority: 'low' }
      ],
      generated_at: '2026-09-06T15:00:00+08:00'
    }
  })
  if (!res.success) {
    return { success: false, data: null, code: res.code, message: thoughtfulnessErrorMessage(res, 'AI 用心度分析失败，请稍后再试') }
  }
  return { success: true, data: normalizeThoughtfulness(res.data), code: 0, message: 'success' }
}

	/**
 * 语音转写:上传音频到 /voice/transcribe → 拿 task_id → 轮询 /ai/tasks/{id}
 * → status=succeeded 时从 result_payload.transcript 取转写文本。
 * 参数:音频临时文件路径 + 当前问题文本 + 字段 key。返回 { success, text, error }。
 */
export async function transcribeAudio(audioPath: string, questionText: string = '', questionFieldKey: string = ''): Promise<any> {
  // 真实 ASR:上传音频文件 → 创建转写任务 → 轮询任务结果
  return await transcribeAudioReal(audioPath, questionFieldKey)
}

/**
 * 真实 ASR 转写:上传音频 → 轮询任务 → 返回转写文本。
 * 复用 ai_task 异步轮询模式,与画像抽取 pollExtractionAndLoadDraft 同构。
 */
async function transcribeAudioReal(audioPath: string, questionFieldKey: string): Promise<any> {
  // 1. 上传音频文件,创建异步转写任务
  const uploadResult = await uploadAudioForTranscribe(audioPath, questionFieldKey)
  if (!uploadResult.success || uploadResult.data == null) {
    const msg = uploadResult.message != null ? ('' + uploadResult.message) : '转写请求失败'
    return { success: false, text: '', error: msg }
  }
  const taskId = uploadResult.data.task_id != null ? ('' + uploadResult.data.task_id) : ''
  if (taskId == '') {
    return { success: false, text: '', error: '转写任务创建失败' }
  }

  // 2. 轮询任务直到终态(最多 30 次,每次间隔 poll_after_ms)
  for (let i = 0; i < 30; i++) {
    const taskRes = await pollTask(taskId)
    if (!taskRes.success || taskRes.data == null) {
      return { success: false, text: '', error: '转写任务状态查询失败' }
    }
    const status = String(taskRes.data.status != null ? taskRes.data.status : '')
    if (status == 'succeeded') {
      // 从 result_payload.transcript 取转写文本
      const payload = taskRes.data.result_payload
      const transcript = payload != null && payload.transcript != null ? ('' + payload.transcript) : ''
      if (transcript == '') {
        return { success: false, text: '', error: '转写结果为空' }
      }
      return { success: true, text: transcript, error: '' }
    }
    if (status == 'failed') {
      const msg = taskRes.data.error_message != null ? String(taskRes.data.error_message) : '转写失败,请重试'
      return { success: false, text: '', error: msg }
    }
    // queued/leased/running/retry_wait:等待后继续轮询
    const pollAfter = taskRes.data.poll_after_ms != null ? Number(taskRes.data.poll_after_ms) : 1000
    await sleep(Math.min(Math.max(pollAfter, 1000), 5000))
  }
  return { success: false, text: '', error: '转写超时,请重试' }
}

/**
 * 上传音频文件到 /voice/transcribe,创建异步转写任务。
 * 使用 uni.uploadFile(multipart),带 Idempotency-Key header。
 * 返回 { success, data: { task_id, status, poll_after_ms }, message }
 */
async function uploadAudioForTranscribe(audioPath: string, questionFieldKey: string): Promise<any> {
  if (audioPath == null || ('' + audioPath).length == 0) {
    return { success: false, data: null, message: '音频文件为空' }
  }
  const url = buildApiUrl('/voice/transcribe')
  const token = getAccessToken()
  const idempotencyKey = genIdempotencyKey()
  const headers: any = {}
  if (token != '') {
    headers['Authorization'] = 'Bearer ' + token
  }
  headers['Idempotency-Key'] = idempotencyKey

  return new Promise<any>((resolve) => {
    uni.uploadFile({
      url: url,
      filePath: audioPath,
      name: 'audio',
      formData: { question_field_key: questionFieldKey },
      header: headers,
      success: (res: any) => {
        const status = res.statusCode != null ? (res.statusCode as number) : 0
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve({ success: false, data: null, message: '转写响应解析失败' })
          return
        }
        if (status >= 200 && status < 300) {
          resolve({ success: true, data: data, message: 'success' })
        } else {
          const msg = data != null && data.detail != null && data.detail.message != null
            ? ('' + data.detail.message)
            : '转写请求失败'
          resolve({ success: false, data: null, message: msg })
        }
      },
      fail: (err: any) => {
        const msg = err != null && err.errMsg != null ? ('' + err.errMsg) : '上传失败,请检查网络'
        resolve({ success: false, data: null, message: msg })
      }
    })
  })
}

/**
 * 语音合成(TTS):将问题文本合成为可播放的音频。
 * 返回 { success, audioUrl, durationMs, error }
 *
 * POST /voice/synthesize { text } → 返回 { audio_url, duration_ms },由 VoiceRecorder 播放。
 */
export async function synthesizeSpeech(text: string): Promise<any> {
  const res = await request({
    url: '/voice/synthesize',
    method: 'POST',
    data: { text: text },
    headers: { 'Idempotency-Key': genIdempotencyKey() }
  })
  if (!res.success || res.data == null) {
    const msg = res.message != null ? ('' + res.message) : '语音合成失败'
    return { success: false, audioUrl: '', durationMs: 0, error: msg }
  }
  const audioUrl = res.data.audio_url != null ? ('' + res.data.audio_url) : ''
  if (audioUrl == '') {
    return { success: false, audioUrl: '', durationMs: 0, error: '语音合成返回空音频' }
  }
  const durationMs = res.data.duration_ms != null ? Number(res.data.duration_ms) : 0
  return {
    success: true,
    audioUrl: resolveMediaUrl(audioUrl),
    durationMs: durationMs,
    error: ''
  }
}

/**
 * 画像叙事层(人格标题/AI洞察/维度卡片/理想型百分比/变化diff/历史观察)。
 * 发布后由后端 Worker 异步生成，写入 ai_profile_summary。
 * 如果尚未发布或 narrative 任务未完成，后端返回 status='pending'。
 */
export async function getPortraitNarrative(subject: string): Promise<any> {
  return request({
    url: '/ai/profiles/' + subject + '/narrative',
    method: 'GET'
  })
}

/** 用户确认最新生成的画像叙事层。 */
export async function confirmPortraitNarrative(subject: string): Promise<any> {
  return request({
    url: '/ai/profiles/' + subject + '/narrative/confirm',
    method: 'POST',
    data: {}
  })
}
