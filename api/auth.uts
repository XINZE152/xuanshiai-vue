/**
 * 认证相关 API
 * 优先走 FastAPI，失败时回退到本地演示数据。
 */

import { request } from './request.uts'
import { CURRENT_USER_ID_KEY, setAuthTokens, clearAuthTokens } from './config.uts'

export async function getProfileCompletion() {
  return request({
    url: '/users/me/completion',
    method: 'GET',
    mockData: { score: 100, completion_score: 100 }
  })
}

export async function sendSms(phone: string, purpose: string = 'login') {
  return request({
    url: '/auth/sms/send',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'POST',
    data: { phone, purpose },
    mockData: { message: '验证码已发送' }
  })
}

export async function loginByPhone(phone: string, code: string) {
  const res = await request({
    url: '/auth/phone/login',
    forceHttp: true,
    skipAuth: true,
    mockFallback: true,
    method: 'POST',
    data: { phone, code, purpose: 'login' },
    mockData: {
      access_token: 'mock_access_token_xsa',
      refresh_token: 'mock_refresh_token_xsa',
      token_type: 'bearer',
      expires_in: 3600,
      need_bind_phone: false,
      user_id: 1
    }
  })
  if (res.success && res.data != null && res.data.access_token != null) {
    setAuthTokens(String(res.data.access_token), res.data.refresh_token != null ? String(res.data.refresh_token) : '')
    if (res.data.user_id != null) uni.setStorageSync(CURRENT_USER_ID_KEY, res.data.user_id)
  }
  return res
}

export async function getAgreementVersions() {
  return request({
    url: '/auth/agreements',
    method: 'GET',
    skipAuth: true,
    mockData: { user_agreement: '1.0', privacy_policy: '1.0' }
  })
}

export async function acceptAgreement(agreementType: string, version: string, scene: string = 'profile') {
  return request({
    url: '/auth/agreements/accept',
    method: 'POST',
    data: { agreement_type: agreementType, version, scene },
    mockData: { success: true, agreement_type: agreementType, version, scene }
  })
}

/** Development/testing login for an already-created account. */
export async function loginByExistingAccount(phone: string, password: string) {
  const res = await request({
    url: '/auth/test-login',
    forceHttp: true,
    skipAuth: true,
    method: 'POST',
    data: {
      phone,
      password,
      device_id: 'wechat-devtools',
      platform: 'mp-weixin',
      app_version: 'dev'
    },
    mockData: {
      access_token: 'mock_debug_access_token_xsa',
      refresh_token: 'mock_debug_refresh_token_xsa',
      token_type: 'bearer',
      expires_in: 3600,
      need_bind_phone: false,
      user_id: 1
    }
  })
  if (res.success && res.data != null && res.data.access_token != null) {
    setAuthTokens(String(res.data.access_token), res.data.refresh_token != null ? String(res.data.refresh_token) : '')
  }
  return res
}

export async function loginByWechat(code: string) {
  const res = await request({
    url: '/auth/wechat/login',
    skipAuth: true,
    method: 'POST',
    data: {
      code,
      platform: 'mp-weixin'
    },
    mockData: {
      access_token: 'mock_wechat_access_token_xsa',
      refresh_token: 'mock_wechat_refresh_token_xsa',
      token_type: 'bearer',
      expires_in: 3600,
      need_bind_phone: false,
      user_id: 1
    }
  })
  if (res.success && res.data != null && res.data.access_token != null) {
    setAuthTokens(String(res.data.access_token), res.data.refresh_token != null ? String(res.data.refresh_token) : '')
    if (res.data.user_id != null) uni.setStorageSync(CURRENT_USER_ID_KEY, res.data.user_id)
  }
  return res
}

/** Bind a phone number to the currently logged-in WeChat account. */
export async function bindPhone(phone: string, code: string) {
  return request({
    url: '/auth/bind-phone',
    method: 'POST',
    data: { phone, code, purpose: 'bind_phone' },
    mockData: { success: true, bound: true }
  })
}

/** Submit real-name information. The server returns status 1 while reviewing. */
export async function submitRealname(realName: string, idCard: string) {
  return request({
    url: '/auth/realname',
    method: 'POST',
    data: { real_name: realName, id_card: idCard },
    mockData: { success: true, status: 1, real_name: realName }
  })
}

export async function logout() {
  try {
    await request({
      url: '/auth/logout',
      forceHttp: true,
      mockFallback: true,
      method: 'POST',
      mockData: { success: true }
    })
  } finally {
    clearAuthTokens()
  }
}
