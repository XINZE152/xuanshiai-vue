/** Bind a phone number to the currently logged-in WeChat account. */
export async function bindPhone(phone: string, code: string) {
  return request({
    url: '/auth/bind-phone',
    method: 'POST',
    data: { phone, code, purpose: 'bind_phone' }
  })
}

/** Submit real-name information. The server returns status 1 while reviewing. */
export async function submitRealname(realName: string, idCard: string) {
  return request({
    url: '/auth/realname',
    method: 'POST',
    data: { real_name: realName, id_card: idCard }
  })
}

/** Query optional qualification certifications independently from real-name gates. */
export async function getUserCertifications() {
  return request({
    url: '/users/me/certifications',
    method: 'GET',
    mockData: mockCertifications
  })
}

function uploadCertificationFile(path: string, filePath: string, formData: any) {
  return new Promise<any>((resolve) => {
    uni.uploadFile({
      url: buildApiUrl(path),
      filePath,
      name: 'file',
      formData,
      header: getAccessToken() != '' ? { Authorization: 'Bearer ' + getAccessToken() } : {},
      success: (res: any) => {
        if (res.statusCode == 401) clearAuthTokens()
        let data: any = null
        try {
          data = JSON.parse('' + res.data)
        } catch (e) {
          resolve({ success: false, data: null, code: res.statusCode, message: '上传响应解析失败' })
          return
        }
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve({ success: true, data, code: res.statusCode, message: 'success' })
        } else {
          const detail = data != null && data.detail != null ? data.detail : '上传失败'
          resolve({ success: false, data, code: res.statusCode, message: '' + detail })
        }
      },
      fail: (err: any) => {
        resolve({ success: false, data: null, code: -1, message: err != null && err.errMsg != null ? '' + err.errMsg : '上传失败，请检查网络' })
      }
    })
  })
}

/** Submit education, school and one certificate image for manual platform review. */
export async function submitEducationCertification(education: string, school: string, filePath: string) {
  mockCertifications.education = {
    kind: 'education',
    status: 1,
    material_submitted: true,
    material: filePath,
    submitted_at: '',
    reviewed_at: null,
    fail_reason: null,
    next_action: '等待平台审核',
    education,
    school
  }
  if (USE_MOCK) return request({ url: '/users/me/certifications/education/material', method: 'PUT', mockData: mockCertifications })
  return uploadCertificationFile('/users/me/certifications/education/material', filePath, { education, school })
}

/** Submit a handwritten single-pledge signature. Real-name approval is required server-side. */
export async function submitSinglePledgeCertification(signaturePath: string, agreementVersion: string) {
  mockCertifications.single_pledge = {
    kind: 'single_pledge',
    status: 1,
    material_submitted: true,
    material: signaturePath,
    submitted_at: new Date().toISOString(),
    reviewed_at: null,
    fail_reason: null,
    next_action: '等待平台审核',
    title: '单身承诺',
    content: null
  }
  if (USE_MOCK) return request({ url: '/users/me/certifications/single-pledge', method: 'PUT', mockData: mockCertifications })
  return uploadCertificationFile('/users/me/certifications/single-pledge', signaturePath, { agreement_version: agreementVersion })
}

export async function logout() {
  try {
    await request({
      url: '/auth/logout',
      forceHttp: true,
      mockFallback: true,
      method: 'POST',
      mockData: { success: true }
    })
  } finally {
    clearAuthTokens()
  }
}
