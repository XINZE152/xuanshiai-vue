/** API configuration for the deployed FastAPI service. */

export const USE_MOCK = false
export const API_BASE_URL = 'https://xhztest.xyz'
export const ROLE_APPLICATION_USE_MOCK = false

// 情感实验室（MBTI）开关集中在此管理。
// 后端 app/api/router.py 目前没有任何 /emotion-lab/* 路由，真实调用一律 404
// （服务器实测返回 {"detail":"Not Found"}，表现为整页「暂时无法加载」）。
// 除非后端补齐 summary/sessions/answers/submit/profile-source/discard/matches，
// 否则必须保持 true。tests/test-emotion-lab-offline.js 会守住这一行。
export const EMOTION_LAB_USE_MOCK = true
export const LAN_API_BASE_URL = 'https://xhztest.xyz'

// FastAPI mounts its router directly at /api/v1.
export const API_PREFIX = '/api/v1'

export const ACCESS_TOKEN_KEY = 'xsa_access_token'
export const REFRESH_TOKEN_KEY = 'xsa_refresh_token'
export const CURRENT_USER_ID_KEY = 'xsa_user_id'
export const ONBOARDING_MODE_KEY = 'xsa_onboarding_mode'
export const ONBOARDING_COMPLETED_KEY = 'xsa_onboarding_completed'
// token 与「签发它的后端地址」绑定。换环境后旧 token 必须视为无效，
// 否则会拿上一套后端的 JWT 去请求新后端，必然 401（本次联调的根因）。
export const TOKEN_BASE_KEY = 'xsa_token_base'

// 开发态仅可使用本地演示身份，禁止提交真实 token。
export const FASTAPI_AUTO_ENTER_COMMUNITY = false
export const FASTAPI_DEV_ACCESS_TOKEN = ''
export const FASTAPI_DEV_USER_ID = 0

export const API_CONFIG = {
  timeout: 15000,
  showLoading: true,
  loadingText: '加载中...'
}

export const MOCK_DELAY = 300

export function getAccessToken(): string {
  try {
    const token = uni.getStorageSync(ACCESS_TOKEN_KEY)
    if (token == null || token === '') return ''
    const boundBase = uni.getStorageSync(TOKEN_BASE_KEY)
    const base = boundBase != null ? String(boundBase) : ''
    // 空值 = 升级前的历史 token，按当前环境放行，避免升级即全员掉登录。
    if (base != '' && base != API_BASE_URL) {
      clearAuthTokens()
      return ''
    }
    return '' + token
  } catch (e) {}
  return ''
}

export function getRefreshToken(): string {
  try {
    const token = uni.getStorageSync(REFRESH_TOKEN_KEY)
    if (token == null || token === '') return ''
    const boundBase = uni.getStorageSync(TOKEN_BASE_KEY)
    const base = boundBase != null ? String(boundBase) : ''
    // 与 getAccessToken 同款环境绑定校验：换后端后旧 refresh_token 视为无效，
    // 避免拿上一套后端的 refresh_token 去打新后端（必然 401）。
    if (base != '' && base != API_BASE_URL) return ''
    return '' + token
  } catch (e) {}
  return ''
}

export function setAuthTokens(accessToken: string, refreshToken: string = '') {
  try {
    if (accessToken != null && accessToken !== '') {
      uni.setStorageSync(ACCESS_TOKEN_KEY, accessToken)
      uni.setStorageSync(TOKEN_BASE_KEY, API_BASE_URL)
    }
    if (refreshToken != null && refreshToken !== '') uni.setStorageSync(REFRESH_TOKEN_KEY, refreshToken)
    else uni.removeStorageSync(REFRESH_TOKEN_KEY)
  } catch (e) {}
}

export function clearAuthTokens() {
  // 纸飞机身份/积分额度是按账号存的，退出登录必须一并清理，
  // 否则切换账号后会串出上一个账号的昵称、头像与"剩余次数"。
  try {
    const uid = uni.getStorageSync(CURRENT_USER_ID_KEY)
    if (uid != null && '' + uid != '') {
      uni.removeStorageSync('xsa_paper_plane_profile_v1:' + uid)
    }
  } catch (e) {}
  try {
    uni.removeStorageSync('xsa_paper_plane_profile_v1')
    uni.removeStorageSync('xsa_paper_plane_state_v1')
  } catch (e) {}
  try {
    uni.removeStorageSync(ACCESS_TOKEN_KEY)
  } catch (e) {}
  try {
    uni.removeStorageSync(REFRESH_TOKEN_KEY)
  } catch (e) {}
  try {
    uni.removeStorageSync(CURRENT_USER_ID_KEY)
    uni.removeStorageSync(ONBOARDING_MODE_KEY)
    uni.removeStorageSync(ONBOARDING_COMPLETED_KEY)
    uni.removeStorageSync(TOKEN_BASE_KEY)
  } catch (e) {}
}

export function buildApiUrl(path: string): string {
  let p = path != null ? ('' + path) : ''
  if (p.indexOf('http://') == 0 || p.indexOf('https://') == 0) return p
  if (p.indexOf('/api/') == 0) return API_BASE_URL + p
  if (p.charAt(0) != '/') p = '/' + p
  return API_BASE_URL + API_PREFIX + p
}

export function buildWsUrl(path: string, token: string): string {
  let p = path != null ? ('' + path) : ''
  if (p.indexOf('ws://') == 0 || p.indexOf('wss://') == 0) return p
  if (p.charAt(0) != '/') p = '/' + p
  let base = API_BASE_URL
  if (base.indexOf('https://') == 0) {
    base = 'wss://' + base.substring(8)
  } else if (base.indexOf('http://') == 0) {
    base = 'ws://' + base.substring(7)
  }
  const sep = p.indexOf('?') >= 0 ? '&' : '?'
  return base + API_PREFIX + p + sep + 'token=' + encodeURIComponent(token)
}

/**
 * Build an AI WebSocket URL with the short-lived, single-use ticket issued
 * by /voice/ws-ticket. Long-lived access tokens must never be placed in this
 * URL because WebSocket URLs can be retained by client/network diagnostics.
 */
export function buildWsTicketUrl(path: string, ticket: string): string {
  let p = path != null ? ('' + path) : ''
  if (p.indexOf('ws://') == 0 || p.indexOf('wss://') == 0) return p
  if (p.charAt(0) != '/') p = '/' + p
  let base = API_BASE_URL
  if (base.indexOf('https://') == 0) {
    base = 'wss://' + base.substring(8)
  } else if (base.indexOf('http://') == 0) {
    base = 'ws://' + base.substring(7)
  }
  const sep = p.indexOf('?') >= 0 ? '&' : '?'
  return base + API_PREFIX + p + sep + 'ticket=' + encodeURIComponent(ticket)
}

export function buildLiveWsUrl(path: string, ticket: string, lastVersion: number = 0): string {
  let p = path != null ? ('' + path) : ''
  if (p.charAt(0) != '/') p = '/' + p
  let base = API_BASE_URL
  if (base.indexOf('https://') == 0) {
    base = 'wss://' + base.substring(8)
  } else if (base.indexOf('http://') == 0) {
    base = 'ws://' + base.substring(7)
  }
  return base + API_PREFIX + p + '?ticket=' + encodeURIComponent(ticket) + '&last_version=' + Math.max(0, Number(lastVersion))
}

export function resolveMediaUrl(value: any): string {
  if (value == null) return ''
  const p = '' + value
  if (p == '') return ''
  if (p.indexOf('http://') == 0 || p.indexOf('https://') == 0 || p.indexOf('data:') == 0 || p.indexOf('blob:') == 0 || p.indexOf('wxfile://') == 0 || p.indexOf('/static/') == 0 || p.indexOf('mock://') == 0) return p
  if (p.indexOf('/storage/') == 0) return API_BASE_URL + p
  if (p.charAt(0) == '/') return API_BASE_URL + p
  return p
}
