<template>
	<view class="page">
		<view class="topbar" :style="{ paddingTop: statusBarHeight + 'px' }">
			<button class="back-button" @click="goBack">‹</button>
			<view class="topbar-copy">
				<text class="topbar-title">脱单纸飞机</text>
				<text class="topbar-subtitle">接住一份认真表达</text>
			</view>
			<button class="report-button" @click="openReport">举报</button>
		</view>

		<view class="content">
			<text class="eyebrow">CATCH A DATING PLANE</text>
			<text class="page-title">有人把心意扔向了你</text>
			<text class="page-desc">先看看这份自我介绍，再决定要不要回复。</text>

			<!-- 后端 PaperPlaneResponse 不含作者身份字段（昵称/性别/年龄/头像），
			     旧实现在这里写死了一个示例人物（昵称 + 性别 + 26 岁 + 城市），
			     接口取不到就回落到假人。现改为匿名展示，只保留内容、城市与时间。 -->
			<view v-if="!loaded" class="plane-card plane-card-empty">
				<text class="plane-label">{{ loadError != '' ? loadError : '正在接住这份心意…' }}</text>
			</view>
			<view v-else-if="receivedPlane.id <= 0" class="plane-card plane-card-empty">
				<text class="plane-label">暂时没有落下的脱单纸飞机</text>
				<text class="plane-content">稍后回来看看，或者先扔一架出去。</text>
			</view>
			<view v-else class="plane-card">
				<view class="plane-profile">
					<view class="avatar avatar-fallback"><text>♡</text></view>
					<view class="profile-copy">
						<text class="nickname">一位匿名的人</text>
						<text class="profile-meta">{{ receivedPlane.timeText }}</text>
						<view class="profile-tags">
							<text v-if="receivedPlane.city != ''" class="profile-tag">IP 属地 {{ receivedPlane.city }}</text>
							<text class="profile-tag">脱单纸飞机</text>
						</view>
					</view>
				</view>

				<view class="plane-divider"></view>
				<text class="plane-label">TA 想认真认识一个人</text>
				<view class="plane-content">{{ receivedPlane.content }}</view>
				<view class="plane-foot">
					<text>回复前，请先尊重彼此的边界</text>
					<text>♡</text>
				</view>
			</view>

			<view class="reply-hint">
				<view class="reply-hint-icon"><text>✦</text></view>
				<view class="reply-hint-copy">
					<text class="reply-hint-title">愿意认识，就认真回一句</text>
					<text class="reply-hint-desc">你的回复会先经过平台保护，双方愿意后再继续认识。</text>
				</view>
			</view>
		</view>

		<!-- 没有可回复的纸飞机时隐藏回复栏，避免把 id=0 发出去 -->
		<view v-if="receivedPlane.id > 0" class="reply-area">
			<view class="reply-bar">
				<input class="reply-input" :value="replyDraft" @input="onReplyInput" placeholder="写一句想对 TA 说的话" maxlength="120" />
				<button class="reply-send" :disabled="sending" @click="sendReply">发送</button>
			</view>
			<text class="return-action" @click="returnHome">扔回去</text>
		</view>

		<XsaReportSheet
			:visible="reportVisible"
			target-type="paperPlane"
			:target-id="receivedPlane.id"
			:user-id="0"
			@close="reportVisible = false"
			@reported="reportVisible = false"
		/>
	</view>
</template>

<script setup lang="uts">
	import XsaReportSheet from '@/components/XsaReportSheet.uvue'
	import { getPaperPlanes, replyPaperPlane } from '@/api'

	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
	const replyDraft = ref('')
	const sending = ref(false)
	const reportVisible = ref(false)
	const receivedPlane = ref<any>({ id: 0, city: '', timeText: '', content: '', voiceUrl: '' })
	const loaded = ref(false)
	const loadError = ref('')

	onMounted(() => {
		loadReceivedPlane()
	})

	const loadReceivedPlane = async () => {
		loadError.value = ''
		try {
			const res = await getPaperPlanes()
			const list = res != null && res.data != null ? res.data as any[] : []
			const item: any = res != null && res.success && Array.isArray(list) && list.length > 0 ? list[0] : null
			if (item == null || Number(item.id) <= 0) {
				receivedPlane.value = { id: 0, city: '', timeText: '', content: '', voiceUrl: '' }
				return
			}
			receivedPlane.value = {
				id: Number(item.id),
				city: item.city != null ? '' + item.city : '',
				timeText: item.timeText != null ? '' + item.timeText : '',
				content: item.content != null ? '' + item.content : '',
				voiceUrl: item.voiceUrl != null ? '' + item.voiceUrl : ''
			}
		} catch (e) {
			console.error(e)
			loadError.value = '网络异常，暂时没能接住纸飞机'
		} finally {
			loaded.value = true
		}
	}

	const goBack = () => {
		uni.navigateBack()
	}

	const openReport = () => {
		reportVisible.value = true
	}

	const onReplyInput = (e: any) => {
		replyDraft.value = e.detail.value
	}

	const sendReply = async () => {
		const text = replyDraft.value.trim()
		if (text.length == 0 || sending.value) return
		// id 必须来自服务端：为 0 表示当前没有可回复的纸飞机，不能把 0 当记录 id 发出去。
		if (Number(receivedPlane.value.id) <= 0) {
			uni.showToast({ title: '这条纸飞机已失效，请重新捡取', icon: 'none' })
			return
		}
		sending.value = true
		try {
			const res = await replyPaperPlane(receivedPlane.value.id, text)
			if (res != null && res.success) {
				replyDraft.value = ''
				returnHome()
			} else {
				uni.showToast({ title: '发送失败，请稍后再试', icon: 'none' })
			}
		} catch (e) {
			uni.showToast({ title: '网络异常，请稍后再试', icon: 'none' })
		} finally {
			sending.value = false
		}
	}

	const returnHome = () => {
		uni.reLaunch({ url: '/pagesSub/community/paper-plane' })
	}
</script>

<style scoped>
	.page { height: 100%; min-height: 0; width: 100vw; position: relative; overflow: hidden; background: #F7F2FF; display: flex; flex-direction: column; }
	/* #ifdef H5 */
	.page { height: 100vh; }
	/* #endif */
	.topbar { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding-left: 14px; padding-right: 14px; padding-bottom: 10px; background: rgba(255, 255, 255, 0.92); border-bottom: 1px solid #E7DDFB; z-index: 3; }
	.back-button { width: 36px; height: 36px; border-radius: 18px; background: #EEE8FF; color: #4D2E96; font-size: 26px; line-height: 31px; }
	.back-button::after { border: none; }
	.topbar-copy { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 1px; }
	.topbar-title { font-size: 17px; font-weight: 800; color: #21153A; }
	.topbar-subtitle { font-size: 10px; color: #8C79B7; }
	.report-button { width: 52px; height: 32px; border-radius: 10px; background: #FFE8F1; color: #C94D7D; font-size: 11px; font-weight: 800; }
	.report-button::after { border: none; }
	.content { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 22px 16px 148px; }
	.eyebrow { font-size: 10px; letter-spacing: 1px; font-weight: 800; color: #7450C8; }
	.page-title { margin-top: 5px; font-size: 24px; line-height: 1.25; font-family: var(--serif); font-weight: 700; color: #21153A; }
	.page-desc { margin-top: 6px; font-size: 12px; color: #8B8298; }
	.plane-card { margin-top: 18px; padding: 17px; border-radius: 22px; background: rgba(255, 255, 255, 0.94); border: 1px solid #E6D8FF; box-shadow: 0 8px 24px rgba(116, 80, 200, 0.12); }
	.plane-card-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 160px; text-align: center; }
	.plane-profile { display: flex; flex-direction: row; align-items: center; gap: 12px; }
	.avatar { width: 58px; height: 58px; border-radius: 20px; flex-shrink: 0; }
	.avatar-fallback { display: flex; align-items: center; justify-content: center; background: #FFE1EC; color: #E86C9A; font-size: 26px; }
	.profile-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
	.nickname { font-size: 17px; font-weight: 800; color: #21153A; }
	.profile-meta { font-size: 11px; color: #8B8298; }
	.profile-tags { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6px; margin-top: 3px; }
	.profile-tag { padding: 3px 7px; border-radius: 999px; background: #EEE8FF; color: #5C40A7; font-size: 10px; font-weight: 700; }
	.plane-divider { height: 1px; margin: 16px 0 13px; background: #EEE6FA; }
	.plane-label { font-size: 11px; font-weight: 800; color: #7450C8; }
	.plane-content { display: block; margin-top: 8px; font-size: 17px; line-height: 1.65; font-family: var(--serif); color: #322747; }
	.plane-foot { display: flex; flex-direction: row; justify-content: space-between; margin-top: 15px; font-size: 10px; color: #A49AAF; }
	.plane-foot text:last-child { color: #E86C9A; font-size: 18px; line-height: 12px; }
	.reply-hint { display: flex; flex-direction: row; align-items: center; gap: 10px; margin-top: 14px; padding: 12px; border-radius: 16px; background: rgba(255, 232, 243, 0.76); }
	.reply-hint-icon { width: 32px; height: 32px; border-radius: 11px; display: flex; align-items: center; justify-content: center; background: #FFE1EC; color: #E86C9A; font-size: 17px; flex-shrink: 0; }
	.reply-hint-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
	.reply-hint-title { font-size: 12px; font-weight: 800; color: #3A2A50; }
	.reply-hint-desc { font-size: 10px; line-height: 1.45; color: #8B8298; }
	.reply-area { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 10px 14px calc(11px + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, 0.96); border-top: 1px solid #E7DDFB; box-shadow: 0 -6px 18px rgba(116, 80, 200, 0.08); }
	.reply-bar { width: 100%; display: flex; flex-direction: row; align-items: center; gap: 8px; padding: 5px 5px 5px 13px; border: 1px solid #DCCCF8; border-radius: 15px; background: #FBFAFF; }
	.reply-input { flex: 1; min-width: 0; height: 36px; font-size: 13px; color: #322747; }
	.reply-send { width: 62px; height: 36px; border-radius: 11px; background: #7450C8; color: #FFFFFF; font-size: 12px; font-weight: 800; }
	.reply-send::after { border: none; }
	.reply-send:disabled { opacity: 0.5; }
	.return-action { font-size: 12px; font-weight: 800; color: #8C79B7; }
</style>
