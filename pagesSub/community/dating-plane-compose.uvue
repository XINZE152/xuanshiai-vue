<template>
	<view class="page">
		<view class="topbar" :style="{ paddingTop: statusBarHeight + 'px' }">
			<button class="back-button" @click="goBack">‹</button>
			<text class="topbar-title">脱单纸飞机</text>
			<view class="topbar-placeholder"></view>
		</view>

		<view class="content">
			<text class="eyebrow">DATING PAPER PLANE</text>
			<text class="page-title">认真介绍自己，遇见合拍的 TA</text>
			<text class="page-desc">写下真实的你，也写下你想遇见的人。</text>

			<view class="form-card">
				<view class="field-head"><text class="field-label">自我介绍</text><button class="polish-button" :disabled="polishing || selfIntroduction.trim().length == 0" @click="reviewPaperPlanePolish('selfIntroduction')">AI 润色</button></view>
				<textarea
					class="field-input"
					:value="selfIntroduction"
					@input="onSelfIntroductionInput"
					placeholder="介绍一下你的生活、兴趣或想分享的事"
					maxlength="52"
				></textarea>
				<text class="field-count">{{ selfIntroduction.length }}/52</text>

				<view class="field-head ideal-label"><text class="field-label">理想的 TA</text><button class="polish-button" :disabled="polishing || idealPartner.trim().length == 0" @click="reviewPaperPlanePolish('idealPartner')">AI 润色</button></view>
				<textarea
					class="field-input"
					:value="idealPartner"
					@input="onIdealPartnerInput"
					placeholder="你期待和怎样的人认真认识"
					maxlength="52"
				></textarea>
				<text class="field-count">{{ idealPartner.length }}/52</text>
			</view>
		</view>

		<view class="polish-overlay" v-if="polishVisible" @click="closePolishReview">
			<view class="polish-sheet" @click.stop>
				<text class="polish-title">AI 润色预览</text>
				<text class="polish-note">AI 润色仅替换待发送草稿，绝不自动发送</text>
				<text class="polish-label">原文</text>
				<text class="polish-copy">{{ polishOriginal }}</text>
				<text class="polish-label">润色后</text>
				<text class="polish-copy proposed">{{ polishProposed }}</text>
				<view class="polish-actions">
					<button class="polish-secondary" @click="continuePolishEditing">继续编辑</button>
					<button class="polish-secondary" @click="copyPolishResult">复制润色结果</button>
					<button class="polish-primary" @click="confirmPolishReplace">确认替换</button>
				</view>
			</view>
		</view>

		<view class="send-area">
			<button class="send-button" :disabled="sending" @click="sendDatingPlane">{{ sending ? '正在扔出...' : '扔出去' }}</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getCommunityQuotas, sendPaperPlane, polishPaperPlaneText } from '@/api'
	import { guardRealName } from '@/utils/realNameGate.uts'

	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
	const selfIntroduction = ref('')
	const idealPartner = ref('')
	const sending = ref(false)
	const remain = ref(0)
	const polishVisible = ref(false)
	const polishing = ref(false)
	const polishField = ref('')
	const polishOriginal = ref('')
	const polishProposed = ref('')

	onMounted(() => {
		loadQuota()
	})

	const loadQuota = async () => {
		try {
			const res = await getCommunityQuotas()
			if (res != null && res.success && res.data != null && res.data.paperPlaneDaily != null) {
				remain.value = res.data.paperPlaneDaily.remain
			}
		} catch (e) {
			console.error(e)
		}
	}

	const onSelfIntroductionInput = (e: any) => {
		selfIntroduction.value = e.detail.value
	}

	const onIdealPartnerInput = (e: any) => {
		idealPartner.value = e.detail.value
	}

	const reviewPaperPlanePolish = async (field: string) => {
		const original = field == 'idealPartner' ? idealPartner.value.trim() : selfIntroduction.value.trim()
		if (original == '' || polishing.value) return
		polishing.value = true
		try {
			const res = await polishPaperPlaneText(original, field, 'natural')
			if (res != null && res.success && res.data != null) {
				polishField.value = field
				polishOriginal.value = original
				polishProposed.value = res.data.polished != null ? '' + res.data.polished : original
				polishVisible.value = true
			} else {
				uni.showToast({ title: res != null && res.message != null ? '' + res.message : 'AI 润色失败，请稍后再试', icon: 'none' })
			}
		} catch (e) {
			uni.showToast({ title: '网络异常，AI 润色失败，请稍后再试', icon: 'none' })
		} finally {
			polishing.value = false
		}
	}

	const confirmPolishReplace = () => {
		if (!polishVisible.value || polishProposed.value.trim() == '') return
		if (polishField.value == 'idealPartner') idealPartner.value = polishProposed.value
		else selfIntroduction.value = polishProposed.value
		polishVisible.value = false
		uni.showToast({ title: '已替换待发送草稿', icon: 'success' })
	}

	const copyPolishResult = () => {
		if (polishProposed.value.trim() == '') return
		uni.setClipboardData({ data: polishProposed.value, success: () => uni.showToast({ title: '已复制润色结果', icon: 'none' }) })
	}

	const continuePolishEditing = () => {
		polishVisible.value = false
	}

	const closePolishReview = () => {
		if (!polishing.value) polishVisible.value = false
	}

	const sendDatingPlane = async () => {
		const introduction = selfIntroduction.value.trim()
		const partner = idealPartner.value.trim()
		if (introduction.length == 0 || partner.length == 0) {
			uni.showToast({ title: '请完成自我介绍和理想的 TA', icon: 'none' })
			return
		}
		// 次数由服务端裁决（积分加次不在本地 remain 里），这里不再提前拦截。
		const passed = await guardRealName('paperPlane')
		if (!passed || sending.value) return

		sending.value = true
		try {
			const content = '自我介绍：' + introduction + '\n理想的TA：' + partner
			const res = await sendPaperPlane({ content, scope: 'city', anonymous: true })
			const data = res != null ? res.data : null
			if (res != null && res.success && data != null && data.success != false) {
				uni.reLaunch({ url: '/pagesSub/community/paper-plane' })
				return
			}
			const message = data != null && data.message != null ? data.message : '扔出失败，请稍后再试'
			uni.showToast({ title: message, icon: 'none' })
		} catch (e) {
			uni.showToast({ title: '网络异常，请稍后再试', icon: 'none' })
		} finally {
			sending.value = false
		}
	}

	const goBack = () => {
		uni.navigateBack()
	}
</script>

<style scoped>
	.page { height: 100%; min-height: 0; width: 100vw; overflow: hidden; display: flex; flex-direction: column; background: #F7F2FF; }
	/* #ifdef H5 */
	.page { height: 100vh; }
	/* #endif */
	.topbar { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 10px 14px; background: rgba(255, 255, 255, 0.95); border-bottom: 1px solid #E7DDFB; }
	.back-button, .topbar-placeholder { width: 36px; height: 36px; }
	.back-button { border-radius: 18px; background: #EEE8FF; color: #4D2E96; font-size: 26px; line-height: 29px; }
	.back-button::after { border: none; }
	.topbar-title { font-size: 17px; font-weight: 800; color: #21153A; }
	.content { flex: 1; min-height: 0; padding: 22px 16px 96px; box-sizing: border-box; }
	.eyebrow { font-size: 10px; font-weight: 800; letter-spacing: 1px; color: #7450C8; }
	.page-title { display: block; margin-top: 6px; font-size: 24px; line-height: 1.3; font-family: var(--serif); font-weight: 700; color: #21153A; }
	.page-desc { display: block; margin-top: 6px; font-size: 12px; color: #8B8298; }
	.form-card { margin-top: 20px; padding: 16px; border: 1px solid #E4D6FA; border-radius: 18px; background: rgba(255, 255, 255, 0.95); box-shadow: 0 8px 22px rgba(116, 80, 200, 0.1); }
	.field-label { display: block; font-size: 14px; font-weight: 800; color: #3A2A50; }
	.ideal-label { margin-top: 17px; }
	.field-input { width: 100%; height: 82px; margin-top: 9px; padding: 11px; box-sizing: border-box; border: 1px solid #DDCEF4; border-radius: 12px; background: #FCFAFF; color: #322747; font-size: 13px; line-height: 1.5; }
	.field-count { display: block; margin-top: 5px; text-align: right; color: #A49AAF; font-size: 10px; }
	.send-area { position: fixed; left: 0; right: 0; bottom: 0; padding: 10px 16px calc(12px + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, 0.96); border-top: 1px solid #E7DDFB; }
	.send-button { width: 100%; height: 47px; border-radius: 14px; background: #7450C8; color: #FFFFFF; font-size: 15px; font-weight: 800; }
	.send-button::after { border: none; }
	.send-button:disabled { opacity: 0.5; }
	.field-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 8px; }
	.field-head.ideal-label { margin-top: 17px; }
	.polish-button { min-width: 68px; height: 28px; margin: 0; padding: 0 9px; border: 1px solid #D8C8F3; border-radius: 14px; background: #F5F0FF; color: #7450C8; font-size: 11px; line-height: 28px; }
	.polish-button::after { border: none; }
	.polish-button:disabled { opacity: 0.45; }
	.polish-overlay { position: fixed; inset: 0; z-index: 20; display: flex; flex-direction: column; justify-content: flex-end; background: rgba(28, 16, 52, 0.45); }
	.polish-sheet { padding: 20px 16px calc(20px + env(safe-area-inset-bottom)); border-radius: 20px 20px 0 0; background: #FFFFFF; }
	.polish-title { display: block; font-size: 18px; font-weight: 800; color: #21153A; }
	.polish-note { display: block; margin-top: 6px; color: #8B8298; font-size: 11px; }
	.polish-label { display: block; margin-top: 16px; color: #7450C8; font-size: 11px; font-weight: 800; }
	.polish-copy { display: block; margin-top: 6px; padding: 10px; border-radius: 10px; background: #F8F5FC; color: #4A3B5E; font-size: 13px; line-height: 1.5; }
	.polish-copy.proposed { background: #F2ECFF; color: #2D1A4A; }
	.polish-actions { display: flex; flex-direction: row; gap: 8px; margin-top: 18px; }
	.polish-actions button { flex: 1; height: 40px; margin: 0; padding: 0 8px; border-radius: 10px; font-size: 11px; }
	.polish-actions button::after { border: none; }
	.polish-secondary { border: 1px solid #E0D6EE; background: #FFFFFF; color: #5D4D70; }
	.polish-primary { background: #7450C8; color: #FFFFFF; }
</style>
