<template>
	<view class="publish-page">
		<scroll-view class="scroll-content" scroll-y>
			<!-- 媒体区：图片 / 视频互斥；选择后立即上传 -->
			<view class="photo-section">
				<view class="photo-grid" v-if="videoItems.length == 0">
					<view class="photo-item" v-for="(item, index) in photoItems" :key="index">
						<image class="photo" :src="item.localPath" mode="aspectFill"></image>
						<view class="media-status" v-if="item.status == 'uploading' || item.status == 'pending'">
							<text class="media-status-text">上传中</text>
						</view>
						<view class="media-status media-failed" v-else-if="item.status == 'failed'" @click="retryPhoto(index)">
							<text class="media-status-text">失败·点重试</text>
						</view>
						<view class="delete-btn" @click="deletePhoto(index)">
							<text class="icon">✕</text>
						</view>
					</view>
					<view class="photo-item add-btn" @click="addPhoto" v-if="canAddPhoto">
						<text class="icon">+</text>
						<text class="text">添加图片</text>
					</view>
				</view>

				<view class="video-block" v-if="videoItems.length > 0">
					<view class="video-preview">
						<video class="video-player" :src="videoItems[0].localPath" controls></video>
						<view class="media-status" v-if="videoItems[0].status == 'uploading' || videoItems[0].status == 'pending'">
							<text class="media-status-text">上传中</text>
						</view>
						<view class="media-status media-failed" v-else-if="videoItems[0].status == 'failed'" @click="retryVideo">
							<text class="media-status-text">失败·点重试</text>
						</view>
						<view class="delete-btn" @click="deleteVideo">
							<text class="icon">✕</text>
						</view>
					</view>
				</view>

				<view class="media-actions" v-if="videoItems.length == 0">
					<view class="media-action-btn" @click="addVideo" v-if="canAddVideo || photoItems.length > 0">
						<text class="media-action-text">添加视频</text>
					</view>
				</view>

				<text class="photo-tip text-muted">图片最多 9 张，或视频 1 条（互斥）；选择后自动上传</text>
			</view>

			<!-- 内容输入 + 表情 -->
			<view class="content-section">
				<textarea
					class="textarea"
					:value="content"
					@input="onContentInput"
					placeholder="分享此刻的心情..."
					maxlength="500"
					auto-height
				></textarea>
				<view class="content-footer">
					<text class="emoji-btn" @click="toggleEmoji">表情</text>
					<text class="char-count">{{ content.length }}/500</text>
				</view>
			</view>

			<!-- 位置 -->
			<view class="option-item" @click="chooseLocation">
				<view class="option-left">
					<view class="option-icon icon-location">
						<view class="loc-pin">
							<view class="loc-hole"></view>
						</view>
					</view>
					<text class="option-label">添加位置</text>
				</view>
				<view class="option-right">
					<text class="option-value text-muted" v-if="location">{{ location }}</text>
					<text class="arrow">›</text>
				</view>
			</view>

			<!-- 话题 -->
			<view class="option-item" @click="openTopicSheet">
				<view class="option-left">
					<text class="option-icon">#</text>
					<text class="option-label">添加话题</text>
				</view>
				<view class="option-right">
					<text class="option-value text-muted" v-if="topicTitle !== ''">{{ topicTitle }}</text>
					<text class="option-value text-muted" v-else>选择话题</text>
					<text class="arrow">›</text>
				</view>
			</view>

			<!-- 内容声明 -->
			<view class="option-item" @click="selectDeclaration">
				<view class="option-left">
					<text class="option-icon">ⓘ</text>
					<text class="option-label">内容声明</text>
				</view>
				<view class="option-right">
					<text class="option-value text-muted">{{ declarationText }}</text>
					<text class="arrow">›</text>
				</view>
			</view>

			<!-- 可见范围 -->
			<view class="option-item" @click="selectVisibility">
				<view class="option-left">
					<view class="option-icon icon-eye">
						<view class="eye-oval">
							<view class="eye-ball">
								<view class="eye-shine"></view>
							</view>
						</view>
					</view>
					<text class="option-label">谁可以看</text>
				</view>
				<view class="option-right">
					<text class="option-value text-muted">{{ visibilityText }}</text>
					<text class="arrow">›</text>
				</view>
			</view>

			<!-- 提醒谁看 -->
			<view class="option-item" @click="selectMention">
				<view class="option-left">
					<text class="option-icon">@</text>
					<text class="option-label">提醒谁看</text>
				</view>
				<view class="option-right">
					<text class="option-value text-muted" v-if="mentions.length > 0">
						已选择{{ mentions.length }}人
					</text>
					<text class="arrow">›</text>
				</view>
			</view>
		</scroll-view>

		<!-- 底部发布按钮 -->
		<view class="footer">
			<button class="cancel-btn" @click="handleCancel">取消</button>
			<button class="publish-btn" @click="handlePublish" :disabled="!canPublish">发布</button>
		</view>

		<!-- 表情浮层 -->
		<view class="emoji-mask" v-if="showEmojiPanel" @click="showEmojiPanel = false">
			<view class="emoji-panel" @click.stop="">
				<view class="emoji-grid">
					<text
						class="emoji-item"
						v-for="(emoji, eidx) in EMOJI_LIST"
						:key="eidx"
						@click="insertEmoji(emoji)"
					>{{ emoji }}</text>
				</view>
			</view>
		</view>

		<!-- 话题半屏 -->
		<view class="sheet-mask" v-if="showTopicSheet" @click="closeTopicSheet">
			<view class="topic-sheet" @click.stop="">
				<view class="sheet-handle"></view>
				<text class="sheet-title">选择话题</text>
				<input class="sheet-search" :value="topicKeyword" @input="onTopicSearch" placeholder="搜索话题" />
				<view v-if="topicLoading" class="sheet-status">
					<text class="text-muted">加载中...</text>
				</view>
				<view v-else-if="topicError !== ''" class="sheet-status">
					<text class="text-muted">{{ topicError }}</text>
					<text class="text-accent" @click="loadTopicOptions">重试</text>
				</view>
				<scroll-view scroll-y class="sheet-list" v-else>
					<view class="topic-row" v-if="topicId > 0" @click="clearTopic">
						<text class="text-muted">清除已选话题</text>
					</view>
					<view
						class="topic-row"
						v-for="t in filteredTopics"
						:key="t.id"
						@click="pickTopic(t)"
					>
						<text class="topic-row-tag">{{ t.tag }}</text>
						<text class="topic-row-title">{{ t.title }}</text>
					</view>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { publishDynamic, getTopics, getTopicDetail, createCommunityCreateKey, discardCommunityCreateKey, uploadCommunityMedia, getCommunityMediaStatus, deleteCommunityMedia } from '@/api'
	import { guardCommunityVerification } from '@/utils/realNameGate.uts'

		type LocalMedia = {
			localPath: string
			mediaId: number
			remoteUrl: string
			status: string // pending | uploading | ready | failed
			mediaType: string // image | video
			moderationStatus: string // pending | approved | rejected | hidden
			cancelled: boolean
		}

		const photoItems = ref<LocalMedia[]>([])
		const videoItems = ref<LocalMedia[]>([])
		/** 已从 UI 移除但仍在上传中的项，完成时若 cancelled 则 delete */
		const inFlightMedia = ref<LocalMedia[]>([])
		const content = ref('')
		const location = ref('')
		const visibility = ref(0)
		const mentions = ref<number[]>([])
		const publishing = ref(false)
		const publishedOk = ref(false)
		const pendingPublishKey = ref('')
		const pendingPublishFingerprint = ref('')
		const topicId = ref(0)
		const topicTitle = ref('')
		const declaration = ref('')
		const showEmojiPanel = ref(false)
		const showTopicSheet = ref(false)
		const topicLoading = ref(false)
		const topicError = ref('')
		const topicKeyword = ref('')
		const topicOptions = ref([] as any[])
		const authGuideShowing = ref(false)

		const showCommunityAuthGuide = (message: string): boolean => {
			if (message.indexOf('认证') < 0) return false
			if (authGuideShowing.value) return true
			authGuideShowing.value = true
			const needsFaceVerification = message.indexOf('人脸') >= 0
			uni.showModal({
				title: needsFaceVerification ? '需要完成人脸认证' : '需要实名认证',
				content: needsFaceVerification
					? '当前账号尚未完成人脸认证。完成实名认证和人脸认证后，才能在社区发布动态。'
					: '完成实名认证后，才能在社区发布动态。',
				confirmText: needsFaceVerification ? '去认证中心' : '去实名认证',
				cancelText: '暂不处理',
				success: (result) => {
					authGuideShowing.value = false
					if (result.confirm) {
						uni.navigateTo({ url: '/pagesSub/profileExtra/certification?focus=realname' })
					}
				}
			})
			return true
		}

const DECLARATION_OPTIONS = [
	'内容无需声明',
	'内容包含虚构演绎',
	'内容包含广告推广',
	'内容可能引起不适'
]

const EMOJI_LIST = [
	'😊', '😂', '🥰', '😍', '🤗', '👍', '🙏', '✨',
	'🌅', '☕', '📚', '🎵', '🏃', '🌿', '💡', '🎯',
	'❤️', '🤍', '🌟', '🌸', '🍜', '🎨', '📷', '🌙'
]

onLoad(async (query: any) => {
		const raw = query != null ? query.topicId : null
		const parsed = raw != null ? parseInt('' + raw) : 0
		topicId.value = parsed > 0 ? parsed : 0
		if (topicId.value > 0) {
			// 优先详情接口；失败再 hot 列表；仍失败则占位，不空吞
			let resolved = false
			try {
				const detailRes = await getTopicDetail(topicId.value)
				if (detailRes.success && detailRes.data != null && detailRes.data.topic != null) {
					const t = detailRes.data.topic as any
					if (t.title != null && ('' + t.title) !== '') {
						topicTitle.value = '' + t.title
						resolved = true
					}
				}
			} catch (e) {
				console.error(e)
			}
			if (!resolved) {
				try {
					const res = await getTopics('hot')
					if (res.success && res.data != null) {
						const list = res.data as any[]
						for (let i = 0; i < list.length; i++) {
							if (list[i].id == topicId.value) {
								topicTitle.value = list[i].title != null ? ('' + list[i].title) : ''
								resolved = topicTitle.value !== ''
								break
							}
						}
					}
				} catch (e) {
					console.error(e)
				}
			}
			if (!resolved) {
				topicTitle.value = '话题 #' + topicId.value
				uni.showToast({ title: '话题标题加载失败，可重新选择', icon: 'none' })
			}
		}
	})

	const canPublish = computed(() => {
			const photos = photoItems.value as LocalMedia[]
			const videos = videoItems.value as LocalMedia[]
			let hasReadyMedia = false
			for (let i = 0; i < photos.length; i++) {
				const s = photos[i].status
				if (s == 'uploading' || s == 'pending') return false
				if (s == 'ready' && photos[i].mediaId > 0) hasReadyMedia = true
			}
			for (let i = 0; i < videos.length; i++) {
				const s = videos[i].status
				if (s == 'uploading' || s == 'pending') return false
				if (s == 'ready' && videos[i].mediaId > 0) hasReadyMedia = true
			}
			const hasText = content.value.trim().length > 0
			return hasText || hasReadyMedia
		})

	const canAddPhoto = computed(() => {
		return videoItems.value.length == 0 && photoItems.value.length < 9
	})

	const canAddVideo = computed(() => {
		return photoItems.value.length == 0 && videoItems.value.length < 1
	})

	const mediaIdsFingerprint = (): string => {
		const ids: string[] = []
		const photos = photoItems.value as LocalMedia[]
		for (let i = 0; i < photos.length; i++) {
			ids.push('i' + photos[i].mediaId + ':' + photos[i].status)
		}
		const videos = videoItems.value as LocalMedia[]
		for (let i = 0; i < videos.length; i++) {
			ids.push('v' + videos[i].mediaId + ':' + videos[i].status)
		}
		return ids.join(',')
	}

		const makeLocalMedia = (localPath: string, mediaType: string): LocalMedia => {
			return {
				localPath: localPath,
				mediaId: 0,
				remoteUrl: '',
				status: 'uploading',
				mediaType: mediaType,
				moderationStatus: '',
				cancelled: false
			}
		}

		const trackInFlight = (item: LocalMedia) => {
			const list = inFlightMedia.value as LocalMedia[]
			for (let i = 0; i < list.length; i++) {
				if (list[i] === item) return
			}
			list.push(item)
			inFlightMedia.value = list
		}

		const untrackInFlight = (item: LocalMedia) => {
			const list = inFlightMedia.value as LocalMedia[]
			const next: LocalMedia[] = []
			for (let i = 0; i < list.length; i++) {
				if (list[i] !== item) next.push(list[i])
			}
			inFlightMedia.value = next
		}

		const removeMediaFromUi = (item: LocalMedia) => {
			const photos = photoItems.value as LocalMedia[]
			const nextPhotos: LocalMedia[] = []
			for (let i = 0; i < photos.length; i++) {
				if (photos[i] !== item) nextPhotos.push(photos[i])
			}
			photoItems.value = nextPhotos
			const videos = videoItems.value as LocalMedia[]
			const nextVideos: LocalMedia[] = []
			for (let i = 0; i < videos.length; i++) {
				if (videos[i] !== item) nextVideos.push(videos[i])
			}
			videoItems.value = nextVideos
		}

		const uploadOne = async (item: LocalMedia) => {
			if (item.cancelled) return
			item.status = 'uploading'
			trackInFlight(item)
			try {
				const res = await uploadCommunityMedia(item.localPath, 'post')
				if (item.cancelled) {
					const mid = res != null && res.success && res.data != null && res.data.id != null
						? (res.data.id as number)
						: 0
					if (mid > 0) {
						try {
							await deleteCommunityMedia(mid)
						} catch (e) {}
					}
					item.mediaId = 0
					item.remoteUrl = ''
					item.status = 'failed'
					return
				}
				if (res != null && res.success && res.data != null) {
					const data = res.data as any
					item.mediaId = data.id != null ? (data.id as number) : 0
					item.remoteUrl = data.url != null ? ('' + data.url) : ''
					if (data.mediaType != null && ('' + data.mediaType) != '') {
						item.mediaType = '' + data.mediaType
					}
					item.moderationStatus = data.moderationStatus != null ? ('' + data.moderationStatus) : ''
					item.status = item.mediaId > 0 && item.moderationStatus == 'approved' ? 'ready' : (item.mediaId > 0 ? 'pending' : 'failed')
				} else {
					const message = res != null && res.message != null ? ('' + res.message) : ''
					showCommunityAuthGuide(message)
					item.status = 'failed'
					item.mediaId = 0
					item.remoteUrl = ''
				}
			} catch (e) {
				if (item.cancelled) {
					item.mediaId = 0
					item.remoteUrl = ''
					item.status = 'failed'
					return
				}
				item.status = 'failed'
				item.mediaId = 0
				item.remoteUrl = ''
			} finally {
				untrackInFlight(item)
				invalidatePendingPublishKey()
			}
		}

		const cleanupUnboundMedia = async () => {
			if (publishedOk.value) return
			const photos = photoItems.value as LocalMedia[]
			for (let i = 0; i < photos.length; i++) {
				const m = photos[i]
				if (m.status == 'uploading' || m.status == 'pending') {
					m.cancelled = true
					trackInFlight(m)
				} else if (m.status == 'ready' && m.mediaId > 0) {
					try {
						await deleteCommunityMedia(m.mediaId)
					} catch (e) {}
				}
			}
			const videos = videoItems.value as LocalMedia[]
			for (let i = 0; i < videos.length; i++) {
				const m = videos[i]
				if (m.status == 'uploading' || m.status == 'pending') {
					m.cancelled = true
					trackInFlight(m)
				} else if (m.status == 'ready' && m.mediaId > 0) {
					try {
						await deleteCommunityMedia(m.mediaId)
					} catch (e) {}
				}
			}
			// 已从 UI 移除但仍在飞行中的项：确保 cancelled，完成后 uploadOne 会 delete
			const flying = inFlightMedia.value as LocalMedia[]
			for (let i = 0; i < flying.length; i++) {
				flying[i].cancelled = true
			}
		}

		const confirmMediaReady = async (item: LocalMedia): Promise<boolean> => {
			if (item.mediaId <= 0) return false
			const res = await getCommunityMediaStatus(item.mediaId)
			if (res == null || !res.success || res.data == null) {
				uni.showToast({ title: res != null && res.message != null ? ('' + res.message) : '媒体状态查询失败，请稍后重试', icon: 'none' })
				return false
			}
			const data = res.data as any
			item.moderationStatus = data.moderationStatus != null ? ('' + data.moderationStatus) : ''
			if (data.status != null && ('' + data.status) != 'ready') {
				uni.showToast({ title: '图片尚未准备好，请重新上传', icon: 'none' })
				return false
			}
			if (item.moderationStatus != 'approved') {
				uni.showToast({ title: item.moderationStatus == 'pending' ? '图片正在审核，请审核通过后再发布' : '图片审核未通过，请重新上传', icon: 'none' })
				return false
			}
			item.status = 'ready'
			return true
		}

const visibilityText = computed(() => {
	const texts = ['公开', '仅好友可见', '仅自己可见']
	return texts[visibility.value]
})

const declarationText = computed(() => {
	if (declaration.value === '') return '内容无需声明'
	return declaration.value
})

const filteredTopics = computed(() => {
	const kw = topicKeyword.value.trim()
	const list = topicOptions.value as any[]
	if (kw === '') return list
	const out: any[] = []
	for (let i = 0; i < list.length; i++) {
		const t = list[i]
		const title = t.title != null ? ('' + t.title) : ''
		const tag = t.tag != null ? ('' + t.tag) : ''
		if (title.indexOf(kw) >= 0 || tag.indexOf(kw) >= 0) out.push(t)
	}
	return out
})

const addPhoto = async () => {
		const allowed = await guardCommunityVerification()
		if (!allowed) return
		if (!canAddPhoto.value) {
			if (videoItems.value.length > 0) {
				uni.showToast({ title: '已选择视频，无法再添加图片', icon: 'none' })
			}
			return
		}
		const remaining = 9 - photoItems.value.length
		uni.chooseImage({
			count: remaining,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: async (res) => {
				const paths = res.tempFilePaths as string[]
				const start = photoItems.value.length
				for (let i = 0; i < paths.length; i++) {
					const path = paths[i] != null ? ('' + paths[i]) : ''
					if (path == '') continue
					photoItems.value.push(makeLocalMedia(path, 'image'))
				}
				invalidatePendingPublishKey()
				const list = photoItems.value as LocalMedia[]
				for (let i = start; i < list.length; i++) {
					await uploadOne(list[i])
				}
			}
		})
	}

	const addVideo = async () => {
		const allowed = await guardCommunityVerification()
		if (!allowed) return
		if (photoItems.value.length > 0) {
			uni.showModal({
				title: '提示',
				content: '添加视频将清除已选图片，是否继续？',
				success: async (res) => {
if (res.confirm) {
							// 清理已选图片：ready 直接删；上传中标记 cancelled，完成后 uploadOne 会 delete
							const old = photoItems.value as LocalMedia[]
							for (let i = 0; i < old.length; i++) {
								const m = old[i]
								if (m.status == 'uploading' || m.status == 'pending') {
									m.cancelled = true
									trackInFlight(m)
								} else if (m.status == 'ready' && m.mediaId > 0) {
									try {
										await deleteCommunityMedia(m.mediaId)
									} catch (e) {}
								}
							}
							photoItems.value = []
							invalidatePendingPublishKey()
							pickVideo()
						}
				}
			})
			return
		}
		if (videoItems.value.length >= 1) {
			uni.showToast({ title: '最多添加 1 个视频', icon: 'none' })
			return
		}
		pickVideo()
	}

	const pickVideo = () => {
		uni.chooseVideo({
			sourceType: ['album', 'camera'],
			compressed: true,
			success: async (res) => {
				const path = res.tempFilePath != null ? ('' + res.tempFilePath) : ''
if (path !== '') {
						// 替换旧视频：ready 直接删；上传中标记 cancelled，完成后 uploadOne 会 delete
						const old = videoItems.value as LocalMedia[]
						for (let i = 0; i < old.length; i++) {
							const m = old[i]
							if (m.status == 'uploading' || m.status == 'pending') {
								m.cancelled = true
								trackInFlight(m)
							} else if (m.status == 'ready' && m.mediaId > 0) {
								try {
									await deleteCommunityMedia(m.mediaId)
								} catch (e) {}
							}
						}
						const item = makeLocalMedia(path, 'video')
						videoItems.value = [item]
						invalidatePendingPublishKey()
						await uploadOne(item)
					}
			}
		})
	}

		const deletePhoto = async (index: number) => {
			const list = photoItems.value as LocalMedia[]
			if (index < 0 || index >= list.length) return
			const item = list[index]
			if (item.status == 'uploading' || item.status == 'pending') {
				item.cancelled = true
				trackInFlight(item)
				removeMediaFromUi(item)
				invalidatePendingPublishKey()
				return
			}
			if (item.status == 'ready' && item.mediaId > 0) {
				try {
					await deleteCommunityMedia(item.mediaId)
				} catch (e) {}
			}
			photoItems.value.splice(index, 1)
			invalidatePendingPublishKey()
		}

		const deleteVideo = async () => {
			const list = videoItems.value as LocalMedia[]
			for (let i = 0; i < list.length; i++) {
				const item = list[i]
				if (item.status == 'uploading' || item.status == 'pending') {
					item.cancelled = true
					trackInFlight(item)
					continue
				}
				if (item.status == 'ready' && item.mediaId > 0) {
					try {
						await deleteCommunityMedia(item.mediaId)
					} catch (e) {}
				}
			}
			videoItems.value = []
			invalidatePendingPublishKey()
		}

	const retryPhoto = async (index: number) => {
		const list = photoItems.value as LocalMedia[]
		if (index < 0 || index >= list.length) return
		const item = list[index]
		if (item.status != 'failed') return
		await uploadOne(item)
	}

	const retryVideo = async () => {
		const list = videoItems.value as LocalMedia[]
		if (list.length == 0) return
		const item = list[0]
		if (item.status != 'failed') return
		await uploadOne(item)
	}

const onContentInput = (e: any) => {
	content.value = e.detail.value
}

const insertEmoji = (emoji: string) => {
	const next = content.value + emoji
	content.value = next.length > 500 ? next.substring(0, 500) : next
}

const toggleEmoji = () => {
	showEmojiPanel.value = !showEmojiPanel.value
}

const selectDeclaration = () => {
	uni.showActionSheet({
		itemList: DECLARATION_OPTIONS,
		success: (res) => {
			const idx = res.tapIndex
			if (idx == 0) {
				declaration.value = ''
			} else if (idx > 0 && idx < DECLARATION_OPTIONS.length) {
				declaration.value = DECLARATION_OPTIONS[idx]
			}
		}
	})
}

const chooseLocation = () => {
	uni.chooseLocation({
		success: (res) => {
			location.value = res.name || res.address
		}
	})
}

const selectVisibility = () => {
	uni.showActionSheet({
		itemList: ['公开', '仅好友可见', '仅自己可见'],
		success: (res) => {
			visibility.value = res.tapIndex
		}
	})
}

const selectMention = () => {
	uni.showToast({
		title: '功能开发中',
		icon: 'none'
	})
}

const openTopicSheet = async () => {
	showTopicSheet.value = true
	topicError.value = ''
	if (topicOptions.value.length == 0) {
		await loadTopicOptions()
	}
}

const loadTopicOptions = async () => {
	topicLoading.value = true
	topicError.value = ''
	try {
		const res = await getTopics('hot')
		if (res.success && res.data != null) {
			topicOptions.value = res.data as any[]
		} else {
			topicError.value = '话题加载失败'
		}
	} catch (e) {
		topicError.value = '网络异常'
	} finally {
		topicLoading.value = false
	}
}

const onTopicSearch = (e: any) => {
	topicKeyword.value = e.detail.value
}

const pickTopic = (t: any) => {
	topicId.value = t.id as number
	topicTitle.value = t.title != null ? ('' + t.title) : ''
	showTopicSheet.value = false
	topicKeyword.value = ''
}

const clearTopic = () => {
	topicId.value = 0
	topicTitle.value = ''
}

const closeTopicSheet = () => {
	showTopicSheet.value = false
	topicKeyword.value = ''
}

const handleCancel = () => {
		if (
			photoItems.value.length > 0 ||
			videoItems.value.length > 0 ||
			content.value.trim().length > 0 ||
			topicId.value > 0
		) {
			uni.showModal({
				title: '提示',
				content: '确定放弃编辑吗？',
				success: async (res) => {
					if (res.confirm) {
						discardPendingPublishKey()
						await cleanupUnboundMedia()
						uni.navigateBack()
					}
				}
			})
		} else {
			discardPendingPublishKey()
			uni.navigateBack()
		}
	}

	const discardPendingPublishKey = () => {
		if (pendingPublishKey.value != '') {
			discardCommunityCreateKey(pendingPublishKey.value)
		}
		pendingPublishKey.value = ''
		pendingPublishFingerprint.value = ''
	}

	const publishFingerprint = () => {
		return content.value.trim() + '|' + mediaIdsFingerprint() + '|' + location.value + '|' + topicId.value + '|' + visibility.value + '|' + declaration.value
	}

	const invalidatePendingPublishKey = () => {
		if (pendingPublishFingerprint.value != '' && pendingPublishFingerprint.value != publishFingerprint()) {
			discardPendingPublishKey()
		}
	}

	onUnload(() => {
		discardPendingPublishKey()
		// fire-and-forget cleanup of ready unbound media
		cleanupUnboundMedia()
	})

	const handlePublish = async () => {
		if (publishing.value) return
		const ok = await guardCommunityVerification()
		if (!ok) return
		if (!canPublish.value) {
			uni.showToast({
				title: '请添加正文或图片、视频',
				icon: 'none'
			})
			return
		}

		const photos = photoItems.value as LocalMedia[]
		const videos = videoItems.value as LocalMedia[]
		for (let i = 0; i < photos.length; i++) {
			if (photos[i].mediaId > 0 && !(await confirmMediaReady(photos[i]))) return
		}
		for (let i = 0; i < videos.length; i++) {
			if (videos[i].mediaId > 0 && !(await confirmMediaReady(videos[i]))) return
		}
		const hasText = content.value.trim().length > 0
		let hasFailedMedia = false
		for (let i = 0; i < photos.length; i++) {
			if (photos[i].status == 'uploading' || photos[i].status == 'pending') {
				uni.showToast({ title: '图片上传中，请稍候', icon: 'none' })
				return
			}
			if (photos[i].status == 'failed') {
				hasFailedMedia = true
			}
		}
		for (let i = 0; i < videos.length; i++) {
			if (videos[i].status == 'uploading' || videos[i].status == 'pending') {
				uni.showToast({ title: '视频上传中，请稍候', icon: 'none' })
				return
			}
			if (videos[i].status == 'failed') {
				hasFailedMedia = true
			}
		}
		if (hasFailedMedia && !hasText) {
			uni.showToast({ title: '媒体上传失败，请重试或删除后发布', icon: 'none' })
			return
		}
		if (hasFailedMedia) uni.showToast({ title: '失败媒体不会发布', icon: 'none' })

		const imageMediaIds: number[] = []
		for (let i = 0; i < photos.length; i++) {
			if (photos[i].status == 'ready' && photos[i].mediaId > 0) {
				imageMediaIds.push(photos[i].mediaId)
			}
		}
		let videoMediaId = 0
		if (videos.length > 0 && videos[0].status == 'ready' && videos[0].mediaId > 0) {
			videoMediaId = videos[0].mediaId
		}

		publishing.value = true
		const fingerprint = publishFingerprint()
		if (pendingPublishKey.value == '' || pendingPublishFingerprint.value != fingerprint) {
			discardPendingPublishKey()
			pendingPublishKey.value = createCommunityCreateKey('post')
			pendingPublishFingerprint.value = fingerprint
		}
		uni.showLoading({ title: '发布中...' })
		try {
			const payload: any = {
				content: content.value.trim(),
				location: location.value,
				topicId: topicId.value,
				visibility: visibility.value,
				declaration: declaration.value,
				idempotencyKey: pendingPublishKey.value
			}
			if (imageMediaIds.length > 0) {
				payload.imageMediaIds = imageMediaIds
			}
			if (videoMediaId > 0) {
				payload.videoMediaId = videoMediaId
			}
			const res = await publishDynamic(payload)
			const data = res != null ? res.data : null
			const bizOk = res != null && res.success && (data == null || data.success != false)
			uni.hideLoading()
			if (bizOk) {
				publishedOk.value = true
				discardPendingPublishKey()
				uni.showToast({ title: '发布成功', icon: 'success' })
				setTimeout(() => {
					uni.navigateBack()
				}, 800)
			} else {
				if (data != null && data.idempotencyRejected === true) {
					discardPendingPublishKey()
				}
				const msg =
					data != null && data.message != null
						? data.message
						: res != null && res.message != null
							? res.message
							: '发布失败，请重试'
				if (showCommunityAuthGuide('' + msg)) return
				uni.showToast({ title: msg, icon: 'none' })
			}
		} catch (e) {
			uni.hideLoading()
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		} finally {
			publishing.value = false
		}
	}
</script>

