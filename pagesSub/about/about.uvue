<template>
	<view class="page">
		<view class="about-nav"><text class="ic ic-sys ic-fanhui nav-back" @tap="goBack"></text><text>关于我们</text><view class="nav-placeholder"></view></view>
		<!-- Hero 区 -->
		<view class="hero">
			<view class="hero-icon-wrap">
				<image class="hero-icon" src="/static/logo.png" mode="aspectFit"></image>
			</view>
			<text class="hero-title">宣誓爱</text>
			<text class="hero-version">V {{ appVersion }}</text>
		</view>

		<!-- 文章列表 -->
		<view class="list-section">
			<view
				class="list-item"
				v-for="(item, index) in articles"
				:key="item.type"
				:class="{ 'list-item-last': index === articles.length - 1 }"
				@click="onItemClick(item)"
			>
				<text class="list-label">{{ item.title }}</text>
				<view class="list-right">
					<text class="ic ic-sys ic-jiantou-you list-arrow" v-if="item.clickable"></text>
				</view>
			</view>
		</view>

		<!-- 页脚 -->
		<view class="footer">
			<text class="footer-tagline">共享相亲资源 加速脱单进程</text>
			<text class="footer-icp">粤ICP备18145793号-4A</text>
			<view class="footer-withdraw" @click="handleWithdraw">
				<text class="withdraw-text">撤回对全部协议的同意</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { getArticles, ArticleListItem } from '@/api/about'

let articles = ref([] as ArticleListItem[])
let loading = ref(true)
let error = ref('')

const appVersion = '1.0.0'
const goBack = () => uni.navigateBack({ delta: 1 })

onMounted(async () => {
	try {
		const res = await getArticles()
		if (!res.success || res.data == null) throw new Error('数据获取失败')
		articles.value = res.data
	} catch (e) {
		error.value = '加载失败，请重试'
		uni.showToast({ title: '加载失败', icon: 'none' })
	} finally {
		loading.value = false
	}
})

const onItemClick = (item: ArticleListItem) => {
	if (!item.clickable) {
		uni.showToast({ title: '当前已是最新版本', icon: 'none' })
		return
	}
	uni.navigateTo({ url: '/pagesSub/about/article?type=' + item.type })
}

const handleWithdraw = () => {
	uni.showModal({
		title: '撤回协议确认',
		content: '若点击确认撤回《用户服务》及《隐私政策》，将无法正常使用 App 功能并退出',
		confirmText: '确认撤回',
		cancelText: '取消',
		confirmColor: '#79B48C',
		success: (res) => {
			if (res.confirm) {
				uni.showToast({ title: '已提交撤回申请', icon: 'none' })
				// TODO: 调用接口撤回协议同意
			}
		}
	})
}
</script>

<style scoped>
