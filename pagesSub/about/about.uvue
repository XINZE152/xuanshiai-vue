.list-section {
	background-color: #FFFFFF;
	margin-top: 20rpx;
}

.list-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 36rpx 40rpx;
	border-bottom: 2rpx solid #F0F0F0;
}

.list-item-last {
	border-bottom: none;
}

.list-label {
	font-size: 30rpx;
	line-height: 1.5;
	letter-spacing: 0.5px;
	color: #1A1A1A;
	flex: 1;
}

.list-right {
	display: flex;
	align-items: center;
	gap: 12rpx;
	flex-shrink: 0;
}

.list-value {
	font-size: 26rpx;
	line-height: 1.5;
	letter-spacing: 0.3px;
	color: #9CA3AF;
}

