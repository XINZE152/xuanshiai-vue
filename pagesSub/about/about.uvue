.about-nav { height: 100px; padding: 44px 20px 0; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: space-between; font-size: 20px; font-weight: 800; }.nav-back,.nav-placeholder { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }.nav-back { font-size: 38px; font-weight: 300; }

