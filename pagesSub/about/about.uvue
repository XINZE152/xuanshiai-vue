	font-size: 26rpx;
	line-height: 1.7;
	letter-spacing: 0.5px;
	color: #9CA3AF;
	text-align: center;
}

.footer-icp {
	font-size: 24rpx;
	line-height: 1.7;
	letter-spacing: 0.4px;
	color: #B0B0B0;
	text-align: center;
}

.footer-withdraw {
	padding: 20rpx 48rpx;
	border-radius: 40rpx;
	background-color: #F5F5F5;
	margin-top: 16rpx;
}

