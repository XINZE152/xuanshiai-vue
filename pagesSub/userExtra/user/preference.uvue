<template>
	<view class="page">
		<view class="nav-bar" :style="{ paddingTop: statusBarHeight + 'px' }">
			<view class="nav-back" @tap="goBack"><text class="nav-back-icon">‹</text></view>
			<text class="nav-title">择偶标准</text>
			<view class="nav-placeholder"></view>
		</view>

		<view v-if="loading" class="state"><text>正在加载择偶标准...</text></view>
		<view v-else-if="!loaded" class="state" @tap="load"><text>择偶标准加载失败，点击重试</text></view>
		<scroll-view v-else class="content" scroll-y enhanced show-scrollbar="false">
			<view class="sync-row">
				<view class="led" :class="{ 'led-on': !ledDirty }"></view>
				<text class="sync-text">{{ ledDirty ? '未保存' : '已保存' }}</text>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">年龄</text><text class="mod-tip">拖动旋钮调整范围</text></view>
				<view class="readout">
					<text class="readout-main">{{ ageReadout }}</text>
					<text v-if="ageUnit != ''" class="readout-unit">{{ ageUnit }}</text>
				</view>
				<view id="age-track" class="track" @touchstart="onAgeTrackTouchStart" @touchmove="onAgeTrackTouchMove" @touchend="onTrackTouchEnd">
					<view class="ticks"><view v-for="i in 21" :key="i" class="tick"></view></view>
					<view class="zone" :style="{ left: ageLoPct + '%', width: ageZoneWidth + '%' }"></view>
					<view class="knob" :style="{ left: ageLoPct + '%' }"><view class="knob-dot"></view></view>
					<view class="knob" :style="{ left: ageHiPct + '%' }"><view class="knob-dot"></view></view>
				</view>
				<view class="scale"><text>18</text><text>28</text><text>39</text><text>49</text><text>60</text></view>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">身高</text><text class="mod-tip">拖动旋钮调整范围</text></view>
				<view class="readout">
					<text class="readout-main">{{ heightReadout }}</text>
					<text v-if="heightUnit != ''" class="readout-unit">{{ heightUnit }}</text>
				</view>
				<view id="height-track" class="track" @touchstart="onHeightTrackTouchStart" @touchmove="onHeightTrackTouchMove" @touchend="onTrackTouchEnd">
					<view class="ticks"><view v-for="i in 17" :key="i" class="tick"></view></view>
					<view class="zone" :style="{ left: heightLoPct + '%', width: heightZoneWidth + '%' }"></view>
					<view class="knob" :style="{ left: heightLoPct + '%' }"><view class="knob-dot"></view></view>
					<view class="knob" :style="{ left: heightHiPct + '%' }"><view class="knob-dot"></view></view>
				</view>
				<view class="scale"><text>140</text><text>160</text><text>180</text><text>200</text><text>220</text></view>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">学历</text><text class="mod-tip">达到或高于所选</text></view>
				<view class="readout">
					<text class="readout-main">{{ eduReadout }}</text>
					<text v-if="eduMin != null" class="readout-unit">及以上</text>
				</view>
				<view id="edu-track" class="detents" @touchstart="onEduTrackTouchStart">
					<view class="detent-line"></view>
					<view class="detent-ind" :style="{ left: 'calc(' + eduIndex + ' * 100% / 9)' }"></view>
				</view>
				<view class="detent-labels">
					<text v-for="(label, index) in eduLabels" :key="label" class="detent-label" :class="{ 'detent-label-on': eduIndex == index }" @tap="setEduIndex(index)">{{ label }}</text>
				</view>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">收入</text><text class="mod-tip">对 TA 的年收入底线</text></view>
				<view class="readout">
					<text class="readout-main">{{ incomeReadout }}</text>
				</view>
				<view id="income-track" class="detents" @touchstart="onIncomeTrackTouchStart">
					<view class="detent-line"></view>
					<view class="detent-ind" :style="{ left: 'calc(' + incomeIndex + ' * 100% / 6)', width: 'calc(100% / 6)' }"></view>
				</view>
				<view class="detent-labels">
					<text v-for="(label, index) in incomeLabels" :key="label" class="detent-label" :class="{ 'detent-label-on': incomeIndex == index }" @tap="setIncomeIndex(index)">{{ label }}</text>
				</view>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">距离</text><text class="mod-tip">三挡拨段</text></view>
				<view class="segs">
					<view class="seg-ind" :style="segIndStyle(3, dist)"></view>
					<view class="seg seg-tall" @tap="setDist(0)">
						<text class="seg-name" :class="{ 'seg-name-on': dist == 0 }">最好同城</text>
						<text class="seg-sub">就在这座城市</text>
					</view>
					<view class="seg seg-tall" @tap="setDist(1)">
						<text class="seg-name" :class="{ 'seg-name-on': dist == 1 }">异地也可以</text>
						<text class="seg-sub">同省不同城</text>
					</view>
					<view class="seg seg-tall" @tap="setDist(2)">
						<text class="seg-name" :class="{ 'seg-name-on': dist == 2 }">距离不是问题</text>
						<text class="seg-sub">跨省也接受</text>
					</view>
				</view>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">更多条件</text><text class="mod-tip">不选即不限</text></view>
				<view class="plan-row">
					<text class="plan-label">婚姻状况</text>
					<view class="segs segs-small">
						<view class="seg-ind" :style="segIndStyle(marryOptions.length, marryReq)"></view>
						<view v-for="(option, oi) in marryOptions" :key="option" class="seg" @tap="setMarryReq(oi)">
							<text class="seg-name" :class="{ 'seg-name-on': marryReq == oi }">{{ option }}</text>
						</view>
					</view>
				</view>
				<view class="plan-row">
					<text class="plan-label">住房要求</text>
					<view class="segs segs-small">
						<view class="seg-ind" :style="segIndStyle(housingOptions.length, houseReq)"></view>
						<view v-for="(option, oi) in housingOptions" :key="option" class="seg" @tap="setHouseReq(oi)">
							<text class="seg-name" :class="{ 'seg-name-on': houseReq == oi }">{{ option }}</text>
						</view>
					</view>
				</view>
				<view class="plan-row">
					<text class="plan-label">吸烟要求</text>
					<view class="segs segs-small">
						<view class="seg-ind" :style="segIndStyle(smokingOptions.length, smokeReq)"></view>
						<view v-for="(option, oi) in smokingOptions" :key="option" class="seg" @tap="setSmokeReq(oi)">
							<text class="seg-name" :class="{ 'seg-name-on': smokeReq == oi }">{{ option }}</text>
						</view>
					</view>
				</view>
				<view class="plan-row">
					<text class="plan-label">饮酒要求</text>
					<view class="segs segs-small">
						<view class="seg-ind" :style="segIndStyle(drinkingOptions.length, drinkReq)"></view>
						<view v-for="(option, oi) in drinkingOptions" :key="option" class="seg" @tap="setDrinkReq(oi)">
							<text class="seg-name" :class="{ 'seg-name-on': drinkReq == oi }">{{ option }}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">期望地区</text><text class="mod-tip">先选省份，可不选城市</text></view>
				<picker class="area-row" mode="selector" :range="provinceOptions" :value="provinceIndex" @change="onProvinceChange">
					<view class="area-row-inner">
						<text class="area-label">省份</text>
						<view class="area-value"><text class="area-value-text">{{ provinceDisplay }}</text><text class="area-arrow">›</text></view>
					</view>
				</picker>
				<view v-if="citiesOfPrefProvince.length > 0" class="keys area-keys">
					<view v-for="city in citiesOfPrefProvince" :key="city.code" class="key" :class="{ 'key-on': prefCities.indexOf(city.code) >= 0 }" @tap="togglePrefCity(city.code)">
						<text>{{ city.name }}</text>
					</view>
				</view>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">关系期待</text><text class="mod-tip">可留空，再次点击可取消</text></view>
                <view v-for="(group, gi) in planGroups" :key="group.key" class="plan-row">
                    <text class="plan-label">{{ group.label }}</text>
                    <view class="keys plan-keys">
                        <view v-for="(option, oi) in group.opts" :key="option" class="key plan-key" :class="{ 'key-on': planValue(gi) == oi }" @tap="setPlan(gi, oi)"><text>{{ option }}</text></view>
                    </view>
                </view>
			</view>

			<view class="mod">
				<view class="mod-head"><text class="mod-name">期待</text><text class="mod-tip">可多选，不选也行</text></view>
				<view class="keys">
					<view v-for="option in extraOptions" :key="option" class="key" :class="{ 'key-on': extras.indexOf(option) >= 0 }" @tap="toggleExtra(option)">
						<text>{{ option }}</text>
					</view>
				</view>
			</view>

			<view class="content-spacer"></view>
		</scroll-view>

		<view class="footer">
			<view class="cancel-button" hover-class="hv-press" @tap="goBack"><text>取消</text></view>
			<view class="save-button" :class="{ disabled: saving || loading || !loaded || saved }" hover-class="hv-press" @tap="save"><text>{{ saving ? '保存中...' : '保存' }}</text></view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { getOwnPreferences, updateOwnPreferences } from '@/api'
import locationJson from '@/data/location.json'

const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20

const AGE_MIN = 18
const AGE_MAX = 60
const HEIGHT_MIN = 140
const HEIGHT_MAX = 220
// 学历阶梯按升序展示（不限到博士）；education_min 存旧版降序下标（1 博士 - 8 小学），两者换算为 9 - 下标
const eduLabels = ['不限', '小学', '初中', '高中', '中专', '大专', '本科', '硕士', '博士']
// 吸烟/饮酒要求已由 smoking/drinking_requirement 结构化承载，不再进 extra_requirement；历史旧选项在下次保存时清除
const extraOptions = ['有稳定工作', '重视家庭', '愿意认真沟通']
// 与后端 PreferenceUpdateRequest 对齐：婚姻 0 不限 1 未婚 2 离异 3 丧偶；住房 0 不限 1 有房 2 无房；烟酒 0 不限 1 不抽(饮) 2 可接受
const marryOptions = ['不限', '未婚', '离异', '丧偶']
const housingOptions = ['不限', '有房', '无房']
const smokingOptions = ['不限', '不抽烟', '可接受']
const drinkingOptions = ['不限', '不饮酒', '可接受']
// income_min 与资料 income 同尺度（年收入，元），挡位对齐资料收入区间档
const incomeLabels = ['不限', '10w', '20w', '30w', '50w', '100w']
const incomeStopValues = [0, 100000, 200000, 300000, 500000, 1000000]
const provinceList: any[] = Array.isArray(locationJson) ? locationJson as any[] : []
const provinceOptions: string[] = ['不限']
for (let i = 0; i < provinceList.length; i++) provinceOptions.push('' + provinceList[i].name)
const planGroups = [
	{ key: 'dating_goal', label: '我的关系目标', opts: ['倾向恋爱', '倾向结婚'] },
	{ key: 'meeting_pace', label: '我期待的见面节奏', opts: ['倾向尽快见面', '真诚高效', '了解清楚再见面', '都行看对方的见面意愿'] },
	{ key: 'children_intention', label: '我的生育意愿', opts: ['想要孩子', '看情况决定是否要孩子', '不想要孩子'] }
] as any[]

const loading = ref(true)
const loaded = ref(false)
const saved = ref(false)
const saving = ref(false)
const ledDirty = ref(false)
const ageMin = ref(null as any)
const ageMax = ref(null as any)
const heightMin = ref(null as any)
const heightMax = ref(null as any)
const eduMin = ref(null as any)
const dist = ref(2)
const planGoal = ref(-1)
const planPace = ref(-1)
const planKids = ref(-1)
const extras = ref([] as string[])
const smokeReq = ref(0)
const drinkReq = ref(0)
const houseReq = ref(0)
const marryReq = ref(0)
const incomeMin = ref(null as any)
const prefProvince = ref('')
const prefCities = ref([] as string[])

const dragTarget = ref('')
const dragRect = ref(null as any)
const dragLo = ref(false)
const dragStartX = ref(0)
const dragPending = ref(false)

const clampInt = (value: any, min: number, max: number, fallback: number): number => {
	if (value == null) return fallback
	const num = Number(value)
	if (isNaN(num)) return fallback
	return Math.min(max, Math.max(min, Math.round(num)))
}

const pctOf = (value: number, min: number, max: number): number => (value - min) / (max - min) * 100

const ageLo = computed(() : number => ageMin.value == null ? AGE_MIN : Number(ageMin.value))
const ageHi = computed(() : number => ageMax.value == null ? AGE_MAX : Number(ageMax.value))
const heightLo = computed(() : number => heightMin.value == null ? HEIGHT_MIN : Number(heightMin.value))
const heightHi = computed(() : number => heightMax.value == null ? HEIGHT_MAX : Number(heightMax.value))

const ageLoPct = computed(() : number => pctOf(ageLo.value, AGE_MIN, AGE_MAX))
const ageHiPct = computed(() : number => pctOf(ageHi.value, AGE_MIN, AGE_MAX))
const ageZoneWidth = computed(() : number => ageHiPct.value - ageLoPct.value)
const heightLoPct = computed(() : number => pctOf(heightLo.value, HEIGHT_MIN, HEIGHT_MAX))
const heightHiPct = computed(() : number => pctOf(heightHi.value, HEIGHT_MIN, HEIGHT_MAX))
const heightZoneWidth = computed(() : number => heightHiPct.value - heightLoPct.value)

const ageReadout = computed(() : string => {
	if (ageMin.value == null && ageMax.value == null) return '不限'
	if (ageMin.value == null) return '' + ageHi.value + ' 岁以内'
	if (ageMax.value == null) return '' + ageLo.value + ' 岁以上'
	return '' + ageLo.value + ' ~ ' + ageHi.value
})
const ageUnit = computed(() : string => ageMin.value == null && ageMax.value == null ? '' : '岁')
const heightReadout = computed(() : string => {
	if (heightMin.value == null && heightMax.value == null) return '不限'
	if (heightMin.value == null) return '' + heightHi.value + ' cm 以内'
	if (heightMax.value == null) return '' + heightLo.value + ' cm 以上'
	return '' + heightLo.value + ' ~ ' + heightHi.value
})
const heightUnit = computed(() : string => heightMin.value == null && heightMax.value == null ? '' : 'cm')
const eduIndex = computed(() : number => eduMin.value == null ? 0 : 9 - Number(eduMin.value))
const eduReadout = computed(() : string => eduMin.value == null ? '不限' : eduLabels[eduIndex.value])
const incomeIndex = computed(() : number => {
	const v = incomeMin.value == null ? 0 : Number(incomeMin.value)
	if (isNaN(v) || v <= 0) return 0
	let best = 1
	for (let i = 2; i < incomeStopValues.length; i++) {
		if (Math.abs(incomeStopValues[i] - v) < Math.abs(incomeStopValues[best] - v)) best = i
	}
	return best
})
const incomeReadout = computed(() : string => incomeIndex.value == 0 ? '不限' : incomeLabels[incomeIndex.value] + ' 以上')
const provinceIndex = computed(() : number => {
	if (prefProvince.value == '') return 0
	for (let i = 0; i < provinceList.length; i++) {
		if ('' + provinceList[i].code == prefProvince.value) return i + 1
	}
	return 0
})
const provinceDisplay = computed(() : string => provinceIndex.value == 0 ? '不限' : provinceOptions[provinceIndex.value])
const citiesOfPrefProvince = computed(() : any[] => {
	const idx = provinceIndex.value
	if (idx == 0) return []
	const cities = provinceList[idx - 1].city
	return Array.isArray(cities) ? cities as any[] : []
})

const markDirty = () => { ledDirty.value = true }

const segIndStyle = (count: number, index: number): string => {
	const cell = '(100% - 12rpx) / ' + count
	return 'width: calc(' + cell + '); left: calc(6rpx + ' + cell + ' * ' + index + ');'
}

const planValue = (gi: number): number => gi == 0 ? planGoal.value : (gi == 1 ? planPace.value : planKids.value)

const setDist = (value: number) => {
	if (dist.value == value) return
	dist.value = value
	markDirty()
}
const setPlan = (gi: number, oi: number) => {
	if (saving.value || saved.value) return
	if (planValue(gi) == oi) oi = -1
	if (gi == 0) planGoal.value = oi
	else if (gi == 1) planPace.value = oi
	else planKids.value = oi
	markDirty()
}
const setEduIndex = (index: number) => {
	if (eduIndex.value == index) return
	eduMin.value = index == 0 ? null : (9 - index)
	markDirty()
}
const setIncomeIndex = (index: number) => {
	if (incomeIndex.value == index) return
	incomeMin.value = index == 0 ? null : incomeStopValues[index]
	markDirty()
}
const setMarryReq = (v: number) => { if (marryReq.value != v) { marryReq.value = v; markDirty() } }
const setHouseReq = (v: number) => { if (houseReq.value != v) { houseReq.value = v; markDirty() } }
const setSmokeReq = (v: number) => { if (smokeReq.value != v) { smokeReq.value = v; markDirty() } }
const setDrinkReq = (v: number) => { if (drinkReq.value != v) { drinkReq.value = v; markDirty() } }

const provinceCodeByCity = (code: string): string => {
	if (code.length < 2) return ''
	for (let i = 0; i < provinceList.length; i++) {
		if (('' + provinceList[i].code).substring(0, 2) == code.substring(0, 2)) return '' + provinceList[i].code
	}
	return ''
}

const onProvinceChange = (e: any) => {
	const raw = e.detail != null && e.detail.value != null ? Number(e.detail.value) : 0
	const next = raw >= 1 && raw <= provinceList.length ? '' + provinceList[raw - 1].code : ''
	if (next == prefProvince.value) return
	prefProvince.value = next
	prefCities.value = []
	markDirty()
}

const togglePrefCity = (raw: any) => {
	const code = '' + raw
	const index = prefCities.value.indexOf(code)
	if (index >= 0) prefCities.value.splice(index, 1)
	else {
		if (prefCities.value.length >= 20) {
			uni.showToast({ title: '最多选择 20 个城市', icon: 'none' })
			return
		}
		prefCities.value.push(code)
	}
	markDirty()
}
const toggleExtra = (option: string) => {
	const index = extras.value.indexOf(option)
	if (index >= 0) extras.value.splice(index, 1)
	else extras.value.push(option)
	markDirty()
}

const queryRect = (id: string, callback: (rect: any) => void) => {
	uni.createSelectorQuery().select('#' + id).boundingClientRect((rect: any) => {
		callback(rect)
	}).exec()
}

const applyTrackValue = (clientX: number, min: number, span: number, setLo: (v: number) => void, setHi: (v: number) => void, getLo: () => number, getHi: () => number) => {
	const rect = dragRect.value
	if (rect == null || Number(rect.width) <= 0) return
	let value = Math.round(min + (clientX - Number(rect.left)) / Number(rect.width) * span)
	value = Math.min(min + span, Math.max(min, value))
	if (dragLo.value) setLo(Math.min(value, getHi()))
	else setHi(Math.max(value, getLo()))
	markDirty()
}

// 上下限旋钮重合（如同为极端值）时无法按就近判定归属，改按首次滑动方向挑有活动空间的旋钮
const resolveDragLo = (dx: number, min: number, max: number, getLo: () => number, getHi: () => number): boolean => {
	if (dx > 0) {
		if (getHi() < max) return false
		return getLo() < getHi()
	}
	if (getLo() > min) return true
	return getHi() > getLo()
}

const onAgeTrackTouchStart = (e: any) => {
	const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
	if (touch == null) return
	queryRect('age-track', (rect: any) => {
		if (rect == null) return
		dragRect.value = rect
		const x = Number(touch.clientX)
		const loX = Number(rect.left) + Number(rect.width) * (Number(ageMin.value == null ? AGE_MIN : ageMin.value) - AGE_MIN) / (AGE_MAX - AGE_MIN)
		const hiX = Number(rect.left) + Number(rect.width) * (Number(ageMax.value == null ? AGE_MAX : ageMax.value) - AGE_MIN) / (AGE_MAX - AGE_MIN)
		const tie = Math.abs(x - loX) == Math.abs(x - hiX)
		dragLo.value = Math.abs(x - loX) <= Math.abs(x - hiX)
		dragStartX.value = x
		dragPending.value = tie
		dragTarget.value = 'age'
		if (!tie) applyTrackValue(x, AGE_MIN, AGE_MAX - AGE_MIN,
			(v: number) => { ageMin.value = v },
			(v: number) => { ageMax.value = v },
			() : number => ageLo.value,
			() : number => ageHi.value)
	})
}
const onAgeTrackTouchMove = (e: any) => {
	if (dragTarget.value != 'age') return
	const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
	if (touch == null) return
	const x = Number(touch.clientX)
	if (dragPending.value) {
		const dx = x - Number(dragStartX.value)
		if (Math.abs(dx) < 2) return
		dragPending.value = false
		dragLo.value = resolveDragLo(dx, AGE_MIN, AGE_MAX, () : number => ageLo.value, () : number => ageHi.value)
	}
	applyTrackValue(x, AGE_MIN, AGE_MAX - AGE_MIN,
		(v: number) => { ageMin.value = v },
		(v: number) => { ageMax.value = v },
		() : number => ageLo.value,
		() : number => ageHi.value)
}

const onHeightTrackTouchStart = (e: any) => {
	const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
	if (touch == null) return
	queryRect('height-track', (rect: any) => {
		if (rect == null) return
		dragRect.value = rect
		const x = Number(touch.clientX)
		const loX = Number(rect.left) + Number(rect.width) * (Number(heightMin.value == null ? HEIGHT_MIN : heightMin.value) - HEIGHT_MIN) / (HEIGHT_MAX - HEIGHT_MIN)
		const hiX = Number(rect.left) + Number(rect.width) * (Number(heightMax.value == null ? HEIGHT_MAX : heightMax.value) - HEIGHT_MIN) / (HEIGHT_MAX - HEIGHT_MIN)
		const tie = Math.abs(x - loX) == Math.abs(x - hiX)
		dragLo.value = Math.abs(x - loX) <= Math.abs(x - hiX)
		dragStartX.value = x
		dragPending.value = tie
		dragTarget.value = 'height'
		if (!tie) applyTrackValue(x, HEIGHT_MIN, HEIGHT_MAX - HEIGHT_MIN,
			(v: number) => { heightMin.value = v },
			(v: number) => { heightMax.value = v },
			() : number => heightLo.value,
			() : number => heightHi.value)
	})
}
const onHeightTrackTouchMove = (e: any) => {
	if (dragTarget.value != 'height') return
	const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
	if (touch == null) return
	const x = Number(touch.clientX)
	if (dragPending.value) {
		const dx = x - Number(dragStartX.value)
		if (Math.abs(dx) < 2) return
		dragPending.value = false
		dragLo.value = resolveDragLo(dx, HEIGHT_MIN, HEIGHT_MAX, () : number => heightLo.value, () : number => heightHi.value)
	}
	applyTrackValue(x, HEIGHT_MIN, HEIGHT_MAX - HEIGHT_MIN,
		(v: number) => { heightMin.value = v },
		(v: number) => { heightMax.value = v },
		() : number => heightLo.value,
		() : number => heightHi.value)
}

const onTrackTouchEnd = () => { dragTarget.value = ''; dragPending.value = false }

const detentTap = (id: string, e: any, stops: number, apply: (index: number) => void) => {
	const touch = e.touches != null && e.touches.length > 0 ? e.touches[0] : null
	if (touch == null) return
	queryRect(id, (rect: any) => {
		if (rect == null || Number(rect.width) <= 0) return
		const p = (Number(touch.clientX) - Number(rect.left)) / Number(rect.width)
		apply(Math.min(stops - 1, Math.max(0, Math.floor(p * stops))))
	})
}

const onEduTrackTouchStart = (e: any) => { detentTap('edu-track', e, eduLabels.length, setEduIndex) }
const onIncomeTrackTouchStart = (e: any) => { detentTap('income-track', e, incomeLabels.length, setIncomeIndex) }

const load = async () => {
	loading.value = true
	loaded.value = false
	try {
		const response = await getOwnPreferences()
		if (!response.success || response.data == null) {
			uni.showToast({ title: response.message != null ? '' + response.message : '择偶标准加载失败', icon: 'none' })
			return
		}
		const data = response.data as any
		planGoal.value = planGroups[0].opts.indexOf(data.dating_goal)
		planPace.value = planGroups[1].opts.indexOf(data.meeting_pace)
		planKids.value = planGroups[2].opts.indexOf(data.children_intention)
		ageMin.value = data.age_min
		ageMax.value = data.age_max
		heightMin.value = data.height_min
		heightMax.value = data.height_max
		const eduNum = data.education_min == null ? null : Number(data.education_min)
		eduMin.value = eduNum == null || eduNum == 0 ? null : eduNum
		const acceptLongDistance = data.accept_long_distance == true
		const acceptCrossProvince = data.accept_cross_province == true
		// 跨省必含异地；历史数据出现「跨省接受但异地不接受」时按更宽一档归一
		dist.value = acceptCrossProvince ? 2 : (acceptLongDistance ? 1 : 0)
		smokeReq.value = clampInt(data.smoking_requirement, 0, 2, 0)
		drinkReq.value = clampInt(data.drinking_requirement, 0, 2, 0)
		houseReq.value = clampInt(data.housing_requirement, 0, 2, 0)
		marryReq.value = clampInt(data.marriage_status, 0, 3, 0)
		const incomeNum = data.income_min == null ? null : Number(data.income_min)
		incomeMin.value = incomeNum != null && !isNaN(incomeNum) && incomeNum > 0 ? incomeNum : null
		const rawProvince = data.preferred_province_code != null ? '' + data.preferred_province_code : ''
		const rawCities: string[] = []
		if (Array.isArray(data.preferred_city_codes)) {
			const cityRaw = data.preferred_city_codes as any[]
			for (let i = 0; i < cityRaw.length; i++) {
				const code = cityRaw[i] == null ? '' : '' + cityRaw[i]
				if (code != '' && rawCities.indexOf(code) < 0) rawCities.push(code)
			}
		}
		prefCities.value = rawCities
		prefProvince.value = rawProvince != '' ? rawProvince : (rawCities.length > 0 ? provinceCodeByCity(rawCities[0]) : '')
		const rawExtra = data.extra_requirement != null ? '' + data.extra_requirement : ''
		const parsed: string[] = []
		if (rawExtra != '' && rawExtra != '无其他要求') {
			const parts = rawExtra.split(',')
			for (let i = 0; i < parts.length; i++) {
				const part = parts[i].trim()
				if (part != '' && extraOptions.indexOf(part) >= 0 && parsed.indexOf(part) < 0) parsed.push(part)
			}
		}
		extras.value = parsed
		ledDirty.value = false
		loaded.value = true
	} catch (error) {
		uni.showToast({ title: '网络异常，请重试', icon: 'none' })
	} finally {
		loading.value = false
	}
}

const save = async () => {
	if (saving.value || loading.value || !loaded.value || saved.value) return
	if (ageMin.value != null && ageMax.value != null && Number(ageMin.value) > Number(ageMax.value)) {
		uni.showToast({ title: '年龄下限不能大于上限', icon: 'none' })
		return
	}
	if (heightMin.value != null && heightMax.value != null && Number(heightMin.value) > Number(heightMax.value)) {
		uni.showToast({ title: '身高下限不能大于上限', icon: 'none' })
		return
	}
	saving.value = true
	try {
		const response = await updateOwnPreferences({
			age_min: ageMin.value,
			age_max: ageMax.value,
			height_min: heightMin.value,
			height_max: heightMax.value,
			education_min: eduMin.value,
			accept_long_distance: dist.value >= 1,
			accept_cross_province: dist.value == 2,
			income_min: incomeMin.value,
			marriage_status: marryReq.value,
			preferred_province_code: prefProvince.value != '' ? prefProvince.value : null,
			preferred_city_codes: prefCities.value,
			housing_requirement: houseReq.value,
			smoking_requirement: smokeReq.value,
			drinking_requirement: drinkReq.value,
			dating_goal: planGoal.value >= 0 ? planGroups[0].opts[planGoal.value] : null,
			meeting_pace: planPace.value >= 0 ? planGroups[1].opts[planPace.value] : null,
			children_intention: planKids.value >= 0 ? planGroups[2].opts[planKids.value] : null,
			extra_requirement: extras.value.length > 0 ? extras.value.join(',') : null
		})
		if (!response.success) {
			uni.showToast({ title: response.message != null ? '' + response.message : '择偶标准保存失败', icon: 'none' })
			return
		}
		saved.value = true
		ledDirty.value = false
		uni.showToast({ title: '择偶标准已保存', icon: 'success' })
		setTimeout(() => goBack(), 500)
	} catch (error) {
		uni.showToast({ title: '保存失败，已保留选择，请重试', icon: 'none' })
	} finally {
		saving.value = false
	}
}

const goBack = () => { uni.navigateBack({ delta: 1 }) }
onMounted(() => { load() })
</script>

<style scoped>
.page { min-height: 100vh; display: flex; flex-direction: column; background: var(--canvas); color: var(--ink); }
.nav-bar { flex-shrink: 0; min-height: 88rpx; padding-left: 24rpx; padding-right: 24rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; background: var(--paper); border-bottom: 1px solid var(--line); }
.nav-back, .nav-placeholder { width: 72rpx; height: 72rpx; flex-shrink: 0; }
.nav-back { display: flex; align-items: center; justify-content: center; }
.nav-back-icon { color: var(--ink); font-size: 56rpx; font-weight: 700; line-height: 1; }
.nav-title { flex: 1; color: var(--ink); font-size: 34rpx; font-weight: 700; text-align: center; }
.state { flex: 1; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 26rpx; }
.content { flex: 1; height: 0; padding: 20rpx 24rpx 0; box-sizing: border-box; }

.sync-row { display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; padding: 4rpx 8rpx 14rpx; }
.led { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: var(--line); transition: background-color 0.18s ease-out; }
.led-on { background: var(--sage); }
.sync-text { color: var(--muted); font-size: 22rpx; }

.mod { background: var(--surface); border: 1px solid var(--line); border-radius: 24rpx; padding: 30rpx 28rpx 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-sm); }
.mod-head { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; }
.mod-name { color: var(--ink); font-size: 28rpx; font-weight: 700; }
.mod-tip { color: var(--muted); font-size: 22rpx; }

.readout { display: flex; flex-direction: row; align-items: baseline; margin: 20rpx 0 20rpx; }
.readout-main { color: var(--ink); font-size: 52rpx; font-weight: 800; line-height: 1.1; }
.readout-unit { margin-left: 12rpx; color: var(--ink2); font-size: 26rpx; font-weight: 500; }

.track { position: relative; height: 92rpx; }
.ticks { position: absolute; left: 0; right: 0; top: 22rpx; height: 48rpx; display: flex; flex-direction: row; align-items: stretch; justify-content: space-between; }
.tick { width: 2rpx; background: var(--line); }
.zone { position: absolute; top: 28rpx; height: 36rpx; background: var(--accent-glow); border-top: 4rpx solid var(--accent); border-bottom: 4rpx solid var(--accent); }
.knob { position: absolute; top: 46rpx; width: 40rpx; height: 40rpx; margin-left: -20rpx; margin-top: -20rpx; border-radius: 20rpx; background: var(--surface); border: 3rpx solid var(--ink); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }
.knob-dot { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: var(--accent); }
.scale { display: flex; flex-direction: row; justify-content: space-between; margin-top: 6rpx; color: var(--muted); font-size: 20rpx; }

.detents { position: relative; height: 76rpx; }
.detent-line { position: absolute; left: 0; right: 0; top: 37rpx; height: 3rpx; background: var(--line); }
.detent-ind { position: absolute; top: 6rpx; height: 64rpx; width: calc(100% / 9); border-radius: 16rpx; background: var(--accent-glow); border: 3rpx solid var(--accent); transition: left 0.18s ease-out; }
.detent-labels { display: flex; flex-direction: row; margin-top: 8rpx; }
.detent-label { flex: 1; text-align: center; color: var(--muted); font-size: 20rpx; }
.detent-label-on { color: var(--accent2); font-weight: 700; }

.segs { position: relative; display: flex; flex-direction: row; margin-top: 26rpx; background: var(--canvas); border: 1px solid var(--line); border-radius: 22rpx; padding: 6rpx; }
.seg-ind { position: absolute; top: 6rpx; bottom: 6rpx; border-radius: 16rpx; background: var(--surface); border: 2rpx solid var(--accent); box-shadow: var(--shadow-sm); transition: left 0.18s ease-out; }
.seg { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.seg-tall { height: 120rpx; }
.segs-small .seg { height: 72rpx; }
.segs-small { margin-top: 14rpx; }
.seg-name { color: var(--ink2); font-size: 26rpx; font-weight: 600; transition: color 0.18s ease-out; }
.seg-name-on { color: var(--accent2); }
.seg-sub { color: var(--muted); font-size: 20rpx; }

.plan-keys { margin-top: 14rpx; }
.plan-key { width: calc((100% - 16rpx) / 2); height: auto; min-height: 88rpx; padding: 18rpx 12rpx; text-align: center; }
.plan-key > text { font-size: 24rpx; }
.plan-row { margin-top: 22rpx; }
.plan-label { display: block; color: var(--ink2); font-size: 25rpx; font-weight: 700; margin-bottom: 4rpx; }

.keys { display: flex; flex-direction: row; flex-wrap: wrap; gap: 16rpx; margin-top: 26rpx; }
.key { width: calc((100% - 32rpx) / 3); height: 104rpx; display: flex; align-items: center; justify-content: center; background: var(--surface); border: 2rpx solid var(--line); border-radius: 20rpx; box-shadow: 0 4rpx 0 var(--bg-subtle); }
.key > text { color: var(--ink2); font-size: 26rpx; font-weight: 600; }
.key-on { border-color: var(--accent); background: var(--accent-glow); box-shadow: 0 4rpx 0 var(--accent-glow); }
.key-on > text { color: var(--accent2); }

.area-row { display: block; margin-top: 22rpx; background: var(--canvas); border: 1px solid var(--line); border-radius: 20rpx; padding: 22rpx 24rpx; }
.area-row-inner { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.area-label { color: var(--ink2); font-size: 26rpx; font-weight: 600; }
.area-value { display: flex; flex-direction: row; align-items: center; }
.area-value-text { color: var(--ink); font-size: 26rpx; font-weight: 600; }
.area-arrow { margin-left: 10rpx; color: var(--muted); font-size: 30rpx; }
.area-keys { margin-top: 18rpx; }

.hv-press { transform: scale(0.98); opacity: 0.85; }

.content-spacer { height: 40rpx; }
.footer { flex-shrink: 0; display: flex; flex-direction: row; gap: 20rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1px solid var(--line); }
.cancel-button, .save-button { flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; }
.cancel-button { background: var(--warm); color: var(--ink2); }
.save-button { background: var(--accent); color: var(--text-invert); box-shadow: var(--shadow-sm); }
.save-button.disabled { opacity: 0.55; pointer-events: none; }
</style>
