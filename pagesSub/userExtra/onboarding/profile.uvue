<template>
	<view class="onboarding-page">
		<view class="topbar">
			<view class="back-button-hit" @tap="handleBack"></view>
			<view class="topbar-space"></view>
			<view class="topbar-space"></view>
		</view>

		<!-- 资料保存后的收尾页：AI 画像是选填入口，不阻塞注册 -->
		<view v-if="finished" class="finish-page">
			<view class="finish-copy">
				<text class="hero-title">资料填好了</text>
				<text class="hero-subtitle">接下来让知遇和你聊几句，把你说过的话整理成一份画像，再帮你写成自我介绍和 3 个问答，直接填进资料里。</text>
			</view>
			<view class="finish-card">
				<text class="finish-card-title">关于知遇</text>
				<text class="finish-card-line">只在你同意后开始，授权随时可以撤回</text>
				<text class="finish-card-line">聊得越具体，整理出来的内容越像你自己</text>
				<text class="finish-card-line">生成的内容不会自动公开，需要你逐项确认才会写入</text>
			</view>
			<view class="finish-actions">
				<button v-if="aiEntryAvailable" class="finish-primary" :disabled="aiEntryBusy" @click="openAiPortrait">{{ aiEntryBusy ? '正在进入…' : '让知遇认识我，生成 AI 画像' }}</button>
				<view v-else class="finish-primary finish-primary-disabled">
					<text class="finish-primary-text">{{ aiEntryChecked ? 'AI 画像正在准备中' : '正在检查 AI 画像…' }}</text>
					<text class="finish-primary-sub">可以先逛逛，稍后从「我的 - 知遇」进入</text>
				</view>
				<button class="finish-secondary" @click="goHomeAfterOnboarding">先去逛逛</button>
			</view>
		</view>

		<view v-else-if="step === 0" class="identity-page">
			<view class="hero-copy">
				<text class="hero-title">欢迎加入<text class="hero-emphasis">宣誓爱</text></text>
				<text class="hero-subtitle">请选择您要注册的身份</text>
			</view>
			<view class="role-list">
				<view
					v-for="role in roles"
					:key="role.key"
					class="role-card"
					:class="role.tone"
					@tap="chooseRole(role.key)"
				>
					<view class="role-icon" :class="role.iconTone"><text>{{ role.icon }}</text></view>
					<view class="role-copy">
						<text class="role-title">{{ role.title }}</text>
						<text class="role-subtitle">{{ role.subtitle }}</text>
					</view>
					<text class="role-arrow">›</text>
				</view>
			</view>
		</view>

		<view v-else class="step-page">
			<view class="step-head">
				<text class="step-label">完善资料 {{ step }} / {{ totalSteps }}</text>
				<view class="progress-track">
					<view class="progress-fill" :style="{ width: progressWidth + '%' }"></view>
				</view>
			</view>
			<view class="question-head">
				<text class="question-title">{{ currentTitle }}</text>
				<text class="question-hint">这些信息只用于为你推荐更合适的人</text>
			</view>

			<view v-if="currentType === 'date'" class="onboarding-picker">
				<picker-view class="date-picker-view" :value="datePickerValue" indicator-style="height: 52px; background: transparent; border-top: 2px solid #C9CED3; border-bottom: 2px solid #C9CED3;" mask-style="background: linear-gradient(to bottom, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 28%, rgba(255,255,255,0) 72%, rgba(255,255,255,1) 100%);" @pickstart="onWheelStart" @pickend="onWheelEnd" @change="onDatePickerChange">
					<picker-view-column><view v-for="year in yearOptions" :key="year" class="picker-column-item"><text>{{ year }}年</text></view></picker-view-column>
					<picker-view-column><view v-for="month in monthOptions" :key="month" class="picker-column-item"><text>{{ month }}月</text></view></picker-view-column>
					<picker-view-column><view v-for="day in dayOptions" :key="day" class="picker-column-item"><text>{{ day }}日</text></view></picker-view-column>
				</picker-view>
				<text class="picker-selected-text">{{ selectedValue || '上下滑动选择出生日期' }}</text>
			</view>
			<view v-if="currentType === 'picker'" class="onboarding-picker">
				<picker-view class="single-picker-view" :value="pickerViewValue" indicator-style="height: 52px; background: transparent; border-top: 2px solid #C9CED3; border-bottom: 2px solid #C9CED3;" mask-style="background: linear-gradient(to bottom, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 28%, rgba(255,255,255,0) 72%, rgba(255,255,255,1) 100%);" @pickstart="onWheelStart" @pickend="onWheelEnd" @change="onPickerViewChange">
					<picker-view-column><view v-for="option in currentOptions" :key="option" class="picker-column-item"><text>{{ option }}</text></view></picker-view-column>
				</picker-view>
				<text class="picker-selected-text">{{ selectedValue || '上下滑动选择' }}</text>
			</view>
			<view v-if="currentType === 'location'" class="onboarding-picker location-picker">
				<picker-view :key="locationPickerKey" class="location-picker-view" :value="locationPickerValue" indicator-style="height: 52px; background: transparent; border-top: 2px solid #C9CED3; border-bottom: 2px solid #C9CED3;" mask-style="background: linear-gradient(to bottom, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 28%, rgba(255,255,255,0) 72%, rgba(255,255,255,1) 100%);" @pickstart="onWheelStart" @pickend="onWheelEnd" @change="onLocationPickerChange">
					<picker-view-column><view v-for="province in provinceOptions" :key="province" class="picker-column-item"><text>{{ province }}</text></view></picker-view-column>
					<picker-view-column><view v-for="city in cityOptions" :key="city" class="picker-column-item"><text>{{ city }}</text></view></picker-view-column>
					<picker-view-column><view v-for="district in districtOptions" :key="district" class="picker-column-item"><text>{{ district }}</text></view></picker-view-column>
				</picker-view>
			</view>
			<view v-if="currentType === 'grid'" class="option-grid">
				<view
					v-for="option in currentOptions"
					:key="option"
					class="option-chip"
					:class="{ selected: selectedValue === option }"
					@click="selectOption(option)"
				>
					<text>{{ option }}</text>
				</view>
			</view>
			<view v-if="currentType !== 'date' && currentType !== 'picker' && currentType !== 'location' && currentType !== 'grid'" class="option-list">
				<view
					v-for="option in currentOptions"
					:key="option"
					class="option-row"
					:class="{ selected: selectedValue === option }"
					@click="selectOption(option)"
				>
					<text>{{ option }}</text>
				</view>
			</view>

			<view class="step-footer">
				<button class="previous-button" :disabled="step === 1" @click="previousStep">上一步</button>
				<button class="next-button" @click="nextStep">{{ step === totalSteps ? '完成' : '下一步' }}</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import locationJson from '@/data/location.json'
	import { updateOwnProfile } from '@/api/user.uts'
	import { getProfileCompletion } from '@/api/auth.uts'
	import { getContinuousMoxiangState } from '@/api/ai-moxiang.uts'

	const step = ref(0)
	const mode = ref('')
	const selections = ref([] as string[])
	// 资料保存成功后的收尾页：AI 画像是「选填入口」，不是注册链路的必经一步。
	// 不用新增页面，避免改动 pages.json（受保护文件）。
	const finished = ref(false)
	const aiEntryBusy = ref(false)
	// 画像能力是否可用：只由一次只读探测决定，读不到不弹错，只把入口降级。
	const aiEntryAvailable = ref(true)
	const aiEntryChecked = ref(false)

	const roles = [
		{ key: 'self', title: '自己找对象', subtitle: '我单身，我自己找对象', icon: '♡', tone: 'role-peach', iconTone: 'icon-peach' },
		{ key: 'parent', title: '我是父母', subtitle: '替子女登记信息找对象', icon: '♧', tone: 'role-blue', iconTone: 'icon-blue' },
		{ key: 'buddy', title: '找搭子', subtitle: '认识一群兴趣相投的人', icon: '♧', tone: 'role-lilac', iconTone: 'icon-lilac' },
		{ key: 'matchmaker', title: '当红娘', subtitle: '当红娘，我推荐单身', icon: '♧', tone: 'role-pink', iconTone: 'icon-pink' }
	]

	const numericOptions = (start: number, end: number, suffix: string): string[] => {
		const options = [] as string[]
		for (let value = start; value <= end; value++) options.push('' + value + suffix)
		return options
	}
	const heightOptions = numericOptions(140, 220, 'cm')
	const weightOptions = numericOptions(40, 120, 'kg')
	const educationOptions = ['高中及以下', '大专', '本科', '硕士', '博士']
	const heightTouched = ref(false)
	const weightTouched = ref(false)
	const bodyDefaults = (gender: string): any => gender === '女' ? { height: '160cm', weight: '50kg' } : { height: '170cm', weight: '60kg' }
	const applyBodyDefaults = (gender: string) => {
		const body = bodyDefaults(gender)
		if (!heightTouched.value) selections.value[4] = body.height
		if (!weightTouched.value) selections.value[5] = body.weight
	}
	const yearOptions = numericOptions(1966, 2008, '')
	const monthOptions = numericOptions(1, 12, '')
	const dayOptions = numericOptions(1, 31, '')
	const datePickerValue = ref([34, 0, 0] as number[])
	const pickerIndex = ref(0)
	const pickerViewValue = computed(() => [pickerIndex.value])
	const wheelBusy = ref(false)
	const onWheelStart = () => { wheelBusy.value = true }
	const onWheelEnd = () => { wheelBusy.value = false }
	const waitWheelSettled = async () => {
		let waited = 0
		while (wheelBusy.value && waited < 800) {
			await new Promise<void>((resolve) => { setTimeout(() => { resolve() }, 50) })
			waited += 50
		}
	}
	const questions = [
		{ title: '您的性别', type: 'picker', options: ['男', '女'] },
		{ title: '您的出生日期', type: 'date', options: [] as string[] },
		{ title: '您的老家是哪里', type: 'location', options: [] as string[] },
		{ title: '您的工作地区', type: 'location', options: [] as string[] },
		{ title: '您的身高是多少', type: 'picker', options: heightOptions },
		{ title: '您的体重是多少', type: 'picker', options: weightOptions },
		{ title: '您的最高学历', type: 'picker', options: educationOptions },
		{ title: '您从事何种工作', type: 'grid', options: ['不限', '私企员工', '央企/国企', '外企', '事业单位', '公务员', '教师', '医生', '护士', '互联网行业', '自由职业', '军人', '工人', '服务业', '金融', '律师', '求职中', '在校学生'] },
		{ title: '您的婚姻状况', type: 'picker', options: ['未婚', '离异', '丧偶'] },
		{ title: '您的收入状况', type: 'picker', options: ['小于10w', '10-20w', '30-50w', '50-100w', '100w以上', '保密'] }
	]

	const totalSteps = questions.length
	const currentTitle = computed(() => step.value > 0 ? questions[step.value - 1].title : '')
	const currentType = computed(() => step.value > 0 ? questions[step.value - 1].type : 'list')
	const currentOptions = computed((): string[] => step.value > 0 ? questions[step.value - 1].options : [])
	const selectedValue = computed(() => step.value > 0 && selections.value[step.value - 1] != null ? selections.value[step.value - 1] : '')
	const progressWidth = computed(() => Math.round(step.value / totalSteps * 100))
	const fallbackLocations = [
		{ name: '江苏省', cities: [{ name: '南京市', districts: ['玄武区', '秦淮区', '鼓楼区', '建邺区'] }, { name: '苏州市', districts: ['姑苏区', '虎丘区', '吴中区', '相城区'] }] },
		{ name: '浙江省', cities: [{ name: '杭州市', districts: ['上城区', '拱墅区', '西湖区', '滨江区'] }, { name: '宁波市', districts: ['海曙区', '江北区', '鄞州区'] }] },
		{ name: '上海市', cities: [{ name: '上海市', districts: ['黄浦区', '徐汇区', '长宁区', '浦东新区'] }] },
		{ name: '广东省', cities: [{ name: '广州市', districts: ['荔湾区', '越秀区', '天河区', '白云区'] }, { name: '深圳市', districts: ['罗湖区', '福田区', '南山区', '宝安区'] }] }
	] as any[]
	const normalizeLocations = (raw: any): any[] => {
		if (!Array.isArray(raw)) return []
		return (raw as any[]).map((province: any) => {
			const rawCities = province.city != null ? province.city : province.cities
			const cities = rawCities != null && Array.isArray(rawCities) ? rawCities as any[] : []
			return {
				name: '' + province.name,
				cities: cities.map((city: any) => {
					const rawAreas = city.area != null ? city.area : city.districts
					const areas = rawAreas != null && Array.isArray(rawAreas) ? rawAreas as any[] : []
					return {
						name: '' + city.name,
						code: city.code != null ? '' + city.code : '',
						districts: areas.map((area: any) => ({
							name: area != null && area.name != null ? '' + area.name : '' + area,
							code: area != null && area.code != null ? '' + area.code : ''
						}))
					}
				})
				,
				code: province.code != null ? '' + province.code : ''
			}
		})
	}
	const importedLocations = normalizeLocations(locationJson)
	const locationData = ref(importedLocations.length > 0 ? importedLocations : fallbackLocations)
	const locationIndexes = ref([0, 0, 0] as number[])
	const locationPickerKey = ref(0)
	const locationCodesByQuestion = ref([
		{ province: '', city: '', district: '' },
		{ province: '', city: '', district: '' }
	] as any[])
	const provinceOptions = computed((): string[] => locationData.value.map((item: any) => '' + item.name))
	const cityOptions = computed((): string[] => {
		const province = locationData.value[locationIndexes.value[0]]
		const cities = province != null && Array.isArray(province.cities) ? province.cities as any[] : []
		return cities.map((item: any) => '' + item.name)
	})
	const districtOptions = computed((): string[] => {
		const province = locationData.value[locationIndexes.value[0]]
		const cities = province != null && Array.isArray(province.cities) ? province.cities as any[] : []
		const city = cities[locationIndexes.value[1]]
		const districts = city != null && Array.isArray(city.districts) ? city.districts as any[] : []
		return districts.map((item: any) => item != null && item.name != null ? '' + item.name : '' + item)
	})
	const locationPickerValue = computed(() => [locationIndexes.value[0], locationIndexes.value[1], locationIndexes.value[2]])
	const locationLabel = computed(() => {
		if (provinceOptions.value.length == 0 || cityOptions.value.length == 0 || districtOptions.value.length == 0) return ''
		return provinceOptions.value[locationIndexes.value[0]] + ' ' + cityOptions.value[locationIndexes.value[1]] + ' ' + districtOptions.value[locationIndexes.value[2]]
	})
	const selectedLocationCodes = (indexes: number[]): any => {
		const province = locationData.value[indexes[0]]
		const cities = province != null && Array.isArray(province.cities) ? province.cities as any[] : []
		const city = cities[indexes[1]]
		const districts = city != null && Array.isArray(city.districts) ? city.districts as any[] : []
		const district = districts[indexes[2]]
		return {
			province: province != null && province.code != null ? '' + province.code : '',
			city: city != null && city.code != null ? '' + city.code : '',
			district: district != null && district.code != null ? '' + district.code : ''
		}
	}

	const chooseRole = (key: string) => {
		if (key === 'parent') {
			uni.setStorageSync('xsa_onboarding_mode', 'parent')
			uni.setStorageSync('xsa_onboarding_completed', true)
			uni.reLaunch({ url: '/pages/parent/parent' })
			return
		}
		if (key === 'matchmaker') {
			uni.showToast({ title: '该身份流程暂未开放', icon: 'none' })
			return
		}
		mode.value = key
		selections.value = questions.map((question: any) => {
			if (question.type === 'date') return '2000-01-01'
			if (question.type === 'picker' && question.options.length > 0) return question.options[0]
			return ''
		})
		selections.value[6] = '大专'
		// 性别默认值会取 options[0]="男"。注册页已经让用户选过性别，这里必须尊重草稿，
		// 否则"注册选女 → 编辑资料显示男"（服务端还会因为实名后不可改而彻底定死）。
		try {
			const pendingGender = Number(uni.getStorageSync('xsa_pending_gender'))
			const genderQuestion: any = questions[0]
			if (pendingGender == 1 || pendingGender == 2) {
				if (genderQuestion != null && genderQuestion.type === 'picker' && genderQuestion.options.length >= pendingGender) {
					selections.value[0] = genderQuestion.options[pendingGender - 1]
				}
			}
		} catch (e) {}
		heightTouched.value = false
		weightTouched.value = false
		applyBodyDefaults(selections.value[0])
		// 不再把默认下标 [0,0,0] 写进答案：它对应数据文件首条"北京市 市辖区 东城区"，
		// 导致用户没选地区也会被落库成北京东城（编辑页读出来"每次都是东城区"）。
		// 这里保持未选择，等用户主动打开选择器后再写入编码。
		step.value = 1
	}

	watch(step, () => {
		if (step.value <= 0 || currentType.value !== 'picker') return
		const options = currentOptions.value
		const selected = selectedValue.value
		const index = options.indexOf(selected)
		pickerIndex.value = index >= 0 ? index : 0
	})

	const selectOption = (option: string) => {
		if (step.value <= 0 || step.value > totalSteps) return
		while (selections.value.length < step.value) selections.value.push('')
		selections.value[step.value - 1] = option
		if (step.value === 1) applyBodyDefaults(option)
	}
	const selectPicker = (event: any) => {
		const index = Number(event.detail.value)
		const options = currentOptions.value
		if (index >= 0 && index < options.length) selectOption(options[index])
	}
	const selectDate = (event: any) => selectOption('' + event.detail.value)
	const onPickerViewChange = (event: any) => {
		const values = event.detail.value as any[]
		const index = Number(values[0])
		pickerIndex.value = index
		const options = currentOptions.value
		if (index < 0 || index >= options.length) return
		if (step.value === 5) heightTouched.value = true
		if (step.value === 6) weightTouched.value = true
		selectOption(options[index])
	}
	const onDatePickerChange = (event: any) => {
		const values = event.detail.value as any[]
		const yearIndex = Number(values[0])
		const monthIndex = Number(values[1])
		const dayIndex = Number(values[2])
		datePickerValue.value = [yearIndex, monthIndex, dayIndex]
		const year = yearOptions[yearIndex]
		const month = monthOptions[monthIndex].length == 1 ? '0' + monthOptions[monthIndex] : monthOptions[monthIndex]
		const day = dayOptions[dayIndex].length == 1 ? '0' + dayOptions[dayIndex] : dayOptions[dayIndex]
		selectDate({ detail: { value: year + '-' + month + '-' + day } })
	}
	const onLocationPickerChange = (event: any) => {
		const values = event.detail.value as any[]
		let provinceIndex = Number(values[0])
		let cityIndex = Number(values[1])
		let districtIndex = Number(values[2])
		if (provinceIndex < 0 || provinceIndex >= provinceOptions.value.length) provinceIndex = 0
		const provinceChanged = provinceIndex != locationIndexes.value[0]
		if (provinceChanged) {
			// 省份变了，市/区必须回到首项，否则会出现“安徽省 / 宁波市 / 上城区”这种跨省组合。
			cityIndex = 0
			districtIndex = 0
		}
		const province = locationData.value[provinceIndex]
		const cities = province != null && Array.isArray(province.cities) ? province.cities as any[] : []
		if (cityIndex < 0 || cityIndex >= cities.length) cityIndex = 0
		const city = cities[cityIndex]
		const districts = city != null && Array.isArray(city.districts) ? city.districts as any[] : []
		if (districtIndex < 0 || districtIndex >= districts.length) districtIndex = 0
		locationIndexes.value = [provinceIndex, cityIndex, districtIndex]
		if (provinceChanged) locationPickerKey.value = locationPickerKey.value + 1
		if (locationLabel.value != '') {
			selectOption(locationLabel.value)
			if (step.value == 3) locationCodesByQuestion.value[0] = selectedLocationCodes(locationIndexes.value)
			if (step.value == 4) locationCodesByQuestion.value[1] = selectedLocationCodes(locationIndexes.value)
		}
	}

	const previousStep = () => {
		if (step.value > 1) step.value = step.value - 1
	}

	const buildProfilePayload = (): any => {
		const hometown = locationCodesByQuestion.value[0]
		const residence = locationCodesByQuestion.value[1]
		// 注册页的性别只是本地选择并未上报，这里是新用户性别首次落库的唯一入口，必须携带；
		// 老账号服务端已存性别时会拒绝该字段，由 nextStep 的重试逻辑剔除后再提交。
		const gender = selections.value[0] == '男' ? 1 : selections.value[0] == '女' ? 2 : null
		const birthday = selections.value[1]
		const heightText = selections.value[4].replace('cm', '')
		const weightText = selections.value[5].replace('kg', '')
		const educationMap: any = { '高中及以下': 1, '大专': 2, '本科': 3, '硕士': 4, '博士': 5 }
		const marriageMap: any = { '未婚': 1, '离异': 2, '丧偶': 3 }
		const incomeMap: any = { '小于10w': 50000, '10-20w': 150000, '30-50w': 400000, '50-100w': 750000, '100w以上': 1000000 }
		const rawPayload: any = {
			gender,
			birthday,
			height: Number(heightText),
			weight: Number(weightText),
			education_level: educationMap[selections.value[6]],
			occupation: selections.value[7],
			is_married: marriageMap[selections.value[8]],
			income: incomeMap[selections.value[9]] != null ? incomeMap[selections.value[9]] : null,
			hometown_province_code: hometown.province,
			hometown_city_code: hometown.city,
			hometown_district_code: hometown.district,
			residence_province_code: residence.province,
			residence_city_code: residence.city,
			residence_district_code: residence.district
		}
		// 「保密」等空值字段不随 PATCH 提交，避免服务端对 null 校验报错。
		const payload: any = {}
		const rawKeys = Object.keys(rawPayload)
		for (let i = 0; i < rawKeys.length; i++) {
			if (rawPayload[rawKeys[i]] != null) payload[rawKeys[i]] = rawPayload[rawKeys[i]]
		}
		return payload
	}

	const ensureLocationSelection = (): boolean => {
		if (currentType.value !== 'location') return true
		if (selectedValue.value.length > 0) return true
		const label = locationLabel.value
		if (label == '') return false
		selections.value[step.value - 1] = label
		locationCodesByQuestion.value[step.value - 3] = selectedLocationCodes(locationIndexes.value)
		return true
	}

	const nextStep = async () => {
		const stepBeforeWait = step.value
		await waitWheelSettled()
		if (step.value != stepBeforeWait) return
		if (!ensureLocationSelection()) {
			uni.showToast({ title: '请选择一项后继续', icon: 'none' })
			return
		}
		if (selectedValue.value.length === 0) {
			uni.showToast({ title: '请选择一项后继续', icon: 'none' })
			return
		}
		if (step.value < totalSteps) {
			step.value = step.value + 1
			return
		}
		const payload = buildProfilePayload()
		let res = await updateOwnProfile(payload)
		if (!res.success) {
			// 防御：服务端对性别等已提交字段返回修改禁令时，剔除该字段重试一次。
			const firstMessage = res.message != null ? '' + res.message : ''
			if (firstMessage.indexOf('性别') >= 0 && payload.gender != null) {
				const retryPayload: any = {}
				const payloadKeys = Object.keys(payload)
				for (let i = 0; i < payloadKeys.length; i++) {
					if (payloadKeys[i] != 'gender') retryPayload[payloadKeys[i]] = payload[payloadKeys[i]]
				}
				res = await updateOwnProfile(retryPayload)
			}
		}
		if (!res.success) {
			uni.showToast({ title: res.message != null ? '' + res.message : '资料保存失败，请重试', icon: 'none' })
			return
		}
		const completion = await getProfileCompletion()
		if (!completion.success || completion.data == null) {
			uni.showToast({ title: '资料已提交，但服务器校验失败，请重试', icon: 'none' })
			return
		}
		uni.setStorageSync('xsa_onboarding_completed', true)
		uni.setStorageSync('xsa_onboarding_mode', mode.value)
		uni.setStorageSync('xsa_skip_welcome_once', true)
		// 不再直接跳首页：先给一个 AI 画像入口，由用户决定现在生成还是稍后再说。
		finished.value = true
		probeAiPortraitEntry()
	}

	/**
	 * 进收尾页时做一次只读探测，决定 AI 画像入口是否可用。
	 * 服务端明确关闭能力（AI_FEATURE_DISABLED）才降级入口；网络抖动保留入口，
	 * 避免把「一次请求失败」误报成「功能没有」。
	 */
	const probeAiPortraitEntry = () => {
		if (aiEntryChecked.value) return
		aiEntryChecked.value = true
		getContinuousMoxiangState().then(() => {
			aiEntryAvailable.value = true
		}).catch((error: any) => {
			const businessCode = error != null && error.businessCode != null ? '' + error.businessCode : ''
			aiEntryAvailable.value = businessCode != 'AI_FEATURE_DISABLED'
		})
	}

	const goHomeAfterOnboarding = () => {
		uni.setStorageSync('xsa_skip_welcome_once', true)
		uni.switchTab({ url: '/pages/index/index' })
	}

	const openAiPortrait = () => {
		if (aiEntryBusy.value) return
		if (!aiEntryAvailable.value) {
			uni.showToast({ title: '知遇还在准备中，你可以先逛逛', icon: 'none' })
			return
		}
		aiEntryBusy.value = true
		// redirectTo：返回键不能退回已经填完的资料页。
		uni.redirectTo({
			url: '/pagesSub/profileExtra/my-portrait-master',
			fail: () => {
				aiEntryBusy.value = false
				uni.showToast({ title: '页面打开失败，可以先逛逛', icon: 'none' })
			}
		})
	}

	const handleBack = async () => {
		const stepBeforeWait = step.value
		await waitWheelSettled()
		if (step.value != stepBeforeWait) return
		if (step.value > 0) {
			step.value = step.value - 1
		} else {
			uni.navigateBack()
		}
	}
</script>

<style scoped>
	.onboarding-page {
