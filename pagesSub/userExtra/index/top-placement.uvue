<template>
	<view class="top-page">
		<scroll-view scroll-y class="top-scroll" :show-scrollbar="false">
			<view v-if="loading" class="state-panel"><text>正在读取置顶状态...</text></view>

			<view v-else-if="paymentSuccess && successOrder != null" class="success-panel">
				<view class="success-mark"><text>✓</text></view>
				<text class="success-title">置顶已开启</text>
				<text class="success-copy">支付已确认，你的资料将进入广场置顶推荐。</text>
				<view class="remaining-card"><text class="remaining-label">剩余置顶</text><text class="remaining-days">{{ successOrder.remainingDays }} 天</text><text class="remaining-copy">有效期至 {{ formatDate(successOrder.expiresAt) }}</text></view>
				<view class="success-order"><text>套餐 · {{ successOrder.planName }}</text><text>¥{{ successOrder.amount }}</text></view>
				<view class="success-order"><text>订单号</text><text>{{ successOrder.orderNo }}</text></view>
				<view class="success-action" @tap="goBack"><text>返回广场</text></view>
			</view>

			<view v-else class="purchase-content">
				<!-- 1. 顶部渐变轻量 Banner -->
				<view class="hero-banner">
					<view class="status-bar-spacer"></view>
					<view class="hero-nav">
						<view class="nav-back" @tap="goBack"><text class="nav-back-icon">‹</text></view>
						<view class="nav-placeholder"></view>
					</view>
					<text class="hero-title">置顶尊享特权</text>
					<text class="hero-copy">优先曝光 · 提升脱单成功率</text>
				</view>

				<!-- 2. 状态提示卡片（奶白风，叠压 Banner） -->
				<view class="active-status">
					<text class="active-title">{{ activeStatus.active ? '您当前正在置顶' : '您当前还未置顶' }}</text>
					<text class="active-copy">{{ activeStatus.active ? '继续购买会在现有有效期基础上延长' : '置顶曝光，让更多优质用户看见你' }}</text>
				</view>

				<!-- 3. 置顶推荐模块（无头像卡片，纯留白） -->
				<view class="recommend-module">
					<view class="module-head">
						<text class="module-title">置顶推荐</text>
						<view class="recommend-btn" @tap="openPayment"><text>立即置顶</text></view>
					</view>
				</view>

				<!-- 4. 置顶套餐选择区 -->
				<view class="plans-section">
					<text class="section-title">选择置顶套餐</text>
					<view class="plans-wrap">
						<view v-for="(plan, index) in plans" :key="plan.id" class="plan-card" :class="{ selected: selectedPlanIndex === index }" @tap="selectPlan(index)">
							<view v-if="plan.tag != '' || plan.recommended" class="plan-tag">{{ plan.tag != '' ? plan.tag : '推荐' }}</view>
							<text class="plan-name">{{ plan.name }}</text>
							<text class="plan-duration">有效期 {{ plan.days }} 天</text>
							<!-- 单价按需求后补，暂不写死；合计金额见底部支付栏 -->
						</view>
					</view>
				</view>

				<!-- 5. 置顶专属权益（潮流图标风） -->
				<view class="benefits-section">
					<text class="benefit-heading">置顶专属权益</text>
					<view class="benefit-icons">
						<view v-for="item in benefits" :key="item.title" class="benefit-item">
							<view class="benefit-icon"><text>{{ item.icon }}</text></view>
							<text class="benefit-title">{{ item.title }}</text>
							<text class="benefit-desc">{{ item.desc }}</text>
						</view>
					</view>
				</view>

				<!-- 6. 底部温馨提示（轻量悬浮式） -->
				<view class="notice-card">
					<text class="notice-copy">置顶服务为虚拟商品，购买成功后不支持退款。置顶期间系统将优先向匹配用户展示你的资料。</text>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view v-if="!loading && !paymentSuccess && plans.length > 0" class="footer-safe">
			<view class="total-row"><text>合计：</text><text class="total-price">¥{{ selectedPlan.price }}</text></view>
			<view class="pay-button" :class="{ disabled: paying }" @tap="openPayment"><text>{{ paying ? '支付确认中…' : '确认支付' }}</text></view>
		</view>
		<XsaPaymentSheet :visible="paymentVisible" :amount="selectedPlan.price" :loading="paying" @close="closePayment" @confirm="confirmPayment" />
	</view>
</template>

<script setup lang="uts">
import { getTopPlacementStatus, getTopPlacementPackages, payTopPlacement, TopPlacementPlan, TopPlacementOrder } from '@/api/top-placement.uts'
import { getDiscoveryPlaza } from '@/api'
import { resolveMediaUrl } from '@/api/config.uts'
import XsaPaymentSheet from '@/components/XsaPaymentSheet.uvue'

const plans = ref<TopPlacementPlan[]>([])
const benefits = [
	{ icon: '↑', title: '优先展示', desc: '首页靠前' },
	{ icon: '◎', title: '精准触达', desc: '同城优质' },
	{ icon: '♡', title: '更多匹配', desc: '喜欢翻倍' }
]
const selectedPlanIndex = ref(0)
const activeStatus = ref<any>({ active: false, remainingDays: 0, expiresAt: 0 })
const loading = ref(true)
const paymentVisible = ref(false)
const paying = ref(false)
const paymentSuccess = ref(false)
const successOrder = ref<TopPlacementOrder | null>(null)
const recommendImages = ref<string[]>([])
const selectedPlan = computed(() => plans.value.length > selectedPlanIndex.value ? plans.value[selectedPlanIndex.value] : { id: '', name: '', days: 0, price: 0, tag: '', recommended: false } as TopPlacementPlan)

const loadStatus = async () => {
	loading.value = true
	try {
		const [statusResult, packageResult] = await Promise.all([getTopPlacementStatus(), getTopPlacementPackages()])
		activeStatus.value = statusResult.success && statusResult.data != null ? statusResult.data : { active: false, remainingDays: 0, expiresAt: 0 }
		if (packageResult.success && packageResult.data != null) {
			plans.value = packageResult.data as TopPlacementPlan[]
			if (selectedPlanIndex.value >= plans.value.length) selectedPlanIndex.value = 0
		}
		const plazaResult = await getDiscoveryPlaza({ page: 1, page_size: 4 })
		if (plazaResult.success && plazaResult.data != null) {
			const items = (plazaResult.data as any).items as any[]
			const images: string[] = []
			for (let i = 0; i < items.length; i++) {
				const image = resolveMediaUrl(items[i] != null ? items[i].avatar : '')
				if (image != '') images.push(image)
				if (images.length >= 2) break
			}
			recommendImages.value = images
		}
	} catch (e) {
		activeStatus.value = { active: false, remainingDays: 0, expiresAt: 0 }
	} finally { loading.value = false }
}
const selectPlan = (index: number) => { if (!paying.value) selectedPlanIndex.value = index }
const openPayment = () => { if (!paying.value && selectedPlan.value.id != '') paymentVisible.value = true }
const closePayment = () => { if (!paying.value) paymentVisible.value = false }
const confirmPayment = async () => {
	if (paying.value) return
	try {
		paying.value = true
		const result = await payTopPlacement(selectedPlan.value)
		if (!result.success || result.data == null) { uni.showToast({ title: result.message, icon: 'none' }); return }
		successOrder.value = result.data
		paymentVisible.value = false
		paymentSuccess.value = true
	} catch (e) { uni.showToast({ title: '付款确认失败，请稍后重试', icon: 'none' }) } finally { paying.value = false }
}
const formatDate = (timestamp: number): string => {
	const date = new Date(timestamp)
	return String(date.getFullYear()) + '年' + String(date.getMonth() + 1) + '月' + String(date.getDate()) + '日'
}
const goBack = () => { uni.navigateBack({}) }
onMounted(() => { loadStatus() })
</script>

<style scoped>
.top-page { min-height: 100vh; background: #FFFFFF; color: #111111; }
.top-scroll { height: 100vh; }
.purchase-content { display: flex; flex-direction: column; padding-bottom: 150px; }

/* 1. Banner */
.hero-banner { position: relative; display: flex; flex-direction: column; align-items: center; padding: 0 20px 60px; background: linear-gradient(152deg, #6BA88A 0%, #8EC3AD 52%, #AFD6C4 100%); border-radius: 0 0 30px 30px; overflow: hidden; }
.status-bar-spacer { height: 44px; }
.hero-nav { width: 100%; height: 44px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.nav-back { width: 40px; height: 40px; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.nav-back-icon { font-family: Arial, sans-serif; font-size: 34px; font-weight: 300; line-height: 34px; color: #FFFFFF; transform: translateY(-1px); }
.nav-placeholder { width: 40px; }
.hero-title { color: #FFFFFF; font-size: 20px; font-weight: 600; letter-spacing: 1px; }
.hero-copy { margin-top: 10px; color: rgba(255,255,255,.88); font-size: 12px; letter-spacing: 1.2px; }

/* 2. 状态提示卡片 */
.active-status { position: relative; z-index: 2; margin: -38px 16px 0; padding: 26px 22px; background: #FFFFFF; border: 1px solid #F0F1F0; border-radius: 26px; box-shadow: 0 6px 18px rgba(28,40,34,.05); display: flex; flex-direction: column; align-items: center; text-align: center; }
.active-title { color: #111111; font-size: 15px; font-weight: 600; letter-spacing: .5px; }
.active-copy { margin-top: 9px; color: #6E6E6E; font-size: 12px; letter-spacing: .3px; }

/* 3. 置顶推荐模块 */
.recommend-module { margin: 16px 16px 0; background: #FAFBFA; border: 1px solid #F3F4F3; border-radius: 26px; overflow: hidden; }
.module-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 18px 18px 22px; }
.module-title { color: #111111; font-size: 14px; font-weight: 600; letter-spacing: .5px; }
.recommend-btn { padding: 7px 16px; border-radius: 999px; background: #4BA883; color: #FFFFFF; font-size: 12px; letter-spacing: .5px; }

/* 4. 套餐选择区 */
.plans-section { margin: 16px 16px 0; background: #FAFBFA; border: 1px solid #F3F4F3; border-radius: 26px; overflow: hidden; }
.section-title { display: block; padding: 18px 18px 14px; text-align: center; color: #111111; font-size: 14px; font-weight: 600; letter-spacing: .5px; }
.plans-wrap { display: flex; flex-direction: column; }
.plan-card { position: relative; width: 100%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 19px 18px; border-top: 1px solid #F1F2F1; }
.plan-card.selected { background: #FFFFFF; }
.plan-card.selected .plan-name { color: #4BA883; }
.plan-tag { position: absolute; top: 17px; right: 16px; padding: 3px 9px; border-radius: 999px; background: #E8F3ED; color: #4A7E66; font-size: 11px; }
.plan-name { color: #1A1A1A; font-size: 13px; letter-spacing: .4px; }
.plan-duration { margin-top: 4px; color: #7A7A7A; font-size: 11px; }

/* 5. 专属权益 */
.benefits-section { margin: 16px 16px 0; background: #E8F1EC; border-radius: 26px; padding: 20px 16px 22px; }
.benefit-heading { display: block; text-align: center; color: #1A2A22; font-size: 13px; font-weight: 600; letter-spacing: .8px; }
.benefit-icons { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; gap: 8px; margin-top: 18px; }
.benefit-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 6px; }
.benefit-icon { width: 40px; height: 40px; border-radius: 14px; display: flex; align-items: center; justify-content: center; background: #FFFFFF; color: #5A8F75; font-size: 20px; }
.benefit-title { color: #2A3A32; font-size: 12px; margin-top: 4px; }
.benefit-desc { color: #7A8A82; font-size: 11px; text-align: center; }

/* 6. 温馨提示 */
.notice-card { margin: 6px 24px 0; padding: 16px 0; text-align: center; }
.notice-copy { color: #7A7A7A; font-size: 11px; line-height: 1.9; letter-spacing: .2px; }

.bottom-space { height: 12px; }

/* 底部支付栏 */
.footer-safe { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; display: flex; flex-direction: row; align-items: center; gap: 24px; padding: 14px 16px calc(env(safe-area-inset-bottom) + 14px); background: rgba(255,255,255,.98); border-top: 1px solid #F0F1F0; }
.total-row { display: flex; flex-direction: row; align-items: baseline; gap: 3px; color: #111111; font-size: 20px; font-weight: 600; white-space: nowrap; }
.total-price { color: #4BA883; font-size: 26px; font-weight: 600; }
.pay-button { flex: 1; height: 50px; border-radius: 999px; display: flex; align-items: center; justify-content: center; background: #4BA883; color: #FFFFFF; font-size: 16px; font-weight: 600; }
.pay-button.disabled { opacity: .56; }

/* 加载 / 成功态（保留原逻辑样式） */
.state-panel { margin: 32px 16px; padding: 36px 20px; border-radius: 20px; background: #F8F9F6; border: 1px solid #DCE8D8; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; color: #3A4552; font-size: 14px; }
.success-panel { margin: 32px 16px; padding: 36px 20px; border-radius: 20px; background: #F8F9F6; border: 1px solid #DCE8D8; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; color: #3A4552; font-size: 14px; }
.success-mark { width: 76px; height: 76px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #E2EBE0; border: 2px solid #A8C0A5; color: #4A6B55; font-size: 38px; font-weight: 700; }
.success-title { color: #111111; font-family: 'Playfair Display'; font-size: 28px; font-weight: 700; }
.success-copy { color: #3A4552; font-size: 13px; line-height: 1.6; }
.remaining-card { width: 100%; padding: 18px 12px; border-radius: 14px; background: linear-gradient(135deg, #E8EDE4, #F0EBE0); display: flex; flex-direction: column; gap: 4px; }
.remaining-label { color: #4A6B55; font-size: 12px; }
.remaining-days { color: #111111; font-size: 30px; font-weight: 700; }
.remaining-copy { color: #3A4552; font-size: 11px; }
.success-order { width: 100%; padding: 12px 0; border-top: 1px solid #DCE8D8; display: flex; justify-content: space-between; gap: 12px; color: #3A4552; font-size: 12px; text-align: left; }
.success-order text:last-child { color: #111111; }
.success-action { width: 100%; height: 50px; border-radius: 20px; background: linear-gradient(90deg, #E6EBD8, #E8CFA5); color: #111111; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 700; }
</style>
