.section-title { display: block; font-size: 32rpx; font-weight: 700; color: var(--ink); }
.section-note, .footer-tip { display: block; margin-top: 8rpx; font-size: 23rpx; color: var(--muted); line-height: 1.5; }
.progress-text { font-size: 25rpx; font-weight: 600; color: var(--accent2); white-space: nowrap; }
.account-label { padding-top: 6rpx; font-size: 22rpx; font-weight: 700; color: var(--muted); }
.certification-label { padding-top: 22rpx; border-top: 1px solid var(--line); }
.cert-item { display: flex; flex-direction: row; align-items: center; gap: 20rpx; padding: 10rpx 0; }
.cert-icon-wrap { width: 76rpx; height: 76rpx; border-radius: 38rpx; background-color: var(--warm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.cert-icon-wrap.cert-done { background-color: var(--sage-soft); }
.cert-icon-text { font-size: 21rpx; font-weight: 700; color: var(--ink2); }
.cert-text-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.cert-label { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.cert-desc { font-size: 22rpx; color: var(--muted); line-height: 1.45; }
.status { font-size: 24rpx; font-weight: 600; white-space: nowrap; }
.passed, .uploaded { color: var(--sage); }
.reviewing { color: var(--accent2); }
.action-pill, .code-button, .text-action { padding: 12rpx 22rpx; border-radius: 16rpx; background-color: var(--warm); color: var(--accent2); font-size: 24rpx; flex-shrink: 0; }
.detail-hero { text-align: center; padding: 20rpx 0 68rpx; }
.hero-title { display: block; font-family: var(--serif); font-size: 48rpx; font-weight: 700; color: var(--ink); }
.hero-underline { width: 76rpx; height: 12rpx; margin: -14rpx auto 0; background-color: var(--accent-bg); }
.hero-subtitle { display: block; margin-top: 12rpx; font-size: 27rpx; color: var(--muted); }
.form-card { gap: 22rpx; }
.field-input { height: 88rpx; padding: 0 24rpx; border-radius: 18rpx; background-color: var(--surface); border: 1px solid var(--line); color: var(--ink); font-size: 27rpx; box-sizing: border-box; }
.code-row { display: flex; flex-direction: row; gap: 16rpx; align-items: center; }
.code-input { flex: 1; }
.code-button { min-width: 168rpx; text-align: center; }
.disabled { opacity: 0.5; }
.primary-button, .secondary-button { min-height: 92rpx; border-radius: 46rpx; background-color: var(--accent); color: var(--text-invert); display: flex; align-items: center; justify-content: center; font-size: 29rpx; font-weight: 700; }
.secondary-button { margin-top: 24rpx; background-color: var(--surface); color: var(--accent2); border: 1px solid var(--line); }
.review-tip, .reject-tip { padding: 22rpx; border-radius: 16rpx; background-color: var(--warm); color: var(--accent2); font-size: 25rpx; line-height: 1.5; }
.reject-tip { display: flex; flex-direction: column; gap: 4rpx; margin-bottom: 18rpx; color: var(--review-danger); }
.reject-title { font-size: 27rpx; font-weight: 700; }
.education-form { background-color: var(--surface); border-radius: 24rpx; padding: 8rpx 30rpx 32rpx; box-shadow: var(--shadow-sm); }
/* UniApp view flex defaults to a column; certification fields must be explicit rows. */
.education-picker { display: block; width: 100%; }
.line-field { width: 100%; min-height: 104rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1px solid var(--line); box-sizing: border-box; }
.line-label { flex-shrink: 0; font-size: 28rpx; font-weight: 700; color: var(--ink); }
.line-value { display: flex; flex-direction: row; align-items: center; gap: 12rpx; color: var(--ink2); font-size: 27rpx; }
.line-input { flex: 1; min-width: 0; height: 104rpx; text-align: right; font-size: 27rpx; color: var(--ink2); }
.picker-arrow { color: var(--muted); font-size: 36rpx; }
.placeholder-text { color: var(--muted); }
.upload-section { padding: 30rpx 0; border-bottom: 1px solid var(--line); }
.upload-title { display: block; margin-bottom: 22rpx; font-size: 28rpx; font-weight: 700; color: var(--ink); }
.upload-tile, .upload-preview { width: 164rpx; height: 164rpx; border-radius: 16rpx; background-color: var(--paper); }
.upload-tile { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: var(--muted); font-size: 25rpx; }
.upload-plus { font-size: 58rpx; line-height: 1; color: var(--muted); }
.upload-preview-wrap { display: flex; align-items: flex-end; gap: 20rpx; }
.remove-image, .clear-signature { color: var(--accent2); font-size: 24rpx; padding: 12rpx 0; }
.privacy-note { display: flex; flex-direction: column; gap: 6rpx; padding-top: 28rpx; color: var(--muted); font-size: 23rpx; line-height: 1.65; }
.privacy-note.compact { margin-top: 30rpx; border-top: 1px solid var(--line); }
.privacy-title { font-size: 25rpx; font-weight: 700; color: var(--ink2); }
.bottom-action { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background-color: var(--paper); border-top: 1px solid var(--line); }
.status-panel, .status-page { margin: 0 -32rpx; }
.status-band { display: flex; flex-direction: column; gap: 4rpx; padding: 34rpx 32rpx 48rpx; background-color: var(--accent-bg); }
.status-band-title { font-size: 36rpx; font-weight: 700; color: var(--ink); }
.status-band-copy { font-size: 26rpx; color: var(--ink2); }
.document-card { margin: -20rpx 32rpx 0; padding: 36rpx; border-radius: 28rpx; background-color: var(--surface); box-shadow: var(--shadow-md); }
.document-preview { width: 100%; height: 320rpx; border-radius: 18rpx; background-color: var(--warm); }
.document-placeholder, .document-symbol { height: 260rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background-color: var(--paper); color: var(--accent2); font-size: 30rpx; font-weight: 700; }
.document-meta { display: block; margin-top: 20rpx; text-align: center; color: var(--ink2); font-size: 25rpx; }
.privacy-copy { display: block; margin-top: 22rpx; padding-top: 22rpx; border-top: 1px solid var(--line); color: var(--muted); font-size: 23rpx; line-height: 1.5; }
.pledge-document-card .document-symbol { margin-bottom: 30rpx; }
.pledge-form, .pledge-view { padding-bottom: 20rpx; }
.pledge-copy-card { padding: 30rpx; border-radius: 22rpx; background-color: var(--warm); color: var(--ink2); font-size: 27rpx; line-height: 1.8; }
.signature-heading { margin-top: 30rpx; display: flex; flex-direction: column; gap: 4rpx; }
.signature-title { font-family: var(--serif); font-size: 31rpx; font-weight: 700; color: var(--ink); }
.signature-note { font-size: 23rpx; color: var(--muted); }
.signature-canvas { width: 100%; height: 280rpx; margin-top: 18rpx; border-radius: 22rpx; background-color: var(--surface); border: 1px solid var(--line); }
.clear-signature { text-align: right; }
.signature-readonly { height: 300rpx; margin-top: 24rpx; border-radius: 22rpx; background-color: var(--surface); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--muted); }
.signature-readonly image { width: 100%; height: 100%; }
.return-link { padding: 18rpx; text-align: center; color: var(--accent2); font-size: 27rpx; }
.footer-tip { text-align: center; padding: 0 12rpx 48rpx; }
</style>
