<template>
	<view class="page">
		<view v-if="loadError != ''" class="notice-card error-card">
			<view class="notice-copy">
				<text class="notice-title">认证状态加载失败</text>
				<text class="notice-text">{{ loadError }}</text>
			</view>
			<view class="text-action" @tap="refreshStatus"><text>重试</text></view>
		</view>

		<view class="section-card">
			<view class="card-header">
				<view>
					<text class="section-title">认证中心</text>
					<text class="section-note">各项可独立完成，学历和头像无需先绑定手机号或实名认证</text>
				</view>
				<text class="progress-text">已完成 {{ completed }}/4</text>
			</view>

			<view class="cert-item">
				<view class="cert-icon-wrap" :class="{ 'cert-done': phoneVerified }"><text class="cert-icon-text">手机</text></view>
				<view class="cert-text-wrap">
					<text class="cert-label">手机号绑定</text>
					<text class="cert-desc">{{ phoneVerified ? phoneMasked : '用于接收审核和服务通知' }}</text>
				</view>
				<text v-if="phoneVerified" class="status passed">已绑定</text>
				<view v-else class="action-pill" @tap="openStep('phone')"><text>去绑定</text></view>
			</view>

			<view class="cert-item">
				<view class="cert-icon-wrap" :class="{ 'cert-done': realnameStatus == 2 }"><text class="cert-icon-text">实名</text></view>
				<view class="cert-text-wrap">
					<text class="cert-label">实名认证</text>
					<text class="cert-desc">{{ realnameDescription }}</text>
				</view>
				<text v-if="realnameStatus == 2" class="status passed">已通过</text>
				<text v-else-if="realnameStatus == 1 || realnameStatus == 4" class="status reviewing">审核中</text>
				<text v-else-if="realnameStatus == 3 || realnameStatus == 5" class="status rejected">未通过</text>
				<view v-else class="action-pill" @tap="openStep('realname')"><text>去认证</text></view>
			</view>

			<view class="cert-item">
				<view class="cert-icon-wrap" :class="{ 'cert-done': educationStatus == 2 }"><text class="cert-icon-text">学历</text></view>
				<view class="cert-text-wrap">
					<text class="cert-label">学历认证</text>
					<text class="cert-desc">{{ educationDescription }}</text>
				</view>
				<text v-if="educationStatus == 2" class="status passed">已认证</text>
				<text v-else-if="educationStatus == 1" class="status reviewing">审核中</text>
				<view v-else class="action-pill" @tap="openStep('education')"><text>{{ educationStatus == 3 ? '重新提交' : '去认证' }}</text></view>
			</view>

			<view class="cert-item">
				<view class="cert-icon-wrap" :class="{ 'cert-done': avatarUploaded }"><text class="cert-icon-text">头像</text></view>
				<view class="cert-text-wrap">
					<text class="cert-label">头像认证</text>
					<text class="cert-desc">{{ avatarUploaded ? '本人照片已上传，认证结果以平台审核为准' : '上传真实本人照片，无需前置认证' }}</text>
				</view>
				<text v-if="avatarUploaded" class="status uploaded">已上传</text>
				<view v-else class="action-pill" :class="{ disabled: avatarUploading }" @tap="openStep('avatar')"><text>{{ avatarUploading ? '上传中…' : '上传图片' }}</text></view>
			</view>
		</view>

		<view v-if="activeStep == 'phone' && !phoneVerified" class="section-card form-card">
			<text class="section-title">绑定手机号</text>
			<text class="section-note">验证码仅用于绑定当前微信账号</text>
			<input class="field-input" type="number" maxlength="11" placeholder="请输入11位手机号" :value="phone" @input="onPhoneInput" />
			<view class="code-row">
				<input class="field-input code-input" type="number" maxlength="6" placeholder="请输入验证码" :value="smsCode" @input="onCodeInput" />
				<view class="code-button" :class="{ disabled: codeSending || countdown > 0 }" @tap="sendBindCode"><text>{{ codeButtonText }}</text></view>
			</view>
			<view class="primary-button" :class="{ disabled: binding }" @tap="confirmBindPhone"><text>{{ binding ? '绑定中…' : '确认绑定' }}</text></view>
		</view>

		<view v-if="activeStep == 'realname' && realnameStatus != 2" class="section-card form-card">
			<text class="section-title">实名认证</text>
			<text v-if="realnameStatus == 1 || realnameStatus == 4" class="review-tip">资料已提交，正在审核。</text>
			<template v-else>
				<text class="section-note">请填写本人真实姓名和有效身份证号</text>
				<input class="field-input" maxlength="64" placeholder="真实姓名" :value="realName" @input="onRealNameInput" />
				<input class="field-input" maxlength="18" placeholder="18位身份证号" :value="idCard" @input="onIdCardInput" />
				<view class="primary-button" :class="{ disabled: realnameSubmitting }" @tap="confirmRealname"><text>{{ realnameSubmitting ? '提交中…' : '提交实名认证' }}</text></view>
			</template>
		</view>

		<view v-if="activeStep == 'education' && educationStatus != 2 && educationStatus != 1" class="section-card form-card">
			<text class="section-title">学历认证</text>
			<text class="section-note">选择本人最高学历后提交，由平台人工审核</text>
			<picker mode="selector" :range="educationOptions" :value="educationIndex" @change="onEducationChange">
				<view class="picker-field"><text :class="{ 'placeholder-text': !educationSelected }">{{ educationSelected ? educationOptions[educationIndex] : '请选择最高学历' }}</text><text class="picker-arrow">›</text></view>
			</picker>
			<text v-if="educationStatus == 3 && educationFailReason != ''" class="field-error">未通过原因：{{ educationFailReason }}</text>
			<view class="primary-button" :class="{ disabled: educationSubmitting }" @tap="confirmEducation"><text>{{ educationSubmitting ? '提交中…' : '提交学历认证' }}</text></view>
		</view>

		<view v-if="returnTo != ''" class="return-link" @tap="backToApplication"><text>返回申请页面</text></view>
		<text class="footer-tip">各项认证状态以平台审核结果为准；上传资料不等于认证通过。</text>
	</view>
</template>

<script setup lang="uts">
import { bindPhone, getMeProfile, getUserCertifications, sendSms, submitEducationCertification, submitRealname, uploadUserProfileMedia } from '@/api'

const phoneVerified = ref(false)
const phoneMasked = ref('')
const realnameStatus = ref(0)
const educationStatus = ref(0)
const educationFailReason = ref('')
const avatarUploaded = ref(false)
const activeStep = ref('')
const returnTo = ref('')
const loadError = ref('')
const phone = ref('')
const smsCode = ref('')
const realName = ref('')
const idCard = ref('')
const educationOptions: string[] = ['小学', '初中', '高中', '中专', '大专', '本科', '硕士', '博士']
const educationIndex = ref(0)
const educationSelected = ref(false)
const binding = ref(false)
const realnameSubmitting = ref(false)
const educationSubmitting = ref(false)
const avatarUploading = ref(false)
const codeSending = ref(false)
const countdown = ref(0)

const completed = computed(() => (phoneVerified.value ? 1 : 0) + (realnameStatus.value == 2 ? 1 : 0) + (educationStatus.value == 2 ? 1 : 0) + (avatarUploaded.value ? 1 : 0))
const codeButtonText = computed(() => countdown.value > 0 ? countdown.value + '秒后重试' : (codeSending.value ? '发送中…' : '获取验证码'))
const realnameDescription = computed(() => {
	if (realnameStatus.value == 2) return '已通过平台实名认证'
	if (realnameStatus.value == 1 || realnameStatus.value == 4) return '资料正在审核，请耐心等待'
	if (realnameStatus.value == 3) return '认证未通过，请重新提交'
	if (realnameStatus.value == 5) return '实名认证已撤销，请重新提交'
	return '填写本人真实身份信息后提交审核'
})
const educationDescription = computed(() => {
	if (educationStatus.value == 2) return '学历信息已通过平台人工审核'
	if (educationStatus.value == 1) return '学历信息正在等待平台审核'
	if (educationStatus.value == 3) return educationFailReason.value != '' ? educationFailReason.value : '审核未通过，可重新提交'
	return '选择学历并提交平台人工审核'
})

const messageOf = (res: any, fallback: string): string => res != null && res.message != null && String(res.message) != '' ? String(res.message) : fallback

const refreshStatus = async () => {
	loadError.value = ''
	let loaded = false
	const profileRes = await getMeProfile()
	if (profileRes.success && profileRes.data != null) {
		loaded = true
		phoneVerified.value = profileRes.data.phone_verified == true
		phoneMasked.value = profileRes.data.phone_masked != null ? String(profileRes.data.phone_masked) : ''
		realnameStatus.value = profileRes.data.realname_status != null ? Number(profileRes.data.realname_status) : (profileRes.data.realNameStatus == 'passed' ? 2 : (profileRes.data.realNameStatus == 'reviewing' ? 1 : 0))
		avatarUploaded.value = profileRes.data.avatar != null && String(profileRes.data.avatar).trim() != ''
	}
	const certRes = await getUserCertifications()
	if (certRes.success && certRes.data != null && certRes.data.education != null) {
		loaded = true
		educationStatus.value = certRes.data.education.status != null ? Number(certRes.data.education.status) : 0
		educationFailReason.value = certRes.data.education.fail_reason != null ? String(certRes.data.education.fail_reason) : ''
	}
	if (!loaded) loadError.value = messageOf(profileRes, messageOf(certRes, '请检查网络后重试'))
}

const chooseAvatarForCertification = () => {
	if (avatarUploading.value) return
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: async (res: any) => {
			const filePath = res != null && res.tempFilePaths != null && res.tempFilePaths.length > 0 ? String(res.tempFilePaths[0]) : ''
			if (filePath == '') return
			avatarUploading.value = true
			try {
				const uploadRes = await uploadUserProfileMedia(filePath, 'avatar')
				if (!uploadRes.success) {
					uni.showToast({ title: messageOf(uploadRes, '头像上传失败'), icon: 'none' })
					return
				}
				avatarUploaded.value = true
				uni.showToast({ title: '头像已上传', icon: 'success' })
			} finally { avatarUploading.value = false }
		}
	})
}

const openStep = (step: string) => {
	if (step == 'avatar') {
		chooseAvatarForCertification()
		return
	}
	activeStep.value = step
}
const onPhoneInput = (e: any) => { phone.value = e.detail.value }
const onCodeInput = (e: any) => { smsCode.value = e.detail.value }
const onRealNameInput = (e: any) => { realName.value = e.detail.value }
const onIdCardInput = (e: any) => { idCard.value = e.detail.value }
const onEducationChange = (e: any) => {
	educationIndex.value = Number(e.detail.value)
	educationSelected.value = true
}

const startCountdown = () => {
	countdown.value = 60
	const timer = setInterval(() => {
		countdown.value -= 1
		if (countdown.value <= 0) clearInterval(timer)
	}, 1000)
}

const sendBindCode = async () => {
	if (codeSending.value || countdown.value > 0) return
	if (!/^1[3-9]\d{9}$/.test(phone.value.trim())) {
		uni.showToast({ title: '请输入正确的11位手机号', icon: 'none' })
		return
	}
	codeSending.value = true
	try {
		const res = await sendSms(phone.value.trim(), 'bind_phone')
		if (!res.success) {
			uni.showToast({ title: messageOf(res, '验证码发送失败'), icon: 'none' })
			return
		}
		startCountdown()
		uni.showToast({ title: '验证码已发送', icon: 'success' })
	} finally { codeSending.value = false }
}

const confirmBindPhone = async () => {
	if (binding.value) return
	if (!/^1[3-9]\d{9}$/.test(phone.value.trim()) || !/^\d{6}$/.test(smsCode.value.trim())) {
		uni.showToast({ title: '请填写手机号和6位验证码', icon: 'none' })
		return
	}
	binding.value = true
	try {
		const res = await bindPhone(phone.value.trim(), smsCode.value.trim())
		if (!res.success) {
			uni.showToast({ title: messageOf(res, '绑定失败'), icon: 'none' })
			return
		}
		uni.showToast({ title: '手机号已绑定', icon: 'success' })
		await refreshStatus()
	} finally { binding.value = false }
}

const confirmRealname = async () => {
	if (realnameSubmitting.value) return
	if (realName.value.trim().length < 2 || !/^[1-9]\d{5}(18|19|20)\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\d|3[01])\d{3}[0-9Xx]$/.test(idCard.value.trim())) {
		uni.showToast({ title: '请填写真实姓名和有效身份证号', icon: 'none' })
		return
	}
	realnameSubmitting.value = true
	try {
		const res = await submitRealname(realName.value.trim(), idCard.value.trim())
		if (!res.success) {
			uni.showToast({ title: messageOf(res, '提交失败'), icon: 'none' })
			return
		}
		realnameStatus.value = 1
		uni.showToast({ title: '已提交审核', icon: 'success' })
	} finally { realnameSubmitting.value = false }
}

const confirmEducation = async () => {
	if (educationSubmitting.value) return
	if (!educationSelected.value) {
		uni.showToast({ title: '请选择最高学历', icon: 'none' })
		return
	}
	educationSubmitting.value = true
	try {
		const res = await submitEducationCertification(educationOptions[educationIndex.value])
		if (!res.success) {
			uni.showToast({ title: messageOf(res, '学历认证提交失败'), icon: 'none' })
			return
		}
		educationStatus.value = res.data != null && res.data.education != null && res.data.education.status != null ? Number(res.data.education.status) : 1
		uni.showToast({ title: '已提交审核', icon: 'success' })
	} finally { educationSubmitting.value = false }
}

const backToApplication = () => { uni.navigateBack() }

onLoad((options: any) => {
	let requested = ''
	if (options != null && options.type != null) requested = String(options.type)
	else if (options != null && options.focus != null) requested = String(options.focus)
	if (requested == 'phone' || requested == 'realname' || requested == 'education') activeStep.value = requested
	if (options != null && options.returnTo != null) returnTo.value = String(options.returnTo)
	refreshStatus()
})
onShow(() => { refreshStatus() })
</script>

<style scoped>
.page { min-height: 100vh; background-color: var(--canvas); padding: 32rpx; box-sizing: border-box; }
.section-card, .notice-card { display: flex; flex-direction: column; gap: 28rpx; padding: 32rpx; background-color: var(--surface); border-radius: 24rpx; box-shadow: var(--shadow-sm); margin-bottom: 28rpx; }
.card-header, .notice-card { flex-direction: row; justify-content: space-between; align-items: center; gap: 20rpx; }
.notice-copy { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.notice-title { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.notice-text { font-size: 23rpx; color: var(--muted); }
.error-card { background-color: var(--paper); border: 1px solid var(--line); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: var(--ink); }
.section-note, .footer-tip { display: block; margin-top: 8rpx; font-size: 23rpx; color: var(--muted); line-height: 1.5; }
.progress-text { font-size: 25rpx; font-weight: 600; color: var(--accent2); white-space: nowrap; }
.cert-item { display: flex; flex-direction: row; align-items: center; gap: 20rpx; padding: 10rpx 0; }
.cert-icon-wrap { width: 76rpx; height: 76rpx; border-radius: 38rpx; background-color: var(--warm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.cert-icon-wrap.cert-done { background-color: var(--sage-soft); }
.cert-icon-text { font-size: 22rpx; font-weight: 700; color: var(--ink2); }
.cert-text-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.cert-label { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.cert-desc { font-size: 22rpx; color: var(--muted); line-height: 1.45; }
.status { font-size: 24rpx; font-weight: 600; white-space: nowrap; }
.passed, .uploaded { color: var(--sage); }
.reviewing { color: var(--accent2); }
.rejected, .field-error { color: var(--review-danger); }
.action-pill, .code-button, .text-action { padding: 12rpx 22rpx; border-radius: 16rpx; background-color: var(--warm); color: var(--accent2); font-size: 24rpx; flex-shrink: 0; }
.form-card { gap: 22rpx; }
.field-input, .picker-field { height: 88rpx; padding: 0 24rpx; border-radius: 18rpx; background-color: var(--surface); border: 1px solid var(--line); color: var(--ink); font-size: 27rpx; box-sizing: border-box; }
.picker-field { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.picker-arrow { color: var(--muted); font-size: 34rpx; }
.placeholder-text { color: var(--muted); }
.field-error { font-size: 23rpx; line-height: 1.5; }
.code-row { display: flex; flex-direction: row; gap: 16rpx; align-items: center; }
.code-input { flex: 1; }
.code-button { min-width: 168rpx; text-align: center; }
.disabled { opacity: 0.5; }
.primary-button { height: 92rpx; border-radius: 18rpx; background-color: var(--accent); color: var(--text-invert); display: flex; align-items: center; justify-content: center; font-size: 29rpx; font-weight: 600; }
.review-tip { padding: 22rpx; border-radius: 16rpx; background-color: var(--warm); color: var(--accent2); font-size: 25rpx; line-height: 1.5; }
.return-link { padding: 18rpx; text-align: center; color: var(--accent2); font-size: 27rpx; }
.footer-tip { text-align: center; padding: 0 12rpx 48rpx; }
</style>
