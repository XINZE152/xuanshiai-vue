<template>
	<view class="page">
		<view class="top-bar" :style="{ paddingTop: (statusBarHeight + topBarOffset) + 'px', height: (statusBarHeight + 44 + topBarOffset) + 'px' }">
			<view class="top-back" @tap="goBack"><text>←</text></view>
			<text class="top-title">我的任务</text>
		</view>

		<scroll-view scroll-y class="content-scroll" show-scrollbar="false">
			<view class="points-section">
				<view class="points-card">
					<view class="points-display">
						<text class="points-label">当前积分</text>
						<text class="points-value">{{ pointsText }}</text>
					</view>
					<view class="points-actions">
						<view class="outline-pill outline-pill-disabled" @tap="openPurchase"><text>购买积分（暂未开放）</text></view>
						<view class="outline-pill" @tap="openExchange"><text>兑换</text></view>
					</view>
					<text class="points-note">积分是平台通用虚拟货币，可兑换各类功能次数</text>
				</view>
			</view>

			<view class="checkin-section">
				<view class="section-heading">
					<text class="section-title">每日抽签</text>
				</view>
				<view class="daily-draw-card daily-draw-card-disabled" @tap="drawCheckIn">
					<text class="draw-card-label">DAILY BLESSING</text>
					<text class="draw-card-number">—</text>
					<text class="draw-card-message">每日抽签暂未开放</text>
					<text class="draw-card-action">开放后可在此收下今日祝福</text>
				</view>
			</view>

			<view class="earn-section">
				<text class="section-title">积分获取</text>
				<view class="earn-card">
					<view class="earn-icon"><text>📅</text></view>
					<view class="earn-copy"><text class="earn-title">每日抽签领积分</text><text class="earn-desc">暂未开放，开放后每天可抽一支签</text></view>
					<view class="small-action small-action-disabled" @tap="drawCheckIn"><text>暂未开放</text></view>
				</view>
				<view class="earn-card">
					<view class="earn-icon"><text>👥</text></view>
					<view class="earn-copy"><text class="earn-title">邀请好友赚积分</text><text class="earn-desc">暂未开放，开放后邀请注册双方各得积分</text></view>
					<view class="small-action small-action-disabled" @tap="openInvite"><text>暂未开放</text></view>
				</view>
			</view>

			<view class="usage-section">
				<text class="usage-title">积分使用范围</text>
				<text class="usage-line">• 可兑换申请认识次数、纸飞机</text>
				<text class="usage-line">• 可解锁筛选后他人名片</text>
				<text class="usage-line">• 免费查看名片额度耗尽后可通过积分兑换次数</text>
			</view>
			<view class="bottom-space"></view>
		</scroll-view>

		<view v-if="activeSheet === 'exchange'" class="sheet-mask" @tap="closeSheet">
			<view class="bottom-sheet exchange-sheet" @tap.stop>
				<view class="sheet-handle"></view>
				<text class="sheet-title">积分兑换</text>
				<view class="exchange-balance"><text>当前积分：</text><text class="balance-value">{{ pointsText }} 积分</text></view>
				<view class="exchange-options" v-if="exchangeItems.length > 0">
					<view v-for="(item, index) in exchangeItems" :key="item.key" class="exchange-option" :class="selectedExchangeItem === index ? 'exchange-selected' : ''" @tap="selectExchangeItem(index)">
						<text class="exchange-name">{{ item.name }}</text>
						<text class="exchange-cost">{{ item.cost }} 积分/次</text>
					</view>
				</view>
				<view v-else class="exchange-empty">
					<text class="exchange-empty-text">{{ exchangeError != '' ? exchangeError : (exchangeLoading ? '兑换项加载中…' : '暂无可兑换项，请稍后再来') }}</text>
				</view>
				<view class="cost-row"><text>共需</text><text class="cost-value">{{ exchangeCost }} 积分</text><text class="cost-unit">（单次兑换）</text></view>
				<text class="exchange-note">兑换成功后，积分余额与对应次数由服务器同步更新</text>
				<view class="sheet-primary-button" :class="currentExchangeItem == null || exchangeSubmitting ? 'sheet-primary-button-disabled' : ''" @tap="confirmExchange"><text>{{ exchangeSubmitting ? '兑换中…' : '立即兑换' }}</text></view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { getPointProducts, getPointsSummary, redeemPointProduct } from '@/api'

type ExchangeItem = { key: string; name: string; cost: number }

const points = ref(0)
const exchangeItems = ref<ExchangeItem[]>([])
const exchangeLoading = ref(false)
const exchangeSubmitting = ref(false)
const exchangeError = ref('')
const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const topBarOffset = 16
const activeSheet = ref('')
const selectedExchangeItem = ref(0)

const pointsText = computed(() => points.value.toLocaleString())
const currentExchangeItem = computed<ExchangeItem | null>(() => {
	const list = exchangeItems.value
	if (list.length == 0) return null
	const index = Math.min(Math.max(selectedExchangeItem.value, 0), list.length - 1)
	return list[index]
})
const exchangeCost = computed(() => {
	const item = currentExchangeItem.value
	return item != null ? item.cost : 0
})

const productLabel = (code: string): string => {
	if (code == 'extra_apply') return '申请认识次数'
	if (code == 'browse_unlock') return '查看资料次数'
	if (code == 'paper_plane_unlock') return '纸飞机次数'
	if (code == 'profile_detail_unlock') return '完整资料卡解锁'
	return ''
}

const loadPoints = async () => {
	const res = await getPointsSummary()
	if (res != null && res.success == true && res.data != null && res.data.balance != null) {
		points.value = Number(res.data.balance)
	}
}

const loadExchangeItems = async () => {
	exchangeLoading.value = true
	exchangeError.value = ''
	try {
		const res = await getPointProducts()
		if (res == null || res.success != true) {
			exchangeError.value = res != null && res.message != null && '' + res.message != '' ? '' + res.message : '兑换项读取失败，请稍后重试'
			exchangeItems.value = []
			return
		}
		const rows = res.data != null && Array.isArray(res.data) ? res.data as any[] : []
		const mapped: ExchangeItem[] = []
		for (let i = 0; i < rows.length; i++) {
			const product = rows[i]
			const code = product != null && product.code != null ? '' + product.code : ''
			const label = productLabel(code)
			if (label == '') continue
			mapped.push({ key: code, name: label, cost: Number(product.points_cost != null ? product.points_cost : 0) })
		}
		mapped.sort((a: ExchangeItem, b: ExchangeItem) => a.cost - b.cost)
		exchangeItems.value = mapped
		if (mapped.length > 0) selectedExchangeItem.value = 0
	} catch (error) {
		exchangeError.value = '兑换项读取失败，请稍后重试'
		exchangeItems.value = []
	} finally {
		exchangeLoading.value = false
	}
}

onShow(() => {
	loadPoints()
	loadExchangeItems()
})

const goBack = () => { uni.navigateBack() }
const openPurchase = () => { uni.showToast({ title: '积分充值暂未开放', icon: 'none' }) }
const openExchange = () => { activeSheet.value = 'exchange'; if (exchangeItems.value.length == 0) loadExchangeItems() }
const openInvite = () => { uni.showToast({ title: '邀请好友暂未开放', icon: 'none' }) }
const closeSheet = () => { activeSheet.value = '' }
const selectExchangeItem = (index: number) => { selectedExchangeItem.value = index }

const drawCheckIn = () => {
	uni.showToast({ title: '每日抽签暂未开放', icon: 'none' })
}

const confirmExchange = async () => {
	if (exchangeSubmitting.value) return
	const item = currentExchangeItem.value
	if (item == null || item.key == '') {
		uni.showToast({ title: exchangeError.value != '' ? exchangeError.value : '暂无可兑换项', icon: 'none' })
		return
	}
	if (points.value < item.cost) {
		uni.showToast({ title: '积分不足，当前 ' + points.value + ' 积分', icon: 'none' })
		return
	}
	exchangeSubmitting.value = true
	try {
		const res = await redeemPointProduct(item.key)
		// 余额一律回读服务器，兑换失败不能报成功。
		await loadPoints()
		if (res == null || res.success != true) {
			const msg = res != null && res.message != null && '' + res.message != '' ? '' + res.message : '兑换失败，请重试'
			uni.showToast({ title: msg, icon: 'none' })
			return
		}
		activeSheet.value = ''
		uni.showToast({ title: '兑换成功', icon: 'success' })
	} finally {
		exchangeSubmitting.value = false
	}
}
</script>

<style scoped>
.page {
	height: 100vh;
	display: flex;
	flex-direction: column;
	background-color: #EDF1EC;
	color: #1A1A1A;
	--task-bg: #EDF1EC;
	--task-paper: #FFFFFF;
	--task-card: #F8F9F6;
	--task-text: #1A1A1A;
	--task-secondary: #4B5563;
	--task-muted: #9CA3AF;
	--task-sage: #E2EBE0;
	--task-green: #A8C0A5;
	--task-green-deep: #627A5F;
	--task-green-light: #EDF4EC;
	--task-border: #E8EAE4;
	--task-gold-light: #F7F1E5;
	--task-gold: #C9A96E;
	--task-gold-text: #B8944A;
}
.top-bar { position: relative; flex-shrink: 0; display: flex; flex-direction: row; align-items: center; justify-content: center; padding-left: 32rpx; padding-right: 32rpx; box-sizing: border-box; background-color: var(--task-paper); }
.top-back { position: absolute; left: 32rpx; width: 56rpx; font-size: 36rpx; color: var(--task-text); }
.top-title { color: var(--task-text); font-size: 34rpx; font-weight: 500; }
.content-scroll { flex: 1; min-height: 0; box-sizing: border-box; background-color: var(--task-bg); }
.points-section, .checkin-section { padding: 28rpx 32rpx 0; }
.points-card { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 36rpx 36rpx 28rpx; border-radius: 32rpx; background: linear-gradient(135deg, #E8EDE4 0%, #DCE5D6 60%, #F0EBE0 100%); }
.points-display { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.points-label { color: var(--task-secondary); font-size: 26rpx; font-weight: 400; }
.points-value { color: var(--task-text); font-family: var(--serif); font-size: 72rpx; line-height: 1.1; font-weight: 700; }
.points-actions { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 24rpx; }
.outline-pill { padding: 20rpx 36rpx; border: 1px solid var(--task-green); border-radius: 9999rpx; color: var(--task-green-deep); background-color: var(--task-sage); font-size: 26rpx; font-weight: 500; }
.outline-pill-disabled { border-color: var(--task-border); color: var(--task-muted); background-color: var(--task-card); }
.points-note { color: var(--task-muted); font-size: 24rpx; font-weight: 400; }
.section-heading { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.section-title { color: var(--task-text); font-size: 32rpx; font-weight: 600; }
.daily-draw-card { min-height: 260rpx; padding: 36rpx 28rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; border: 1px solid var(--task-border); border-radius: 24rpx; box-sizing: border-box; text-align: center; background-color: var(--task-paper); }
.daily-draw-card-disabled { background-color: var(--task-card); }
.draw-card-label { color: var(--task-green-deep); font-size: 20rpx; font-weight: 700; }
.draw-card-number { color: var(--task-gold-text); font-family: var(--serif); font-size: 42rpx; font-weight: 700; line-height: 1.1; }
.draw-card-message { color: var(--task-text); font-family: var(--serif); font-size: 28rpx; font-weight: 700; line-height: 1.45; }
.draw-card-action { margin-top: 6rpx; color: var(--task-green-deep); font-size: 22rpx; font-weight: 700; }
.earn-section { display: flex; flex-direction: column; gap: 24rpx; padding: 24rpx 32rpx 0; }
.earn-card { display: flex; flex-direction: row; align-items: center; padding: 32rpx; border: 1px solid var(--task-border); border-radius: 24rpx; background-color: var(--task-card); box-shadow: 0 2px 10px rgba(36, 55, 40, 0.04); }
.earn-icon { width: 80rpx; height: 80rpx; margin-right: 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--task-green-deep); background-color: var(--task-sage); font-size: 40rpx; }
.earn-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.earn-title { color: var(--task-text); font-size: 28rpx; font-weight: 400; }
.earn-desc { color: var(--task-muted); font-size: 24rpx; line-height: 1.6; font-weight: 400; }
.small-action { padding: 16rpx 32rpx; border-radius: 9999rpx; color: var(--task-green-deep); background-color: var(--task-green-light); font-size: 26rpx; font-weight: 500; white-space: nowrap; }
.small-action-disabled { color: var(--task-muted); background-color: var(--task-sage); }
.usage-section { display: flex; flex-direction: column; gap: 16rpx; padding: 32rpx 40rpx 48rpx; }
.usage-title { color: var(--task-muted); font-size: 26rpx; font-weight: 600; }
.usage-line { color: var(--task-muted); font-size: 24rpx; line-height: 1.6; font-weight: 400; }
.bottom-space { height: 48rpx; }
.sheet-mask { position: fixed; z-index: 20; left: 0; right: 0; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: flex-end; background-color: rgba(26, 35, 29, 0.42); }
.bottom-sheet { display: flex; flex-direction: column; padding: 24rpx 32rpx 32rpx; border-radius: 24rpx 24rpx 0 0; background-color: var(--task-bg); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; border-radius: 9999rpx; background-color: #D7DDD5; }
.sheet-title { margin-bottom: 28rpx; color: var(--task-text); font-size: 32rpx; font-weight: 600; }
.sheet-primary-button { min-height: 72rpx; margin-top: 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: var(--task-text); background: linear-gradient(90deg, #D4E4D0 0%, #BCD4B6 100%); font-size: 26rpx; font-weight: 600; }
.sheet-primary-button-disabled { color: var(--task-muted); background-color: var(--task-sage); background-image: none; }
.exchange-empty { min-height: 120rpx; margin-top: 24rpx; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--task-border); border-radius: 16rpx; }
.exchange-empty-text { color: var(--task-muted); font-size: 24rpx; text-align: center; }
.exchange-balance { display: flex; flex-direction: row; justify-content: center; align-items: center; color: var(--task-muted); font-size: 24rpx; }
.balance-value { color: var(--task-text); font-weight: 700; }
.exchange-options { display: flex; flex-direction: row; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.exchange-option { width: calc((100% - 16rpx) / 2); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; padding: 24rpx 8rpx; border: 1px solid transparent; border-radius: 16rpx; background-color: var(--task-card); }
.exchange-selected { border-color: var(--task-green); background-color: var(--task-paper); }
.exchange-name { color: var(--task-text); font-size: 24rpx; }
.exchange-cost { margin-top: 8rpx; color: var(--task-gold-text); font-size: 22rpx; }
.cost-row { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8rpx; margin-top: 24rpx; color: var(--task-muted); font-size: 24rpx; }
.cost-unit { font-size: 20rpx; }
.cost-value { color: var(--task-gold-text); font-weight: 700; }
.exchange-note { margin-top: 16rpx; color: var(--task-muted); font-size: 22rpx; line-height: 1.5; text-align: center; }
</style>
