<template>
	<view class="visitors-page">
		<view class="status-bar"><text>9:41</text><text>●●●</text></view>
		<view class="record-nav"><view class="back-button" @tap="goBack"><text class="ic ic-sys ic-fanhui"></text></view><text class="nav-title">浏览记录</text><view class="nav-placeholder"></view></view>
		<view class="main-tabs"><view class="main-tab" @tap="goHistory"><text>我看过谁</text><view class="tab-line"></view></view><view class="main-tab active"><text>谁看过我</text><view class="tab-line"></view></view></view>
		<scroll-view class="visitors-scroll" scroll-y>
			<view class="unlock-banner"><view class="banner-top"><view class="banner-lock"><text class="ic ic-vip ic-huiyuan"></text></view><view class="banner-copy"><text class="banner-title">解锁查看全部访客</text><text class="banner-subtitle">开通VIP会员，查看谁在关注你</text></view></view><view class="banner-button" @tap="goVip"><text>立即开通会员</text></view></view>
			<view class="visitor-heading"><text>最近访客</text><view class="sort"><text class="ic ic-sys ic-xiala"></text><text>按时间</text></view></view>
			<view class="visitor-grid"><view class="visitor-card" v-for="visitor in visitors" :key="visitor.distance"><view class="photo-area"><view class="person-placeholder"><text class="ic ic-social ic-touxiang"></text></view><view class="photo-lock"><view class="photo-lock-circle"><text class="ic ic-vip ic-huiyuan"></text></view></view></view><view class="info-strip"><text>距你 {{ visitor.distance }}</text><text class="hot">合拍度 {{ visitor.compatText }}</text></view></view></view>
			<view class="bottom-unlock"><view class="bottom-vip-icon"><text class="ic ic-vip ic-huiyuan"></text></view><text class="bottom-title">还有更多人在关注你</text><text class="bottom-desc">开通VIP会员后，所有访客记录将自动解锁，你可以查看对方的详细资料并发起互动</text><view class="bottom-button" @tap="goVip"><text>立即开通VIP · 解锁全部访客</text></view><view class="feature-list"><text>✓ 无限查看</text><text>✓ 清晰头像</text><text>✓ 详细资料</text></view></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { getVisitors } from '@/api'
const visitors = ref<any[]>([])
const loadVisitors = async () => {
	const res = await getVisitors(1, 20)
	if (!res.success || res.data == null) return
	const rows = res.data.items != null && Array.isArray(res.data.items) ? res.data.items as any[] : []
	const result: any[] = []
	for (let i = 0; i < rows.length; i++) {
		const card = rows[i].target != null ? rows[i].target : {}
		result.push({ distance: card.distance_km != null ? Number(card.distance_km).toFixed(1) + 'km' : '未知', compatText: card.match_score != null ? Math.round(Number(card.match_score)) + '%' : '--' })
	}
	visitors.value = result
}
const goBack = () => { uni.navigateBack({}) }
const goHistory = () => { uni.redirectTo({ url: '/pagesSub/profileExtra/history' }) }
const goVip = () => { uni.navigateTo({ url: '/pagesSub/profileExtra/vip' }) }
onMounted(() => { loadVisitors() })
</script>

<style>
page { background: #F7F4F0; }.visitors-page { min-height: 100vh; background: #F7F4F0; color: #2C2C2C; }.status-bar { height: 62px; padding: 20px 16px 0; box-sizing: border-box; display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; color: #2C2C2C; font-size: 14px; font-weight: 600; }.record-nav { height: 52px; padding: 0 16px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }.back-button,.nav-placeholder { width: 40px; height: 40px; }.back-button { display: flex; align-items: center; justify-content: center; border-radius: 20px; background: #FFFFFF; }.nav-title { font-size: 17px; font-weight: 600; }.main-tabs { display: flex; flex-direction: row; padding: 0 16px; border-bottom: 1px solid #E5E1DA; }.main-tab { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 12px 20px 0; color: #A9A6A0; font-size: 15px; }.main-tab.active { color: #2C2C2C; font-weight: 600; }.tab-line { width: 100%; height: 3px; margin-top: 10px; }.main-tab.active .tab-line { background: #D4A89E; }.visitors-scroll { height: calc(100vh - 158px); padding: 12px 16px 32px; box-sizing: border-box; }.unlock-banner { padding: 16px; border-radius: 16px; background: #FFF4DA; }.banner-top { display: flex; flex-direction: row; align-items: center; gap: 12px; }.banner-lock,.bottom-vip-icon { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #F7E5E2; color: #C77F76; }.banner-lock { width: 48px; height: 48px; font-size: 24px; }.banner-copy { flex: 1; display: flex; flex-direction: column; gap: 5px; }.banner-title { font-size: 16px; font-weight: 600; }.banner-subtitle { color: #8E8E8A; font-size: 12px; }.banner-button { display: flex; align-items: center; justify-content: center; height: 44px; margin-top: 14px; border-radius: 22px; background: #D4A89E; color: #FFFFFF; font-size: 14px; font-weight: 600; }.visitor-heading { display: flex; flex-direction: row; justify-content: space-between; padding: 20px 0 12px; font-size: 15px; font-weight: 600; }.sort { display: flex; flex-direction: row; align-items: center; gap: 4px; color: #8E8E8A; font-size: 12px; font-weight: 400; }.visitor-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12px; }.visitor-card { width: calc(50% - 6px); overflow: hidden; border-radius: 14px; background: #FFFFFF; }.photo-area { position: relative; height: 164px; display: flex; align-items: center; justify-content: center; background: #E9E6E0; }.person-placeholder { color: #A9A6A0; font-size: 52px; }.photo-lock { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: rgba(247,244,240,.42); }.photo-lock-circle { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 18px; background: rgba(44,44,44,.58); color: #FFFFFF; font-size: 18px; }.info-strip { display: flex; flex-direction: row; justify-content: space-between; padding: 10px 12px; color: #8E8E8A; font-size: 11px; }.hot { color: #C77F76; }.bottom-unlock { display: flex; flex-direction: column; align-items: center; margin-top: 24px; padding: 24px 16px 28px; border-radius: 16px; background: #FFFFFF; }.bottom-vip-icon { width: 56px; height: 56px; font-size: 28px; }.bottom-title { margin-top: 10px; font-size: 16px; font-weight: 600; }.bottom-desc { margin-top: 6px; color: #8E8E8A; font-size: 12px; line-height: 1.6; text-align: center; }.bottom-button { margin-top: 16px; padding: 12px 24px; border-radius: 23px; background: #D4A89E; color: #FFFFFF; font-size: 13px; font-weight: 600; }.feature-list { display: flex; flex-direction: row; gap: 16px; margin-top: 16px; color: #8FA88A; font-size: 11px; }
@font-face { font-family: "iconfont-sys"; src: url('/static/婚恋小程序图标/系统通用/iconfont.woff2') format('woff2'); } @font-face { font-family: "iconfont-social"; src: url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff2') format('woff2'); } @font-face { font-family: "iconfont-vip"; src: url('/static/婚恋小程序图标/会员支付与任务/iconfont.woff2') format('woff2'); }.ic{font-style:normal}.ic-sys{font-family:"iconfont-sys"}.ic-social{font-family:"iconfont-social"}.ic-vip{font-family:"iconfont-vip"}.ic-fanhui:before{content:"\e606"}.ic-xiala:before{content:"\e609"}.ic-huiyuan:before{content:"\e65d"}.ic-touxiang:before{content:"\e632"}
</style>
