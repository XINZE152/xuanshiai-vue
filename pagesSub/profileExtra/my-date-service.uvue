<script setup lang="uts">
type StepItem = {
	no: string
	name: string
	lines: string[]
}

const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20

const steps: StepItem[] = [
	{ no: '1', name: '需求匹配', lines: ['红娘按你的', '择偶要求牵线'] },
	{ no: '2', name: '线下约见', lines: ['安排与心仪', '嘉宾初见面'] },
	{ no: '3', name: '约会反馈', lines: ['写反馈并为', '红娘服务打分'] }
]

const goBack = () => { uni.navigateBack() }
const onFindMatchmaker = () => {
	uni.showToast({ title: '已为您联系红娘', icon: 'none' })
}
</script>

