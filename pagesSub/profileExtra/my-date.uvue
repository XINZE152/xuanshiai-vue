<template>
	<view class="page">
		<view class="top-bar" :style="{ paddingTop: statusBarHeight + 'px', height: (statusBarHeight + 52) + 'px' }">
			<view class="top-back" @tap="goBack"><text>‹</text></view>
			<view class="top-placeholder"></view>
		</view>

		<scroll-view scroll-y class="content-scroll" show-scrollbar="false">
			<view class="content-inner">
				<view class="page-head">
					<text class="page-title">我的约会</text>
					<text class="page-sub">共 {{ totalCount }} 场约会 · {{ pendingCount }} 场待确认</text>
				</view>

				<view class="filter-tabs">
					<view v-for="tab in statusTabs" :key="tab.key" class="filter-tab" :class="activeFilter === tab.key ? 'filter-tab-active' : ''" @tap="selectFilter(tab.key)">
						<text>{{ tab.label }}</text>
					</view>
				</view>

				<view v-if="visibleItems.length > 0" class="ticket-list">
					<view v-for="item in visibleItems" :key="item.id" class="ticket-card">
						<view class="notch notch-left"></view>
						<view class="notch notch-right"></view>
						<view class="ticket-main">
							<view class="date-block">
								<text class="date-num">{{ item.dateText }}</text>
								<text class="date-week">{{ item.weekText }}</text>
							</view>
							<view class="ticket-copy">
								<text class="ticket-title">{{ item.title }}</text>
								<view class="ticket-with">
									<image class="with-avatar" :src="item.partnerAvatar" mode="aspectFill"></image>
									<text class="with-name">{{ item.partnerName }}</text>
								</view>
								<text class="ticket-loc">{{ item.location }}</text>
							</view>
						</view>
						<view class="status-stamp" :class="item.stampClass"><text>{{ item.statusLabel }}</text></view>
						<view class="ticket-stub">
							<view class="met-wrap">
								<text class="met-label">见面方式</text>
								<text class="met-value" :class="item.metClass">{{ item.metValue }}</text>
							</view>
							<view class="detail-link" @tap="viewDetail(item)"><text>约会详情</text><text class="detail-arrow">→</text></view>
						</view>
					</view>
				</view>

				<view v-else class="empty-state">
					<view class="empty-ring"></view>
					<text class="empty-title">暂无相关约会</text>
					<text class="empty-copy">确认后的约会安排会显示在这里</text>
				</view>
				<view class="bottom-space"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
type DateKey = 'all' | 'pending' | 'confirmed' | 'done' | 'cancelled'
type DateTab = { key: DateKey; label: string }
type DateItem = {
	id: number
	status: DateKey
	statusLabel: string
	stampClass: string
	dateText: string
	weekText: string
	title: string
	partnerName: string
	partnerAvatar: string
	location: string
	metValue: string
	metClass: string
}

const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const activeFilter = ref<DateKey>('all')

const statusTabs: DateTab[] = [
	{ key: 'all', label: '全部' },
	{ key: 'pending', label: '待确认' },
	{ key: 'confirmed', label: '已确认' },
	{ key: 'done', label: '已完成' },
	{ key: 'cancelled', label: '已取消' }
]

const dates: DateItem[] = [
	{
		id: 1,
		status: 'pending',
		statusLabel: '待确认',
		stampClass: 'stamp-pending',
		dateText: '07.05',
		weekText: '周日 15:00',
		title: '咖啡馆慢聊',
		partnerName: '沈亦舟',
		partnerAvatar: '/static/avatars/matchmaking-anime-034.jpg',
		location: '滨江 · 天目里 B 区',
		metValue: '线下见面',
		metClass: 'met-offline'
	},
	{
		id: 2,
		status: 'confirmed',
		statusLabel: '已确认',
		stampClass: 'stamp-success',
		dateText: '07.12',
		weekText: '周六 14:00',
		title: '美术馆同行',
		partnerName: '温知意',
		partnerAvatar: '/static/avatars/matchmaking-anime-047.jpg',
		location: '南山路 · 浙江美术馆',
		metValue: '线下见面',
		metClass: 'met-offline'
	},
	{
		id: 3,
		status: 'confirmed',
		statusLabel: '已确认',
		stampClass: 'stamp-success',
		dateText: '07.19',
		weekText: '周六 19:00',
		title: '晚餐约会',
		partnerName: '苏窈',
		partnerAvatar: '/static/avatars/matchmaking-anime-058.jpg',
		location: '湖滨 · 银泰 in77',
		metValue: '线下见面',
		metClass: 'met-offline'
	},
	{
		id: 4,
		status: 'done',
		statusLabel: '已完成',
		stampClass: 'stamp-checked',
		dateText: '06.28',
		weekText: '周六 19:30',
		title: '江边散步',
		partnerName: '林清欢',
		partnerAvatar: '/static/avatars/matchmaking-anime-063.jpg',
		location: '钱塘江滨江步道',
		metValue: '线下见面',
		metClass: 'met-offline'
	},
	{
		id: 5,
		status: 'done',
		statusLabel: '已完成',
		stampClass: 'stamp-checked',
		dateText: '06.15',
		weekText: '周日 13:00',
		title: '视频初见',
		partnerName: '宋轻语',
		partnerAvatar: '/static/avatars/matchmaking-anime-071.jpg',
		location: '线上 · 视频通话',
		metValue: '视频约会',
		metClass: 'met-online'
	},
	{
		id: 6,
		status: 'cancelled',
		statusLabel: '已取消',
		stampClass: 'stamp-rejected',
		dateText: '06.22',
		weekText: '周日 16:00',
		title: '公园漫步',
		partnerName: '韩星河',
		partnerAvatar: '/static/avatars/matchmaking-anime-019.jpg',
		location: '西湖景区 · 曲院风荷',
		metValue: '线下见面',
		metClass: 'met-offline'
	}
]

const totalCount = dates.length
let pendingTotal = 0
for (const item of dates) {
	if (item.status === 'pending') pendingTotal++
}
const pendingCount = pendingTotal

const visibleItems = computed<DateItem[]>(() => {
	const result: DateItem[] = []
	for (const item of dates) {
		if (activeFilter.value === 'all' || item.status === activeFilter.value) {
			result.push(item)
		}
	}
	return result
})

const goBack = () => { uni.navigateBack() }
const selectFilter = (key: DateKey) => { activeFilter.value = key }
const viewDetail = (item: DateItem) => {
	uni.showToast({ title: `${item.title}详情 Demo`, icon: 'none' })
}
</script>

<style scoped>
