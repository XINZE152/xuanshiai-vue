<template>
	<view class="mpr-page">
		<!-- 导航栏 -->
		<view class="mpr-nav" :style="{ paddingTop: navPadTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
			<view class="mpr-nav-side mpr-nav-back" @tap="navBack">
				<text class="mpr-nav-back-text">‹</text>
			</view>
			<text class="mpr-nav-title" :style="{ top: navPadTop + 'px' }">{{ subjectLabel }}</text>
			<view class="mpr-nav-side"></view>
		</view>

		<view v-if="loading" class="mpr-state">
			<view class="mpr-loading-dot"></view>
			<text class="mpr-state-title">{{ stateMessage }}</text>
		</view>

		<view v-else-if="errorMessage != ''" class="mpr-state">
			<text class="mpr-state-title">暂时没有铺开这份成稿</text>
			<text class="mpr-state-copy">{{ errorMessage }}</text>
			<view class="mpr-btn" @tap="retryLoad"><text class="mpr-btn-text">重试</text></view>
		</view>

		<!-- 发布前：只展示当前草稿对应的精确预览。 -->
		<view v-else-if="!publishedMode && previewContent != ''" class="mpr-body">
			<view class="mpr-paper">
				<text class="mpr-kicker">成稿预览 · 尚未发布</text>
				<text class="mpr-preview-content">{{ previewContent }}</text>
			</view>

			<view class="mpr-actions">
				<view class="mpr-btn mpr-btn-primary" :class="{ 'mpr-btn-disabled': publishing }" @tap="onConfirmPublish">
					<text class="mpr-btn-primary-text">{{ publishing ? '正在发布…' : '发布这份成稿' }}</text>
				</view>
				<view class="mpr-btn" @tap="onContinueChat"><text class="mpr-btn-text">继续聊聊完善</text></view>
				<view class="mpr-btn mpr-btn-ghost" @tap="onBackToArchive"><text class="mpr-btn-text">返回画像档案</text></view>
			</view>
			<text class="mpr-hint">发布的是你此刻看到的这一版。发布完成后，AI 会整理完整画像并交给你确认。</text>
		</view>

		<!-- 已发布但叙事 Worker 尚未生成完成。 -->
		<view v-else-if="publishedMode && !narrativeReady" class="mpr-state">
			<text class="mpr-state-title">正在写下完整画像</text>
			<text class="mpr-state-copy">成稿已经发布，完整理解仍在后台整理。稍后刷新即可，不需要重复发布。</text>
			<text v-if="narrativeFailure != ''" class="mpr-state-copy mpr-fail">上次整理失败：{{ narrativeFailure }}。可稍后刷新重试，不影响已发布的成稿。</text>
			<view class="mpr-btn mpr-btn-primary" @tap="retryLoad">
				<text class="mpr-btn-primary-text">刷新画像</text>
			</view>
			<view v-if="narrativeFailure != ''" class="mpr-btn" :class="{ 'mpr-btn-disabled': regenerating }" @tap="onRegenerateNarrative">
				<text class="mpr-btn-text">{{ regenerating ? '正在重新生成…' : '重新生成完整画像' }}</text>
			</view>
			<view class="mpr-btn mpr-btn-ghost" @tap="onBackToArchive"><text class="mpr-btn-text">先返回档案</text></view>
		</view>

		<!-- 完整画像：pending_confirmation / confirmed / 历史 published。 -->
		<scroll-view v-else-if="narrativeReady" scroll-y class="mpr-scroll" enhanced :show-scrollbar="false">
			<view class="mpr-body">
				<view class="mpr-paper">
					<text class="mpr-kicker">{{ narrativeStatusLabel }}</text>
					<text v-if="narrative.persona_title != null && narrative.persona_title != ''" class="mpr-title">{{ narrative.persona_title }}</text>

					<view v-if="narrative.persona_tags != null && narrative.persona_tags.length > 0" class="mpr-tags">
						<text v-for="tag in narrative.persona_tags" :key="tag" class="mpr-tag">{{ tag }}</text>
					</view>

					<view v-if="narrative.insight != null && narrative.insight != ''" class="mpr-section">
						<text class="mpr-section-label">AI 的理解</text>
						<text class="mpr-section-copy">{{ narrative.insight }}</text>
					</view>

					<view v-if="narrative.dimensions != null && narrative.dimensions.length > 0" class="mpr-section">
						<text class="mpr-section-label">画像结构</text>
						<view v-for="dim in narrative.dimensions" :key="dim.key" class="mpr-dimension">
							<text class="mpr-dimension-title">{{ dim.title }}</text>
							<text class="mpr-dimension-copy">{{ dim.summary }}</text>
						</view>
					</view>

					<view v-if="narrative.ideal_weights != null && narrative.ideal_weights.length > 0" class="mpr-section">
						<text class="mpr-section-label">你在意的配比</text>
						<view v-for="weight in narrative.ideal_weights" :key="weight.key" class="mpr-weight">
							<text class="mpr-weight-label">{{ weight.label }}</text>
							<view class="mpr-weight-track"><view class="mpr-weight-fill" :style="{ width: weight.percent + '%' }"></view></view>
							<text class="mpr-weight-value">{{ weight.percent }}%</text>
						</view>
					</view>

					<view v-if="narrative.recent_change != null" class="mpr-section mpr-change">
						<text class="mpr-section-label">最近的一笔</text>
						<text class="mpr-dimension-title">{{ narrative.recent_change.summary }}</text>
						<text class="mpr-dimension-copy">{{ narrative.recent_change.observation }}</text>
					</view>

					<view v-if="narrative.history_observations != null && narrative.history_observations.length > 0" class="mpr-section">
						<text class="mpr-section-label">一路留下的变化</text>
						<view v-for="item in narrative.history_observations" :key="item.revision_id" class="mpr-history">
							<text class="mpr-dimension-copy">{{ item.observation }}</text>
						</view>
					</view>

					<view v-if="narrative.emotional_insight != null" class="mpr-section mpr-emotional-insight">
						<view class="mpr-insight-header">
							<text class="mpr-section-label">情感气质透视</text>
							<view class="mpr-attachment-badge">
								<text class="mpr-attachment-badge-text">{{ attachmentStyleLabel(narrative.emotional_insight.attachment_style) }}</text>
							</view>
						</view>
						<text v-if="narrative.emotional_insight.attachment_summary != null && narrative.emotional_insight.attachment_summary != ''" class="mpr-attachment-summary">{{ narrative.emotional_insight.attachment_summary }}</text>

						<view v-if="narrative.emotional_insight.highlights != null && narrative.emotional_insight.highlights.length > 0" class="mpr-sub-block">
							<text class="mpr-sub-title">相处闪光点</text>
							<view v-for="(hl, idx) in narrative.emotional_insight.highlights" :key="'hl-' + idx" class="mpr-bullet-row">
								<text class="mpr-bullet-dot">✦</text>
								<text class="mpr-bullet-copy">{{ hl }}</text>
							</view>
						</view>

						<view v-if="narrative.emotional_insight.boundaries != null && narrative.emotional_insight.boundaries.length > 0" class="mpr-sub-block">
							<text class="mpr-sub-title">相处安全边界</text>
							<view v-for="(bd, idx) in narrative.emotional_insight.boundaries" :key="'bd-' + idx" class="mpr-bullet-row">
								<text class="mpr-bullet-dot">◇</text>
								<text class="mpr-bullet-copy">{{ bd }}</text>
							</view>
						</view>

						<view v-if="narrative.emotional_insight.master_message != null && narrative.emotional_insight.master_message != ''" class="mpr-master-quote">
							<text class="mpr-master-quote-mark">“</text>
							<text class="mpr-master-quote-text">{{ narrative.emotional_insight.master_message }}</text>
						</view>
					</view>

					<view v-if="narrative.conclusion != null && narrative.conclusion != ''" class="mpr-section mpr-conclusion">
						<text class="mpr-section-label">收束</text>
						<text class="mpr-section-copy">{{ narrative.conclusion }}</text>
					</view>
				</view>

				<view class="mpr-actions">
					<view v-if="awaitingNarrativeConfirmation" class="mpr-btn mpr-btn-primary" :class="{ 'mpr-btn-disabled': confirming }" @tap="onConfirmNarrative">
						<text class="mpr-btn-primary-text">{{ confirming ? '正在确认…' : '这份画像符合我' }}</text>
					</view>
					<view v-if="canPrepareProfileCard" class="mpr-btn mpr-btn-profile-card" @tap="onPrepareProfileCard"><text class="mpr-btn-profile-card-text">整理为公开介绍</text></view>
					<view v-if="narrativeReady && subject == 'ideal_partner'" class="mpr-btn mpr-btn-profile-card" @tap="onOpenSearchSuggestions"><text class="mpr-btn-profile-card-text">根据已确认资料整理找人建议</text></view>
					<view v-if="narrativeReady && subject == 'personal'" class="mpr-btn mpr-btn-poster" @tap="onOpenPoster">
						<text class="mpr-btn-poster-text">生成专属画像海报</text>
					</view>
					<view class="mpr-btn" @tap="onContinueChat"><text class="mpr-btn-text">继续聊聊完善</text></view>
					<view class="mpr-btn mpr-btn-ghost" @tap="onBackToArchive"><text class="mpr-btn-text">返回画像档案</text></view>
				</view>
				<text v-if="awaitingNarrativeConfirmation" class="mpr-hint">确认前请先完整看一遍。确认只表示这份文字符合你的自我理解，不代表平台替你作出事实认证。</text>
			</view>
		</scroll-view>

		<view v-else class="mpr-state">
			<text class="mpr-state-title">还没有可整理的{{ subjectLabel }}</text>
			<view class="mpr-btn" @tap="onContinueChat"><text class="mpr-btn-text">去聊一聊</text></view>
		</view>

		<!-- 专属墨相海报弹窗 -->
		<MoxiangPosterSheet :visible="showPosterSheet" :data="posterData" @close="showPosterSheet = false" />

		<view v-if="profileCardVisible" class="mpr-card-mask" @tap="closeProfileCard">
			<view class="mpr-card-sheet" @tap.stop>
				<text class="mpr-card-title">整理为公开介绍</text>
				<scroll-view scroll-y class="mpr-card-scroll" enhanced :show-scrollbar="false">
					<view class="mpr-card-content">
						<text class="mpr-card-copy">确认画像只代表本人确认，不会自动公开。点击“确认采用”才会写入公开资料；未选择字段不写入。实际可见对象仍受现有隐私设置约束，这里不会扩大可见范围。</text>
						<text class="mpr-card-copy mpr-card-boundary">这里不会修改长期择偶标准、发送消息或公开访谈原文。</text>
						<view v-if="profileCardLoading" class="mpr-card-state"><text>正在整理公开介绍…</text></view>
						<view v-else-if="profileCardError != ''" class="mpr-card-state"><text>{{ profileCardError }}</text><view class="mpr-btn" @tap="onPrepareProfileCard"><text class="mpr-btn-text">重新整理</text></view></view>
						<view v-else>
							<text v-if="profileCardApplyMessage != ''" class="mpr-card-limit">{{ profileCardApplyMessage }}</text>
								<view v-for="row in profileCardRows" :key="row.key" class="mpr-card-row">
									<view class="mpr-card-row-copy"><text class="mpr-card-row-label">{{ row.label }}</text></view><text class="mpr-card-row-toggle" @tap="toggleProfileCardField(row.key)">{{ row.selected ? '采用' : '跳过' }}</text>
									<template v-if="row.key == 'self_intro'">
										<textarea v-model="row.value" class="mpr-card-editor" maxlength="500" :disabled="profileCardApplying || profileCardApplyPayload != null" />
										<view v-if="row.selected" class="mpr-card-replace" @tap="toggleReplaceExistingSelfIntro"><text>已有自我介绍默认保留</text><text class="mpr-card-replace-value">{{ replaceExistingSelfIntro ? '已确认替换已有介绍' : '不会替换已有介绍' }}</text></view>
									</template>
									<view v-else class="mpr-card-tags"><text class="mpr-card-limit">{{ profileCardTagLimitText }}</text><view v-for="tag in row.tags" :key="tag" class="mpr-card-tag" :class="{ 'mpr-card-tag-selected': profileCardSelectedTags.indexOf(tag) >= 0 }" @tap="toggleProfileCardTag(tag)"><text>{{ tag }}</text></view></view>
								</view>
								<text v-if="profileCardInterestTagsAbsent" class="mpr-card-limit">本次没有生成可采用的兴趣标签，正文仍可采用。</text>
						</view>
					</view>
				</scroll-view>
				<view v-if="!profileCardLoading && profileCardError == '' && profileCardRows.length > 0" class="mpr-card-actions"><view class="mpr-btn mpr-btn-ghost" @tap="closeProfileCard"><text class="mpr-btn-text">{{ profileCardApplyPayload != null ? '返回' : '取消' }}</text></view><view class="mpr-btn mpr-btn-primary" :class="{ 'mpr-btn-disabled': profileCardApplying }" @tap="onRequestApplyProfileCard"><text class="mpr-btn-primary-text">{{ profileCardApplying ? '正在保存…' : (profileCardApplyPayload != null ? '重试核对' : '确认采用') }}</text></view></view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	import { createProfilePreview, getProfilePreview, type ProfilePreviewRecord } from '@/api/ai-moxiang.uts'
	import { publishProfileDraft, pollTaskUntilTerminal, getPortraitNarrative, confirmPortraitNarrative, regeneratePortraitNarrative } from '@/api/ai-profile.uts'
	import { summarizeProfileCard, getProfileCardDraft, applyProfileCardDraft, isProfileCardVersionConflict, waitForProfileCardTask, createProfileCardIdempotencyKey } from '@/api/ai-profile-card.uts'
	import { getMeProfile, getOwnProfile } from '@/api/user.uts'
	import MoxiangPosterSheet from '@/components/moxiang/MoxiangPosterSheet.uvue'
	import type { MoxiangPosterData } from '@/utils/moxiang-poster-drawer.uts'

	const systemInfo = uni.getSystemInfoSync()
	const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
	const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
	const navPadTop = menuButtonInfo != null && menuButtonInfo.top > statusBarHeight ? menuButtonInfo.top : statusBarHeight + 6
	const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8
	// 采用标签预算：后端 merge 写入按「已有标签 + 本次采用 <= 10」做最终校验，
	// 前端用同一口径预先限制可选数量，避免用户只撞到通用校验报错。
	// existing < 0 表示还没读到已有标签数，退回旧的 3 个上限，由后端兜底。
	const MAX_PROFILE_CARD_ADOPT_TAGS = 3
	const MAX_PERSONAL_TAGS = 10
	function profileCardTagBudget(existing: number): number {
		const room = MAX_PERSONAL_TAGS - existing
		if (room <= 0) return 0
		return room > MAX_PROFILE_CARD_ADOPT_TAGS ? MAX_PROFILE_CARD_ADOPT_TAGS : room
	}

	export default {
		components: {
			MoxiangPosterSheet
		},
		data() {
			return {
				navPadTop: navPadTop,
				menuButtonSpacing: menuButtonSpacing,
				subject: 'personal',
				subjectLabel: '我的真实画像',
				draftId: '',
				expectedRevision: 0,
				previewId: '',
				previewContent: '',
				publishedMode: false,
				narrative: null as any,
				loading: true,
				publishing: false,
				confirming: false,
				pageAlive: true,
				stateMessage: '正在整理成稿…',
				errorMessage: '',
				narrativeFailure: '',
				regenerating: false,
				showPosterSheet: false,
				openPosterOnReady: false,
				profileCardVisible: false,
				profileCardLoading: false,
				profileCardApplying: false,
				profileCardError: '',
				profileCardExpectedRevision: 0,
				profileCardDraftId: '',
				profileCardSourceRevisionId: null as any,
				profileCardBaseProfileRevision: null as any,
				profileCardSelectedTags: [] as string[],
				profileCardExistingTagCount: -1,
				profileCardTagApplyMode: '',
				replaceExistingSelfIntro: false,
				profileCardRows: [] as any[],
				profileCardSummarizeKey: '',
				profileCardApplyKey: '',
				profileCardApplyPayload: null as any,
				profileCardApplyContext: null as any,
				profileCardApplyUncertain: false,
				profileCardApplyMessage: '',
				profileCardDraft: null as any,
				profileCardInterestTagsAbsent: false,
				profileCardSubmittedTags: [] as string[],
				posterIdentity: { nickname: '', ageText: '', cityText: '', verifiedBadge: '' }
			}
		},
		computed: {
			// 已有标签越多，本次可采用的数量越少；未读到已有标签数时按旧上限展示。
			profileCardTagLimitText(): string {
				const budget = profileCardTagBudget(this.profileCardExistingTagCount)
				if (budget <= 0) return '已有兴趣标签已达 ' + MAX_PERSONAL_TAGS + ' 个上限，请先精简后再采用'
				if (this.profileCardExistingTagCount < 0) return '逐个选择，最多 ' + MAX_PROFILE_CARD_ADOPT_TAGS + ' 个；已有标签默认保留'
				return '逐个选择，最多再选 ' + budget + ' 个；已有标签默认保留'
			},
			narrativeReady(): boolean {
				if (this.narrative == null) return false
				const status = String(this.narrative.status ?? '')
				return status == 'pending_confirmation' || status == 'confirmed' || status == 'published'
			},
			awaitingNarrativeConfirmation(): boolean {
				if (this.narrative == null) return false
				const status = String(this.narrative.status ?? '')
				// 历史 published 行没有逐条确认依据：先经「这份画像符合我」完成一次
				// 既有确认动作，转成 confirmed 后再开放资料卡；不放宽后端 confirmed 门槛。
				return status == 'pending_confirmation' || status == 'published'
			},
			canPrepareProfileCard(): boolean {
				if (this.subject != 'personal' || this.narrative == null) return false
				const status = String(this.narrative.status ?? '')
				// 只有确实经过用户确认的来源才能整理公开介绍；
				// 历史 published 行需先完成一次上面的确认动作。
				return status == 'confirmed'
			},
			narrativeStatusLabel(): string {
				if (this.awaitingNarrativeConfirmation) return '完整画像 · 待你确认'
				return '完整画像 · 已确认'
			},
			posterData(): MoxiangPosterData | null {
				if (this.narrative == null) return null
				const ei = this.narrative.emotional_insight != null ? this.narrative.emotional_insight : null
				return {
					personaTitle: String(this.narrative.persona_title ?? ''),
					personaTags: (this.narrative.persona_tags != null ? (this.narrative.persona_tags as any[]) : []).map((t: any): string => String(t)),
					attachmentStyle: String(ei != null ? (ei.attachment_style ?? '') : ''),
					attachmentSummary: String(ei != null ? (ei.attachment_summary ?? '') : ''),
					highlights: (ei != null && ei.highlights != null ? (ei.highlights as any[]) : []).map((h: any): string => String(h)),
					boundaries: (ei != null && ei.boundaries != null ? (ei.boundaries as any[]) : []).map((b: any): string => String(b)),
					masterMessage: String(ei != null ? (ei.master_message ?? '') : ''),
					nickname: String(this.posterIdentity.nickname ?? ''),
					ageText: String(this.posterIdentity.ageText ?? ''),
					cityText: String(this.posterIdentity.cityText ?? ''),
					verifiedBadge: String(this.posterIdentity.verifiedBadge ?? '')
				} as MoxiangPosterData
			}
		},
		onLoad(query: any) {
			const q = query || {}
			this.subject = String(q.subject ?? 'personal') == 'ideal_partner' ? 'ideal_partner' : 'personal'
			this.subjectLabel = this.subject == 'ideal_partner' ? '期待的长期关系' : '我的真实画像'
			this.draftId = String(q.draft_id ?? '')
			this.expectedRevision = Number(q.expected_revision ?? 0)
			this.previewId = String(q.preview_id ?? '')
			this.publishedMode = this.draftId == '' && this.previewId == ''
			if (q.openPoster == '1') {
				this.openPosterOnReady = true
			}
			if (this.publishedMode) this.loadNarrative()
			else this.loadPreview()
		},
		onUnload() {
			this.pageAlive = false
		},
		methods: {
			onOpenPoster() {
				this.showPosterSheet = true
			},
				buildProfileCardRows(fields: any): any[] {
					const rows: any[] = []
					const add = (key: string, label: string, questionId: number = 0) => {
						const source = fields != null && fields[key] != null ? fields[key] : {}
						const candidates = source.candidates != null && Array.isArray(source.candidates) ? source.candidates as any[] : []
						const value = source.value != null && String(source.value).trim() != '' ? String(source.value).trim() : (candidates.length > 0 ? candidates.join('、') : '')
						if (key == 'interest_tag_candidates') {
							// 标签为空是可解释状态：正文仍可采用，标签区如实说明，不硬填也不隐藏。
							this.profileCardInterestTagsAbsent = value == ''
						}
						if (value == '') return
						rows.push({ key: key, label: label, value: value, selected: true, questionId: questionId, tags: candidates.map((item: any): string => String(item).trim()).filter((item: string): boolean => item != '') })
					}
					add('self_intro', '自我介绍')
					add('interest_tag_candidates', '兴趣标签')
					return rows
				},
			toggleProfileCardField(key: string) {
				if (this.profileCardApplying || this.profileCardApplyPayload != null) return
				for (let index = 0; index < this.profileCardRows.length; index++) if (this.profileCardRows[index].key == key) this.profileCardRows[index].selected = !this.profileCardRows[index].selected
			},
			toggleProfileCardTag(tag: string) {
				if (this.profileCardApplying || this.profileCardApplyPayload != null) return
				const index = this.profileCardSelectedTags.indexOf(tag)
				if (index >= 0) this.profileCardSelectedTags.splice(index, 1)
				else if (this.profileCardSelectedTags.length < profileCardTagBudget(this.profileCardExistingTagCount)) this.profileCardSelectedTags.push(tag)
				else uni.showToast({ title: this.profileCardTagLimitText, icon: 'none' })
			},
			// 采用是合并写入，预算取决于已有标签数；读取失败记为 -1，由后端最终校验兜底。
			async refreshProfileCardTagBudget() {
				this.profileCardExistingTagCount = -1
				try {
					const res = await getOwnProfile()
					if (!this.pageAlive) return
					if (!res.success || res.data == null) return
					const profile: any = res.data.profile != null ? res.data.profile : res.data
					this.profileCardExistingTagCount = Array.isArray(profile.personal_tags) ? (profile.personal_tags as any[]).length : 0
				} catch (e) {
					this.profileCardExistingTagCount = -1
				}
			},
			toggleReplaceExistingSelfIntro() {
				if (this.profileCardApplying || this.profileCardApplyPayload != null) return
				this.replaceExistingSelfIntro = !this.replaceExistingSelfIntro
			},
			profileCardOptionalFields(): any {
				const fields: any = {}
				if (this.profileCardDraftId != '') fields.draft_id = this.profileCardDraftId
				if (this.profileCardSourceRevisionId != null) fields.source_revision_id = this.profileCardSourceRevisionId
				if (this.profileCardBaseProfileRevision != null) fields.base_profile_revision = this.profileCardBaseProfileRevision
				if (this.profileCardTagApplyMode != '') fields.tag_apply_mode = this.profileCardTagApplyMode
				return fields
			},
			resetProfileCardApply() {
				this.profileCardApplyKey = ''
				this.profileCardApplyPayload = null
				this.profileCardApplyContext = null
				this.profileCardApplyUncertain = false
			},
			closeProfileCard() {
				if (!this.profileCardApplying) this.profileCardVisible = false
			},
			async onPrepareProfileCard() {
				if (!this.canPrepareProfileCard || this.profileCardLoading || this.profileCardApplying) return
				this.profileCardVisible = true
				// 保存结果不明时重新打开原操作，不创建新草稿或丢弃幂等上下文。
				if (this.profileCardApplyPayload != null) return
				this.profileCardLoading = true
				this.profileCardError = ''
				this.profileCardApplyMessage = ''
				await this.refreshProfileCardTagBudget()
					this.profileCardRows = []
					this.profileCardSelectedTags = []
					this.profileCardInterestTagsAbsent = false
				if (this.profileCardSummarizeKey == '') this.profileCardSummarizeKey = createProfileCardIdempotencyKey('profile-card-summarize')
				try {
					const accepted = await summarizeProfileCard(false, this.profileCardSummarizeKey)
					if (!this.pageAlive) return
					if (!accepted.success || accepted.data == null) {
						if (Number(accepted.code) == 409) this.profileCardSummarizeKey = ''
						throw new Error(String(accepted.message ?? '资料卡整理暂时不可用'))
					}
					const taskId = String(accepted.data.task_id ?? '')
					const cardDraftId = String(accepted.data.draft_id ?? '')
					if (cardDraftId == '') throw new Error('服务版本不支持精确草稿，请稍后重试')
					if (taskId == '') throw new Error('资料卡整理未返回有效任务')
					const task = await waitForProfileCardTask(taskId, () => this.pageAlive)
					if (!this.pageAlive) return
					if (!task.done || task.status != 'succeeded') {
						if (task.done) this.profileCardSummarizeKey = ''
						throw new Error(task.error != '' ? task.error : '资料卡整理未完成')
					}
					const draft = await getProfileCardDraft(cardDraftId)
					if (!this.pageAlive) return
					if (!draft.success || draft.data == null) {
						if (Number(draft.code) == 404 || Number(draft.code) == 409) this.profileCardSummarizeKey = ''
						throw new Error(String(draft.message ?? '资料卡草稿读取失败'))
					}
					if (String(draft.data.draft_id ?? '') != cardDraftId || draft.data.expected_revision == null || draft.data.base_profile_revision == null || draft.data.source_revision_id == null) throw new Error('草稿版本信息不完整，请重新整理')
					if (draft.data.status != 'ready' && draft.data.status != 'partial') {
						this.profileCardSummarizeKey = ''
						throw new Error('草稿已采用或失效，请重新整理')
					}
					this.profileCardDraft = draft.data
					this.profileCardDraftId = String(draft.data.draft_id ?? '')
					this.profileCardExpectedRevision = Number(draft.data.expected_revision ?? 0)
					this.profileCardSourceRevisionId = draft.data.source_revision_id != null ? Number(draft.data.source_revision_id) : null
					this.profileCardBaseProfileRevision = Number(draft.data.base_profile_revision)
					this.profileCardTagApplyMode = 'merge'
					this.resetProfileCardApply()
					this.replaceExistingSelfIntro = false
					this.profileCardRows = this.buildProfileCardRows(draft.data.fields)
				} catch (error: any) {
					if (this.pageAlive) this.profileCardError = error?.message ?? String(error)
				} finally {
					if (this.pageAlive) this.profileCardLoading = false
				}
			},
			// 海报身份元素（脱敏白名单内）：昵称、年龄段、城市中文、认证徽章。
			// 任一接口失败都不阻塞海报——身份行留空即可。
			async loadPosterIdentity() {
				if (this.subject != 'personal') return
				try {
					const [meRes, profileRes] = await Promise.all([getMeProfile(), getOwnProfile()])
					let nickname = ''
					let verifiedBadge = ''
					if (meRes.success && meRes.data != null) {
						nickname = String(meRes.data.nickname ?? '')
						if (String(meRes.data.realNameStatus ?? '') == 'passed') {
							verifiedBadge = '实名认证'
						}
					}
					let ageText = ''
					let cityText = ''
					if (profileRes.success && profileRes.data != null) {
						const age = profileRes.data.age
						if (age != null && Number(age) > 0) ageText = Number(age) + '岁'
						cityText = String(profileRes.data.residence_display ?? '')
					}
					this.posterIdentity = { nickname: nickname, ageText: ageText, cityText: cityText, verifiedBadge: verifiedBadge }
				} catch (e) {
					// 静默：海报身份区留空，不阻塞主流程。
				}
			},
			attachmentStyleLabel(style: any): string {
				const s = String(style ?? '')
				if (s == 'secure') return '安全型依恋'
				if (s == 'anxious') return '焦虑型依恋'
				if (s == 'avoidant') return '回避型依恋'
				if (s == 'fearful') return '恐惧回避型依恋'
				return s != '' ? s : '情感气质'
			},
			navBack() {
				uni.navigateBack({ delta: 1, fail: () => { uni.switchTab({ url: '/pages/profile/profile' }) } })
			},
			async loadPreview() {
				this.loading = true
				this.stateMessage = '正在生成成稿预览…'
				this.errorMessage = ''
				try {
					let preview: ProfilePreviewRecord | null = null
					if (this.previewId != '') {
						preview = await getProfilePreview(this.previewId)
					} else if (this.draftId != '' && this.expectedRevision >= 0) {
						preview = await createProfilePreview(this.draftId, this.expectedRevision)
						this.previewId = preview.previewId
					} else {
						throw new Error('缺少草稿或预览参数')
					}
					if (preview.status == 'confirmed') {
						this.publishedMode = true
						await this.loadNarrative(false)
						return
					}
					if (preview.status != 'active') throw new Error('预览已经失效，请返回知遇重新整理')
					this.draftId = preview.draftId
					this.expectedRevision = preview.expectedRevision
					this.previewContent = preview.content
				} catch (e: any) {
					this.errorMessage = '加载预览失败：' + (e?.message ?? String(e))
				} finally {
					this.loading = false
				}
			},
			async loadNarrative(showLoading: boolean = true) {
				if (showLoading) this.loading = true
				this.stateMessage = '正在读取完整画像…'
				this.errorMessage = ''
				try {
					const res = await getPortraitNarrative(this.subject)
					if (!res.success || res.data == null) throw new Error(String(res.message ?? '画像读取失败'))
					this.narrative = res.data
					if (this.subject == 'personal') this.loadPosterIdentity()
					if (this.openPosterOnReady && this.narrativeReady) {
						this.showPosterSheet = true
						this.openPosterOnReady = false
					}
				} catch (e: any) {
					this.errorMessage = '读取完整画像失败：' + (e?.message ?? String(e))
				} finally {
					this.loading = false
				}
			},
			retryLoad() {
				if (this.publishedMode) this.loadNarrative()
				else this.loadPreview()
			},
			onConfirmPublish() {
				if (this.publishing) return
				uni.showModal({
					title: '确认发布',
					content: '将发布你现在看到的这一版，发布后仍可继续完善并留下新版本。',
					success: (res: any) => {
						if (res.confirm) this.publishPreview()
					}
				})
			},
			async publishPreview() {
				if (this.draftId == '' || this.previewId == '' || this.publishing) return
				this.publishing = true
				this.loading = true
				this.stateMessage = '正在发布这份成稿…'
				this.errorMessage = ''
				try {
					const res = await publishProfileDraft(this.draftId, this.expectedRevision, this.previewId)
					if (!res.success || res.data == null) throw new Error(String(res.message ?? '发布失败'))
					const synced = (res.data != null && res.data.synced_profile_fields != null) ? (res.data.synced_profile_fields as any[]) : []
					if (synced.length > 0) {
						setTimeout(() => {
							uni.showToast({ title: '知遇已同步补充基础资料，无需重复填写', icon: 'none', duration: 2500 })
						}, 2000)
					}
					const taskId = String(res.data.task_id ?? '')
					if (taskId != '') {
						const task = await pollTaskUntilTerminal(taskId, 40, () => this.pageAlive)
						if (!task.done || task.status != 'succeeded') throw new Error(task.error != '' ? task.error : '发布任务未完成')
					}
					// 发布任务完成后先切换为只读模式，后续叙事失败也不能诱导用户重复发布。
					this.publishedMode = true
					this.previewContent = ''
					this.stateMessage = '正在写下完整画像…'
					const narrativeTaskId = String(res.data.narrative_task_id ?? '')
					if (narrativeTaskId != '') {
						const narrativeTask = await pollTaskUntilTerminal(narrativeTaskId, 40, () => this.pageAlive)
						if (!narrativeTask.done || narrativeTask.status != 'succeeded') {
							this.narrative = { status: 'pending' }
							// 叙事失败必须可见：留错误详情而不是只说"仍在整理"。
							this.narrativeFailure = narrativeTask.error != '' ? narrativeTask.error : '叙事生成超时'
							uni.showToast({ title: '成稿已发布，完整画像整理失败', icon: 'none' })
							return
						}
					}
					await this.loadNarrative(false)
				} catch (e: any) {
					this.errorMessage = '发布失败：' + (e?.message ?? String(e))
				} finally {
					this.loading = false
					this.publishing = false
				}
			},
			onRequestApplyProfileCard() {
				if (this.profileCardApplying || this.profileCardRows.length == 0) return
				if (this.profileCardSelectedTags.length > profileCardTagBudget(this.profileCardExistingTagCount)) {
					uni.showToast({ title: this.profileCardTagLimitText, icon: 'none' })
					return
				}
				uni.showModal({
					title: this.profileCardApplyPayload != null ? '核对上次采用结果' : '确认写入公开资料',
					content: this.profileCardApplyPayload != null ? '将使用同一幂等键和原先确认的内容重试，不会重复写入，也不会改用当前编辑值。' : '确认采用后，只有你选中的字段会写入公开资料；可见对象仍受现有隐私设置约束。不会修改长期择偶标准、发送消息或公开访谈原文。已有自我介绍默认不替换，需先明确勾选替换。',
					success: (res: any) => {
						if (res.confirm && this.pageAlive) this.applyProfileCard()
					}
				})
			},
			async applyProfileCard() {
				if (!this.pageAlive || this.profileCardApplying || this.profileCardRows.length == 0) return
				if (this.profileCardApplyPayload == null) {
					if (this.profileCardDraftId == '' || this.profileCardSourceRevisionId == null || this.profileCardBaseProfileRevision == null) {
						this.profileCardError = '草稿版本信息不完整，请重新整理'
						return
					}
					const accepted: any = {}
					const personalTags: string[] = []
					const rejected: string[] = []
					for (let index = 0; index < this.profileCardRows.length; index++) {
						const row = this.profileCardRows[index]
						if (row.selected != true) { rejected.push(row.key); continue }
						if (row.key == 'self_intro') accepted.self_intro = row.value
						else if (row.key == 'interest_tag_candidates') {
							if (this.profileCardSelectedTags.length > profileCardTagBudget(this.profileCardExistingTagCount)) {
								uni.showToast({ title: this.profileCardTagLimitText, icon: 'none' })
								return
							}
							for (let tagIndex = 0; tagIndex < this.profileCardSelectedTags.length; tagIndex++) personalTags.push(this.profileCardSelectedTags[tagIndex])
						}
					}
					if (personalTags.length > 0) accepted.personal_tags = personalTags
					// 快照与表单数组分离：响应丢失后的同键重试必须保持原 body 摘要。
					this.profileCardApplyPayload = { expected_revision: this.profileCardExpectedRevision, accepted: accepted, rejected: rejected, replace_existing: { self_intro: this.replaceExistingSelfIntro } }
					this.profileCardApplyContext = this.profileCardOptionalFields()
					this.profileCardApplyKey = createProfileCardIdempotencyKey('profile-card-apply')
					this.profileCardSubmittedTags = personalTags.slice()
				}
				this.profileCardApplying = true
				try {
					const result = await applyProfileCardDraft(this.profileCardApplyPayload, this.profileCardApplyKey, this.profileCardApplyContext)
					if (!this.pageAlive) return
					if (!result.success || result.data == null) {
						if (isProfileCardVersionConflict(result)) {
							this.profileCardSummarizeKey = ''
							this.resetProfileCardApply()
							this.profileCardError = '资料已变化，请重新整理/刷新；请先核对当前资料，不会自动覆盖'
							uni.showToast({ title: '资料已变化，请重新整理/刷新', icon: 'none' })
							return
						}
						const code = Number(result.code)
						if ((code == 400 || code == 422) && !this.profileCardApplyUncertain) {
							this.resetProfileCardApply()
							this.profileCardApplyMessage = String(result.message ?? '内容校验未通过，请修改后再次确认')
						} else {
							this.profileCardApplyUncertain = true
							this.profileCardApplyMessage = '保存结果尚未确认，内容已锁定。请同键重试核对，或到我的资料核对结果；不会重复写入。'
						}
						uni.showToast({ title: String(result.message ?? '保存结果尚未确认，请重试核对'), icon: 'none' })
						return
					}
					const written = Array.isArray(result.data.written_fields) ? result.data.written_fields as any[] : []
					const skipped = Array.isArray(result.data.skipped_fields) ? result.data.skipped_fields as any[] : []
					// 采用成功后读取正式资料核对，不只依赖回执提示"成功"；
					// 核对不到时如实说明，不重复写入。
					let readBackIssue = ''
					try {
						const own = await getOwnProfile()
						if (this.pageAlive && own.success && own.data != null) {
							const profile: any = own.data.profile != null ? own.data.profile : own.data
							for (let index = 0; index < written.length; index++) {
								const key = String(written[index])
								if (key == 'self_intro' && String(profile.self_intro ?? '').trim() == '') readBackIssue = '自我介绍尚未核对到'
								if (key == 'personal_tags') {
									const serverTags = Array.isArray(profile.personal_tags) ? (profile.personal_tags as any[]).map((t: any): string => String(t)) : []
									for (let tagIndex = 0; tagIndex < this.profileCardSubmittedTags.length; tagIndex++) {
										if (serverTags.indexOf(this.profileCardSubmittedTags[tagIndex]) < 0) {
											readBackIssue = '所选标签尚未核对到'
											break
										}
									}
								}
							}
						} else if (this.pageAlive) {
							readBackIssue = '公开资料尚未核对到'
						}
					} catch (e) {
						readBackIssue = '公开资料尚未核对到'
					}
					this.profileCardDraft = result.data
					this.profileCardExpectedRevision = Number(result.data.expected_revision)
					this.profileCardSummarizeKey = ''
					this.resetProfileCardApply()
					this.profileCardExistingTagCount = -1
					this.profileCardApplyMessage = ''
					this.profileCardVisible = false
					if (readBackIssue != '') {
						uni.showToast({ title: '已提交；' + readBackIssue + '，请稍后在资料页确认', icon: 'none', duration: 3000 })
					} else {
						uni.showToast({ title: written.length > 0 ? '已按回执写入公开资料' : (skipped.length > 0 ? '已按回执跳过未选内容' : '公开资料未发生变化'), icon: 'none' })
					}
				} catch (error: any) {
					if (this.pageAlive) {
						this.profileCardApplyUncertain = true
						this.profileCardApplyMessage = '保存结果尚未确认，内容已锁定。请同键重试核对，或到我的资料核对结果；不会重复写入。'
						uni.showToast({ title: error?.message ?? '保存结果尚未确认，请重试核对', icon: 'none' })
					}
				} finally {
					this.profileCardApplying = false
				}
			},
			async onConfirmNarrative() {
				if (!this.awaitingNarrativeConfirmation || this.confirming) return
				this.confirming = true
				try {
					const res = await confirmPortraitNarrative(this.subject)
					if (!res.success || res.data == null) throw new Error(String(res.message ?? '确认失败'))
					// confirm 响应为精简结构；重新 GET，保留 dimensions/conclusion 等完整字段。
					await this.loadNarrative(false)
					uni.showToast({ title: '画像已确认', icon: 'none' })
				} catch (e: any) {
					uni.showToast({ title: '确认失败，请稍后重试', icon: 'none' })
				} finally {
					this.confirming = false
				}
			},
			async onRegenerateNarrative() {
				if (this.regenerating) return
				this.regenerating = true
				try {
					const res = await regeneratePortraitNarrative(this.subject)
					if (!res.success || res.data == null) throw new Error(String(res.message ?? '重新生成失败'))
					const taskId = String(res.data.task_id ?? '')
					if (taskId != '') {
						const task = await pollTaskUntilTerminal(taskId, 40, () => this.pageAlive)
						if (!task.done || task.status != 'succeeded') {
							this.narrativeFailure = task.error != '' ? task.error : '重新生成超时'
							uni.showToast({ title: '整理仍未完成，可稍后再试', icon: 'none' })
							return
						}
					}
					this.narrativeFailure = ''
					await this.loadNarrative(false)
				} catch (e: any) {
					this.narrativeFailure = e?.message ?? String(e)
					uni.showToast({ title: '重新生成失败，请稍后再试', icon: 'none' })
				} finally {
					this.regenerating = false
				}
			},
			onContinueChat() {
				uni.redirectTo({ url: '/pagesSub/profileExtra/my-portrait-master?subject=' + this.subject })
			},
			onOpenSearchSuggestions() {
				uni.navigateTo({ url: '/pagesSub/profileExtra/search?suggest=1' })
			},
			onBackToArchive() {
				uni.redirectTo({ url: '/pagesSub/profileExtra/my-portrait-archive' })
			}
		}
	}
</script>

<style>
	.mpr-page {
		min-height: 100vh;
		background: var(--canvas);
		color: #23201E;
		--canvas: #F3EFE8;
		--primary: #9C5B42;
		--primary-dark: #854B35;
		--warm-gold: #C29F68;
		--surface: #FFFFFF;
		--surface-warm: #FAF7F2;
		--line: #E8E2D8;
		--border-card: #D8D2C7;
		--ink: #23201E;
		--ink2: #6C665F;
		--muted: #9E978E;
		--text-invert: #FFFFFF;
	}

	.mpr-nav {
		position: sticky;
		top: 0;
		z-index: 100;
		box-sizing: content-box;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding-left: 10px;
		padding-bottom: 8px;
		background: var(--canvas);
		border-bottom: 1px solid rgba(232, 226, 216, 0.7);
	}

	.mpr-nav-side {
		z-index: 1;
		min-width: 44px;
		height: 40px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}

	.mpr-nav-back {
		justify-content: flex-start;
	}

	.mpr-nav-back-text {
		font-size: 28px;
		color: #23201E;
		padding: 0 8px;
		line-height: 1;
	}

	.mpr-nav-title {
		position: absolute;
		left: 0;
		right: 0;
		height: 40px;
		line-height: 40px;
		text-align: center;
		font-size: 17px;
		font-weight: 700;
		color: #23201E;
		pointer-events: none;
		z-index: 1;
	}

	.mpr-state {
		padding: 80px 24px 48px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.mpr-loading-dot {
		width: 14px;
		height: 14px;
		border-radius: 999px;
		background: #9C5B42;
		margin-bottom: 16px;
		box-shadow: 0 2px 8px rgba(156, 91, 66, 0.3);
	}

	.mpr-state-title {
		font-size: 18px;
		color: #23201E;
		font-weight: 700;
		text-align: center;
	}

	.mpr-state-copy {
		font-size: 13px;
		color: #6C665F;
		line-height: 1.65;
		text-align: center;
		margin-top: 10px;
		max-width: 320px;
	}

	.mpr-fail {
		color: #C04A2B;
	}

	.mpr-scroll {
		height: calc(100vh - 48px);
	}

	.mpr-body {
		padding: 16px 16px 48px;
	}

	.mpr-paper {
		background: #FFFFFF;
		padding: 24px 18px;
		border: 1px solid #E8E2D8;
		border-radius: 16px;
