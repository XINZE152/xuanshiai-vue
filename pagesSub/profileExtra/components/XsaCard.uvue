<template>
	<view class="xsa-card" :class="[variant, { clickable: clickable }]" @click="handleClick">
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaCard - 宣誓爱通用卡片组件
 * 遵循 DESIGN.md 设计规范
 */

interface Props {
	variant?: 'standard' | 'hero' | 'feature' | 'grid';
	clickable?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
	variant: 'standard',
	clickable: false
});

const emit = defineEmits<{
	click: []
}>();

const handleClick = () => {
	if (props.clickable) {
		emit('click');
	}
};
</script>

<style scoped>
/* 基础卡片 - 遵循 DESIGN.md */
.xsa-card {
	background: var(--surface);
	overflow: hidden;
	position: relative;
}

/* 标准卡片 */
.xsa-card.standard {
	border: 1px solid var(--line);
	border-radius: 12px;
	padding: 13px;
	box-shadow: 0 2px 8px rgba(17, 23, 24, 0.06);
}

/* Hero 卡片（人物照片） - 不对称圆角 */
.xsa-card.hero {
	border-radius: 8px 26px 8px 8px;
	padding: 0;
	background: var(--warm);
}

/* 功能卡片（深色背景） */
.xsa-card.feature {
	background: var(--navy);
	color: var(--paper);
	border-radius: 12px 28px 12px 12px;
	padding: 18px;
}

.xsa-card.feature::after {
	content: "";
	position: absolute;
	width: 110px;
	height: 110px;
	border: 1px solid rgba(56, 152, 141, 0.45);
	border-radius: 50%;
	right: -22px;
	bottom: -42px;
	pointer-events: none;
}

/* 网格卡片（广场模式） */
.xsa-card.grid {
	border: 1px solid var(--line);
	border-radius: 10px;
	padding: 0;
	overflow: hidden;
}

/* 可点击状态 */
.xsa-card.clickable {
	cursor: pointer;
	transition: 0.18s;
}

.xsa-card.clickable:hover {
	transform: translateY(-2px);
	box-shadow: 0 4px 16px rgba(17, 23, 24, 0.10);
}
</style>
