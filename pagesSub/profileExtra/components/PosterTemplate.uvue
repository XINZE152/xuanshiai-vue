.split-badge { display: flex; flex-direction: row; gap: 6rpx; align-items: center; margin-top: 16rpx; padding: 6rpx 14rpx; border-radius: 24rpx; color: #D8A0A8; background-color: #FFFFFF; font-size: 12rpx; }
.split-slogan { margin-top: auto; width: 40rpx; color: #D8A0A8; font-size: 18rpx; line-height: 1.8; text-align: center; }
