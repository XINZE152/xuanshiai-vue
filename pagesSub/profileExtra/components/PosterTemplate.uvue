.mint-column { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; padding: 12rpx 10rpx; color: #4A5453; background-color: #E8F1EF; font-size: 11rpx; line-height: 1.12; }
.mint-column text { width: 100%; }
.mint-column:first-child { border-radius: 16rpx 0 0 16rpx; }
.mint-column:last-child { border-radius: 0 16rpx 16rpx 0; }
.mint-column-title { margin-bottom: 4rpx; color: #73948E; font-size: 14rpx; font-weight: 700; }
.mint-footer { display: flex; flex-direction: row; align-items: center; gap: 10rpx; padding: 6rpx 16rpx 8rpx; color: #73948E; background-color: #FAFDFC; font-size: 9rpx; }
.mint-qr { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 6rpx; color: #73948E; background-color: #E8F1EF; font-size: 11rpx; }
.poster-template.compact .poster-thumb, .poster-template.preview .poster-thumb { font-family: 'Ma Shan Zheng', 'STKaiti', 'KaiTi', serif; }
.guest-guide, .split-guide, .mint-footer { font-family: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif; }
</style>
