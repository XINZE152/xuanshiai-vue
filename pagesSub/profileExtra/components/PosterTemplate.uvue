.split-fact-row { display: flex; flex-direction: row; gap: 4rpx; }
.split-fact-row text { flex: 1; min-width: 0; }
.split-heading { display: flex; flex-direction: row; align-items: center; gap: 6rpx; color: #C09098; font-size: 15rpx; font-weight: 700; }
.split-heading view { flex: 1; height: 2rpx; background-color: #E8D0D4; }
.split-wish { display: flex; flex-direction: column; gap: 4rpx; color: #555555; font-size: 10rpx; line-height: 1.15; }
.split-wish text { width: 100%; }
.split-qr { width: 76rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; align-self: flex-end; margin-top: auto; border-radius: 12rpx; border: 4rpx solid #F0B5C3; color: #D8A0A8; background-color: #FFFFFF; font-size: 12rpx; }
.split-guide { color: #B89488; font-size: 9rpx; line-height: 1.2; text-align: right; }
.poster-mint { display: flex; flex-direction: column; border-radius: 22rpx; background-color: #FAFDFC; }
.mint-photo-wrap { position: relative; width: 100%; height: 212rpx; overflow: hidden; border-radius: 20rpx 20rpx 0 0; }
.mint-photo { width: 100%; height: 100%; }
.mint-stamp { position: absolute; right: 16rpx; bottom: 14rpx; width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #4A5453; background-color: rgba(191,216,210,.82); font-size: 12rpx; }
.mint-name-row { display: flex; flex-direction: column; gap: 6rpx; padding: 14rpx 20rpx 10rpx; background-color: #FAFDFC; }
.mint-name { color: #2C3A38; font-size: 28rpx; font-weight: 700; }
.mint-tags { display: flex; flex-direction: row; gap: 10rpx; }
.mint-tags text { padding: 4rpx 14rpx; border-radius: 16rpx; color: #4A5453; background-color: rgba(191,216,210,.25); font-size: 11rpx; }
