<template>
	<view class="poster-template" :class="modeClass">
		<view class="poster-stage" :class="modeStageClass">
			<view class="style-card">
				<view class="card-frame" :class="borderClass" :style="cardStyle">
					<view v-if="styleId === 1" class="poster-thumb poster-guest">
						<view class="guest-photo-wrap">
							<image class="guest-photo" :src="profileImage" mode="aspectFill"></image>
							<view v-if="profile.realNameVerified" class="guest-stamp"><text>已实名</text></view>
						</view>
						<view class="guest-body">
							<view class="guest-pattern"></view>
							<text class="guest-name">{{ profile.name }}</text>
							<text class="guest-intro">{{ introDisplay }}</text>
							<view class="guest-divider"></view>
							<view class="guest-footer">
								<view class="guest-qr"><text>QR</text></view>
								<view class="guest-guide"><text class="guide-quote">“</text><text>长按识别二维码</text><text>了解Ta的资料</text></view>
							</view>
						</view>
					</view>

					<view v-else-if="styleId === 2" class="poster-thumb poster-journal">
						<view class="journal-top-gradient"></view>
						<view class="journal-info">
							<view class="journal-profile">
								<image class="journal-photo" :src="profileImage" mode="aspectFill"></image>
								<view v-if="profile.realNameVerified" class="journal-stamp"><text>已实名</text></view>
								<view class="journal-tags"><text>{{ profile.tags[0] }}</text><text>{{ profile.tags[1] }}</text></view>
								<text class="journal-name">{{ profile.name }}</text>
							</view>
							<view class="journal-facts">
								<text>出生：{{ birthDisplay }}</text>
								<text>身高：{{ profile.height }}</text>
								<text>职业：{{ profile.job }}</text>
								<text>家乡：{{ profile.hometown }}</text>
								<text>学历：{{ profile.education }}</text>
								<text>婚姻状况：{{ profile.marriage }}</text>
							</view>
						</view>
						<view class="journal-heading"><view></view><text>理想中的 Ta</text><view></view></view>
						<view class="journal-wish"><text>{{ expectation(0) }}</text><text>{{ expectation(1) }}</text><text>{{ expectation(2) }}</text><text>{{ expectation(3) }}</text><text>{{ expectation(4) }}</text></view>
						<view class="journal-footer"><view class="journal-qr"><text>QR</text></view><text>有幸相逢，期许同行</text></view>
					</view>

					<view v-else-if="styleId === 3" class="poster-thumb poster-split">
						<view class="split-aside">
							<image class="split-avatar" :src="profileImage" mode="aspectFill"></image>
							<text class="split-name">{{ profile.name }}</text>
							<view v-if="profile.realNameVerified" class="split-badge"><text>♥</text><text>已实名</text></view>
							<text class="split-slogan">愿有真诚，终遇相逢</text>
						</view>
						<view class="split-main">
							<view class="split-decor"></view>
							<text class="split-title">嘉宾介绍</text>
							<text class="split-copy">{{ profile.introduction }}</text>
							<view class="split-facts">
								<view class="split-fact-row"><text>年龄：{{ profile.age }}</text><text>身高：{{ profile.height }}</text></view>
								<view class="split-fact-row"><text>学历：{{ profile.education }}</text><text>职业：{{ profile.job }}</text></view>
								<view class="split-fact-row"><text>收入：{{ profile.income }}</text><text>居住地：{{ profile.city }}</text></view>
								<view class="split-fact-row"><text>婚姻状态：{{ profile.marriage }}</text><text>家乡：{{ profile.hometown }}</text></view>
							</view>
							<view class="split-heading"><view></view><text>择偶条件</text><view></view></view>
							<view class="split-wish"><text>· {{ expectation(0) }}</text><text>· {{ expectation(1) }}</text><text>· {{ expectation(2) }}</text><text>· {{ expectation(3) }}</text><text>· {{ expectation(4) }}</text></view>
							<view class="split-qr"><text>QR</text></view>
							<text class="split-guide">长按识别二维码，了解更多Ta的资料</text>
						</view>
					</view>

					<view v-else class="poster-thumb poster-mint">
						<view class="mint-photo-wrap">
							<image class="mint-photo" :src="profileImage" mode="aspectFill"></image>
							<view v-if="profile.realNameVerified" class="mint-stamp"><text>已实名</text></view>
						</view>
						<view class="mint-name-row"><text class="mint-name">{{ profile.name }}</text><view class="mint-tags"><text>{{ profile.tags[0] }}</text><text>{{ profile.tags[1] }}</text></view></view>
						<view class="mint-columns">
							<view class="mint-column"><text class="mint-column-title">个人概况</text><text>年龄：{{ profile.age }}</text><text>身高：{{ profile.height }}</text><text>学历：{{ profile.education }}</text><text>职业：{{ profile.job }}</text><text>现居：{{ profile.city }}</text><text>收入：{{ profile.income }}</text></view>
							<view class="mint-column"><text class="mint-column-title">期待的伴侣</text><text>{{ expectation(0) }}</text><text>{{ expectation(1) }}</text><text>{{ expectation(2) }}</text><text>{{ expectation(3) }}</text><text>{{ expectation(4) }}</text></view>
						</view>
						<view class="mint-footer"><view class="mint-qr"><text>QR</text></view><text>长按识别二维码</text><text>慢慢相遇，与温柔相逢</text></view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import type { PosterProfile } from '@/utils/poster-profile.uts'

interface Props {
	profile: PosterProfile
	styleId?: number
	mode?: 'compact' | 'preview'
	imageIndex?: number
}

const props = withDefaults(defineProps<Props>(), {
	styleId: 1,
	mode: 'compact',
	imageIndex: 0
})

const styleId = computed(() => props.styleId)
const modeClass = computed(() => props.mode == 'preview' ? 'preview' : 'compact')
const modeStageClass = computed(() => props.mode == 'preview' ? 'preview-stage' : 'compact-stage')
const cardStyle = computed(() => props.mode == 'preview' ? 'transform: scale(2.09756); transform-origin: top left;' : '')
const profile = computed(() => props.profile)
const profileImage = computed(() => {
	const photos = props.profile.photos != null && props.profile.photos.length > 0 ? props.profile.photos : [props.profile.avatar]
	let index = props.imageIndex
	if (index < 0) index = 0
	if (index >= photos.length) index = index % photos.length
	return photos[index]
})
const birthDisplay = computed(() => props.profile.birthYear != null && props.profile.birthYear != '未填写' ? props.profile.birthYear : props.profile.age)
const introDisplay = computed(() => {
	const intro = props.profile.introduction != null ? props.profile.introduction.trim() : ''
	if (intro.length >= 36 || intro == '未填写') return intro
	return '年龄' + props.profile.age + '，身高' + props.profile.height + '，' + props.profile.education + '，' + props.profile.marriage + '。' + intro
})
const borderClass = computed(() => {
	if (props.styleId == 2) return 'border-cocoa'
	if (props.styleId == 3) return 'border-rose'
	if (props.styleId == 4) return 'border-mint'
	return 'border-lilac'
})
const expectation = (index: number): string => {
	if (props.profile.expectations != null && index < props.profile.expectations.length && props.profile.expectations[index] != '') return props.profile.expectations[index]
	return '未填写'
}
</script>

<style scoped>
