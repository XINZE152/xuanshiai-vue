.poster-template.compact { width: 328rpx; height: 588rpx; }
.poster-template.preview { width: 688rpx; height: 1234rpx; }
.poster-stage { width: 100%; height: 100%; overflow: visible; }
.style-card { width: 328rpx; height: 588rpx; }
.poster-template.preview .style-card, .preview-stage .style-card { width: 688rpx; height: 1234rpx; overflow: visible; }
.card-frame { position: relative; width: 328rpx; height: 588rpx; padding: 4rpx; box-sizing: border-box; border-radius: 24rpx; }
.poster-template.preview .card-frame, .preview-stage .card-frame { transform: scale(2.09756); transform-origin: top left; }
.border-lilac { background-color: #C5BDD4; }
.border-cocoa { background-color: #D9BCB4; }
.border-rose { background-color: #E8B8C0; }
.border-mint { background-color: #BFD8D2; }
.poster-thumb { position: relative; width: 320rpx; height: 580rpx; overflow: hidden; box-sizing: border-box; }
.poster-guest { display: flex; flex-direction: column; border: 2rpx solid #CEC8DD; border-radius: 22rpx; background-color: #FBFAF7; }
.guest-photo-wrap { position: relative; width: 100%; height: 236rpx; flex-shrink: 0; overflow: hidden; border-radius: 20rpx 20rpx 0 0; }
.guest-photo { width: 100%; height: 100%; }
.guest-stamp { position: absolute; right: 16rpx; bottom: 14rpx; width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #FFFFFF; background-color: rgba(206,163,167,.86); font-size: 12rpx; font-weight: 700; }
.guest-body { position: relative; flex: 1; display: flex; flex-direction: column; gap: 12rpx; padding: 24rpx; background-color: #F6F3F5; }
.guest-pattern { position: absolute; right: 12rpx; top: 14rpx; width: 36rpx; height: 36rpx; border: 2rpx solid rgba(197,189,212,.46); border-radius: 50%; }
.guest-name { color: #4E3E34; font-size: 30rpx; font-weight: 600; }
.guest-intro { width: 100%; color: #6B5A4E; font-size: 16rpx; line-height: 1.45; }
.guest-divider { height: 1rpx; background-color: #C5BDD4; }
.guest-footer { display: flex; flex-direction: row; align-items: center; gap: 10rpx; margin-top: auto; }
.guest-qr { width: 84rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #CCCCCC; background-color: #F5F0F5; font-size: 14rpx; }
.guest-guide { display: flex; flex-direction: column; gap: 4rpx; color: #999999; font-size: 16rpx; }
.guide-quote { color: #D4C8E8; font-size: 40rpx; line-height: .6; }
.poster-journal { display: flex; flex-direction: column; gap: 16rpx; border-radius: 22rpx; padding: 36rpx 24rpx 16rpx; background: linear-gradient(180deg, #F6EDE5 0%, #F6EDE5 44%, #F9F2EC 72%, #FDF9F5 100%); }
.journal-top-gradient { position: absolute; left: 0; top: 0; width: 100%; height: 300rpx; background: radial-gradient(circle at 78% 10%, rgba(217,188,180,.18), transparent 28%); }
.journal-info { position: relative; display: flex; flex-direction: row; gap: 12rpx; }
.journal-profile { position: relative; width: 116rpx; height: 176rpx; flex-shrink: 0; }
.journal-photo { width: 104rpx; height: 112rpx; border-radius: 12rpx; }
.journal-stamp { position: absolute; left: 56rpx; top: 88rpx; width: 52rpx; height: 18rpx; display: flex; align-items: center; justify-content: center; color: #8B6A60; background-color: rgba(229,208,200,.82); font-size: 12rpx; }
.journal-tags { display: flex; flex-direction: row; gap: 8rpx; margin-top: 38rpx; }
.journal-tags text { padding: 3rpx 8rpx; border-radius: 12rpx; color: #8B7268; background: linear-gradient(135deg, #ECE0D8, #DFCCC0); font-size: 10rpx; }
.journal-name { position: absolute; left: 26rpx; top: 124rpx; color: #6B5048; font-size: 20rpx; font-weight: 700; }
.journal-facts { display: flex; flex-direction: column; gap: 4rpx; padding-top: 2rpx; color: #8B7268; font-size: 16rpx; line-height: 1.25; }
