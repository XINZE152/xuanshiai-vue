.journal-wish text { width: 100%; }
.journal-footer { display: flex; flex-direction: row; align-items: center; gap: 12rpx; margin-top: auto; color: #B89488; font-size: 18rpx; }
.journal-qr { width: 84rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; color: #D4958A; background-color: #FCF9F3; font-size: 14rpx; }
.poster-split { display: flex; flex-direction: row; border-radius: 22rpx; background-color: #FDFAF8; }
.split-aside { width: 39%; height: 580rpx; display: flex; flex-direction: column; align-items: center; padding: 20rpx 16rpx 28rpx; box-sizing: border-box; color: #D8A0A8; background-color: #F9E6E8; }
.split-avatar { width: 88rpx; height: 88rpx; border: 4rpx solid #FFFFFF; border-radius: 50%; }
