<template>
	<view class="unlock-page">
		<!-- 自定义导航栏 -->
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<text class="back-icon">&#8249;</text>
			</view>
			<text class="nav-title">解锁记录</text>
			<view class="nav-placeholder"></view>
		</view>

		<scroll-view class="scroller" scroll-y @scrolltolower="loadMore">
			<view v-if="loading && historyList.length == 0" class="state"><text>加载中...</text></view>
			<view v-else-if="loadError != ''" class="state">
				<text>{{ loadError }}</text>
				<text class="retry" @tap="load(true)">重试</text>
			</view>
			<view v-else-if="historyList.length == 0" class="state"><text>还没有解锁过资料</text></view>
			<view v-else class="match-list">
				<view
					class="match-card"
					v-for="item in historyList"
					:key="item.targetUserId"
					@click="openProfile(item)"
				>
					<view class="match-top">
						<view class="match-user">
							<XsaAvatar :name="item.name" :src="item.avatar" size="medium"></XsaAvatar>
							<view class="match-text">
								<text class="match-name">{{ item.name }}</text>
								<text class="match-meta">{{ item.age > 0 ? item.age + '岁' : '年龄未公开' }}</text>
								<text class="match-school">解锁于 {{ item.unlockedAt }}</text>
							</view>
						</view>
						<view class="match-score">
							<text class="match-percent">{{ item.pointsCost }}</text>
							<text class="match-score-label">积分</text>
						</view>
					</view>
				</view>
				<view v-if="loadingMore" class="state"><text>加载更多...</text></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import XsaAvatar from '@/components/XsaAvatar.uvue'
import { getPaperPlaneProfileUnlockHistory } from '@/api'

const historyList = ref([] as any[])
const page = ref(1)
const hasMore = ref(true)
const loading = ref(false)
const loadingMore = ref(false)
const loadError = ref('')

const mapItem = (row: any): any => {
	const avatar = row != null && row.avatar_thumb != null && '' + row.avatar_thumb != '' ? '' + row.avatar_thumb : (row != null && row.avatar != null ? '' + row.avatar : '')
	return {
		targetUserId: Number(row != null && row.target_user_id != null ? row.target_user_id : 0),
		name: row != null && row.nickname != null && '' + row.nickname != '' ? '' + row.nickname : '用户',
		avatar: avatar,
		age: row != null && row.age != null ? Number(row.age) : 0,
		unlockedAt: row != null && row.unlocked_at != null ? ('' + row.unlocked_at).slice(0, 10) : '',
		pointsCost: row != null && row.points_cost != null ? Number(row.points_cost) : 0
	}
}

const load = async (reset: boolean = false) => {
	if (loading.value || loadingMore.value) return
	if (reset) { page.value = 1; hasMore.value = true; historyList.value = [] }
	loadError.value = ''
	if (page.value == 1) loading.value = true
	else loadingMore.value = true
	try {
		const res = await getPaperPlaneProfileUnlockHistory(page.value, 20)
		if (res == null || !res.success || res.data == null) {
			loadError.value = res != null && res.message != null ? '' + res.message : '解锁记录加载失败'
			return
		}
		const rows = res.data.items != null && Array.isArray(res.data.items) ? res.data.items as any[] : []
		const mapped: any[] = []
		for (let i = 0; i < rows.length; i++) {
			const item = mapItem(rows[i])
			if (item.targetUserId > 0) mapped.push(item)
		}
		historyList.value = reset ? mapped : historyList.value.concat(mapped)
		hasMore.value = res.data.has_more == true
		if (hasMore.value) page.value += 1
	} catch (e) {
		loadError.value = '解锁记录加载失败，请重试'
	} finally {
		loading.value = false
		loadingMore.value = false
	}
}

const loadMore = () => {
	if (hasMore.value && !loading.value && !loadingMore.value) load(false)
}

const goBack = () => { uni.navigateBack({}) }
const openProfile = (item: any) => {
	if (item == null || item.targetUserId <= 0) return
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/detail?userId=' + item.targetUserId,
		fail: () => {
			uni.showToast({ title: '页面跳转失败', icon: 'none' })
		}
	})
}

onMounted(() => { load(true) })
</script>

<style scoped>
	/* 页面根 */
	.unlock-page {
		min-height: 100vh;
		background: #F0F0F3;
	}

	/* 导航栏 */
	.nav-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: var(--status-bar-height) 16px 0;
		height: calc(48px + var(--status-bar-height));
		background: #F0F0F3;
	}
	.nav-back {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.back-icon {
		font-size: 28px;
		color: #1A1A1A;
		font-weight: 300;
	}
	.nav-title {
		font-size: 17px;
		font-weight: 600;
		color: #1A1A1A;
	}
	.nav-placeholder {
		width: 40px;
	}

	/* 滚动区 */
	.scroller {
		height: calc(100vh - 48px - var(--status-bar-height));
	}

	/* 列表：与 emotion-lab 的 .match-list 一致 */
	.match-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 12px 16px 32px;
	}

	/* 卡片：与 emotion-lab 的 .match-list .match-card 完全一致 */
	.match-card {
		position: relative;
		background: #FFFFFF;
		border-radius: 16px;
		padding: 18px;
		gap: 12px;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		overflow: hidden;
	}

	/* 顶部行 */
	.match-top {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}

	.match-user {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 12px;
		min-width: 0;
		flex: 1;
	}

	.match-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
		flex: 1;
	}

	/* 原稿：姓名 16px/700 #1A1A1A；年龄城市 12px #8E8E93；学校 12px #B0B0B0 */
	.match-name {
		font-size: 16px;
		font-weight: 700;
		color: #1A1A1A;
	}

	.match-meta {
		font-size: 12px;
		color: #8E8E93;
	}

	.match-school {
		font-size: 12px;
		color: #B0B0B0;
	}

	/* 合拍度圆：与 emotion-lab 完全一致 */
	.match-score {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: #E8F5F0;
		gap: 2px;
	}

	.match-percent {
		font-size: 24px;
		font-weight: 700;
		line-height: 1;
		color: #7EC8A0;
	}

	.match-score-label {
		font-size: 11px;
		color: #9AA0A6;
	}

	/* 标签：与 emotion-lab 完全一致 */
	.match-tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 8px;
	}

	.match-tag {
		padding: 4px 10px;
		border-radius: 10px;
		background: #E0F5E8;
	}

	.match-tag-accent {
		background: #FFF0E0;
	}

	.match-tag-text {
		font-size: 11px;
		color: #5DAF85;
	}

	.match-tag-accent .match-tag-text {
		color: #E8A040;
		font-weight: 700;
	}

	/* 简介：与 emotion-lab 完全一致 */
	.match-bio {
		display: block;
		font-size: 12px;
		line-height: 1.5;
		color: #8E8E93;
	}

	.state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		padding: 80px 24px;
		font-size: 14px;
		color: #8E8E93;
	}

	.retry {
		color: #5F9F7A;
		font-weight: 600;
	}
</style>
