<template>
	<view class="page">
		<!-- 账号与安全 -->
		<view class="section-card">
			<text class="section-title">账号与安全</text>
			<!-- 编辑资料 -->
			<view class="item" @click="navigateTo('/pagesSub/userExtra/user/edit')">
				<view class="icon-wrap">
					<text class="icon-text ic ic-me ic-dongtai"></text>
				</view>
				<view class="text-wrap">
					<text class="label">编辑资料</text>
				</view>
				<view class="right-wrap">
					<text class="arrow">‹</text>
				</view>
			</view>
			<!-- 身份认证 -->
			<view class="item" @click="navigateTo('/pagesSub/profileExtra/certification')">
				<view class="icon-wrap icon-done">
					<text class="icon-text ic ic-sys ic-shiming"></text>
				</view>
				<view class="text-wrap">
					<text class="label">身份认证</text>
				</view>
				<view class="right-wrap">
					<view class="badge">
					<text class="badge-text">{{ certificationLabel }}</text>
					</view>
					<text class="arrow">‹</text>
				</view>
			</view>
			<!-- 手机号 -->
			<view class="item" @click="handleChangePhone">
				<view class="icon-wrap">
					<text class="icon-text ic ic-social ic-touxiang"></text>
				</view>
				<view class="text-wrap">
					<text class="label">手机号</text>
				</view>
				<view class="right-wrap">
					<text class="value">{{ phoneMasked != '' ? phoneMasked : '未绑定' }}</text>
					<text class="arrow">‹</text>
				</view>
			</view>
		</view>

		<!-- 隐私设置 -->
		<view class="section-card">
			<text class="section-title">隐私设置</text>
			<view class="item" @click="handlePrivacy('profile')">
				<view class="icon-wrap">
					<text class="icon-text ic ic-home ic-search"></text>
				</view>
				<view class="text-wrap">
					<text class="label">谁可以查看我的资料</text>
				</view>
				<view class="right-wrap">
					<text class="value">{{ profilePrivacyLabel }}</text>
					<text class="arrow">‹</text>
				</view>
			</view>
			<view class="item" @click="handlePrivacy('message')">
				<view class="icon-wrap">
					<text class="icon-text ic ic-home ic-hello"></text>
				</view>
				<view class="text-wrap">
					<text class="label">谁可以给我发消息</text>
				</view>
				<view class="right-wrap">
					<text class="value">{{ messagePrivacyLabel }}</text>
					<text class="arrow">‹</text>
				</view>
			</view>
			<view class="item">
				<view class="icon-wrap">
					<text class="icon-text ic ic-social ic-tongzhi"></text>
				</view>
				<view class="text-wrap">
					<text class="label">显示在线状态</text>
					<text class="desc">开启后，他人可以看到你的在线状态</text>
				</view>
				<switch :checked="showOnlineStatus" @change="onOnlineStatusChange" color="#7EC8A0" />
			</view>
			<view class="item">
				<view class="icon-wrap">
					<text class="icon-text ic ic-home ic-search"></text>
				</view>
				<view class="text-wrap">
					<text class="label">无痕浏览</text>
					<text class="desc">开启后浏览他人资料不会留下访客记录</text>
				</view>
				<switch :checked="anonymousBrowse" @change="onAnonymousBrowseChange" color="#7EC8A0" />
			</view>
		</view>

		<!-- 通知设置 -->
		<view class="section-card">
			<text class="section-title">通知设置</text>
			<view class="item">
				<view class="icon-wrap">
					<text class="icon-text ic ic-home ic-heart"></text>
				</view>
				<view class="text-wrap">
					<text class="label">接收点赞通知</text>
				</view>
				<switch :checked="receiveLike" @change="onLikeNotifyChange" color="#7EC8A0" />
			</view>
			<view class="item">
				<view class="icon-wrap">
					<text class="icon-text ic ic-social ic-pinglun"></text>
				</view>
				<view class="text-wrap">
					<text class="label">接收评论和回复通知</text>
				</view>
				<switch :checked="receiveComment" @change="onCommentNotifyChange" color="#7EC8A0" />
			</view>
			<view class="item">
				<view class="icon-wrap">
					<text class="icon-text ic ic-social ic-huati"></text>
				</view>
				<view class="text-wrap">
					<text class="label">接收关注通知</text>
				</view>
				<switch :checked="receiveFollow" @change="onFollowNotifyChange" color="#7EC8A0" />
			</view>
			<view class="item">
				<view class="icon-wrap">
					<text class="icon-text ic ic-social ic-tongzhi"></text>
				</view>
				<view class="text-wrap">
					<text class="label">接收新消息通知</text>
					<text class="desc">包括私信、系统通知等</text>
				</view>
				<switch :checked="receiveMessage" @change="onMessageNotifyChange" color="#7EC8A0" />
			</view>
			<view class="item">
				<view class="icon-wrap">
					<text class="icon-text ic ic-home ic-star"></text>
				</view>
				<view class="text-wrap">
					<text class="label">接收匹配通知</text>
					<text class="desc">有人申请认识你时通知</text>
				</view>
				<switch :checked="receiveMatch" @change="onMatchNotifyChange" color="#7EC8A0" />
			</view>
			<view class="item">
				<view class="icon-wrap">
					<text class="icon-text ic ic-social ic-huodong"></text>
				</view>
				<view class="text-wrap">
					<text class="label">接收活动通知</text>
					<text class="desc">平台活动、牵线活动等提醒</text>
				</view>
				<switch :checked="receiveActivity" @change="onActivityNotifyChange" color="#7EC8A0" />
			</view>
		</view>

		<!-- 社区安全 -->
		<view class="section-card">
			<text class="section-title">社区安全</text>
			<view class="item" @click="toggleSafety">
				<view class="icon-wrap">
					<text class="icon-text ic ic-sys ic-guanbi"></text>
				</view>
				<view class="text-wrap">
					<text class="label">已屏蔽用户</text>
				</view>
				<view class="right-wrap">
					<text class="value">{{ blockedSummary }}</text>
					<text class="arrow">‹</text>
				</view>
			</view>
			<view class="safety-list" v-if="safetyVisible">
				<text class="empty-safety" v-if="blockedLoading">加载中...</text>
				<text class="empty-safety text-accent" v-else-if="blockedError != ''" @click="loadBlockedUsers">{{ blockedError }}，点击重试</text>
				<view v-else>
					<view class="safety-row" v-for="u in blockedUsers" :key="u.id">
						<text class="label">{{ u.nickname || '已屏蔽用户' }}</text>
						<text class="text-accent" :class="{ disabled: isUnblocking(u.id) }" @click="unblock(u.id)">{{ isUnblocking(u.id) ? '处理中' : '解除屏蔽' }}</text>
					</view>
					<text class="empty-safety" v-if="blockedLoaded && !blockedLoading && blockedError == '' && blockedUsers.length == 0">暂无已屏蔽用户</text>
				</view>
			</view>
			<view class="item" @click="toggleRecords">
				<view class="icon-wrap">
					<text class="icon-text ic ic-social ic-pinglun"></text>
				</view>
				<view class="text-wrap">
					<text class="label">举报与申诉记录</text>
				</view>
				<view class="right-wrap">
					<text class="value">查看</text>
					<text class="arrow">‹</text>
				</view>
			</view>
			<view class="safety-list" v-if="recordsVisible">
				<text class="empty-safety" v-if="recordsLoading">加载中...</text>
				<text class="empty-safety text-accent" v-else-if="recordsError != ''" @click="loadReports">{{ recordsError }}，点击重试</text>
				<view v-else>
					<view class="report-row" v-for="r in reports" :key="r.id">
						<text class="report-text">{{ r.result || '处理中' }}</text>
						<text class="text-accent" v-if="r.can_appeal" @click="startAppeal(r.id)">申诉</text>
					</view>
					<view class="appeal-form" v-if="appealingReportId > 0">
						<textarea class="appeal-input" :value="appealReason" maxlength="1000" placeholder="请说明申诉理由" @input="onAppealReasonInput"></textarea>
						<view class="appeal-actions">
							<text class="text-muted" @click="cancelAppeal">取消</text>
							<text class="text-accent" :class="{ disabled: appealSubmitting }" @click="submitAppeal">{{ appealSubmitting ? '提交中' : '提交申诉' }}</text>
						</view>
					</view>
					<view class="report-row" v-for="a in appeals" :key="a.id">
						<text class="report-text">申诉：{{ appealStatusText(a.status) }}</text>
					</view>
					<text class="empty-safety" v-if="recordsLoaded && reports.length == 0 && appeals.length == 0">暂无举报或申诉记录</text>
				</view>
			</view>
		</view>

		<!-- 通用设置 -->
		<view class="section-card">
			<text class="section-title">通用设置</text>
			<view class="item" @click="clearCache">
				<view class="icon-wrap">
					<text class="icon-text ic ic-sys ic-guanbi"></text>
				</view>
				<view class="text-wrap">
					<text class="label">清除缓存</text>
				</view>
				<view class="right-wrap">
					<text class="value">{{ cacheSize }}</text>
					<text class="arrow">‹</text>
				</view>
			</view>
			<view class="item" @click="checkUpdate">
				<view class="icon-wrap">
					<text class="icon-text ic ic-sys ic-shuaxin"></text>
				</view>
				<view class="text-wrap">
					<text class="label">检查更新</text>
				</view>
				<view class="right-wrap">
					<text class="value">{{ appVersion }}</text>
					<text class="arrow">‹</text>
				</view>
			</view>
			<view class="item" @click="showAbout">
				<view class="icon-wrap">
					<text class="icon-text ic ic-sys ic-shiming"></text>
				</view>
				<view class="text-wrap">
					<text class="label">关于我们</text>
				</view>
				<view class="right-wrap">
					<text class="arrow">‹</text>
				</view>
			</view>
		</view>

		<!-- 帮助与反馈 -->
		<view class="section-card">
			<text class="section-title">帮助与反馈</text>
			<view class="item" @click="showHelp">
				<view class="icon-wrap">
					<text class="icon-text ic ic-me ic-bangzhu"></text>
				</view>
				<view class="text-wrap">
					<text class="label">帮助中心</text>
				</view>
				<view class="right-wrap">
					<text class="arrow">‹</text>
				</view>
			</view>
			<view class="item" @click="showFeedback">
				<view class="icon-wrap">
					<text class="icon-text ic ic-sys ic-fenxiang"></text>
				</view>
				<view class="text-wrap">
					<text class="label">意见反馈</text>
				</view>
				<view class="right-wrap">
					<text class="arrow">‹</text>
				</view>
			</view>
		</view>

		<!-- 退出登录 -->
		<view class="section-card">
			<view class="logout-btn" @click="handleLogout">
				<text class="logout-text">退出登录</text>
			</view>
		</view>

		<XsaModal
			:visible="phoneSheetVisible"
			title="换绑手机号"
			cancel-text="取消"
			confirm-text="确认换绑"
			:confirm-loading="phoneSubmitting"
			@close="closePhoneSheet"
			@confirm="submitPhoneChange"
		>
			<view class="phone-form">
				<input class="phone-input" :value="phoneNew" maxlength="11" type="number" placeholder="新手机号" @input="onPhoneNewInput" />
				<view class="phone-code-row">
					<input class="phone-input phone-code-input" :value="phoneNewCode" maxlength="6" type="number" placeholder="新号验证码" @input="onPhoneNewCodeInput" />
					<text class="phone-code-btn" @click="sendNewPhoneCode">{{ phoneSendingNew ? '发送中' : '发送验证码' }}</text>
				</view>
				<view class="phone-mode-row">
					<text class="phone-mode" :class="{ active: phoneProofMode == 'code' }" @click="phoneProofMode = 'code'">旧号验证码</text>
					<text class="phone-mode" :class="{ active: phoneProofMode == 'password' }" @click="phoneProofMode = 'password'">登录密码</text>
				</view>
				<view v-if="phoneProofMode == 'code'">
					<input class="phone-input" :value="phoneOld" maxlength="11" type="number" placeholder="旧手机号" @input="onPhoneOldInput" />
					<view class="phone-code-row">
						<input class="phone-input phone-code-input" :value="phoneOldCode" maxlength="6" type="number" placeholder="旧号验证码" @input="onPhoneOldCodeInput" />
						<text class="phone-code-btn" @click="sendOldPhoneCode">{{ phoneSendingOld ? '发送中' : '发送验证码' }}</text>
					</view>
				</view>
				<input v-else class="phone-input" :value="phonePassword" maxlength="64" password placeholder="登录密码" @input="onPhonePasswordInput" />
				<text v-if="phoneError != ''" class="phone-error">{{ phoneError }}</text>
				<text class="phone-note">换绑成功后，其他设备会退出登录。</text>
			</view>
		</XsaModal>

		<text class="footer-tip">宣誓爱 v1.0.0 — 为每一份真心寻找归宿</text>
	</view>
</template>

<script setup lang="uts">
import { logout, getMeProfile, getCommunityPrivacy, updateCommunityPrivacy, getBlockedUsers, unblockUser, getMyReports, getMyReportAppeals, createReportAppeal, sendSms, changePhone, createPhoneChangeKey } from '@/api'
import { ACCESS_TOKEN_KEY, REFRESH_TOKEN_KEY } from '@/api/config.uts'
import XsaModal from '@/components/XsaModal.uvue'

// 设置项状态
let showOnlineStatus = ref(true)
let anonymousBrowse = ref(false)
let receiveMessage = ref(true)
let receiveMatch = ref(true)
let receiveActivity = ref(false)
let receiveLike = ref(true)
let receiveComment = ref(true)
let receiveFollow = ref(true)
let phoneMasked = ref('')
let realnameStatus = ref(0)
let cacheSize = ref('计算中')

// 换绑手机号
let phoneSheetVisible = ref(false)
let phoneNew = ref('')
let phoneNewCode = ref('')
let phoneOld = ref('')
let phoneOldCode = ref('')
let phonePassword = ref('')
let phoneProofMode = ref('code')
let phoneSubmitting = ref(false)
let phoneSendingNew = ref(false)
let phoneSendingOld = ref(false)
let phoneError = ref('')

// 隐私设置选项：未从服务端读回前为 ''，避免默认宣称“所有人”。
let profilePrivacy = ref('')   // all | friends | only_me
let messagePrivacy = ref('')   // all | friends | certified
let privacyLoaded = ref(false)
let privacySaving = ref(false)

// 社区安全
let blockedUsers = ref([] as any[])
let reports = ref([] as any[])
let appeals = ref([] as any[])
let safetyVisible = ref(false)
let blockedLoading = ref(false)
let blockedLoaded = ref(false)
let blockedError = ref('')
let recordsVisible = ref(false)
let recordsLoading = ref(false)
let recordsLoaded = ref(false)
let recordsError = ref('')
let unblockingIds = ref([] as number[])
let appealingReportId = ref(0)
let appealReason = ref('')
let appealSubmitting = ref(false)

const profilePrivacyLabel = computed(() => {
	if (!privacyLoaded.value) return '读取中…'
	const map: Record<string, string> = { all: '所有人', friends: '已匹配的人', only_me: '仅自己' }
	return map[profilePrivacy.value] ?? '未知'
})
const messagePrivacyLabel = computed(() => {
	if (!privacyLoaded.value) return '读取中…'
	const map: Record<string, string> = { all: '所有人', friends: '已匹配的人', certified: '已实名用户' }
	return map[messagePrivacy.value] ?? '未知'
})
const certificationLabel = computed(() => {
	if (realnameStatus.value == 2) return '已认证'
	if (realnameStatus.value == 1 || realnameStatus.value == 4) return '审核中'
	if (realnameStatus.value == 3) return '未通过'
	if (realnameStatus.value == 5) return '已撤销'
	return '未认证'
})

const appVersion = computed(() => 'v1.0.0')

const refreshAccountStatus = async () => {
	const res = await getMeProfile()
	if (!res.success || res.data == null) return
	const data = res.data as any
	phoneMasked.value = data.phone_masked != null ? String(data.phone_masked) : ''
	realnameStatus.value = data.realname_status != null ? Number(data.realname_status) : 0
}

const refreshCacheSize = () => {
	try {
		const info = uni.getStorageInfoSync()
		const size = info.currentSize != null ? Number(info.currentSize) : 0
		cacheSize.value = size >= 1024 ? (size / 1024).toFixed(1) + 'MB' : size.toFixed(0) + 'KB'
	} catch (e) {
		cacheSize.value = '未知'
	}
}

const onAnonymousBrowseChange = async (event: any) => {
	const next = event != null && event.detail != null && event.detail.value === true
	const previous = anonymousBrowse.value
	anonymousBrowse.value = next
	await savePrivacy('anonymous_browse_enabled', next, () => { anonymousBrowse.value = previous })
}

const loadPrivacy = async () => {
	try {
		const res = await getCommunityPrivacy()
		if (!res.success || res.data == null) throw new Error('privacy unavailable')
		const p = res.data as any
		showOnlineStatus.value = p.hide_online_status != true
		anonymousBrowse.value = p.anonymous_browse_enabled === true
		receiveLike.value = p.notify_like != false
		receiveComment.value = p.notify_comment != false
		receiveFollow.value = p.notify_follow != false
		receiveMessage.value = p.notify_message != false
		receiveMatch.value = p.notify_match != false
		receiveActivity.value = p.notify_activity == true
		const profileValue = p.profile_visibility != null ? '' + p.profile_visibility : ''
		const messageValue = p.message_privacy != null ? '' + p.message_privacy : ''
		profilePrivacy.value = profileValue
		messagePrivacy.value = messageValue
		privacyLoaded.value = true
	} catch (e) {
		privacyLoaded.value = false
		uni.showToast({ title: '设置加载失败，请重试', icon: 'none' })
	}
}
onMounted(() => { loadPrivacy(); refreshAccountStatus(); refreshCacheSize() })

const savePrivacy = async (key: string, value: boolean, rollback: () => void) => {
	const payload: any = {}
	payload[key] = value
	try {
		const res = await updateCommunityPrivacy(payload)
		if (!res.success) {
			rollback()
			uni.showToast({ title: '保存失败，请重试', icon: 'none' })
		}
	} catch (e) {
		rollback()
		uni.showToast({ title: '保存失败，请重试', icon: 'none' })
	}
}

// 在线状态开关
const onOnlineStatusChange = (e: SwitchChangeEvent) => {
	const previous = showOnlineStatus.value
	showOnlineStatus.value = e.detail.value
	savePrivacy('hide_online_status', !e.detail.value, () => { showOnlineStatus.value = previous })
	uni.showToast({
		title: e.detail.value ? '已显示在线' : '已隐藏在线',
		icon: 'none'
	})
}

// 消息通知开关
const onMessageNotifyChange = (e: SwitchChangeEvent) => {
	const previous = receiveMessage.value
	receiveMessage.value = e.detail.value
	savePrivacy('notify_message', e.detail.value, () => { receiveMessage.value = previous })
}

// 匹配通知开关
const onMatchNotifyChange = (e: SwitchChangeEvent) => {
	const previous = receiveMatch.value
	receiveMatch.value = e.detail.value
	savePrivacy('notify_match', e.detail.value, () => { receiveMatch.value = previous })
}

// 活动通知开关
const onActivityNotifyChange = (e: SwitchChangeEvent) => {
	const previous = receiveActivity.value
	receiveActivity.value = e.detail.value
	savePrivacy('notify_activity', e.detail.value, () => { receiveActivity.value = previous })
}

const onLikeNotifyChange = (e: SwitchChangeEvent) => {
	const previous = receiveLike.value
	receiveLike.value = e.detail.value
	savePrivacy('notify_like', e.detail.value, () => { receiveLike.value = previous })
}

const onCommentNotifyChange = (e: SwitchChangeEvent) => {
	const previous = receiveComment.value
	receiveComment.value = e.detail.value
	savePrivacy('notify_comment', e.detail.value, () => { receiveComment.value = previous })
}

const onFollowNotifyChange = (e: SwitchChangeEvent) => {
	const previous = receiveFollow.value
	receiveFollow.value = e.detail.value
	savePrivacy('notify_follow', e.detail.value, () => { receiveFollow.value = previous })
}

const blockedSummary = computed(() => {
	if (blockedLoading.value) return '加载中'
	if (blockedError.value != '') return '加载失败'
	if (blockedLoaded.value) return '' + blockedUsers.value.length + ' 人'
	return '点击查看'
})

const toggleSafety = async () => {
	safetyVisible.value = !safetyVisible.value
	if (safetyVisible.value && !blockedLoaded.value) await loadBlockedUsers()
}

const loadBlockedUsers = async () => {
	blockedLoading.value = true
	blockedError.value = ''
	try {
		const res = await getBlockedUsers()
		if (!res.success) throw new Error('blocked users unavailable')
		blockedUsers.value = res.data as any[]
		blockedLoaded.value = true
	} catch (e) {
		blockedError.value = '加载失败'
		uni.showToast({ title: '黑名单加载失败', icon: 'none' })
	} finally {
		blockedLoading.value = false
	}
}

const isUnblocking = (id: number) => {
	const ids = unblockingIds.value as number[]
	for (let i = 0; i < ids.length; i++) {
		if (ids[i] == id) return true
	}
	return false
}

const unblock = async (id: number) => {
	if (isUnblocking(id)) return
	unblockingIds.value.push(id)
	try {
		const res = await unblockUser(id)
		if (res.success) {
			blockedUsers.value = (blockedUsers.value as any[]).filter((u: any) => u.id != id)
		} else {
			uni.showToast({ title: '解除失败，请重试', icon: 'none' })
		}
	} catch (e) {
		uni.showToast({ title: '解除失败，请重试', icon: 'none' })
	} finally {
		const ids = unblockingIds.value as number[]
		const index = ids.indexOf(id)
		if (index >= 0) ids.splice(index, 1)
	}
}

const toggleRecords = async () => {
	recordsVisible.value = !recordsVisible.value
	if (recordsVisible.value && !recordsLoaded.value) await loadReports()
}

const loadReports = async () => {
	recordsLoading.value = true
	recordsError.value = ''
	try {
		const res = await getMyReports()
		const appealRes = await getMyReportAppeals()
		if (!res.success || res.data == null || !appealRes.success || appealRes.data == null) {
			throw new Error('reports unavailable')
		}
		reports.value = (res.data.items != null ? res.data.items : []) as any[]
		appeals.value = (appealRes.data.items != null ? appealRes.data.items : []) as any[]
		recordsLoaded.value = true
	} catch (e) {
		recordsError.value = '加载失败'
		uni.showToast({ title: '记录加载失败', icon: 'none' })
	} finally {
		recordsLoading.value = false
	}
}

const appealStatusText = (status: number) => {
	if (status == 1) return '复核通过'
	if (status == 2) return '复核驳回'
	return '复核中'
}

const startAppeal = (reportId: number) => {
	appealingReportId.value = reportId
	appealReason.value = ''
}

const onAppealReasonInput = (e: any) => {
	appealReason.value = e.detail.value
}

const cancelAppeal = () => {
	appealingReportId.value = 0
	appealReason.value = ''
}

const submitAppeal = async () => {
	const reason = appealReason.value.trim()
	if (reason.length == 0) {
		uni.showToast({ title: '请填写申诉理由', icon: 'none' })
		return
	}
	if (appealSubmitting.value) return
	appealSubmitting.value = true
	try {
		const res = await createReportAppeal(appealingReportId.value, reason)
		if (res.success) {
			uni.showToast({ title: '申诉已提交', icon: 'success' })
			cancelAppeal()
			await loadReports()
		} else {
			uni.showToast({ title: '申诉提交失败，请重试', icon: 'none' })
		}
	} catch (e) {
		uni.showToast({ title: '申诉提交失败，请重试', icon: 'none' })
	} finally {
		appealSubmitting.value = false
	}
}

// 导航到指定页面
const navigateTo = (url: string) => {
	uni.navigateTo({ url })
}

// 隐私设置选择
const PRIVACY_OPTIONS: Record<string, string[]> = {
	profile: ['所有人', '已匹配的人', '仅自己'],
	message: ['所有人', '已匹配的人', '已实名用户']
}
const PRIVACY_VALUES: Record<string, string[]> = {
	profile: ['all', 'friends', 'only_me'],
	message: ['all', 'friends', 'certified']
}

// 资料可见性 / 消息权限：真实读写 GET/PUT /users/me/privacy，不再提示"接口暂未提供"。
const handlePrivacy = (type: 'profile' | 'message') => {
	if (!privacyLoaded.value) {
		uni.showToast({ title: '正在读取当前设置，请稍后重试', icon: 'none' })
		return
	}
	if (privacySaving.value) return
	const options = PRIVACY_OPTIONS[type]
	const values = PRIVACY_VALUES[type]
	const current = type === 'profile' ? profilePrivacy.value : messagePrivacy.value
	uni.showActionSheet({
		itemList: options,
		success: (res: any) => {
			const index = Number(res.tapIndex)
			if (isNaN(index) || index < 0 || index >= values.length) return
			const next = values[index]
			if (next === current) return
			applyPrivacyChoice(type, next, current)
		},
		fail: () => {}
	})
}

const applyPrivacyChoice = async (type: 'profile' | 'message', next: string, previous: string) => {
	privacySaving.value = true
	if (type === 'profile') profilePrivacy.value = next
	else messagePrivacy.value = next
	const payload: any = {}
	payload[type === 'profile' ? 'profile_visibility' : 'message_privacy'] = next
	try {
		const res = await updateCommunityPrivacy(payload)
		if (!res.success || res.data == null) throw new Error('privacy update rejected')
		// 以服务端返回值为准回填，避免出现"显示已修改但实际未生效"。
		const saved = res.data as any
		const savedProfile = saved.profile_visibility != null ? '' + saved.profile_visibility : ''
		const savedMessage = saved.message_privacy != null ? '' + saved.message_privacy : ''
		if (savedProfile != '') profilePrivacy.value = savedProfile
		if (savedMessage != '') messagePrivacy.value = savedMessage
		uni.showToast({ title: '已保存', icon: 'none' })
	} catch (e) {
		if (type === 'profile') profilePrivacy.value = previous
		else messagePrivacy.value = previous
		uni.showToast({ title: '保存失败，已保留原设置', icon: 'none' })
	} finally {
		privacySaving.value = false
	}
}


// 修改手机号
const resetPhoneForm = () => {
	phoneNew.value = ''
	phoneNewCode.value = ''
	phoneOld.value = ''
	phoneOldCode.value = ''
	phonePassword.value = ''
	phoneProofMode.value = 'code'
	phoneError.value = ''
	phoneSendingNew.value = false
	phoneSendingOld.value = false
}
const openPhoneSheet = () => {
	resetPhoneForm()
	phoneSheetVisible.value = true
}
const closePhoneSheet = () => {
	if (phoneSubmitting.value) return
	phoneSheetVisible.value = false
}
const onPhoneNewInput = (event: any) => { phoneNew.value = event != null && event.detail != null ? '' + event.detail.value : '' }
const onPhoneNewCodeInput = (event: any) => { phoneNewCode.value = event != null && event.detail != null ? '' + event.detail.value : '' }
const onPhoneOldInput = (event: any) => { phoneOld.value = event != null && event.detail != null ? '' + event.detail.value : '' }
const onPhoneOldCodeInput = (event: any) => { phoneOldCode.value = event != null && event.detail != null ? '' + event.detail.value : '' }
const onPhonePasswordInput = (event: any) => { phonePassword.value = event != null && event.detail != null ? '' + event.detail.value : '' }
const validPhone = (value: string): boolean => /^1[3-9]\d{9}$/.test(value)
const validCode = (value: string): boolean => /^\d{6}$/.test(value)

const sendNewPhoneCode = async () => {
	if (phoneSendingNew.value) return
	phoneError.value = ''
	if (!validPhone(phoneNew.value)) {
		phoneError.value = '请输入正确的 11 位新手机号'
		return
	}
	phoneSendingNew.value = true
	const res = await sendSms(phoneNew.value, 'change_phone_new')
	if (res != null && res.success) {
		uni.showToast({ title: '验证码已发送', icon: 'none' })
	} else {
		phoneError.value = res != null && res.message != null ? '' + res.message : '验证码发送失败，请稍后重试'
	}
	phoneSendingNew.value = false
}

const sendOldPhoneCode = async () => {
	if (phoneSendingOld.value) return
	phoneError.value = ''
	if (!validPhone(phoneOld.value)) {
		phoneError.value = '请输入正确的 11 位旧手机号'
		return
	}
	phoneSendingOld.value = true
	const res = await sendSms(phoneOld.value, 'change_phone_old')
	if (res != null && res.success) {
		uni.showToast({ title: '验证码已发送', icon: 'none' })
	} else {
		phoneError.value = res != null && res.message != null ? '' + res.message : '验证码发送失败，请稍后重试'
	}
	phoneSendingOld.value = false
}

const submitPhoneChange = async () => {
	if (phoneSubmitting.value) return
	phoneError.value = ''
	if (!validPhone(phoneNew.value)) {
		phoneError.value = '请输入正确的 11 位新手机号'
		return
	}
	if (!validCode(phoneNewCode.value)) {
		phoneError.value = '请输入 6 位新手机号验证码'
		return
	}
	if (phoneProofMode.value == 'code') {
		if (!validPhone(phoneOld.value)) {
			phoneError.value = '请输入正确的 11 位旧手机号'
			return
		}
		if (!validCode(phoneOldCode.value)) {
			phoneError.value = '请输入 6 位旧手机号验证码'
			return
		}
	} else if (phonePassword.value == '') {
		phoneError.value = '请输入登录密码'
		return
	}
	phoneSubmitting.value = true
	const res = await changePhone(
		phoneNew.value,
		phoneNewCode.value,
		phoneProofMode.value == 'code' ? phoneOldCode.value : '',
		phoneProofMode.value == 'password' ? phonePassword.value : '',
		createPhoneChangeKey()
	)
	if (res != null && res.success) {
		phoneSubmitting.value = false
		phoneSheetVisible.value = false
		uni.showToast({ title: '手机号已更新', icon: 'success' })
		refreshAccountStatus()
		return
	}
	const code = res != null ? Number(res.code) : 0
	if (code == 409) phoneError.value = '验证码或密码错误，或新手机号已被占用'
	else if (code == 428) phoneError.value = '敏感操作需要二次确认，请重试'
	else phoneError.value = res != null && res.message != null ? '' + res.message : '换绑失败，请稍后重试'
	phoneSubmitting.value = false
}

const handleChangePhone = () => {
	openPhoneSheet()
}

// 清除缓存
const clearCache = () => {
	uni.showModal({
		title: '提示',
		content: '确定要清除缓存吗？',
		success: (res) => {
			if (res.confirm) {
				try {
					const info = uni.getStorageInfoSync()
					const keys = info.keys != null ? info.keys as string[] : []
					for (let i = 0; i < keys.length; i++) {
						const keepKeys = [ACCESS_TOKEN_KEY, REFRESH_TOKEN_KEY, 'xsa_login_agreed', 'xsa_welcome_agreed', 'xsa_user_id']
						if (keepKeys.indexOf(keys[i]) < 0) uni.removeStorageSync(keys[i])
					}
					cacheSize.value = '0KB'
					uni.showToast({ title: '清除成功', icon: 'success' })
				} catch (e) {
					uni.showToast({ title: '清除失败，请重试', icon: 'none' })
				}
			}
		}
	})
}

// 检查更新
const checkUpdate = () => {
	uni.showToast({ title: '版本检查接口暂未提供', icon: 'none' })
}

// 关于我们
const showAbout = () => {
	uni.navigateTo({ url: '/pagesSub/about/about' })
}

// 帮助中心
const showHelp = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/help', fail: () => { uni.showToast({ title: '客服与帮助打开失败，请重试', icon: 'none' }) } })
}

// 意见反馈
const showFeedback = () => {
	uni.navigateTo({ url: '/pagesSub/profileExtra/help?open=feedback', fail: () => { uni.showToast({ title: '意见反馈打开失败，请重试', icon: 'none' }) } })
}

// 退出登录
const handleLogout = () => {
	uni.showModal({
		title: '提示',
		content: '确定要退出登录吗？',
		success: async (res) => {
			if (res.confirm) {
				await logout()
				uni.reLaunch({ url: '/pages/auth/login' })
			}
		}
	})
}
</script>

