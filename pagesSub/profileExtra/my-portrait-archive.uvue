<template>
	<view class="mpa-page">
		<view class="mpa-nav" :style="{ paddingTop: navPadTop + 'px', paddingRight: (menuButtonSpacing + 8) + 'px' }">
			<view class="mpa-nav-side mpa-nav-back" @tap="navBack"><text class="mpa-nav-back-text">‹</text></view>
			<text class="mpa-nav-title" :style="{ top: navPadTop + 'px' }">我的画像档案</text>
			<view class="mpa-nav-side"></view>
		</view>
		<view v-if="loading" class="mpa-loading"><view class="mpa-loading-dot"></view><text class="mpa-loading-text">正在读取知遇状态…</text></view>
		<view v-else-if="errorMessage" class="mpa-error">
			<text class="mpa-error-text">{{ errorMessage }}</text>
			<view class="mpa-error-btn" @tap="loadArchive"><text class="mpa-error-btn-text">重试</text></view>
		</view>
		<view v-else class="mpa-body">
			<MoxiangContinuousPanel v-if="continuousState != null && continuousState.consent_granted" :state="continuousState" @open="openContinuousPortrait" />
			<view v-else class="mpa-consent-state">
				<text class="mpa-consent-title">知遇墨相</text>
				<text class="mpa-consent-copy">授权后，知遇会在一次自然对话中分别整理你的真实画像与期待的长期关系。整份确认前不会成为正式画像。</text>
				<view class="mpa-btn" @tap="goMaster('personal')"><text class="mpa-btn-text">进入授权与对话</text></view>
			</view>
			<view v-if="continuousState != null && continuousState.consent_granted" class="mpa-actions">
				<view class="mpa-btn" @tap="goMaster('personal')"><text class="mpa-btn-text">继续自然聊天</text></view>
				<view class="mpa-btn mpa-btn-ghost" @tap="openMemorySheet"><text class="mpa-btn-ghost-text">数据管理</text></view>
			</view>
			<view v-if="archive.personal.currentRevision || archive.personal.history.length > 0" class="mpa-legacy-entry" @tap="goLegacy('personal')"><text class="mpa-legacy-text">查看旧版画像记录</text><text class="mpa-legacy-arrow">›</text></view>
			<view v-if="archive.idealPartner.currentRevision || archive.idealPartner.history.length > 0" class="mpa-legacy-entry" @tap="goLegacy('ideal_partner')"><text class="mpa-legacy-text">查看旧版伴侣画像记录</text><text class="mpa-legacy-arrow">›</text></view>
		</view>
		<MemoryManagementSheet :visible="memorySheetVisible" @close="closeMemorySheet" />
	</view>
</template>

<script lang="uts">
import { getMoxiangArchive, getContinuousMoxiangState, buildContinuousPortrait, type MoxiangArchiveResponse, type ArchiveSubject, type ContinuousMoxiangState, type ContinuousSubjectState } from '@/api/ai-moxiang.uts'
import MemoryManagementSheet from '@/components/MemoryManagementSheet.uvue'
import MoxiangContinuousPanel from '@/components/moxiang/MoxiangContinuousPanel.uvue'

type PendingContinuousBuild = { refresh: boolean, key: string }

function emptySubject(subject: 'personal' | 'ideal_partner'): ArchiveSubject {
	return { subject, consentActive: false, currentRevision: null, activeDraft: null, summaryExcerpt: null, history: [], preview: null }
}
function emptyArchive(): MoxiangArchiveResponse {
	return { personal: emptySubject('personal'), idealPartner: emptySubject('ideal_partner'), fallbackAvailable: false }
}
function errorCode(error: any): number {
	return Number(error?.code ?? error?.statusCode ?? error?.status ?? 0)
}
function buildKey(subject: string): string {
	return 'archive-' + subject + '-' + Date.now().toString(36)
}
const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const menuButtonInfo = uni.getMenuButtonBoundingClientRect()
const navPadTop = menuButtonInfo != null && menuButtonInfo.top > statusBarHeight ? menuButtonInfo.top : statusBarHeight + 6
const menuButtonSpacing = menuButtonInfo != null ? (systemInfo.windowWidth - menuButtonInfo.left) : 8

export default {
	components: { MemoryManagementSheet, MoxiangContinuousPanel },
	data() { return {
		navPadTop, menuButtonSpacing, loading: true, errorMessage: '', memorySheetVisible: false,
		archive: emptyArchive() as MoxiangArchiveResponse,
		continuousState: null as ContinuousMoxiangState | null,
		archiveRequestSeq: 0, archiveLifecycleSeq: 0, archivePageAlive: true, archivePageVisible: true, pollTimer: null as any,
		continuousPendingBuilds: new Map<string, PendingContinuousBuild>(), continuousActionBusy: new Set<string>()
	} },
	onLoad() { this.archivePageAlive = true; this.archivePageVisible = true; this.loadArchive() },
	onShow() { this.archivePageVisible = true; if (!this.loading) this.loadArchive() },
	onHide() { this.archivePageVisible = false; this.archiveLifecycleSeq += 1; this.archiveRequestSeq += 1; this.continuousActionBusy.clear(); this.loading = false; this.stopPolling() },
	onUnload() { this.archivePageAlive = false; this.archivePageVisible = false; this.clearContinuousPrivateCache() },
	methods: {
		clearContinuousPrivateCache() {
			this.archiveRequestSeq += 1
			this.archiveLifecycleSeq += 1
			this.loading = false
			this.stopPolling()
			this.continuousPendingBuilds.clear()
			this.continuousActionBusy.clear()
			this.continuousState = null
			this.archive = emptyArchive()
			try { uni.removeStorageSync('moxiang-continuous-state') } catch (e) {}
		},
		stopPolling() { if (this.pollTimer != null) { clearTimeout(this.pollTimer); this.pollTimer = null } },
		schedulePolling() {
			this.stopPolling()
			if (!this.archivePageAlive || !this.archivePageVisible || this.continuousState == null || !this.continuousState.consent_granted) return
			this.pollTimer = setTimeout(() => { this.pollTimer = null; this.refreshContinuousState() }, 5000)
		},
		async refreshContinuousState(): Promise<boolean> {
			const requestSeq = ++this.archiveRequestSeq
			try {
				const state = await getContinuousMoxiangState()
				if (!this.archivePageAlive || !this.archivePageVisible || requestSeq != this.archiveRequestSeq) return false
				if (!state.consent_granted) { this.clearContinuousPrivateCache(); return true }
				this.continuousState = state
				this.schedulePolling()
				return true
			} catch (e: any) {
				if (!this.archivePageAlive || !this.archivePageVisible || requestSeq != this.archiveRequestSeq) return false
				const code = errorCode(e)
				if (code == 401 || code == 403) { this.clearContinuousPrivateCache(); this.errorMessage = '授权状态已变化，请重新进入知遇'; return false }
				this.errorMessage = '读取知遇状态失败：' + (e?.message ?? String(e)); return false
			}
		},
		async loadArchive() {
			this.loading = true; this.errorMessage = ''; this.stopPolling()
			const requestSeq = ++this.archiveRequestSeq
			try {
				const results = await Promise.all([getMoxiangArchive(), getContinuousMoxiangState()])
				if (!this.archivePageAlive || !this.archivePageVisible || requestSeq != this.archiveRequestSeq) return
				const state = results[1]
				this.archive = results[0]
				if (!state.consent_granted) { this.clearContinuousPrivateCache(); this.loading = false; return }
				this.continuousState = state; this.schedulePolling()
			} catch (e: any) {
				if (!this.archivePageAlive || !this.archivePageVisible || requestSeq != this.archiveRequestSeq) return
				const code = errorCode(e)
				if (code == 401 || code == 403) { this.clearContinuousPrivateCache(); this.errorMessage = '授权状态已变化，请重新进入知遇' } else this.errorMessage = '读取档案失败：' + (e?.message ?? String(e))
			} finally { if (requestSeq == this.archiveRequestSeq && this.archivePageAlive && this.archivePageVisible) this.loading = false }
		},
		async openContinuousPortrait(subject: string) {
			if ((subject != 'personal' && subject != 'ideal_partner') || this.continuousActionBusy.has(subject)) return
			this.continuousActionBusy.add(subject)
			const lifecycleSeq = this.archiveLifecycleSeq
			try {
				if (!this.archivePageAlive || !this.archivePageVisible || this.continuousState == null || !this.continuousState.consent_granted) return
				let item = subject == 'personal' ? this.continuousState.personal : this.continuousState.ideal_partner
				let pending = this.continuousPendingBuilds.get(subject)
				let refresh = false
				if (pending == null && item.status != 'failed' && (item.status == 'stale' || item.has_updates)) {
					const choice: any = await new Promise((resolve) => uni.showModal({
						title: item.status == 'stale' ? '这份稿件的版本已变化' : '有新的对话补充',
						content: '合并后会生成新的待确认稿，需要重新阅读。不会自动改变已确认画像。',
						confirmText: '合并新信息', cancelText: '先看原稿', success: resolve, fail: () => resolve({ confirm: false })
					}))
					if (!this.archivePageAlive || !this.archivePageVisible || lifecycleSeq != this.archiveLifecycleSeq || this.continuousState == null || !this.continuousState.consent_granted) return
					refresh = choice.confirm === true
					if (!refresh) { this.openContinuousResult(subject, item, item.status == 'confirmed'); return }
				}
				if (!this.archivePageAlive || !this.archivePageVisible || this.continuousState == null || !this.continuousState.consent_granted) return
				if (pending != null || refresh || item.status == 'failed') {
					if (pending == null) {
						pending = { refresh: item.status == 'failed' ? false : refresh, key: buildKey(subject) }
						this.continuousPendingBuilds.set(subject, pending)
					}
					const updated = await buildContinuousPortrait(subject, pending.refresh, pending.key)
					if (!this.archivePageAlive || !this.archivePageVisible || lifecycleSeq != this.archiveLifecycleSeq || this.continuousPendingBuilds.get(subject) !== pending) return
					this.continuousPendingBuilds.delete(subject)
					if (!updated.consent_granted) { this.clearContinuousPrivateCache(); return }
					this.archiveRequestSeq += 1
					this.loading = false
					this.continuousState = updated
					item = subject == 'personal' ? updated.personal : updated.ideal_partner
					this.openContinuousResult(subject, item, item.status == 'confirmed')
					return
				}
				if (item.status == 'collecting') { this.goMaster(subject); return }
				if (item.status == 'generating') { this.openContinuousResult(subject, item, false); return }
				this.openContinuousResult(subject, item, item.status == 'confirmed')
			} catch (e: any) {
				if (lifecycleSeq != this.archiveLifecycleSeq || !this.archivePageAlive || !this.archivePageVisible) return
				const code = errorCode(e)
				if ([400, 401, 403, 404, 409, 422].includes(code)) this.continuousPendingBuilds.delete(subject)
				if (code == 401 || code == 403) { this.clearContinuousPrivateCache(); this.errorMessage = '授权状态已变化，请重新进入知遇'; return }
				if (this.archivePageAlive && this.archivePageVisible) this.errorMessage = '生成成稿失败：' + (e?.message ?? String(e))
			} finally { if (lifecycleSeq == this.archiveLifecycleSeq) this.continuousActionBusy.delete(subject) }
		},
		openContinuousResult(subject: string, item: ContinuousSubjectState, published: boolean) {
			if (!this.archivePageAlive || !this.archivePageVisible || this.continuousState == null || !this.continuousState.consent_granted) return
			let url = '/pagesSub/profileExtra/my-portrait-result?flow_version=continuous_v2&subject=' + subject
			if (item.draft_id != null) url += '&draft_id=' + encodeURIComponent(item.draft_id)
			if (item.expected_revision != null) url += '&expected_revision=' + item.expected_revision
			if (item.preview_id != null) url += '&preview_id=' + encodeURIComponent(item.preview_id)
			if (published) url += '&published=1'
			uni.navigateTo({ url })
		},
		goMaster(subject: string) { uni.redirectTo({ url: '/pagesSub/profileExtra/my-portrait-master?flow_version=continuous_v2&subject=' + subject }) },
		goLegacy(subject: string) { uni.navigateTo({ url: '/pagesSub/profileExtra/my-portrait-result?subject=' + subject }) },
		openMemorySheet() { this.memorySheetVisible = true },
		async closeMemorySheet() {
			this.memorySheetVisible = false
			// 管理页可能删除数据或撤权：先失效旧读写，再从服务端重新核对。
			this.clearContinuousPrivateCache()
			await this.loadArchive()
		},
		navBack() { uni.navigateBack({ delta: 1, fail: () => { uni.switchTab({ url: '/pages/profile/profile' }) } }) }
	}
}
</script>

<style>
.mpa-page { min-height: 100vh; background: var(--canvas); padding-bottom: 60px; color: var(--ink); }
.mpa-nav { position: sticky; top: 0; z-index: 100; box-sizing: content-box; display: flex; align-items: center; justify-content: space-between; padding: 0 10px 8px; background: var(--canvas); border-bottom: 1px solid var(--line); }
.mpa-nav-side { min-width: 44px; height: 44px; display: flex; align-items: center; justify-content: flex-start; }
.mpa-nav-back-text { font-size: 28px; color: var(--ink); padding: 0 8px; line-height: 1; }
.mpa-nav-title { position: absolute; left: 0; right: 0; height: 44px; line-height: 44px; text-align: center; font-size: 17px; font-weight: 700; color: var(--ink); pointer-events: none; }
.mpa-loading, .mpa-error, .mpa-consent-state { padding: 80px 24px 48px; display: flex; flex-direction: column; align-items: center; }
.mpa-loading-dot { width: 14px; height: 14px; border-radius: 999px; background: var(--accent); margin-bottom: 16px; }
.mpa-loading-text, .mpa-error-text, .mpa-consent-copy { font-size: 14px; color: var(--muted); text-align: center; line-height: 1.6; }
.mpa-error-btn, .mpa-btn { min-height: 44px; height: 44px; padding: 0 18px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
.mpa-error-btn { margin-top: 20px; }
.mpa-btn-text, .mpa-error-btn-text { color: var(--text-invert); font-size: 14px; font-weight: 700; }
.mpa-body { padding: 16px 0 40px; }
.mpa-consent-title { font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--ink); margin-bottom: 12px; }
.mpa-consent-copy { max-width: 320px; margin-bottom: 24px; }
.mpa-consent-state .mpa-btn { width: 100%; max-width: 320px; }
.mpa-actions { display: flex; gap: 12px; padding: 16px; }
.mpa-actions .mpa-btn { flex: 1; }
.mpa-btn-ghost { background: var(--surface); border: 1px solid var(--line); }
.mpa-btn-ghost-text { color: var(--ink); font-size: 14px; font-weight: 600; }
.mpa-legacy-entry { min-height: 44px; margin: 4px 16px; padding: 0 14px; display: flex; align-items: center; justify-content: space-between; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
.mpa-legacy-text { font-size: 13px; color: var(--muted); }
.mpa-legacy-arrow { font-size: 22px; color: var(--accent); }
</style>
