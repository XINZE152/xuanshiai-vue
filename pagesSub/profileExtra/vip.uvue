<template>
	<view class="vip-page">
		<scroll-view class="vip-scroll vip-scroll-full" scroll-y>
			<view class="status-banner">
				<view class="status-copy"><text class="status-title">{{ isVip ? 'VIP会员已开通' : 'VIP会员未开通' }}</text><text class="status-desc">{{ isVip ? '当前会员权益正在生效' : '选择套餐后创建真实会员订单' }}</text></view>
				<view class="crown-circle"><text class="ic ic-vip ic-huiyuan crown-icon"></text></view>
			</view>

			<view class="plans-section">
				<text class="section-title">选择VIP会员类型</text>
				<view v-if="loadingPlans" class="plans-state"><text>正在读取会员套餐...</text></view>
				<view v-else-if="plans.length === 0" class="plans-state"><text>{{ loadError || '暂无可购买套餐' }}</text></view>
				<view v-else class="plans-row">
						<view v-for="(plan, index) in plans" :key="index" class="plan-card" :class="{ selected: selectedPlan === index }" @tap="selectPlan(index)">
						<text class="plan-tag">{{ plan.tag }}</text>
						<text class="plan-name">{{ plan.name }}</text>
						<text class="plan-price">¥{{ plan.price }}</text>
						<text class="plan-days">{{ plan.days }}</text>
					</view>
				</view>
			</view>

			<view class="benefits-section">
				<view class="benefit-heading"><text class="heading-dot"></text><text>会员权益</text><text class="heading-dot"></text></view>
				<view class="benefit-icons">
						<view class="benefit-icon-item" v-for="(item, index) in benefits" :key="index"><view class="benefit-icon-circle"><text :class="item.iconClass + ' benefit-icon-text'"></text></view><text>{{ item.title }}</text></view>
				</view>
			</view>

			<view class="details-section">
				<text class="details-title">会员权益：</text>
				<text class="detail-line">1. 头像附带VIP尊贵标识；</text>
				<text class="detail-line">2. 平台首页会员专区优先展示、搜索/匹配结果加权靠前曝光；</text>
				<text class="detail-line">3. 解锁会员专区语音介绍、图片视频等深度信息浏览限制；</text>
				<text class="detail-line">4. 套餐附赠对应牵线次数；</text>
				<text class="detail-line">5. 申请认识次数升级：普通用户每日仅3次免费「申请认识」，会员可提升至7次；每日次数定时刷新，剩余次数不累计叠加，操作时页面会展示当日剩余次数。</text>
				<text class="detail-line">6. 高级筛选匹配：首页筛选区分基础筛选与VIP专属高级筛选，开放MBTI匹配功能。</text>
				<text class="detail-line">7. 访客完整查看：可查看「谁看过我」完整详细访客列表。</text>
				<text class="detail-line">8. 会员专享每日20次免费查看他人资料，免费额度耗尽仅可通过积分兑换浏览次数。</text>
			</view>

			<view class="vip-footer">
				<button class="open-button" @click="handleBuy">立即开通</button>
			</view>
		</scroll-view>

		<view v-if="paymentVisible" class="payment-mask" @tap="closePayment">
			<view class="payment-sheet" @tap.stop="noop">
				<view class="payment-handle"></view>
				<text class="payment-title">选择支付方式</text>
				<view class="payment-option" :class="{ selected: paymentSelected }" @tap.stop="togglePayment">
					<view class="payment-option-left">
						<view class="wechat-icon"><text class="ic ic-home ic-hello payment-icon"></text></view>
						<view class="payment-copy"><text class="payment-name">微信支付</text><text class="payment-desc">推荐使用，安全快捷</text></view>
					</view>
					<view class="payment-check" :class="{ checked: paymentSelected }"><text v-if="paymentSelected" class="ic ic-sys ic-tijiaoqueren payment-check-icon"></text></view>
				</view>
				<view class="payment-total"><text>合计</text><text class="payment-total-price">¥{{ selectedPlanPrice }}</text></view>
				<button class="payment-confirm" :disabled="paymentLoading" @tap="confirmPayment">{{ paymentLoading ? '处理中...' : '确认支付' }}</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { getMembershipStatus, getMembershipPackages, createMembershipOrder, testPayOrder } from '@/api'
import { setCurrentUserVipStatus } from '@/utils/quota.uts'

const isVip = ref(false)
const paymentVisible = ref(false)
const paymentSelected = ref(true)
const selectedPlan = ref(0)
const redirectUrl = ref('/pages/index/index')
const loadingPlans = ref(true)
const loadError = ref('')
const paymentLoading = ref(false)
const plans = ref<any[]>([])
const benefits = [
	{ iconClass: 'ic ic-vip ic-renwu', title: '申请次数' },
	{ iconClass: 'ic ic-vip ic-huiyuan', title: '尊贵标识' },
	{ iconClass: 'ic ic-home ic-star', title: '靠前展示' },
	{ iconClass: 'ic ic-vip ic-huiyuanquanyi', title: '解锁功能' },
	{ iconClass: 'ic ic-vip ic-huiyuanfuwu', title: '专属服务' }
]
const selectedPlanData = computed(() => plans.value.length > selectedPlan.value ? plans.value[selectedPlan.value] : null)
const selectedPlanPrice = computed(() => selectedPlanData.value != null ? selectedPlanData.value.price : 0)
const selectPlan = (index: number) => { if (index >= 0 && index < plans.value.length) selectedPlan.value = index }
const goBack = () => { uni.navigateBack({}) }
const noop = () => {}
const handleBuy = () => {
	if (plans.value.length === 0) {
		uni.showToast({ title: loadError.value != '' ? loadError.value : '暂无可购买套餐', icon: 'none' })
		return
	}
	paymentVisible.value = true
}
const closePayment = () => { paymentVisible.value = false }
const togglePayment = () => { paymentSelected.value = !paymentSelected.value }
const returnAfterPayment = () => {
	const pages = getCurrentPages()
	if (pages.length > 1) {
		uni.navigateBack({ delta: 1 })
		return
	}
	uni.reLaunch({ url: redirectUrl.value })
}

const loadMembership = async () => {
	loadingPlans.value = true
	loadError.value = ''
	try {
		const statusRes = await getMembershipStatus()
		if (statusRes.success && statusRes.data != null) {
			isVip.value = (statusRes.data as any).is_vip == true
			// 以服务端为准回写本地，避免本地缓存与真实会员态长期分叉。
			setCurrentUserVipStatus(isVip.value)
		}
		const packagesRes = await getMembershipPackages()
		if (!packagesRes.success || packagesRes.data == null || !Array.isArray(packagesRes.data)) {
			loadError.value = packagesRes.message != null ? '' + packagesRes.message : '会员套餐暂时无法读取'
			return
		}
		const rows = packagesRes.data as any[]
		const mapped: any[] = []
		for (let i = 0; i < rows.length; i++) {
			const row = rows[i] != null ? rows[i] : {}
			mapped.push({
				code: row.package_code != null ? '' + row.package_code : (row.code != null ? '' + row.code : ''),
					name: row.name != null ? '' + row.name : '会员套餐',
					tag: row.tag != null ? '' + row.tag : (row.badge != null ? '' + row.badge : ''),
				price: row.price != null ? Number(row.price) : 0,
				days: row.duration_days != null ? '' + row.duration_days + '天' : (row.days != null ? '' + row.days + '天' : '')
			})
		}
		plans.value = mapped
		if (selectedPlan.value >= mapped.length) selectedPlan.value = 0
	} catch (e) {
		loadError.value = '网络不可用，请重试'
	} finally {
		loadingPlans.value = false
	}
}

onMounted(() => {
	const pages = getCurrentPages()
	const currentPage = pages[pages.length - 1]
	const options = currentPage.options
	if (options.redirect != null && options.redirect != '') {
		try {
			redirectUrl.value = decodeURIComponent('' + options.redirect)
		} catch (e) {
			redirectUrl.value = '/pages/index/index'
		}
	}
	loadMembership()
})

const confirmPayment = async () => {
	if (!paymentSelected.value) {
		uni.showToast({ title: '请选择支付方式', icon: 'none' })
		return
	}
	const selected = selectedPlanData.value
	if (selected == null || selected.code == '') {
		uni.showToast({ title: '请选择有效会员套餐', icon: 'none' })
		return
	}
	paymentLoading.value = true
	try {
		const orderRes = await createMembershipOrder(selected.code, 'membership-' + Date.now() + '-' + selected.code)
		if (!orderRes.success || orderRes.data == null) {
			uni.showToast({ title: orderRes.message != null ? '' + orderRes.message : '订单创建失败', icon: 'none' })
			return
		}
		const order = orderRes.data as any
		const orderNo = order.order_no != null ? '' + order.order_no : (order.orderNo != null ? '' + order.orderNo : '')
		if (orderNo == '') {
			uni.showToast({ title: '订单号缺失，暂不能支付', icon: 'none' })
			return
		}
		const payRes = await testPayOrder(orderNo)
		if (!payRes.success) {
			uni.showToast({ title: payRes.message != null ? '' + payRes.message : '支付未完成', icon: 'none' })
			return
		}
		paymentVisible.value = false
		isVip.value = true
		// 服务端测试支付已履约：把 VIP 态回写本地（按用户分键）。
		// 不回写的话，首页本地额度仍按普通用户 8 人判定。
		// 注意：不清理当日已浏览用户集合——升级只是把上限从 8 提到 20，
		// 已看过的人应保持"已看过"，否则会被当成新人重复计数、反向多给额度。
		setCurrentUserVipStatus(true)
		uni.showToast({ title: '开通成功', icon: 'success' })
		setTimeout(() => { returnAfterPayment() }, 600)
	} catch (e) {
		uni.showToast({ title: '支付失败，请稍后重试', icon: 'none' })
	} finally {
		paymentLoading.value = false
	}
}
</script>

<style scoped>
.vip-page {
	--cream-bg: #FAF7F0;
	--green-light: #EDF4EC;
	--green-soft: #F4F8F3;
	--card: #F8F9F6;
	--green: #A8C0A5;
	--green-deep: #627A5F;
	--gold: #C9A96E;
	--gold-light: #F7F1E5;
	--line: #DCE8D8;
	min-height: 100vh;
	background: var(--cream-bg);
	color: #1A1A1A;
}
.vip-nav { height: calc(44px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) 16px 0; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: space-between; background: var(--cream-bg); }
.nav-back { width: 34px; font-size: 22px; color: var(--green-deep); line-height: 34px; }.nav-title { font-size: 17px; font-weight: 500; }.nav-actions { display: flex; align-items: center; justify-content: center; gap: 12px; width: 72px; height: 36px; border: 1px solid #E8E4DD; border-radius: 20px; }.nav-action-icon { font-size: 17px; color: var(--green-deep); }
.vip-scroll { height: calc(100vh - 44px - env(safe-area-inset-top)); }.vip-scroll-full { height: 100vh; }
.status-banner { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 100px; padding: 20px; box-sizing: border-box; background: linear-gradient(135deg, #E8EDE4, #DCE5D6 50%, #F0EBE0); }.status-copy { display: flex; flex-direction: column; gap: 4px; }.status-title { font-size: 22px; font-weight: 700; }.status-desc { color: #4B5563; font-size: 13px; }.crown-circle { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; background: var(--gold-light); color: var(--gold); }.crown-icon { font-size: 30px; }.benefit-icon-text { font-size: 23px; }
.plans-section { padding: 20px 16px 14px; }.section-title { display: block; margin-bottom: 14px; font-size: 17px; font-weight: 600; }.plans-row { display: flex; flex-direction: row; gap: 8px; }.plan-card { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 12px 10px 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); text-align: center; }.plan-card.selected { border: 2px solid var(--green); background-color: #F4F8F1; }.plan-tag { display: inline-block; padding: 3px 8px; border-radius: 999px; background: var(--gold); color: #FFFFFF; font-size: 10px; font-weight: 600; }.plan-name { display: block; margin-top: 8px; font-size: 14px; font-weight: 600; }.plan-price { display: block; margin-top: 5px; font-size: 26px; font-weight: 700; }.plan-days { display: flex; flex-direction: row; align-items: center; justify-content: center; height: 28px; margin-top: 8px; border-radius: 6px; background: var(--gold-light); font-size: 11px; }
.plans-state { padding: 28px 0; color: #7B8282; font-size: 13px; text-align: center; }
.benefits-section { padding: 8px 16px 16px; }.benefit-heading { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12px; font-size: 17px; font-weight: 600; }.heading-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }.benefit-icons { display: flex; flex-direction: row; justify-content: space-around; margin-top: 16px; }.benefit-icon-item { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 56px; color: #4B5563; font-size: 11px; text-align: center; }.benefit-icon-circle { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; background: #E2EBE0; color: var(--green-deep); font-size: 23px; }
.details-section { margin: 0 16px; padding: 20px 16px; border-radius: 16px; background: var(--cream-bg); }.details-title { display: block; margin-bottom: 10px; font-size: 15px; font-weight: 600; }.detail-line { display: block; margin-top: 7px; color: #4B5563; font-size: 13px; line-height: 1.6; }
.vip-footer { padding: 16px 16px calc(24px + env(safe-area-inset-bottom)); background: var(--cream-bg); }.open-button { width: 100%; height: 50px; border-radius: 20px; background: linear-gradient(90deg, #E6EBD8, #C9A96E); color: #1A1A1A; font-size: 17px; font-weight: 700; }
.payment-mask { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; justify-content: flex-end; background-color: rgba(0, 0, 0, 0.7); }
.payment-sheet { display: flex; flex-direction: column; gap: 20px; padding: 24px 20px calc(32px + env(safe-area-inset-bottom)); border-radius: 20px 20px 0 0; background-color: var(--cream-bg); }
.payment-handle { align-self: flex-start; width: 40px; height: 4px; margin-bottom: 4px; border-radius: 2px; background-color: #E0DDD6; }
.payment-title { font-size: 18px; font-weight: 600; color: #000000; }
.payment-option { display: flex; flex-direction: row; align-items: center; justify-content: space-between; height: 64px; padding: 0 16px; border: 2rpx solid var(--line); background-color: #FFFFFF; }.payment-option.selected { border-color: #C7DDC1; }
.payment-option-left { display: flex; flex-direction: row; align-items: center; gap: 14px; }
.wechat-icon { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 40px; height: 40px; background-color: #E2EBE0; }
.payment-icon { font-size: 24px; color: var(--green-deep); }
.payment-copy { display: flex; flex-direction: column; gap: 4px; }.payment-name { font-size: 15px; color: #1A1A1A; }.payment-desc { font-size: 12px; color: #4B5563; }
.payment-check { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 22px; height: 22px; border: 1px solid #B8C9B4; background-color: #FFFFFF; }.payment-check.checked { border-color: var(--green-deep); background-color: var(--green-deep); }.payment-check-icon { font-size: 14px; color: #FFFFFF; }
.payment-total { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; font-size: 15px; color: #1A1A1A; }.payment-total-price { font-size: 28px; font-weight: 700; color: #000000; }
.payment-confirm { width: 100%; height: 50px; border: 0; border-radius: 0; background-color: #C7DDC1; color: #1A1A1A; font-size: 17px; font-weight: 700; }
@font-face { font-family: "iconfont-home"; src: url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff') format('woff'); }
@font-face { font-family: "iconfont-sys"; src: url('/static/婚恋小程序图标/系统通用/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/系统通用/iconfont.woff') format('woff'); }
@font-face { font-family: "iconfont-vip"; src: url('/static/婚恋小程序图标/会员支付与任务/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/会员支付与任务/iconfont.woff') format('woff'); }
.ic { font-style: normal; -webkit-font-smoothing: antialiased; }
.ic-home { font-family: "iconfont-home" !important; }
.ic-sys { font-family: "iconfont-sys" !important; }
.ic-vip { font-family: "iconfont-vip" !important; }
.ic-star:before { content: "\e60e"; }
.ic-fanhui:before { content: "\e606"; }
.ic-gengduo:before { content: "\e63f"; }
.ic-tijiaoqueren:before { content: "\e627"; }
.ic-huiyuan:before { content: "\e65d"; }
.ic-renwu:before { content: "\e69f"; }
.ic-huiyuanquanyi:before { content: "\e739"; }
.ic-huiyuanfuwu:before { content: "\e674"; }
</style>
