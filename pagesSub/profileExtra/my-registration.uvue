/* ==================== 票根行 ==================== */
.ticket-stub {
	height: 92rpx;
	border-top: 1px dashed var(--line);
	padding: 0 36rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
}

.fee-wrap {
	display: flex;
