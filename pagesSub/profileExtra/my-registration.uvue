<template>
	<view class="page">
		<view class="top-bar" :style="{ paddingTop: statusBarHeight + 'px', height: (statusBarHeight + 52) + 'px' }">
			<view class="top-back" @tap="goBack"><text>‹</text></view>
			<view class="top-placeholder"></view>
		</view>

		<scroll-view scroll-y class="content-scroll" show-scrollbar="false">
			<view class="content-inner">
				<view class="page-head">
					<text class="page-title">我的报名</text>
					<text class="page-sub">共 {{ totalCount }} 条记录 · {{ pendingCount }} 场待审核</text>
				</view>

				<view class="filter-tabs">
					<view v-for="tab in statusTabs" :key="tab.key" class="filter-tab" :class="activeFilter === tab.key ? 'filter-tab-active' : ''" @tap="selectFilter(tab.key)">
						<text>{{ tab.label }}</text>
					</view>
				</view>

				<view v-if="visibleItems.length > 0" class="ticket-list">
					<view v-for="item in visibleItems" :key="item.id" class="ticket-card">
						<view class="notch notch-left"></view>
						<view class="notch notch-right"></view>
						<view class="ticket-main">
							<view class="date-block">
								<text class="date-num">{{ item.dateText }}</text>
								<text class="date-week">{{ item.weekText }}</text>
							</view>
							<view class="ticket-copy">
								<text class="ticket-title">{{ item.title }}</text>
								<text class="ticket-loc">{{ item.location }}</text>
							</view>
						</view>
						<view class="status-stamp" :class="item.stampClass"><text>{{ item.statusLabel }}</text></view>
						<view class="ticket-stub">
							<view class="fee-wrap">
								<text class="fee-label">费用</text>
								<text class="fee-value" :class="item.feeClass">{{ item.fee }}</text>
							</view>
							<view class="detail-link" @tap="viewDetail(item)"><text>活动详情</text><text class="detail-arrow">→</text></view>
						</view>
					</view>
				</view>

				<view v-else class="empty-state">
					<view class="empty-ring"></view>
					<text class="empty-title">暂无相关报名</text>
					<text class="empty-copy">新的活动报名记录会显示在这里</text>
				</view>
				<view class="bottom-space"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
type StatusKey = 'all' | 'success' | 'pending' | 'rejected' | 'checked'
type StatusTab = { key: StatusKey; label: string }
type ActivityItem = {
	id: number
	status: StatusKey
	statusLabel: string
	stampClass: string
	dateText: string
	weekText: string
	title: string
	location: string
	fee: string
	feeClass: string
}

const systemInfo = uni.getSystemInfoSync()
const statusBarHeight = systemInfo.statusBarHeight != null ? systemInfo.statusBarHeight : 20
const activeFilter = ref<StatusKey>('all')

const statusTabs: StatusTab[] = [
	{ key: 'all', label: '全部' },
	{ key: 'success', label: '报名成功' },
	{ key: 'pending', label: '待审' },
	{ key: 'rejected', label: '被拒' },
	{ key: 'checked', label: '已签到' }
]

const activities: ActivityItem[] = [
	{
		id: 1,
		status: 'pending',
		statusLabel: '等待审核',
		stampClass: 'stamp-pending',
		dateText: '进行',
		weekText: '长期',
		title: '单身青年 免费择偶竞争力评分',
		location: '宣誓爱 · 线上',
		fee: '免费',
		feeClass: 'fee-free'
	},
	{
		id: 2,
		status: 'success',
		statusLabel: '报名成功',
		stampClass: 'stamp-success',
		dateText: '06.13',
		weekText: '周六 14:00',
		title: '95后专场 8 分钟轮桌下午茶',
		location: '滨江区泰安路附近',
		fee: '¥29',
		feeClass: 'fee-paid'
	},
	{
		id: 3,
		status: 'rejected',
		statusLabel: '未通过',
		stampClass: 'stamp-rejected',
		dateText: '07.12',
		weekText: '周六 14:00',
		title: '周末城市漫步',
		location: '静安区附近',
		fee: '¥9',
		feeClass: 'fee-paid'
	},
	{
		id: 4,
		status: 'checked',
		statusLabel: '已签到',
		stampClass: 'stamp-checked',
		dateText: '07.19',
		weekText: '周六 14:00',
		title: '单身评分',
		location: '活动地点已记录',
		fee: '免费',
		feeClass: 'fee-free'
	}
]

const totalCount = activities.length
let pendingTotal = 0
for (const item of activities) {
	if (item.status === 'pending') pendingTotal++
}
const pendingCount = pendingTotal

const visibleItems = computed<ActivityItem[]>(() => {
	const result: ActivityItem[] = []
	for (const item of activities) {
		if (activeFilter.value === 'all' || item.status === activeFilter.value) {
			result.push(item)
		}
	}
	return result
})

const goBack = () => { uni.navigateBack() }
const selectFilter = (key: StatusKey) => { activeFilter.value = key }
const viewDetail = (item: ActivityItem) => {
	uni.showToast({ title: `${item.title}详情 Demo`, icon: 'none' })
}
</script>

<style scoped>
