	font-size: 34rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.nav-help {
	position: absolute;
	right: 20rpx;
	top: 22rpx;
	height: 44rpx;
	padding: 0 14rpx;
	border-radius: 999rpx;
	border: 1px solid var(--line);
	display: flex;
	align-items: center;
}

.nav-help-text {
	font-size: 22rpx;
	color: var(--muted);
}

/* ===== 滚动区域 ===== */
.partner-center-entry { margin-top: 18rpx; padding: 26rpx; border: 1px solid var(--line); border-radius: 20rpx; background: var(--warm); display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 18rpx; }
.partner-center-entry.ready { background: var(--match-mist); border-color: var(--accent); }
.partner-center-entry-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.partner-center-entry-title-row { display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.partner-center-entry-title { font-size: 28rpx; font-weight: 800; color: var(--ink); }
.partner-center-entry-desc { font-size: 21rpx; line-height: 1.5; color: var(--ink2); }
.partner-center-entry-action { min-width: 136rpx; height: 64rpx; padding: 0 16rpx; border-radius: 14rpx; background: var(--accent); display: flex; flex-direction: row; align-items: center; justify-content: center; color: var(--paper); font-size: 21rpx; font-weight: 800; white-space: nowrap; flex-shrink: 0; }
.partner-center-entry-action:active { opacity: .78; transform: scale(0.98); }

.partner-center-scroller { flex: 1; height: 0; background: var(--canvas); }.partner-center-content { padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 48rpx); display: flex; flex-direction: column; gap: 20rpx; }.partner-center-hero { padding: 30rpx; border-radius: 22rpx; background: var(--accent2); display: flex; flex-direction: column; gap: 9rpx; }.partner-center-eyebrow { color: var(--accent-bg); font-size: 20rpx; }.partner-center-title { color: var(--paper); font-family: var(--sans); font-size: 38rpx; font-weight: 800; }.partner-center-copy { color: var(--accent-bg); font-size: 22rpx; line-height: 1.55; }
.partner-center-card { overflow: hidden; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); }.partner-center-section-title { display: block; padding: 22rpx 24rpx 12rpx; color: var(--ink); font-size: 25rpx; font-weight: 800; }.partner-center-row { min-height: 104rpx; padding: 18rpx 24rpx; border-top: 1px solid var(--line); display: flex; flex-direction: row; align-items: center; gap: 16rpx; }.partner-center-row > view { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }.partner-center-row > view text:first-child { color: var(--ink); font-size: 24rpx; font-weight: 700; }.partner-center-row > view text:last-child { color: var(--muted); font-size: 20rpx; line-height: 1.4; }.partner-center-row > text { flex-shrink: 0; color: var(--accent2); font-size: 20rpx; }.partner-center-row:active { opacity: .78; }

.page-scroller {
	flex: 1;
	height: 0;
}

.page-content {
	padding: 24rpx 32rpx;
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.bottom-spacer {
	height: 148rpx;
}

/* ===== Banner ===== */
.banner-card {
	padding: 34rpx 30rpx;
	border-radius: 22rpx;
	background: linear-gradient(145deg, var(--accent-bg), var(--surface));
	display: flex;
	flex-direction: column;
	justify-content: center;
	min-height: 208rpx;
	box-sizing: border-box;
}

.banner-copy {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.banner-kicker {
	font-size: 20rpx;
	font-weight: 800;
	letter-spacing: 0.08em;
	color: var(--accent2);
}

.banner-title {
	font-size: 40rpx;
	line-height: 1.34;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.banner-desc {
	font-size: 21rpx;
	line-height: 1.55;
	color: var(--ink2);
}

/* ===== 表单卡片 ===== */
.form-card {
	padding: 28rpx;
	border-radius: 20rpx;
	background: var(--surface);
	box-shadow: var(--shadow-sm);
	display: flex;
	flex-direction: column;
	gap: 18rpx;
}

.section-title {
	font-size: 34rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.section-desc {
	font-size: 22rpx;
	line-height: 1.55;
	color: var(--muted);
}

.form-field {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	padding-top: 18rpx;
	border-top: 1px solid var(--line);
}

.field-label {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--ink2);
}

.required {
	color: var(--brown);
}

.field-counter {
	font-size: 20rpx;
	color: var(--muted);
	text-align: right;
}

.field-input {
	height: 78rpx;
	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 25rpx;
	color: var(--ink);
}

.field-textarea {
	width: 100%;
	min-height: 146rpx;
	padding: 18rpx 20rpx;
	box-sizing: border-box;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 24rpx;
	line-height: 1.6;
	color: var(--ink);
}

/* ===== 审核流程 ===== */
.process-card {
	position: relative;
	overflow: visible;
}

.process-steps {
	display: flex;
	flex-direction: column;
	gap: 0;
}

.process-step {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 18rpx;
	padding-bottom: 28rpx;
}

.process-step:last-child {
	padding-bottom: 0;
}

.step-indicator {
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	border: 2rpx solid var(--line);
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 18rpx;
	font-weight: 800;
	color: var(--muted);
	flex-shrink: 0;
	z-index: 1;
}

.step-indicator.active {
	background: var(--accent);
	border-color: var(--accent);
	color: var(--paper);
}

.step-indicator.done {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
}

.step-copy {
