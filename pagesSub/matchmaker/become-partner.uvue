<template>
	<view class="become-page">
		<!-- 顶部导航栏 -->
		<view class="nav-bar">
			<view class="nav-back" @click="goBack">
				<view class="nav-back-chevron"></view>
			</view>
			<text class="nav-title">{{ partnerCenterVisible ? '合伙人中心' : '申请成为合伙人' }}</text>
			<view class="nav-help" @click="partnerCenterVisible ? closePartnerCenter() : showHelp()">
				<text class="nav-help-text">{{ partnerCenterVisible ? '申请页' : '帮助' }}</text>
			</view>
		</view>

		<scroll-view v-if="!partnerCenterVisible" scroll-y class="page-scroller" :show-scrollbar="false">
			<view class="page-content">
				<!-- Banner 宣传区域 -->
				<view class="banner-card">
					<view class="banner-copy">
						<text class="banner-kicker">合伙人招募</text>
						<text class="banner-title">共建认真婚恋社区，与平台一起成长</text>
						<text class="banner-desc">提交资料后，平台将尽快联系你确认合伙人信息。</text>
					</view>
				</view>

				<view class="partner-center-entry ready">
					<view class="partner-center-entry-copy">
						<view class="partner-center-entry-title-row">
							<text class="partner-center-entry-title">合伙人中心</text>
						</view>
						<text class="partner-center-entry-desc">查看合作工作台、申请进度与服务支持</text>
					</view>
					<view class="partner-center-entry-action" @click="openPartnerCenter">
						<text>进入中心</text>
					</view>
				</view>

				<!-- 基本信息 -->
				<view class="form-card">
					<text class="section-title">基本信息</text>
					<text class="section-desc">用于身份核验与平台联系，信息不会对外公开。</text>

					<view class="form-field">
						<text class="field-label">真实姓名 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="realName"
							placeholder="请填写真实姓名"
							@input="onRealNameInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">手机号 <text class="required">*</text></text>
						<input
							class="field-input"
							type="number"
							maxlength="11"
							:value="phone"
							placeholder="用于接收审核通知"
							@input="onPhoneInput"
						/>
					</view>

					<view class="form-field">
						<text class="field-label">微信号 <text class="required">*</text></text>
						<input
							class="field-input"
							:value="wechat"
							placeholder="便于平台工作人员后续沟通"
							@input="onWechatInput"
						/>
					</view>
				</view>

				<!-- 个人介绍 -->
				<view class="form-card">
					<text class="section-title">个人介绍</text>
					<text class="section-desc">介绍你的背景、资源与合作意愿，帮助我们更好地了解你。</text>

					<view class="form-field">
						<text class="field-label">个人简介 <text class="required">*</text></text>
						<textarea
							class="field-textarea"
							:value="introduction"
							maxlength="200"
							placeholder="简短介绍你的背景、资源和合作意愿，例如：我在杭州有丰富的本地社群资源，希望一起推进认真婚恋服务。"
							@input="onIntroductionInput"
						/>
						<text class="field-counter">{{ introduction.length }}/200</text>
					</view>
				</view>

				<!-- 审核流程 -->
				<view class="form-card process-card">
					<text class="section-title">审核流程</text>
					<text class="section-desc">提交申请后，预计 1-3 个工作日内完成审核。</text>

					<view class="process-steps">
						<view
							v-for="(step, index) in processSteps"
							:key="step.title"
							class="process-step"
						>
							<view class="step-indicator" :class="{ active: index === 0, done: index < currentStep }">
								<text v-if="index < currentStep">✓</text>
								<text v-else>0{{ index + 1 }}</text>
							</view>
							<view class="step-copy">
								<text class="step-title">{{ step.title }}</text>
								<text class="step-desc">{{ step.desc }}</text>
							</view>
							<view v-if="index < processSteps.length - 1" class="step-line"></view>
						</view>
					</view>

					<!-- 咨询入口 -->
					<view class="consult-icons">
						<view class="phone-slot" @click="callConsult">
							<image class="phone-brand" src="/static/icons/phone-call.svg" mode="aspectFit"></image>
						</view>
						<view class="wechat-slot" @click="wechatConsult">
							<image class="wechat-brand" src="/static/icons/wechat-bubble.svg" mode="aspectFit"></image>
						</view>
					</view>
				</view>

				<!-- 微信二维码弹窗 -->
				<view class="qr-overlay" v-if="qrVisible" @click="qrVisible = false">
					<view class="qr-card" @click.stop>
						<view class="qr-close" @click="qrVisible = false">
							<text>×</text>
						</view>
						<text class="qr-title">微信扫码咨询</text>
						<text class="qr-subtitle">添加客服微信，备注"合伙人入驻咨询"</text>
						<view class="qr-image-wrap">
							<image class="qr-image" src="/static/qrcodes/kefu-wechat.webp" mode="aspectFit"></image>
						</view>
						<text class="qr-tip">长按识别二维码添加</text>
					</view>
				</view>

				<!-- 隐私声明 -->
				<view class="privacy-card">
					<text class="privacy-title">隐私与安全</text>
					<text class="privacy-copy">你所提交的全部资料将受到平台隐私协议保护，仅用于合伙人资质审核与合作安排。请如实填写，不要提交他人的联系方式或敏感身份信息。审核通过后，你可在个人设置中随时管理展示范围。</text>
				</view>

				<!-- 底部占位 -->
				<view class="bottom-spacer"></view>
			</view>
		</scroll-view>

		<scroll-view v-else scroll-y class="partner-center-scroller" :show-scrollbar="false">
			<view class="partner-center-content">
				<view class="partner-center-hero">
					<text class="partner-center-eyebrow">合作工作台</text>
					<text class="partner-center-title">合伙人中心</text>
					<text class="partner-center-copy">集中查看申请进度、合作工具和平台服务支持。</text>
				</view>
				<view class="partner-center-card">
					<text class="partner-center-section-title">我的合作</text>
					<view class="partner-center-row" @click="showToast('已打开合伙人申请进度')"><view><text>申请进度</text><text>查看资料审核与平台反馈</text></view><text>查看详情</text></view>
					<view class="partner-center-row" @click="showToast('已打开合作资源')"><view><text>合作资源</text><text>查看可用推广与服务工具</text></view><text>查看详情</text></view>
					<view class="partner-center-row" @click="showToast('已打开合作记录')"><view><text>合作记录</text><text>查看已保存的本地工作记录</text></view><text>查看详情</text></view>
				</view>
				<view class="partner-center-card">
					<text class="partner-center-section-title">服务支持</text>
					<view class="partner-center-row" @click="callConsult"><view><text>电话咨询</text><text>联系平台合作顾问</text></view><text>立即拨打</text></view>
					<view class="partner-center-row" @click="wechatConsult"><view><text>微信咨询</text><text>获取入驻与合作说明</text></view><text>发起咨询</text></view>
				</view>
			</view>
		</scroll-view>

		<!-- 底部提交按钮 -->
		<view v-if="!partnerCenterVisible" class="footer-safe">
			<view
				class="submit-button"
				:class="{ disabled: !canSubmit || submitting }"
				@click="submitApplication"
			>
				<text>{{ submitting ? '提交中…' : (canSubmit ? '提交申请' : '请补全必填信息') }}</text>
			</view>
		</view>

		<XsaToast :visible="toastVisible" :message="toastMessage" @hide="toastVisible = false" />
	</view>
</template>

<script setup lang="uts">
import XsaToast from '@/components/XsaToast.uvue'
import { submitPartnerApplication } from '@/api'

// ===== 基本信息 =====
const realName = ref('')
const phone = ref('')
const wechat = ref('')

// ===== 个人介绍 =====
const introduction = ref('')

// ===== 状态 =====
const submitting = ref(false)
const toastVisible = ref(false)
const toastMessage = ref('')
const qrVisible = ref(false)
const currentStep = ref(0)
const partnerCenterVisible = ref(false)

const processSteps = [
	{ title: '填写申请', desc: '填写完整资料并提交' },
	{ title: '平台审核', desc: '运营人员对资料进行审核' },
	{ title: '审核通过', desc: '获得平台合伙人身份' },
	{ title: '成为合伙人', desc: '可正式参与平台共建与合作' }
]

// ===== 计算属性 =====
const canSubmit = computed(() => {
	return realName.value.trim().length >= 2
		&& realName.value.trim().length <= 64
		&& /^1[3-9]\d{9}$/.test(phone.value.trim())
		&& wechat.value.trim().length > 0
		&& wechat.value.trim().length <= 128
		&& introduction.value.trim().length >= 10
		&& introduction.value.trim().length <= 2000
})

// ===== Toast =====
const showToast = (msg: string) => {
	toastMessage.value = msg
	toastVisible.value = true
}

const openPartnerCenter = () => {
	uni.navigateTo({ url: '/pagesSub/matchmaker/partner-center' })
}

const closePartnerCenter = () => {
	partnerCenterVisible.value = false
}

const guideToRequiredVerification = (message: string) => {
	const needsPhone = message.indexOf('绑定手机号') >= 0
	uni.showModal({
		title: needsPhone ? '请先绑定手机号' : '请先完成实名认证',
		content: needsPhone ? '绑定手机号后，还需要完成实名认证才可提交申请。' : '实名认证审核通过后即可提交申请。',
		confirmText: '去完成',
		success: (modal: any) => {
			if (modal.confirm) uni.navigateTo({ url: '/pagesSub/profileExtra/certification?type=' + (needsPhone ? 'phone' : 'realname') + '&returnTo=partner', fail: () => { uni.showToast({ title: '认证页打开失败，请稍后重试', icon: 'none' }) } })
		}
	})
}

const showExistingApplication = () => {
	uni.showModal({
		title: '申请正在审核',
		content: '你已提交合伙人申请，请等待平台审核结果，无需重复提交。',
		confirmText: '查看状态',
		success: (modal: any) => {
			if (modal.confirm) uni.redirectTo({ url: '/pagesSub/matchmaker/application-success?type=partner' })
		}
	})
}

// ===== 导航 =====
const goBack = () => {
	if (partnerCenterVisible.value) {
		closePartnerCenter()
		return
	}
	uni.navigateBack()
}

const showHelp = () => {
	uni.showModal({
		title: '申请说明',
		content: '成为平台合伙人需要经过实名认证、资源审核和洽谈流程。审核通常在 1-3 个工作日内完成，审核结果将通过短信通知你。如有问题，请联系客服。',
		showCancel: false,
		confirmText: '知道了'
	})
}

const callConsult = () => {
	uni.showModal({
		title: '电话咨询',
		content: '咨询热线：400-XXX-XXXX（工作时间：周一至周五 9:00-18:00）',
		showCancel: false,
		confirmText: '知道了'
	})
}

const wechatConsult = () => {
	qrVisible.value = true
}

// ===== 表单输入 =====
const onRealNameInput = (e: any) => { realName.value = e.detail.value }
const onPhoneInput = (e: any) => { phone.value = e.detail.value }
const onWechatInput = (e: any) => { wechat.value = e.detail.value }
const onIntroductionInput = (e: any) => { introduction.value = e.detail.value }

// ===== 提交申请 =====
const submitApplication = async () => {
	if (submitting.value) return

	// 基本信息校验
	if (realName.value.trim().length < 2 || realName.value.trim().length > 64) {
		showToast('真实姓名需为 2-64 个字符')
		return
	}
	if (!/^1[3-9]\d{9}$/.test(phone.value.trim())) {
		showToast('请填写正确的 11 位手机号')
		return
	}
	if (wechat.value.trim().length === 0 || wechat.value.trim().length > 128) {
		showToast('微信号需为 1-128 个字符')
		return
	}

	// 个人介绍校验
	if (introduction.value.trim().length < 10 || introduction.value.trim().length > 2000) {
		showToast('个人简介需为 10-2000 个字符')
		return
	}

	try {
		submitting.value = true

		const formData = {
			realName: realName.value.trim(),
			phone: phone.value.trim(),
			wechat: wechat.value.trim(),
			introduction: introduction.value.trim()
		}

		const result = await submitPartnerApplication(formData)

		if (result.success) {
			const applicationId = result.data != null && result.data.id != null ? String(result.data.id) : ''
			uni.redirectTo({
				url: '/pagesSub/matchmaker/application-success?type=partner&id=' + applicationId
			})
		} else {
			const message = result.message != null ? String(result.message) : '提交失败，请稍后重试'
			if (result.code == 403 && (message.indexOf('绑定手机号') >= 0 || message.indexOf('实名认证') >= 0)) {
				guideToRequiredVerification(message)
			} else if (result.code == 409) {
				showExistingApplication()
			} else {
				showToast(message)
			}
		}
	} catch (e) {
		showToast('提交失败，请稍后重试')
	} finally {
		submitting.value = false
	}
}
</script>

<style scoped>
.become-page {
	min-height: 100vh;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
}

/* ===== 导航栏 ===== */
