	position: relative;
	height: 88rpx;
	padding: 0 12rpx;
	background: var(--paper);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	border-bottom: 1px solid var(--line);
	flex-shrink: 0;
}

