/* 分成标准 / 牵线卡片：比例数值与牵线状态 */
.workspace-rate-value { color: var(--accent2); font-size: 30rpx; font-weight: 800; }.workspace-match-card { font-size: 21rpx; font-weight: 400; }.workspace-match-card-top { display: flex; justify-content: space-between; align-items: center; color: var(--muted); }.workspace-match-status { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; line-height: 1.2; }.workspace-match-status-pending { background: var(--accent-bg); color: var(--accent2); }.workspace-match-status-progress { background: var(--match-sky); color: var(--match-deep); }.workspace-match-status-succeeded { background: var(--sage-soft); color: var(--sage); }.workspace-match-status-failed { background: var(--match-blush); color: var(--match-coral); }.workspace-match-person { min-height: 64rpx; display: flex; align-items: center; gap: 14rpx; }.workspace-match-person > view { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }.workspace-match-person > view text:first-child { color: var(--ink); font-size: 23rpx; font-weight: 700; }.workspace-match-person > view text:last-child { color: var(--muted); font-size: 19rpx; }.workspace-match-reason { padding: 14rpx; border-radius: 14rpx; background: var(--match-blush); color: var(--ink2); font-size: 20rpx; line-height: 1.5; }.workspace-match-owner { color: var(--muted); font-size: 19rpx; }

/* 牵线管理（按设计稿）：申请时间+黄色状态胶囊、双列头像带角色标、联系Ta、牵线状态弹窗。 */
.workspace-match-card { gap: 20rpx; padding: 26rpx 26rpx; }
.workspace-match-card .workspace-match-card-top { margin-bottom: 2rpx; }
.workspace-match-status-btn { height: 60rpx; padding: 0 22rpx; border-radius: 999rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 10rpx; }
