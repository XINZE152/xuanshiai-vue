// 判断牵线记录中的会员是否为会员专区（VIP）会员，用于卡片上的 VIP 徽章。
const isVipPerson = (person: any): boolean => person != null && Number(person.isVip) == 1

// 点击「联系Ta」→ 打开查看联系方式弹窗（受审计读取，超级红娘可查全部会员）。
const workspaceContactVisible = ref(false)
const workspaceContactLoading = ref(false)
const workspaceContactNickname = ref('')
const workspaceContactRealName = ref('')
const workspaceContactPhone = ref('')
const workspaceContactWechat = ref('')
const workspaceContactScope = ref('SERVED')
const workspaceContactError = ref('')
const workspaceContactMemberId = ref(0)

const resetWorkspaceContact = () => {
	workspaceContactNickname.value = ''
	workspaceContactRealName.value = ''
	workspaceContactPhone.value = ''
	workspaceContactWechat.value = ''
	workspaceContactScope.value = 'SERVED'
	workspaceContactError.value = ''
}

const closeWorkspaceContact = () => {
	workspaceContactVisible.value = false
	workspaceContactMemberId.value = 0
	resetWorkspaceContact()
}

// 遮罩点击守卫：打开后 360ms 内忽略遮罩点击，避免「打开弹窗的那一次点击」穿透关闭弹窗。
const workspaceContactReady = ref(false)

// 名称行：昵称去掉「（演示）」后缀 + 实名，两者相同只显示一个。
const workspaceContactNameText = computed<string>((): string => {
	const nick = workspaceContactNickname.value.length > 0 ? workspaceContactNickname.value.replace('（演示）', '').replace('(演示)', '').trim() : ''
	const real = workspaceContactRealName.value.trim()
	if (nick.length > 0 && real.length > 0 && nick != real) return nick + ' | ' + real
	if (nick.length > 0) return nick
	if (real.length > 0) return real
	return '会员联系方式'
})

const workspaceContactTipText = computed<string>((): string => {
	if (workspaceContactScope.value == 'ALL') return '您当前是超级红娘，可以查看所有会员的联系方式；请勿外泄，每次查看都会记录到服务审计日志。'
	return '超级红娘可以查看所有会员的联系方式；普通红娘仅能查看所服务会员的联系方式。本次查看已记录到服务审计日志。'
})

const copyWorkspaceContact = (value: string) => {
	if (value.length == 0) return
	uni.setClipboardData({
		data: value,
		success: () => { uni.showToast({ title: '已复制', icon: 'none' }) }
	})
}

const callWorkspaceContact = () => {
	const phone = workspaceContactPhone.value.trim()
	if (phone.length == 0) {
		uni.showToast({ title: '该会员未绑定手机号', icon: 'none' })
		return
	}
	uni.makePhoneCall({
		phoneNumber: phone,
		fail: () => { uni.showToast({ title: '拨号未成功，可先复制号码', icon: 'none' }) }
	})
}

const onWorkspaceContactOverlay = () => {
	if (!workspaceContactReady.value) return
	closeWorkspaceContact()
}

// 资料待审里的「联系」→ 上抛会员，复用页面里同一个弹窗（避免重复实现弹层）。
const onPendingReviewContact = (member: any) => {
	const id = member != null && member.user_id != null ? String(member.user_id).trim() : ''
	const name = member != null && member.nickname != null ? String(member.nickname) : ''
	openWorkspaceContact({ id: id, name: name })
}

// 解析会员编号：演示数据（如 W10001）会得到 NaN，必须用「非正数」判断兜住，否则会带着 NaN 去请求接口。
const parseMemberId = (person: any): number => {
	const raw = person != null && person.id != null ? String(person.id).trim() : ''
	if (raw.length == 0) return 0
	const value = Number(raw)
	if (!(value > 0)) return 0
	return Math.floor(value)
}

// 看到联系方式即等于红娘已经介入撮合：待牵线自动转牵线中，不必再点一次状态。
// 只改这一行的本地状态，不整表重载；牵线中/成功/失败保持不变。
const markIntroductionContacted = async (row: any) => {
	if (row == null) return
	if (String(row.status) != 'PENDING') return
	const rawId = row.id != null ? String(row.id).trim() : ''
	const value = Number(rawId)
	if (!(value > 0)) return
	try {
		const result = await updateMatchmakerIntroductionStatus(rawId, 'IN_PROGRESS', '')
		if (!result.success) return
		row.status = 'IN_PROGRESS'
		row.statusLabel = '牵线中'
		row.statusTone = 'progress'
	} catch (e) {
		// 状态推进失败不影响联系方式展示，红娘仍可手动改状态。
	}
}

const openWorkspaceContact = async (person: any, row: any = null) => {
	const id = parseMemberId(person)
	if (id <= 0) {
		showToast('该会员为本地演示数据，暂不支持查看联系方式')
		return
	}
	workspaceContactMemberId.value = id
	resetWorkspaceContact()
	// 先用卡片上的姓名占位，避免弹窗加载期间标题为空。
	workspaceContactNickname.value = person != null && person.name != null ? String(person.name) : ''
	// 打开瞬间屏蔽遮罩点击（同一次点击可能落到刚出现的遮罩上）。
	workspaceContactReady.value = false
	setTimeout(() => { workspaceContactReady.value = true }, 360)
	workspaceContactLoading.value = true
	workspaceContactVisible.value = true
	try {
		const result = await getMatchmakerMemberContact(String(id))
		if (workspaceContactMemberId.value != id) return
		if (!result.success || result.data == null) {
			// 读取失败时保持弹窗打开并就地提示，避免「一闪而过」看起来像没反应。
			workspaceContactError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '联系方式加载失败，请稍后重试'
			return
		}
		const data: any = result.data
		if (data.nickname != null && String(data.nickname).length > 0) workspaceContactNickname.value = String(data.nickname)
		workspaceContactRealName.value = data.realName != null ? String(data.realName) : ''
		workspaceContactPhone.value = data.phone != null ? String(data.phone) : ''
		workspaceContactWechat.value = data.wechat != null ? String(data.wechat) : ''
		workspaceContactScope.value = data.scope != null ? String(data.scope) : 'SERVED'
		await markIntroductionContacted(row)
	} catch (e) {
		workspaceContactError.value = '网络异常，请稍后重试'
	} finally {
		workspaceContactLoading.value = false
	}
}

// 点击牵线记录里的会员头像 → 以红娘权限查看该会员主页。
const openWorkspaceMemberProfile = (person: any) => {
	const id = parseMemberId(person)
	if (id <= 0) {
		showToast('该会员为本地演示数据，暂无主页')
		return
	}
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/detail?userId=' + String(id) + '&matchmakerView=1',
		fail: () => showToast('打开会员主页失败')
	})
}

const getWorkspaceMeetingPresentation = (requestStatus: string, meeting: any) => {
	if (meeting != null) {
		const meetingStatus = meeting.status != null ? String(meeting.status) : ''
		if (meetingStatus == 'SCHEDULED' || meetingStatus == 'REMINDED' || meetingStatus == 'CHECKED_IN') {
			return { phase: 'UPCOMING', statusLabel: '待见面', statusTone: 'upcoming', detail: '已安排约见，请按计划完成服务跟进' }
		}
		if (meetingStatus == 'COMPLETED') {
			return { phase: 'COMPLETED', statusLabel: '已完成', statusTone: 'completed', detail: '本次约见已完成，可继续记录后续服务进展' }
		}
		return { phase: 'ENDED', statusLabel: meetingStatus == 'NO_SHOW' ? '未按约到场' : '已结束', statusTone: 'ended', detail: meeting.cancelReason != null && String(meeting.cancelReason).length > 0 ? String(meeting.cancelReason) : '本次约见已结束' }
	}
	if (requestStatus == 'SUBMITTED') return { phase: 'PROCESSING', statusLabel: '待处理', statusTone: 'submitted', detail: '已收到约见申请，等待服务红娘跟进' }
	if (requestStatus == 'CONTACTED') return { phase: 'PROCESSING', statusLabel: '跟进中', statusTone: 'processing', detail: '正在协调双方可约见时间' }
	if (requestStatus == 'ACCEPTED') return { phase: 'PROCESSING', statusLabel: '待安排', statusTone: 'processing', detail: '双方已同意，等待安排具体约见' }
	return { phase: 'ENDED', statusLabel: requestStatus == 'DECLINED' ? '未达成约见' : '已关闭', statusTone: 'ended', detail: '本次约见申请已结束' }
}

const loadWorkspaceMeetings = async () => {
	workspaceMeetingsLoading.value = true
	workspaceMeetingsError.value = ''
	workspaceMeetingsLoaded.value = false
	workspaceMeetingsUsingDemoData.value = false
	try {
		const result = await getMatchmakerWorkspaceMeetingRequests()
		if (!result.success || result.data == null) {
			workspaceMeetings.value = []
			workspaceMeetingsError.value = result.message != null ? String(result.message) : '约见申请加载失败'
			return
		}
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		workspaceMeetingsUsingDemoData.value = source.isDemo == true
		introductionFallbackUsed = []
		workspaceMeetings.value = items.map((item: any) => {
			const applicant = item.applicant != null ? item.applicant : {}
			const target = item.target != null ? item.target : {}
			const meeting = item.meeting != null ? item.meeting : null
			const presentation = getWorkspaceMeetingPresentation(item.status != null ? String(item.status) : 'SUBMITTED', meeting)
			return {
				id: item.id != null ? String(item.id) : '',
				phase: presentation.phase,
				statusLabel: presentation.statusLabel,
				statusTone: presentation.statusTone,
				detail: presentation.detail,
				requestStatus: item.status != null ? String(item.status) : 'SUBMITTED',
				createdAt: item.createdAt != null ? String(item.createdAt).substring(0, 16) : '',
				owner: item.matchmakerName != null && String(item.matchmakerName) != '' ? String(item.matchmakerName) : '待分派',
				note: item.note != null ? String(item.note) : '',
				meeting: meeting != null ? {
					id: meeting.id != null ? String(meeting.id) : '',
					status: meeting.status != null ? String(meeting.status) : '',
					scheduledAt: meeting.scheduledAt != null ? String(meeting.scheduledAt).substring(0, 16) : '',
					location: meeting.location != null ? String(meeting.location) : ''
				} : null,
				applicant: {
					id: applicant.id != null ? String(applicant.id) : '',
					name: applicant.name != null ? String(applicant.name) : '未命名会员',
					gender: applicant.gender != null ? String(applicant.gender) : '未填写',
					isVip: applicant.isVip === true || applicant.isVip === 1,
					avatar: applicant.avatar != null && String(applicant.avatar).length > 0 ? String(applicant.avatar) : getIntroductionFallbackAvatar(applicant.id, String(applicant.gender), String(applicant.name))
				},
				target: {
					id: target.id != null ? String(target.id) : '',
					name: target.name != null ? String(target.name) : '未命名会员',
					gender: target.gender != null ? String(target.gender) : '未填写',
					isVip: target.isVip === true || target.isVip === 1,
					avatar: target.avatar != null && String(target.avatar).length > 0 ? String(target.avatar) : getIntroductionFallbackAvatar(target.id, String(target.gender), String(target.name))
				}
			}
		})
		workspaceMeetingsLoaded.value = true
		syncBusinessMetricCountsFromWorkspace()
	} catch (e) {
		workspaceMeetings.value = []
		workspaceMeetingsUsingDemoData.value = false
		workspaceMeetingsError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		workspaceMeetingsLoading.value = false
	}
}

// ===== 红娘喜讯：读后台「运营工具-喜讯管理」内容域，只做浏览与详情 =====
const loadWorkspaceNews = async () => {
	newsLoading.value = true
	newsError.value = ''
	try {
		const result = await getMatchmakerWorkspaceGoodNews(newsStage.value, 1, 100)
		if (!result.success || result.data == null) {
			workspaceNews.value = []
			newsTotal.value = 0
			newsError.value = result.message != null ? String(result.message) : '红娘喜讯加载失败'
			return
		}
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		workspaceNews.value = items.map((item: any) => {
			const images: string[] = Array.isArray(item.images) ? item.images as string[] : []
			// 红娘端只登记对方称呼，没有的一侧服务端返回空串，卡片上就不渲染这一侧。
			const fromName = item.fromName != null ? String(item.fromName) : ''
			const toName = item.toName != null ? String(item.toName) : ''
			const stage = item.stage != null ? String(item.stage) : ''
			const content = item.content != null ? String(item.content) : ''
			const createdAt = item.createdAt != null ? String(item.createdAt) : ''
			const blessingCount = item.blessingCount != null ? Number(item.blessingCount) : 0
			return {
				id: item.id != null ? String(item.id) : '',
				stage: stage,
				stageTone: newsStageTone(stage),
				fromUserId: item.fromUserId != null ? String(item.fromUserId) : '',
				toUserId: item.toUserId != null ? String(item.toUserId) : '',
				fromName: fromName,
				toName: toName,
				fromAvatar: item.fromAvatar != null && String(item.fromAvatar).length > 0 ? String(item.fromAvatar) : getIntroductionFallbackAvatar(item.fromUserId, '', fromName),
				toAvatar: item.toAvatar != null && String(item.toAvatar).length > 0 ? String(item.toAvatar) : getIntroductionFallbackAvatar(item.toUserId, '', toName),
				matchmakerName: item.matchmakerName != null ? String(item.matchmakerName) : '服务红娘',
				meetDuration: item.meetDuration != null ? String(item.meetDuration) : '',
				images: images,
				content: content,
				summary: content.length > 56 ? content.substring(0, 56) + '…' : content,
				blessing: item.blessing != null ? String(item.blessing) : '',
				blessingText: String(blessingCount) + '人已送祝福',
				pendingReview: item.pendingReview === true,
				createdAt: createdAt,
				date: createdAt.length >= 10 ? createdAt.substring(0, 10) : createdAt
			}
		})
		newsTotal.value = source.total != null ? Number(source.total) : items.length
	} catch (e) {
		workspaceNews.value = []
		newsTotal.value = 0
		newsError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		newsLoading.value = false
	}
}

const loadWorkspacePennants = async () => {
	pennantsLoading.value = true
	pennantsError.value = ''
	pennantsLoaded.value = false
	try {
		const result = await getMatchmakerWorkspaceGoodNewsPennants(1, 100)
		if (!result.success || result.data == null) {
			workspacePennants.value = []
			pennantsError.value = result.message != null ? String(result.message) : '锦旗墙加载失败'
			return
		}
		const items = Array.isArray(result.data.items) ? result.data.items : []
		workspacePennants.value = items.map((item: any) => ({
			id: item.id != null ? String(item.id) : '',
			maker: item.maker != null ? String(item.maker) : '',
			giver: item.giver != null ? String(item.giver) : '',
			target: item.target != null ? String(item.target) : '',
			words: item.words != null ? String(item.words) : '',
			imageUrl: item.imageUrl != null ? String(item.imageUrl) : '',
			date: item.createdAt != null && String(item.createdAt).length >= 10 ? String(item.createdAt).substring(0, 10) : ''
		}))
		pennantsLoaded.value = true
	} catch (e) {
		workspacePennants.value = []
		pennantsError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		pennantsLoading.value = false
	}
}

const selectNewsStage = (stage: string) => {
	if (stage == '锦旗飘扬') {
		workspaceActiveTab.value = '锦旗'
		return
	}
	// 再点一次已选中的阶段即取消筛选，回到全部喜讯。
	newsStage.value = newsStage.value == stage ? '' : stage
	newsDetailId.value = ''
	void loadWorkspaceNews()
}

const isNewsStageActive = (stage: string): boolean => {
	if (stage == '锦旗飘扬') return workspaceActiveTab.value == '锦旗'
	return workspaceActiveTab.value == '喜讯' && newsStage.value == stage
}

const toggleNewsDetail = (id: string) => {
	newsDetailId.value = newsDetailId.value == id ? '' : id
}

const previewNewsImage = (images: string[], index: number) => {
	if (images.length == 0) return
	uni.previewImage({ urls: images, current: index })
}

const previewPennantImage = (url: string) => {
	if (url.length == 0) return
	uni.previewImage({ urls: [url], current: 0 })
}

const openNewsMemberProfile = (userId: string) => {
	// 后台喜讯表单目前只登记姓名文本，没有关联会员时不跳主页。
	if (userId.length == 0) {
		showToast('这条喜讯只登记了姓名，未关联会员')
		return
	}
	uni.navigateTo({
		url: '/pagesSub/userExtra/user/detail?userId=' + userId + '&matchmakerView=1',
		fail: () => showToast('打开会员主页失败')
	})
}

const openNewsReportSheet = () => {
	newsReportSheetVisible.value = true
}

// 报喜面板分流：反馈喜讯已有写入接口，赠送锦旗还没有服务端入口。
const chooseNewsReportKind = (kind: string) => {
	newsReportSheetVisible.value = false
	if (kind == 'pennant') {
		pennantGiver.value = ''
		pennantReceiver.value = ''
		pennantLeftWords.value = ''
		pennantRightWords.value = ''
		pennantDate.value = ''
		pennantError.value = ''
		pennantReady.value = false
		pennantSheetVisible.value = true
		redrawPennant()
		return
	}
	newsFormStage.value = ''
	newsFormStageIndex.value = 0
	newsFormPartner.value = ''
	newsFormMeetDuration.value = ''
	newsFormContent.value = ''
	newsFormImages.value = []
	newsFormError.value = ''
	newsFeedbackSheetVisible.value = true
}

const pennantPayload = (): PennantContent => {
	return {
		giver: pennantGiver.value.trim(),
		receiver: pennantReceiver.value.trim(),
		leftWords: pennantLeftWords.value.trim(),
		rightWords: pennantRightWords.value.trim(),
		dateText: pennantDate.value.trim()
	} as PennantContent
}

const pennantHost = (): any => {
	return pennantInstance != null && pennantInstance.proxy != null ? pennantInstance.proxy : null
}

// 打开面板时先画一面空白锦旗当模板；canvas 常驻在 XsaSheet 里，等一帧拿到节点即可。
const redrawPennant = async () => {
	await nextTick()
	try {
		await renderPennant('pennantCanvas', pennantHost(), pennantPayload())
	} catch (e: any) {
		console.error('[pennant] 预览绘制失败', e)
	}
}

const generatePennant = async () => {
	if (pennantWorking.value) return
	const payload = pennantPayload()
	if (payload.giver.length == 0) {
		pennantError.value = '请填写赠送人'
		return
	}
	if (payload.receiver.length == 0) {
		pennantError.value = '请填写赠送给'
		return
	}
	if (payload.leftWords.length == 0 || payload.rightWords.length == 0) {
		pennantError.value = '左右两条感谢语都要填写'
		return
	}
	pennantError.value = ''
	pennantWorking.value = true
	try {
		const tempPath = await drawPennant('pennantCanvas', pennantHost(), payload)
		// savePosterToPhotos 只在真正写进相册后返回 true，未授权时它自己会弹引导，这里不再谎报已保存。
		pennantReady.value = await savePosterToPhotos(tempPath)
	} catch (e: any) {
		console.error('[pennant] 锦旗生成失败', e)
		pennantError.value = '锦旗生成失败，请稍后重试'
	} finally {
		pennantWorking.value = false
	}
}

const onNewsFormStageChange = (event: any) => {
	const index = Number(event.detail.value)
	newsFormStageIndex.value = index
	newsFormStage.value = index >= 0 && index < newsStageOptions.length ? newsStageOptions[index] : ''
}

const chooseNewsFormImage = () => {
	const remaining = 9 - newsFormImages.value.length
	if (remaining <= 0) {
		showToast('一条喜讯最多上传 9 张图片')
		return
	}
	uni.chooseImage({
		count: remaining,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: async (res: any) => {
			const paths: any[] = res.tempFilePaths != null ? (res.tempFilePaths as any[]) : []
			if (paths.length == 0) return
			showToast('图片上传中…')
			for (let i = 0; i < paths.length; i++) {
				try {
					const uploaded = await uploadWorkspaceGoodNewsPhoto(String(paths[i]))
					if (uploaded.success && uploaded.data != null && uploaded.data.url != null) {
						// url 存服务端相对路径（入库用），display 才是给 image 组件的完整地址。
						const url = String(uploaded.data.url)
						newsFormImages.value.push({ url: url, display: resolveMediaUrl(url) })
					} else {
						showToast(uploaded.message != null ? String(uploaded.message) : '图片上传失败')
					}
				} catch (e) {
					showToast('图片上传失败，请重试')
				}
			}
		}
	})
}

const removeNewsFormImage = (index: number) => {
	newsFormImages.value.splice(index, 1)
}

const previewNewsFormImage = (index: number) => {
	const urls: string[] = newsFormImages.value.map((item: any) => String(item.display))
	if (urls.length == 0) return
	uni.previewImage({ urls: urls, current: index })
}

const submitNewsFeedback = async () => {
	if (newsFormSubmitting.value) return
	const partner = newsFormPartner.value.trim()
	if (partner.length == 0) {
		newsFormError.value = '请填写对方称呼'
		return
	}
	if (newsFormStage.value.length == 0) {
		newsFormError.value = '请选择当前状态'
		return
	}
	newsFormError.value = ''
	newsFormSubmitting.value = true
	const result = await createMatchmakerWorkspaceGoodNews({
		stage: newsFormStage.value,
		partnerName: partner,
		meetDuration: newsFormMeetDuration.value.trim(),
		content: newsFormContent.value.trim(),
		images: newsFormImages.value.map((item: any) => String(item.url))
	})
	newsFormSubmitting.value = false
	if (!result.success) {
		newsFormError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '提交失败，请稍后重试'
		return
	}
	newsFeedbackSheetVisible.value = false
	showToast('已提交，后台审核通过后公开')
	await loadWorkspaceNews()
}

const blessGoodNews = () => showToast('送祝福将在服务端开放写入后启用')

// ===== 牵线管理：添加牵线记录 =====
const matchAddSheetVisible = ref(false)
const matchAddPickerVisible = ref(false)
const matchAddPickerKind = ref('from')
const matchAddFromId = ref('')
const matchAddFromName = ref('')
const matchAddToId = ref('')
const matchAddToName = ref('')
const matchAddAppliedAt = ref('')
const matchAddFinishedAt = ref('')
const matchAddResult = ref('SUCCEEDED')
const matchAddFailureReason = ref('')
const matchAddError = ref('')
const matchAddSubmitting = ref(false)
const matchAddLoading = ref(false)
const matchAddCandidates = ref<any[]>([])
// 会员选择弹层支持按名字 / 编号搜索（待我牵线 → 添加牵线记录）
const matchAddSearch = ref('')
const onMatchAddSearchInput = (event: any) => {
	matchAddSearch.value = event.detail.value
}
const matchAddFilteredCandidates = computed(() => {
	const rows = matchAddCandidates.value
	const keyword = matchAddSearch.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any): boolean => {
		const content = (String(item.name) + String(item.id) + String(item.gender)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const matchAddResultsLabel = computed(() => {
	const count = String(matchAddFilteredCandidates.value.length)
	return matchAddSearch.value.trim().length > 0 ? '搜索结果（' + count + '）' : '可选会员（' + count + '）'
})
const openMatchAddSheet = () => {
	matchAddFromId.value = ''
	matchAddFromName.value = ''
	matchAddToId.value = ''
	matchAddToName.value = ''
	matchAddAppliedAt.value = ''
	matchAddFinishedAt.value = ''
	matchAddResult.value = 'SUCCEEDED'
	matchAddFailureReason.value = ''
	matchAddError.value = ''
	matchAddSheetVisible.value = true
}
const openMatchAddPicker = async (kind: string) => {
	matchAddPickerKind.value = kind
	matchAddSearch.value = ''
	matchAddPickerVisible.value = true
	if (matchAddCandidates.value.length == 0) {
		matchAddLoading.value = true
		try {
			await loadWorkspaceMembers()
			const rows = workspaceMembers.value
			const options: any[] = []
			for (let i = 0; i < rows.length; i++) {
				const row = rows[i]
				options.push({
					id: String(row.id),
					name: String(row.name || '未命名会员'),
					gender: String(row.gender || '未填写'),
					avatar: String(row.avatar || '')
				})
			}
			matchAddCandidates.value = options
		} catch (e) {
			showToast('会员列表加载失败')
		} finally {
			matchAddLoading.value = false
		}
	}
}
const isMatchAddPicked = (id: string) => {
	return (matchAddPickerKind.value == 'from' && matchAddToId.value == id) || (matchAddPickerKind.value == 'to' && matchAddFromId.value == id)
}
const pickMatchAddMember = (m: any) => {
	if (matchAddPickerKind.value == 'from') {
		matchAddFromId.value = m.id
		matchAddFromName.value = m.name
	} else {
		matchAddToId.value = m.id
		matchAddToName.value = m.name
	}
	matchAddPickerVisible.value = false
}
const submitMatchAdd = async () => {
	if (matchAddSubmitting.value) return
	if (matchAddFromId.value.length == 0) { matchAddError.value = '请选择牵线会员'; return }
	if (matchAddToId.value.length == 0) { matchAddError.value = '请选择被牵线会员'; return }
	if (matchAddFromId.value == matchAddToId.value) { matchAddError.value = '牵线双方不能是同一人'; return }
	if (matchAddResult.value == 'SUCCEEDED' && matchAddFinishedAt.value == '') { matchAddError.value = '牵线成功需要选择牵线完成时间'; return }
	if (matchAddResult.value == 'FAILED' && matchAddFailureReason.value.trim().length == 0) { matchAddError.value = '牵线失败需要填写失败原因'; return }
	matchAddSubmitting.value = true
	matchAddError.value = ''
	try {
		const result = await createMatchmakerIntroduction({
			fromUserId: matchAddFromId.value, toUserId: matchAddToId.value,
			appliedAt: matchAddAppliedAt.value || '', finishedAt: matchAddFinishedAt.value || '',
			result: matchAddResult.value, failureReason: matchAddFailureReason.value
		})
		if (!result.success) {
			matchAddError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '添加失败，请稍后重试'
			return
		}
		matchAddSheetVisible.value = false
		showToast('牵线记录已添加')
		await loadWorkspaceMatches()
	} catch (e) {
		matchAddError.value = '网络异常，请稍后重试'
	} finally {
		matchAddSubmitting.value = false
	}
}

// ===== 牵线管理：牵线状态弹窗（失败必填原因，其他状态无备注） =====
const matchStatusSheetVisible = ref(false)
const matchStatusRow = ref<any>(null)
const matchStatusChoice = ref('IN_PROGRESS')
const matchFailureReason = ref('')
const matchStatusSubmitting = ref(false)
const matchStatusOptions = [
	{ value: 'IN_PROGRESS', label: '牵线中' },
	{ value: 'PENDING', label: '待牵线' },
	{ value: 'SUCCEEDED', label: '牵线成功' },
	{ value: 'FAILED', label: '牵线失败' }
]
const openMatchStatusSheet = (row: any) => {
	matchStatusRow.value = row
	matchStatusChoice.value = String(row.status) == 'PENDING' ? 'IN_PROGRESS' : String(row.status)
	matchFailureReason.value = ''
	matchStatusSheetVisible.value = true
}
const submitMatchStatus = async () => {
	const row = matchStatusRow.value
	if (row == null || matchStatusSubmitting.value) return
	if (matchStatusChoice.value == 'FAILED' && matchFailureReason.value.trim().length == 0) {
		showToast('牵线失败需要填写失败原因')
		return
	}
	matchStatusSubmitting.value = true
	try {
		const result = await updateMatchmakerIntroductionStatus(String(row.id), matchStatusChoice.value, matchFailureReason.value)
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			return
		}
		matchStatusSheetVisible.value = false
		showToast('牵线状态已更新')
		await loadWorkspaceMatches()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		matchStatusSubmitting.value = false
	}
}

// ===== 约见申请：审核状态弹窗 / 删除确认 / 回顶部 =====
const meetingStatusSheetVisible = ref(false)
const meetingStatusRow = ref<any>(null)
const meetingStatusChoice = ref('ACCEPTED')
const meetingStatusSubmitting = ref(false)
const meetingDeleteSheetVisible = ref(false)
const meetingDeleteRow = ref<any>(null)
const meetingDeleteSubmitting = ref(false)
// 已处理选项映射服务端状态；待处理回 SUBMITTED 用于误操作还原。
const openMeetingStatusSheet = (row: any) => {
	meetingStatusRow.value = row
	meetingStatusChoice.value = row.phase == 'PROCESSING' ? 'ACCEPTED' : 'SUBMITTED'
	meetingStatusSheetVisible.value = true
}
const submitMeetingStatus = async () => {
	const row = meetingStatusRow.value
	if (row == null || meetingStatusSubmitting.value) return
	meetingStatusSubmitting.value = true
	try {
		const result = await updateMatchmakerMeetingStatus(String(row.id), meetingStatusChoice.value)
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			return
		}
		meetingStatusSheetVisible.value = false
		showToast('状态已更新')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingStatusSubmitting.value = false
	}
}
const openMeetingDeleteSheet = (row: any) => {
	meetingDeleteRow.value = row
	meetingDeleteSheetVisible.value = true
}
const submitMeetingDelete = async () => {
	const row = meetingDeleteRow.value
	if (row == null || meetingDeleteSubmitting.value) return
	meetingDeleteSubmitting.value = true
	try {
		const result = await deleteMatchmakerMeetingRequest(String(row.id))
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '删除失败')
			return
		}
		meetingDeleteSheetVisible.value = false
		showToast('记录已删除')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingDeleteSubmitting.value = false
	}
}

// ===== 约见安排：排期弹层 / 安排状态弹层 =====
const meetingScheduleSheetVisible = ref(false)
const meetingScheduleRow = ref<any>(null)
const meetingScheduleDate = ref('')
const meetingScheduleTime = ref('')
const meetingScheduleLocation = ref('')
const meetingScheduleSubmitting = ref(false)
const meetingScheduleError = ref('')
const meetingScheduleMinDate = ref('')
const meetingRecordSheetVisible = ref(false)
const meetingRecordRow = ref<any>(null)
const meetingRecordChoice = ref('REMINDED')
const meetingRecordReason = ref('')
const meetingRecordSubmitting = ref(false)

const padMeetingNumber = (value: number): string => String(value).padStart(2, '0')

const openMeetingScheduleSheet = (row: any) => {
	const now = new Date()
	meetingScheduleMinDate.value = String(now.getFullYear()) + '-' + padMeetingNumber(now.getMonth() + 1) + '-' + padMeetingNumber(now.getDate())
	meetingScheduleRow.value = row
	meetingScheduleDate.value = ''
	meetingScheduleTime.value = ''
	meetingScheduleLocation.value = ''
	meetingScheduleError.value = ''
	meetingScheduleSheetVisible.value = true
}
const onMeetingScheduleDate = (event: any) => { meetingScheduleDate.value = event.detail.value }
const onMeetingScheduleTime = (event: any) => { meetingScheduleTime.value = event.detail.value }
const submitMeetingSchedule = async () => {
	const row = meetingScheduleRow.value
	if (row == null || meetingScheduleSubmitting.value) return
	if (meetingScheduleDate.value == '' || meetingScheduleTime.value == '') {
		meetingScheduleError.value = '请选择约见日期和时间'
		return
	}
	if (meetingScheduleLocation.value.trim().length == 0) {
		meetingScheduleError.value = '请填写约见地点'
		return
	}
	meetingScheduleSubmitting.value = true
	meetingScheduleError.value = ''
	try {
		const result = await scheduleMatchmakerMeeting(String(row.id), meetingScheduleDate.value + 'T' + meetingScheduleTime.value + ':00', meetingScheduleLocation.value)
		if (!result.success) {
			meetingScheduleError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '约见安排失败'
			return
		}
		meetingScheduleSheetVisible.value = false
		showToast('约见已安排')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingScheduleSubmitting.value = false
	}
}
const openMeetingRecordSheet = (row: any) => {
	const meeting = row != null && row.meeting != null ? row.meeting : null
	const currentStatus = meeting != null && meeting.status != null ? String(meeting.status) : 'SCHEDULED'
	meetingRecordRow.value = row
	meetingRecordChoice.value = currentStatus == 'SCHEDULED' ? 'REMINDED' : currentStatus
	meetingRecordReason.value = ''
	meetingRecordSheetVisible.value = true
}
const submitMeetingRecordStatus = async () => {
	const row = meetingRecordRow.value
	if (row == null || meetingRecordSubmitting.value) return
	if (row.meeting == null) {
		showToast('该申请还没有约见安排')
		return
	}
	if ((meetingRecordChoice.value == 'CANCELLED' || meetingRecordChoice.value == 'NO_SHOW') && meetingRecordReason.value.trim().length == 0) {
		showToast(meetingRecordChoice.value == 'CANCELLED' ? '取消约见需要填写原因' : '爽约需要填写说明')
		return
	}
	meetingRecordSubmitting.value = true
	try {
		const result = await updateMatchmakerMeetingRecordStatus(String(row.meeting.id), meetingRecordChoice.value, meetingRecordReason.value)
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			return
		}
		meetingRecordSheetVisible.value = false
		showToast('约见状态已更新')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingRecordSubmitting.value = false
	}
}
const workspaceScrollTop = ref(0)
const scrollWorkspaceTop = () => {
	// scroll-top 仅在值变化时触发滚动；0 与 0.1 交替保证重复点击同样回到顶部。
	workspaceScrollTop.value = workspaceScrollTop.value == 0 ? 0.1 : 0
}

const openWorkspace = async (title: string, kind: string, initialTab: string = '') => {
	workspaceTitle.value = title
	workspaceKind.value = kind
	workspaceActiveTab.value = initialTab.length > 0 ? initialTab : (kind == 'commission' ? (title == '财务明细' ? '财务明细' : '分成明细') : (kind == 'lead' ? '客源线索' : (kind == 'news' ? '喜讯' : '全部')))
	workspaceKeyword.value = ''
	workspaceVisible.value = true
	if (kind == 'entry') {
		// 录入客源线索 / 录入会员：重置线索表单，避免残留上一次填写。
		leadFormRealName.value = ''
		leadFormName.value = ''
		leadFormPhone.value = ''
		leadFormWechat.value = ''
		leadFormSource.value = ''
		leadFormSourcePickerVisible.value = false
		leadFormRemark.value = ''
		leadFormIntention.value = 1
		leadFormPhoto.value = ''
		leadFormGender.value = 0
		leadFormBirthday.value = ''
		leadFormError.value = ''
	}
	if (kind == 'member') await loadWorkspaceMembers()
	if (kind == 'lead') await loadWorkspaceLeads()
	if (kind == 'match') await loadWorkspaceMatches()
	if (kind == 'meeting') await loadWorkspaceMeetings()
	// 「线上分成」与「财务明细」各读服务端；「专属推广工具」没有对应数据源，仍是演示数据。
	if (kind == 'commission' && title == '线上分成') await loadWorkspaceCommissionEntries()
	if (kind == 'commission' && title == '财务明细') await loadWorkspaceOfflineIncome()
	if (kind == 'news') {
		newsStage.value = ''
		newsDetailId.value = ''
		await Promise.all([loadWorkspaceNews(), loadWorkspacePennants()])
	}
}

const refreshManagementCenter = async () => {
	await loadManagementAccess()
	if (!canEnterManagementCenter.value) {
		exitManagementCenter()
		showToast('当前开通状态已变化，已返回申请页')
		return
	}
	try {
		const result = await getMatchmakerManagementCenterSnapshot()
		if (result.success && result.data != null) {
			managementCenterSnapshot.value = result.data
			await Promise.all([refreshBusinessMetricCounts(), refreshServedMemberCount()])
			showToast('工作台已刷新')
		} else {
			showToast(result.message != null ? String(result.message) : '工作台刷新失败')
		}
	} catch (e) {
		showToast('工作台刷新失败，请检查网络后重试')
	}
}

const handleManagementCenterAction = (name: string) => {
	// 数据看板：四项直达——我的会员进资料待审「我的」，牵线成功进牵线列表「成功」，两条金额进对应明细
	if (name == 'metric:my_members') {
		openPendingReview('mine')
		return
	}
	if (name == 'metric:online_commission') {
		openWorkspace('线上分成', 'commission')
		return
	}
	if (name == 'metric:offline_performance') {
		openWorkspace('财务明细', 'commission')
		return
	}
	if (name == 'metric:pending_introduction') {
		openWorkspace('待我牵线', 'match', '待牵线')
		return
	}
	if (name == 'metric:introduction_succeeded') {
		openWorkspace('牵线成功', 'match', '成功')
		return
	}
	if (name == 'metric:meeting_requests') {
		openWorkspace('约见申请', 'meeting', '处理中')
		return
	}
	if (name == 'metric:pending_meeting') {
		openWorkspace('待见面', 'meeting', '待见面')
		return
	}
	if (name == '资料待审') {
		openPendingReview('PENDING')
		return
	}
	if (name == '查看全部会员') {
		openPendingReview('')
		return
	}
	if (name == '查看我服务的' || name == '我服务的') {
		openPendingReview('mine')
		return
	}
	if (name == '分成明细' || name == '查看分成明细' || name == '财务明细' || name == '查看财务明细') {
		openWorkspace(name.indexOf('财务') >= 0 ? '财务明细' : '线上分成', 'commission')
		return
	}
	if (name == '录入线索' || name == '录入会员') {
		openWorkspace(name == '录入线索' ? '录入客源线索' : '录入会员', 'entry')
		return
	}
	if (name.indexOf('客源') >= 0) {
		openWorkspace('客源线索', 'lead')
		return
	}
	if (name.indexOf('约见') >= 0 || name.indexOf('约会') >= 0 || name == '安排约见') {
		openWorkspace(name.indexOf('约会') >= 0 ? '待见面' : '约见申请', 'meeting', name.indexOf('约会') >= 0 ? '待见面' : '')
		return
	}
	if (name.indexOf('牵线') >= 0 || name == '添加牵线') {
		openWorkspace(name == '查看牵线记录' ? '牵线管理' : name, 'match')
		return
	}
	if (name.indexOf('推广') >= 0 || name.indexOf('海报') >= 0 || name.indexOf('链接') >= 0) {
		openWorkspace('专属推广工具', 'commission')
		return
	}
	if (name.indexOf('活动') >= 0) {
		openWorkspace(name, 'activity')
		return
	}
	if (name.indexOf('会员') >= 0 || name.indexOf('我服务的') >= 0) {
		openWorkspace(name.replace('查看', ''), 'member')
		return
	}
	if (name.indexOf('账号') >= 0) {
		openMyAccount()
		return
	}
	openWorkspace(name.replace('查看', ''), 'general')
}

const openMatchmakerIdentity = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/certification',
		fail: () => showToast('个人身份信息打开失败，请稍后重试')
	})
}

// 服务导航下拉菜单：组件只回报选项，跳转按红娘中心角色决定。
const serviceNavVisible = ref(false)
const openPage = (url: string) => {
	uni.navigateTo({ url: url, fail: () => showToast('页面打开失败，请稍后重试') })
}
// 「我的账号」：红娘管理中心子页面——会员端「我的」页的精简版，共用账号数据但页面独立。
const openMyAccount = () => {
	uni.navigateTo({
		url: '/pagesSub/matchmaker/my-account',
		fail: () => showToast('我的账号打开失败，请稍后重试')
	})
}
const onServiceNavSelect = (key: string) => {
	serviceNavVisible.value = false
	if (key == 'member_zone') { uni.reLaunch({ url: '/pages/index/index?tab=2', fail: () => showToast('会员分区打开失败，请稍后重试') }); return }
	if (key == 'filter') { openPendingReview(''); return }
	if (key == 'activity') { openPage('/pagesSub/community/activity-list'); return }
	if (key == 'news') { openWorkspace('红娘喜讯', 'news'); return }
	if (key == 'custom') { openPage('/pagesSub/matchmaker/custom'); return }
	if (key == 'vip') { openPage('/pagesSub/profileExtra/vip'); return }
	if (key == 'matchmaker_center') { showToast('当前已在红娘中心'); return }
	if (key == 'about') { openPage('/pagesSub/about/about'); return }
	// 「我的账号」「短视频」入口已从红娘中心的服务导航隐藏（服务导航不再展示这两项），
	// 故此处不再处理 member_center / video；账号页由管理中心顶栏入口进入。
	if (key == 'intro_outgoing' || key == 'intro_incoming') { openWorkspace('牵线管理', 'match'); return }
	if (key == 'meeting') { openWorkspace('约会管理', 'meeting', '待见面'); return }
}

onLoad((options: any) => {
	// 会员主页「编辑资料」入口：进入页面后自动打开资料待审列表
	autoOpenPendingReview.value = options != null && (options.openPendingReview == '1' || options.openPendingReview == 1 || options.openPendingReview === true)
	// 直达工作区：?workspace=meeting（约见申请）/ ?workspace=match（待我牵线）
	autoOpenWorkspace.value = options != null && options.workspace != null ? String(options.workspace) : ''
})

onShow(async () => {
	if (autoOpenPendingReview.value) {
		autoOpenPendingReview.value = false
		await loadManagementAccess()
		await openManagementCenter()
		if (managementCenterVisible.value) openPendingReview('PENDING')
		return
	}
	if (autoOpenWorkspace.value.length > 0) {
		const kind = autoOpenWorkspace.value
		autoOpenWorkspace.value = ''
		await loadManagementAccess()
		await openManagementCenter()
		if (managementCenterVisible.value) {
			if (kind == 'meeting') openWorkspace('约见申请', 'meeting', '处理中')
			else if (kind == 'match') openWorkspace('待我牵线', 'match', '待牵线')
		}
		return
	}
	if (!managementCenterVisible.value && !pendingReviewVisible.value && !workspaceVisible.value) loadManagementAccess()
})

const guideToRequiredVerification = (message: string) => {
	const needsPhone = message.indexOf('绑定手机号') >= 0
	uni.showModal({
		title: needsPhone ? '请先绑定手机号' : '请先完成实名认证',
		content: needsPhone ? '绑定手机号后，还需要完成实名认证才可提交申请。' : '实名认证审核通过后即可提交申请。',
		confirmText: '去完成',
		success: (modal: any) => {
			if (modal.confirm) {
				uni.navigateTo({ url: '/pages/profile/certification?focus=' + (needsPhone ? 'phone' : 'realname') + '&returnTo=matchmaker' })
			}
		}
	})
}

const showExistingApplication = () => {
	uni.showModal({
		title: '申请正在审核',
		content: '你已提交服务红娘申请，请等待平台审核结果，无需重复提交。',
		confirmText: '查看状态',
		success: (modal: any) => {
			if (modal.confirm) uni.redirectTo({ url: '/pagesSub/matchmaker/application-success?type=service_matchmaker' })
		}
	})
}

// ===== 导航 =====
const goBack = () => {
	uni.navigateBack()
}

const handlePageBack = () => {
	if (pendingReviewVisible.value) {
		closePendingReview()
		return
	}
	if (workspaceVisible.value) {
		closeWorkspace()
		return
	}
	goBack()
}

