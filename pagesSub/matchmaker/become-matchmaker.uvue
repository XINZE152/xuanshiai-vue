const leadStatusLabel = (status: string): string => {
	for (let i = 0; i < leadStatusMeta.length; i++) {
		if (leadStatusMeta[i].value == status) return leadStatusMeta[i].label as string
	}
	return '找对象中'
}

const formatLeadTime = (value: any): string => {
	if (value == null) return ''
	return String(value).replace('T', ' ').substring(0, 16)
}

const daysBetweenNow = (timeText: string): number => {
	if (timeText.length == 0) return 0
	const past = new Date(timeText.replace(' ', 'T') + ':00').getTime()
	if (isNaN(past)) return 0
	return Math.floor((Date.now() - past) / 86400000)
}

// 生日存的是 YYYY-MM-DD（历史数据也可能只有年月），按满周岁算：今年生日还没到就减一岁。
const leadAgeFromBirthday = (value: any): number => {
	if (value == null) return 0
	const text = String(value).trim()
	if (text.length < 4) return 0
	const year = Number(text.substring(0, 4))
	if (isNaN(year) || year < 1900) return 0
	const today = new Date()
	let age = today.getFullYear() - year
	if (text.length >= 7) {
		const month = Number(text.substring(5, 7))
		if (!isNaN(month) && month >= 1 && month <= 12) {
			const dayText = text.length >= 10 ? Number(text.substring(8, 10)) : 1
			const day = isNaN(dayText) || dayText < 1 ? 1 : dayText
			const currentMonth = today.getMonth() + 1
			if (currentMonth < month || (currentMonth == month && today.getDate() < day)) age = age - 1
		}
	}
	return age > 0 && age < 120 ? age : 0
}

const loadWorkspaceLeads = async () => {
	workspaceLeadsLoading.value = true
	workspaceLeadsError.value = ''
	try {
		const result = await getMatchmakerWorkspaceLeads()
		if (!result.success || result.data == null) {
			workspaceLeads.value = []
			workspaceLeadsError.value = result.message != null ? String(result.message) : '客源数据加载失败'
			return
		}
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		workspaceLeads.value = items.map((item: any) => {
			const status = item.status != null ? String(item.status) : 'NEW'
			const intentionLevel = item.intention_level != null ? Number(item.intention_level) : 1
			const sourceIntentionValue = item.intention_value != null ? Number(item.intention_value) : (item.intentionValue != null ? Number(item.intentionValue) : 0)
			const knownIntention = leadIntentionDetails.value[String(item.id)] != null ? Number(leadIntentionDetails.value[String(item.id)]) : (sourceIntentionValue >= 1 && sourceIntentionValue <= 9 ? sourceIntentionValue : leadIntentionDefaultValue(intentionLevel))
			const lastFollowAt = item.last_follow_up_at != null ? formatLeadTime(item.last_follow_up_at) : ''
			const staleDays = lastFollowAt.length > 0 ? daysBetweenNow(lastFollowAt) : daysBetweenNow(formatLeadTime(item.created_at))
			const gender = item.gender != null ? Number(item.gender) : 0
			return {
				id: String(item.id),
				name: item.name != null ? String(item.name) : '未命名客源',
				realName: item.real_name != null ? String(item.real_name) : '',
				phone: item.phone != null && String(item.phone).length > 0 ? String(item.phone) : '未提供',
				wechat: item.wechat != null && String(item.wechat).length > 0 ? String(item.wechat) : '未提供',
				source: item.source != null ? String(item.source) : '未知来源',
				// 录入人取 created_by 的红娘显示名；捞取时后端把 created_by 换成捞取人，所以「谁捞回归谁」。
				creator: item.creator_name != null && String(item.creator_name).length > 0 ? String(item.creator_name) : '未记录',
				status: status,
				statusLabel: leadStatusLabel(status),
				statusTone: leadStatusTones[status] != null ? leadStatusTones[status] as string : 'new',
				// 弃海池的卡片头部时间按弃海时点显示，与「按弃海时间倒序」同一口径；存量没有生效弃海行的仍显示登记时间。
				time: status == 'LOST' && item.abandoned_at != null ? formatLeadTime(item.abandoned_at) : formatLeadTime(item.created_at),
				owner: item.matchmaker_name != null && String(item.matchmaker_name).length > 0 ? String(item.matchmaker_name) : '未分派',
				matchmakerId: item.matchmaker_id != null ? Number(item.matchmaker_id) : 0,
				remark: item.remark != null ? String(item.remark) : '',
				abandonReason: item.abandon_reason != null ? String(item.abandon_reason) : '',
				abandonedAt: item.abandoned_at != null ? String(item.abandoned_at) : '',
				intentionLevel: intentionLevel,
				intentionValue: knownIntention,
				intentionLabel: leadIntentionOption(knownIntention).label as string,
				lastFollowAt: lastFollowAt,
				isStale: status != 'LOST' && status != 'CLOSED' && status != 'CONVERTED' && staleDays >= 10,
				followSummary: lastFollowAt.length > 0 ? '最近跟进 ' + lastFollowAt.substring(5, 10) : '暂无跟进记录',
				convertedUserId: item.converted_user_id != null ? String(item.converted_user_id) : '',
				photo: item.photo != null ? String(item.photo) : '',
				gender: gender,
				birthday: item.birthday != null ? String(item.birthday) : '',
				genderMark: gender == 1 ? '♂ 男' : (gender == 2 ? '♀ 女' : '未填'),
				genderTone: gender == 1 ? 'male' : (gender == 2 ? 'female' : 'unknown'),
				// 年龄由生日现算，未填生日或年份不可用时为 0，卡片上整块不显示。
				age: leadAgeFromBirthday(item.birthday),
				// 「入库」胶囊：只有 CONVERTED 算入库；弃海/关闭的客源也如实显示未入库。
				intakeLabel: status == 'CONVERTED' ? '已入库' : '未入库',
				intakeTone: status == 'CONVERTED' ? 'done' : 'todo'
			}
		})
	} catch (e) {
		workspaceLeads.value = []
		workspaceLeadsError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		workspaceLeadsLoading.value = false
	}
}

// ===== 客源线索：工具栏与筛选 =====
const leadFilterStatus = ref<string[]>([])
const leadFilterIntention = ref(0)

const leadFilterSheetVisible = ref(false)
const openLeadFilterSheet = () => { leadFilterSheetVisible.value = true }
const toggleLeadFilterStatus = (value: string) => {
	const idx = leadFilterStatus.value.indexOf(value)
	if (idx >= 0) {
		leadFilterStatus.value = leadFilterStatus.value.filter((item: string): boolean => item != value)
	} else {
		leadFilterStatus.value = leadFilterStatus.value.concat([value])
	}
}
const resetLeadFilter = () => {
	leadFilterStatus.value = []
	leadFilterIntention.value = 0
}
const applyLeadFilter = () => {
	leadFilterSheetVisible.value = false
	showToast('已按条件筛选 ' + String(workspaceVisibleLeads.value.length) + ' 条客源')
}

// ===== 客源线索：状态选择 =====
const leadStatusSheetVisible = ref(false)
const leadStatusCurrent = ref('')
const leadStatusLeadId = ref('')
const openLeadStatusSheet = (row: any) => {
	leadStatusLeadId.value = String(row.id)
	leadStatusCurrent.value = String(row.status)
	leadStatusSheetVisible.value = true
}
const selectLeadStatus = async (value: string) => {
	if (value == leadStatusCurrent.value) {
		leadStatusSheetVisible.value = false
		return
	}
	try {
		const result = await updateWorkspaceLead(leadStatusLeadId.value, { status: value })
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '状态修改失败')
			return
		}
		leadStatusSheetVisible.value = false
		showToast('状态已更新为「' + leadStatusLabel(value) + '」')
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

const leadIntentionOption = (value: number): any => {
	for (let i = 0; i < leadIntentionOptions.length; i++) {
		if (leadIntentionOptions[i].value == value) return leadIntentionOptions[i]
	}
	return leadIntentionOptions[0]
}

const leadIntentionDefaultValue = (level: number): number => {
	if (level == 2) return 2
	if (level == 3) return 4
	return 1
}

// ===== 客源线索：意向选择 =====
const leadIntentionSheetVisible = ref(false)
const leadIntentionCurrent = ref(1)
const leadIntentionLeadId = ref('')
const openLeadIntentionSheet = (row: any) => {
	leadIntentionLeadId.value = String(row.id)
	leadIntentionCurrent.value = Number(row.intentionValue) >= 1 && Number(row.intentionValue) <= 9 ? Number(row.intentionValue) : leadIntentionDefaultValue(Number(row.intentionLevel))
	leadIntentionSheetVisible.value = true
}
const selectLeadIntention = async (value: number) => {
	if (value == leadIntentionCurrent.value) {
		leadIntentionSheetVisible.value = false
		return
	}
	try {
		const option = leadIntentionOption(value)
		const result = await updateWorkspaceLead(leadIntentionLeadId.value, { intentionLevel: option.level, intentionValue: value })
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '意向更新失败')
			return
		}
		leadIntentionDetails.value[leadIntentionLeadId.value] = value
		leadIntentionSheetVisible.value = false
		showToast('意向已更新')
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

// ===== 客源线索：分派跟进 =====
const leadAssignSheetVisible = ref(false)
const leadAssignCurrent = ref(0)
const leadAssignLeadId = ref('')
const leadFollowers = ref<any[]>([])
const leadFollowersLoading = ref(false)
const leadFollowersLoaded = ref(false)
const openLeadAssignSheet = async (row: any) => {
	leadAssignLeadId.value = String(row.id)
	leadAssignCurrent.value = Number(row.matchmakerId)
	leadAssignSheetVisible.value = true
	if (!leadFollowersLoaded.value) {
		leadFollowersLoading.value = true
		try {
			const result = await getWorkspaceLeadFollowers()
			if (result.success && result.data != null) {
				const list = Array.isArray(result.data) ? result.data : []
				leadFollowers.value = list.map((item: any) => ({
					userId: Number(item.user_id),
					displayName: item.display_name != null ? String(item.display_name) : '服务红娘',
					isSelf: item.is_self == true
				}))
				leadFollowersLoaded.value = true
			} else {
				showToast(result.message != null ? String(result.message) : '红娘列表加载失败')
			}
		} catch (e) {
			showToast('网络异常，请稍后重试')
		} finally {
			leadFollowersLoading.value = false
		}
	}
}
const selectLeadAssign = async (follower: any) => {
	if (follower.userId == leadAssignCurrent.value) {
		leadAssignSheetVisible.value = false
		return
	}
	try {
		const result = await assignWorkspaceLead(leadAssignLeadId.value, follower.userId)
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '分派失败')
			return
		}
		leadAssignSheetVisible.value = false
		showToast('已分派给 ' + follower.displayName + ' 跟进')
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

// ===== 客源线索：跟进记录面板 =====
const leadFollowPanelVisible = ref(false)
const leadFollowLeadId = ref('')
const leadFollowLeadName = ref('')
const leadFollowLoading = ref(false)
const leadFollowError = ref('')
const leadFollowRecords = ref<any[]>([])
const leadFollowMethods = [
	{ value: 'PHONE', label: '电话' },
	{ value: 'WECHAT', label: '微信' },
	{ value: 'VISIT', label: '到店' },
	{ value: 'OTHER', label: '其他' }
]
const leadFollowMethod = ref('PHONE')
const leadFollowContent = ref('')
const openLeadFollowPanel = (row: any) => {
	leadFollowLeadId.value = String(row.id)
	leadFollowLeadName.value = String(row.name)
	leadFollowPanelVisible.value = true
	loadLeadFollowRecords()
}
const closeLeadFollowPanel = () => {
	leadFollowPanelVisible.value = false
	leadFollowContent.value = ''
}
const loadLeadFollowRecords = async () => {
	leadFollowLoading.value = true
	leadFollowError.value = ''
	try {
		const result = await getWorkspaceLeadFollowUps(leadFollowLeadId.value)
		if (!result.success || result.data == null) {
			leadFollowRecords.value = []
			leadFollowError.value = result.message != null ? String(result.message) : '跟进记录加载失败'
			return
		}
		const items = Array.isArray(result.data.items) ? result.data.items : []
		leadFollowRecords.value = items.map((item: any) => ({
			id: String(item.id),
			methodLabel: followUpMethodLabels[item.method] != null ? followUpMethodLabels[item.method] as string : '其他',
			content: item.content != null ? String(item.content) : '',
			time: formatLeadTime(item.created_at),
			intentionLabel: item.intention_level != null ? (intentionLabels[Number(item.intention_level)] as string) : ''
		}))
	} catch (e) {
		leadFollowRecords.value = []
		leadFollowError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		leadFollowLoading.value = false
	}
}
const submitLeadFollowUp = async () => {
	const content = leadFollowContent.value.trim()
	if (content.length == 0) {
		showToast('请填写跟进内容')
		return
	}
	try {
		const result = await addWorkspaceLeadFollowUp(leadFollowLeadId.value, { method: leadFollowMethod.value, content: content })
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '跟进保存失败')
			return
		}
		leadFollowContent.value = ''
		showToast('跟进已记录')
		await loadLeadFollowRecords()
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

// ===== 客源线索：添加 / 编辑 =====
const leadFormSheetVisible = ref(false)
const leadFormIsEdit = ref(false)
const leadFormLeadId = ref('')
const leadFormRealName = ref('')
const leadFormName = ref('')
const leadFormPhone = ref('')
const leadFormWechat = ref('')
const leadFormSource = ref('')
const leadFormRemark = ref('')
const leadFormIntention = ref(1)
const leadFormPhoto = ref('')
const leadFormGender = ref(0)
const leadFormBirthday = ref('')
const leadFormError = ref('')
const leadFormSubmitting = ref(false)
const leadFormSourcePickerVisible = ref(false)
const leadFormSourceLabel = computed<string>(() => leadFormSource.value.length > 0 ? leadFormSource.value : '请选择来源渠道')
const pickLeadFormSource = (value: string) => {
	leadFormSource.value = value
	leadFormSourcePickerVisible.value = false
}
// 录入视图示例数据：一键填充全表单便于联调，再点一次清空。
const leadDemoFilled = computed(() => leadFormRealName.value != '' || leadFormName.value != '' || leadFormPhone.value != '' || leadFormWechat.value != '' || leadFormRemark.value != '')
const leadSourceOptions = ['抖音', '微信群', '本地群', '身边朋友', '同行群', '朋友圈', 'QQ', '其他渠道', '落地页']
const DEMO_FEMALE_OCCUPATIONS: string[] = ['平面设计师', '幼儿园教师', '会计', '护士', '产品经理', '咖啡师', '律师助理', '摄影师']
const DEMO_MALE_OCCUPATIONS: string[] = ['软件工程师', '中学教师', '健身教练', '机械工程师', '医生', '销售主管', '摄影师', '会计师']
const DEMO_EDUCATIONS: string[] = ['大专', '本科', '本科', '硕士']
const DEMO_FEMALE_WISHES: string[] = ['希望找同城、有稳定工作的对象', '希望找性格沉稳、愿意沟通的先生', '希望对方同样未婚，计划在本地长期发展']
const DEMO_MALE_WISHES: string[] = ['希望找同城、未婚的伴侣', '希望找性格温和、有共同话题的女生', '希望对方以结婚为目标交往，不接受异地']
const demoTwo = (value: number): string => String(value).padStart(2, '0')
// 线索示例：每次点换一个新人设、手机号重新生成，方便连续提交多条线索不撞手机号。
const fillLeadDemo = () => {
	if (leadDemoFilled.value) {
		leadFormRealName.value = ''
		leadFormName.value = ''
		leadFormPhone.value = ''
		leadFormWechat.value = ''
		leadFormSource.value = ''
		leadFormRemark.value = ''
		leadFormIntention.value = 1
		leadFormPhoto.value = ''
		leadFormGender.value = 0
		leadFormBirthday.value = ''
		leadFormError.value = ''
		return
	}
	const gender = demoPersonaGender[nextDemoPersona()]
	const realName = demoPick(gender == 2 ? DEMO_FEMALE_SURNAMES : DEMO_MALE_SURNAMES) + demoPick(gender == 2 ? DEMO_FEMALE_GIVENS : DEMO_MALE_GIVENS)
	const age = gender == 2 ? demoInt(23, 36) : demoInt(25, 40)
	const birthYear = new Date().getFullYear() - age
	const birthday = String(birthYear) + '-' + demoTwo(demoInt(1, 12)) + '-' + demoTwo(demoInt(1, 28))
	const height = gender == 2 ? demoInt(156, 170) : demoInt(168, 183)
	const education = demoPick(DEMO_EDUCATIONS)
	const occupation = demoPick(gender == 2 ? DEMO_FEMALE_OCCUPATIONS : DEMO_MALE_OCCUPATIONS)
	const wish = demoPick(gender == 2 ? DEMO_FEMALE_WISHES : DEMO_MALE_WISHES)
	leadFormRealName.value = realName
	leadFormName.value = realName + '（示例）'
	leadFormPhone.value = demoPick(DEMO_PHONE_PREFIXES) + String(demoInt(10000000, 99999999))
	leadFormWechat.value = 'wxid_' + String(demoInt(100000, 999999))
	leadFormSource.value = demoPick(leadSourceOptions)
	leadFormIntention.value = demoInt(1, 3)
	leadFormGender.value = gender
	leadFormBirthday.value = birthday
	leadFormRemark.value = String(age) + ' 岁，' + education + '，' + occupation + '，身高 ' + String(height) + 'cm，未婚。' + wish + '。'
	leadFormError.value = ''
}

// ===== 录入会员 = 会员账号建档：只收建号必需的三项 + 保密姓名，
// 资料字段一律交给「编辑资料」页（与会员本人「我的-资料编辑」同一张表单），提交后当场跳过去补。 =====
const emptyMemberEntry = (): any => ({
	nickname: '', realName: '', gender: 1, phone: ''
})
const memberEntry = ref<any>(emptyMemberEntry())
const memberEntrySubmitting = ref(false)
const memberEntryError = ref('')
const memberEntryFilled = computed(() => {
	const d = memberEntry.value
	return String(d.nickname).trim() != '' || String(d.phone).trim() != '' || String(d.realName).trim() != ''
})
// ===== 建号「填充示例」：每次点换一个新人设，手机号每次都重生成，
// 目的是让同一次联调里可以连续提交多条会员而不撞手机号。人设走洗牌发牌，
// 一轮 6 个不重复，发完再洗一次。资料字段不在这里，交给下一步的「编辑资料」。
const DEMO_PERSONA_COUNT = 6
const demoPersonaGender: number[] = [2, 1, 2, 1, 2, 1]
const DEMO_FEMALE_SURNAMES: string[] = ['钱', '林', '苏', '顾', '沈', '江', '温', '叶']
const DEMO_FEMALE_GIVENS: string[] = ['清越', '知雨', '映竹', '南乔', '予安', '语澄', '晚晴']
const DEMO_MALE_SURNAMES: string[] = ['陆', '周', '韩', '秦', '程', '许', '宋', '孟']
const DEMO_MALE_GIVENS: string[] = ['砚舟', '叙白', '承宇', '牧之', '亦航', '望舒', '行舟']
const DEMO_PHONE_PREFIXES: string[] = ['139', '138', '137', '136', '135', '159', '158', '188', '186', '177', '133', '199']
const demoPick = (items: string[]): string => items[Math.floor(Math.random() * items.length)]
const demoInt = (min: number, max: number): number => min + Math.floor(Math.random() * (max - min + 1))
let demoPersonaDeck: number[] = []
let demoPersonaDeal = 0
const nextDemoPersona = (): number => {
	if (demoPersonaDeal >= demoPersonaDeck.length) {
		demoPersonaDeck = []
		for (let i = 0; i < DEMO_PERSONA_COUNT; i++) { demoPersonaDeck.push(i) }
		for (let i = demoPersonaDeck.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1))
			const swap = demoPersonaDeck[i]
			demoPersonaDeck[i] = demoPersonaDeck[j]
			demoPersonaDeck[j] = swap
		}
		demoPersonaDeal = 0
	}
	const dealt = demoPersonaDeck[demoPersonaDeal]
	demoPersonaDeal = demoPersonaDeal + 1
	return dealt
}
// 建号示例只给这一页要收的四项；资料字段交给下一步的「编辑资料」，那里有自己的示例填充。
const fillMemberDemo = () => {
	if (memberEntryFilled.value) {
		memberEntry.value = emptyMemberEntry()
		memberEntryError.value = ''
		return
	}
	const persona = nextDemoPersona()
	const gender = demoPersonaGender[persona]
	const realName = demoPick(gender == 2 ? DEMO_FEMALE_SURNAMES : DEMO_MALE_SURNAMES) + demoPick(gender == 2 ? DEMO_FEMALE_GIVENS : DEMO_MALE_GIVENS)
	memberEntry.value = {
		nickname: realName + '（示例）', realName: realName, gender: gender,
		phone: demoPick(DEMO_PHONE_PREFIXES) + String(demoInt(10000000, 99999999))
	}
	memberEntryError.value = ''
}
const submitMemberEntry = async () => {
	if (memberEntrySubmitting.value) return
	const d = memberEntry.value
	const nickname = String(d.nickname).trim()
	const realName = String(d.realName).trim()
	const phone = String(d.phone).trim()
	if (nickname.length == 0) { memberEntryError.value = '请填写昵称'; return }
	if (realName.length == 0) { memberEntryError.value = '请填写姓名'; return }
	if (!/^1[3-9]\d{9}$/.test(phone)) { memberEntryError.value = '请填写正确的 11 位手机号'; return }
	memberEntrySubmitting.value = true
	memberEntryError.value = ''
	try {
		const result = await createMatchmakerWorkspaceMember({ nickname: nickname, realName: realName, gender: Number(d.gender), phone: phone })
		if (!result.success) {
			memberEntryError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '建号失败，请稍后重试'
			return
		}
		const created = result.data != null ? result.data : null
		const memberId = created != null && created.member_id != null ? String(created.member_id) : ''
		memberEntry.value = emptyMemberEntry()
		// 建号即落待审名单；当场打开该会员的「编辑资料」代填页，资料由同一张表单一次收齐。
		workspaceVisible.value = false
		openPendingReview('PENDING')
		if (memberId.length == 0) { showToast('会员已建号，请重新打开会员资料补填'); return }
		showToast('已建号 G' + memberId + '，请补全会员资料')
		uni.navigateTo({ url: '/pagesSub/userExtra/user/edit?memberId=' + memberId + '&matchmakerView=1' })
	} catch (e) {
		memberEntryError.value = '网络异常，请稍后重试'
	} finally {
		memberEntrySubmitting.value = false
	}
}
const openLeadAddSheet = () => {
	leadFormIsEdit.value = false
	leadFormLeadId.value = ''
	leadFormRealName.value = ''
	leadFormName.value = ''
	leadFormPhone.value = ''
	leadFormWechat.value = ''
	leadFormSource.value = ''
	leadFormRemark.value = ''
	leadFormPhoto.value = ''
	leadFormGender.value = 0
	leadFormBirthday.value = ''
	leadFormIntention.value = 1
	leadFormError.value = ''
	leadFormSheetVisible.value = true
}
const openLeadEditSheet = (row: any) => {
	leadFormIsEdit.value = true
	leadFormLeadId.value = String(row.id)
	leadFormRealName.value = row.realName != null ? String(row.realName) : ''
	leadFormName.value = String(row.name)
	leadFormPhone.value = row.phone == '未提供' ? '' : String(row.phone)
	leadFormWechat.value = row.wechat == '未提供' ? '' : String(row.wechat)
	leadFormSource.value = String(row.source)
	leadFormRemark.value = row.remark != null ? String(row.remark) : ''
	leadFormPhoto.value = row.photo != null ? String(row.photo) : ''
	leadFormGender.value = row.gender != null ? Number(row.gender) : 0
	leadFormBirthday.value = row.birthday != null && String(row.birthday).length > 0 ? String(row.birthday).substring(0, 10) : ''
	leadFormIntention.value = row.intentionLevel != null ? Number(row.intentionLevel) : 1
	leadFormError.value = ''
	leadFormSheetVisible.value = true
}
const chooseLeadPhoto = () => {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: async (res: any) => {
			const paths: any[] = res.tempFilePaths != null ? (res.tempFilePaths as any[]) : []
			if (paths.length == 0) return
			showToast('照片上传中…')
			try {
				const up = await uploadWorkspaceLeadPhoto(paths[0])
				if (up.success && up.data != null && up.data.url != null) {
					leadFormPhoto.value = String(up.data.url)
					showToast('照片已上传')
				} else {
					showToast(up.message != null ? String(up.message) : '照片上传失败')
				}
			} catch (e) {
				showToast('照片上传失败，请重试')
			}
		}
	})
}
const previewLeadPhoto = () => {
	if (leadFormPhoto.value.length == 0) return
	uni.previewImage({ urls: [leadFormPhoto.value] })
}
const onLeadFormBirthday = (event: any) => {
	leadFormBirthday.value = event.detail.value != null ? String(event.detail.value) : ''
}
// 联系方式唯一性：服务端做全局唯一校验（409），这里用已加载线索做即时预检。
const findLeadContactConflict = (phone: string, wechat: string, excludeLeadId: string): string => {
	for (let i = 0; i < workspaceLeads.value.length; i++) {
		const row = workspaceLeads.value[i]
		if (excludeLeadId.length > 0 && String(row.id) == excludeLeadId) continue
		const rowPhone = row.phone == '未提供' ? '' : String(row.phone).trim()
		const rowWechat = row.wechat == '未提供' ? '' : String(row.wechat).trim()
		if ((phone.length > 0 && rowPhone.length > 0 && rowPhone == phone) || (wechat.length > 0 && rowWechat.length > 0 && rowWechat == wechat)) {
			return String(row.name)
		}
	}
	return ''
}
const submitLeadForm = () => {
	const name = leadFormName.value.trim()
	if (name.length == 0) {
		leadFormError.value = '请填写客户称呼'
		return
	}
	const phone = leadFormPhone.value.trim()
	const wechat = leadFormWechat.value.trim()
	if (!/^1[3-9]\d{9}$/.test(phone)) {
		leadFormError.value = '请填写正确的 11 位手机号'
		return
	}
	const conflictLeadName = findLeadContactConflict(phone, wechat, leadFormIsEdit.value ? leadFormLeadId.value : '')
	if (conflictLeadName.length > 0) {
		leadFormError.value = '该联系方式已存在于线索「' + conflictLeadName + '」，请勿重复录入'
		return
	}
	// 打错一位就联系不上人，提交前把联系方式回显给红娘确认。
	uni.showModal({
		title: '确认联系方式',
		content: '称呼：' + name + '\n手机：' + phone + '\n微信：' + (wechat.length > 0 ? wechat : '未填写'),
		confirmText: '信息无误',
		cancelText: '返回修改',
		success: (modal: any) => {
			if (modal.confirm) sendLeadForm(name, phone, wechat)
		}
	})
}
const sendLeadForm = async (name: string, phone: string, wechat: string) => {
	leadFormSubmitting.value = true
	leadFormError.value = ''
	try {
		const payload = { realName: leadFormRealName.value.trim(), name: name, phone: phone, wechat: wechat, source: leadFormSource.value.trim(), intentionLevel: leadFormIntention.value, remark: leadFormRemark.value.trim(), photo: leadFormPhoto.value, gender: leadFormGender.value > 0 ? leadFormGender.value : null, birthday: leadFormBirthday.value.length > 0 ? leadFormBirthday.value : null }
		const result = leadFormIsEdit.value
			? await updateWorkspaceLead(leadFormLeadId.value, payload)
			: await createWorkspaceLead(payload)
		if (!result.success) {
			leadFormError.value = result.message != null && String(result.message).length > 0 ? String(result.message) : '保存失败，请稍后重试'
			return
		}
		leadFormSheetVisible.value = false
		leadFormRealName.value = ''
		leadFormName.value = ''
		leadFormPhone.value = ''
		leadFormWechat.value = ''
		leadFormSource.value = ''
		leadFormRemark.value = ''
		leadFormIntention.value = 1
		leadFormPhoto.value = ''
		leadFormGender.value = 0
		leadFormBirthday.value = ''
		showToast(leadFormIsEdit.value ? '线索已更新' : '线索已添加，等待跟进')
		await loadWorkspaceLeads()
	} catch (e) {
		leadFormError.value = '网络异常，请稍后重试'
	} finally {
		leadFormSubmitting.value = false
	}
}

// ===== 客源线索：放弃 / 恢复 / 入库确认 =====
const leadConfirmSheetVisible = ref(false)
const leadConfirmKind = ref('abandon')
const leadConfirmLeadId = ref('')
const leadConfirmReason = ref('')
const leadConfirmSubmitting = ref(false)
const leadConvertGender = ref(2)
const leadConfirmTip = computed(() => {
	if (leadConfirmKind.value == 'abandon') return '放弃后该线索将进入「已放弃线索」列表，可随时恢复。'
	if (leadConfirmKind.value == 'restore') return '捞取后客源将回到「客源线索」列表，录入人与跟进红娘都改为您。'
	return '入库后将创建正式用户并进入公开资料审核阶段，请确认信息真实有效。'
})
const confirmAbandonLead = (row: any) => {
	leadConfirmKind.value = 'abandon'
	leadConfirmLeadId.value = String(row.id)
	leadConfirmReason.value = ''
	leadConfirmSheetVisible.value = true
}
const confirmRestoreLead = (row: any) => {
	leadConfirmKind.value = 'restore'
	leadConfirmLeadId.value = String(row.id)
	leadConfirmReason.value = ''
	leadConfirmSheetVisible.value = true
}
const confirmConvertLead = (row: any) => {
	if (row.phone == '未提供') {
		showToast('该线索未登记电话，无法入库建档，请先编辑补充')
		return
	}
	leadConfirmKind.value = 'convert'
	leadConfirmLeadId.value = String(row.id)
	leadConvertGender.value = 2
	leadConfirmSheetVisible.value = true
}
const submitLeadConfirm = async () => {
	if (leadConfirmSubmitting.value) return
	leadConfirmSubmitting.value = true
	try {
		let result: any = null
		if (leadConfirmKind.value == 'abandon') {
			if (leadConfirmReason.value.trim().length == 0) {
				showToast('请填写放弃原因')
				return
			}
			result = await abandonWorkspaceLead(leadConfirmLeadId.value, leadConfirmReason.value.trim())
		} else if (leadConfirmKind.value == 'restore') {
			result = await restoreWorkspaceLead(leadConfirmLeadId.value, leadConfirmReason.value.trim().length > 0 ? leadConfirmReason.value.trim() : '重新跟进')
		} else {
			result = await convertWorkspaceLead(leadConfirmLeadId.value, leadConvertGender.value)
		}
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '操作失败，请稍后重试')
			return
		}
		leadConfirmSheetVisible.value = false
		if (leadConfirmKind.value == 'convert') {
			showToast('已入库，该用户已进入资料待审')
		} else if (leadConfirmKind.value == 'abandon') {
			showToast('已放弃线索')
		} else {
			showToast('恭喜，本客源已经成功捞取到您名下，请至“客源线索”中进行维护跟进，加油！')
		}
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		leadConfirmSubmitting.value = false
	}
}

// ===== 客源线索：复制资料弹窗（文本口径 = 编辑线索表单全量字段，未填写留空）=====
const copyVisible = ref(false)
const copyEditing = ref(false)
const copyCopied = ref(false)
const copyText = ref('')
const copyLines = ref<string[]>([])

// 线索列表里的空值统一是 '未提供' 占位，复制文本按编辑页口径留空。
const cpVal = (v: any): string => {
	const text = v == null ? '' : String(v).trim()
	return text == '未提供' ? '' : text
}
const cpGenderLabel = (v: any): string => {
	const gender = v == null ? 0 : Number(v)
	if (gender == 1) return '男'
	if (gender == 2) return '女'
	return ''
}
// 行序与「编辑线索」表单一致（照片只预览不复制）：姓名、称呼、电话、微信、性别、出生年月日、来源渠道，意向与备注收尾。
const buildLeadCopyLines = (row: any): string[] => {
	const birthday = cpVal(row.birthday)
	return [
		'姓名：' + cpVal(row.realName),
		'称呼：' + cpVal(row.name),
		'电话：' + cpVal(row.phone),
		'微信：' + cpVal(row.wechat),
		'性别：' + cpGenderLabel(row.gender),
		'出生年月日：' + (birthday.length >= 10 ? birthday.substring(0, 10) : birthday),
		'来源渠道：' + cpVal(row.source),
		'意向：' + cpVal(row.intentionLabel),
		'备注：' + cpVal(row.remark)
	]
}
const copyLeadProfile = (row: any) => {
	copyLines.value = buildLeadCopyLines(row)
	copyText.value = ''
	copyEditing.value = false
	copyCopied.value = false
	copyVisible.value = true
}
const closeCopyProfile = () => {
	copyVisible.value = false
	copyEditing.value = false
	copyCopied.value = false
}
const toggleCopyEdit = () => {
	if (copyEditing.value) {
		copyLines.value = copyText.value.split('\n')
		copyEditing.value = false
		return
	}
	copyText.value = copyLines.value.join('\n')
	copyEditing.value = true
}
const onCopyText = (event: any) => { copyText.value = event.detail.value }
const confirmCopyProfile = () => {
	if (copyCopied.value) return
	const data = copyEditing.value ? copyText.value : copyLines.value.join('\n')
	if (data.length == 0) {
		showToast('资料还没有内容可复制')
		return
	}
	uni.setClipboardData({
		data: data,
		success: () => {
			copyCopied.value = true
			showToast('资料已复制')
			setTimeout(() => { copyCopied.value = false }, 2000)
		},
		fail: () => showToast('复制失败，请重试')
	})
}

let introductionFallbackUsed: string[] = []
const getIntroductionFallbackAvatar = (memberId: any, gender: string, memberName: string = ''): string => {
	// 真实头像优先；兜底头像按 ID/姓名稳定分配，避免牵线嘉宾全部使用同一张图。
	const seedText = String(memberId || '') + ':' + String(memberName || '')
	let seed = 0
	for (let i = 0; i < seedText.length; i++) seed = (seed * 31 + seedText.charCodeAt(i)) >>> 0
	// 82 张动漫头像池（static/avatars），男会员取 001-041，女会员取 042-082。
	const maleAvatars: string[] = []
	const femaleAvatars: string[] = []
	for (let i = 1; i <= 41; i++) {
		const padded = i < 10 ? '00' + String(i) : (i < 100 ? '0' + String(i) : String(i))
		maleAvatars.push('/static/avatars/matchmaking-anime-' + padded + '.jpg')
		const fj = i + 41
		const fpadded = fj < 100 ? '0' + String(fj) : String(fj)
		femaleAvatars.push('/static/avatars/matchmaking-anime-' + fpadded + '.jpg')
	}
	const neutralAvatars = maleAvatars.concat(femaleAvatars)
	const normalizedGender = String(gender || '')
	const avatars = normalizedGender == '男' || normalizedGender == 'MALE' ? maleAvatars : (normalizedGender == '女' || normalizedGender == 'FEMALE' ? femaleAvatars : neutralAvatars)
	let index = seed % avatars.length
	for (let offset = 0; offset < avatars.length; offset++) {
		const candidate = avatars[(index + offset) % avatars.length]
		if (introductionFallbackUsed.indexOf(candidate) < 0) {
			introductionFallbackUsed.push(candidate)
			return candidate
		}
	}
	const candidate = avatars[index]
	introductionFallbackUsed.push(candidate)
	return candidate
}

const loadWorkspaceMatches = async () => {
	workspaceMatchesLoading.value = true
	workspaceMatchesError.value = ''
	workspaceMatchesLoaded.value = false
	workspaceMatchesUsingDemoData.value = false
	try {
		const result = await getMatchmakerWorkspaceIntroductions()
		if (!result.success || result.data == null) {
			workspaceMatches.value = []
			workspaceMatchesError.value = result.message != null ? String(result.message) : '牵线记录加载失败'
			return
		}
		const statusLabels: any = { PENDING: '待我牵线', IN_PROGRESS: '牵线中', SUCCEEDED: '牵线成功', FAILED: '牵线失败' }
		const statusTones: any = { PENDING: 'pending', IN_PROGRESS: 'progress', SUCCEEDED: 'succeeded', FAILED: 'failed' }
		const owner = managementCenterSnapshot.value != null && managementCenterSnapshot.value.identity != null
			? String(managementCenterSnapshot.value.identity.name || '服务红娘')
			: '服务红娘'
		const source = result.data
		const items = Array.isArray(source.items) ? source.items : []
		workspaceMatchesUsingDemoData.value = source.isDemo == true
		introductionFallbackUsed = []
		workspaceMatches.value = items.map((item: any) => {
			const fromUser = item.fromUser != null ? item.fromUser : {}
			const toUser = item.toUser != null ? item.toUser : {}
			return {
				id: item.id != null ? String(item.id) : '',
				status: item.status != null ? String(item.status) : 'PENDING',
				statusLabel: statusLabels[item.status] != null ? String(statusLabels[item.status]) : '待我牵线',
				statusTone: statusTones[item.status] != null ? String(statusTones[item.status]) : 'pending',
				time: item.createdAt != null ? String(item.createdAt).substring(0, 16) : '',
				failureReason: item.failureReason != null ? String(item.failureReason) : '',
				fromUser: {
					id: fromUser.id != null ? String(fromUser.id) : '',
					name: fromUser.name != null ? String(fromUser.name) : '未命名会员',
					gender: fromUser.gender != null ? String(fromUser.gender) : '未填写',
					avatar: fromUser.avatar != null && String(fromUser.avatar).length > 0 ? String(fromUser.avatar) : getIntroductionFallbackAvatar(fromUser.id, String(fromUser.gender), String(fromUser.name))
				},
				toUser: {
					id: toUser.id != null ? String(toUser.id) : '',
					name: toUser.name != null ? String(toUser.name) : '未命名会员',
					gender: toUser.gender != null ? String(toUser.gender) : '未填写',
					avatar: toUser.avatar != null && String(toUser.avatar).length > 0 ? String(toUser.avatar) : getIntroductionFallbackAvatar(toUser.id, String(toUser.gender), String(toUser.name))
				},
				owner: owner
			}
		})
		workspaceMatchesLoaded.value = true
		syncBusinessMetricCountsFromWorkspace()
	} catch (e) {
		workspaceMatches.value = []
		workspaceMatchesUsingDemoData.value = false
		workspaceMatchesError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		workspaceMatchesLoading.value = false
	}
}

