const canSubmit = computed(() => {
	return realName.value.trim().length >= 2
		&& realName.value.trim().length <= 64
		&& /^1[3-9]\d{9}$/.test(phone.value.trim())
		&& wechat.value.trim().length > 0
		&& wechat.value.trim().length <= 128
		&& avatar.value.length > 0
		&& avatar.value.length <= 512
		&& introduction.value.trim().length >= 10
		&& introduction.value.trim().length <= 2000
		&& specialties.value.length > 0
		&& isValidOptionalPrice()
})

const canEnterManagementCenter = computed(() => {
	return managementAccess.value != null && managementAccess.value.canAccess == true
})

const managementAccessDescription = computed(() => {
	if (managementAccessLoading.value) return '正在核验服务红娘开通状态…'
	if (managementAccess.value == null) return '暂时无法核验开通状态，请稍后重试。'
	// 文案一律取服务端 message，成功与拒绝同一个来源，前端不再各自写一句话。
	const serverMessage = managementAccess.value.message != null ? String(managementAccess.value.message).trim() : ''
	if (serverMessage.length > 0) return serverMessage
	return canEnterManagementCenter.value
		? '服务开通已确认，可进入工作台处理门店服务事项。'
		: '当前账号暂未获得管理中心权限。'
})

const managementAccessActionText = computed(() => {
	if (managementAccessLoading.value) return '核验中'
	if (managementCenterLoading.value) return '进入中'
	if (canEnterManagementCenter.value) return '进入中心'
	return '暂不可进入'
})

