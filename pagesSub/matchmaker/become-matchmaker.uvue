	border-radius: 999rpx;
	border: 1px solid var(--line);
	display: flex;
	align-items: center;
}

.nav-help-text {
	font-size: 22rpx;
	color: var(--muted);
}

/* ===== 滚动区域 ===== */
.workspace-scroller { flex: 1; height: 0; background: var(--canvas); }
.workspace-content { min-height: 100%; padding: 20rpx 22rpx 130rpx; background: var(--canvas); }
.workspace-heading { padding: 8rpx 4rpx 18rpx; display: flex; flex-direction: column; gap: 5rpx; }
.workspace-title { font-size: 32rpx; font-weight: 800; color: var(--ink); }.workspace-copy,.workspace-muted { font-size: 20rpx; color: var(--muted); }
.workspace-tabs { height: 74rpx; display: flex; background: var(--surface); border-radius: 20rpx 20rpx 0 0; }.workspace-tab { flex: 1; position: relative; display: flex; align-items: center; justify-content: center; font-size: 21rpx; white-space: nowrap; }.workspace-tab.active { color: var(--accent2); font-weight: 800; }.workspace-tab.active:after { content: ''; position: absolute; bottom: 0; width: 42rpx; height: 6rpx; border-radius: 99rpx; background: var(--accent); }
.workspace-search { height: 70rpx; margin: 18rpx 0; padding: 0 7rpx 0 18rpx; border: 1rpx solid var(--line); background: var(--surface); border-radius: 14rpx; display: flex; align-items: center; gap: 10rpx; font-size: 30rpx; color: var(--muted); box-shadow: var(--shadow-sm); }.workspace-search input { flex: 1; min-width: 0; font-size: 22rpx; color: var(--ink); }.workspace-search-submit { width: 92rpx; height: 56rpx; border-radius: 14rpx; background: var(--accent); color: var(--paper); display: flex; align-items: center; justify-content: center; }.workspace-search-glyph { font-size: 34rpx; line-height: 1; font-weight: 700; color: inherit; }
.workspace-cash { min-height: 254rpx; padding: 30rpx; position: relative; border-radius: 20rpx; background: var(--accent-bg); display: flex; flex-direction: column; gap: 12rpx; color: var(--ink2); font-size: 23rpx; }.workspace-cash-value { font-size: 56rpx; color: var(--ink); font-weight: 800; }.workspace-cash > view { position: absolute; top: 40rpx; right: 26rpx; padding: 14rpx 24rpx; border-radius: 999rpx; background: var(--surface); color: var(--accent2); font-size: 21rpx; font-weight: 800; }
.workspace-notice,.workspace-promotion { margin-top: 20rpx; padding: 22rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 10rpx; color: var(--ink2); font-size: 21rpx; line-height: 1.55; box-shadow: var(--shadow-sm); }.workspace-notice-title { font-size: 25rpx; color: var(--ink); font-weight: 800; }.workspace-promotion { background: var(--sage-soft); color: var(--accent2); font-weight: 800; }.workspace-promotion > view { display: flex; gap: 12rpx; }.workspace-promotion > view text { flex: 1; padding: 12rpx 8rpx; border-radius: 999rpx; background: var(--surface); text-align: center; font-size: 19rpx; }
.workspace-commission-row { margin-top: 18rpx; color: var(--muted); font-size: 20rpx; }.workspace-commission-row > view { margin-top: 8rpx; padding: 20rpx; border-radius: 20rpx; background: var(--surface); display: flex; align-items: center; gap: 16rpx; box-shadow: var(--shadow-sm); }.workspace-commission-row image,.workspace-member-header image,.workspace-match-person image { width: 60rpx; height: 60rpx; border-radius: 50%; }.workspace-commission-row > view > view { flex: 1; display: flex; flex-direction: column; gap: 4rpx; color: var(--ink); font-size: 21rpx; }.workspace-commission-row > view > view text:last-child { color: var(--muted); font-size: 19rpx; }.workspace-commission-row > view > text:last-child { color: var(--accent2); font-size: 27rpx; font-weight: 800; }
.workspace-info-card,.workspace-match-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 16rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; box-shadow: var(--shadow-sm); }.workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header) { padding-bottom: 13rpx; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--ink2); font-size: 21rpx; font-weight: 400; }.workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header) text:last-child { color: var(--ink); }.workspace-actions { display: flex; gap: 9rpx; }.workspace-actions text { flex: 1; padding: 12rpx 4rpx; border-radius: 14rpx; background: var(--warm); color: var(--accent2); text-align: center; font-size: 18rpx; font-weight: 700; }
.workspace-state { margin-top: 18rpx; min-height: 180rpx; padding: 28rpx; border-radius: 20rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 18rpx; color: var(--muted); font-size: 22rpx; box-shadow: var(--shadow-sm); }.workspace-state-action { padding: 12rpx 24rpx; border-radius: 999rpx; background: var(--sage-soft); color: var(--accent2); font-size: 21rpx; font-weight: 700; }
.workspace-filter-note { padding: 12rpx; color: var(--accent2); font-size: 22rpx; line-height: 1.5; }.workspace-demo-notice { margin: 4rpx 12rpx 12rpx; padding: 12rpx 14rpx; border-radius: 14rpx; background: var(--accent-bg); color: var(--accent2); font-size: 19rpx; line-height: 1.45; }.workspace-match-card { font-size: 21rpx; font-weight: 400; }.workspace-match-card-top { display: flex; justify-content: space-between; align-items: center; color: var(--muted); }.workspace-match-status { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; line-height: 1.2; }.workspace-match-status-pending { background: var(--accent-bg); color: var(--accent2); }.workspace-match-status-progress { background: var(--match-sky); color: var(--match-deep); }.workspace-match-status-succeeded { background: var(--sage-soft); color: var(--sage); }.workspace-match-status-failed { background: var(--match-blush); color: var(--match-coral); }.workspace-match-person { min-height: 64rpx; display: flex; align-items: center; gap: 14rpx; }.workspace-match-person > view { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }.workspace-match-person > view text:first-child { color: var(--ink); font-size: 23rpx; font-weight: 700; }.workspace-match-person > view text:last-child { color: var(--muted); font-size: 19rpx; }.workspace-match-reason { padding: 14rpx; border-radius: 14rpx; background: var(--match-blush); color: var(--ink2); font-size: 20rpx; line-height: 1.5; }.workspace-match-owner { color: var(--muted); font-size: 19rpx; }

/* 牵线管理（按设计稿）：申请时间+黄色状态胶囊、双列头像带角色标、联系Ta、牵线状态弹窗。 */
.workspace-match-card { gap: 20rpx; padding: 26rpx 26rpx; }
.workspace-match-card .workspace-match-card-top { margin-bottom: 2rpx; }
.workspace-match-status-btn { height: 60rpx; padding: 0 22rpx; border-radius: 999rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 10rpx; }
.workspace-match-status-btn text { color: var(--paper); font-size: 22rpx; font-weight: 800; }
.workspace-match-status-btn.t-PENDING { background: var(--review-orange); }
.workspace-match-status-btn.t-IN_PROGRESS { background: var(--accent2); }
.workspace-match-status-btn.t-SUCCEEDED { background: var(--sage); }
.workspace-match-status-btn.t-FAILED { background: var(--match-coral); }
.workspace-match-status-arrow { width: 28rpx; height: 28rpx; border-radius: 50%; background: rgba(255, 255, 255, .3); display: flex; align-items: center; justify-content: center; }
.workspace-match-status-arrow i { width: 10rpx; height: 10rpx; border-top: 3rpx solid var(--paper); border-right: 3rpx solid var(--paper); transform: rotate(45deg); margin-left: -3rpx; }
.workspace-match-status-btn:active { opacity: .8; transform: scale(.97); }
.workspace-match-card .workspace-match-person { display: flex; flex-direction: row; align-items: center; gap: 14rpx; padding: 14rpx 0; border-top: 1rpx solid var(--line); }
.workspace-match-person-side { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; gap: 16rpx; }
.workspace-match-avatar-wrap { position: relative; width: 96rpx; height: 96rpx; flex-shrink: 0; }
.workspace-match-avatar-wrap image { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--warm); }
.workspace-match-role { position: absolute; left: 50%; bottom: -10rpx; transform: translateX(-50%); padding: 2rpx 14rpx; border-radius: 999rpx; font-size: 17rpx; font-weight: 700; white-space: nowrap; }
.workspace-match-role.role-applicant { background: var(--accent-bg); color: var(--accent2); }
.workspace-match-role.role-target { background: var(--match-blush); color: var(--match-coral); }
.workspace-match-person-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.workspace-match-person-name { display: flex; flex-direction: row; align-items: center; gap: 8rpx; min-width: 0; }
.workspace-match-person-name > text:first-child { max-width: 220rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 26rpx; font-weight: 800; }
.workspace-match-gender { padding: 1rpx 10rpx; border-radius: 6rpx; font-size: 17rpx; font-weight: 800; flex-shrink: 0; }
.workspace-match-gender.male { background: var(--match-sky); color: var(--paper); }
.workspace-match-gender.female { background: var(--match-blush); color: var(--paper); }
.workspace-match-person-code { color: var(--muted); font-size: 20rpx; }
.workspace-match-contact { min-width: 132rpx; height: 64rpx; border-radius: 14rpx; background: var(--accent-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.workspace-match-contact text { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.workspace-match-contact:active { opacity: .75; }
.workspace-match-status-form { display: flex; flex-direction: column; gap: 20rpx; }
.workspace-match-status-choices { display: flex; flex-direction: column; gap: 16rpx; }
.workspace-match-status-choice { min-height: 92rpx; border-radius: 18rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; }
.workspace-match-status-choice text { color: var(--ink2); font-size: 27rpx; font-weight: 700; }
.workspace-match-status-choice.active { background: var(--accent-bg); border-color: var(--accent2); }
.workspace-match-status-choice.active text { color: var(--accent2); font-weight: 800; }
.workspace-match-status-choice:active { opacity: .78; }
.workspace-match-status-submit { min-height: 88rpx; border-radius: 999rpx; background: linear-gradient(90deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; }
.workspace-match-status-submit text { color: var(--paper); font-size: 27rpx; font-weight: 800; }
.workspace-match-status-submit.disabled { opacity: .55; }
.workspace-match-status-submit:active { opacity: .85; }

/* 添加牵线记录：行式表单 + 单选 + 扣次说明 + 紫色提交；悬浮按钮 match 态用主紫。 */
.workspace-add.match-add { bottom: 60rpx; width: 96rpx; height: 96rpx; background: linear-gradient(180deg, var(--accent), var(--accent2)); gap: 0; }
.workspace-match-add-form { display: flex; flex-direction: column; gap: 6rpx; }
.workspace-match-add-row { min-height: 100rpx; border-bottom: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; }
.workspace-match-add-row.last { border-bottom: none; }
.workspace-match-add-label { color: var(--ink); font-size: 27rpx; font-weight: 800; flex-shrink: 0; }
.workspace-match-add-picker { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-match-add-picker text { color: var(--ink2); font-size: 24rpx; max-width: 340rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workspace-match-add-picker text.placeholder { color: var(--muted); }
.workspace-match-add-picker i { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); flex-shrink: 0; }
.workspace-match-add-result { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-match-add-result > text { color: var(--ink2); font-size: 24rpx; }
.workspace-match-add-result > text.radio-on { color: var(--ink); font-weight: 700; }
.workspace-match-add-radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 1rpx solid var(--line); background: var(--surface); display: flex; align-items: center; justify-content: center; }
.workspace-match-add-radio.active { background: var(--accent2); border-color: var(--accent2); }
.workspace-match-add-radio.active text { color: var(--paper); font-size: 20rpx; font-weight: 900; }
.workspace-match-add-note { margin: 16rpx 0 6rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: var(--match-mist); display: flex; flex-direction: row; gap: 10rpx; }
.workspace-match-add-note-mark { width: 28rpx; height: 28rpx; border-radius: 50%; background: var(--accent2); color: var(--paper); font-size: 17rpx; font-weight: 800; text-align: center; line-height: 28rpx; flex-shrink: 0; }
.workspace-match-add-note > text:last-child { flex: 1; color: var(--ink2); font-size: 20rpx; line-height: 1.6; }
.workspace-match-add-submit { margin-top: 10rpx; min-height: 92rpx; border-radius: 16rpx; background: linear-gradient(90deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; }
.workspace-match-add-submit text { color: var(--paper); font-size: 28rpx; font-weight: 800; }
.workspace-match-add-submit.disabled { opacity: .55; }
.workspace-match-add-submit:active { opacity: .85; }
.workspace-meeting-overview { margin-top: 4rpx; padding: 21rpx 22rpx; border-radius: 20rpx; background: var(--match-mist); display: flex; flex-direction: column; gap: 8rpx; color: var(--accent2); font-size: 20rpx; line-height: 1.45; }.workspace-meeting-overview > view { display: flex; align-items: baseline; gap: 12rpx; }.workspace-meeting-overview-value { color: var(--match-deep); font-family: var(--serif); font-size: 48rpx; line-height: 1; font-weight: 700; }.workspace-meeting-overview-label { color: var(--ink2); font-size: 22rpx; font-weight: 700; }.workspace-meeting-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: var(--match-paper); display: flex; flex-direction: column; gap: 18rpx; box-shadow: var(--match-shadow); }.workspace-meeting-card-top { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 19rpx; }.workspace-meeting-status { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; line-height: 1.2; }.workspace-meeting-status-submitted { background: var(--accent-bg); color: var(--accent2); }.workspace-meeting-status-processing { background: var(--match-sky); color: var(--match-deep); }.workspace-meeting-status-upcoming { background: var(--sage-soft); color: var(--sage); }.workspace-meeting-status-completed { background: var(--match-mist); color: var(--accent2); }.workspace-meeting-status-ended { background: var(--match-blush); color: var(--match-coral); }.workspace-meeting-pair { padding: 18rpx 0; border-top: 1rpx solid var(--match-line); border-bottom: 1rpx solid var(--match-line); display: flex; align-items: center; gap: 10rpx; }.workspace-meeting-person { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; }.workspace-meeting-person image { width: 58rpx; height: 58rpx; border-radius: 50%; flex-shrink: 0; }.workspace-meeting-person > view { min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }.workspace-meeting-person > view text:first-child { color: var(--ink); font-size: 22rpx; font-weight: 800; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.workspace-meeting-person > view text:last-child { color: var(--muted); font-size: 18rpx; }.workspace-meeting-link { width: 58rpx; height: 38rpx; border-radius: 999rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; color: var(--accent2); font-size: 17rpx; font-weight: 800; flex-shrink: 0; }.workspace-meeting-arrangement { padding: 16rpx; border-radius: 14rpx; background: var(--surface); display: flex; flex-direction: column; gap: 8rpx; }.workspace-meeting-arrangement > text { color: var(--accent2); font-size: 19rpx; font-weight: 800; }.workspace-meeting-arrangement > view { display: flex; justify-content: space-between; gap: 14rpx; color: var(--ink2); font-size: 20rpx; }.workspace-meeting-arrangement > view text:last-child { flex: 1; min-width: 0; text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.workspace-meeting-detail { color: var(--ink2); font-size: 20rpx; line-height: 1.5; }.workspace-meeting-time { color: var(--muted); font-size: 18rpx; }

/* 约见申请（按设计稿）：浅紫须知卡 + 白卡双列大头像 + 灰盒元信息 + 实心胶囊操作 + 圆形回顶。 */
.workspace-meeting-intro { margin-top: 4rpx; padding: 30rpx 30rpx; border-radius: 24rpx; background: var(--accent-bg); display: flex; flex-direction: column; gap: 14rpx; }
.workspace-meeting-intro-head { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.workspace-meeting-intro-mark { width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--accent2); color: var(--paper); font-size: 19rpx; font-weight: 800; text-align: center; line-height: 34rpx; }
.workspace-meeting-intro-title { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.workspace-meeting-intro-text { color: var(--ink2); font-size: 23rpx; line-height: 1.7; }
.workspace-meeting-card { margin-top: 20rpx; padding: 30rpx 26rpx 26rpx; border-radius: 24rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 20rpx; }
.workspace-meeting-pair { display: flex; flex-direction: row; align-items: center; gap: 12rpx; padding: 0; border-top: none; border-bottom: none; }
.workspace-meeting-pair .workspace-meeting-person { flex-direction: column; align-items: center; }
.workspace-meeting-person { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.workspace-meeting-avatar-wrap { position: relative; width: 110rpx; height: 110rpx; }
.workspace-meeting-avatar-wrap image { width: 110rpx; height: 110rpx; border-radius: 50%; background: var(--warm); }
.workspace-meeting-gender { position: absolute; right: -2rpx; bottom: -2rpx; width: 34rpx; height: 34rpx; border-radius: 50%; border: 3rpx solid var(--surface); box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 800; color: var(--paper); }
.workspace-meeting-gender.male { background: var(--match-sky); color: var(--match-deep); }
.workspace-meeting-gender.female { background: var(--match-blush); color: var(--match-coral); }
.workspace-meeting-name { max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 27rpx; font-weight: 800; }
.workspace-meeting-person-code { color: var(--muted); font-size: 21rpx; }
.workspace-meeting-wish { padding: 10rpx 24rpx; border-radius: 999rpx; background: var(--accent-bg); flex-shrink: 0; }
.workspace-meeting-wish text { color: var(--accent2); font-size: 23rpx; font-weight: 800; }
.workspace-meeting-meta { padding: 20rpx 22rpx; border-radius: 16rpx; background: var(--warm); display: flex; flex-direction: column; gap: 10rpx; }
.workspace-meeting-meta-line { display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.workspace-meeting-meta-glyph { font-size: 20rpx; }
.workspace-meeting-meta-line text { color: var(--ink2); font-size: 22rpx; }
.workspace-meeting-foot { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; }
.workspace-meeting-status-btn { height: 72rpx; padding: 0 30rpx; border-radius: 999rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12rpx; }
.workspace-meeting-status-btn text { color: var(--paper); font-size: 25rpx; font-weight: 800; }
.workspace-meeting-status-arrow { width: 30rpx; height: 30rpx; border-radius: 50%; background: rgba(255, 255, 255, .28); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-status-arrow i { width: 11rpx; height: 11rpx; border-top: 3rpx solid var(--paper); border-right: 3rpx solid var(--paper); transform: rotate(45deg); margin-left: -4rpx; }
.workspace-meeting-status-btn.pending { background: var(--accent2); }
.workspace-meeting-status-btn.done { background: var(--match-coral); }
.workspace-meeting-status-btn:active { opacity: .8; transform: scale(.97); }
.workspace-meeting-delete { height: 72rpx; padding: 0 34rpx; border-radius: 999rpx; background: var(--warm); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-delete text { color: var(--ink2); font-size: 24rpx; font-weight: 700; }
.workspace-meeting-delete:active { opacity: .75; }
.workspace-scroll-top { position: fixed; right: 30rpx; bottom: 130rpx; z-index: 20; width: 108rpx; height: 108rpx; border-radius: 50%; background: var(--surface); box-shadow: 0 8rpx 30rpx rgba(70, 70, 105, .16); display: flex; align-items: center; justify-content: center; }
.workspace-scroll-top-arrow { color: var(--ink2); font-size: 40rpx; font-weight: 900; line-height: 1; }
.workspace-scroll-top:active { opacity: .8; transform: scale(.95); }


.workspace-meeting-status-form { display: flex; flex-direction: column; gap: 20rpx; }

.workspace-meeting-status-pair { display: flex; flex-direction: row; gap: 20rpx; }
.workspace-meeting-status-pill { flex: 1; min-width: 0; min-height: 92rpx; border-radius: 999rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-status-pill text { color: var(--ink2); font-size: 27rpx; font-weight: 700; }
.workspace-meeting-status-pill.active { background: var(--accent-bg); border-color: var(--accent2); }
.workspace-meeting-status-pill.active text { color: var(--accent2); font-weight: 800; }
.workspace-meeting-status-pill:active { opacity: .78; }
.workspace-member-header { display: flex; align-items: center; gap: 15rpx; }.workspace-member-header > view { display: flex; flex-direction: column; gap: 6rpx; color: var(--muted); font-size: 20rpx; font-weight: 400; }.workspace-member-header > view text:first-child { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.workspace-entry-card { margin-top: 18rpx; padding: 26rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 18rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; box-shadow: var(--shadow-sm); }

/* 录入客源线索：分步卡片 + chips 单选 + 示例填充，复用工作台 Token。 */
.workspace-entry-page { display: flex; flex-direction: column; gap: 20rpx; padding-bottom: 40rpx; }
.workspace-entry-hero { padding: 22rpx 26rpx; border-radius: 20rpx; background: var(--match-mist); display: flex; flex-direction: row; align-items: center; gap: 18rpx; }
.workspace-entry-hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.workspace-entry-hero-title { color: var(--accent2); font-size: 25rpx; font-weight: 800; }
.workspace-entry-hero-sub { color: var(--ink2); font-size: 21rpx; line-height: 1.5; }
.workspace-entry-demo { padding: 14rpx 24rpx; border-radius: 999rpx; background: var(--surface); box-shadow: var(--shadow-sm); flex-shrink: 0; }
.workspace-entry-demo text { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.workspace-entry-demo:active { opacity: .75; transform: scale(.98); }
.workspace-entry-formcard { margin-top: 0; padding: 26rpx; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
.workspace-entry-card-head { display: flex; flex-direction: row; align-items: center; gap: 14rpx; padding-bottom: 6rpx; }
.workspace-entry-step { width: 40rpx; height: 40rpx; border-radius: 12rpx; background: var(--accent); color: var(--paper); font-size: 21rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.workspace-entry-card-head-copy { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12rpx; }
.workspace-entry-card-title { color: var(--ink); font-size: 27rpx; font-weight: 800; }
.workspace-entry-card-require { color: var(--muted); font-size: 20rpx; }
.workspace-entry-row { display: flex; flex-direction: row; align-items: center; gap: 14rpx; min-height: 92rpx; border-bottom: 1px solid var(--line); }
.workspace-entry-row.last { border-bottom: none; }
.workspace-entry-label { width: 84rpx; color: var(--ink2); font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
.workspace-entry-row input { flex: 1; min-width: 0; color: var(--ink); font-size: 25rpx; }
.workspace-entry-picker { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-entry-picker text { color: var(--ink2); font-size: 25rpx; }
.workspace-entry-picker i { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); }
.workspace-entry-block { padding: 20rpx 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 14rpx; }
.workspace-entry-block.last { border-bottom: none; padding-bottom: 4rpx; }
.workspace-entry-block-label { color: var(--ink2); font-size: 22rpx; font-weight: 700; }
.workspace-entry-chips { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; }
.workspace-entry-chip { padding: 10rpx 24rpx; border-radius: 999rpx; background: var(--surface); border: 1px solid var(--match-line); }
.workspace-entry-chip text { color: var(--ink2); font-size: 21rpx; font-weight: 700; }
.workspace-entry-chip.active { background: var(--match-deep); border-color: var(--match-deep); }
.workspace-entry-chip.active text { color: var(--paper); }
.workspace-entry-chip:active { opacity: .75; }
.workspace-entry-textarea { width: 100%; min-height: 130rpx; padding: 16rpx; border-radius: 12rpx; background: var(--surface); border: 1px solid var(--match-line); color: var(--ink); font-size: 23rpx; line-height: 1.6; box-sizing: border-box; }
.workspace-entry-submit { margin-top: 6rpx; min-height: 88rpx; border-radius: 999rpx; background: var(--accent); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }
.workspace-entry-submit text { color: var(--paper); font-size: 27rpx; font-weight: 800; }
.workspace-entry-submit.disabled { opacity: .55; }
.workspace-entry-submit:active { opacity: .8; transform: scale(.99); }
.workspace-entry-foot { display: flex; justify-content: center; }
.workspace-entry-foot text { color: var(--muted); font-size: 20rpx; text-align: center; }.workspace-entry-card > view:not(.workspace-entry-submit) { min-height: 72rpx; padding-bottom: 12rpx; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: var(--ink2); font-size: 22rpx; font-weight: 400; }.workspace-entry-card input { flex: 1; text-align: right; font-size: 22rpx; color: var(--ink); }.workspace-entry-submit { height: 72rpx; border-radius: 999rpx; background: var(--accent); display: flex; align-items: center; justify-content: center; color: var(--paper); font-size: 24rpx; font-weight: 800; }
.workspace-generic-card { margin-top: 18rpx; padding: 24rpx; border-radius: 20rpx; background: var(--surface); display: flex; align-items: center; gap: 16rpx; box-shadow: var(--shadow-sm); }.workspace-generic-card > view:first-child { width: 58rpx; height: 58rpx; border-radius: 14rpx; background: var(--accent-bg); color: var(--accent2); display: flex; align-items: center; justify-content: center; font-size: 25rpx; }.workspace-generic-card > view:nth-child(2) { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }.workspace-generic-card > view:nth-child(2) text:first-child { font-size: 24rpx; font-weight: 800; }.workspace-generic-card > view:nth-child(2) text:last-child { color: var(--muted); font-size: 18rpx; }.workspace-generic-card > text:last-child { color: var(--accent2); font-size: 20rpx; }
.workspace-add { position: fixed; right: 22rpx; bottom: 38rpx; width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; color: var(--paper); font-size: 17rpx; font-weight: 800; box-shadow: var(--shadow-sm); }.workspace-add text:first-child { font-size: 30rpx; line-height: 28rpx; }

/* 微信小程序 uvue 必须显式标记横向 flex，避免文字与操作按钮纵向叠压。 */
.workspace-tabs, .workspace-search, .workspace-promotion > view, .workspace-commission-row > view, .workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header), .workspace-actions, .workspace-match-card-top, .workspace-match-person, .workspace-meeting-card-top, .workspace-meeting-pair, .workspace-meeting-person, .workspace-meeting-arrangement > view, .workspace-member-header, .workspace-entry-card > view:not(.workspace-entry-submit), .workspace-generic-card { flex-direction: row; }
.workspace-tabs, .workspace-search, .workspace-actions, .workspace-match-person, .workspace-meeting-pair, .workspace-meeting-person, .workspace-member-header, .workspace-generic-card { min-width: 0; }
.workspace-info-card > view, .workspace-match-person > view, .workspace-member-header > view, .workspace-generic-card > view { min-width: 0; }

.page-scroller {
	flex: 1;
	height: 0;
}

.page-content {
	padding: 24rpx 32rpx;
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.bottom-spacer {
	height: 148rpx;
}

/* ===== Banner ===== */
.banner-card {
	padding: 34rpx 30rpx;
	border-radius: 22rpx;
	background: linear-gradient(145deg, var(--accent-bg), var(--surface));
	display: flex;
	flex-direction: column;
	justify-content: center;
	min-height: 208rpx;
	box-sizing: border-box;
}

.banner-copy {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.banner-kicker {
	font-size: 20rpx;
	font-weight: 800;
	letter-spacing: 0.08em;
	color: var(--accent2);
}

.banner-title {
	font-size: 40rpx;
	line-height: 1.34;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.banner-desc {
	font-size: 21rpx;
	line-height: 1.55;
	color: var(--ink2);
}

/* ===== 红娘管理中心入口 ===== */
.management-entry {
	padding: 26rpx;
	border: 1px solid var(--line);
	border-radius: 20rpx;
	background: var(--warm);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 18rpx;
}

.management-entry.ready {
	background: var(--match-mist);
	border-color: var(--accent);
}

.management-entry-copy {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.management-entry-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10rpx;
}

.management-entry-title {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--ink);
}

.management-demo-badge {
	padding: 4rpx 10rpx;
	border-radius: 999rpx;
	background: var(--accent-bg);
	color: var(--accent2);
	font-size: 18rpx;
	font-weight: 800;
}

.management-entry-desc {
	font-size: 21rpx;
	line-height: 1.5;
	color: var(--ink2);
}

.management-entry-action {
	min-width: 136rpx;
	height: 64rpx;
	padding: 0 16rpx;
	border-radius: 14rpx;
	background: var(--accent);
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--paper);
	font-size: 21rpx;
	font-weight: 800;
	white-space: nowrap;
	flex-shrink: 0;
}

.management-entry-action.disabled {
	background: var(--muted);
	opacity: 0.72;
}

/* ===== 管理中心加载骨架 ===== */
.management-center-loading {
	flex: 1;
	height: 0;
	padding: 24rpx 32rpx;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.management-loading-card,
.management-loading-heading,
.management-loading-pill {
	background: var(--warm);
	border-radius: 16rpx;
}

.management-loading-identity {
	height: 260rpx;
	border-radius: 20rpx;
}

.management-loading-tabs {
	display: flex;
	flex-direction: row;
	gap: 12rpx;
}

.management-loading-pill {
	width: 142rpx;
	height: 58rpx;
	border-radius: 999rpx;
}

.management-loading-pill.short {
	width: 96rpx;
}

.management-loading-heading {
	width: 186rpx;
	height: 38rpx;
}

.management-loading-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 14rpx;
}

.management-loading-grid .management-loading-card {
	height: 176rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
	padding: 28rpx;
	border-radius: 20rpx;
	background: var(--surface);
	box-shadow: var(--shadow-sm);
	display: flex;
	flex-direction: column;
	gap: 18rpx;
}

.section-title {
	font-size: 34rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.section-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12rpx;
}

.optional-label {
	font-size: 20rpx;
	color: var(--muted);
	padding: 4rpx 12rpx;
	border-radius: 999rpx;
	background: var(--warm);
}

.section-desc {
	font-size: 22rpx;
	line-height: 1.55;
	color: var(--muted);
}

.form-field {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	padding-top: 18rpx;
	border-top: 1px solid var(--line);
}

.field-label {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--ink2);
}

.required {
	color: var(--brown);
}

.optional {
	font-size: 20rpx;
	font-weight: 400;
	color: var(--muted);
	margin-left: 8rpx;
}

.field-hint {
	font-size: 20rpx;
	color: var(--muted);
}

.field-counter {
	font-size: 20rpx;
	color: var(--muted);
	text-align: right;
}

.field-input {
	height: 78rpx;
	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 25rpx;
	color: var(--ink);
}

.field-textarea {
	width: 100%;
	min-height: 146rpx;
	padding: 18rpx 20rpx;
	box-sizing: border-box;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 24rpx;
	line-height: 1.6;
	color: var(--ink);
}

.case-textarea {
	min-height: 120rpx;
}

/* ===== 头像上传 ===== */
.avatar-upload {
	width: 160rpx;
	height: 160rpx;
	border-radius: 50%;
	overflow: hidden;
	border: 2rpx dashed var(--line);
	background: var(--canvas);
}

.avatar-preview {
	width: 100%;
	height: 100%;
}

.avatar-placeholder {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 6rpx;
}

.avatar-plus {
	font-size: 48rpx;
	font-weight: 300;
	color: var(--muted);
}

.avatar-hint {
	font-size: 18rpx;
	color: var(--muted);
}

/* ===== 擅长领域 ===== */
.specialty-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 12rpx;
}

.specialty-chip {
	width: 100%;
	height: 58rpx;
	padding: 0 8rpx;
	box-sizing: border-box;
	border: 1px solid var(--line);
	border-radius: 999rpx;
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 22rpx;
	line-height: 1;
	color: var(--ink2);
}

.specialty-chip text {
	display: block;
	width: 100%;
	text-align: center;
	line-height: 1;
	white-space: nowrap;
}

.specialty-chip.selected {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
	font-weight: 800;
}

/* ===== 价格输入 ===== */
.price-input-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 78rpx;
	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	gap: 8rpx;
}

.price-prefix {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--brown);
	flex-shrink: 0;
}

.price-input {
	flex: 1;
	min-width: 0;
	font-size: 25rpx;
	color: var(--ink);
}

.price-suffix {
	font-size: 22rpx;
	color: var(--muted);
	flex-shrink: 0;
}

/* ===== 成功案例 ===== */
.case-block {
	padding: 22rpx;
	border: 1px solid var(--line);
	border-radius: 16rpx;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.case-block-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.case-block-title {
	font-size: 24rpx;
	font-weight: 800;
	color: var(--ink);
}

.case-delete {
	padding: 8rpx 16rpx;
	border-radius: 8rpx;
	background: rgba(231, 110, 76, 0.12);
}

.case-delete text {
	font-size: 20rpx;
	color: var(--brown);
}

.case-block .form-field {
	border-top: none;
	padding-top: 0;
}

.case-images {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 12rpx;
}

.case-image-item {
	position: relative;
	width: 148rpx;
	height: 148rpx;
	border-radius: 12rpx;
	overflow: hidden;
}

.case-image-preview {
	width: 100%;
	height: 100%;
}

.case-image-delete {
	position: absolute;
	top: 4rpx;
	right: 4rpx;
	width: 36rpx;
	height: 36rpx;
	border-radius: 50%;
	background: rgba(0, 0, 0, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
}

.case-image-delete text {
	font-size: 24rpx;
	color: var(--paper);
	font-weight: 700;
}

.case-image-add {
	width: 148rpx;
	height: 148rpx;
	border: 2rpx dashed var(--line);
	border-radius: 12rpx;
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
}

.case-add-plus {
	font-size: 48rpx;
	font-weight: 300;
	color: var(--muted);
}

.add-case-button {
	height: 72rpx;
	border: 1px dashed var(--line);
	border-radius: 14rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.add-case-button text {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--accent2);
}

/* ===== 审核流程 ===== */
.process-card {
	position: relative;
	overflow: visible;
}

.process-steps {
	display: flex;
	flex-direction: column;
	gap: 0;
}

.process-step {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 18rpx;
	padding-bottom: 28rpx;
}

.process-step:last-child {
	padding-bottom: 0;
}

.step-indicator {
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	border: 2rpx solid var(--line);
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 18rpx;
	font-weight: 800;
	color: var(--muted);
	flex-shrink: 0;
	z-index: 1;
}

.step-indicator.active {
	background: var(--accent);
	border-color: var(--accent);
	color: var(--paper);
}

.step-indicator.done {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
}

.step-copy {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 6rpx;
	padding-top: 4rpx;
}

.step-title {
	font-size: 25rpx;
	font-weight: 700;
	color: var(--ink);
}

.step-desc {
	font-size: 20rpx;
	line-height: 1.5;
	color: var(--muted);
}

.step-line {
	position: absolute;
	left: 25rpx;
	top: 56rpx;
	width: 2rpx;
	height: calc(100% - 38rpx);
	background: var(--line);
}

/* ===== 咨询入口 ===== */
.consult-icons {
	position: absolute;
	/* 保持在审核流程卡片内，避免悬出页面边缘。 */
	right: 30rpx;
	top: 46%;
	transform: translateY(-50%);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12rpx;
	z-index: 2;
}

.consult-icon {
	width: 70rpx;
	height: 70rpx;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 8rpx 18rpx rgba(45, 124, 114, 0.18);
}

.wechat-brand {
	width: 64rpx;
	height: 64rpx;
	flex-shrink: 0;
}

.wechat-slot {
	width: 70rpx;
	height: 70rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.consult-emoji {
	display: none;
}

.phone-brand {
	width: 64rpx;
	height: 64rpx;
}

.phone-slot {
	width: 70rpx;
	height: 70rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

/* ===== 微信二维码弹窗 ===== */
.qr-overlay {
	position: fixed;
	inset: 0;
	z-index: 100;
	background: rgba(17, 23, 24, 0.48);
	display: flex;
	align-items: center;
	justify-content: center;
}

.qr-card {
	position: relative;
	width: 540rpx;
	padding: 44rpx 40rpx 36rpx;
	border-radius: 28rpx;
	background: var(--paper);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 16rpx;
	box-shadow: var(--shadow-lg);
}

.qr-close {
	position: absolute;
	top: 16rpx;
	right: 16rpx;
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	background: var(--surface);
	display: flex;
	align-items: center;
	justify-content: center;
}

.qr-close text {
	font-size: 32rpx;
	color: var(--muted);
	font-weight: 300;
}

.qr-title {
	font-size: 36rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.qr-subtitle {
	font-size: 24rpx;
	line-height: 1.55;
	color: var(--muted);
	text-align: center;
}

.qr-image-wrap {
	width: 360rpx;
	height: 360rpx;
	padding: 16rpx;
	border: 1px solid var(--line);
	border-radius: 16rpx;
	background: var(--canvas);
}

.qr-image {
	width: 100%;
	height: 100%;
}

.qr-tip {
	font-size: 22rpx;
	color: var(--muted);
}

/* ===== 隐私声明 ===== */
.privacy-card {
	padding: 22rpx 24rpx;
	border-radius: 18rpx;
	background: var(--sage-soft);
	display: flex;
	flex-direction: column;
	gap: 10rpx;
}

.privacy-title {
	font-size: 25rpx;
	font-weight: 800;
	color: var(--accent2);
}

.privacy-copy {
	font-size: 21rpx;
	line-height: 1.65;
	color: var(--ink2);
}

/* ===== 底部按钮 ===== */
.footer-safe {
	position: fixed;
	z-index: 20;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
	background: rgba(250, 252, 252, 0.96);
	border-top: 1px solid var(--line);
	flex-shrink: 0;
}

.submit-button {
	height: 86rpx;
	border-radius: 20rpx;
	background: var(--brown);
	color: var(--paper);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 28rpx;
	font-weight: 800;
}

.submit-button.disabled {
	opacity: 0.56;
}

/* ===== 客源线索工作台 ===== */
.workspace-lead-toolbar {
	margin-top: 14rpx;
	display: flex;
	flex-direction: row;
	gap: 10rpx;
}

.workspace-lead-tool {
	flex: 1;
	min-height: 66rpx;
	padding: 0 8rpx;
	border: 1px solid var(--match-line);
	border-radius: 12rpx;
	background: var(--surface);
	color: var(--ink2);
	text-align: center;
	font-size: 22rpx;
	font-weight: 700;
	display: flex;
	align-items: center;
	justify-content: center;
}

.workspace-lead-tool.active {
	background: var(--match-mist);
	border-color: var(--accent);
	color: var(--accent2);
}

.workspace-lead-tool.primary {
	background: var(--match-deep);
	border-color: var(--match-deep);
	color: var(--paper);
}

.workspace-lead-card {
	margin-top: 14rpx;
	padding: 22rpx 20rpx 16rpx;
	border: 1px solid var(--match-line);
	border-radius: 16rpx;
	background: var(--match-paper);
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	box-shadow: var(--match-shadow);
}

.workspace-lead-card .workspace-actions {
	padding-top: 12rpx;
	border-top: 1px solid var(--match-line);
	flex-wrap: wrap;
}

.workspace-lead-card .workspace-actions text {
	flex: 1 1 30%;
	min-width: 29%;
	padding: 12rpx 6rpx;
	border-radius: 10rpx;
	background: var(--match-mist);
	color: var(--accent2);
	font-size: 19rpx;
	font-weight: 700;
	text-align: center;
}

.workspace-lead-top {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	min-width: 0;
}

.workspace-lead-name {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	gap: 10rpx;
	min-width: 0;
}

.workspace-lead-title {
	color: var(--ink);
	font-size: 32rpx;
	font-weight: 800;
}

.workspace-lead-age {
	color: var(--muted);
	font-size: 21rpx;
}

.workspace-lead-time {
	color: var(--muted);
	font-size: 19rpx;
}

.workspace-lead-rows {
	display: flex;
	flex-direction: column;
}

.workspace-lead-rows > view {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 11rpx 0;
	border-bottom: 1px solid var(--match-line);
	color: var(--ink2);
	font-size: 22rpx;
	min-width: 0;
}

.workspace-lead-rows > view:last-child {
	border-bottom: none;
}

.workspace-lead-rows > view text:last-child {
	color: var(--ink);
	font-weight: 600;
	text-align: right;
	max-width: 72%;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.workspace-lead-status-new {
	color: var(--accent2) !important;
}

.workspace-lead-status-ok {
	color: var(--accent2) !important;
}

.workspace-lead-status-warn {
	color: var(--match-coral) !important;
}

.workspace-lead-status-muted {
	color: var(--muted) !important;
}

.workspace-lead-stale {
	color: var(--match-coral) !important;
	font-weight: 700 !important;
}

.workspace-lead-click-row {
	min-height: 48rpx;
}

.workspace-lead-intention {
	color: var(--accent2) !important;
}

/* 跟进记录面板 */
.workspace-follow-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14rpx;
	padding: 2rpx 0 16rpx;
}

.workspace-follow-back {
	color: var(--accent2);
	font-size: 24rpx;
	font-weight: 700;
}

.workspace-follow-title {
	color: var(--ink);
	font-size: 28rpx;
	font-weight: 800;
}

.workspace-follow-list {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.workspace-follow-item {
	padding: 20rpx;
	border-radius: 16rpx;
	background: var(--match-mist);
	border: 1px solid var(--match-line);
	display: flex;
	flex-direction: column;
	gap: 10rpx;
}

.workspace-follow-item-top {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
}

.workspace-follow-method {
	color: var(--accent2);
	font-size: 21rpx;
	font-weight: 800;
}

.workspace-follow-time {
	color: var(--muted);
	font-size: 20rpx;
}

.workspace-follow-content {
	color: var(--ink);
	font-size: 24rpx;
	line-height: 1.5;
}

.workspace-follow-intention {
	color: var(--muted);
	font-size: 20rpx;
}

.workspace-follow-form {
	margin-top: 20rpx;
	padding: 22rpx;
	border-radius: 16rpx;
	background: var(--match-paper);
	border: 1px solid var(--match-line);
	display: flex;
	flex-direction: column;
	gap: 14rpx;
	box-shadow: var(--shadow-sm);
}

.workspace-follow-form-title {
	color: var(--ink);
	font-size: 24rpx;
	font-weight: 800;
}

.workspace-follow-methods {
	display: flex;
	flex-direction: row;
	gap: 10rpx;
	flex-wrap: wrap;
}

.workspace-follow-method-chip {
	padding: 10rpx 24rpx;
	border-radius: 999rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--ink2);
	font-size: 21rpx;
	font-weight: 700;
}

.workspace-follow-method-chip.active {
	background: var(--match-deep);
	border-color: var(--match-deep);
	color: var(--paper);
}

.workspace-follow-textarea {
	width: 100%;
	min-height: 110rpx;
	padding: 16rpx;
	border-radius: 12rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--ink);
	font-size: 23rpx;
	box-sizing: border-box;
}

.workspace-follow-submit {
	padding: 16rpx 0;
	border-radius: 14rpx;
	background: var(--match-deep);
	color: var(--paper);
	text-align: center;
	font-size: 24rpx;
	font-weight: 800;
}

/* 底部弹层内容 */
.workspace-option-list {
	display: flex;
	flex-direction: column;
}

.workspace-option {
