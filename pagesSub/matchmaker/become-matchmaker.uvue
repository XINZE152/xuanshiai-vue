const workspaceVisibleMembers = computed(() => {
	let rows = workspaceMembers.value
	if (workspaceActiveTab.value == '进行中') rows = rows.filter((item: any) => item.reviewStatus == 'PENDING')
	if (workspaceActiveTab.value == '已完成') rows = rows.filter((item: any) => item.reviewStatus != 'PENDING')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.name) + String(item.id) + String(item.status) + String(item.gender)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleLeads = computed(() => {
	let rows = workspaceLeads.value
	if (workspaceActiveTab.value == '已放弃线索') rows = rows.filter((item: any) => item.status == 'LOST')
	if (workspaceActiveTab.value == '客源线索') rows = rows.filter((item: any) => item.status != 'LOST')
	// 弃海池按弃海时点倒序（最新放弃在最上）：接口整体按客源 id 倒序，早录入晚放弃的会沉底。
	if (workspaceActiveTab.value == '已放弃线索') {
		rows = rows.slice().sort((a: any, b: any): number => {
			const left = String(a.abandonedAt)
			const right = String(b.abandonedAt)
			if (left == right) return Number(b.id) - Number(a.id)
			if (left.length == 0) return 1
			if (right.length == 0) return -1
			return left < right ? 1 : -1
		})
	}
	if (leadFilterStatus.value.length > 0) rows = rows.filter((item: any) => leadFilterStatus.value.indexOf(item.status) >= 0)
	if (leadFilterIntention.value > 0) rows = rows.filter((item: any) => Number(item.intentionValue) == leadFilterIntention.value)
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.name) + String(item.phone) + String(item.wechat) + String(item.source)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleMatches = computed(() => {
	let rows = workspaceMatches.value
	if (workspaceActiveTab.value == '待牵线') rows = rows.filter((item: any) => item.status == 'PENDING')
	if (workspaceActiveTab.value == '牵线中') rows = rows.filter((item: any) => item.status == 'IN_PROGRESS')
	if (workspaceActiveTab.value == '成功') rows = rows.filter((item: any) => item.status == 'SUCCEEDED')
	if (workspaceActiveTab.value == '失败') rows = rows.filter((item: any) => item.status == 'FAILED')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.id) + String(item.statusLabel) + String(item.fromUser.name) + String(item.toUser.name)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})
const workspaceVisibleMeetings = computed(() => {
	let rows = workspaceMeetings.value
	if (workspaceActiveTab.value == '待处理') rows = rows.filter((item: any) => item.phase == 'PROCESSING')
	if (workspaceActiveTab.value == '待见面') rows = rows.filter((item: any) => item.phase == 'UPCOMING')
	if (workspaceActiveTab.value == '已完成') rows = rows.filter((item: any) => item.phase == 'COMPLETED')
	if (workspaceActiveTab.value == '已结束') rows = rows.filter((item: any) => item.phase == 'ENDED')
	const keyword = workspaceKeyword.value.trim().toLowerCase()
	if (keyword.length == 0) return rows
	return rows.filter((item: any) => {
		const content = (String(item.id) + String(item.applicant.name) + String(item.target.name) + String(item.statusLabel)).toLowerCase()
		return content.indexOf(keyword) >= 0
	})
})

