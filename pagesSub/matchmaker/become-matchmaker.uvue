	if (matchStatusChoice.value == 'FAILED' && matchFailureReason.value.trim().length == 0) {
		showToast('牵线失败需要填写失败原因')
		return
	}
	matchStatusSubmitting.value = true
	try {
		const result = await updateMatchmakerIntroductionStatus(String(row.id), matchStatusChoice.value, matchFailureReason.value)
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			return
		}
		matchStatusSheetVisible.value = false
		showToast('牵线状态已更新')
		await loadWorkspaceMatches()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		matchStatusSubmitting.value = false
	}
}

// ===== 约见申请：审核状态弹窗 / 删除确认 / 回顶部 =====
const meetingStatusSheetVisible = ref(false)
const meetingStatusRow = ref<any>(null)
const meetingStatusChoice = ref('ACCEPTED')
const meetingStatusSubmitting = ref(false)
const meetingDeleteSheetVisible = ref(false)
const meetingDeleteRow = ref<any>(null)
const meetingDeleteSubmitting = ref(false)
// 已处理选项映射服务端状态；待处理回 SUBMITTED 用于误操作还原。
const openMeetingStatusSheet = (row: any) => {
	meetingStatusRow.value = row
	meetingStatusChoice.value = row.phase == 'PROCESSING' ? 'ACCEPTED' : 'SUBMITTED'
	meetingStatusSheetVisible.value = true
}
const submitMeetingStatus = async () => {
	const row = meetingStatusRow.value
	if (row == null || meetingStatusSubmitting.value) return
	meetingStatusSubmitting.value = true
	try {
		const result = await updateMatchmakerMeetingStatus(String(row.id), meetingStatusChoice.value)
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '状态更新失败')
			return
		}
		meetingStatusSheetVisible.value = false
		showToast('状态已更新')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingStatusSubmitting.value = false
	}
}
const openMeetingDeleteSheet = (row: any) => {
	meetingDeleteRow.value = row
	meetingDeleteSheetVisible.value = true
}
const submitMeetingDelete = async () => {
	const row = meetingDeleteRow.value
	if (row == null || meetingDeleteSubmitting.value) return
	meetingDeleteSubmitting.value = true
	try {
		const result = await deleteMatchmakerMeetingRequest(String(row.id))
		if (!result.success) {
			showToast(result.message != null && String(result.message).length > 0 ? String(result.message) : '删除失败')
			return
		}
		meetingDeleteSheetVisible.value = false
		showToast('记录已删除')
		await loadWorkspaceMeetings()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	} finally {
		meetingDeleteSubmitting.value = false
	}
}
const workspaceScrollTop = ref(0)
const scrollWorkspaceTop = () => {
	// scroll-top 仅在值变化时触发滚动；0 与 0.1 交替保证重复点击同样回到顶部。
	workspaceScrollTop.value = workspaceScrollTop.value == 0 ? 0.1 : 0
}

const openWorkspace = async (title: string, kind: string, initialTab: string = '') => {
	workspaceTitle.value = title
	workspaceKind.value = kind
	workspaceActiveTab.value = initialTab.length > 0 ? initialTab : (kind == 'commission' ? '分成明细' : (kind == 'lead' ? '客源线索' : '全部'))
	workspaceKeyword.value = ''
	workspaceVisible.value = true
	if (kind == 'member') await loadWorkspaceMembers()
	if (kind == 'lead') await loadWorkspaceLeads()
	if (kind == 'match') await loadWorkspaceMatches()
	if (kind == 'meeting') await loadWorkspaceMeetings()
}

const refreshManagementCenter = async () => {
	await loadManagementAccess()
	if (!canEnterManagementCenter.value) {
		exitManagementCenter()
		showToast('当前开通状态已变化，已返回申请页')
		return
	}
	try {
		const result = await getMatchmakerManagementCenterSnapshot()
		if (result.success && result.data != null) {
			managementCenterSnapshot.value = result.data
			await refreshBusinessMetricCounts()
			showToast('工作台已刷新')
		} else {
			showToast(result.message != null ? String(result.message) : '工作台刷新失败')
		}
	} catch (e) {
		showToast('工作台刷新失败，请检查网络后重试')
	}
}

const handleManagementCenterAction = (name: string) => {
	if (name == 'metric:pending_introduction') {
		openWorkspace('待我牵线', 'match', '待牵线')
		return
	}
	if (name == 'metric:introduction_succeeded') {
		openWorkspace('牵线成功', 'match', '成功')
		return
	}
	if (name == 'metric:meeting_requests') {
		openWorkspace('约见申请', 'meeting', '处理中')
		return
	}
	if (name == 'metric:pending_meeting') {
		openWorkspace('待见面', 'meeting', '待见面')
		return
	}
	if (name == '资料待审') {
		openPendingReview('PENDING')
		return
	}
	if (name == '查看全部会员') {
		openPendingReview('')
		return
	}
	if (name == '查看我服务的' || name == '我服务的') {
		openPendingReview('mine')
		return
	}
	if (name == '分成明细' || name == '查看分成明细' || name == '财务明细' || name == '查看财务明细') {
		openWorkspace(name.indexOf('财务') >= 0 ? '财务明细' : '线上分成', 'commission')
		return
	}
	if (name == '录入线索' || name == '录入会员') {
		openWorkspace(name == '录入线索' ? '录入客源线索' : '录入会员', 'entry')
		return
	}
	if (name.indexOf('客源') >= 0) {
		openWorkspace('客源线索', 'lead')
		return
	}
	if (name.indexOf('约见') >= 0 || name.indexOf('约会') >= 0 || name == '安排约见') {
		openWorkspace(name.indexOf('约会') >= 0 ? '待见面' : '约见申请', 'meeting', name.indexOf('约会') >= 0 ? '待见面' : '')
		return
	}
	if (name.indexOf('牵线') >= 0 || name == '添加牵线') {
		openWorkspace(name == '查看牵线记录' ? '牵线管理' : name, 'match')
		return
	}
	if (name.indexOf('推广') >= 0 || name.indexOf('海报') >= 0 || name.indexOf('链接') >= 0) {
		openWorkspace('专属推广工具', 'commission')
		return
	}
	if (name.indexOf('活动') >= 0) {
		openWorkspace(name, 'activity')
		return
	}
	if (name.indexOf('会员') >= 0 || name.indexOf('我服务的') >= 0) {
		openWorkspace(name.replace('查看', ''), 'member')
		return
	}
	if (name.indexOf('视频') >= 0) {
		openWorkspace('视频管理', 'video')
		return
	}
	if (name.indexOf('账号') >= 0) {
		openWorkspace('我的账号', 'account')
		return
	}
	openWorkspace(name.replace('查看', ''), 'general')
}

const openMatchmakerIdentity = () => {
	uni.navigateTo({
		url: '/pagesSub/profileExtra/certification',
		fail: () => showToast('个人身份信息打开失败，请稍后重试')
	})
}

onShow(() => {
	if (!managementCenterVisible.value && !pendingReviewVisible.value && !workspaceVisible.value) loadManagementAccess()
})

const guideToRequiredVerification = (message: string) => {
	const needsPhone = message.indexOf('绑定手机号') >= 0
	uni.showModal({
		title: needsPhone ? '请先绑定手机号' : '请先完成实名认证',
		content: needsPhone ? '绑定手机号后，还需要完成实名认证才可提交申请。' : '实名认证审核通过后即可提交申请。',
		confirmText: '去完成',
		success: (modal: any) => {
			if (modal.confirm) {
				uni.navigateTo({ url: '/pages/profile/certification?focus=' + (needsPhone ? 'phone' : 'realname') + '&returnTo=matchmaker' })
			}
		}
	})
}

const showExistingApplication = () => {
	uni.showModal({
		title: '申请正在审核',
		content: '你已提交服务红娘申请，请等待平台审核结果，无需重复提交。',
		confirmText: '查看状态',
		success: (modal: any) => {
			if (modal.confirm) uni.redirectTo({ url: '/pagesSub/matchmaker/application-success?type=service_matchmaker' })
		}
	})
}

// ===== 导航 =====
const goBack = () => {
	uni.navigateBack()
}

const handlePageBack = () => {
	if (pendingReviewVisible.value) {
		closePendingReview()
		return
	}
	if (workspaceVisible.value) {
		closeWorkspace()
		return
	}
	goBack()
}

const showHelp = () => {
	uni.showModal({
		title: '申请说明',
		content: '成为平台红娘需要经过实名认证、资料审核和培训流程。审核通常在 1-3 个工作日内完成，审核结果将通过短信通知你。如有问题，请联系客服。',
		showCancel: false,
		confirmText: '知道了'
	})
}

const callConsult = () => {
	uni.showModal({
		title: '电话咨询',
		content: '咨询热线：400-XXX-XXXX（工作时间：周一至周五 9:00-18:00）',
		showCancel: false,
		confirmText: '知道了'
	})
}

const wechatConsult = () => {
	qrVisible.value = true
}

// ===== 表单输入 =====
const onRealNameInput = (e: any) => { realName.value = e.detail.value }
const onPhoneInput = (e: any) => { phone.value = e.detail.value }
const onWechatInput = (e: any) => { wechat.value = e.detail.value }
const onIntroductionInput = (e: any) => { introduction.value = e.detail.value }
const onPriceInput = (e: any) => { price.value = e.detail.value }

const isValidOptionalPrice = (): boolean => {
	const value = price.value.trim()
	if (value.length == 0) return true
	const amount = Number(value)
	return !isNaN(amount) && amount >= 0 && amount <= 1000000
}

// ===== 头像上传 =====
const uploadAvatar = () => {
	uni.chooseImage({
		count: 1,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res: any) => {
			if (res.tempFilePaths && res.tempFilePaths.length > 0) {
				avatar.value = res.tempFilePaths[0]
				showToast('头像已上传')
			}
		}
	})
}

// ===== 擅长领域 =====
const toggleSpecialty = (item: string) => {
	const idx = specialties.value.indexOf(item)
	if (idx >= 0) {
		specialties.value.splice(idx, 1)
	} else {
		if (specialties.value.length >= 5) {
			showToast('最多选择 5 个擅长领域')
			return
		}
		specialties.value.push(item)
	}
}

// ===== 成功案例 =====
const addCase = () => {
	if (successCases.value.length >= 3) return
	successCases.value.push({ description: '', images: [] })
}

const removeCase = (index: number) => {
	successCases.value.splice(index, 1)
}

const onCaseDescriptionInput = (index: number, e: any) => {
	if (index >= 0 && index < successCases.value.length) {
		successCases.value[index].description = e.detail.value
	}
}

const uploadCaseImage = (index: number) => {
	uni.chooseImage({
		count: 3 - successCases.value[index].images.length,
		sizeType: ['compressed'],
		sourceType: ['album', 'camera'],
		success: (res: any) => {
			if (res.tempFilePaths && res.tempFilePaths.length > 0) {
				const imgs = res.tempFilePaths as string[]
				for (let i = 0; i < imgs.length; i++) {
					successCases.value[index].images.push(imgs[i])
				}
			}
		}
	})
}

const removeCaseImage = (caseIndex: number, imgIndex: number) => {
	if (caseIndex >= 0 && caseIndex < successCases.value.length) {
		successCases.value[caseIndex].images.splice(imgIndex, 1)
	}
}

// ===== 提交申请 =====
const submitApplication = async () => {
	if (submitting.value) return

	// 基本信息校验
	if (realName.value.trim().length < 2 || realName.value.trim().length > 64) {
		showToast('真实姓名需为 2-64 个字符')
		return
	}
	if (!/^1[3-9]\d{9}$/.test(phone.value.trim())) {
		showToast('请填写正确的 11 位手机号')
		return
	}
	if (wechat.value.trim().length === 0 || wechat.value.trim().length > 128) {
		showToast('微信号需为 1-128 个字符')
		return
	}

	// 红娘资料校验
	if (avatar.value.length === 0 || avatar.value.length > 512) {
		showToast('请上传有效头像')
		return
	}
	if (introduction.value.trim().length < 10 || introduction.value.trim().length > 2000) {
		showToast('个人简介需为 10-2000 个字符')
		return
	}
	if (specialties.value.length === 0) {
		showToast('请至少选择一个擅长领域')
		return
	}
	if (!isValidOptionalPrice()) {
		showToast('服务价格需为 0-1000000 的数字')
		return
	}
	for (let index = 0; index < successCases.value.length; index++) {
		const description = successCases.value[index].description.trim()
		if (description.length > 1000) {
			showToast('成功案例说明最多 1000 个字符')
			return
		}
	}

	try {
		submitting.value = true

		const formData = {
			realName: realName.value.trim(),
			phone: phone.value.trim(),
			wechat: wechat.value.trim(),
			avatar: avatar.value,
			introduction: introduction.value.trim(),
			specialties: specialties.value,
			price: price.value.trim().length > 0 ? Number(price.value.trim()) : undefined,
			cases: successCases.value
				.filter((c: CaseItem) => c.description.trim().length > 0)
				.map((c: CaseItem) => ({
					description: c.description.trim(),
					images: c.images
				}))
		}

		const result = await submitMatchmakerApplication(formData)

		if (result.success) {
			const applicationId = result.data != null && result.data.id != null ? String(result.data.id) : ''
			uni.redirectTo({
				url: '/pagesSub/matchmaker/application-success?type=service_matchmaker&id=' + applicationId
			})
		} else {
			const message = result.message != null ? String(result.message) : '提交失败，请稍后重试'
			if (result.code == 403 && (message.indexOf('绑定手机号') >= 0 || message.indexOf('实名认证') >= 0)) {
				guideToRequiredVerification(message)
			} else if (result.code == 409) {
				showExistingApplication()
			} else {
				showToast(message)
			}
		}
	} catch (e) {
		showToast('提交失败，请稍后重试')
	} finally {
		submitting.value = false
	}
}
</script>

<style scoped>
