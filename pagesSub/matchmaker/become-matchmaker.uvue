const leadFollowPanelVisible = ref(false)
const leadFollowLeadId = ref('')
const leadFollowLeadName = ref('')
const leadFollowLoading = ref(false)
const leadFollowError = ref('')
const leadFollowRecords = ref<any[]>([])
const leadFollowMethods = [
	{ value: 'PHONE', label: '电话' },
	{ value: 'WECHAT', label: '微信' },
	{ value: 'VISIT', label: '到店' },
	{ value: 'OTHER', label: '其他' }
]
const leadFollowMethod = ref('PHONE')
const leadFollowContent = ref('')
const openLeadFollowPanel = (row: any) => {
	leadFollowLeadId.value = String(row.id)
	leadFollowLeadName.value = String(row.name)
	leadFollowPanelVisible.value = true
	loadLeadFollowRecords()
}
const closeLeadFollowPanel = () => {
	leadFollowPanelVisible.value = false
	leadFollowContent.value = ''
}
const loadLeadFollowRecords = async () => {
	leadFollowLoading.value = true
	leadFollowError.value = ''
	try {
		const result = await getWorkspaceLeadFollowUps(leadFollowLeadId.value)
		if (!result.success || result.data == null) {
			leadFollowRecords.value = []
			leadFollowError.value = result.message != null ? String(result.message) : '跟进记录加载失败'
			return
		}
		const items = Array.isArray(result.data.items) ? result.data.items : []
		leadFollowRecords.value = items.map((item: any) => ({
			id: String(item.id),
			methodLabel: followUpMethodLabels[item.method] != null ? followUpMethodLabels[item.method] as string : '其他',
			content: item.content != null ? String(item.content) : '',
			time: formatLeadTime(item.created_at),
			intentionLabel: item.intention_level != null ? (intentionLabels[Number(item.intention_level)] as string) : ''
		}))
	} catch (e) {
		leadFollowRecords.value = []
		leadFollowError.value = '网络数据加载失败，请检查本地服务后重试'
	} finally {
		leadFollowLoading.value = false
	}
}
const submitLeadFollowUp = async () => {
	const content = leadFollowContent.value.trim()
	if (content.length == 0) {
		showToast('请填写跟进内容')
		return
	}
	try {
		const result = await addWorkspaceLeadFollowUp(leadFollowLeadId.value, { method: leadFollowMethod.value, content: content })
		if (!result.success) {
			showToast(result.message != null ? String(result.message) : '跟进保存失败')
			return
		}
		leadFollowContent.value = ''
		showToast('跟进已记录')
		await loadLeadFollowRecords()
		await loadWorkspaceLeads()
	} catch (e) {
		showToast('网络异常，请稍后重试')
	}
}

