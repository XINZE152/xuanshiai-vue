.workspace-match-add-picker { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-match-add-picker text { color: var(--ink2); font-size: 24rpx; max-width: 340rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.workspace-match-add-picker text.placeholder { color: var(--muted); }
.workspace-match-add-picker i { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); flex-shrink: 0; }
.workspace-match-add-result { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-match-add-result > text { color: var(--ink2); font-size: 24rpx; }
.workspace-match-add-result > text.radio-on { color: var(--ink); font-weight: 700; }
.workspace-match-add-radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 1rpx solid var(--line); background: var(--surface); display: flex; align-items: center; justify-content: center; }
.workspace-match-add-radio.active { background: var(--accent2); border-color: var(--accent2); }
.workspace-match-add-radio.active text { color: var(--paper); font-size: 20rpx; font-weight: 900; }
.workspace-match-add-note { margin: 16rpx 0 6rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: var(--match-mist); display: flex; flex-direction: row; gap: 10rpx; }
.workspace-match-add-note-mark { width: 28rpx; height: 28rpx; border-radius: 50%; background: var(--accent2); color: var(--paper); font-size: 17rpx; font-weight: 800; text-align: center; line-height: 28rpx; flex-shrink: 0; }
.workspace-match-add-note > text:last-child { flex: 1; color: var(--ink2); font-size: 20rpx; line-height: 1.6; }
.workspace-match-add-submit { margin-top: 10rpx; min-height: 92rpx; border-radius: 16rpx; background: linear-gradient(90deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; }
