.workspace-match-add-submit.disabled { opacity: .55; }
.workspace-match-add-submit:active { opacity: .85; }
.workspace-meeting-overview { margin-top: 4rpx; padding: 21rpx 22rpx; border-radius: 20rpx; background: var(--match-mist); display: flex; flex-direction: column; gap: 8rpx; color: var(--accent2); font-size: 20rpx; line-height: 1.45; }.workspace-meeting-overview > view { display: flex; align-items: baseline; gap: 12rpx; }.workspace-meeting-overview-value { color: var(--match-deep); font-family: var(--serif); font-size: 48rpx; line-height: 1; font-weight: 700; }.workspace-meeting-overview-label { color: var(--ink2); font-size: 22rpx; font-weight: 700; }.workspace-meeting-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: var(--match-paper); display: flex; flex-direction: column; gap: 18rpx; box-shadow: var(--match-shadow); }.workspace-meeting-card-top { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 19rpx; }.workspace-meeting-status { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; line-height: 1.2; }.workspace-meeting-status-submitted { background: var(--accent-bg); color: var(--accent2); }.workspace-meeting-status-processing { background: var(--match-sky); color: var(--match-deep); }.workspace-meeting-status-upcoming { background: var(--sage-soft); color: var(--sage); }.workspace-meeting-status-completed { background: var(--match-mist); color: var(--accent2); }.workspace-meeting-status-ended { background: var(--match-blush); color: var(--match-coral); }.workspace-meeting-pair { padding: 18rpx 0; border-top: 1rpx solid var(--match-line); border-bottom: 1rpx solid var(--match-line); display: flex; align-items: center; gap: 10rpx; }.workspace-meeting-person { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; }.workspace-meeting-person image { width: 58rpx; height: 58rpx; border-radius: 50%; flex-shrink: 0; }.workspace-meeting-person > view { min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }.workspace-meeting-person > view text:first-child { color: var(--ink); font-size: 22rpx; font-weight: 800; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.workspace-meeting-person > view text:last-child { color: var(--muted); font-size: 18rpx; }.workspace-meeting-link { width: 58rpx; height: 38rpx; border-radius: 999rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; color: var(--accent2); font-size: 17rpx; font-weight: 800; flex-shrink: 0; }.workspace-meeting-arrangement { padding: 16rpx; border-radius: 14rpx; background: var(--surface); display: flex; flex-direction: column; gap: 8rpx; }.workspace-meeting-arrangement > text { color: var(--accent2); font-size: 19rpx; font-weight: 800; }.workspace-meeting-arrangement > view { display: flex; justify-content: space-between; gap: 14rpx; color: var(--ink2); font-size: 20rpx; }.workspace-meeting-arrangement > view text:last-child { flex: 1; min-width: 0; text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }.workspace-meeting-detail { color: var(--ink2); font-size: 20rpx; line-height: 1.5; }.workspace-meeting-time { color: var(--muted); font-size: 18rpx; }

/* 约见申请（按设计稿）：浅紫须知卡 + 白卡双列大头像 + 灰盒元信息 + 实心胶囊操作 + 圆形回顶。 */
.workspace-meeting-intro { margin-top: 4rpx; padding: 30rpx 30rpx; border-radius: 24rpx; background: var(--accent-bg); display: flex; flex-direction: column; gap: 14rpx; }
.workspace-meeting-intro-head { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.workspace-meeting-intro-mark { width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--accent2); color: var(--paper); font-size: 19rpx; font-weight: 800; text-align: center; line-height: 34rpx; }
.workspace-meeting-intro-title { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.workspace-meeting-intro-text { color: var(--ink2); font-size: 23rpx; line-height: 1.7; }
.workspace-meeting-card { margin-top: 20rpx; padding: 30rpx 26rpx 26rpx; border-radius: 24rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 20rpx; }
.workspace-meeting-pair { display: flex; flex-direction: row; align-items: center; gap: 12rpx; padding: 0; border-top: none; border-bottom: none; }
.workspace-meeting-pair .workspace-meeting-person { flex-direction: column; align-items: center; }
.workspace-meeting-person { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.workspace-meeting-avatar-wrap { position: relative; width: 110rpx; height: 110rpx; }
.workspace-meeting-avatar-wrap image { width: 110rpx; height: 110rpx; border-radius: 50%; background: var(--warm); }
.workspace-meeting-gender { position: absolute; right: -2rpx; bottom: -2rpx; width: 34rpx; height: 34rpx; border-radius: 50%; border: 3rpx solid var(--surface); box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 800; color: var(--paper); }
.workspace-meeting-gender.male { background: var(--match-sky); color: var(--match-deep); }
.workspace-meeting-gender.female { background: var(--match-blush); color: var(--match-coral); }
.workspace-meeting-name { max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 27rpx; font-weight: 800; }
.workspace-meeting-name-row { max-width: 250rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 6rpx; }
.workspace-meeting-name-row .workspace-meeting-name { max-width: 176rpx; }
.workspace-meeting-vip { padding: 1rpx 10rpx; border-radius: 6rpx; font-size: 17rpx; font-weight: 800; color: #ffffff; background: #b98a2b; flex-shrink: 0; }
.workspace-meeting-avatar-wrap:active { opacity: .8; }
.workspace-meeting-name-row:active { opacity: .7; }
.workspace-meeting-person-code { color: var(--muted); font-size: 21rpx; }
.workspace-meeting-wish { padding: 10rpx 24rpx; border-radius: 999rpx; background: var(--accent-bg); flex-shrink: 0; }
.workspace-meeting-wish text { color: var(--accent2); font-size: 23rpx; font-weight: 800; }
.workspace-meeting-meta { padding: 20rpx 22rpx; border-radius: 16rpx; background: var(--warm); display: flex; flex-direction: column; gap: 10rpx; }
.workspace-meeting-meta-line { display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.workspace-meeting-meta-glyph { font-size: 20rpx; }
.workspace-meeting-meta-line text { color: var(--ink2); font-size: 22rpx; }
.workspace-meeting-foot { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; }
.workspace-meeting-status-btn { height: 72rpx; padding: 0 30rpx; border-radius: 999rpx; display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 12rpx; }
.workspace-meeting-status-btn text { color: var(--paper); font-size: 25rpx; font-weight: 800; }
.workspace-meeting-status-arrow { width: 30rpx; height: 30rpx; border-radius: 50%; background: rgba(255, 255, 255, .28); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-status-arrow i { width: 11rpx; height: 11rpx; border-top: 3rpx solid var(--paper); border-right: 3rpx solid var(--paper); transform: rotate(45deg); margin-left: -4rpx; }
.workspace-meeting-status-btn.pending { background: var(--accent2); }
.workspace-meeting-status-btn.done { background: var(--match-coral); }
.workspace-meeting-status-btn:active { opacity: .8; transform: scale(.97); }
.workspace-meeting-delete { height: 72rpx; padding: 0 34rpx; border-radius: 999rpx; background: var(--warm); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-delete text { color: var(--ink2); font-size: 24rpx; font-weight: 700; }
.workspace-meeting-delete:active { opacity: .75; }
.workspace-scroll-top { position: fixed; right: 30rpx; bottom: 130rpx; z-index: 20; width: 108rpx; height: 108rpx; border-radius: 50%; background: var(--surface); box-shadow: 0 8rpx 30rpx rgba(70, 70, 105, .16); display: flex; align-items: center; justify-content: center; }
.workspace-scroll-top-arrow { color: var(--ink2); font-size: 40rpx; font-weight: 900; line-height: 1; }
.workspace-scroll-top:active { opacity: .8; transform: scale(.95); }


.workspace-meeting-status-form { display: flex; flex-direction: column; gap: 20rpx; }

.workspace-meeting-status-pair { display: flex; flex-direction: row; gap: 20rpx; }
.workspace-meeting-status-pill { flex: 1; min-width: 0; min-height: 92rpx; border-radius: 999rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; }
.workspace-meeting-status-pill text { color: var(--ink2); font-size: 27rpx; font-weight: 700; }
.workspace-meeting-status-pill.active { background: var(--accent-bg); border-color: var(--accent2); }
.workspace-meeting-status-pill.active text { color: var(--accent2); font-weight: 800; }
.workspace-meeting-status-pill:active { opacity: .78; }
.workspace-member-header { display: flex; align-items: center; gap: 15rpx; }.workspace-member-header > view { display: flex; flex-direction: column; gap: 6rpx; color: var(--muted); font-size: 20rpx; font-weight: 400; }.workspace-member-header > view text:first-child { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.workspace-entry-card { margin-top: 18rpx; padding: 26rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 18rpx; color: var(--ink); font-size: 28rpx; font-weight: 800; box-shadow: var(--shadow-sm); }

/* 录入客源线索：分步卡片 + chips 单选 + 示例填充，复用工作台 Token。 */
.workspace-entry-page { display: flex; flex-direction: column; gap: 20rpx; padding-bottom: 40rpx; }
.workspace-entry-hero { padding: 22rpx 26rpx; border-radius: 20rpx; background: var(--match-mist); display: flex; flex-direction: row; align-items: center; gap: 18rpx; }
.workspace-entry-hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.workspace-entry-hero-title { color: var(--accent2); font-size: 25rpx; font-weight: 800; }
.workspace-entry-hero-sub { color: var(--ink2); font-size: 21rpx; line-height: 1.5; }
.workspace-entry-demo { padding: 14rpx 24rpx; border-radius: 999rpx; background: var(--surface); box-shadow: var(--shadow-sm); flex-shrink: 0; }
.workspace-entry-demo text { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.workspace-entry-demo:active { opacity: .75; transform: scale(.98); }
.workspace-entry-formcard { margin-top: 0; padding: 26rpx; border-radius: 20rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
.workspace-entry-card-head { display: flex; flex-direction: row; align-items: center; gap: 14rpx; padding-bottom: 6rpx; }
.workspace-entry-step { width: 40rpx; height: 40rpx; border-radius: 12rpx; background: var(--accent); color: var(--paper); font-size: 21rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.workspace-entry-card-head-copy { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12rpx; }
.workspace-entry-card-title { color: var(--ink); font-size: 27rpx; font-weight: 800; }
.workspace-entry-card-require { color: var(--muted); font-size: 20rpx; }
.workspace-entry-row { display: flex; flex-direction: row; align-items: center; gap: 14rpx; min-height: 92rpx; border-bottom: 1px solid var(--line); }
.workspace-entry-row.last { border-bottom: none; }
.workspace-entry-label { width: 84rpx; color: var(--ink2); font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
.workspace-entry-row input { flex: 1; min-width: 0; color: var(--ink); font-size: 25rpx; }
/* 带 typo 的卡片（基础信息、身形与属地）字号向「学历」气泡看齐：标签 28rpx、控件文字 27rpx。
   只动字号，颜色和字重保持原样。 */
.workspace-entry-formcard-typo .workspace-entry-label { font-size: 28rpx; }
.workspace-entry-formcard-typo .workspace-entry-row input { font-size: 27rpx; }
.workspace-entry-formcard-typo .workspace-entry-picker text { font-size: 27rpx; }
.workspace-entry-formcard-typo .ls-chip text { font-size: 27rpx; }
.workspace-entry-picker { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 10rpx; }
.workspace-entry-picker text { color: var(--ink2); font-size: 25rpx; }
.workspace-entry-picker i { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); }
.workspace-entry-block { padding: 20rpx 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 14rpx; }
.workspace-entry-block.last { border-bottom: none; padding-bottom: 4rpx; }
/* 购房面板展开时隐藏本行分隔线：1px 实线会穿过半透明投影，把软阴影切成一条硬边。 */
.workspace-entry-block-floating { border-bottom-color: transparent; }
.workspace-entry-block-label { color: var(--ink); font-size: 28rpx; font-weight: 800; }
.workspace-entry-chip { padding: 10rpx 24rpx; border-radius: 999rpx; background: var(--surface); border: 1px solid var(--match-line); }
.workspace-entry-chip text { color: var(--ink2); font-size: 21rpx; font-weight: 700; }
.workspace-entry-chip.active { background: var(--match-deep); border-color: var(--match-deep); }
.workspace-entry-chip.active text { color: var(--paper); }
.workspace-entry-chip:active { opacity: .75; }
/* 会员标签云：未选中为中性浅灰底，选中用描边 + 浅底 + 勾。勾位常驻占位、只切透明度，
   所以每个标签的宽度和位置固定，勾选不会挤动同行标签。 */
.workspace-tag-cloud { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 18rpx 16rpx; }
.workspace-tag-chip { display: flex; flex-direction: row; align-items: center; gap: 6rpx; padding: 16rpx 40rpx 16rpx 14rpx; border-radius: 999rpx; border: 2rpx solid transparent; background: #F1F3F2; }
.workspace-tag-chip text { color: var(--ink2); font-size: 22rpx; font-weight: 700; line-height: 1; }
/* 勾统一 20rpx 且固定在等宽盒内，避免大字号时溢出药丸左缘被裁切。 */
.workspace-tag-chip .workspace-tag-check { width: 20rpx; flex-shrink: 0; font-size: 20rpx; text-align: center; opacity: 0; }
.workspace-tag-check.on { opacity: 1; }
.workspace-tag-chip.active { background: var(--match-mist); border-color: var(--match-deep); box-shadow: 0 4rpx 14rpx rgba(21, 74, 69, .14); }
.workspace-tag-chip.active text { color: var(--match-deep); }
.workspace-tag-chip:active { opacity: .7; }
.workspace-tag-reset { margin-left: auto; padding: 16rpx 30rpx; border-radius: 999rpx; background: var(--match-blush); }
.workspace-tag-reset text { color: var(--match-coral); font-size: 22rpx; font-weight: 800; line-height: 1; }
/* 购房下拉：选项面板在表单内展开（enhanced scroll-view 里 fixed/absolute 包含块不可靠，会盖住上方内容）。
   白底、圆角、阴影只挂在最外层 .workspace-select 上，触发条和选项列表是它的两块透明内容，
   展开时是一个容器的两段，不是两个方块。阴影总扩散半径压在卡片内边距 26rpx 以内，避免跨底色跳出硬边。 */
.workspace-select { border-radius: 22rpx; background: var(--surface); box-shadow: 0 0 0 1rpx rgba(12, 19, 19, .06), 0 8rpx 22rpx rgba(12, 19, 19, .12); overflow: hidden; display: flex; flex-direction: column; }
/* 择偶职业仍用原生 picker 选择（滚轮弹层），只把它的点击条套进同一个气泡外壳：picker 默认宽度不撑满，需要拉满才能和别的下拉同宽。 */
.workspace-select-picker { width: 100%; }
.workspace-select-trigger { min-height: 88rpx; padding: 0 28rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 20rpx; }
.workspace-select-trigger text { color: var(--ink); font-size: 27rpx; font-weight: 500; }
.workspace-select-trigger .workspace-select-placeholder { color: var(--muted); font-weight: 400; }
/* 自由输入项（如宗教）套进同一个气泡外壳时，input 自己吃掉剩余宽度，字号与触发条正文对齐。 */
.workspace-select-trigger input { flex: 1; min-width: 0; background: transparent; color: var(--ink); font-size: 27rpx; font-weight: 500; }
/* 双人字箭头：两条边框拼出的转角是极尖锐角，细描边在尖点上会被光栅化削掉（像素图里两撇实心、尖点空白），
   所以给转角加小圆角把尖点变钝头；描边维持 3rpx 且用 --muted，比正文的 --ink 浅一档。 */
.workspace-select-caret { width: 36rpx; height: 44rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.workspace-select-caret-up { width: 18rpx; height: 18rpx; border-left: 3rpx solid var(--muted); border-top: 3rpx solid var(--muted); border-top-left-radius: 7rpx; transform: rotate(45deg); }
.workspace-select-caret-down { width: 18rpx; height: 18rpx; border-left: 3rpx solid var(--muted); border-bottom: 3rpx solid var(--muted); border-bottom-left-radius: 7rpx; transform: rotate(-45deg); }
.workspace-select-menu { padding: 0 12rpx 12rpx; display: flex; flex-direction: column; gap: 4rpx; }
.workspace-select-option { min-height: 84rpx; padding: 0 24rpx; border-radius: 18rpx; display: flex; flex-direction: row; align-items: center; }
.workspace-select-option text { color: var(--ink); font-size: 27rpx; font-weight: 400; }
.workspace-select-option.active { background: var(--match-mist); }
.workspace-select-option.active text { color: var(--match-deep); font-weight: 600; }
.workspace-select-option:active { background: var(--match-mist); }
.workspace-entry-textarea { width: 100%; min-height: 130rpx; padding: 16rpx; border-radius: 12rpx; background: var(--surface); border: 1px solid var(--match-line); color: var(--ink); font-size: 23rpx; line-height: 1.6; box-sizing: border-box; }
.workspace-entry-custom-input { width: 100%; margin-top: 14rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: var(--surface); border: 1px solid var(--match-line); color: var(--ink); font-size: 23rpx; }
/* 年龄 / 身高共用的同轴双向范围条（仿设计稿）。浅雾绿底板里绿/白两段，两个白色旋钮共用同一根轴，旋钮顶上一枚墨绿气泡读数。
   小程序会把「溢出定位祖先」的绝对子元素整块裁掉，所以既不能用负 margin 居中旋钮，也不能把定位盒缩窄：
   定位盒铺满轨道，位置一律写成 calc((100% - 一个旋钮宽) * 比例)，旋钮盒永远留在轨道内，端点上气泡和右端旋钮都不会被裁。
   刻度行用同一个 calc 表达式（比例 0/0.25/0.5/0.75/1、标签盒与旋钮同宽），标签中心与旋钮中心逐一对齐。 */
.member-range-plate { width: 100%; box-sizing: border-box; padding: 22rpx 28rpx 16rpx; border-radius: 28rpx; background: var(--match-mist); }
.member-range-track { position: relative; width: 100%; height: 140rpx; }
.member-range-rail { position: absolute; left: 0; right: 0; top: 96rpx; height: 44rpx; border-radius: 22rpx; background: rgba(21, 74, 69, .10); }
.member-range-fill { position: absolute; left: 8rpx; right: 8rpx; top: 102rpx; height: 32rpx; border-radius: 16rpx; background: var(--sage-soft); }
.member-range-travel { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.member-range-band { position: absolute; top: 102rpx; height: 32rpx; border-radius: 16rpx; background: var(--surface); box-shadow: inset 0 0 0 1px rgba(21, 74, 69, .06); }
.member-range-knob { position: absolute; top: 96rpx; width: 84rpx; display: flex; flex-direction: column; align-items: center; }
.member-range-knob-dot { width: 44rpx; height: 44rpx; border-radius: 22rpx; background: var(--surface); border: 1px solid var(--match-line); box-shadow: 0 4rpx 12rpx rgba(21, 74, 69, .18); }
/* 气泡单独一层（不再嵌在旋钮里）：两旋钮贴近时它需要横向让位，而小程序会裁掉溢出定位盒的子元素，只有平级才推得开。 */
.member-range-bubble { position: absolute; top: 37rpx; width: 84rpx; display: flex; flex-direction: column; align-items: center; }
.member-range-scale { position: relative; height: 28rpx; }
.member-range-scale-item { position: absolute; top: 0; width: 84rpx; display: flex; flex-direction: row; justify-content: center; }
.member-range-scale-text { color: var(--ink2); font-size: 20rpx; }
.member-range-bubble-box { width: 84rpx; height: 52rpx; border-radius: 14rpx; background: var(--match-deep); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.member-range-bubble-text { color: var(--match-paper); font-size: 26rpx; font-weight: 800; }
.member-range-bubble-tail { width: 14rpx; height: 14rpx; margin-top: -7rpx; border-radius: 3rpx; background: var(--match-deep); transform: rotate(45deg); }
.workspace-entry-submit { margin-top: 6rpx; min-height: 88rpx; border-radius: 999rpx; background: var(--accent); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm); }
.workspace-entry-submit text { color: var(--paper); font-size: 27rpx; font-weight: 800; }
.workspace-entry-submit.disabled { opacity: .55; }
.workspace-entry-submit:active { opacity: .8; transform: scale(.99); }
.workspace-entry-foot { display: flex; justify-content: center; }
.workspace-entry-foot text { color: var(--muted); font-size: 20rpx; text-align: center; }.workspace-entry-card > view:not(.workspace-entry-submit) { min-height: 72rpx; padding-bottom: 12rpx; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 20rpx; color: var(--ink2); font-size: 22rpx; font-weight: 400; }.workspace-entry-card input { flex: 1; text-align: right; font-size: 22rpx; color: var(--ink); }.workspace-entry-submit { height: 72rpx; border-radius: 999rpx; background: var(--accent); display: flex; align-items: center; justify-content: center; color: var(--paper); font-size: 24rpx; font-weight: 800; }
.workspace-generic-card { margin-top: 18rpx; padding: 24rpx; border-radius: 20rpx; background: var(--surface); display: flex; align-items: center; gap: 16rpx; box-shadow: var(--shadow-sm); }.workspace-generic-card > view:first-child { width: 58rpx; height: 58rpx; border-radius: 14rpx; background: var(--accent-bg); color: var(--accent2); display: flex; align-items: center; justify-content: center; font-size: 25rpx; }.workspace-generic-card > view:nth-child(2) { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }.workspace-generic-card > view:nth-child(2) text:first-child { font-size: 24rpx; font-weight: 800; }.workspace-generic-card > view:nth-child(2) text:last-child { color: var(--muted); font-size: 18rpx; }.workspace-generic-card > text:last-child { color: var(--accent2); font-size: 20rpx; }
.workspace-add { position: fixed; right: 22rpx; bottom: 38rpx; width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; color: var(--paper); font-size: 17rpx; font-weight: 800; box-shadow: var(--shadow-sm); }.workspace-add text:first-child { font-size: 30rpx; line-height: 28rpx; }

/* 微信小程序 uvue 必须显式标记横向 flex，避免文字与操作按钮纵向叠压。 */
.workspace-tabs, .workspace-search, .workspace-promotion > view, .workspace-commission-row > view, .workspace-info-card > view:not(.workspace-actions):not(.workspace-member-header), .workspace-actions, .workspace-match-card-top, .workspace-match-person, .workspace-meeting-card-top, .workspace-meeting-pair, .workspace-meeting-person, .workspace-meeting-arrangement > view, .workspace-member-header, .workspace-entry-card > view:not(.workspace-entry-submit), .workspace-generic-card { flex-direction: row; }
.workspace-tabs, .workspace-search, .workspace-actions, .workspace-match-person, .workspace-meeting-pair, .workspace-meeting-person, .workspace-member-header, .workspace-generic-card { min-width: 0; }
.workspace-info-card > view, .workspace-match-person > view, .workspace-member-header > view, .workspace-generic-card > view { min-width: 0; }

.page-scroller {
	flex: 1;
	height: 0;
}

.page-content {
	padding: 24rpx 32rpx;
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.bottom-spacer {
	height: 148rpx;
}

/* ===== Banner ===== */
.banner-card {
	padding: 34rpx 30rpx;
	border-radius: 22rpx;
	background: linear-gradient(145deg, var(--accent-bg), var(--surface));
	display: flex;
	flex-direction: column;
	justify-content: center;
	min-height: 208rpx;
	box-sizing: border-box;
}

.banner-copy {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.banner-kicker {
	font-size: 20rpx;
	font-weight: 800;
	letter-spacing: 0.08em;
	color: var(--accent2);
}

.banner-title {
	font-size: 40rpx;
	line-height: 1.34;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.banner-desc {
	font-size: 21rpx;
	line-height: 1.55;
	color: var(--ink2);
}

/* ===== 红娘管理中心入口 ===== */
.management-entry {
	padding: 26rpx;
	border: 1px solid var(--line);
	border-radius: 20rpx;
	background: var(--warm);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 18rpx;
}

.management-entry.ready {
	background: var(--match-mist);
	border-color: var(--accent);
}

.management-entry-copy {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}

.management-entry-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10rpx;
}

.management-entry-title {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--ink);
}

.management-demo-badge {
	padding: 4rpx 10rpx;
	border-radius: 999rpx;
	background: var(--accent-bg);
	color: var(--accent2);
	font-size: 18rpx;
	font-weight: 800;
}

.management-entry-desc {
	font-size: 21rpx;
	line-height: 1.5;
	color: var(--ink2);
}

.management-entry-action {
	min-width: 136rpx;
	height: 64rpx;
	padding: 0 16rpx;
	border-radius: 14rpx;
	background: var(--accent);
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--paper);
	font-size: 21rpx;
	font-weight: 800;
	white-space: nowrap;
	flex-shrink: 0;
}

.management-entry-action.disabled {
	background: var(--muted);
	opacity: 0.72;
}

/* ===== 管理中心加载骨架 ===== */
.management-center-loading {
	flex: 1;
	height: 0;
	padding: 24rpx 32rpx;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
	gap: 22rpx;
}

.management-loading-card,
.management-loading-heading,
.management-loading-pill {
	background: var(--warm);
	border-radius: 16rpx;
}

.management-loading-identity {
	height: 260rpx;
	border-radius: 20rpx;
}

.management-loading-tabs {
	display: flex;
	flex-direction: row;
	gap: 12rpx;
}

.management-loading-pill {
	width: 142rpx;
	height: 58rpx;
	border-radius: 999rpx;
}

.management-loading-pill.short {
	width: 96rpx;
}

.management-loading-heading {
	width: 186rpx;
	height: 38rpx;
}

.management-loading-grid {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 14rpx;
}

.management-loading-grid .management-loading-card {
	height: 176rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
	padding: 28rpx;
	border-radius: 20rpx;
	background: var(--surface);
	box-shadow: var(--shadow-sm);
	display: flex;
	flex-direction: column;
	gap: 18rpx;
}

.section-title {
	font-size: 34rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.section-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12rpx;
}

.optional-label {
	font-size: 20rpx;
	color: var(--muted);
	padding: 4rpx 12rpx;
	border-radius: 999rpx;
	background: var(--warm);
}

.section-desc {
	font-size: 22rpx;
	line-height: 1.55;
	color: var(--muted);
}

.form-field {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	padding-top: 18rpx;
	border-top: 1px solid var(--line);
}

.field-label {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--ink2);
}

.required {
	color: var(--brown);
}

.optional {
	font-size: 20rpx;
	font-weight: 400;
	color: var(--muted);
	margin-left: 8rpx;
}

.field-hint {
	font-size: 20rpx;
	color: var(--muted);
}

.field-counter {
	font-size: 20rpx;
	color: var(--muted);
	text-align: right;
}

.field-input {
	height: 78rpx;
	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 25rpx;
	color: var(--ink);
}

.field-textarea {
	width: 100%;
	min-height: 146rpx;
	padding: 18rpx 20rpx;
	box-sizing: border-box;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	font-size: 24rpx;
	line-height: 1.6;
	color: var(--ink);
}

.case-textarea {
	min-height: 120rpx;
}

/* ===== 头像上传 ===== */
.avatar-upload {
	width: 160rpx;
	height: 160rpx;
	border-radius: 50%;
	overflow: hidden;
	border: 2rpx dashed var(--line);
	background: var(--canvas);
}

.avatar-preview {
	width: 100%;
	height: 100%;
}

.avatar-placeholder {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 6rpx;
}

.avatar-plus {
	font-size: 48rpx;
	font-weight: 300;
	color: var(--muted);
}

.avatar-hint {
	font-size: 18rpx;
	color: var(--muted);
}

/* ===== 擅长领域 ===== */
.specialty-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 12rpx;
}

.specialty-chip {
	width: 100%;
	height: 58rpx;
	padding: 0 8rpx;
	box-sizing: border-box;
	border: 1px solid var(--line);
	border-radius: 999rpx;
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 22rpx;
	line-height: 1;
	color: var(--ink2);
}

.specialty-chip text {
	display: block;
	width: 100%;
	text-align: center;
	line-height: 1;
	white-space: nowrap;
}

.specialty-chip.selected {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
	font-weight: 800;
}

/* ===== 价格输入 ===== */
.price-input-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 78rpx;
	padding: 0 20rpx;
	border: 1px solid var(--line);
	border-radius: 14rpx;
	background: var(--canvas);
	gap: 8rpx;
}

.price-prefix {
	font-size: 28rpx;
	font-weight: 800;
	color: var(--brown);
	flex-shrink: 0;
}

.price-input {
	flex: 1;
	min-width: 0;
	font-size: 25rpx;
	color: var(--ink);
}

.price-suffix {
	font-size: 22rpx;
	color: var(--muted);
	flex-shrink: 0;
}

/* ===== 成功案例 ===== */
.case-block {
	padding: 22rpx;
	border: 1px solid var(--line);
	border-radius: 16rpx;
	background: var(--canvas);
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.case-block-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.case-block-title {
	font-size: 24rpx;
	font-weight: 800;
	color: var(--ink);
}

.case-delete {
	padding: 8rpx 16rpx;
	border-radius: 8rpx;
	background: rgba(231, 110, 76, 0.12);
}

.case-delete text {
	font-size: 20rpx;
	color: var(--brown);
}

.case-block .form-field {
	border-top: none;
	padding-top: 0;
}

.case-images {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 12rpx;
}

.case-image-item {
	position: relative;
	width: 148rpx;
	height: 148rpx;
	border-radius: 12rpx;
	overflow: hidden;
}

.case-image-preview {
	width: 100%;
	height: 100%;
}

.case-image-delete {
	position: absolute;
	top: 4rpx;
	right: 4rpx;
	width: 36rpx;
	height: 36rpx;
	border-radius: 50%;
	background: rgba(0, 0, 0, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
}

.case-image-delete text {
	font-size: 24rpx;
	color: var(--paper);
	font-weight: 700;
}

.case-image-add {
	width: 148rpx;
	height: 148rpx;
	border: 2rpx dashed var(--line);
	border-radius: 12rpx;
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
}

.case-add-plus {
	font-size: 48rpx;
	font-weight: 300;
	color: var(--muted);
}

.add-case-button {
	height: 72rpx;
	border: 1px dashed var(--line);
	border-radius: 14rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.add-case-button text {
	font-size: 24rpx;
	font-weight: 700;
	color: var(--accent2);
}

/* ===== 审核流程 ===== */
.process-card {
	position: relative;
	overflow: visible;
}

.process-steps {
	display: flex;
	flex-direction: column;
	gap: 0;
}

.process-step {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 18rpx;
	padding-bottom: 28rpx;
}

.process-step:last-child {
	padding-bottom: 0;
}

.step-indicator {
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	border: 2rpx solid var(--line);
	background: var(--canvas);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 18rpx;
	font-weight: 800;
	color: var(--muted);
	flex-shrink: 0;
	z-index: 1;
}

.step-indicator.active {
	background: var(--accent);
	border-color: var(--accent);
	color: var(--paper);
}

.step-indicator.done {
	background: var(--accent-bg);
	border-color: var(--accent);
	color: var(--accent2);
}

.step-copy {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 6rpx;
	padding-top: 4rpx;
}

.step-title {
	font-size: 25rpx;
	font-weight: 700;
	color: var(--ink);
}

.step-desc {
	font-size: 20rpx;
	line-height: 1.5;
	color: var(--muted);
}

.step-line {
	position: absolute;
	left: 25rpx;
	top: 56rpx;
	width: 2rpx;
	height: calc(100% - 38rpx);
	background: var(--line);
}

/* ===== 咨询入口 ===== */
.consult-icons {
	position: absolute;
	/* 保持在审核流程卡片内，避免悬出页面边缘。 */
	right: 30rpx;
	top: 46%;
	transform: translateY(-50%);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12rpx;
	z-index: 2;
}

.consult-icon {
	width: 70rpx;
	height: 70rpx;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 8rpx 18rpx rgba(45, 124, 114, 0.18);
}

.wechat-brand {
	width: 64rpx;
	height: 64rpx;
	flex-shrink: 0;
}

.wechat-slot {
	width: 70rpx;
	height: 70rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.consult-emoji {
	display: none;
}

.phone-brand {
	width: 64rpx;
	height: 64rpx;
}

.phone-slot {
	width: 70rpx;
	height: 70rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

/* ===== 微信二维码弹窗 ===== */
.qr-overlay {
	position: fixed;
	inset: 0;
	z-index: 100;
	background: rgba(17, 23, 24, 0.48);
	display: flex;
	align-items: center;
	justify-content: center;
}

.qr-card {
	position: relative;
	width: 540rpx;
	padding: 44rpx 40rpx 36rpx;
	border-radius: 28rpx;
	background: var(--paper);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 16rpx;
	box-shadow: var(--shadow-lg);
}

.qr-close {
	position: absolute;
	top: 16rpx;
	right: 16rpx;
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	background: var(--surface);
	display: flex;
	align-items: center;
	justify-content: center;
}

.qr-close text {
	font-size: 32rpx;
	color: var(--muted);
	font-weight: 300;
}

.qr-title {
	font-size: 36rpx;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

.qr-subtitle {
	font-size: 24rpx;
	line-height: 1.55;
	color: var(--muted);
	text-align: center;
}

.qr-image-wrap {
	width: 360rpx;
	height: 360rpx;
	padding: 16rpx;
	border: 1px solid var(--line);
	border-radius: 16rpx;
	background: var(--canvas);
}

.qr-image {
	width: 100%;
	height: 100%;
}

.qr-tip {
	font-size: 22rpx;
	color: var(--muted);
}

/* ===== 隐私声明 ===== */
.privacy-card {
	padding: 22rpx 24rpx;
	border-radius: 18rpx;
	background: var(--sage-soft);
	display: flex;
	flex-direction: column;
	gap: 10rpx;
}

.privacy-title {
	font-size: 25rpx;
	font-weight: 800;
	color: var(--accent2);
}

.privacy-copy {
	font-size: 21rpx;
	line-height: 1.65;
	color: var(--ink2);
}

/* ===== 底部按钮 ===== */
.footer-safe {
	position: fixed;
	z-index: 20;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
	background: rgba(250, 252, 252, 0.96);
	border-top: 1px solid var(--line);
	flex-shrink: 0;
}

.submit-button {
	height: 86rpx;
	border-radius: 20rpx;
	background: var(--brown);
	color: var(--paper);
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 28rpx;
	font-weight: 800;
}

.submit-button.disabled {
	opacity: 0.56;
}

/* ===== 客源线索工作台 ===== */
/* 添加/筛选悬浮键：1:1 照搬资料待审的 .review-float-actions 成对悬浮键 */
.lead-float-actions {
	position: fixed;
	right: 20rpx;
	bottom: calc(env(safe-area-inset-bottom) + 20rpx);
	z-index: 75;
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.fab-lead-add,
.fab-lead-filter {
	width: 104rpx;
	height: 104rpx;
	border-radius: 50%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 2rpx;
	box-shadow: var(--match-shadow);
}

.fab-lead-add { background: var(--accent-bg); }
.fab-lead-add text { color: var(--accent2); font-size: 19rpx; font-weight: 800; }
.fab-lead-filter { background: var(--match-blush); }
.fab-lead-filter text { color: var(--match-coral); font-size: 19rpx; font-weight: 800; }
.fab-lead-filter.active { background: var(--accent-bg); }
.fab-lead-filter.active text { color: var(--accent2); }
.fab-lead-glyph { font-size: 26rpx !important; }
.fab-lead-add:active,
.fab-lead-filter:active { opacity: 0.8; transform: scale(0.96); }

.workspace-lead-card {
	margin-top: 14rpx;
	padding: 30rpx 28rpx 20rpx;
	border-radius: 24rpx;
	background: var(--surface);
	display: flex;
	flex-direction: column;
	gap: 6rpx;
	box-shadow: var(--shadow-sm);
}

.workspace-lead-card .workspace-actions {
	margin-top: 16rpx;
	flex-wrap: wrap;
}

.workspace-lead-card .workspace-actions text {
	flex: 1 1 30%;
	min-width: 29%;
	padding: 16rpx 6rpx;
	border-radius: 12rpx;
	background: var(--warm);
	color: var(--ink2);
	font-size: 21rpx;
	font-weight: 700;
	text-align: center;
}

.workspace-lead-top {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	min-width: 0;
}

.workspace-lead-name {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10rpx;
	flex: 1;
	min-width: 0;
}

.workspace-lead-title {
	color: var(--ink);
	font-size: 34rpx;
	font-weight: 800;
}

/* 性别徽标：配色沿用约见/牵线卡片的男女档（浅底 + 深字），未知给中性灰，避免卡片间另起一套色 */
.workspace-lead-gender {
	padding: 4rpx 12rpx;
	border-radius: 10rpx;
	font-size: 19rpx;
	font-weight: 800;
	flex-shrink: 0;
}

.workspace-lead-gender.male {
	background: var(--match-sky);
	color: var(--match-deep);
}

.workspace-lead-gender.female {
	background: var(--match-blush);
	color: var(--match-coral);
}

.workspace-lead-gender.unknown {
	background: var(--warm);
	color: var(--muted);
}

/* 年龄由生日现算（满周岁），跟在性别徽标后面，用中性灰不跟姓名抢视觉重量 */
.workspace-lead-age {
	color: var(--muted);
	font-size: 22rpx;
	font-weight: 700;
	flex-shrink: 0;
}

.workspace-lead-time {
	color: var(--muted);
	font-size: 20rpx;
}

/* 右上角让出固定宽度给「入库」胶囊，日期落到它下面，长名字（如「孟亦航（示例）」）不会被挤断 */
.workspace-lead-top-right {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	gap: 8rpx;
	flex-shrink: 0;
}

/* 入库胶囊：照参考稿的实心小药丸（饱和底 + 反白加粗字、全程无图标），已入库用品牌深绿，未入库用珊瑚色提醒 */
.workspace-lead-intake {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 7rpx 20rpx;
	border-radius: 999rpx;
}

.workspace-lead-intake.todo {
	background: var(--match-coral);
}

.workspace-lead-intake.done {
	background: var(--accent2);
}

.workspace-lead-intake-label {
	font-size: 22rpx;
	font-weight: 800;
	letter-spacing: 1rpx;
	color: #ffffff;
}

.workspace-lead-rows {
	display: flex;
	flex-direction: column;
}

/* 参考稿的读法：灰色标签列定宽，值一律左对齐顶在同一条竖线上，行间不画分隔线。 */
.workspace-lead-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 22rpx;
	min-width: 0;
	min-height: 68rpx;
}

.workspace-lead-row > text:first-child {
	width: 104rpx;
	flex-shrink: 0;
	color: var(--muted);
	font-size: 23rpx;
}

.workspace-lead-row > text:last-child {
	flex: 1;
	min-width: 0;
	color: var(--ink);
	font-size: 25rpx;
	font-weight: 600;
	text-align: left;
}

.workspace-lead-value {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-start;
	gap: 6rpx;
}

.workspace-lead-value > text:first-child {
	color: var(--ink);
	font-size: 25rpx;
	font-weight: 600;
}

.workspace-lead-chevron {
	color: var(--muted) !important;
	font-size: 24rpx !important;
	font-weight: 400 !important;
}

/* 备注是长文本，按参考稿 Description 的处理：灰色小标题 + 浅底内嵌块，可折行不截断。 */
.workspace-lead-remark {
	display: flex;
	flex-direction: column;
	gap: 10rpx;
	padding: 14rpx 0 18rpx;
}

.workspace-lead-remark > text {
	color: var(--muted);
	font-size: 23rpx;
}

.workspace-lead-remark-box {
	padding: 18rpx 20rpx;
	border-radius: 14rpx;
	background: var(--canvas);
}

.workspace-lead-remark-box > text {
	color: var(--ink2);
	font-size: 23rpx;
	line-height: 1.6;
}

/* 弃海原因：沿用资料待审「驳回说明」的提示色，和备注区分开。 */
.workspace-lead-remark-box.abandon {
	background: var(--match-blush);
}

.workspace-lead-remark-box.abandon > text {
	color: var(--match-coral);
}

/* 状态与意向是可选值，借参考稿 Today / Ongoing 的浅底色块 + 彩色字 + 下拉角标。 */
.workspace-lead-chip {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 6rpx;
	padding: 9rpx 18rpx;
	border-radius: 10rpx;
	background: var(--warm);
}

.workspace-lead-chip > text {
	font-size: 22rpx;
	font-weight: 800;
	color: var(--ink2);
}

.workspace-lead-status-new {
	background: var(--accent-bg);
}

.workspace-lead-status-new > text {
	color: var(--accent2) !important;
}

.workspace-lead-status-ok {
	background: var(--sage-soft);
}

.workspace-lead-status-ok > text {
	color: var(--sage) !important;
}

.workspace-lead-status-warn {
	background: var(--review-orange-soft);
}

.workspace-lead-status-warn > text {
	color: var(--review-orange) !important;
}

.workspace-lead-status-muted {
	background: var(--warm);
}

.workspace-lead-status-muted > text {
	color: var(--muted) !important;
}

.workspace-lead-stale {
	color: var(--match-coral) !important;
	font-weight: 700 !important;
}

.workspace-lead-intention {
	background: var(--match-sky);
}

.workspace-lead-intention > text {
	color: var(--accent) !important;
}

/* 跟进记录面板 */
.workspace-follow-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14rpx;
	padding: 2rpx 0 16rpx;
}

.workspace-follow-back {
	color: var(--accent2);
	font-size: 24rpx;
	font-weight: 700;
}

.workspace-follow-title {
	color: var(--ink);
	font-size: 28rpx;
	font-weight: 800;
}

.workspace-follow-list {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.workspace-follow-item {
	padding: 20rpx;
	border-radius: 16rpx;
	background: var(--match-mist);
	border: 1px solid var(--match-line);
	display: flex;
	flex-direction: column;
	gap: 10rpx;
}

.workspace-follow-item-top {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
}

.workspace-follow-method {
	color: var(--accent2);
	font-size: 21rpx;
	font-weight: 800;
}

.workspace-follow-time {
	color: var(--muted);
	font-size: 20rpx;
}

.workspace-follow-content {
	color: var(--ink);
	font-size: 24rpx;
	line-height: 1.5;
}

.workspace-follow-intention {
	color: var(--muted);
	font-size: 20rpx;
}

.workspace-follow-form {
	margin-top: 20rpx;
	padding: 22rpx;
	border-radius: 16rpx;
	background: var(--match-paper);
	border: 1px solid var(--match-line);
	display: flex;
	flex-direction: column;
	gap: 14rpx;
	box-shadow: var(--shadow-sm);
}

.workspace-follow-form-title {
	color: var(--ink);
	font-size: 24rpx;
	font-weight: 800;
}

.workspace-follow-methods {
	display: flex;
	flex-direction: row;
	gap: 10rpx;
	flex-wrap: wrap;
}

.workspace-follow-method-chip {
	padding: 10rpx 24rpx;
	border-radius: 999rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--ink2);
	font-size: 21rpx;
	font-weight: 700;
}

.workspace-follow-method-chip.active {
	background: var(--match-deep);
	border-color: var(--match-deep);
	color: var(--paper);
}

.workspace-follow-textarea {
	width: 100%;
	min-height: 110rpx;
	padding: 16rpx;
	border-radius: 12rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--ink);
	font-size: 23rpx;
	box-sizing: border-box;
}

.workspace-follow-submit {
	padding: 16rpx 0;
	border-radius: 14rpx;
	background: var(--match-deep);
	color: var(--paper);
	text-align: center;
	font-size: 24rpx;
	font-weight: 800;
}

/* 底部弹层内容 */
.workspace-option-list {
	display: flex;
	flex-direction: column;
}

/* 添加牵线记录：会员选择弹层（搜索 + 列表） */
.workspace-match-add-picker {
	display: flex;
	flex-direction: column;
	min-width: 0;
}

.workspace-option {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 24rpx 8rpx;
	border-bottom: 1px solid var(--line);
	color: var(--ink);
	font-size: 26rpx;
	font-weight: 600;
}

.workspace-option.selected {
	color: var(--accent2);
}

.workspace-option-check {
	color: var(--accent2);
	font-weight: 800;
}

/* ===== 会员选择弹层：命令面板模板（头部 / 搜索 / 键位提示 / 头像结果行）
	 sheet-body 自带 16px 18px 内边距，这里用负外边距让分割线贴齐面板边缘。 ===== */
.mp-pick {
	margin: -16px -18px 0;
	background: var(--surface);
	display: flex;
	flex-direction: column;
	max-height: 72vh;
}

/* 名单自己滚动：头部 / 搜索 / 提示条固定不动，几十条也能滑到底 */
.mp-pick-scroll {
	flex: 1;
	min-height: 0;
}

.mp-pick-head {
	flex-shrink: 0;
	height: 96rpx;
	background: var(--paper);
	padding: 0 28rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16rpx;
	border-bottom: 1rpx solid var(--match-line);
}

.mp-pick-back {
	width: 64rpx;
	height: 64rpx;
	border-radius: 18rpx;
	background: var(--warm);
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.mp-pick-back:active {
	opacity: .7;
}

.mp-pick-back-glyph {
	width: 16rpx;
	height: 16rpx;
	border-left: 3rpx solid var(--muted);
	border-bottom: 3rpx solid var(--muted);
	border-bottom-left-radius: 6rpx;
	transform: rotate(45deg);
	margin-left: 6rpx;
}

.mp-pick-title {
	flex: 1;
	min-width: 0;
	color: var(--ink);
	font-size: 32rpx;
	font-weight: 600;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mp-pick-total {
	min-width: 56rpx;
	padding: 6rpx 16rpx;
	border-radius: 999rpx;
	background: var(--match-mist);
	color: var(--match-deep);
	font-size: 21rpx;
	font-weight: 700;
	text-align: center;
	flex-shrink: 0;
}

.mp-pick-search {
	flex-shrink: 0;
	height: 120rpx;
	padding: 0 28rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16rpx;
	border-bottom: 1rpx solid var(--match-line);
}

.mp-pick-search-glyph {
	color: var(--muted);
	font-size: 34rpx;
	line-height: 1;
	flex-shrink: 0;
}

.mp-pick-search-input {
	flex: 1;
	min-width: 0;
	color: var(--ink);
	font-size: 28rpx;
}

.mp-pick-search-ph {
	color: var(--muted);
	font-size: 26rpx;
}

/* 清空按钮只在有关键词时出现，槽位常驻以免搜索框左右抖动 */
.mp-pick-clear-slot {
	width: 56rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.mp-pick-clear {
	width: 48rpx;
	height: 48rpx;
	border-radius: 14rpx;
	background: var(--warm);
	color: var(--muted);
	font-size: 22rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.mp-pick-clear:active {
	opacity: .7;
}

.mp-pick-hints {
	flex-shrink: 0;
	padding: 14rpx 28rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
	gap: 22rpx;
	border-bottom: 1rpx solid var(--match-line);
}

.mp-pick-hint {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8rpx;
}

.mp-pick-hint-key {
	padding: 2rpx 12rpx;
	border-radius: 10rpx;
	background: var(--surface);
	border: 1rpx solid var(--match-line);
	color: var(--ink2);
	font-size: 20rpx;
	line-height: 1.6;
}

.mp-pick-hint-label {
	color: var(--muted);
	font-size: 20rpx;
}

.mp-pick-state {
	min-height: 220rpx;
	padding: 40rpx 28rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--muted);
	font-size: 24rpx;
}

.mp-pick-results-label {
	display: block;
	padding: 22rpx 28rpx 8rpx;
	color: var(--muted);
	font-size: 21rpx;
}

.mp-pick-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 21rpx 28rpx;
}

.mp-pick-row.picked {
	background: var(--match-mist);
}

.mp-pick-avatar {
	width: 68rpx;
	height: 68rpx;
	border-radius: 18rpx;
	background: var(--warm);
	flex-shrink: 0;
}

.mp-pick-name {
	margin-left: 18rpx;
	max-width: 300rpx;
	color: var(--ink);
	font-size: 28rpx;
	font-weight: 600;
	flex-shrink: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mp-pick-row.picked .mp-pick-name {
	color: var(--match-deep);
}

.mp-pick-meta {
	flex: 1;
	min-width: 0;
	margin-left: 14rpx;
	color: var(--muted);
	font-size: 23rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mp-pick-tail {
	width: 44rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	flex-shrink: 0;
}

.mp-pick-tail-check {
	color: var(--match-deep);
	font-size: 28rpx;
	font-weight: 800;
}

.workspace-filter-group {
	margin-bottom: 20rpx;
}

.workspace-filter-label {
	display: block;
	color: var(--muted);
	font-size: 21rpx;
	margin-bottom: 12rpx;
}

.workspace-filter-chips {
	display: flex;
	flex-direction: row;
	gap: 10rpx;
	flex-wrap: wrap;
}

.workspace-filter-chip {
	padding: 10rpx 26rpx;
	border-radius: 999rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--ink2);
	font-size: 21rpx;
	font-weight: 700;
}

.workspace-filter-chip.active {
	background: var(--match-mist);
	border-color: var(--accent);
	color: var(--accent2);
}

.intention-filter-chip {
	max-width: 100%;
	padding-left: 16rpx;
	padding-right: 16rpx;
	font-size: 19rpx;
}

.workspace-sheet-actions {
	display: flex;
	flex-direction: row;
	gap: 12rpx;
	margin-top: 10rpx;
}

.workspace-sheet-btn {
	flex: 1;
	padding: 16rpx 0;
	border-radius: 14rpx;
	background: var(--match-deep);
	color: var(--paper);
	text-align: center;
	font-size: 24rpx;
	font-weight: 800;
}

.workspace-sheet-btn.ghost {
	background: var(--surface);
	border: 1px solid var(--match-line);
	color: var(--accent2);
}

.workspace-sheet-btn.disabled {
	opacity: 0.56;
}

/* 线索表单与确认 */
.workspace-lead-form,
.workspace-lead-confirm {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.workspace-form-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14rpx;
	padding: 14rpx 0;
	border-bottom: 1px solid var(--line);
}

.workspace-form-row text {
	width: 76rpx;
	color: var(--ink2);
	font-size: 22rpx;
	flex-shrink: 0;
}

.workspace-form-row input {
	flex: 1;
	color: var(--ink);
	font-size: 24rpx;
}

.workspace-form-error {
	color: var(--match-coral);
	font-size: 21rpx;
}

/* ===== 添加/编辑线索：性别、生日、照片、来源渠道（补充样式） ===== */
.workspace-entry-options {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	gap: 14rpx;
	flex: 1;
	min-width: 0;
}

.workspace-entry-options-wrap {
	align-content: flex-start;
}

.workspace-entry-option {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8rpx;
	padding: 6rpx 18rpx;
	border-radius: 999rpx;
	background: var(--surface);
	border: 1px solid var(--match-line);
}

.workspace-entry-option.selected {
	background: var(--match-deep);
	border-color: var(--match-deep);
}

.workspace-entry-option text {
	width: auto;
	color: var(--ink2);
	font-size: 22rpx;
	font-weight: 700;
}

.workspace-entry-option.selected text {
	color: var(--paper);
}

.workspace-entry-radio {
	width: 20rpx;
	height: 20rpx;
	border-radius: 50%;
	border: 2rpx solid var(--muted);
	box-sizing: border-box;
}

.workspace-entry-option.selected .workspace-entry-radio {
	border-color: var(--paper);
	background: var(--paper);
}

.workspace-entry-options .workspace-entry-chip {
	margin: 0;
}

.workspace-entry-options .workspace-entry-chip text {
	width: auto;
}

.workspace-form-picker {
	flex: 1;
}

.workspace-form-picker-value {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	gap: 10rpx;
	flex: 1;
	min-width: 0;
}

.workspace-form-picker-value text {
	width: auto;
	color: var(--ink);
	font-size: 24rpx;
}

.workspace-form-picker-value .workspace-entry-chevron {
	color: var(--muted);
	font-size: 28rpx;
}

.lead-photo-upload {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16rpx;
	flex: 1;
	min-width: 0;
}

.lead-photo-preview {
	width: 96rpx;
	height: 96rpx;
	border-radius: 16rpx;
	background: var(--surface);
	border: 1px solid var(--line);
}

.lead-photo-add {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 4rpx;
	width: 96rpx;
	height: 96rpx;
	border-radius: 16rpx;
	background: var(--surface);
	border: 1px dashed var(--match-line);
}

.lead-photo-add text {
	width: auto;
	color: var(--muted);
	font-size: 20rpx;
}

.lead-photo-plus {
	color: var(--muted);
	font-size: 36rpx;
	font-weight: 700;
	line-height: 1;
}

.lead-photo-remove {
	color: var(--match-coral);
	font-size: 22rpx;
}

.workspace-confirm-tip {
	color: var(--ink2);
	font-size: 23rpx;
	line-height: 1.5;
}

.workspace-confirm-gender {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
}

.workspace-confirm-gender > text {
	color: var(--muted);
	font-size: 21rpx;
}

/* ===== 复制资料弹窗（内联实现，常驻挂载 + open 类；卡片结构与配色照搬资料待审的复制弹窗） ===== */
.cp-overlay {
	position: fixed;
	z-index: 9700;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(12, 19, 19, .46);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 56rpx;
	box-sizing: border-box;
	opacity: 0;
	pointer-events: none;
	transition: opacity .2s ease-out;
}

.cp-overlay.open {
	opacity: 1;
	pointer-events: auto;
}

.cp-card {
	width: 100%;
	max-width: 640rpx;
	background: var(--surface);
	border-radius: 32rpx;
	padding: 40rpx 32rpx 0;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	box-shadow: var(--shadow-lg);
	transform: translateY(24rpx) scale(.97);
	transition: transform .2s ease-out;
}

.cp-overlay.open .cp-card {
	transform: translateY(0) scale(1);
}

.cpd-icon {
	align-self: center;
	width: 112rpx;
	height: 112rpx;
	border-radius: 28rpx;
	border: 1px solid var(--line);
	background: linear-gradient(160deg, var(--paper), var(--warm));
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 10rpx 24rpx rgba(12, 19, 19, .10);
}

.cpd-icon-glyph {
	color: var(--accent2);
	font-size: 48rpx;
	line-height: 1;
}

.cpd-title {
	margin-top: 24rpx;
	color: var(--ink);
	font-size: 33rpx;
	font-weight: 800;
	text-align: center;
}

.cpd-subtitle {
	margin-top: 10rpx;
	color: var(--muted);
	font-size: 22rpx;
	line-height: 1.55;
	text-align: center;
}

.cpd-body {
	margin-top: 24rpx;
	min-height: 116rpx;
	max-height: 50vh;
	padding: 22rpx 24rpx;
	border-radius: 20rpx;
	background: var(--canvas);
	box-sizing: border-box;
}

.cpd-lines {
	display: flex;
	flex-direction: column;
}

.cpd-line {
	color: var(--ink2);
	font-size: 25rpx;
	line-height: 46rpx;
}

.cpd-editor {
	display: flex;
	flex-direction: column;
}

.cpd-textarea {
	width: 100%;
	height: 380rpx;
	color: var(--ink);
	font-size: 25rpx;
	line-height: 46rpx;
}

.cpd-note {
	margin-top: 10rpx;
	color: var(--muted);
	font-size: 20rpx;
	line-height: 1.5;
}

.cpd-footer {
	margin-top: 28rpx;
	padding: 24rpx 0 32rpx;
	border-top: 1px solid var(--line);
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.cpd-btn {
	min-width: 184rpx;
	height: 76rpx;
	padding: 0 28rpx;
	border-radius: 999rpx;
	background: var(--warm);
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 6rpx 16rpx rgba(12, 19, 19, .08);
}

.cpd-btn text {
	color: var(--ink);
	font-size: 25rpx;
	font-weight: 700;
}

.cpd-btn.primary {
	background: linear-gradient(90deg, var(--accent), var(--accent2));
	box-shadow: 0 10rpx 24rpx rgba(0, 96, 82, .24);
}

.cpd-btn.primary text {
	color: var(--paper);
}

.cpd-btn:active {
	opacity: .8;
}

/* ===== 查看联系方式弹窗（内联实现，常驻挂载 + open 类） ===== */
.xsa-contact-overlay {
	position: fixed;
	z-index: 9600;
	inset: 0;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(12, 19, 19, .46);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 0 56rpx;
	box-sizing: border-box;
	opacity: 0;
	pointer-events: none;
	transition: opacity .2s ease-out;
}

.xsa-contact-overlay.open {
	opacity: 1;
	pointer-events: auto;
}

.xsa-contact-card {
	width: 100%;
	max-width: 644rpx;
	background: #ffffff;
	border-radius: 40rpx;
	padding: 44rpx 36rpx 34rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	box-sizing: border-box;
	box-shadow: 0 24rpx 70rpx rgba(20, 24, 40, .22);
	transform: translateY(24rpx) scale(.97);
	transition: transform .2s ease-out;
}

.xsa-contact-overlay.open .xsa-contact-card {
	transform: translateY(0) scale(1);
}

.xsa-contact-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: 16rpx;
}

.xsa-contact-head-icon {
	position: relative;
	width: 66rpx;
	height: 62rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.cc-avatar {
	position: relative;
	width: 52rpx;
	height: 44rpx;
	border-radius: 12rpx;
	background: linear-gradient(135deg, #6E8BFF, #4C6DF5);
	display: flex;
	align-items: center;
	justify-content: center;
	overflow: hidden;
}

.cc-avatar-head {
	position: absolute;
	top: 7rpx;
	left: 17rpx;
	width: 16rpx;
	height: 16rpx;
	border-radius: 50%;
	background: #ffffff;
}

.cc-avatar-body {
	position: absolute;
	bottom: 6rpx;
	left: 12rpx;
	width: 26rpx;
	height: 13rpx;
	border-radius: 13rpx 13rpx 4rpx 4rpx;
	background: #ffffff;
}

.cc-lens {
	position: absolute;
	right: 0;
	bottom: 0;
	width: 28rpx;
	height: 28rpx;
	border-radius: 50%;
	border: 6rpx solid #F0518B;
	background: #ffffff;
	box-sizing: border-box;
}

.xsa-contact-title {
	font-size: 42rpx;
	font-weight: 800;
	color: #1F2430;
}

.xsa-contact-name {
	margin-top: 30rpx;
	font-size: 30rpx;
	font-weight: 600;
	color: #39404E;
	text-align: center;
}

.xsa-contact-state {
	margin-top: 34rpx;
	min-height: 120rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #8A90A0;
	font-size: 26rpx;
}

.xsa-contact-state.error {
	color: #E0455A;
	text-align: center;
	line-height: 1.6;
}

.xsa-contact-rows {
	width: 100%;
	display: flex;
	flex-direction: column;
}

.xsa-contact-row {
	margin-top: 26rpx;
	width: 100%;
	min-height: 112rpx;
	border-radius: 26rpx;
	padding: 0 20rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 14rpx;
	box-sizing: border-box;
}

.xsa-contact-row.phone { background: #FDE7EB; }
.xsa-contact-row.wechat { background: #E9F7EF; }

.cc-badge {
	width: 58rpx;
	height: 58rpx;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.cc-badge.phone { background: #F04150; }
.cc-badge.wechat { background: #35C08A; }

.cc-badge-img {
	width: 40rpx;
	height: 40rpx;
}

.cc-value {
	flex: 1;
	min-width: 0;
	font-size: 34rpx;
	font-weight: 800;
	line-height: 1.25;
	color: #1F2430;
}

.cc-actions {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10rpx;
	flex-shrink: 0;
}

.cc-btn {
	height: 66rpx;
	padding: 0 20rpx;
	border-radius: 18rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.cc-btn text {
	color: #ffffff;
	font-size: 26rpx;
	font-weight: 800;
}

.cc-btn.phone { background: #F04150; }
.cc-btn.wechat { background: #35C08A; }
.cc-btn:active { opacity: .82; }

.xsa-contact-tip {
	margin-top: 40rpx;
	width: 100%;
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.cc-tip-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12rpx;
}

.cc-tip-mark {
	width: 38rpx;
	height: 38rpx;
	border-radius: 50%;
	background: #EDE7FF;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.cc-tip-mark text {
	font-size: 22rpx;
	font-weight: 800;
	color: #6C5CE7;
}

.cc-tip-title {
	font-size: 30rpx;
	font-weight: 800;
	color: #2B3240;
}

.cc-tip-copy {
	font-size: 26rpx;
	line-height: 1.62;
	color: #6B7280;
}

.xsa-contact-close {
	margin-top: 44rpx;
	width: 100%;
	height: 104rpx;
	border-radius: 52rpx;
	background: linear-gradient(135deg, #7C5CFC, #6C5CE7);
	display: flex;
	align-items: center;
	justify-content: center;
}

.xsa-contact-close text {
	color: #ffffff;
	font-size: 34rpx;
	font-weight: 800;
}

.xsa-contact-close:active { opacity: .88; }

/* ===== 录入客源线索 · 轻档案卡风格（参考 Edit Profile 设计语言） ===== */
/* 薄荷渐变页面底 + 隐藏默认页头（顶部提示卡取而代之） */
.workspace-scroller.ls-scroll { background: linear-gradient(180deg, #D7EEE6 0%, #EAF6F1 32%, #F6FBF8 62%, #FFFFFF 100%); }
.workspace-scroller.ls-scroll .workspace-content { background: transparent; padding: 8rpx 26rpx 130rpx; }
.workspace-scroller.ls-scroll .workspace-heading { display: none; }
/* 导航右侧黑色保存药丸：与返回键同一操作行（top 84rpx / height 56rpx），文字双向居中。 */
.nav-help.nav-help-save { top: calc(var(--status-bar-height) + 84rpx); height: 56rpx; min-width: 104rpx; padding: 0 26rpx; box-sizing: border-box; justify-content: center; background: #101413; border: none; }
.nav-help.nav-help-save .nav-help-text { color: #FFFFFF; font-size: 23rpx; font-weight: 800; line-height: 1; text-align: center; }

.lead-studio { gap: 0; padding-bottom: 40rpx; }

/* 顶部漂浮提示卡 */
.ls-hero { margin-top: 14rpx; padding: 32rpx 30rpx; border-radius: 32rpx; background: linear-gradient(135deg, #123B33 0%, #1E5648 100%); display: flex; flex-direction: row; align-items: center; gap: 18rpx; box-shadow: 0 18rpx 40rpx rgba(18, 59, 51, .20); }
.ls-hero-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }
.ls-hero-title { color: #FFFFFF; font-size: 36rpx; font-weight: 800; letter-spacing: 1rpx; }
.ls-hero-sub { color: rgba(255, 255, 255, .75); font-size: 22rpx; line-height: 1.55; }
.ls-hero-demo { flex-shrink: 0; padding: 12rpx 28rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .18); }
.ls-hero-demo text { color: #FFFFFF; font-size: 21rpx; font-weight: 700; }
.ls-hero-demo:active { opacity: .7; }

/* 分区标题 */
.ls-section { margin: 38rpx 8rpx 18rpx; color: #14201C; font-size: 32rpx; font-weight: 800; }

/* 白色漂浮卡 */
.ls-card { padding: 6rpx 30rpx; border-radius: 28rpx; background: #FFFFFF; display: flex; flex-direction: column; box-shadow: 0 10rpx 30rpx rgba(20, 50, 42, .07); }

/* 字段：小灰标签 + 大值 */
.ls-field { padding: 26rpx 0; border-bottom: 1rpx solid #EEF3F0; display: flex; flex-direction: column; gap: 12rpx; }
.ls-field:last-child { border-bottom: none; }
/* 气泡下拉展开时把本行 1px 分隔线让出来，阴影压在分隔线上会显脏。 */
.ls-field-floating { border-bottom-color: transparent; }
.ls-label { color: #93A39C; font-size: 21rpx; font-weight: 600; }
.ls-label-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.ls-count { color: #A9B8B1; font-size: 20rpx; }
.ls-field input { width: 100%; color: #16211D; font-size: 28rpx; font-weight: 600; }

/* 选择器 */
.ls-picker { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12rpx; }
.ls-picker text { color: #16211D; font-size: 28rpx; font-weight: 600; }
.ls-picker .ls-placeholder { color: #A9B8B1; font-weight: 400; }
.ls-picker i { width: 14rpx; height: 14rpx; border-top: 3rpx solid #9AA8A2; border-right: 3rpx solid #9AA8A2; transform: rotate(135deg); }

/* 马卡龙标签芯片 */
.ls-chips { display: flex; flex-direction: row; flex-wrap: wrap; gap: 14rpx; }
.ls-chip { padding: 14rpx 30rpx; border-radius: 999rpx; background: #FFFFFF; border: 1.5rpx solid #E3ECE8; }
.ls-chip text { color: #5B6B64; font-size: 23rpx; font-weight: 600; }
.ls-chip:active { opacity: .7; }
.ls-tone-pink.active { background: #FCE4EC; border-color: #E88BB0; }
.ls-tone-mint.active { background: #DFF3E4; border-color: #7CC79A; }
.ls-tone-blue.active { background: #E1EEFB; border-color: #82B4E8; }
.ls-tone-lavender.active { background: #EDE7FA; border-color: #AE97E3; }
.ls-tone-sun.active { background: #FBF3D9; border-color: #DFC26A; }
.ls-chip.active text { color: #17251F; font-weight: 800; }

/* 多行描述 */
.ls-textarea { width: 100%; min-height: 170rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #F5F8F6; color: #16211D; font-size: 24rpx; line-height: 1.7; box-sizing: border-box; }

/* 错误提示 / 提交 / 页脚 */
.ls-error { margin-top: 24rpx; padding: 18rpx 24rpx; border-radius: 18rpx; background: #FDEBEF; text-align: center; }
.ls-error text { color: #D64560; font-size: 22rpx; font-weight: 600; }
.ls-submit { margin-top: 40rpx; height: 96rpx; border-radius: 999rpx; background: #101413; display: flex; align-items: center; justify-content: center; box-shadow: 0 16rpx 32rpx rgba(16, 20, 19, .25); }
.ls-submit text { color: #FFFFFF; font-size: 29rpx; font-weight: 800; letter-spacing: 2rpx; }
.ls-submit.disabled { opacity: .55; }
.ls-submit:active { opacity: .85; transform: scale(.99); }
.ls-foot { margin-top: 20rpx; display: flex; justify-content: center; }
.ls-foot text { color: #9AA8A2; font-size: 20rpx; text-align: center; }

/* ===== 红娘喜讯中心：色带 + 压边阶段卡 + 反馈条 + 喜讯卡列表 + 锦旗墙 ===== */
.news-band { margin-top: 4rpx; padding: 26rpx 26rpx 60rpx; border-radius: 20rpx; background: linear-gradient(180deg, var(--security-hero) 0%, var(--paper) 100%); display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; }
.news-band-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.news-band-title { color: var(--ink); font-size: 34rpx; font-weight: 800; }
.news-band-sub { color: var(--muted); font-size: 20rpx; line-height: 1.5; }
.news-band-count { flex: none; min-width: 104rpx; padding: 10rpx 16rpx; border-radius: 16rpx; background: var(--surface); display: flex; flex-direction: column; align-items: center; box-shadow: var(--shadow-sm); }
.news-band-count-value { color: var(--accent2); font-size: 34rpx; font-weight: 800; line-height: 1.2; }
.news-band-count-label { color: var(--muted); font-size: 18rpx; }
.news-stage-card { margin-top: -40rpx; padding: 22rpx 12rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; box-shadow: var(--shadow-sm); }
.news-stage-grid { display: flex; flex-direction: row; flex-wrap: wrap; }
.news-stage { width: 25%; padding: 10rpx 4rpx 12rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; border-radius: 16rpx; }
.news-stage-glyph { width: 62rpx; height: 62rpx; border-radius: 50%; display: flex; flex-direction: row; align-items: center; justify-content: center; font-size: 30rpx; background: var(--warm); }
.news-stage-label { color: var(--ink2); font-size: 19rpx; text-align: center; }
.news-stage.active { background: var(--accent-bg); }
.news-stage.active .news-stage-label { color: var(--accent2); font-weight: 800; }
.news-feedback { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: var(--review-soft); display: flex; flex-direction: row; align-items: center; gap: 12rpx; }
.news-feedback-glyph { flex: none; font-size: 26rpx; }
.news-feedback-text { flex: 1; min-width: 0; color: var(--review-deep); font-size: 20rpx; line-height: 1.45; }
.news-feedback-btn { flex: none; padding: 10rpx 16rpx; border-radius: 999rpx; background: var(--surface); color: var(--accent2); font-size: 20rpx; font-weight: 800; display: flex; flex-direction: row; align-items: center; gap: 4rpx; }
.news-feedback-arrow { font-size: 22rpx; line-height: 1; }
.news-section { margin-top: 24rpx; padding: 0 6rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.news-section-title { color: var(--ink); font-size: 26rpx; font-weight: 800; }
.news-section-filter { padding: 8rpx 16rpx; border-radius: 999rpx; background: var(--warm); color: var(--accent2); font-size: 19rpx; }
.news-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 16rpx; box-shadow: var(--shadow-sm); }
.news-card-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 12rpx; }
.news-card-stage { flex: none; padding: 9rpx 18rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 800; line-height: 1.2; }
.news-card-couple { flex: 1; min-width: 0; display: flex; flex-direction: row; justify-content: flex-end; }
.news-card-person { max-width: 176rpx; min-width: 0; margin-left: 14rpx; display: flex; flex-direction: row; align-items: center; }
.news-card-avatar { flex: none; width: 46rpx; height: 46rpx; border-radius: 50%; }
.news-card-name { min-width: 0; margin-left: 8rpx; color: var(--ink); font-size: 20rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.news-card-meta { display: flex; flex-direction: row; align-items: center; gap: 10rpx; color: var(--ink2); font-size: 20rpx; }
.news-card-meta-glyph { font-size: 22rpx; color: var(--muted); }
.news-card-meta-item { color: var(--ink2); }
.news-card-meta-divider { color: var(--line); }
.news-card-images { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; }
.news-card-image { width: 168rpx; height: 168rpx; border-radius: 16rpx; background: var(--warm); }
.news-card-detail { padding: 18rpx; border-radius: 16rpx; background: var(--paper); border: 1rpx solid var(--line); display: flex; flex-direction: column; gap: 10rpx; }
.news-card-content { color: var(--ink2); font-size: 21rpx; line-height: 1.6; }
.news-card-content-empty { color: var(--muted); }
.news-card-blessing { color: var(--accent2); font-size: 20rpx; line-height: 1.6; }
.news-card-date { color: var(--muted); font-size: 19rpx; }
.news-card-bless-btn { margin-top: 4rpx; align-self: flex-start; padding: 12rpx 26rpx; border-radius: 999rpx; background: var(--sage-soft); color: var(--accent2); font-size: 20rpx; font-weight: 800; }
.news-card-foot { padding-top: 14rpx; border-top: 1rpx solid var(--line); display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.news-card-blessing-count { color: var(--muted); font-size: 19rpx; }
.news-card-toggle { padding: 10rpx 20rpx; border-radius: 999rpx; background: var(--warm); color: var(--accent2); font-size: 20rpx; font-weight: 800; display: flex; flex-direction: row; align-items: center; gap: 4rpx; }
.news-card-toggle-arrow { font-size: 24rpx; line-height: 1; transform: rotate(90deg); }
.news-card-toggle-arrow.open { transform: rotate(-90deg); }
/* 阶段配色：沿用现有语义 Token，按喜讯阶段分档（徽标用底+字，筛选图标只用底色） */
.news-card-stage.t-coral { background: var(--match-blush); color: var(--match-coral); }
.news-card-stage.t-sky { background: var(--match-sky); color: var(--match-deep); }
.news-card-stage.t-sage { background: var(--sage-soft); color: var(--sage); }
.news-card-stage.t-plum { background: var(--plane-lilac); color: var(--plane-purple-deep); }
.news-card-stage.t-apricot { background: var(--shortcut-apricot); color: var(--review-orange); }
.news-card-stage.t-mint { background: var(--shortcut-mint); color: var(--accent2); }
.news-card-stage.t-lilac { background: var(--shortcut-lilac); color: var(--review-deep); }
.news-card-stage.t-blush { background: var(--review-lilac); color: var(--review-purple); }
.news-stage-glyph.t-coral { background: var(--match-blush); }
.news-stage-glyph.t-sky { background: var(--match-sky); }
.news-stage-glyph.t-sage { background: var(--sage-soft); }
.news-stage-glyph.t-plum { background: var(--plane-lilac); }
.news-stage-glyph.t-apricot { background: var(--shortcut-apricot); }
.news-stage-glyph.t-mint { background: var(--shortcut-mint); }
.news-stage-glyph.t-lilac { background: var(--shortcut-lilac); }
.news-stage-glyph.t-blush { background: var(--review-lilac); }
.news-pennant-card { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: var(--surface); display: flex; flex-direction: column; gap: 16rpx; box-shadow: var(--shadow-sm); }
.news-pennant-image { width: 100%; height: 300rpx; border-radius: 16rpx; background: var(--warm); }
.news-pennant-plate { padding: 30rpx 24rpx; border-radius: 16rpx; background: var(--match-blush); display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx; }
.news-pennant-words { flex: 1; min-width: 0; color: var(--match-coral); font-size: 26rpx; font-weight: 800; line-height: 1.5; }
.news-pennant-plate-mark { flex: none; padding: 6rpx 14rpx; border-radius: 999rpx; background: var(--surface); color: var(--match-coral); font-size: 18rpx; }
.news-pennant-meta { display: flex; flex-direction: column; gap: 6rpx; }
.news-pennant-giver { color: var(--ink); font-size: 22rpx; font-weight: 700; }
.news-pennant-target, .news-pennant-maker, .news-pennant-date { color: var(--muted); font-size: 19rpx; }

/* 报喜：右下角悬浮键沿用资料待审「筛选」键的圆形样式，面板按模板稿做双入口卡片 */
.workspace-add.news-report { width: 104rpx; height: 104rpx; flex-direction: column; gap: 2rpx; background: var(--surface); box-shadow: var(--match-shadow); }
.workspace-add.news-report:active { opacity: 0.8; transform: scale(0.96); }
.workspace-add.news-report .news-report-glyph { font-size: 36rpx; line-height: 34rpx; }
.workspace-add.news-report .news-report-label { color: var(--ink); font-size: 19rpx; font-weight: 800; line-height: 1.2; }
.news-report-grid { display: flex; flex-direction: row; gap: 18rpx; }
.news-report-tile { flex: 1; min-width: 0; padding: 34rpx 18rpx 30rpx; border-radius: 24rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.news-report-tile.lavender { background: var(--shortcut-lilac); }
.news-report-tile.blush { background: var(--match-blush); }
.news-report-tile:active { opacity: 0.86; }
.news-report-icon { width: 104rpx; height: 104rpx; border-radius: 50%; display: flex; flex-direction: row; align-items: center; justify-content: center; font-size: 44rpx; color: var(--text-invert); }
.news-report-icon.lavender { background: linear-gradient(135deg, var(--review-purple), var(--plane-purple)); }
.news-report-icon.blush { background: linear-gradient(135deg, var(--badge-coral), var(--match-coral)); }
.news-report-tile-label { font-size: 25rpx; font-weight: 800; }
.news-report-tile.lavender .news-report-tile-label { color: var(--review-deep); }
.news-report-tile.blush .news-report-tile-label { color: var(--match-coral); }
.news-report-note { margin-top: 22rpx; color: var(--muted); font-size: 20rpx; line-height: 1.5; }

/* 喜讯卡片：待审标记与「只有一侧有姓名」的排版 */
.news-card-head-left { flex: none; display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.news-card-pending { padding: 9rpx 14rpx; border-radius: 999rpx; background: var(--warm); color: var(--muted); font-size: 18rpx; font-weight: 700; line-height: 1.2; }

/* 反馈喜讯表单 */
.news-form-privacy { padding: 18rpx 20rpx; border-radius: 18rpx; background: var(--warm); display: flex; flex-direction: column; gap: 8rpx; }
.news-form-privacy-title { color: var(--ink); font-size: 22rpx; font-weight: 800; }
.news-form-privacy-text { color: var(--ink2); font-size: 21rpx; line-height: 1.6; }
.news-form-row { display: flex; flex-direction: row; align-items: center; gap: 14rpx; padding: 22rpx 0; border-bottom: 1px solid var(--line); }
.news-form-label { flex: none; width: 130rpx; color: var(--ink2); font-size: 23rpx; font-weight: 700; }
.news-form-input { flex: 1; min-width: 0; color: var(--ink); font-size: 24rpx; text-align: right; }
.news-form-unit { flex: none; color: var(--ink2); font-size: 23rpx; }
.news-form-picker-value { flex: 1; min-width: 0; display: flex; flex-direction: row; align-items: center; justify-content: flex-end; gap: 8rpx; }
.news-form-picker-value text { color: var(--ink); font-size: 24rpx; }
.news-form-picker-value text.placeholder { color: var(--muted); }
.news-form-chevron { color: var(--muted); font-size: 28rpx; line-height: 1; }
.news-form-textarea { width: 100%; min-height: 160rpx; margin-top: 22rpx; padding: 20rpx; box-sizing: border-box; border-radius: 18rpx; background: var(--warm); color: var(--ink); font-size: 23rpx; line-height: 1.6; }
.news-form-subtitle { margin-top: 26rpx; color: var(--ink); font-size: 24rpx; font-weight: 800; }
.news-form-images { margin-top: 16rpx; display: flex; flex-direction: row; flex-wrap: wrap; gap: 16rpx; }
.news-form-image-cell { position: relative; width: 160rpx; height: 160rpx; }
.news-form-image { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: var(--warm); }
.news-form-image-remove { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; border-radius: 0 16rpx 0 16rpx; background: rgba(12, 19, 19, .46); color: var(--text-invert); font-size: 20rpx; text-align: center; line-height: 40rpx; }
.news-form-image-add { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: var(--warm); border: 1px solid var(--line); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; }
.news-form-image-add-glyph { color: var(--muted); font-size: 40rpx; line-height: 40rpx; }
.news-form-image-add-label { color: var(--muted); font-size: 19rpx; }
.news-form-error { display: block; margin-top: 16rpx; }
.news-form-submit { margin-top: 30rpx; height: 88rpx; border-radius: 18rpx; background: linear-gradient(135deg, var(--review-purple), var(--plane-purple)); display: flex; flex-direction: row; align-items: center; justify-content: center; }
.news-form-submit text { color: var(--text-invert); font-size: 27rpx; font-weight: 800; }
.news-form-submit:active { opacity: .88; }
.news-form-submit.disabled { opacity: .56; }

/* 赠送锦旗：预览就是绘制用的 canvas，尺寸与 utils/pennant-drawer.uts 的入参一致 */
.pennant-preview { margin-top: 22rpx; display: flex; flex-direction: row; justify-content: center; }
.pennant-canvas { border-radius: 12rpx; }
.pennant-hint { display: block; margin-top: 16rpx; color: var(--muted); font-size: 20rpx; line-height: 1.5; }
