.workspace-match-status-btn.t-FAILED { background: var(--match-coral); }
.workspace-match-status-arrow { width: 28rpx; height: 28rpx; border-radius: 50%; background: rgba(255, 255, 255, .3); display: flex; align-items: center; justify-content: center; }
