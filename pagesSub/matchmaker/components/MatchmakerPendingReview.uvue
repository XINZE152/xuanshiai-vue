<template>
  <view class="pr-shell">

    <!-- ============ 列表视图 ============ -->
    <view v-if="subview == ''" class="pr-main">
      <scroll-view scroll-x class="pr-tabs" :show-scrollbar="false">
        <view class="pr-tabs-row">
          <view v-for="tab in tabs" :key="tab.key" class="pr-tab" :class="{ active: activeTab == tab.key }" @tap="selectTab(tab.key)">
            <text>{{ tab.label }}</text>
          </view>
        </view>
      </scroll-view>

      <view class="pr-search">
        <text class="pr-search-icon">⌕</text>
        <input class="pr-search-input" placeholder="请输入昵称/编号/姓名/手机号" placeholder-class="pr-search-ph" :value="keyword" confirm-type="search" @input="onKeyword" @confirm="loadMembers" />
      </view>

      <scroll-view scroll-y class="pr-list" :show-scrollbar="false" @scrolltolower="loadMoreMembers">
        <view v-if="loading" class="state-card"><text>正在加载资料数据…</text></view>
        <view v-else-if="errorMessage != ''" class="state-card">
          <text>{{ errorMessage }}</text>
          <view class="state-action" @tap="loadMembers"><text>重新加载</text></view>
        </view>
        <view v-else-if="members.length == 0" class="state-card"><text>{{ emptyText }}</text></view>

          <view v-for="member in members" :key="member.user_id" class="mcard" :id="'mcard-' + member.user_id" @tap="openMemberProfile(member)">
          <view class="mcard-body">
            <view class="mcard-ava" :class="member.gender == 1 ? 'male' : 'female'">
              <image v-if="member.avatar" :src="avatarSrc(member.avatar)" mode="aspectFill" />
              <text v-else>{{ avatarText(member.nickname) }}</text>
              <view class="mcard-ava-badge"><text>{{ member.gender == 1 ? '♂' : (member.gender == 2 ? '♀' : '') }}</text></view>
            </view>
            <view class="mcard-info">
              <view class="mcard-name-row">
                <text class="mcard-name">{{ member.nickname }}</text>
                <view class="realname-tag" :class="member.realname_status == 2 ? 'ok' : ''"><text>{{ member.realname_status == 2 ? '已实名' : '未实名' }}</text></view>
                <view class="mcard-vip" v-if="isVipMember(member)"><text>VIP</text></view>
              </view>
              <view class="mcard-sub">
                <text class="mcard-no">编号：G{{ member.user_id }}</text>
                <view v-if="member.created_at != null && String(member.created_at).length > 0" class="mcard-reg">
                  <text class="mcard-sub-dot">·</text>
                  <text>登记：{{ formatTime(member.created_at) }}</text>
                </view>
              </view>
              <text class="mcard-meta">{{ memberMeta(member) }}</text>
              <view class="mcard-owner" @tap.stop="openAssign(member)">
                <text class="mcard-owner-glyph">❥</text>
                <text class="mcard-owner-label">跟进服务：</text>
                <text class="mcard-owner-value">{{ member.matchmaker_name || '待分派' }}</text>
              </view>
            </view>
            <view class="mcard-side">
              <view class="mcard-status" :class="'st-' + member.review_status.toLowerCase()" @tap.stop="openReview(member)">
                <text>{{ reviewLabel(member.review_status) }}</text>
                <text class="mcard-status-dot">●</text>
              </view>
              <view class="mcard-ark"><text class="mcard-ark-glyph">◈</text><text>公开档案</text></view>
              <view class="mcard-profile-entry" @tap.stop="openMemberProfile(member)"><text>会员主页 ›</text></view>
            </view>
          </view>

          <text v-if="member.review_status == 'REJECTED' && member.review_reason" class="mcard-reason">弃海原因：{{ member.review_reason }}</text>

          <view class="mcard-actions">
            <view :id="'more-trigger-' + member.user_id" class="act-more" @tap.stop="toggleMenu(member, $event)"><text>更多</text></view>
            <view class="act" @tap.stop="openContact(member)"><text>联系</text></view>
            <view class="act" @tap.stop="openFollowUps(member)"><text>跟进({{ member.followCount || 0 }})</text></view>
            <view class="act" @tap.stop="copyProfile(member)"><text>复制资料</text></view>
            <view class="act" @tap.stop="onEditProfile(member)"><text>编辑资料</text></view>
          </view>

        </view>
        <view v-if="hasMoreMembers" class="state-card" @tap="loadMoreMembers"><text>{{ loadingMoreMembers ? '加载中…' : '加载更多' }}</text></view>
      </scroll-view>

      <view class="review-float-actions">
        <view class="fab-enter" @tap="onEnterMember"><text class="fab-enter-glyph">✎</text><text>录入</text></view>
        <view class="fab-filter" @tap="onFilter"><text class="fab-filter-glyph">☲</text><text>筛选</text></view>
      </view>
    </view>

    <!-- 页面级筛选抽屉，放在滚动列表之外，避免被列表或卡片裁切。 -->
    <view v-if="filterVisible" class="filter-layer">
      <view class="filter-mask" @tap="closeMemberFilter"></view>
      <view class="filter-drawer" @tap.stop>
        <view class="filter-head">
          <view>
            <text class="filter-title">条件筛选</text>
            <text class="filter-subtitle">按会员资料缩小查看范围</text>
          </view>
          <view class="filter-close" @tap="closeMemberFilter"><text>✕</text></view>
        </view>
        <scroll-view scroll-y class="filter-scroll" :show-scrollbar="false">
          <view v-for="row in filterRows" :key="row.key" class="filter-row">
            <picker v-if="row.key == 'residence' || row.key == 'hometown' || row.key == 'household'" mode="region" @change="selectFilterRegion(row.key, $event)">
              <view class="filter-row-summary"><text class="filter-label">{{ row.label }}</text><view class="filter-current"><text>{{ memberFilter[row.key] || '不限' }}</text><text class="filter-chevron">›</text></view></view>
            </picker>
            <view v-else class="filter-row-summary" @tap="toggleMemberFilter(row.key)">
              <text class="filter-label">{{ row.label }}</text>
              <view class="filter-current"><text>{{ filterValueText(row.key) }}</text><text class="filter-chevron">›</text></view>
            </view>
            <view v-if="expandedFilterKey == row.key && isRangeFilter(row.key)" class="filter-range">
              <text class="filter-range-hint">选择{{ row.label }}范围</text>
              <view class="filter-range-controls">
                <picker :range="rangeValues(row.key)" :value="rangeBoundIndex(row.key, 'min')" @change="setRangeBound(row.key, 'min', $event)"><view class="filter-range-input"><text>{{ rangeBoundText(row.key, 'min') }}</text></view></picker>
                <text class="filter-range-separator">—</text>
                <picker :range="rangeValues(row.key)" :value="rangeBoundIndex(row.key, 'max')" @change="setRangeBound(row.key, 'max', $event)"><view class="filter-range-input"><text>{{ rangeBoundText(row.key, 'max') }}</text></view></picker>
                <view class="filter-range-apply" @tap="applyRange(row.key)"><text>确定</text></view>
              </view>
            </view>
            <view v-else-if="expandedFilterKey == row.key" class="filter-options">
              <view v-for="option in row.options" :key="row.key + option.value" class="filter-option" :class="{ selected: memberFilter[row.key] == option.value }" @tap="selectMemberFilter(row.key, option.value)">
                <text>{{ option.label }}</text>
              </view>
            </view>
          </view>
          <text class="filter-data-note">收入保密与未填写暂无法区分。</text>
        </scroll-view>
        <view class="filter-footer">
          <view class="filter-reset" @tap="resetMemberFilter"><text>重置</text></view>
          <view class="filter-confirm" @tap="confirmMemberFilter"><text>确定</text></view>
        </view>
      </view>
    </view>

    <!-- 页面级菜单不受 scroll-view 裁切，坐标取自点击事件。 -->
    <view v-if="menuForId != 0 && menuMember != null" class="more-layer" @tap="closeMenu">
      <view class="more-pop" :style="{ left: menuLeft + 'px', top: menuTop + 'px' }" @tap.stop>
        <view v-if="activeTab == 'REJECTED'" class="more-item last" @tap="pickupMember(menuMember)"><text>{{ pickupLoading ? '捞取中…' : '我要捞取' }}</text></view>
        <template v-else>
        <view class="more-item" @tap="openIntroductions(menuMember)"><text>牵线({{ menuMember.introCount || 0 }})</text></view>
        <view class="more-item" @tap="openMatch(menuMember)"><text>匹配</text></view>
        <view class="more-item" @tap="openNote(menuMember)"><text>红娘说</text></view>
        <view class="more-item" :class="{ last: !canReview }" @tap="openAssign(menuMember)"><text>修改红娘</text></view>
        <view v-if="canReview" class="more-item last" @tap="onAbandonEntry(menuMember)"><text>{{ menuMember.review_status == 'REJECTED' ? '已弃海' : '移入弃海' }}</text></view>
        </template>
      </view>
    </view>

    <!-- ============ 子页：牵线记录 ============ -->
    <view v-else-if="subview == 'introductions' && selected != null" class="subpage">
      <view class="subpage-head">
        <text class="subpage-title">会员 {{ selected.nickname }} 的牵线记录</text>
        <view class="subpage-close" @tap="closeSubpage"><text>✕</text></view>
      </view>
      <view class="seg">
        <view class="seg-item" :class="{ on: introTab == 'OUTGOING' }" @tap="selectIntroTab('OUTGOING')"><text>主动牵线</text></view>
        <view class="seg-item" :class="{ on: introTab == 'INCOMING' }" @tap="selectIntroTab('INCOMING')"><text>被动牵线</text></view>
      </view>
      <scroll-view scroll-y class="subpage-list" :show-scrollbar="false">
        <view v-if="introLoading" class="state-card"><text>正在加载牵线记录…</text></view>
        <view v-else-if="visibleIntroductions.length == 0" class="state-card"><text>暂无牵线记录</text></view>
        <view v-for="row in visibleIntroductions" :key="row.id" class="intro-row">
          <view class="intro-ava"><text>{{ avatarText(row.counterpart_nickname) }}</text></view>
          <view class="intro-copy">
            <text class="intro-name">{{ row.counterpart_nickname }}</text>
            <text class="intro-sub">编号：G{{ row.counterpart_user_id }} · {{ row.direction == 'OUTGOING' ? '把本会员介绍给 TA' : '把 TA 介绍给本会员' }}</text>
          </view>
          <view class="intro-right">
            <text class="intro-status" :class="'ms-' + introStatusTone(row.status)">{{ introStatusLabel(row.status) }}</text>
            <text class="intro-time">{{ formatTime(row.created_at) }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ============ 子页：匹配 ============ -->
    <view v-else-if="subview == 'match' && selected != null" class="subpage">
      <view class="subpage-head">
        <text class="subpage-title">匹配合适的人</text>
        <view class="subpage-close" @tap="closeSubpage"><text>✕</text></view>
      </view>
      <scroll-view scroll-y class="subpage-list" :show-scrollbar="false">
        <view class="match-member">
          <view class="match-member-ava"><image v-if="selected.avatar" :src="avatarSrc(selected.avatar)" mode="aspectFill" /><text v-else>{{ avatarText(selected.nickname) }}</text></view>
          <view class="match-member-copy">
            <view class="mcard-name-row"><text class="mcard-name">{{ selected.nickname }}</text><text class="match-member-no">会员(G{{ selected.user_id }})</text></view>
            <text class="mcard-meta">{{ memberMeta(selected) }}</text>
          </view>
        </view>

        <view class="match-pref">
          <text class="match-pref-title">根据该会员的择偶要求：</text>
          <view class="match-pref-chips">
            <view v-for="chip in preferenceChips" :key="chip" class="match-chip"><text>{{ chip }}</text></view>
          </view>
        </view>

        <view class="match-tip">
          <text class="match-tip-title">温馨提示</text>
          <text class="match-tip-copy">状态为"停止相亲"、"已经脱单"的会员资料不会显示在匹配结果中。</text>
        </view>

        <view v-if="matchLoading" class="state-card"><text>正在匹配合适人选…</text></view>
        <view v-else-if="candidates.length == 0" class="state-card"><text>暂无符合条件的会员资料</text></view>
        <view v-for="row in candidates" :key="row.user_id" class="candidate-card">
          <view class="mcard-body">
            <view class="mcard-ava" :class="row.gender == 1 ? 'male' : 'female'">
              <image v-if="row.avatar" :src="avatarSrc(row.avatar)" mode="aspectFill" />
              <text v-else>{{ avatarText(row.nickname) }}</text>
            </view>
            <view class="mcard-info">
              <view class="mcard-name-row"><text class="mcard-name">{{ row.nickname }}</text></view>
              <text class="cand-no">编号:G{{ row.user_id }}</text>
              <view class="mcard-owner"><text class="mcard-owner-glyph">❥</text><text class="mcard-owner-label">服务红娘：</text><text class="mcard-owner-value">{{ row.matchmaker_name || '待分派' }}</text></view>
            </view>
            <view class="cand-ark"><text>公开相亲</text></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ============ 红娘说 / 修改红娘 / 弃因 / 联系 / 跟进 面板 ============ -->
    <view v-if="sheet != ''" class="overlay" @tap="closeSheet">
      <view class="panel" @tap.stop>
        <view v-if="sheet != 'assign'" class="panel-head">
          <text class="panel-title">{{ sheetTitle }}</text>
          <view class="panel-close" @tap="closeSheet"><text>✕</text></view>
        </view>

        <view v-if="sheet == 'note' && selected != null" class="panel-body">
          <textarea class="panel-textarea" maxlength="200" placeholder="请输入一段红娘对该会员的评价，本信息公开展示，限制200汉字" :value="noteDraft" @input="onNoteDraft" />
          <view class="panel-submit" @tap="submitNote"><text>提交</text></view>
        </view>

        <view v-else-if="sheet == 'assign' && selected != null" class="panel-body">
          <view class="assign-head">
            <text class="assign-cancel" @tap="closeSheet">取消</text>
            <text class="assign-title">修改红娘</text>
            <view class="assign-confirm" @tap="submitAssign"><text>确认</text></view>
          </view>
          <view v-if="assignLoading" class="state-inline"><text>正在加载红娘名单…</text></view>
          <view v-for="option in assignOptions" :key="option.user_id" class="assign-row" :class="{ disabled: option.user_id == (selected.matchmaker_id || 0), picked: assignTarget == option.user_id }" @tap="pickAssign(option)">
            <text>{{ option.display_name }}</text>
            <text v-if="option.user_id == (selected.matchmaker_id || 0)" class="assign-current">当前</text>
          </view>
        </view>

        <view v-else-if="sheet == 'abandonReason' && selected != null" class="panel-body">
          <textarea class="panel-textarea" maxlength="100" placeholder="请输入弃海原因" :value="abandonReason" @input="onAbandonReason" />
          <text class="panel-counter">已输入 {{ abandonReason.length }}/100字</text>
          <view class="panel-submit" @tap="submitAbandon"><text>确定提交</text></view>
        </view>

        <view v-else-if="sheet == 'review' && selected != null" class="panel-body">
          <view class="review-fee-row">
            <text class="review-fee-label">审核费：</text>
            <text class="review-fee-value">免审核费</text>
            <text class="review-fee-time">{{ formatTime(selected.created_at) }}</text>
          </view>
          <view class="review-status-row">
            <view v-for="option in reviewOptions" :key="option.value" class="review-chip" :class="{ picked: reviewStatus == option.value }" @tap="pickReviewStatus(option.value)">
              <text>{{ option.label }}</text>
            </view>
          </view>
          <view v-if="reviewStatus == 'REJECTED'" class="review-reject-area">
            <textarea class="review-reason" maxlength="30" placeholder="请输入审核不通过原因，限30个字" :value="reviewReason" @input="onReviewReason" />
            <text class="review-template-title">从模板选择：</text>
            <view v-for="(tpl, index) in reviewReasonTemplates" :key="index" class="review-template" @tap="applyReviewTemplate(tpl)"><text>{{ tpl }}</text></view>
          </view>
          <view class="panel-submit review-submit" @tap="submitReview"><text>提交</text></view>
        </view>

        <view v-else-if="sheet == 'followups' && selected != null" class="panel-body">
          <view v-for="item in followUps" :key="item.id" class="fu-row">
            <text class="fu-method">{{ followMethodLabel(item.method) }}</text>
            <text class="fu-content">{{ item.content }}</text>
            <text class="fu-time">{{ formatTime(item.created_at) }}</text>
          </view>
          <view v-if="followUps.length == 0" class="state-inline"><text>暂无服务跟进</text></view>
          <textarea class="panel-textarea" maxlength="2000" placeholder="记录本次服务跟进" :value="followContent" @input="onFollowContent" />
          <view class="panel-submit" @tap="submitFollowUp"><text>新增跟进</text></view>
        </view>
      </view>
    </view>

    <!-- 移入弃海确认弹窗 -->
    <view v-if="modal == 'abandon' && selected != null" class="modal-mask" @tap="closeModal">
      <view class="modal-card" @tap.stop>
        <text class="modal-copy">移入弃海后，该会员将显示在「弃海」列表，公开资料审核将标记为「审核不通过」，需修改资料后重新提交审核。</text>
        <view class="modal-actions">
          <view class="modal-btn" @tap="closeModal"><text>取消</text></view>
          <view class="modal-btn strong" @tap="confirmAbandon"><text>确认弃海</text></view>
        </view>
      </view>
    </view>

    <!-- 复制资料弹窗（样板：授权卡结构——图标块 + 居中标题/说明 + 分隔线 + 左右双胶囊）。
         先把要复制的文本列出来，「修改」只改这段文本，不回写会员在库中的资料。 -->
    <view v-if="copyVisible" class="cpd-mask" @tap="closeCopyProfile">
      <view class="cpd-card" @tap.stop>
        <view class="cpd-icon"><text class="cpd-icon-glyph">◈</text></view>
        <text class="cpd-title">复制会员资料</text>
        <text class="cpd-subtitle">确认下方文本后再复制，可先修改。</text>

        <view v-if="copyLoading" class="cpd-body">
          <view class="cpd-state"><text>正在加载资料…</text></view>
        </view>
        <view v-else-if="copyEditing" class="cpd-body cpd-editor">
          <textarea class="cpd-textarea" maxlength="2000" :value="copyText" @input="onCopyText" />
          <text class="cpd-note">这里的修改只影响要复制的文本，不会改动该会员的资料。</text>
        </view>
        <scroll-view v-else scroll-y class="cpd-body" :show-scrollbar="false">
          <view class="cpd-lines">
            <text v-if="copyError != ''" class="cpd-error">{{ copyError }}</text>
            <view v-if="copyError != ''" class="cpd-retry" @tap="retryCopyLoad"><text>重新加载</text></view>
            <text v-for="(line, index) in copyLines" :key="index" class="cpd-line">{{ line }}</text>
          </view>
        </scroll-view>

        <view class="cpd-footer">
          <view class="cpd-btn" @tap="toggleCopyEdit"><text>{{ copyEditing ? '预览' : '修改' }}</text></view>
          <view class="cpd-btn primary" :class="{ disabled: copyLoading }" @tap="confirmCopyProfile"><text>{{ copyCopied ? '已复制 ✓' : '一键复制' }}</text></view>
        </view>
      </view>
    </view>

    <!-- 查看联系方式弹窗由父页面（become-matchmaker）统一渲染，这里只上抛会员，避免重复实现弹层。 -->
  </view>
</template>

<script setup lang="uts">
import { watch } from 'vue'
import {
  assignMatchmakerMemberMatchmaker,
  createMatchmakerMemberFollowUp,
  getMatchmakerMemberFollowUps,
  getMatchmakerMemberMatchCandidates,
  getMatchmakerMemberMatchHistory,
  getMatchmakerMemberMatchmakers,
  getMatchmakerMemberNote,
  getMatchmakerMemberProfile,
  getMatchmakerReviewMembers,
  pickupMatchmakerMember,
  getMatchmakerWorkspaceProfile,
  getDiscoveryPlaza,
  updateMatchmakerMemberNote,
  updateMatchmakerReviewMember
} from '@/api'
import { resolveMediaUrl } from '@/api/config.uts'

interface Props {
  snapshot: any;
  initialTab?: string;
  refreshToken?: number;
}
const props = defineProps<Props>()
const emit = defineEmits<{ servedCount: [count: number], contact: [member: any], entry: [] }>()

const tabs = [
  { key: '', label: '全部' },
  { key: 'PENDING', label: '待审' },
  { key: 'mine', label: '我的' },
  { key: 'REJECTED', label: '弃海' },
  { key: 'vip_online', label: '线上VIP' },
  { key: 'vip_offline', label: '线下VIP' }
]

const activeTab = ref(props.initialTab == 'mine' ? 'mine' : (props.initialTab == '' ? '' : 'PENDING'))
const keyword = ref('')
const loading = ref(false)
const errorMessage = ref('')
const members = ref<any[]>([])
const rawMembers = ref<any[]>([])
const selfUserId = ref(0)
// 公开资料审核只对总店（SUPER）红娘开放，后端同口径返回 403。
const canReview = ref(false)

const filterVisible = ref(false)
const expandedFilterKey = ref('')
const rangeDraftMin = ref('')
const rangeDraftMax = ref('')
const options = (values: string[]): any[] => [{ label: '不限', value: '' }, ...values.map((value: string): any => ({ label: value, value: value }))]
const provinces = ['北京市','天津市','河北省','山西省','内蒙古自治区','辽宁省','吉林省','黑龙江省','上海市','江苏省','浙江省','安徽省','福建省','江西省','山东省','河南省','湖北省','湖南省','广东省','广西壮族自治区','海南省','重庆市','四川省','贵州省','云南省','西藏自治区','陕西省','甘肃省','青海省','宁夏回族自治区','新疆维吾尔自治区']
const createMemberFilter = (): any => ({ hometown:'', residence:'', household:'', gender:'', ageRange:'', heightRange:'', weight:'', education:'', occupation:'', income:'', marital:'', housing:'', vehicle:'', smoking:'', drinking:'', ethnicity:'', religion:'', mbti:'' })
const memberFilter = ref<any>(createMemberFilter())
const appliedMemberFilter = ref<any>(createMemberFilter())
const filterRows = [
 {key:'gender',label:'性别',options:[{label:'不限',value:''},{label:'男',value:'male'},{label:'女',value:'female'}]},
 {key:'ageRange',label:'年龄',options:[{label:'不限',value:''},{label:'20岁以下',value:'under20'},{label:'20-25岁',value:'20-25'},{label:'26-30岁',value:'26-30'},{label:'31-35岁',value:'31-35'},{label:'36-40岁',value:'36-40'},{label:'41岁以上',value:'over40'}]},
 {key:'heightRange',label:'身高(cm)',options:[{label:'不限',value:''},{label:'160cm以下',value:'under160'},{label:'160-169cm',value:'160-169'},{label:'170-179cm',value:'170-179'},{label:'180cm及以上',value:'over180'}]},
 {key:'weight',label:'体重(kg)',options:[{label:'不限',value:''},{label:'40kg以下',value:'under40'},{label:'40至不足50kg',value:'40-49'},{label:'50至不足60kg',value:'50-59'},{label:'60至不足70kg',value:'60-69'},{label:'70至不足80kg',value:'70-79'},{label:'80kg及以上',value:'over80'}]},
 {key:'residence',label:'现居地',options:options(provinces)}, {key:'hometown',label:'家乡',options:options(provinces)}, {key:'household',label:'户口',options:options(provinces)},
 {key:'education',label:'学历',options:[{label:'不限',value:''},{label:'高中及以下',value:'highschool'},{label:'大专',value:'college'},{label:'本科',value:'bachelor'},{label:'硕士',value:'masters'},{label:'博士',value:'doctor'}]},
 {key:'marital',label:'婚姻状况',options:[{label:'不限',value:''},{label:'未婚',value:'1'},{label:'离异',value:'2'},{label:'丧偶',value:'3'}]},
 {key:'occupation',label:'职业',options:options(['私企员工','央企/国企','事业单位/公务员','外企员工','自由职业','创业者/个体','教师','医生','律师','金融从业','互联网/IT','制造业','服务业','在校学生'])},
 {key:'income',label:'收入（年）',options:[{label:'不限',value:''},{label:'小于10w',value:'under10'},{label:'10-20w',value:'10-20'},{label:'30-50w',value:'30-50'},{label:'50-100w',value:'50-100'},{label:'100w以上',value:'over100'}]},
 {key:'mbti',label:'MBTI',options:options(['INTJ','INTP','ENTJ','ENTP','INFJ','INFP','ENFJ','ENFP','ISTJ','ISFJ','ESTJ','ESFJ','ISTP','ISFP','ESTP','ESFP'])},
 {key:'housing',label:'购房',options:options(['已购房','未购房','与父母同住'])}, {key:'vehicle',label:'购车',options:options(['已购车','未购车'])},
 {key:'ethnicity',label:'民族',options:options(['汉族','回族','满族','蒙古族','壮族','维吾尔族','藏族','苗族','彝族','其他'])},
 {key:'smoking',label:'吸烟',options:options(['不吸烟','偶尔吸烟','经常吸烟'])}, {key:'drinking',label:'喝酒',options:options(['不饮酒','社交场合饮酒','经常饮酒'])}, {key:'religion',label:'宗教',options:options(['无宗教信仰','佛教','基督教','伊斯兰教','道教','其他'])}
]
