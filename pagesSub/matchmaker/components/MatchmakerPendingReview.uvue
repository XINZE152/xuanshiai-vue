.cpd-footer { margin-top: 28rpx; padding: 24rpx 0 32rpx; border-top: 1px solid var(--line); display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.cpd-btn { min-width: 184rpx; height: 76rpx; padding: 0 28rpx; border-radius: 999rpx; background: var(--warm); display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 16rpx rgba(12, 19, 19, .08); }
.cpd-btn text { color: var(--ink); font-size: 25rpx; font-weight: 700; }
.cpd-btn.primary { background: linear-gradient(90deg, var(--accent), var(--accent2)); box-shadow: 0 10rpx 24rpx rgba(0, 96, 82, .24); }
