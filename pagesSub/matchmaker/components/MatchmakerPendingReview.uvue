.modal-btn.strong text { color: var(--accent2); font-weight: 800; }
.modal-btn:active { opacity: 0.7; }

/* 复制资料弹窗：图标块 + 居中标题/说明 + 文本区 + 分隔线 + 左右双胶囊（配色沿用本组件 token） */
.cpd-mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 100; padding: 0 56rpx; box-sizing: border-box; display: flex; flex-direction: row; align-items: center; justify-content: center; background: rgba(12, 19, 19, .46); }
.cpd-card { width: 100%; max-width: 640rpx; padding: 40rpx 32rpx 0; border-radius: 32rpx; background: var(--surface); display: flex; flex-direction: column; box-sizing: border-box; box-shadow: var(--shadow-lg); }
.cpd-icon { align-self: center; width: 112rpx; height: 112rpx; border-radius: 28rpx; border: 1px solid var(--line); background: linear-gradient(160deg, var(--paper), var(--warm)); display: flex; align-items: center; justify-content: center; box-shadow: 0 10rpx 24rpx rgba(12, 19, 19, .10); }
.cpd-icon-glyph { color: var(--accent2); font-size: 48rpx; line-height: 1; }
.cpd-title { margin-top: 24rpx; color: var(--ink); font-size: 33rpx; font-weight: 800; text-align: center; }
.cpd-subtitle { margin-top: 10rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; text-align: center; }
.cpd-body { margin-top: 24rpx; min-height: 116rpx; max-height: 50vh; padding: 22rpx 24rpx; border-radius: 20rpx; background: var(--canvas); box-sizing: border-box; }
.cpd-lines { display: flex; flex-direction: column; }
.cpd-line { color: var(--ink2); font-size: 25rpx; line-height: 46rpx; }
.cpd-state { min-height: 72rpx; display: flex; align-items: center; justify-content: center; }
.cpd-state text { color: var(--muted); font-size: 23rpx; }
.cpd-error { color: #e5484d; font-size: 22rpx; line-height: 40rpx; }
.cpd-retry { margin-top: 8rpx; align-self: flex-start; padding: 10rpx 24rpx; border-radius: 999rpx; background: var(--surface); }
.cpd-retry text { color: var(--accent2); font-size: 22rpx; font-weight: 800; }
.cpd-editor { display: flex; flex-direction: column; }
.cpd-textarea { width: 100%; height: 380rpx; color: var(--ink); font-size: 25rpx; line-height: 46rpx; }
