<template>
	<view class="custom-page">
		<scroll-view scroll-y class="page-scroller" :show-scrollbar="false">
			<view class="page-content">

				<!-- ============ Hero 主视觉 ============ -->
				<view class="hero">
					<view class="hero-bg"></view>
					<view class="hero-inner">
						<view class="hero-copy">
							<text class="hero-eyebrow">私人定制</text>
							<text class="hero-title">懂你的喜欢，也懂你的不将就</text>
							<text class="hero-summary">一对一红娘服务，按你的节奏筛选与认识。</text>
							<view class="hero-tags">
								<view v-for="tag in heroTags" :key="tag" class="hero-tag">
									<text class="hero-tag-dot"></text>
									<text class="hero-tag-text">{{ tag }}</text>
								</view>
							</view>
						</view>
					</view>
				</view>

				<!-- ============ 为什么选择 / 七大专属服务 ============ -->
				<view class="section">
					<view class="section-head">
						<text class="section-title">为什么选择私人定制？</text>
						<text class="section-sub">七大专属服务</text>
					</view>

					<view class="service-grid">
						<view
							v-for="(item, index) in exclusiveServices"
							:key="item.title"
							class="service-card"
							@click="showServiceDetail(item)"
						>
							<view class="service-icon">
								<text class="service-icon-text">{{ item.icon }}</text>
							</view>
							<text class="service-title">{{ item.title }}</text>
							<text class="service-copy">{{ item.copy }}</text>
						</view>
						<!-- 占位第 8 格：查看更多 -->
						<view class="service-card more-card" @click="showAllServices">
							<view class="service-icon more-icon">
								<text class="service-icon-text">···</text>
							</view>
							<text class="service-title">查看更多</text>
							<text class="service-copy">了解全部服务细节</text>
						</view>
					</view>
				</view>

				<!-- ============ 服务流程 ============ -->
				<view class="section">
					<view class="section-head">
						<text class="section-title">服务流程</text>
						<text class="section-sub">每一步，都有红娘陪着你</text>
					</view>

					<scroll-view scroll-x :enable-flex="true" class="process-scroll" :show-scrollbar="false">
						<view class="process-list">
							<view
								v-for="(step, index) in processSteps"
								:key="step.title"
								class="process-item"
							>
								<view class="process-circle">
									<text class="process-num">{{ index + 1 }}</text>
								</view>
								<view v-if="index < processSteps.length - 1" class="process-line"></view>
								<text class="process-title">{{ step.title }}</text>
								<text class="process-copy">{{ step.copy }}</text>
							</view>
						</view>
					</scroll-view>
				</view>

				<!-- ============ 成功案例 ============ -->
				<view class="section">
					<view class="section-head row">
						<view class="section-head-text">
							<text class="section-title">成功案例</text>
							<text class="section-sub">服务案例展示，人物照片来自公开图库</text>
						</view>
						<text class="section-link" @click="showAllCases">查看更多 ›</text>
					</view>

					<scroll-view :scroll-x="true" :enable-flex="true" enhanced class="case-scroll" :show-scrollbar="false" @scroll="handleCaseScroll" @scrollend="handleCaseScrollEnd">
						<view class="case-list" :style="'width: ' + caseListWidth + 'rpx;'">
							<view
								v-for="(item, caseIdx) in successCases"
								:key="item.name"
								class="case-card"
							>
								<image class="case-image" :src="item.image" mode="aspectFit"></image>
								<view class="case-body">
									<text class="case-name">{{ item.name }}</text>
									<text class="case-meta">{{ item.matchTime }}</text>
									<view class="case-feedback-row">
										<text class="case-quote-mark">"</text>
										<text class="case-feedback">{{ item.feedback }}</text>
									</view>
								</view>
							</view>
						</view>
					</scroll-view>

					<!-- 滑动指示点 -->
					<view class="case-dots">
						<view
							v-for="(dot, dotIdx) in successCases"
							:key="'dot-' + dotIdx"
							class="case-dot"
							:class="{ active: currentCaseIndex === dotIdx }"
						></view>
					</view>
				</view>

				<!-- ============ 查看更多案例弹窗 ============ -->
				<view v-if="showAllCasesModal" class="cases-overlay" @click="closeAllCases">
					<view class="cases-modal" @click.stop>
						<view class="cases-modal-head">
							<text class="cases-modal-title">全部成功案例</text>
							<text class="cases-modal-sub">服务案例展示，人物照片来自公开图库</text>
							<view class="cases-modal-close" @click="closeAllCases">
								<text>×</text>
							</view>
						</view>
						<scroll-view scroll-y class="cases-modal-scroll" :show-scrollbar="false">
							<view class="cases-modal-list">
								<view
									v-for="item in allDisplayCases"
									:key="item.name"
									class="cases-modal-card"
								>
									<image class="cases-modal-image" :src="item.image" mode="aspectFit"></image>
									<view class="cases-modal-body">
										<text class="cases-modal-name">{{ item.name }}</text>
										<text class="cases-modal-meta">{{ item.matchTime }}</text>
										<view class="cases-modal-feedback">
											<text class="case-quote-mark">"</text>
											<text class="cases-modal-feedback-text">{{ item.feedback }}</text>
										</view>
									</view>
								</view>
							</view>
						</scroll-view>
					</view>
				</view>

				<!-- ============ 服务套餐 ============ -->
				<view class="section">
					<view class="section-head">
						<text class="section-title">服务套餐</text>
						<text class="section-sub">选择适合自己的服务节奏</text>
					</view>

					<scroll-view :scroll-x="true" :enable-flex="true" enhanced class="plan-scroll" :show-scrollbar="false">
						<view class="plan-list" :style="'width: ' + planListWidth + 'rpx;'">
							<view
								v-for="item in plans"
								:key="item.id"
								class="plan-card"
								:class="{ selected: selectedPlanId === item.id, hot: item.isHot }"
								@click="selectPlan(item)"
							>
								<view v-if="item.tag" class="plan-badge"><text>{{ item.tag }}</text></view>
								<text class="plan-name">{{ item.name }}</text>
								<view class="plan-price-row">
									<text class="plan-price-symbol">¥</text>
									<text class="plan-price-value">{{ item.price }}</text>
									<text v-if="item.originalPrice" class="plan-price-original">¥{{ item.originalPrice }}</text>
								</view>
								<text class="plan-duration">{{ item.duration }}</text>
								<view class="plan-divider"></view>
								<view class="plan-benefits">
									<view v-for="(b, i) in item.benefits.slice(0, 3)" :key="i" class="plan-benefit">
										<text class="plan-benefit-dot"></text>
										<text class="plan-benefit-text">{{ b }}</text>
									</view>
								</view>
							</view>
						</view>
					</scroll-view>
				</view>

				<!-- ============ 底部说明 ============ -->
				<view class="page-note">
					<text class="page-note-text">页面人物照片来自公开图库，仅作案例展示</text>
					<text class="page-note-text">服务全程由平台认证红娘一对一跟进</text>
				</view>

			</view>
		</scroll-view>

		<!-- ============ 底部固定 CTA ============ -->
		<view class="footer-safe">
			<view class="footer-actions">
				<view class="contact-btn" @click="contactMatchmaker">
					<text class="contact-btn-text">联系红娘</text>
				</view>
				<view class="apply-btn" @click="applyPlan">
					<text class="apply-btn-text">立即申请私人定制</text>
				</view>
			</view>
		</view>

	</view>
</template>

<script setup lang="uts">
import { getCustomPlans } from '@/api'

const matchmakerCaseImageA = '/pagesSub/matchmaker/static/cases/wuhan-zhou-zheng.webp'
const matchmakerCaseImageB = '/pagesSub/matchmaker/static/cases/shenzhen-zhang-liu.webp'

interface PlanItem {
	id: number
	name: string
	price: number
	originalPrice?: number
	duration: string
	services: string[]
	features: string[]
	benefits: string[]
	matchmakerCount: number
	description: string
	isHot: boolean
	tag: string
}

const fallbackPlans: PlanItem[] = [
	{
		id: 1, name: '基础版', price: 2999, originalPrice: 3999, duration: '3 个月',
		services: ['精准匹配 3 次', '见面节奏建议', '资料优化 1 次'],
		features: ['1 位专属红娘', '每月回访'],
		benefits: ['专属红娘 1 名', '精准匹配 3 次', '资料优化 1 次'],
		matchmakerCount: 1,
		description: '适合初次尝试私人定制服务',
		isHot: false, tag: ''
	},
	{
		id: 2, name: '高级版', price: 5999, originalPrice: 8999, duration: '6 个月',
		services: ['精准匹配不限次', '见面复盘 5 次', '一对一沟通指导'],
		features: ['金牌红娘 1 名', '每周反馈'],
		benefits: ['金牌红娘 1 名', '精准匹配不限次', '线下约会安排'],
		matchmakerCount: 2,
		description: '平台推荐，匹配更精准',
		isHot: true, tag: '推荐'
	},
	{
		id: 3, name: '尊享版', price: 9990, originalPrice: 12999, duration: '12 个月',
		services: ['长期候选池筛选', '资深红娘团队', 'VIP 专属服务'],
		features: ['资深红娘团队', '无限次匹配'],
		benefits: ['资深红娘团队', '无限次匹配', '高端会员库开放'],
		matchmakerCount: 3,
		description: '资深红娘全程尊享服务',
		isHot: false, tag: ''
	}
]

const heroTags = ['私密筛选', '专属顾问', '持续跟进']

const exclusiveServices = [
	{ icon: '隐', title: '无需注册曝光', copy: '资料不公开展示，仅由红娘内部匹配使用。' },
	{ icon: '知', title: '深度了解会员', copy: '通过沟通了解性格、经历与关系期待。' },
	{ icon: '开', title: '开放隐藏会员', copy: '接触未在公开列表展示的优质会员。' },
	{ icon: '荐', title: '红娘精准推荐', copy: '红娘人工筛选后定向推荐匹配对象。' },
	{ icon: '形', title: '个人形象指导', copy: '约会形象与沟通技巧一对一建议。' },
	{ icon: '见', title: '安排线下见面', copy: '协助沟通双方时间，安排线下约会。' },
	{ icon: '馈', title: '反馈约会结果', copy: '约会后收集双方反馈，优化匹配策略。' }
]

const processSteps = [
	{ title: '提交申请', copy: '填写关系期待' },
	{ title: '红娘联系', copy: '24 小时内主动联系' },
	{ title: '需求分析', copy: '深入沟通明确方向' },
	{ title: '精准匹配', copy: '筛选推荐合适对象' },
	{ title: '安排见面', copy: '协调时间促成约会' },
	{ title: '持续跟进', copy: '回访优化推荐质量' }
]

	const successCases = [
		{
			name: '杭州 · 林女士 & 王先生',
			matchTime: '2026.03 牵手',
			copy: '两人都是高校教师，性格内敛但目标明确。从咖啡到徒步到家庭聚餐，三个月后确认订婚。',
			feedback: '红娘很耐心，推荐的非常精准。我们两个都是比较慢热的人，但红娘帮我们找到了共同节奏。',
			image: matchmakerCaseImageA
		},
		{
			name: '南京 · 周先生 & 赵女士',
			matchTime: '2026.05 牵手',
			copy: '杭州的她与南京的他，经过三个月的双向了解，最终确定了共同生活的城市，完成了一场跨越城市的奔赴。',
			feedback: '感谢红娘帮我们看清了方向。异地很难，但她帮我们一步一步把不确定变成了确定。',
			image: matchmakerCaseImageB
		},
		{
			name: '上海 · 陈女士 & 李先生',
			matchTime: '2026.06 牵手',
			copy: '双方都不是一见钟情的类型，但在持续沟通和反馈中逐渐发现了彼此的契合点，慢慢走进了对方的生活。',
			feedback: '不着急反而更稳。红娘一直跟我们说，好的关系是日复一日的确定感，我们终于体会到了。',
			image: matchmakerCaseImageA
		}
	]

	// 更多案例（用于"查看更多"弹窗）
	const moreCases = [
		{
			name: '深圳 · 张先生 & 刘女士',
			matchTime: '2026.04 牵手',
			feedback: '我们都是第一次用婚恋服务，一开始很犹豫。红娘给了很多安心感，匹配的第三位就遇到了对的人。',
			image: matchmakerCaseImageB
		},
		{
			name: '成都 · 杨女士 & 孙先生',
			matchTime: '2026.02 牵手',
			feedback: '红娘很懂我们这代人的婚恋观，不催不赶，帮我们自然地走到了一起。现在每天都觉得很踏实。',
			image: matchmakerCaseImageA
		},
		{
			name: '北京 · 赵先生 & 吴女士',
			matchTime: '2025.12 牵手',
			feedback: '两个互联网人，平时太忙了。红娘帮我们做了很多筛选和节奏安排，让我们能专注在了解彼此上。',
			image: matchmakerCaseImageB
		},
		{
			name: '广州 · 陈先生 & 黄女士',
			matchTime: '2025.11 牵手',
			feedback: '见面前两次都觉得不太合适，红娘建议再试一次，第三次见面完全改观了。感谢她的坚持。',
			image: matchmakerCaseImageB
		},
		{
			name: '武汉 · 周女士 & 郑先生',
			matchTime: '2025.10 牵手',
			feedback: '红娘特别细心，记得每个人的喜好和小细节。她推荐的人选，一次比一次贴近我的期待。',
			image: matchmakerCaseImageA
		}
	]

const caseListWidth = computed((): number => {
	const count = successCases.length
	if (count <= 1) return 480
	return count * 480 + (count - 1) * 24
})

const plans = ref<PlanItem[]>(fallbackPlans)
const selectedPlanId = ref<number>(2)

const activePlan = computed<PlanItem>(() => {
	const found = plans.value.find((p: PlanItem) => p.id == selectedPlanId.value)
	return found != null ? found : plans.value[0]
})

const planListWidth = computed((): number => {
	const count = plans.value.length
	if (count <= 1) return 335
	return count * 335 + (count - 1) * 16
})

onMounted(async () => {
	try {
		const pages = getCurrentPages()
		const currentPage = pages[pages.length - 1]
		const options = currentPage.options
		if (options != null && options.id != null) {
			selectedPlanId.value = parseInt(options.id)
		}
	} catch (e) {}

	try {
		const response = await getCustomPlans()
		if (response.success && response.data != null) {
			const list = response.data as PlanItem[]
			if (list.length > 0) {
				plans.value = list.map((p: any): PlanItem => ({
					id: p.id,
					name: p.name,
					price: p.price,
					originalPrice: p.originalPrice,
					duration: p.duration,
					services: p.services,
					features: p.features,
					benefits: p.features,
					matchmakerCount: p.matchmakerCount,
					description: p.description,
					isHot: p.isHot,
					tag: p.tag
				}))
				const exists = plans.value.find((p: PlanItem) => p.id == selectedPlanId.value)
				if (exists == null) selectedPlanId.value = plans.value[0].id
			}
		}
	} catch (e) {
		uni.showToast({ title: '已展示默认服务方案', icon: 'none' })
	}
})

const selectPlan = (plan: PlanItem) => {
	selectedPlanId.value = plan.id
}

// ===== 案例滑动追踪 =====
const currentCaseIndex = ref(0)
let caseScrollTimer: any = null
const caseCardStepRpx = 504
let latestCaseScrollLeft = 0

const updateCaseIndex = (scrollLeft: number) => {
	try {
		const info = uni.getSystemInfoSync()
		const screenWidth = info.screenWidth ?? 375
		const cardStep = (caseCardStepRpx / 750) * screenWidth
		if (cardStep <= 0 || successCases.length == 0) return
		const rawIdx = Math.floor((scrollLeft + cardStep * 0.5) / cardStep)
		currentCaseIndex.value = Math.max(0, Math.min(rawIdx, successCases.length - 1))
	} catch (_) {
		// 降级：不更新指示点
	}
}

const handleCaseScroll = (e: any) => {
	latestCaseScrollLeft = e.detail?.scrollLeft ?? 0
	if (caseScrollTimer != null) clearTimeout(caseScrollTimer)
	caseScrollTimer = setTimeout(() => {
		caseScrollTimer = null
		updateCaseIndex(latestCaseScrollLeft)
	}, 48)
}

const handleCaseScrollEnd = (e: any) => {
	latestCaseScrollLeft = e.detail?.scrollLeft ?? latestCaseScrollLeft
	if (caseScrollTimer != null) {
		clearTimeout(caseScrollTimer)
		caseScrollTimer = null
	}
	updateCaseIndex(latestCaseScrollLeft)
}

// ===== 查看更多案例 =====
const showAllCasesModal = ref(false)
const allDisplayCases = computed(() => {
	return successCases.concat(moreCases)
})

const showServiceDetail = (item: any) => {
	uni.showModal({
		title: item.title,
		content: item.copy,
		showCancel: false,
		confirmText: '知道了'
	})
}

const showAllServices = () => {
	uni.showToast({ title: '更多服务介绍整理中', icon: 'none' })
}

const showAllCases = () => {
		showAllCasesModal.value = true
	}

	const closeAllCases = () => {
		showAllCasesModal.value = false
	}

const contactMatchmaker = async () => {
	uni.showToast({ title: '提交服务申请后，平台会在授权流程内安排联系', icon: 'none' })
}

const applyPlan = () => {
	uni.navigateTo({
		url: '/pagesSub/matchmaker/apply?type=custom&matchmakerName='
			+ encodeURIComponent(activePlan.value.name)
			+ '&planId=' + activePlan.value.id
			+ '&planName=' + encodeURIComponent(activePlan.value.name)
			+ '&planPrice=' + activePlan.value.price
			+ '&planDuration=' + encodeURIComponent(activePlan.value.duration)
			+ '&planOriginalPrice=' + (activePlan.value.originalPrice != null ? activePlan.value.originalPrice : 0)
			+ '&planDescription=' + encodeURIComponent(activePlan.value.description)
			+ '&planBenefits=' + encodeURIComponent(activePlan.value.benefits.join('|'))
	})
}
</script>

<style scoped>
.custom-page {
	min-height: 100vh;
	background: var(--canvas);
}

.page-scroller {
	height: 100vh;
}

.page-content {
	padding: 24rpx 32rpx 200rpx;
	display: flex;
	flex-direction: column;
	gap: 24rpx;
}

/* ============ Hero ============ */
.hero {
	position: relative;
	border-radius: 20rpx;
	overflow: hidden;
	background: linear-gradient(145deg, var(--accent-bg) 0%, var(--surface) 100%);
	box-shadow: var(--shadow-md);
}

.hero-bg {
	position: absolute;
	top: -60rpx;
	right: -60rpx;
	width: 320rpx;
	height: 320rpx;
	border-radius: 50%;
	background: var(--accent-glow);
	border: 1rpx solid var(--soft);
}

.hero-inner {
	position: relative;
	display: flex;
	flex-direction: column;
	padding: 32rpx 28rpx;
}

.hero-copy {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
	z-index: 1;
}

.hero-eyebrow {
	font-size: 20rpx;
	font-weight: 800;
	color: var(--accent2);
	letter-spacing: 0.08em;
}

.hero-title {
	font-size: 40rpx;
	line-height: 1.3;
	font-weight: 700;
	font-family: var(--serif);
	color: var(--ink);
}

.hero-summary {
	font-size: 20rpx;
	line-height: 1.55;
	color: var(--ink2);
	opacity: 1;
}

.hero-tags {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 12rpx;
	margin-top: 10rpx;
}

.hero-tag {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8rpx;
	padding: 8rpx 16rpx;
	border-radius: 999rpx;
	background: var(--surface);
}

.hero-tag-dot {
	width: 12rpx;
	height: 12rpx;
	border-radius: 50%;
	background: var(--accent);
}

.hero-tag-text {
	font-size: 20rpx;
	font-weight: 700;
	color: var(--accent2);
}

/* ============ 通用 Section ============ */
.section {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.section-head {
	display: flex;
	flex-direction: column;
	gap: 4rpx;
}

.section-head.row {
	flex-direction: row;
	align-items: flex-end;
