@font-face { font-family: "iconfont-home"; src: url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff') format('woff'); }
@font-face { font-family: "iconfont-sys"; src: url('/static/婚恋小程序图标/系统通用/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/系统通用/iconfont.woff') format('woff'); }
@font-face { font-family: "iconfont-social"; src: url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff') format('woff'); }
@font-face { font-family: "iconfont-me"; src: url('/static/婚恋小程序图标/个人中心/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/个人中心/iconfont.woff') format('woff'); }

.ic { font-style: normal; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
.ic-sys { font-family: "iconfont-sys" !important; }
.ic-social { font-family: "iconfont-social" !important; }
.ic-me { font-family: "iconfont-me" !important; }

/* 图标 unicode 映射（仅本页用到的子集） */
.ic-jiantou-you:before { content: "\e928"; }
.ic-touxiang:before { content: "\e632"; }
.ic-shiming:before { content: "\e605"; }
.ic-fenxiang:before { content: "\e636"; }
.ic-shezhi:before { content: "\e69d"; }
.ic-kefu:before { content: "\e6d0"; }
.ic-bangzhu:before { content: "\e623"; }

/* 个人中心图标尺寸 */
.avatar-icon { font-size: 28px; color: var(--profile-text-inverse); }

/* ==================== 邀请分享弹窗（与「我的」页同款） ==================== */
.invite-share-mask {
	position: fixed;
	z-index: 20;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	background-color: rgba(12, 19, 19, 0.68);
}

.invite-share-sheet {
	display: flex;
	flex-direction: column;
	align-self: stretch;
	width: 100%;
	padding: 24rpx 32rpx 26rpx;
	border-radius: 28rpx 28rpx 0 0;
	background-color: #EDF1EC;
}

.invite-share-handle {
	width: 64rpx;
	height: 6rpx;
	margin: 0 auto 32rpx;
	border-radius: 999px;
	background-color: #D7DDD5;
}

.invite-share-title {
	margin-bottom: 28rpx;
	color: #1A1A1A;
	font-size: 30rpx;
	font-weight: 600;
}

.invite-share-options {
	display: flex;
	flex-direction: row;
	gap: 24rpx;
}

.invite-share-option {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	height: 220rpx;
	padding: 20rpx 8rpx;
	border: 1px solid #B9CFB5;
	border-radius: 24rpx;
	background-color: #F8FAF7;
}

.invite-share-option + .invite-share-option { border-color: #D5B477; background-color: #FCF8EF; }

.invite-share-option-icon {
	width: 72rpx;
	height: 72rpx;
	margin-bottom: 20rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 999px;
