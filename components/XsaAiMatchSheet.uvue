<template>
	<view class="ai-match-overlay" :class="{ open: visible }" @click="handleClose">
		<view class="ai-match-sheet" :class="{ dragging: isDragging }" :style="{ height: sheetHeight + '%' }" @click.stop>
			<!-- 顶部拖拽区：按住横线上下调整小窗显示区域 -->
			<view
				class="drag-zone"
				@touchstart="onDragStart"
				@touchmove.stop.prevent="onDragMove"
				@touchend="onDragEnd"
				@touchcancel="onDragEnd"
			>
				<view class="drag-bar"></view>
				<view class="sheet-head">
					<text class="sheet-title">资料合拍参考</text>
					<view class="close-btn" @click="handleClose">
						<text>✕</text>
					</view>
				</view>
			</view>

			<!-- 内容区：scroll-view 保证小程序内可滚动 -->
			<scroll-view class="sheet-scroll" scroll-y enhanced :show-scrollbar="false">
				<view class="sheet-content">
					<!-- 仅在正式 compatibility 结果取得展示资格后显示受限数值 -->
					<view class="pair-header">
						<view class="pair-side">
							<view class="pair-avatar">
								<image v-if="myAvatar != ''" class="pair-avatar-img" :src="myAvatar" mode="aspectFill"></image>
								<text v-else class="pair-avatar-fallback">我</text>
							</view>
							<view v-if="myMbti != ''" class="pair-type-chip"><text class="pair-type-text">{{ myMbti }}</text></view>
						</view>
						<view class="pair-center">
							<text class="pair-score-label">双向资料合拍参考</text>
							<text class="pair-score">{{ scoreText }}</text>
						</view>
						<view class="pair-side">
							<view class="pair-avatar">
								<image v-if="otherAvatar != ''" class="pair-avatar-img" :src="otherAvatar" mode="aspectFill"></image>
								<text v-else class="pair-avatar-fallback">Ta</text>
							</view>
							<view v-if="otherType != ''" class="pair-type-chip"><text class="pair-type-text">{{ otherType }}</text></view>
						</view>
					</view>

					<view v-if="loading" class="state-unavailable"><text class="state-unavailable-title">正在读取资料合拍参考</text><text class="state-unavailable-desc">只根据当前可见且已确认的资料整理。</text></view>
					<view v-else-if="errorMessage != ''" class="state-unavailable"><text class="state-unavailable-title">合拍参考暂时无法读取</text><text class="state-unavailable-desc">{{ errorMessage }}</text><view class="compatibility-retry" @click="loadCompatibility"><text>重试</text></view></view>
					<view v-else-if="isDisplayReady" class="compatibility-result">
						<view class="compatibility-overall"><text class="compatibility-overall-label">整体参考</text><text class="compatibility-overall-value">{{ scoreText }}</text><text class="compatibility-overall-copy">本次可用资料覆盖度 {{ coverageText }}</text></view>
						<view class="compatibility-directions"><view class="compatibility-direction"><text>对方资料符合我期待的参考</text><text>{{ directionViewerText }}</text></view><view class="compatibility-direction"><text>我的资料符合对方期待的参考</text><text>{{ directionTargetText }}</text></view></view>
						<view v-if="reasonLines.length > 0" class="compatibility-section"><text class="compatibility-section-title">可展示依据</text><text v-for="(line, index) in reasonLines" :key="index" class="compatibility-line">{{ line }}</text></view>
						<text class="compatibility-engine">{{ engineLabel }}</text>
						<!-- §5：分数语义说明——规则指数不是关系成功率，也不加阈值结论。 -->
						<text class="sheet-tip">仅依据双方当前可见且已确认的资料整理，供了解和破冰参考。分数为合拍参考指数（满分 100），不代表关系结果或成功概率。</text>
						<text class="sheet-tip">{{ compatibility.disclaimer }}</text>
					</view>
					<view v-else class="state-unavailable"><text class="state-unavailable-title">{{ statusTitle }}</text><text class="state-unavailable-desc">{{ statusDescription }}</text></view>

					<view v-if="compatibility != null && !isDisplayReady" class="sheet-tip"><text>仅供了解和破冰参考，不代表平台承诺任何关系结果。</text></view>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { getCompatibility, waitForCompatibilityTask } from '@/api/ai-compatibility.uts'
import { USE_MOCK } from '@/api/config.uts'
/** 资料合拍参考；沿用现有可拖拽、可滚动的小窗。 */
interface Props {
	visible: boolean;
	targetUserId: number;
	myName: string;
	myAvatar: string;
	myMbti: string;
	otherName: string;
	otherAvatar: string;
	otherMbti: string;
}
const props = withDefaults(defineProps<Props>(), {
	visible: false,
	targetUserId: 0,
	myName: '你',
	myAvatar: '',
	myMbti: '',
	otherName: 'Ta',
	otherAvatar: '',
	otherMbti: ''
});
const emit = defineEmits<{
	close: []
}>();

const windowInfo = uni.getWindowInfo()
const windowHeight = windowInfo.windowHeight != null ? windowInfo.windowHeight : 667

/* 小窗高度（百分比），拖拽在 28% ~ 97% 之间连续变化，松手吸附档位 */
const HEIGHT_STOPS: number[] = [48, 72, 94]
const sheetHeight = ref(72)
const isDragging = ref(false)
let dragStartY = 0
let dragStartHeight = 72

const compatibility = ref<any>(null)
const loading = ref(false)
const errorMessage = ref('')
let requestSequence = 0

const isDisplayReady = computed((): boolean => {
	const result = compatibility.value
	return !loading.value && errorMessage.value == '' && result != null && result.status == 'ready' && result.display_eligible == true
})
const percentText = (value: any, multiplier: number = 1): string => {
	if (value == null) return '--'
	const score = Number(value) * multiplier
	if (isNaN(score) || score < 0 || score > 100) return '--'
	return '' + Math.round(score) + '%'
}
// §5：固定匹配解读。停止展示生成式 reason_texts，改由当前允许展示的
// evidence（displayable=true）按 reason_code 输出固定话术。
//
// 白名单与后端 app/services/ai/compatibility.py 的 _EVIDENCE_LIMITATIONS 一一对应；
// 未知码一律忽略（不反向推测「不满足」），不得在此新增后端没有的判断。
const REASON_CODE_TEMPLATES: Record<string, string> = {
	AGE_MUTUAL_WITHIN_RANGE: '双方年龄均在对方已确认的年龄期待范围内',
	CITY_MUTUAL_ACCEPTED: '双方所在城市均在对方已确认的可接受范围内',
	MARRIAGE_MUTUAL_ACCEPTED: '双方婚姻状态符合对方已确认的期待',
	EDUCATION_MUTUAL_WITHIN_RANGE: '双方学历符合对方已确认的学历范围',
	HEIGHT_MUTUAL_WITHIN_RANGE: '双方身高均在对方已确认的期待范围内',
	INCOME_MUTUAL_WITHIN_RANGE: '双方收入档位符合对方已确认的期待范围',
	INTEREST_OVERLAP: '双方兴趣标签存在交集',
	RELATIONSHIP_GOAL_SHARED: '双方已确认的关系期待一致',
}
// 非相互满足码的固定状态话术；同样只在 evidence.displayable=true 时输出。
const REASON_CODE_NOTES: Record<string, string> = {
	DIMENSION_UNKNOWN: '部分资料尚不完整',
}
// 分数文案固定使用「分/100」，不把规则指数写成关系成功概率。
const scoreText = computed((): string => {
	if (!isDisplayReady.value) return '--'
	const value = compatibility.value.compatibility_index
	if (value == null) return '--'
	const score = Number(value)
	if (isNaN(score) || score < 0 || score > 100) return '--'
	return '' + Math.round(score) + '分/100'
})
const coverageText = computed((): string => isDisplayReady.value ? percentText(compatibility.value.coverage, 100) : '--')
const directionViewerText = computed((): string => isDisplayReady.value && compatibility.value.directions != null ? percentText(compatibility.value.directions.viewer_to_target) : '--')
const directionTargetText = computed((): string => isDisplayReady.value && compatibility.value.directions != null ? percentText(compatibility.value.directions.target_to_viewer) : '--')
// 固定原因清单：只输出白名单内且 evidence.displayable=true 的原因码。
const reasonLines = computed((): string[] => {
	if (!isDisplayReady.value || !Array.isArray(compatibility.value.evidence)) return []
	const lines: string[] = []
	const seen: string[] = []
	const items = compatibility.value.evidence
	for (let i = 0; i < items.length; i++) {
		const item = items[i]
		if (item == null || item.displayable != true) continue
		const code = item.reason_code != null ? '' + item.reason_code : ''
		if (code == '' || seen.indexOf(code) >= 0) continue
		seen.push(code)
		// 未知码忽略：不在白名单内的一律不输出，也不反推「不满足」。
		const template = REASON_CODE_TEMPLATES[code] != null ? REASON_CODE_TEMPLATES[code] : REASON_CODE_NOTES[code]
		if (template == null || template == '') continue
		lines.push(template)
	}
	return lines
})
// 展示用的证据条目同样只保留白名单内、displayable=true 的项，避免未知码经 limitation 泄漏。
const evidenceItems = computed((): any[] => {
	if (!isDisplayReady.value || !Array.isArray(compatibility.value.evidence)) return []
	return compatibility.value.evidence.filter((item: any): boolean => {
		if (item == null || item.displayable != true) return false
		const code = item.reason_code != null ? '' + item.reason_code : ''
		if (code == '' || (REASON_CODE_TEMPLATES[code] == null && REASON_CODE_NOTES[code] == null)) return false
		return typeof item.limitation == 'string' && item.limitation.trim() != ''
	})
})
const engineLabel = computed((): string => {
	if (!isDisplayReady.value) return ''
	return compatibility.value.engine == 'llm-v1' ? 'AI 资料合拍参考' : '规则资料参考，非 AI 精算'
})
const statusTitle = computed((): string => {
	const result = compatibility.value
	if (result == null) return '暂无合拍参考'
	if (result.status == 'stale') return '资料已更新，请重新获取'
	if (result.status == 'blocked') return '当前无法提供合拍参考'
	if (result.status == 'coverage_insufficient') return '可用资料还不足'
	if (result.status == 'ready' && result.display_eligible != true) return '合拍参考暂未开放展示'
	return '暂无可展示的合拍参考'
})
const statusDescription = computed((): string => {
	const result = compatibility.value
	if (result != null && result.status == 'stale') return '双方资料或授权已有变化，旧结果不作为最新参考。'
	if (result != null && result.status == 'blocked') return '当前资料或授权不满足读取条件，不展示相关分数与解释。'
	if (result != null && result.status == 'coverage_insufficient') return '已确认且允许使用的资料不足，不生成完整分数。'
	return '你仍可以查看公开资料，并按真实互动继续了解。'
})

const compatibilityError = (response: any): string => {
	const detail = response != null && response.data != null ? response.data.detail : null
	const code = detail != null ? String(detail.code != null ? detail.code : '') : ''
	if (code == 'AI_FEATURE_DISABLED') return '资料合拍参考当前未开放'
	if (code == 'AI_CONSENT_REQUIRED') return '需要有效授权才能读取资料合拍参考'
	if (code == 'CANDIDATE_NOT_VISIBLE') return '当前无法查看该用户的合拍参考'
	if (detail != null && typeof detail.message == 'string') return detail.message
	return response != null && response.message != null ? String(response.message) : '读取失败，请稍后重试'
}
const loadCompatibility = async () => {
	if (!props.visible) return
	const sequence = ++requestSequence
	const targetId = props.targetUserId
	const isCurrent = (): boolean => sequence == requestSequence && props.visible && props.targetUserId == targetId
	compatibility.value = null
	errorMessage.value = ''
	loading.value = true
	try {
		if (USE_MOCK) { errorMessage.value = '演示模式没有正式合拍结果'; return }
		if (isNaN(targetId) || targetId <= 0) { errorMessage.value = '暂无可读取的目标用户'; return }
		let response = await getCompatibility(targetId)
		if (!isCurrent()) return
		if (!response.success || response.data == null) { errorMessage.value = compatibilityError(response); return }
		// 202 的预测状态不是结果；任务成功后必须重新经过 GET 的资格与可见性校验。
		if (response.data.task_id != null && String(response.data.task_id) != '') {
			const outcome = await waitForCompatibilityTask(String(response.data.task_id), isCurrent)
			if (!isCurrent()) return
			if (outcome.status != 'succeeded') { errorMessage.value = outcome.error != null ? String(outcome.error) : '处理未完成，请稍后重试'; return }
			response = await getCompatibility(targetId)
			if (!isCurrent()) return
			if (!response.success || response.data == null) { errorMessage.value = compatibilityError(response); return }
			if (response.data.task_id != null) { errorMessage.value = '合拍参考仍在处理中，请稍后重试'; return }
		}
		if (response.data.status == null) { errorMessage.value = '暂无正式合拍结果'; return }
		compatibility.value = response.data
	} catch (error) {
		if (isCurrent()) errorMessage.value = '网络连接失败，请稍后重试'
	} finally {
		if (isCurrent()) loading.value = false
	}
}

// 对方 MBTI 缺失时返回空串（展示层隐藏 chip），不伪造类型
const otherType = computed(() : string => {
	const mbti = props.otherMbti
	return mbti != null && mbti.length == 4 ? mbti : ''
})

const handleClose = () => {
	requestSequence++
	compatibility.value = null
	loading.value = false
	emit('close')
}

const onDragStart = (event: any) => {
	if (props.visible != true) return
	const touch = event.touches != null && event.touches.length > 0 ? event.touches[0] : null
	if (touch == null) return
	dragStartY = Number(touch.clientY)
	dragStartHeight = sheetHeight.value
	isDragging.value = true
}

const onDragMove = (event: any) => {
	if (isDragging.value != true) return
	const touch = event.touches != null && event.touches.length > 0 ? event.touches[0] : null
	if (touch == null) return
	const deltaY = dragStartY - Number(touch.clientY)
	const heightPercent = dragStartHeight + (deltaY / windowHeight) * 100
	sheetHeight.value = Math.max(28, Math.min(97, heightPercent))
}

const onDragEnd = () => {
	if (isDragging.value != true) return
	isDragging.value = false
	const current = sheetHeight.value
	if (current < 40) {
		sheetHeight.value = HEIGHT_STOPS[0]
		handleClose()
		return
	}
	let nearest = HEIGHT_STOPS[0]
	for (let i = 1; i < HEIGHT_STOPS.length; i++) {
		if (Math.abs(HEIGHT_STOPS[i] - current) < Math.abs(nearest - current)) nearest = HEIGHT_STOPS[i]
	}
	sheetHeight.value = nearest
}

watch(() => props.visible, (newValue: boolean) => {
	if (newValue) {
		sheetHeight.value = 72
		isDragging.value = false
		loadCompatibility()
	} else {
		requestSequence++
		compatibility.value = null
		loading.value = false
	}
}, { immediate: true })
watch(() => props.targetUserId, () => { if (props.visible) loadCompatibility() })
onUnmounted(() => { requestSequence++ })
</script>

<style scoped>
/* 遮罩层：与 XsaSheet 同源 */
.ai-match-overlay {
	position: fixed;
	z-index: 60;
	inset: 0;
	background: rgba(12, 19, 19, 0.36);
	opacity: 0;
	pointer-events: none;
	transition: opacity 0.22s;
}

.ai-match-overlay.open {
	opacity: 1;
	pointer-events: auto;
}

/* 小窗面板：默认 72% 高度，拖拽中关闭高度过渡 */
.ai-match-sheet {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 72%;
	background: var(--paper);
	border-radius: 24px 24px 0 0;
	transform: translateY(104%);
	transition: transform 0.28s cubic-bezier(0.2, 0.75, 0.25, 1), height 0.26s cubic-bezier(0.2, 0.75, 0.25, 1);
	overflow: hidden;
	display: flex;
	flex-direction: column;
}

.ai-match-overlay.open .ai-match-sheet {
	transform: translateY(0);
}

.ai-match-sheet.dragging {
	transition: transform 0.28s cubic-bezier(0.2, 0.75, 0.25, 1);
}

/* 顶部拖拽区 */
.drag-zone {
	padding-top: 9px;
	flex-shrink: 0;
}

.drag-bar {
	width: 38px;
	height: 4px;
	background: var(--line);
	border-radius: 2px;
	margin: 0 auto 2px;
}

.sheet-head {
	height: 44px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	padding: 0 18px;
}

.sheet-title {
	max-width: calc(100% - 104px);
	font-size: 20px;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
	text-align: center;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.close-btn {
	position: absolute;
	top: 0;
	right: 14px;
	width: 44px;
	height: 44px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 20px;
	color: var(--muted);
}

/* 内容滚动区 */
.sheet-scroll {
	flex: 1;
	min-height: 0;
}

.sheet-content {
	padding: 4px 18px calc(24px + env(safe-area-inset-bottom));
}

/* 头部：头像 × 匹配度 × 头像 */
.pair-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 4px 12px 0;
}

.pair-side {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8px;
}

.pair-avatar {
	width: 62px;
	height: 62px;
	border-radius: 50%;
	background: var(--warm);
	border: 2px solid var(--surface);
	overflow: hidden;
	display: flex;
	align-items: center;
	justify-content: center;
}

.pair-avatar-img {
	width: 62px;
	height: 62px;
}

.pair-avatar-fallback {
	font-size: 18px;
	color: var(--muted);
	font-family: var(--serif);
}

.pair-type-chip {
	padding: 2px 10px;
	border-radius: 999px;
	background: var(--accent-bg);
}

.pair-type-text {
	font-size: 14px;
	font-weight: 700;
	color: var(--accent2);
	letter-spacing: 1px;
}

.pair-center {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2px;
}

.pair-score-label {
	font-size: 13px;
	color: var(--muted);
	letter-spacing: 2px;
}

.pair-score {
	font-size: 46px;
	font-weight: 900;
	color: var(--accent2);
	font-family: var(--serif);
	line-height: 1.1;
}

.pair-headline {
	display: block;
	margin-top: 12px;
	font-size: 15px;
	line-height: 1.7;
	color: var(--ink2);
	text-align: center;
}

/* 分区 */
.section {
	margin-top: 18px;
}

.section-divider {
	margin-top: 18px;
	border-top: 1px solid var(--line);
}

.section-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8px;
	margin-bottom: 12px;
}

.section-mark {
	width: 3px;
	height: 16px;
	border-radius: 2px;
	background: var(--accent);
}

.section-title {
	font-size: 19px;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
}

/* 合适的点：两栏文字块 */
.harmony-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
}

.harmony-item {
	width: 48%;
	display: flex;
	flex-direction: column;
	gap: 4px;
	margin-bottom: 12px;
}

.harmony-title {
	font-size: 16px;
	font-weight: 700;
	color: var(--accent2);
}

.harmony-text {
	font-size: 15px;
	line-height: 1.7;
	color: var(--ink2);
}

/* 可能的摩擦 */
.friction-list {
	display: flex;
	flex-direction: column;
	gap: 14px;
}

.friction-item {
	display: flex;
	flex-direction: column;
	gap: 5px;
}

.friction-title-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 7px;
}

.friction-dot {
	width: 6px;
	height: 6px;
	border-radius: 3px;
	background: var(--heart-red);
}

.friction-title {
	font-size: 16px;
	font-weight: 700;
	color: var(--ink);
}

.friction-line {
	font-size: 15px;
	line-height: 1.7;
	color: var(--ink2);
}

.friction-who {
	font-weight: 700;
	color: var(--accent2);
	margin-right: 4px;
}

/* 社交建议 */
.advice-list {
	display: flex;
	flex-direction: column;
	gap: 14px;
}

.advice-item {
	display: flex;
	flex-direction: column;
	gap: 6px;
}

.advice-title {
	font-size: 16px;
	font-weight: 700;
	color: var(--ink);
	font-family: var(--serif);
}

.advice-points {
	display: flex;
	flex-direction: column;
	gap: 5px;
}

.advice-point {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 7px;
}

.point-dot {
	width: 5px;
	height: 5px;
	border-radius: 2.5px;
	background: var(--soft);
	margin-top: 11px;
	flex-shrink: 0;
}

.point-text {
	flex: 1;
	font-size: 15px;
	line-height: 1.7;
	color: var(--ink2);
}

/* 尚无可展示结果 */
.state-unavailable {
	margin-top: 22px;
	padding: 26px 16px;
	border-radius: 12px;
	background: var(--warm);
	display: flex;
	flex-direction: column;
	align-items: center;
}

.state-unavailable-title {
	font-size: 16px;
	font-weight: 600;
	color: var(--ink);
	margin-bottom: 8px;
}

.state-unavailable-desc {
	font-size: 13px;
	line-height: 1.7;
	color: var(--muted);
	text-align: center;
}

.compatibility-result { margin-top: 22px; }
.compatibility-overall { display: flex; flex-direction: column; gap: 6px; }
.compatibility-overall-label, .compatibility-section-title { font-size: 16px; font-weight: 600; color: var(--ink); }
.compatibility-overall-value { font-size: 26px; color: var(--accent2); }
.compatibility-overall-copy, .compatibility-engine { font-size: 13px; color: var(--muted); }
.compatibility-directions { margin-top: 16px; border-top: 1px solid var(--line); }
.compatibility-direction { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 14px; color: var(--ink2); }
.compatibility-direction text:first-child { flex: 1; }
.compatibility-section { display: flex; flex-direction: column; gap: 8px; margin-top: 18px; }
.compatibility-line { font-size: 14px; line-height: 1.7; color: var(--ink2); }
.compatibility-engine { display: block; margin-top: 18px; }
.compatibility-retry { margin-top: 16px; padding: 8px 16px; color: var(--accent2); font-size: 14px; }

/* 底部提示 */
.sheet-tip {
	margin-top: 18px;
	padding: 10px 12px;
	border-radius: 8px;
	background: var(--warm);
	font-size: 13px;
	line-height: 1.6;
