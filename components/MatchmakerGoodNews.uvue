.gn-detail-floats { position: fixed; z-index: 45; right: 26rpx; bottom: calc(env(safe-area-inset-bottom) + 180rpx); display: flex; flex-direction: column; gap: 18rpx; }.gn-detail-floats > view,.gn-detail-floats > button { width: 100rpx; height: 100rpx; border-radius: 50%; background: var(--surface); box-shadow: var(--match-shadow); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: var(--review-deep); padding: 0; margin: 0; border: 0; line-height: 1.4; font-size: 19rpx; }.gn-detail-floats > button::after { border: 0; }.gn-detail-floats text:first-child { font-size: 38rpx; }.gn-detail-bar { position: fixed; z-index: 48; left: 0; right: 0; bottom: 0; padding: 16rpx 22rpx calc(env(safe-area-inset-bottom) + 18rpx); background: var(--surface); border-top: 1px solid var(--line); display: flex; flex-direction: row; gap: 12rpx; }.gn-detail-bar > view { flex: 1; min-width: 0; padding: 20rpx 0; border-radius: 22rpx; background: var(--review-lilac); color: var(--review-deep); text-align: center; font-size: 25rpx; font-weight: 700; }.gn-detail-bar > view:nth-child(2) { background: var(--match-blush); color: var(--review-danger); }.gn-detail-bar > view:last-child { background: var(--warm); color: var(--ink2); }
.gn-report-options { display: flex; flex-direction: row; justify-content: space-around; padding: 26rpx 10rpx; }.gn-report-options > view { display: flex; flex-direction: column; align-items: center; gap: 20rpx; color: var(--review-deep); font-size: 25rpx; }.gn-report-circle { width: 108rpx; height: 108rpx; border-radius: 50%; background: var(--review-lilac); display: flex; align-items: center; justify-content: center; font-size: 45rpx; }.gn-report-circle.gift { background: var(--match-blush); }.gn-form { padding: 8rpx 6rpx 20rpx; display: flex; flex-direction: column; gap: 18rpx; }.gn-form-tip { display: block; padding: 12rpx 6rpx; color: var(--muted); font-size: 22rpx; line-height: 1.7; }.gn-privacy { padding: 20rpx; border-radius: 20rpx; background: var(--match-sky); color: var(--ink2); font-size: 22rpx; line-height: 1.7; display: flex; flex-direction: column; gap: 10rpx; }.gn-privacy-title { font-weight: 700; color: var(--accent2); font-size: 25rpx; }.gn-field { min-height: 88rpx; border-bottom: 1px solid var(--line); display: flex; flex-direction: row; align-items: center; gap: 16rpx; font-size: 25rpx; }.gn-field > text:first-child { min-width: 140rpx; color: var(--ink2); }.gn-field input { flex: 1; min-width: 0; font-size: 25rpx; text-align: right; color: var(--ink); }.gn-field-choice { flex: 1; min-width: 0; text-align: right; color: var(--ink2); }.gn-textarea { width: 100%; height: 190rpx; padding: 20rpx; box-sizing: border-box; border-radius: 18rpx; background: var(--canvas); color: var(--ink); font-size: 24rpx; line-height: 1.7; }.gn-form-title { font-size: 25rpx; color: var(--ink2); }.gn-form-images { display: flex; flex-direction: row; flex-wrap: wrap; gap: 14rpx; }.gn-form-image,.gn-image-add { width: 138rpx; height: 138rpx; position: relative; }.gn-form-image image { width: 100%; height: 100%; border-radius: 16rpx; }.gn-form-image > text { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; border-radius: 0 16rpx 0 16rpx; background: var(