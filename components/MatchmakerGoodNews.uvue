.gn-pennant-summary { display: flex; flex-direction: row; align-items: center; gap: 16rpx; padding: 30rpx 2rpx 10rpx; }.gn-pennant-icon { width: 176rpx; height: 160rpx; flex-shrink: 0; }.gn-quote { flex: 1; min-width: 0; padding: 12rpx 18rpx; border: 1px solid var(--match-blush); border-radius: 20rpx; color: var(--review-danger); line-height: 1.7; font-size: 27rpx; font-weight: 700; background: var(--match-paper); }.gn-quote > text:first-child { font-size: 40rpx; color: var(--review-pink); }
.gn-state { min-height: 290rpx; padding: 50rpx 24rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; color: var(--muted); font-size: 25rpx; text-align: center; }.gn-empty { background: var(--match-sky); border-radius: 26rpx; margin-top: 18rpx; }.gn-empty-icon { width: 108rpx; height: 108rpx; border-radius: 30rpx; background: var(--surface); display: flex; align-items: center; justify-content: center; color: var(--soft); font-size: 60rpx; }.gn-state-action { padding: 14rpx 28rpx; border-radius: 999rpx; background: var(--accent-bg); color: var(--accent2); font-size: 23rpx; }.gn-more { display: block; padding: 30rpx 20rpx; text-align: center; font-size: 22rpx; color: var(--muted); }
.gn-fab { position: fixed; z-index: 50; right: 24rpx; bottom: calc(env(safe-area-inset-bottom) + 28rpx); width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--surface); box-shadow: var(--match-shadow); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--accent2); font-size: 20rpx; gap: 4rpx; }.gn-fab-icon { font-size: 36rpx; }
.gn-detail { padding: 12rpx 0 125rpx; }.gn-detail-card { background: var(--surface); border-radius: 34rpx; overflow: hidden; }.gn-detail-head { padding: 26rpx 20rpx; display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; gap: 18rpx; background: var(--review-soft); }.gn-received { padding: 10rpx 18rpx; color: var(--review-deep); border-radius: 999rpx; background: var(--review-lilac); font-size: 22rpx; }.gn-detail-body { padding: 24rpx; }.gn-detail-meta { display: flex; flex-direction: row; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 18rpx; margin-bottom: 20rpx; }.gn-duration { padding: 9rpx 18rpx; border-radius: 999rpx; background: var(--review-lilac); color: var(--review-deep); font-size: 23rpx; }.gn-content { display: block; font-size: 30rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-all; margin-bottom: 24rpx; }.gn-detail-images { display: flex; flex-direction: column; gap: 18rpx; }.gn-detail-images image { width: 100%; border-radius: 22rpx; background: var(--warm); }.gn-care { margin-top: 28rpx; padding: 22rpx; border: 1px solid var(--line); border-radius: 22rpx; color: var(--muted); font-size: 22rpx; line-height: 1.7; display: flex; flex-direction: column; gap: 10rpx; }.gn-care-title { color: var(--accent2); font-size: 25rpx; font-weight: 700; }
