.gn-section { padding: 28rpx 6rpx 8rpx; display: flex; flex-direction: row; justify-content: space-between; align-items: center; font-size: 25rpx; font-weight: 700; }.gn-clear { color: var(--accent2); font-size: 22rpx; font-weight: 400; }
