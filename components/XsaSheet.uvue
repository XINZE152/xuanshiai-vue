<template>
	<view class="xsa-sheet-overlay" :class="{ open: visible }" @click="handleOverlayClick">
		<view class="xsa-sheet" :class="[tall ? 'tall' : '', theme == 'atelier' ? 'xsa-sheet-atelier' : '']" @click.stop>
			<view class="handle" v-if="showHandle"></view>
			<view class="sheet-header" v-if="title">
				<text class="sheet-title">{{ title }}</text>
				<view class="close-btn" @click="handleClose">
					<text>✕</text>
				</view>
			</view>
			<view class="sheet-body">
				<slot></slot>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaSheet - 宣誓爱底部滑出面板组件
 * 遵循 DESIGN.md 设计规范
 * theme="atelier": 墨相模块暖纸主题(继承页面 --at-* Token)
 */

interface Props {
	visible: boolean;
	title?: string;
	tall?: boolean;
	closeOnOverlay?: boolean;
	showHandle?: boolean;
	theme?: string;
}

const props = withDefaults(defineProps<Props>(), {
	visible: false,
	tall: false,
	closeOnOverlay: true,
	showHandle: true,
	theme: 'default'
});

const emit = defineEmits<{
	close: []
}>();

const handleClose = () => {
	emit('close');
};

const handleOverlayClick = () => {
	if (props.closeOnOverlay) {
		emit('close');
	}
};
</script>

<style scoped>
/* 遮罩层 - 遵循 DESIGN.md */
.xsa-sheet-overlay {
	position: fixed;
	z-index: 60;
	inset: 0;
	background: rgba(12, 19, 19, 0.36);
	opacity: 0;
	pointer-events: none;
	transition: opacity 0.22s;
}

.xsa-sheet-overlay.open {
	opacity: 1;
	pointer-events: auto;
}

/* Sheet 面板 */
.xsa-sheet {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	max-height: 88%;
	background: var(--paper);
	border-radius: 24px 24px 0 0;
	transform: translateY(104%);
	transition: transform 0.28s cubic-bezier(0.2, 0.75, 0.25, 1);
	overflow: hidden;
}

.xsa-sheet-overlay.open .xsa-sheet {
	transform: translateY(0);
}

.xsa-sheet.tall {
	height: 94%;
	max-height: 94%;
}

/* 顶部把手 */
.handle {
	width: 38px;
	height: 4px;
	background: var(--line);
	border-radius: 2px;
	margin: 9px auto 5px;
}

/* Sheet 头部 */
.sheet-header {
	height: 54px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	padding: 0 18px;
	border-bottom: 1px solid var(--line);
}

.sheet-title {
	max-width: calc(100% - 104px);
	font-size: 19px;
	font-family: var(--serif);
	font-weight: 700;
	color: var(--ink);
	text-align: center;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.close-btn {
	position: absolute;
	top: 5px;
	right: 14px;
	width: 44px;
	height: 44px;
	border-radius: 50%;
	background: transparent;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	font-size: 20px;
	color: var(--muted);
}

/* Sheet 内容区域 */
.sheet-body {
	max-height: calc(100% - 64px);
	overflow-y: auto;
	padding: 16px 18px calc(24px + env(safe-area-inset-bottom));
	-webkit-overflow-scrolling: touch;
}

.sheet-body::-webkit-scrollbar {
	display: none;
}

/* ===== 墨相主题(暖纸):仅在墨相模块内使用,颜色继承页面 --at-* Token ===== */
.xsa-sheet-atelier {
	background: var(--at-card, #FFFCF5);
	border-top: 1px solid var(--at-line, #E6DAC4);
}
.xsa-sheet-atelier .handle { background: var(--at-line, #E6DAC4); }
.xsa-sheet-atelier .sheet-header { border-bottom: 1px solid var(--at-line, #E6DAC4); }
.xsa-sheet-atelier .sheet-title { color: var(--at-ink, #2E2418); }
	.xsa-sheet-atelier .close-btn { color: var(--at-ink2, #5C4F3D); }
</style>
