<template>
		<view class="matchmaker-card" :class="{ 'large-text': largeText }" @click="handleDetail">
		<view class="card-media">
			<MatchmakerAvatar :src="data.avatar" :name="data.name" variant="card" />
		</view>

		<view class="card-body">
			<view class="card-name-row">
				<text class="card-name">{{ data.name }}</text>
			</view>
			<text class="card-copy">{{ cardCopy }}</text>

			<view class="card-tags" v-if="data.tags != null && data.tags.length > 0">
				<view v-for="(tag, index) in data.tags.slice(0, 2)" :key="index" class="card-tag">
					<text>{{ tag }}</text>
				</view>
			</view>

			<view v-if="showMetrics" class="card-meta">
				<view class="meta-item">
					<text class="meta-value">{{ data.successCount }}</text>
					<text class="meta-label">牵线成功</text>
				</view>
				<view class="meta-item">
					<text class="meta-value">{{ data.serviceCount }}</text>
					<text class="meta-label">累计服务</text>
				</view>
			</view>

			<view class="card-footer">
				<view v-if="data.certification || data.badge" class="card-certification">
					<text class="certification-mark">✓</text>
					<text>已认证</text>
				</view>
				<view class="card-button" @click.stop="handleContact">
					<text>{{ actionText }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import MatchmakerAvatar from '@/components/MatchmakerAvatar.uvue';

interface Props {
		data: any;
		actionText?: string;
		showMetrics?: boolean;
		largeText?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
		actionText: '联系她',
		showMetrics: true,
		largeText: false
});

const emit = defineEmits<{
	detail: [item: any];
	contact: [item: any];
}>();

const cardCopy = computed(() => {
	if (props.data == null) return '';
	if (props.data.caseRecord != null && props.data.caseRecord.length > 0) return props.data.caseRecord;
	if (props.data.introduction != null && props.data.introduction.length > 0) return props.data.introduction;
	return props.data.description != null ? props.data.description : '';
});

const handleDetail = () => {
	emit('detail', props.data);
};

const handleContact = () => {
	emit('contact', props.data);
};
</script>

<style scoped>
	.matchmaker-card {
		width: 100%;
		min-width: 0;
		border-radius: 24rpx;
		background: var(--surface);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		border: 1px solid rgba(211, 217, 216, 0.65);
	}

	.card-media {
		position: relative;
		height: 262rpx;
		background: var(--warm);
	}

	.card-body {
		padding: 22rpx 22rpx 24rpx;
		display: flex;
		flex-direction: column;
		gap: 10rpx;
	}

	.card-name-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 12rpx;
	}

	.card-name {
		min-width: 0;
		flex: 1;
		font-size: 36rpx;
		line-height: 1.2;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.card-copy {
		min-height: 64rpx;
		font-size: 22rpx;
		line-height: 1.55;
		color: var(--ink2);
		overflow-wrap: anywhere;
	}

	.card-meta {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12rpx;
		padding: 16rpx 0 4rpx;
		border-top: 1px solid var(--line);
	}

	.meta-item {
		display: flex;
		flex-direction: column;
		gap: 4rpx;
	}

	.meta-value {
		font-size: 30rpx;
		line-height: 1;
		font-weight: 800;
		color: var(--ink);
	}

	.meta-label {
		font-size: 18rpx;
		color: var(--muted);
	}

	.card-tags {
		display: flex;
		flex-direction: row;
		gap: 8rpx;
		flex-wrap: wrap;
	}

	.card-tag {
		min-height: 40rpx;
		padding: 0 10rpx;
		border-radius: 10rpx;
		border: 1px solid var(--line);
		background: var(--surface);
		display: flex;
		align-items: center;
		justify-content: center;
		max-width: 100%;
	}

	.card-tag text {
		font-size: 17rpx;
		line-height: 1.25;
		font-weight: 700;
		color: var(--ink2);
		white-space: nowrap;
	}

	.card-footer {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 12rpx;
		margin-top: 6rpx;
	}

	.card-button {
		height: 56rpx;
		padding: 0 22rpx;
		border-radius: 18rpx;
		background: linear-gradient(135deg, rgba(44, 128, 124, 0.16), rgba(56, 152, 141, 0.24));
		border: 1px solid rgba(44, 128, 124, 0.18);
		color: var(--accent2);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 22rpx;
		font-weight: 800;
	}

	.card-certification {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 4rpx;
		min-height: 32rpx;
		color: var(--muted);
	}

	.card-certification text {
		font-size: 18rpx;
		line-height: 1.25;
		font-weight: 600;
		white-space: nowrap;
	}

	.certification-mark {
		width: 20rpx;
		height: 20rpx;
		border-radius: 50%;
		background: var(--match-mist);
		color: var(--match-deep) !important;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 14rpx !important;
		font-weight: 800 !important;
	}

	.matchmaker-card.large-text {
		border-radius: 18px;
		border-color: var(--line);
		box-shadow: var(--shadow-sm);
	}

	.matchmaker-card.large-text .card-media {
		height: 220px;
	}

	.matchmaker-card.large-text .card-body {
		padding: 18px;
		gap: 10px;
	}

	.matchmaker-card.large-text .card-name {
		font-size: 20px;
		font-family: var(--sans);
		line-height: 1.3;
	}

	.matchmaker-card.large-text .card-copy {
		font-size: 16px;
		min-height: 0;
		line-height: 1.55;
	}

	.matchmaker-card.large-text .card-tag text,
	.matchmaker-card.large-text .meta-label {
		font-size: 14px;
	}

	.matchmaker-card.large-text .meta-value {
		font-size: 16px;
	}

	.matchmaker-card.large-text .card-button {
		min-height: 48px;
		height: auto;
		border-radius: 12px;
		background: var(--accent-bg);
		border-color: var(--accent);
		font-size: 16px;
	}
</style>
