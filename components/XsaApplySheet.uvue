<template>
	<XsaSheet :visible="visible" title="申请认识" :tall="false" @close="handleClose">
		<view class="apply-sheet">
			<text class="lead">对方同意后才能开始聊天。请用具体、尊重的话说明你为什么想认识 TA。</text>
			<view class="meta-row">
				<text class="meta-label">今日剩余免费次数</text>
				<text class="meta-value">{{ remainText }}</text>
			</view>
			<textarea
				class="message-input"
				:value="message"
				@input="onInput"
				placeholder="例如：看到你也喜欢看展，想认真了解一下…"
				maxlength="120"
			></textarea>
			<text class="count">{{ message.length }}/120</text>
			<view class="tips">
				<text class="tip">· 仅需实名认证；学历不作为拦截条件</text>
				<text class="tip">· 未双方同意前不可交换联系方式</text>
				<text class="tip">· 次数用尽可用积分加次，会员权益仅作说明</text>
			</view>
			<view class="actions">
				<button class="btn secondary" @click="handleClose">取消</button>
					<button class="btn primary" :class="{ 'is-disabled': submitting || message.trim().length == 0 }" :disabled="submitting || message.trim().length == 0" @click="handleSubmit">
					{{ submitting ? '提交中…' : '发送申请' }}
				</button>
			</view>
		</view>
	</XsaSheet>
</template>

<script setup lang="uts">
	import XsaSheet from '@/components/XsaSheet.uvue'
	import { applyToMeet, getCommunityQuotas, getMyQuotas } from '@/api'
	import { guardRealName } from '@/utils/realNameGate.uts'

	interface Props {
		visible: boolean
		userId: number
	}

	const props = withDefaults(defineProps<Props>(), {
		visible: false,
		userId: 0
	})

	const emit = defineEmits<{
		close: []
		success: [payload: any]
	}>()

	const message = ref('')
	const submitting = ref(false)
	const remain = ref(2)

	// 余额只用于展示。额度唯一权威口径是 GET /users/me/quotas（后端 A-4 起与真实扣次同源），
	// /community/quotas 仅作降级；两者都不再作为"能不能点提交"的判据——由服务端 429 裁决。
	const loadRemain = async () => {
		try {
			const mine = await getMyQuotas()
			if (mine.success && mine.data != null && mine.data.apply != null) {
				remain.value = mine.data.apply.totalRemaining
				return
			}
		} catch (e) {
			console.error(e)
		}
		try {
			const res = await getCommunityQuotas()
			if (res.success && res.data != null && res.data.applyDaily != null) {
				remain.value = res.data.applyDaily.remain
			}
		} catch (e) {
			console.error(e)
		}
	}

	watch(
		() => props.visible,
		async (v: boolean) => {
			if (v) {
				message.value = ''
				await loadRemain()
			}
		}
	)

	const remainText = computed(() => {
		return remain.value + ' 次'
	})

	const onInput = (e: any) => {
		message.value = e.detail.value
	}

	const handleClose = () => {
		emit('close')
	}

	const handleSubmit = async () => {
		if (submitting.value) return
		const text = message.value.trim()
		if (text.length == 0) {
			uni.showToast({ title: '请填写申请附言', icon: 'none' })
			return
		}
		const ok = await guardRealName('apply')
		if (!ok) return
		// 不再用本地 remain 拦截：额度可能刚被积分加过（extra_remaining 只在 /users/me/quotas 里），
		// 本地判 0 会让「兑换了次数还是点不动」。是否放行交给服务端，429 时按 F-07 引导兑换。
		submitting.value = true
		try {
			const res = await applyToMeet(props.userId, text)
			// 仅 data.success===true 视为成功；409 等为 failRes
			const data = res != null ? res.data : null
			const bizOk =
				res != null && res.success == true && data != null && data.success == true
			if (bizOk) {
				if (data.remain != null) {
					remain.value = data.remain
				}
				// remain==null 禁止本地 remain-1
				const toastTitle =
					data.quotaRefreshFailed == true
						? '申请已发送，额度同步失败请下拉刷新'
						: '申请已发送'
				uni.showToast({ title: toastTitle, icon: data.quotaRefreshFailed == true ? 'none' : 'success' })
				emit('success', data)
				emit('close')
				// 对方未实名：申请照常送达，但其必须实名后才能点「同意 / 拒绝」。
				// 后端 create_application 回包带 target_realname_required。
				if (data.target_realname_required == true || data.targetRealnameRequired == true) {
					uni.showModal({
						title: '申请已发送',
						content: '对方完成实名认证后才能处理你的申请，可先等待对方认证。',
						showCancel: false,
						confirmText: '知道了'
					})
				}
			} else {
				const msg =
					data != null && data.message != null
						? data.message
						: res != null && res.message != null
							? res.message
							: '发送失败，请重试'
				if (data != null && data.remain != null) {
					remain.value = data.remain
				}
				// F-07：按后端业务码分流，而不是所有失败都只弹一句 toast。
				// 403 的 detail 是 {code,message,retryable}，request 层已提成 res.businessCode。
				const httpCode = res != null && res.code != null ? Number(res.code) : 0
				const biz = res != null && res.businessCode != null ? '' + res.businessCode : ''
				if (biz == 'PROFILE_INCOMPLETE') {
					uni.showModal({
						title: '资料未完善',
						content: '对方需要看到完整资料才会回应，先花 1 分钟补齐资料。',
						confirmText: '去完善',
						success: (r) => {
							if (r.confirm) {
								emit('close')
								uni.navigateTo({ url: '/pagesSub/userExtra/user/edit' })
							}
						}
					})
				} else if (biz == 'PHONE_REQUIRED') {
					uni.showModal({
						title: '请先绑定手机号',
						content: '绑定手机号后才能发起认识申请。',
						confirmText: '去绑定',
						success: (r) => {
							if (r.confirm) {
								emit('close')
								uni.navigateTo({ url: '/pagesSub/profileExtra/security' })
							}
						}
					})
				} else if (biz == 'REALNAME_REQUIRED') {
					uni.showModal({
						title: '请先完成实名认证',
						content: '实名认证通过后才能发起认识申请。',
						confirmText: '去认证',
						success: (r) => {
							if (r.confirm) {
								emit('close')
								uni.navigateTo({ url: '/pagesSub/profileExtra/certification?focus=realname' })
							}
						}
					})
				} else if (biz == 'APPLICATION_RESTRICTED') {
					uni.showToast({ title: msg != '' ? msg : '当前账号状态暂不可发起申请', icon: 'none' })
				} else if (httpCode == 409) {
					uni.showModal({
						title: '已有进行中的申请',
						content: msg != '' ? msg : '双方已有进行中的认识申请或匹配，请到消息页查看。',
						showCancel: false,
						confirmText: '知道了',
						success: () => { emit('close') }
					})
				} else if (httpCode == 429) {
					uni.showModal({
						title: '今日次数已用完',
						content: '可用积分兑换「申请认识次数」，兑换后立即生效。',
						confirmText: '去兑换',
						success: (r) => {
							if (r.confirm) {
								emit('close')
								uni.navigateTo({ url: '/pagesSub/profileExtra/my-tasks' })
							}
						}
					})
				} else {
					uni.showToast({ title: msg, icon: 'none' })
				}
			}
		} catch (e) {
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		} finally {
			submitting.value = false
		}
	}
</script>

<style scoped>
	.apply-sheet {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.lead {
		font-size: 13px;
		line-height: 1.6;
		color: var(--muted);
	}

	.meta-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 10px 12px;
		background: var(--soft);
		border-radius: 10px;
	}

	.meta-label {
		font-size: 12px;
		color: var(--muted);
	}

	.meta-value {
		font-size: 13px;
		font-weight: 700;
		color: var(--accent);
	}

	.message-input {
		width: 100%;
		min-height: 96px;
		padding: 12px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 12px;
		font-size: 14px;
		color: var(--ink);
		line-height: 1.55;
	}

	.count {
		align-self: flex-end;
		font-size: 11px;
		color: var(--muted);
	}

	.tips {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.tip {
		font-size: 11px;
		color: var(--muted);
		line-height: 1.5;
	}

	.actions {
		display: flex;
		flex-direction: row;
		gap: 10px;
		margin-top: 6px;
		padding-bottom: 8px;
	}

	.btn {
		flex: 1;
		height: 44px;
		border-radius: 999px;
		font-size: 14px;
		font-weight: 600;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border: none;
	}

	.btn.secondary {
		background: var(--paper);
		color: var(--ink);
		border: 1px solid var(--line);
	}

	.btn.primary {
		background: var(--accent);
		color: var(--text-invert);
	}

	.btn.is-disabled {
		opacity: 0.5;
	}
</style>
