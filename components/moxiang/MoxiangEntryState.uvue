	display: flex;
	flex-direction: column;
	padding: 24px 16px 16px;
}
.mx-entry-hero {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-bottom: 20px;
}
.mx-entry-title {
	font-size: 22px;
	font-weight: 700;
	color: #23201E;
}
.mx-entry-sub {
	font-size: 13px;
	color: #807B75;
	margin-top: 4px;
}
.mx-entry-card {
	background: #FFFFFF;
	border: 1px solid #E5DFD5;
	border-radius: 12px;
	padding: 16px;
	box-shadow: 0 4px 12px rgba(35, 32, 30, 0.04);
}
.mx-entry-card-title {
	font-size: 15px;
	font-weight: 700;
	color: #23201E;
}
.mx-entry-card-body {
	font-size: 13px;
	color: #524C46;
	line-height: 1.6;
	margin-top: 8px;
}
.mx-entry-card-actions {
	display: flex;
	flex-direction: row;
	margin-top: 14px;
	gap: 8px;
}
.mx-entry-btn {
	flex: 1;
	height: 44px;
	border-radius: 8px;
	background: #FFFFFF;
	border: 1px solid #D8D2C7;
	display: flex;
	align-items: center;
	justify-content: center;
}
.mx-entry-btn-primary {
	background: #9C5B42;
	border: none;
}
.mx-entry-btn-text {
	font-size: 13px;
	color: #4A4540;
	font-weight: 600;
}
.mx-entry-btn-text-primary {
	color: #FFFFFF;
}
.mx-entry-meta {
	margin-top: 10px;
}
.mx-entry-meta-label {
	font-size: 11px;
	color: #807B75;
}
.mx-entry-meta-value {
	font-size: 13px;
	color: #23201E;
	font-weight: 600;
	margin-top: 2px;
}
.mx-entry-error {
	margin-top: 14px;
	padding: 10px 12px;
	border-radius: 8px;
	background: #FAF2EE;
	border: 1px solid #E8DCCF;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8px;
}
.mx-entry-error-text {
	flex: 1;
	font-size: 12px;
	color: #9C5B42;
}
.mx-entry-error-btn {
	padding: 6px 12px;
	border-radius: 6px;
	background: #9C5B42;
}
.mx-entry-error-btn-text {
	font-size: 11px;
	color: #FFFFFF;
	font-weight: 700;
}
</style>