	font-size: 14px;
	font-weight: 700;
	color: #23201E;
}
.mx-invite-sub {
	font-size: 12px;
	color: #6C665F;
	margin-top: 4px;
	line-height: 16px;
}
.mx-invite-list {
	margin-top: 10px;
}
.mx-invite-item {
	padding: 8px 0;
	border-top: 1px solid #EFEAE2;
}
.mx-invite-item:first-child {
	border-top: 0;
}
.mx-invite-dim {
	font-size: 11px;
	color: #9C5B42;
	background: #FAF2EE;
	padding: 2px 6px;
	border-radius: 4px;
	font-weight: 600;
}
.mx-invite-content {
	display: block;
	font-size: 13px;
	color: #23201E;
	line-height: 1.55;
	margin-top: 4px;
}
.mx-invite-meta {
	margin-top: 8px;
}
.mx-invite-meta-label {
	font-size: 11px;
	color: #807B75;
}
.mx-invite-actions {
	display: flex;
	flex-direction: row;
	gap: 8px;
	margin-top: 12px;
}
.mx-invite-btn {
	flex: 1;
	height: 44px;
	border-radius: 8px;
	background: #FFFFFF;
	border: 1px solid #D8D2C7;
	display: flex;
	align-items: center;
	justify-content: center;
}
