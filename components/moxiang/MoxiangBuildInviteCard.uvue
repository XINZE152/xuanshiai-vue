<!--
  Phase 1 Contract v1.1 P1-D：墨相师构建邀请卡片
  接受/暂缓必须通过 MasterWS.acceptBuildInvite / snoozeBuildInvite,
  同一 invite 重复接受回放同一结果;失败(BUILD_INVITE_CONFLICT)前不卸载卡片。
-->
<template>
	<view class="mx-invite">
		<view class="mx-invite-head">
			<text class="mx-invite-title">这次聊下来，我记住了这些</text>
			<text class="mx-invite-sub">已经记下 {{ invite.candidateCount }} 条有意思的细节，覆盖 {{ invite.dimensionCount }} 个面向。要不要一起整理成画像？</text>
		</view>
		<view class="mx-invite-list">
			<view v-for="(item, idx) in invite.summaryItems" :key="idx" class="mx-invite-item">
				<text class="mx-invite-dim">{{ dimensionLabel(item.profileDimension) }}</text>
				<text class="mx-invite-content">{{ item.content }}</text>
			</view>
		</view>
		<view class="mx-invite-meta">
			<text class="mx-invite-meta-label">有效轮次 {{ invite.effectiveTurnCount }} · 维度 {{ invite.dimensionCount }} · 候选 {{ invite.candidateCount }}</text>
		</view>
		<view class="mx-invite-actions">
			<view class="mx-invite-btn" @tap="onSnooze">
				<text class="mx-invite-btn-text">稍后再说</text>
			</view>
			<view class="mx-invite-btn mx-invite-btn-primary" @tap="onAccept">
				<text class="mx-invite-btn-text mx-invite-btn-text-primary">现在构建</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import type { ProfileSubject } from '@/api/ai-profile.uts'
import type { JourneyStage } from '@/api/voice-master-ws.uts'
import { dimensionLabel } from '@/utils/moxiang-dimension.uts'

/** 组件层 camelCase 视图(由 master page 适配 WS payload 后传入) */
export interface InviteViewItem {
	profileDimension: string
	content: string
	confidence: number
}
export interface InviteView {
	inviteId: string
	subject: ProfileSubject
	journeyStage: JourneyStage
	candidateCount: number
	dimensionCount: number
	effectiveTurnCount: number
	summaryItems: InviteViewItem[]
}

const props = defineProps<{
	invite: InviteView
	busy?: boolean
}>()

const emit = defineEmits<{
	(e: 'accept', inviteId: string): void
	(e: 'snooze', inviteId: string): void
}>()

function onAccept() {
	if (props.busy == true) return
	emit('accept', props.invite.inviteId)
}
function onSnooze() {
	if (props.busy == true) return
	emit('snooze', props.invite.inviteId)
}
</script>

