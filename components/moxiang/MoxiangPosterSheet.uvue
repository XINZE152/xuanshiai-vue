	}

	.mps-btn-primary {
		flex: 2;
		background: #9C5B42;
		box-shadow: 0 4px 12px rgba(156, 91, 66, 0.25);
	}

	.mps-btn.disabled {
		opacity: 0.6;
	}

	.mps-btn-text {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 700;
	}

	.mps-hint {
		font-size: 11px;
		color: #A39B91;
