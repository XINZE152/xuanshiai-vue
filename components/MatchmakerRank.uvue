<template>
	<view class="rank-wrap">
		<view class="rank-header">
			<view class="rank-heading">
				<text class="rank-title">红娘排行榜</text>
				<text class="rank-subtitle">按已完成服务数量排序</text>
			</view>
			<view class="rank-more" @click="handleMore">
				<text class="rank-more-link">查看更多 ›</text>
			</view>
		</view>

		<!-- 领奖台固定三席，视觉顺序 2-1-3，冠军永远居中；第四名往后不在这张卡里展示 -->
		<view class="rank-podium">
			<view
				class="podium-item"
				:class="slot.tone"
				v-for="slot in podiumSlots"
				:key="slot.rank"
				@click="handleSlotClick(slot)"
			>
				<view class="podium-figure">
					<view v-if="!slot.empty" class="podium-frame">
						<MatchmakerAvatar :src="slot.item.avatar" :name="slot.item.name" :variant="slot.variant" />
					</view>
					<view v-if="!slot.empty" class="podium-badge">
						<text class="podium-badge-text">{{ slot.rank }}</text>
					</view>
				</view>
				<text v-if="!slot.empty" class="podium-name">{{ slot.item.name }}</text>
				<text v-if="!slot.empty" class="podium-meta">服务 {{ slot.item.serviceCount }} 人</text>
				<text v-if="!slot.empty" class="podium-meta">成功 {{ slot.item.successCount }} 约</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import MatchmakerAvatar from '@/components/MatchmakerAvatar.uvue';

interface Props {
	list: any[];
}

interface PodiumSlot {
	rank: number;
	tone: string;
	variant: string;
	empty: boolean;
	item: any;
}

const props = defineProps<Props>();

const emit = defineEmits<{
	'item-click': [item: any];
	more: [];
}>();

const makeSlot = (item: any, rank: number): PodiumSlot => {
	const empty = item == null
	return {
		rank: rank,
		tone: empty ? 'empty' : (rank == 1 ? 'champion' : (rank == 2 ? 'silver' : 'bronze')),
		variant: rank == 1 ? 'rank-lg' : 'rank',
		empty: empty,
		item: item
	}
};

// 名次取自 list 的下标，视图只改排列方式，不重排数据。
const podiumSlots = computed((): PodiumSlot[] => {
	const list = props.list
	return [
		makeSlot(list.length >= 2 ? list[1] : null, 2),
		makeSlot(list.length >= 1 ? list[0] : null, 1),
		makeSlot(list.length >= 3 ? list[2] : null, 3)
	]
});

const handleSlotClick = (slot: PodiumSlot) => {
	if (slot.empty) return
	emit('item-click', slot.item)
};

const handleMore = () => {
	emit('more')
};
</script>

<style scoped>
	.rank-wrap {
		padding: 34rpx 28rpx 38rpx;
		border-radius: 32rpx;
		background: var(--match-paper);
		box-shadow: 0 14rpx 36rpx rgba(88, 74, 56, 0.06);
	}

	/* uni-app x 的 view 默认是 column 方向的 flex，横向排版必须显式声明 row */
	.rank-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 6rpx;
		margin-bottom: 30rpx;
	}

	.rank-heading {
		flex: 1 1 auto;
		min-width: 0;
	}

	.rank-title {
		display: block;
		font-size: 32rpx;
		line-height: 1.2;
		font-family: "Kaiti SC", "PingFang SC", "Microsoft YaHei", sans-serif;
		font-weight: 700;
		color: var(--ink);
	}

	.rank-subtitle {
		display: block;
		margin-top: 8rpx;
		font-size: 20rpx;
		color: var(--muted);
	}

	.rank-more {
		flex: 0 0 auto;
		margin-left: 16rpx;
		padding: 8rpx 0 8rpx 16rpx;
	}

	.rank-more-link {
		font-size: 22rpx;
		font-weight: 800;
		line-height: 1.2;
		color: var(--accent2);
	}

	.rank-podium {
		display: flex;
		flex-direction: row;
		align-items: flex-end;
	}

	/* 三席各占三分之一，等宽不随名字长短变化，冠军因此严格居中 */
	.podium-item {
		flex: 0 0 33.3333%;
		width: 33.3333%;
		min-width: 0;
		text-align: center;
	}

	/* uvue.wxss 给所有 view 加了 overflow:hidden，越出这个盒子的绝对定位子元素会被裁掉，
	   所以盒子高度必须同时装下圆环和徽标 */
	.podium-figure {
		position: relative;
		width: 100%;
		height: 200rpx;
	}

	.podium-frame {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 36rpx;
		margin: 0 auto;
		box-sizing: border-box;
		width: 114rpx;
		height: 114rpx;
		padding: 5rpx;
		border-radius: 50%;
		background: #C9CDD3;
	}

	.podium-item.champion .podium-frame {
		width: 148rpx;
		height: 148rpx;
		padding: 6rpx;
		background: #ECAE3F;
	}

	.podium-item.bronze .podium-frame {
		background: #A9764E;
	}

	/* 名次徽标挂在圆环下沿：只压 4~10rpx，数字整段落在圆环之外，叠放顺序被平台改写也照样看得见 */
	.podium-badge {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 2;
		margin: 0 auto;
		box-sizing: border-box;
		width: 40rpx;
		height: 40rpx;
		border-radius: 50%;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		background: #B0B7C0;
		border: 4rpx solid var(--match-paper);
	}

	.podium-item.champion .podium-badge {
		width: 46rpx;
		height: 46rpx;
		background: #E9A428;
	}

	.podium-item.bronze .podium-badge {
		background: #9F6E4E;
	}

	.podium-badge-text {
		font-size: 22rpx;
		font-weight: 800;
		line-height: 1;
		color: #FFFFFF;
	}

	.podium-item.champion .podium-badge-text {
		font-size: 24rpx;
	}

	.podium-name {
		display: block;
		max-width: 100%;
		margin: 14rpx auto 0;
		font-size: 26rpx;
		line-height: 1.3;
		font-weight: 700;
		color: var(--ink);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.podium-meta {
		display: block;
		max-width: 100%;
		margin: 6rpx auto 0;
		font-size: 20rpx;
		line-height: 1.4;
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
