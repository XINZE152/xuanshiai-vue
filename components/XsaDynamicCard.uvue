<template>
	<view class="xsa-dynamic-card" @click="handleOpen">
		<!-- 用户信息栏 -->
		<view class="card-header" @click.stop="handleUserClick">
			<image class="avatar" :src="dynamic.user.avatar" mode="aspectFill"></image>
<view class="user-info">
					<view class="name-row">
						<view class="name-left">
							<text class="name">{{ dynamic.user.name }}</text>
							<text class="gender-icon text-muted" v-if="genderIcon !== ''">{{ genderIcon }}</text>
						</view>
					</view>
					<view class="meta-row" v-if="metaLine !== ''">
						<text class="meta-text">{{ metaLine }}</text>
					</view>
					<view class="relation-row" v-if="relationList.length > 0">
						<text class="relation-tag" v-for="(rt, ri) in relationList" :key="ri">{{ rt }}</text>
					</view>
					<view class="tag-row" v-if="tagList.length > 0">
						<text class="mini-tag" v-for="(tag, i) in tagList" :key="i">{{ tag }}</text>
					</view>
				</view>
			<button
				v-if="showFollow"
				class="follow-btn"
				:class="{ done: followed }"
				@click.stop="handleFollow"
			>
				{{ followed ? '已关注' : '关注' }}
			</button>
			<view class="more-btn" @click.stop="handleMore">
				<text class="icon">⋯</text>
			</view>
		</view>

		<!-- 动态内容 -->
		<view class="card-body">
			<text class="content-text" v-if="dynamic.content">{{ dynamic.content }}</text>

<view class="photo-grid" :class="gridClass" v-if="dynamic.photos && dynamic.photos.length > 0">
					<image
						class="photo-item"
						:class="gridClass"
						v-for="(photo, index) in dynamic.photos"
						:key="index"
						:src="photo"
						mode="aspectFill"
						@click.stop="handlePhotoClick(index)"
					></image>
				</view>

				<!-- 视频：一期封面/占位，避免纯视频动态在 feed 像空帖 -->
				<view class="video-block" v-else-if="hasVideo" @click.stop="handleVideoClick">
					<video
						v-if="videoSrc !== ''"
						class="video-player"
						:src="videoSrc"
						:controls="true"
						:show-center-play-btn="true"
						object-fit="cover"
						@click.stop
					></video>
					<view v-else class="video-placeholder">
						<text class="video-play-icon">▶</text>
						<text class="video-hint text-muted">视频动态</text>
					</view>
				</view>

				<view class="topic-chip" v-if="dynamic.topicId != null && dynamic.topicId > 0" @click.stop="handleTopic">
					<text class="topic-hash">#</text>
					<text class="topic-label">{{ topicLabel }}</text>
				</view>

				<!-- 点赞摘要：后端返回头像时展示，缺少头像时仍保留数量信息。 -->
				<view class="like-summary" v-if="likeCount > 0" @click.stop="handleLike">
					<view class="like-avatars" v-if="likeAvatarList.length > 0">
						<image
							class="like-avatar"
							v-for="(av, ai) in likeAvatarList"
							:key="ai"
							:src="av"
							mode="aspectFill"
							:style="{ marginLeft: ai == 0 ? '0' : '-8px', zIndex: 10 - ai }"
						></image>
					</view>
					<text class="like-summary-text text-muted">等{{ likeCount }}人赞过</text>
				</view>

			<view class="location-time-row" v-if="dynamic.location || timeText !== ''">
				<view class="location" v-if="dynamic.location">
					<text class="icon">📍</text>
					<text class="text text-muted">{{ dynamic.location }}</text>
				</view>
				<text class="time time-bottom text-muted" v-if="timeText !== ''">{{ timeText }}</text>
			</view>
		</view>

		<!-- 互动栏 -->
		<view class="card-footer" @click.stop>
			<view class="action-item" @click="handleLike">
				<text class="ic ic-social action-icon" :class="{ liked: liked }">{{ likeIcon }}</text>
				<text class="text text-muted" :class="{ liked: liked }" v-if="likeCount > 0">{{ likeCount }}</text>
			</view>
			<view class="action-item" @click="handleComment">
				<text class="ic ic-social action-icon">{{ commentIcon }}</text>
				<text class="text text-muted" v-if="commentCount > 0">{{ commentCount }}</text>
			</view>
			<view class="action-item" @click="handleShare">
				<text class="icon">↗</text>
				<text class="text text-muted">分享</text>
			</view>
			<button
				class="apply-btn"
				:class="{ pending: applyStatus === 'pending', done: applyStatus === 'accepted' }"
				@click="handleApply"
			>
				{{ applyLabel }}
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * XsaDynamicCard - 社区动态卡片
 * 横排布局需显式 flex-direction:row（UniApp view 默认 column）
 */

interface DynamicUser {
			id: number
			avatar: string
			name: string
			age?: number
			city?: string
			height?: string
			job?: string
			education?: string
			verified?: boolean
			realNameStatus?: string
			educationStatus?: string
			gender?: string
			birthYear?: number
			ipLocation?: string
			income?: string
		}
	
		interface Dynamic {
			id: number
			user: DynamicUser
			content?: string
			photos?: string[]
			location?: string
			time?: string
			timeText?: string
			likeCount?: number
			commentCount?: number
			collectCount?: number
			liked?: boolean
			collected?: boolean
			followed?: boolean
			applyStatus?: string
			topicId?: number
			tags?: string[]
			declaration?: string
			cityTag?: boolean
			relationTags?: string[]
			topicTitle?: string
			videos?: string[]
			mediaType?: string
		}

interface Props {
	dynamic: Dynamic
	showFollow?: boolean
}

const props = withDefaults(defineProps<Props>(), {
	showFollow: true
})

const emit = defineEmits<{
	userClick: [userId: number]
	photoClick: [index: number]
	like: [dynamicId: number]
	comment: [dynamicId: number]
	share: [dynamicId: number]
	collect: [dynamicId: number]
	follow: [userId: number]
	unfollow: [userId: number]
	apply: [userId: number]
	more: [dynamicId: number, userId: number]
	topic: [topicId: number]
	open: [dynamicId: number]
}>()

const liked = ref(props.dynamic.liked === true)
const likeCount = ref(props.dynamic.likeCount != null ? props.dynamic.likeCount : 0)
const followed = ref(props.dynamic.followed === true)
const likeIcon = String.fromCharCode(0xec8c)
const commentIcon = String.fromCharCode(0xe679)
const applyStatus = ref(props.dynamic.applyStatus != null ? props.dynamic.applyStatus : 'none')

watch(
	() => props.dynamic,
	(d: Dynamic) => {
		liked.value = d.liked === true
		likeCount.value = d.likeCount != null ? d.likeCount : 0
		followed.value = d.followed === true
		applyStatus.value = d.applyStatus != null ? d.applyStatus : 'none'
	},
	{ deep: true }
)

const timeText = computed((): string => {
	if (props.dynamic.timeText != null && props.dynamic.timeText !== '') return props.dynamic.timeText as string
	if (props.dynamic.time != null) return props.dynamic.time as string
	return ''
})

const commentCount = computed((): number => {
	return props.dynamic.commentCount != null ? props.dynamic.commentCount : 0
})

const genderIcon = computed((): string => {
		const g = props.dynamic.user != null ? props.dynamic.user.gender : null
		if (g == null || g === '') return ''
		const s = ('' + g).toLowerCase()
		if (s == '男' || s == 'male' || s == 'm') return '♂'
		if (s == '女' || s == 'female' || s == 'f') return '♀'
		return ''
	})

	const metaLine = computed((): string => {
		const parts: string[] = []
		const u = props.dynamic.user
		if (u != null) {
			let year: number = 0
			if (u.birthYear != null && (u.birthYear as number) > 1900) {
				year = u.birthYear as number
			} else if (u.age != null && (u.age as number) > 0) {
				year = new Date().getFullYear() - (u.age as number)
			}
			if (year > 0) parts.push(year + '年')
			if (u.ipLocation != null && ('' + u.ipLocation) !== '') {
				parts.push('' + u.ipLocation)
			}
			if (u.income != null && ('' + u.income) !== '') {
				parts.push('' + u.income)
			}
		}
		return parts.join(' · ')
	})

	const relationList = computed((): string[] => {
		const out: string[] = []
		if (props.dynamic.cityTag === true) out.push('同城')
		if (props.dynamic.relationTags != null) {
			const tags = props.dynamic.relationTags as string[]
			for (let i = 0; i < tags.length; i++) {
				const t = tags[i]
				if (t != null && t !== '' && out.indexOf(t) < 0) out.push(t)
			}
		}
		return out
	})

	const topicLabel = computed((): string => {
		if (props.dynamic.topicTitle != null && ('' + props.dynamic.topicTitle) !== '') {
			return '' + props.dynamic.topicTitle
		}
		return '相关话题'
	})

	const hasVideo = computed((): boolean => {
		if (props.dynamic.mediaType == 'video') return true
		if (props.dynamic.videos != null && (props.dynamic.videos as string[]).length > 0) return true
		return false
	})

	const videoSrc = computed((): string => {
		if (props.dynamic.videos == null) return ''
		const list = props.dynamic.videos as string[]
		if (list.length == 0) return ''
		const first = list[0]
		return first != null ? ('' + first) : ''
	})

	const likeAvatarList = computed((): string[] => {
		const raw = props.dynamic.likeAvatars
		if (raw == null || !Array.isArray(raw)) return []
		const out: string[] = []
		for (let i = 0; i < raw.length && out.length < 3; i++) {
			const avatar = raw[i]
			if (avatar != null && ('' + avatar) !== '') out.push('' + avatar)
		}
		return out
	})

	const tagList = computed((): string[] => {
		const out: string[] = []
		const relationSet = relationList.value
		const u = props.dynamic.user
		if (u != null && (u.realNameStatus == 'passed' || u.verified == true)) {
			out.push('已实名')
		}

		// 页面传入的 tags 优先，便于不同场景选择各自最重要的资料标签。
		if (props.dynamic.tags != null) {
			const tags = props.dynamic.tags as string[]
			for (let i = 0; i < tags.length; i++) {
				const t = tags[i]
				if (t == null || t === '') continue
				if (relationSet.indexOf(t) >= 0) continue
				if (out.indexOf(t) < 0) out.push(t)
				if (out.length >= 3) return out
			}
		}

		if (u != null) {
			const profileTags: string[] = []
			if (u.job != null && u.job !== '') profileTags.push(u.job as string)
			if (u.education != null && u.education !== '') profileTags.push(u.education as string)
			if (u.height != null && u.height !== '') profileTags.push(u.height as string)
			for (let i = 0; i < profileTags.length; i++) {
				const tag = profileTags[i]
				if (out.indexOf(tag) < 0) out.push(tag)
				if (out.length >= 3) return out
			}
		}

		if (props.dynamic.declaration != null && props.dynamic.declaration !== '') {
			const declaration = props.dynamic.declaration as string
			if (out.indexOf(declaration) < 0) out.push(declaration)
		}
		if (out.length > 3) return out.slice(0, 3)
		return out
	})

const applyLabel = computed((): string => {
		if (applyStatus.value === 'pending') return '已申请'
		if (applyStatus.value === 'accepted') return '已通过'
		if (applyStatus.value === 'rejected') return '再次申请'
		return '申请认识'
	})

const gridClass = computed(() => {
	const count = props.dynamic.photos != null ? props.dynamic.photos.length : 0
	if (count === 1) return 'single'
	if (count === 2) return 'double'
	if (count === 4) return 'quad'
	return 'grid'
})

const handleUserClick = () => {
	emit('userClick', props.dynamic.user.id)
}

const handlePhotoClick = (index: number) => {
		emit('photoClick', index)
		uni.previewImage({
			current: index,
			urls: props.dynamic.photos != null ? props.dynamic.photos : []
		})
	}

	const handleVideoClick = () => {
		// 进入详情播放；卡片内 video 自带 controls 时本回调较少触发
		emit('open', props.dynamic.id)
	}

const handleLike = () => {
	emit('like', props.dynamic.id)
}

const handleComment = () => {
	emit('comment', props.dynamic.id)
}

const handleShare = () => {
	emit('share', props.dynamic.id)
}

const handleFollow = () => {
	if (followed.value) {
		emit('unfollow', props.dynamic.user.id)
		return
	}
	emit('follow', props.dynamic.user.id)
}

const handleApply = () => {
		if (applyStatus.value === 'pending') {
			uni.showToast({ title: '已申请，等待对方回应', icon: 'none' })
			return
		}
		if (applyStatus.value === 'accepted') {
			uni.showToast({ title: '双方已同意，可在消息中沟通', icon: 'none' })
			return
		}
		// none / rejected 可发起或再次申请
		emit('apply', props.dynamic.user.id)
	}

const handleMore = () => {
	emit('more', props.dynamic.id, props.dynamic.user.id)
}

const handleTopic = () => {
	if (props.dynamic.topicId != null) {
		emit('topic', props.dynamic.topicId)
	}
}

const handleOpen = () => {
	emit('open', props.dynamic.id)
}
</script>

<style scoped>
.xsa-dynamic-card {
	background: var(--surface);
	margin-bottom: 8px;
}

.card-header {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 12px;
	padding: 12px 16px;
}

.avatar {
	width: 40px;
	height: 40px;
	border-radius: 50%;
	flex-shrink: 0;
}

.user-info {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 4px;
	min-width: 0;
}

.name-row {
		display: flex;
		flex-direction: row;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px;
	}

	.name-left {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-width: 0;
	}

	.name {
		font-size: 15px;
		font-weight: 600;
		color: var(--ink);
	}

	.gender-icon {
		font-size: 12px;
		margin-left: 4px;
	}

	.time {
		font-size: 12px;
		flex-shrink: 0;
	}

	.meta-row {
		margin-top: 2px;
	}

	.meta-text {
		font-size: 11px;
		line-height: 1.4;
		color: var(--accent);
	}

	.relation-row {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 4px;
	}

	.relation-tag {
		font-size: 10px;
		color: var(--accent2);
		background: var(--accent-bg);
		padding: 2px 8px;
		border-radius: 999px;
	}

	.tag-row {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 4px;
	}

.mini-tag {
	font-size: 10px;
	padding: 2px 6px;
	border-radius: 4px;
	background: var(--soft);
	color: var(--accent2);
}

.follow-btn {
	height: 28px;
	padding: 0 10px;
	border-radius: 999px;
	border: 1px solid var(--accent);
	background: var(--paper);
	color: var(--accent2);
	font-size: 11px;
	font-weight: 700;
	line-height: 26px;
	flex-shrink: 0;
}

.follow-btn.done {
	border-color: var(--line);
	color: var(--muted);
	background: var(--surface);
}

.more-btn {
	width: 32px;
	height: 32px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.more-btn .icon {
	font-size: 20px;
	color: var(--muted);
}

.card-body {
	padding: 0 16px 12px;
}

.content-text {
	font-size: 15px;
	color: var(--ink);
	line-height: 1.6;
	display: block;
	margin-bottom: 12px;
}

.photo-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 4px;
	margin-bottom: 8px;
}

.photo-item {
	border-radius: 8px;
	overflow: hidden;
}

.photo-item.single {
	max-width: 280px;
	max-height: 280px;
	width: 100%;
}

.photo-item.double {
	width: calc(50% - 2px);
	height: 160px;
}

.photo-item.quad {
	width: calc(50% - 2px);
	height: 160px;
}

.photo-item.grid {
		width: calc(33.33% - 3px);
		height: 110px;
	}

	.video-block {
		margin-bottom: 8px;
		border-radius: 8px;
		overflow: hidden;
		background: var(--soft);
		max-width: 280px;
	}

	.video-player {
		width: 100%;
		height: 200px;
		display: block;
		background: var(--ink);
	}

	.video-placeholder {
		width: 100%;
		height: 160px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	.video-play-icon {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--surface);
		color: var(--accent);
		font-size: 16px;
		line-height: 44px;
		text-align: center;
		border: 1px solid var(--line);
	}

	.video-hint {
		font-size: 12px;
	}

	.topic-chip {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
	align-self: flex-start;
	margin-bottom: 8px;
	padding: 4px 8px;
	border-radius: 6px;
	background: var(--accent-bg);
}

.topic-hash {
	color: var(--accent);
	font-weight: 800;
	font-size: 12px;
}

.topic-label {
	font-size: 12px;
	color: var(--accent2);
	font-weight: 600;
}

.like-summary {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8px;
	padding-top: 4px;
	margin-bottom: 4px;
}

.like-avatars {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-left: 0;
}

.like-avatar {
	width: 22px;
	height: 22px;
	border-radius: 50%;
	border: 2px solid var(--surface);
	background: var(--soft);
}

.like-summary-text {
	font-size: 12px;
}

.location {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
	min-width: 0;
	flex: 1;
}

.location-time-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	min-height: 20px;
}

.location .icon {
	font-size: 13px;
}

.location .text {
	font-size: 13px;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.time-bottom {
	font-size: 12px;
	flex-shrink: 0;
	margin-left: auto;
}

.card-footer {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16px;
	padding: 12px 16px;
	border-top: 1px solid var(--line);
}

.action-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
}

.action-icon {
	font-size: 18px;
	color: var(--muted);
}

.action-icon.liked {
	color: var(--danger);
}

.action-icon.liked {
	animation: heartBeat 0.3s ease;
}

.action-item .text.liked {
	color: var(--accent2);
	font-weight: 700;
}

.action-item .text {
	font-size: 13px;
}

.apply-btn {
	margin-left: auto;
	height: 32px;
	padding: 0 12px;
	border-radius: 999px;
	border: none;
	background: var(--accent);
	color: var(--paper);
	font-size: 12px;
	font-weight: 700;
	line-height: 32px;
}

.apply-btn.pending,
.apply-btn.done {
	background: var(--surface);
	color: var(--muted);
	border: 1px solid var(--line);
}

@keyframes thumbPulse {
	0%,
	100% {
		transform: scale(1);
	}
	50% {
		transform: scale(1.3);
	}
}

@font-face {
	font-family: "iconfont-social";
	src: url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/社区互动与信息/iconfont.woff') format('woff');
}

@font-face {
	font-family: "iconfont-home";
	src: url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff2') format('woff2'), url('/static/婚恋小程序图标/首页推荐与匹配/iconfont.woff') format('woff');
}

.ic {
	font-style: normal;
}

.ic-social {
	font-family: "iconfont-social" !important;
}

.ic-home {
	font-family: "iconfont-home" !important;
}

</style>
