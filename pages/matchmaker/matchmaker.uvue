<template>
	<view class="matchmaker-page">
		<view class="page-shell">
			<view v-if="currentTabValue !== 'ai'" class="page-head">
				<image class="page-head-art" src="/static/generated/matchmaker-hero-calligraphy.webp" mode="aspectFill"></image>
				<text class="page-kicker">牵线</text>
				<text class="page-desc">服务红娘负责匹配推进，私人定制负责长期陪跑，AI 红娘负责梳理线索与破冰建议。</text>
			</view>

			<view v-if="currentTabValue !== 'ai'" class="page-tabs">
				<view class="matchmaker-tab-bar">
					<view
						v-for="(tab, index) in tabs"
						:key="tab"
						class="matchmaker-tab"
						:class="{ active: currentTabIndex === index }"
						@click="handleTabChange(index)"
					>
						<text>{{ tab }}</text>
					</view>
				</view>
			</view>

			<scroll-view class="page-scroller" scroll-y enhanced :show-scrollbar="false">
				<view class="page-content" :class="{ 'service-page-content': currentTabValue === 'service', 'ai-page-content': currentTabValue === 'ai' }">
					<view class="error-card" v-if="loadError.length > 0">
						<text class="error-title">部分内容加载失败</text>
						<text class="error-desc">{{ loadError }}</text>
						<view class="error-button" @click="reloadPage">
							<text>重新加载</text>
						</view>
					</view>

					<view v-if="currentTabValue === 'service'" class="tab-panel">
						<LiveMatchmakingPanel />
						<view class="service-showcase">
							<view class="section-header service-showcase-header">
								<view>
									<text class="section-title">服务红娘</text>
									<text class="section-desc">专业顾问会先理解你的关系目标，再决定如何帮你更稳地认识一个人。</text>
								</view>
							</view>

							<view v-if="serviceMatchmakers.length === 0 && !pageLoading" class="service-empty">
								<XsaEmpty
									text="暂无服务红娘"
									description="稍后再来看看，我们正在整理最新排期。"
									size="small"
								/>
							</view>

							<scroll-view v-else scroll-x enhanced :enable-flex="true" :show-scrollbar="false" class="service-card-scroll">
								<view class="service-card-list" :style="'width: ' + serviceCardListWidth + 'rpx;'">
									<view v-for="item in serviceMatchmakers" :key="item.id" class="service-card-item">
										<MatchmakerCard
											:data="item"
											actionText="联系她"
											@detail="handleMatchmakerDetail"
											@contact="handleMatchmakerContact"
										/>
									</view>
								</view>
							</scroll-view>
						</view>

						<MatchmakerRank v-if="rankList.length > 0" :list="rankList" @item-click="handleMatchmakerDetail" />
					<view class="join-entry-row">
						<view class="join-entry" @click="handleBecomeMatchmaker">
							<view class="join-entry-icon"><text>缘</text></view>
							<text class="join-entry-label">我要做红娘</text>
						</view>
						<view class="join-entry" @click="handleBecomePartner">
							<view class="join-entry-icon partner"><text>伴</text></view>
							<text class="join-entry-label">申请合伙人</text>
						</view>
						<view class="join-entry" @click="handleBecomePromoter">
							<view class="join-entry-icon promoter"><text>推</text></view>
							<text class="join-entry-label">推广红娘</text>
						</view>
					</view>

						<view class="notice-card">
							<text class="notice-title">服务说明</text>
							<text class="notice-text">红娘只帮助你梳理资料、匹配对象与安排节奏，不替双方自动同意，也不会承诺关系结果。</text>
						</view>
					</view>

					<view v-if="currentTabValue === 'custom'" class="tab-panel">
						<view class="custom-home-hero">
							<image class="custom-home-hero-art" src="/static/generated/matchmaker-custom-calligraphy.webp" mode="aspectFill"></image>
							<view class="custom-home-copy">
								<text class="custom-home-kicker">私人定制服务</text>
								<text class="custom-home-title">专属红娘，认真陪你靠近</text>
								<text class="custom-home-desc">从需求梳理、候选筛选到见面反馈，全程跟进每一个关键节点。</text>
							</view>
						</view>

						<view class="section-header">
							<view><text class="section-title">服务套餐</text><text class="section-desc">选择适合自己的服务节奏</text></view>
						</view>

						<XsaEmpty v-if="customPlans.length === 0 && !pageLoading" text="暂无定制方案" description="方案内容整理中。" size="small" />
						<scroll-view
							v-if="customPlans.length > 0"
							scroll-x
							enhanced
							:enable-flex="true"
							class="custom-home-plan-scroll"
							:show-scrollbar="false"
						>
							<view class="custom-home-plan-list" :style="'width: ' + customPlanListWidth + 'rpx;'">
								<view v-for="item in customPlans" :key="item.id" class="custom-home-plan" :class="{ selected: selectedCustomPlanId === item.id }" @click="selectCustomPlan(item)">
									<view v-if="selectedCustomPlanId === item.id" class="custom-home-plan-selected-badge"><text>已选</text></view>
									<view class="custom-home-plan-title-row">
										<text class="custom-home-plan-name">{{ item.name }}</text>
										<text v-if="item.tag" class="custom-home-plan-recommend"><text>{{ item.tag }}</text></text>
									</view>
									<view class="custom-home-plan-price"><text>¥{{ item.price }}</text></view>
									<text class="custom-home-plan-duration">{{ item.duration }}</text>
									<text class="custom-home-plan-feature">{{ item.features[0] }}</text>
									<text class="custom-home-plan-copy">{{ item.description }}</text>
								</view>
							</view>
						</scroll-view>

					<view v-if="currentTabValue === 'custom'" class="join-entry-row">
						<view class="join-entry" @click="handleBecomeMatchmaker">
							<view class="join-entry-icon"><text>缘</text></view>
							<text class="join-entry-label">我要做红娘</text>
						</view>
						<view class="join-entry" @click="handleBecomePartner">
							<view class="join-entry-icon partner"><text>伴</text></view>
							<text class="join-entry-label">申请合伙人</text>
						</view>
						<view class="join-entry" @click="handleBecomePromoter">
							<view class="join-entry-icon promoter"><text>推</text></view>
							<text class="join-entry-label">推广红娘</text>
						</view>
					</view>

					</view>

					<view v-if="currentTabValue === 'ai'" class="ai-chat-page">
						<view class="ai-chat-nav">
							<view class="ai-back" @click="leaveAiChat"><view class="ai-back-chevron"></view></view>
							<text class="ai-nav-title">AI 红娘</text>
							<text class="ai-clear" @click="clearAiMessages">清除记录</text>
						</view>

						<view class="ai-profile-card">
							<image class="ai-profile-avatar" src="/static/portraits/profile-woman-main.webp" mode="aspectFill"></image>
							<view class="ai-profile-copy">
								<text class="ai-profile-name">小缘助手</text>
								<text class="ai-profile-subtitle">关系沟通助手</text>
							</view>
							<view class="ai-online"><view class="ai-online-dot"></view><text>在线</text></view>
						</view>

						<view class="ai-message-list">
							<view v-for="item in aiMessages" :key="item.id" class="ai-message" :class="item.role">
								<text>{{ item.text }}</text>
							</view>
						</view>

						<view class="quick-question-panel">
							<view class="quick-question-title"><view></view><text>快捷问题</text><view></view></view>
							<view class="quick-question-grid">
								<view v-for="item in aiQuickQuestions" :key="item" class="quick-question" @click="askAiQuestion(item)"><text>{{ item }}</text></view>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<view v-if="currentTabValue === 'custom'" class="custom-apply-safe">
			<view class="custom-apply-button" @click="applyCustomPlan">
				<text>立即申请私人定制</text>
			</view>
		</view>

		<view v-if="currentTabValue === 'ai'" class="ai-input-safe">
			<view class="ai-input-bar">
				<input class="ai-chat-input" :value="aiInput" placeholder="请输入你的问题" confirm-type="send" @input="onAiInput" @confirm="sendAiMessage" />
				<view class="ai-send-button" @click="sendAiMessage"><text>发送</text></view>
			</view>
		</view>
	</view>

	<!-- 自定义底部导航栏 -->
	<XsaTabBar />
</template>


<script setup lang="uts">
import XsaTabBar from '@/components/XsaTabBar.uvue'
import LiveMatchmakingPanel from '@/components/LiveMatchmakingPanel.uvue'
	import XsaEmpty from '@/components/XsaEmpty.uvue'
	import MatchmakerCard from '@/components/MatchmakerCard.uvue'
	import MatchmakerRank from '@/components/MatchmakerRank.uvue'
	import {
		getServiceMatchmakers,
		getVolunteerMatchmakers,
		getCustomPlans
	} from '@/api'

	const tabs = ['服务红娘', '私人定制', 'AI红娘']
	const tabValues = ['service', 'custom', 'ai']
	const customHomeValues = [
		{ mark: '准', title: '精准匹配', copy: '根据关系期待筛选候选对象。' },
		{ mark: '专', title: '专属服务', copy: '一位红娘持续跟进反馈。' },
		{ mark: '密', title: '隐私保护', copy: '资料只在必要范围内展示。' }
	]
	const customHomeServices = [
		{ title: '无需注册曝光', copy: '服务期间减少无关曝光。' },
		{ title: '深度了解会员', copy: '梳理目标、方式与边界。' },
		{ title: '开放隐藏会员', copy: '匹配更合适的隐藏资料。' },
		{ title: '红娘精准推荐', copy: '结合资料和反馈推荐。' },
		{ title: '个人形象指导', copy: '优化介绍、沟通与见面状态。' },
		{ title: '安排线下见面', copy: '协助沟通首次见面安排。' },
		{ title: '反馈约见结果', copy: '复盘感受并调整方向。' }
	]
	const customHomeSteps = [
		{ title: '提交申请', copy: '填写期待' },
		{ title: '红娘联系', copy: '确认需求' },
		{ title: '需求分析', copy: '梳理方向' },
		{ title: '精准匹配', copy: '推荐对象' },
		{ title: '安排见面', copy: '双方沟通' },
		{ title: '持续跟进', copy: '反馈复盘' }
	]
	const aiQuickQuestions = [
		'如何提高相亲成功率',
		'怎么写自我介绍',
		'第一次约会注意什么',
		'帮我分析择偶需求'
	]

	const currentTabIndex = ref(0)
	const pageLoading = ref(false)
	const loadError = ref('')
	const aiInput = ref('')
	const aiMessages = ref<any[]>([
		{ id: 1, role: 'assistant', text: '你好，我是你的 AI 红娘。可以告诉我你的择偶需求吗？' },
		{ id: 2, role: 'user', text: '我希望对方性格开朗，有稳定职业。' }
	])
	const nextAiMessageId = ref(3)

	const serviceMatchmakers = ref<any[]>([])
	const rankList = ref<any[]>([])
	const customPlans = ref<any[]>([])
	const selectedCustomPlanId = ref(0)

	const currentTabValue = computed(() => {
		return tabValues[currentTabIndex.value]
	})

	const serviceCardListWidth = computed((): number => {
		const count = serviceMatchmakers.value.length
		if (count == 0) return 0
		return count * 278 + (count - 1) * 16 + 52
	})

	const customPlanListWidth = computed((): number => {
		const count = customPlans.value.length
		if (count == 0) return 0
		if (count == 1) return 300
		return count * 300 + (count - 1) * 14 + 32
	})

	onMounted(() => {
		reloadPage()
	})

	const handleTabChange = (index : number) => {
		if (tabValues[index] === 'custom') {
			uni.navigateTo({
				url: '/pagesSub/matchmaker/custom'
			})
			return
		}
		currentTabIndex.value = index
	}

	const reloadPage = async () => {
		pageLoading.value = true
		loadError.value = ''
		try {
			await Promise.all([
				loadServiceMatchmakers(),
				loadMatchmakerRanking(),
				loadCustomContent()
			])
		} catch (e) {
			loadError.value = '页面已展示可用内容，但有少量模块暂时未加载完整。'
		} finally {
			pageLoading.value = false
		}
	}

	const loadServiceMatchmakers = async () => {
		try {
			const res = await getServiceMatchmakers()
			if (res.success && res.data != null) {
				serviceMatchmakers.value = res.data as any[]
			} else if (loadError.value.length == 0) {
				loadError.value = '网络连接不可用，请检查网络后重新加载。'
			}
		} catch (e) {
			if (loadError.value.length == 0) {
				loadError.value = '服务红娘数据加载失败。'
			}
		}
	}

	const loadMatchmakerRanking = async () => {
		try {
			const res = await getVolunteerMatchmakers()
			if (res.success && res.data != null) {
				rankList.value = res.data as any[]
			} else if (loadError.value.length == 0) {
				loadError.value = '红娘排行榜加载失败，请稍后重试。'
			}
		} catch (e) {
			if (loadError.value.length == 0) {
				loadError.value = '红娘排行榜加载失败，请稍后重试。'
			}
		}
	}

	const loadCustomContent = async () => {
		try {
			const planRes = await getCustomPlans()
			if (planRes.success && planRes.data != null) {
				customPlans.value = planRes.data as any[]
			} else if (loadError.value.length == 0) {
				loadError.value = '网络连接不可用，请检查网络后重新加载。'
			}
		} catch (e) {
			if (loadError.value.length == 0) {
				loadError.value = '私人定制内容加载失败。'
			}
		}
	}

	const handleMatchmakerDetail = (item : any) => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/detail?id=' + item.id
		})
	}

	const handleMatchmakerContact = (item : any) => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/detail?id=' + item.id
		})
	}

	const handleSelectPlan = (item : any) => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/custom?id=' + item.id
		})
	}

	const goCustomPlans = () => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/custom'
		})
	}

	const selectCustomPlan = (item : any) => {
		selectedCustomPlanId.value = item.id
	}

	const applyCustomPlan = () => {
		const plan = customPlans.value.find((p: any) => p.id == selectedCustomPlanId.value)
		if (plan == null) {
			uni.showToast({ title: '请先选择服务套餐', icon: 'none' })
			return
		}
		const name = plan.name
		uni.navigateTo({
			url: '/pagesSub/matchmaker/apply?type=custom&matchmakerName=' + encodeURIComponent(name)
				+ '&planId=' + plan.id
				+ '&planName=' + encodeURIComponent(name)
				+ '&planPrice=' + plan.price
				+ '&planDuration=' + encodeURIComponent(plan.duration)
		})
	}

	const showCustomHomeDetail = (item : any) => {
		uni.showModal({ title: item.title, content: item.copy, showCancel: false, confirmText: '知道了' })
	}

	const handleBecomeMatchmaker = () => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/become-matchmaker'
		})
	}

	const handleBecomePartner = () => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/become-partner'
		})
	}

	const handleBecomePromoter = () => {
		uni.navigateTo({
			url: '/pagesSub/matchmaker/become-promoter'
		})
	}

	const applyCustomService = () => {
		applyCustomPlan()
	}

	const onAiInput = (event: any) => {
		aiInput.value = event.detail.value
	}

	const sendAiMessage = () => {
		const text = aiInput.value.trim()
		if (text.length == 0) return
		aiMessages.value.push({ id: nextAiMessageId.value, role: 'user', text: text })
		nextAiMessageId.value = nextAiMessageId.value + 1
		aiInput.value = ''
		aiMessages.value.push({ id: nextAiMessageId.value, role: 'assistant', text: '我先帮你把这个问题拆成可以观察和沟通的具体线索，再一起看看下一步怎么做。' })
		nextAiMessageId.value = nextAiMessageId.value + 1
	}

	const askAiQuestion = (question: string) => {
		aiInput.value = question
		sendAiMessage()
	}

	const clearAiMessages = () => {
		aiMessages.value = [{ id: 1, role: 'assistant', text: '你好，我是你的 AI 红娘。可以告诉我你的择偶需求吗？' }]
		nextAiMessageId.value = 2
	}

	const leaveAiChat = () => {
		currentTabIndex.value = 0
	}
</script>

<style scoped>
	.matchmaker-page {
		height: 100vh;
		/* 对齐首页的浅薄荷绿主题。 */
		background: #FAF8F5;
		--canvas: #FAF8F5;
		--paper: #FFFFFF;
		--surface: #FFFFFF;
		--ink: #1A1A1A;
		--ink2: #5A6B5C;
		--muted: #A0B0A2;
		--line: #E8EDE6;
		--accent: #7EC8A0;
		--accent2: #5BAF80;
		--soft: #A0B0A2;
		--accent-bg: #E8F5EE;
		--accent-glow: rgba(126, 200, 160, 0.16);
		--text-invert: #FFFFFF;
		--warm: #F5F9F2;
		--brown: #5BAF80;
		--sage: #7EC8A0;
		--sage-soft: #E8F5EE;
		--match-paper: #FFFFFF;
		--match-mist: #F5F9F2;
		--match-sky: #E8F5EE;
		--match-blush: #FFF0F0;
		--match-deep: #1A1A1A;
		--match-coral: #F08282;
		--match-line: #E8EDE6;
		--match-shadow: 0 12px 28px rgba(91, 175, 128, 0.10);
		--navy: #2D4A3E;
	}

	.page-shell {
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.page-head {
		margin: 20rpx 28rpx 0;
		padding: 0 30rpx 54rpx;
		display: flex;
		flex-direction: column;
		gap: 12rpx;
		border: 1px solid var(--match-line);
		border-radius: 24rpx;
		background: var(--match-paper);
		box-shadow: 0 10rpx 24rpx rgba(91, 175, 128, 0.08);
	}

	.page-head-art {
		width: calc(100% + 60rpx);
		height: 250rpx;
		margin-left: -30rpx;
		margin-bottom: 8rpx;
		border-radius: 24rpx 24rpx 0 0;
	}

	.page-kicker {
		font-size: 20rpx;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--accent2);
	}

	.page-title {
		font-size: 42rpx;
		line-height: 1.3;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
	}

	.page-desc {
		font-size: 21rpx;
		line-height: 1.55;
		color: var(--muted);
	}

	.page-tabs {
		position: relative;
		z-index: 2;
		margin-top: -38rpx;
		padding: 0 46rpx 18rpx;
	}

	.matchmaker-tab-bar {
		width: 100%;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 6rpx;
		padding: 7rpx;
		border-radius: 999rpx;
		background: var(--surface);
		box-shadow: 0 8rpx 20rpx rgba(91, 175, 128, 0.12);
		border: 1px solid var(--match-line);
	}

	.matchmaker-tab {
		position: relative;
		flex: 1;
		width: 33.3333%;
		min-width: 0;
		flex-shrink: 1;
		height: 64rpx;
		border-radius: 999rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 22rpx;
		font-weight: 700;
		color: var(--muted);
	}

	.matchmaker-tab.active {
		background: var(--accent-bg);
		color: var(--accent2);
	}

	.page-scroller {
		flex: 1;
		height: 0;
	}

	.page-content {
		padding: 8rpx 28rpx 188rpx;
		display: flex;
		flex-direction: column;
		gap: 24rpx;
	}

	.service-page-content {
		padding-bottom: calc(env(safe-area-inset-bottom) + 144rpx);
	}

	.ai-page-content {
		padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 144rpx);
	}

	.error-card {
		padding: 24rpx;
		border-radius: 20rpx;
		background: rgba(194, 224, 207, 0.56);
		display: flex;
		flex-direction: column;
		gap: 10rpx;
	}

	.error-title {
		font-size: 28rpx;
		font-weight: 800;
		color: var(--ink);
	}

	.error-desc {
		font-size: 22rpx;
		line-height: 1.55;
		color: var(--ink2);
	}

	.error-button {
		margin-top: 4rpx;
		align-self: flex-start;
		height: 56rpx;
		padding: 0 18rpx;
		border-radius: 16rpx;
		background: var(--surface);
		display: flex;
		align-items: center;
		font-size: 20rpx;
		font-weight: 800;
		color: var(--accent2);
	}

	.summary-card {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12rpx;
	}

	.summary-item {
		padding: 18rpx 16rpx;
		border-radius: 20rpx;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
		gap: 8rpx;
		min-height: 120rpx;
		justify-content: center;
	}

	.summary-value {
		font-size: 30rpx;
		line-height: 1.2;
		font-weight: 800;
		color: var(--ink);
	}

	.summary-label {
		font-size: 18rpx;
		line-height: 1.45;
		color: var(--muted);
	}

	.tab-panel {
		display: flex;
		flex-direction: column;
		gap: 20rpx;
	}

	.custom-home-hero {
		min-height: 0;
		padding: 0;
		border-radius: 20rpx;
		background: var(--paper);
		border: 1px solid var(--line);
		box-shadow: var(--shadow-sm);
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.custom-home-hero-art {
		width: 100%;
		height: 220rpx;
		flex-shrink: 0;
		border-radius: 20rpx 20rpx 0 0;
	}

	.custom-home-copy {
		position: relative;
		z-index: 1;
		width: auto;
		padding: 22rpx 28rpx 28rpx;
		display: flex;
		flex-direction: column;
		gap: 12rpx;
	}

	.custom-home-kicker { font-size: 20rpx; font-weight: 800; letter-spacing: .08em; color: var(--accent2); }
	.custom-home-title { font-size: 40rpx; line-height: 1.3; font-family: var(--serif); font-weight: 700; color: var(--ink); }
	.custom-home-desc { font-size: 22rpx; line-height: 1.6; color: var(--muted); }
	.custom-home-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
	.custom-home-value { min-height: 188rpx; padding: 18rpx 14rpx; border-radius: 16rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 10rpx; }
	.custom-home-mark { width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--accent-bg); color: var(--accent2); display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; }
	.custom-home-value-title { font-size: 24rpx; font-weight: 800; color: var(--ink); }.custom-home-value-copy { font-size: 18rpx; line-height: 1.5; color: var(--muted); }
	.custom-home-services { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.custom-home-service { min-height: 144rpx; padding: 18rpx; border-radius: 16rpx; background: var(--surface); box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 7rpx; }.custom-home-service-index { font-size: 18rpx; color: var(--accent2); font-weight: 800; }.custom-home-service-title { font-size: 25rpx; font-weight: 800; color: var(--ink); }.custom-home-service-copy { font-size: 19rpx; line-height: 1.45; color: var(--muted); }
	.custom-home-process-scroll, .custom-home-plan-scroll { width: 100%; margin: 0 -32rpx; padding: 0 32rpx; }.custom-home-process-list, .custom-home-plan-list { display: flex; flex-direction: row; flex-wrap: nowrap; align-items: flex-start; gap: 14rpx; }.custom-home-process { width: 128rpx; flex-shrink: 0; display: flex; flex-direction: column; gap: 8rpx; }.custom-home-process-mark { width: 50rpx; height: 50rpx; border-radius: 50%; background: var(--accent); color: var(--paper); display: flex; align-items: center; justify-content: center; font-size: 18rpx; font-weight: 800; }.custom-home-process-title { font-size: 23rpx; font-weight: 800; color: var(--ink); }.custom-home-process-copy { font-size: 18rpx; color: var(--muted); }
	.custom-home-plan-list { box-sizing: border-box; }
	.custom-home-plan { position: relative; width: 300rpx; min-height: 220rpx; flex-shrink: 0; padding: 22rpx; border-radius: 16rpx; background: var(--surface); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 9rpx; box-sizing: border-box; transition: 0.2s; }.custom-home-plan.selected { border-color: var(--accent); background: linear-gradient(145deg, var(--paper) 0%, var(--match-mist) 100%); box-shadow: var(--match-shadow); transform: translateY(-3rpx); }.custom-home-plan-title-row { display: flex; flex-direction: row; align-items: center; gap: 8rpx; min-height: 34rpx; padding-right: 46rpx; }.custom-home-plan-name { font-size: 28rpx; font-family: var(--serif); font-weight: 700; color: var(--ink); white-space: nowrap; }.custom-home-plan-recommend { padding: 3rpx 8rpx; border: 1px solid var(--accent-bg); border-radius: 999rpx; background: var(--match-mist); color: var(--accent2); font-size: 16rpx; font-weight: 800; line-height: 1.25; white-space: nowrap; }.custom-home-plan-selected-badge { position: absolute; top: 12rpx; right: 12rpx; padding: 6rpx 11rpx; border-radius: 999rpx; background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 100%); box-shadow: var(--shadow-sm); color: var(--paper); font-size: 17rpx; font-weight: 800; line-height: 1.2; }.custom-home-plan-price { font-size: 40rpx; color: var(--brown); font-weight: 800; }.custom-home-plan.selected .custom-home-plan-price { color: var(--accent2); }.custom-home-plan-duration { font-size: 18rpx; color: var(--muted); }.custom-home-plan-feature { font-size: 21rpx; color: var(--accent2); font-weight: 800; }.custom-home-plan-copy { font-size: 18rpx; line-height: 1.45; color: var(--muted); }

	.plan-entry-card {
		padding: 28rpx;
		border-radius: 20rpx;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--line);
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 18rpx;
	}

	.plan-entry-left {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 8rpx;
		min-width: 0;
	}

	.plan-entry-title {
		font-size: 30rpx;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
	}

	.plan-entry-desc {
		font-size: 22rpx;
		line-height: 1.5;
		color: var(--muted);
	}

	.plan-entry-arrow {
		width: 52rpx;
		height: 52rpx;
		border-radius: 50%;
		background: var(--accent-bg);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.plan-entry-arrow text {
		font-size: 36rpx;
		font-weight: 700;
		color: var(--accent2);
	}

	.section-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20rpx;
	}

	.section-header.compact {
		margin-top: -4rpx;
	}

	.section-title {
		display: block;
		font-size: 34rpx;
		line-height: 1.2;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--match-deep);
	}

	.section-desc {
		display: block;
		margin-top: 8rpx;
		font-size: 20rpx;
		line-height: 1.55;
		color: var(--muted);
	}

	.section-link {
		flex-shrink: 0;
		font-size: 22rpx;
		font-weight: 800;
		color: var(--match-coral);
	}

	.service-showcase {
		padding: 26rpx 0 24rpx;
		border-radius: 24rpx;
		background: var(--match-paper);
		border: 1px solid var(--match-line);
		box-shadow: 0 8rpx 22rpx rgba(91, 175, 128, 0.07);
		overflow: hidden;
	}

	.service-showcase-header {
		padding: 0 26rpx 20rpx;
	}

	.service-empty {
		padding: 12rpx 26rpx 4rpx;
	}

	.service-card-scroll {
		width: 100%;
		padding: 0 26rpx;
		box-sizing: border-box;
	}

	.service-card-list {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: flex-start;
		gap: 16rpx;
		padding-right: 26rpx;
		box-sizing: border-box;
	}

	.service-card-item {
		width: 278rpx;
		flex-shrink: 0;
	}

	.notice-card {
		padding: 26rpx;
		border-radius: 24rpx;
		background: var(--accent-bg);
		box-shadow: none;
		border: 1px solid #D6EBDD;
		display: flex;
		flex-direction: column;
		gap: 10rpx;
	}

	.notice-title {
		font-size: 27rpx;
		font-weight: 800;
		color: var(--match-deep);
	}

	.notice-text {
		font-size: 21rpx;
		line-height: 1.6;
		color: var(--ink2);
	}

	.feature-card {
		padding: 30rpx 28rpx;
		border-radius: 24rpx 36rpx 24rpx 24rpx;
		background: var(--navy);
		color: var(--paper);
		display: flex;
		flex-direction: column;
		gap: 12rpx;
		box-shadow: var(--shadow-md);
	}

	.feature-kicker {
		font-size: 20rpx;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: var(--soft);
	}

	.feature-title {
		font-size: 38rpx;
		line-height: 1.35;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--paper);
	}

	.feature-desc {
		font-size: 22rpx;
		line-height: 1.65;
		color: rgba(250, 252, 252, 0.78);
	}

	.plan-list {
		display: flex;
		flex-direction: column;
		gap: 18rpx;
	}

	.ai-hero {
		padding: 30rpx 28rpx;
		border-radius: 24rpx;
		background: linear-gradient(180deg, rgba(24, 65, 93, 0.96), rgba(24, 65, 93, 0.88));
		box-shadow: var(--shadow-md);
		display: flex;
		flex-direction: column;
		gap: 14rpx;
	}

	.ai-badge {
		align-self: flex-start;
		height: 42rpx;
		padding: 0 14rpx;
		border-radius: 999rpx;
		background: rgba(121, 177, 169, 0.22);
		color: var(--paper);
		display: flex;
		align-items: center;
		font-size: 18rpx;
		font-weight: 800;
	}

	.ai-title {
		font-size: 38rpx;
		line-height: 1.36;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--paper);
	}

	.ai-desc {
		font-size: 22rpx;
		line-height: 1.65;
		color: rgba(250, 252, 252, 0.76);
	}

	.ai-flow {
		display: flex;
		flex-direction: column;
		gap: 12rpx;
		margin-top: 6rpx;
	}

	.ai-flow-item {
		display: flex;
		align-items: flex-start;
		gap: 12rpx;
	}

	.flow-index {
		width: 44rpx;
		height: 44rpx;
		border-radius: 50%;
		background: rgba(250, 252, 252, 0.14);
		color: var(--paper);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 18rpx;
		font-weight: 800;
		flex-shrink: 0;
	}

	.flow-copy {
		font-size: 22rpx;
		line-height: 1.6;
		color: rgba(250, 252, 252, 0.82);
	}

	.prompt-list {
		display: flex;
		flex-wrap: wrap;
		gap: 12rpx;
	}

	.prompt-chip {
		min-height: 58rpx;
		padding: 0 18rpx;
		border-radius: 16rpx;
		border: 1px solid var(--line);
		background: var(--surface);
		display: flex;
		align-items: center;
		font-size: 22rpx;
		font-weight: 700;
		color: var(--ink2);
	}

	.prompt-chip.selected {
		background: var(--accent-bg);
		border-color: var(--accent);
		color: var(--accent2);
	}

	.prompt-preview {
		padding: 22rpx 24rpx;
		border-radius: 20rpx;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
		gap: 8rpx;
	}

	.prompt-preview-title {
		font-size: 20rpx;
		font-weight: 800;
		color: var(--accent2);
	}

	.prompt-preview-text {
		font-size: 24rpx;
		line-height: 1.6;
		color: var(--ink);
	}

	.ai-list {
		display: flex;
		flex-direction: column;
		gap: 16rpx;
	}

	.ai-item {
		display: flex;
		gap: 18rpx;
		padding: 24rpx;
		border-radius: 22rpx;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.ai-avatar {
		width: 124rpx;
		height: 156rpx;
		border-radius: 18rpx 30rpx 18rpx 18rpx;
		flex-shrink: 0;
	}

	.ai-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 10rpx;
		min-width: 0;
	}

	.ai-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10rpx;
	}

	.ai-name {
		font-size: 32rpx;
		line-height: 1.2;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
	}

	.ai-score {
		height: 42rpx;
		padding: 0 12rpx;
		border-radius: 999rpx;
		background: rgba(56, 152, 141, 0.12);
		color: var(--accent2);
		display: flex;
		align-items: center;
		font-size: 20rpx;
		font-weight: 800;
		flex-shrink: 0;
	}

	.ai-meta {
		font-size: 22rpx;
		line-height: 1.5;
		color: var(--muted);
	}

	.ai-copy {
		font-size: 22rpx;
		line-height: 1.6;
		color: var(--ink2);
	}

	.ai-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8rpx;
	}

	.ai-chat-page {
		display: flex;
		flex-direction: column;
		gap: 20rpx;
	}

	.ai-chat-nav {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 16rpx;
		padding: 4rpx 4rpx 0;
	}

	.ai-back {
		width: 64rpx;
		height: 64rpx;
		border-radius: 50%;
		background: var(--surface);
		border: 1px solid var(--line);
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: var(--shadow-sm);
		flex-shrink: 0;
	}

	.ai-back-chevron {
		width: 18rpx;
		height: 18rpx;
		border-left: 4rpx solid var(--ink);
		border-bottom: 4rpx solid var(--ink);
		transform: rotate(45deg);
		margin-left: 6rpx;
	}

	.ai-nav-title {
		flex: 1;
		min-width: 0;
		font-size: 34rpx;
		line-height: 1.2;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
		text-align: center;
	}

	.ai-clear {
		flex-shrink: 0;
		font-size: 22rpx;
		font-weight: 700;
		color: var(--accent2);
	}

	.ai-profile-card {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 18rpx;
		padding: 22rpx;
		border-radius: 24rpx;
		background: linear-gradient(135deg, rgba(195, 222, 218, 0.42), rgba(255, 255, 255, 0.96));
		box-shadow: var(--shadow-sm);
	}

	.ai-profile-avatar {
		width: 112rpx;
		height: 112rpx;
		border-radius: 24rpx;
		flex-shrink: 0;
		border: 4rpx solid rgba(255, 255, 255, 0.82);
	}

	.ai-profile-copy {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 6rpx;
	}

	.ai-profile-name {
		font-size: 30rpx;
		line-height: 1.2;
		font-family: var(--serif);
		font-weight: 700;
		color: var(--ink);
	}

	.ai-profile-subtitle {
		font-size: 21rpx;
		line-height: 1.5;
		color: var(--muted);
	}

	.ai-online {
		height: 44rpx;
		padding: 0 14rpx;
		border-radius: 999rpx;
		background: rgba(56, 152, 141, 0.12);
		color: var(--accent2);
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8rpx;
		font-size: 20rpx;
		font-weight: 700;
		flex-shrink: 0;
	}

	.ai-online-dot {
		width: 12rpx;
		height: 12rpx;
		border-radius: 50%;
		background: var(--sage);
	}

	.ai-message-list {
		display: flex;
		flex-direction: column;
		gap: 14rpx;
	}

	.ai-message {
		max-width: 86%;
		padding: 18rpx 20rpx;
		border-radius: 20rpx;
		font-size: 24rpx;
		line-height: 1.6;
		word-break: break-word;
	}

	.ai-message.assistant {
		align-self: flex-start;
		background: var(--surface);
		color: var(--ink2);
		box-shadow: var(--shadow-sm);
		border-bottom-left-radius: 8rpx;
	}

	.ai-message.assistant text {
		color: var(--ink2);
	}

	.ai-message.user {
		align-self: flex-end;
		background: var(--accent);
		color: var(--paper);
		border-bottom-right-radius: 8rpx;
		box-shadow: 0 8rpx 22rpx rgba(56, 152, 141, 0.18);
	}

	.ai-message.user text {
		color: var(--paper);
	}

	.quick-question-panel {
		display: flex;
		flex-direction: column;
		gap: 16rpx;
		padding: 24rpx 22rpx;
		border-radius: 24rpx;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	.quick-question-title {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 12rpx;
	}

	.quick-question-title view {
		flex: 1;
		height: 1px;
		background: var(--line);
	}

	.quick-question-title text {
		flex-shrink: 0;
		font-size: 21rpx;
		font-weight: 800;
		color: var(--accent2);
	}

	.quick-question-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 12rpx;
	}

	.quick-question {
		min-height: 58rpx;
		padding: 0 18rpx;
		border-radius: 16rpx;
		border: 1px solid var(--line);
		background: var(--paper);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 22rpx;
		font-weight: 700;
		color: var(--ink2);
	}

	.quick-question text,
	.ai-online text,
	.ai-send-button text {
		color: inherit;
	}

	.join-entry-row {
		display: flex;
		flex-direction: row;
		gap: 12rpx;
		padding: 2rpx 0;
	}

	.join-entry {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 9rpx;
		padding: 20rpx 8rpx 18rpx;
		border-radius: 20rpx;
		background: var(--match-paper);
		box-shadow: 0 7rpx 18rpx rgba(91, 175, 128, 0.07);
		border: 1px solid var(--match-line);
	}

	.join-entry-icon {
		width: 58rpx;
		height: 58rpx;
		border-radius: 18rpx;
		background: var(--match-mist);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 24rpx;
		font-weight: 800;
		color: var(--accent2);
	}

	.join-entry-icon.partner {
		background: #FFF5E7;
		color: #D9963A;
	}

	.join-entry-icon.promoter {
		background: var(--accent-bg);
		color: var(--accent2);
	}

	.join-entry-label {
		font-size: 20rpx;
		font-weight: 700;
		color: var(--match-deep);
		text-align: center;
		line-height: 1.35;
	}

	.custom-apply-safe {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
		background: rgba(250, 252, 252, 0.96);
		border-top: 1px solid var(--line);
		z-index: 30;
	}

	.custom-apply-button {
		height: 88rpx;
		border-radius: 20rpx;
		background: var(--accent);
		color: var(--paper);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28rpx;
		font-weight: 800;
		box-shadow: var(--shadow-md);
	}

	.custom-apply-button text {
		color: var(--paper);
	}

	.ai-input-safe {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx);
		background: rgba(250, 252, 252, 0.96);
		border-top: 1px solid var(--line);
		z-index: 30;
	}

