<template>
	<view class="edit-page">
		<!-- 导航栏 -->
		<view class="nav-bar">
			<text class="nav-title active">编辑资料</text>
			<text class="nav-title muted" @tap="onPreview">主页预览</text>
		</view>

		<!-- 滚动内容区 -->
		<scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="false">
			<!-- 资料完整度进度条 -->
			<view class="progress-section">
				<view class="progress-header">
					<text class="progress-label">资料完整度</text>
					<text class="progress-pct">{{ completeness }}%</text>
				</view>
				<view class="progress-bar-bg">
					<view class="progress-bar-fill" :style="{ width: completeness + '%' }"></view>
				</view>
				<text class="progress-hint">资料越完整，推荐权重越高，更容易遇见对的人</text>
			</view>

			<!-- 头像区 -->
			<view class="section-card">
				<view class="section-card-header">
					<text class="section-title">头像</text>
					<view class="change-bg-btn" @tap="changeBackground">
						<text class="change-bg-text">更换背景</text>
						<text class="change-bg-arrow">›</text>
					</view>
				</view>
				<view class="avatar-row">
					<view class="avatar-circle" @tap="chooseAvatar">
						<image class="avatar-img" :src="formData.avatar" mode="aspectFill"></image>
						<view class="camera-badge">
							<text class="camera-icon">📷</text>
						</view>
					</view>
					<view class="avatar-info">
						<text class="avatar-title">上传真实头像</text>
						<text class="avatar-desc">正面高清照，衣着得体，提高推荐排名</text>
					</view>
				</view>
				<text class="avatar-warning">⚠ 他人照片、看不清脸、P图过度、非人物照将无法通过审核</text>
			</view>

			<!-- 我的相册 -->
			<view class="section-card">
				<view class="card-header">
					<text class="section-title">我的相册</text>
					<text class="card-count">{{ formData.photos.length }}/9</text>
				</view>
				<view class="album-grid">
					<view class="album-cell" v-for="(photo, index) in formData.photos" :key="index">
						<image class="album-photo" :src="photo" mode="aspectFill"></image>
						<view class="album-delete" @tap="deletePhoto(index)">
							<text class="delete-icon">✕</text>
						</view>
					</view>
					<view class="album-cell add-cell" v-if="formData.photos.length < 9" @tap="addPhoto">
						<text class="add-icon">+</text>
					</view>
				</view>
			</view>

			<!-- 基础信息 - 预览卡（.pen: PNARb Profile Preview Card） -->
			<view class="section-card profile-preview-card">
				<view class="preview-card-header">
					<text class="section-title">基础信息</text>
					<view class="edit-badge" @tap="openBasicInfoEditor">
						<text class="edit-badge-text">编辑</text>
						<text class="edit-badge-arrow">›</text>
					</view>
				</view>
				<view class="preview-field-list">
					<view class="preview-field">
						<text class="preview-label">现居地</text>
						<text class="preview-value">{{ formData.location || '未填写' }}</text>
					</view>
					<view class="preview-field">
						<text class="preview-label">家乡</text>
						<text class="preview-value">{{ formData.hometown || '未填写' }}</text>
					</view>
					<view class="preview-field">
						<text class="preview-label">职业</text>
						<text class="preview-value">{{ formData.company ? formData.occupation + ' · ' + formData.company : formData.occupation || '未填写' }}</text>
					</view>
					<view class="preview-field">
						<text class="preview-label">收入</text>
						<text class="preview-value">{{ formData.income || '未填写' }}</text>
					</view>
					<view class="preview-field">
						<text class="preview-label">婚姻状况</text>
						<text class="preview-value">{{ formData.maritalStatus || '未填写' }}</text>
					</view>
					<view class="preview-field">
						<text class="preview-label">脱单目标</text>
						<text class="preview-value">{{ formData.goal || '未填写' }}</text>
					</view>
					<view class="preview-field">
						<text class="preview-label">微信号</text>
						<text class="preview-value muted">仅作为紧急联系</text>
					</view>
				</view>
			</view>

			<!-- 四重认证 -->
			<view class="section-card">
				<view class="card-header">
					<text class="section-title">四重认证</text>
					<text class="card-count accent">已完成 {{ completedCerts }}/4</text>
				</view>
				<view class="cert-item" v-for="cert in certs" :key="cert.label">
					<view class="cert-icon-wrap" :class="{ 'cert-done': cert.done }">
						<text class="cert-icon-text">{{ cert.icon }}</text>
					</view>
					<view class="cert-text-wrap">
						<text class="cert-label">{{ cert.label }}</text>
						<text class="cert-desc">{{ cert.desc }}</text>
					</view>
					<view v-if="cert.done" class="cert-check">
						<text class="check-icon">✓</text>
					</view>
					<view v-else class="cert-pending" @tap="goCertification(cert.key)">
						<text class="pending-text">去认证</text>
					</view>
				</view>
			</view>

			<!-- 自我介绍 -->
			<view class="section-card">
				<text class="section-title">自我介绍</text>
				<view class="intro-input-wrap">
					<textarea
						class="intro-textarea"
						:value="formData.introduction"
						placeholder="分享一下你的性格、爱好、生活态度...让TA更快了解你"
						maxlength="500"
						@input="onIntroInput"
					></textarea>
				</view>
				<text class="intro-hint">超有趣的自我介绍会被更多人看见哦！完成后建议搭配照片验证</text>
			</view>

			<!-- 兴趣标签 -->
			<view class="section-card tag-section">
				<text class="section-title">兴趣标签</text>
				<text class="tag-desc">选择或自定义最能代表你的标签（最多10个）</text>
				<view class="tag-row" v-for="(row, ri) in tagRows" :key="ri">
					<view
						class="tag-item"
						v-for="tag in row"
						:key="tag"
						:class="{ 'tag-selected': selectedTags.includes(tag) }"
						@tap="toggleTag(tag)"
					>
						<text class="tag-text">{{ tag }}</text>
					</view>
				</view>
				<view class="tag-add-btn" @tap="addCustomTag">
					<text class="tag-add-text">+添加</text>
				</view>
			</view>

			<!-- 关于我 - 问答 -->
			<view class="section-card">
				<text class="section-title">关于我</text>
				<text class="qa-section-desc">你的回答将展示在个人主页，帮助对方更深入了解你</text>
				<view class="qa-card" v-for="q in loveQuestions" :key="q.id" @tap="editQA(q)">
					<text class="qa-question">{{ q.question }}</text>
					<view class="qa-answer-row">
						<text class="qa-answer-hint" v-if="!q.answer">点击填写你的回答...</text>
						<text class="qa-answer-text" v-else>{{ q.answer }}</text>
						<text class="qa-edit-icon">✎</text>
					</view>
				</view>
			</view>

			<!-- 保存区域 -->
			<view class="save-section">
				<view class="save-buttons">
					<view class="cancel-btn" @tap="onCancel">
						<text class="cancel-text">取消</text>
					</view>
					<view class="save-btn" @tap="handleSave">
						<text class="save-text">保存</text>
					</view>
				</view>
				<text class="safe-note">你的信息将受到严格保护，仅用于平台匹配</text>
			</view>

			<!-- 底部留白 -->
			<view class="scroll-bottom-spacer"></view>
		</scroll-view>

		<!-- ==================== 基础信息详情编辑页（.pen: OzNuL Basic Info Section） ==================== -->
		<view class="basic-info-sheet" v-if="basicInfoEditVisible">
			<view class="sheet-mask" @tap="closeBasicInfoEditor"></view>
			<view class="sheet-panel">
				<!-- sheet 标题栏 -->
				<view class="sheet-header">
					<text class="sheet-back" @tap="closeBasicInfoEditor">取消</text>
					<text class="sheet-title">基础信息</text>
					<text class="sheet-done" @tap="closeBasicInfoEditor">完成</text>
				</view>

				<scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="false">
					<view class="form-card">
						<!-- 昵称 -->
						<view class="form-row" @tap="showFieldEditor('nickname')">
							<text class="form-label">昵称</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.nickname }">{{ formData.nickname || '请输入昵称' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 性别 -->
						<view class="form-row" @tap="showFieldEditor('gender')">
							<text class="form-label">性别</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.genderLabel }">{{ formData.genderLabel || '男' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 生日 -->
						<view class="form-row" @tap="showFieldEditor('birthday')">
							<text class="form-label">生日</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.birthday }">{{ formData.birthday || '请选择出生日期' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 身高 -->
						<view class="form-row" @tap="showFieldEditor('height')">
							<text class="form-label">身高</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.height }">{{ formData.height ? formData.height + ' cm' : '165 cm' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 体重 -->
						<view class="form-row" @tap="showFieldEditor('weight')">
							<text class="form-label">体重</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.weight }">{{ formData.weight ? formData.weight + ' kg' : '48 kg' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 现居地 -->
						<view class="form-row" @tap="showFieldEditor('location')">
							<text class="form-label">现居地</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.location }">{{ formData.location || '北京' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 家乡 -->
						<view class="form-row" @tap="showFieldEditor('hometown')">
							<text class="form-label">家乡</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.hometown }">{{ formData.hometown || '杭州' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 婚姻状况 -->
						<view class="form-row" @tap="showFieldEditor('maritalStatus')">
							<text class="form-label">婚姻状况</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.maritalStatus }">{{ formData.maritalStatus || '未婚' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 学历 -->
						<view class="form-row" @tap="showFieldEditor('education')">
							<text class="form-label">学历</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.education }">{{ formData.education || '本科 · 北京大学' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 职业 -->
						<view class="form-row" @tap="showFieldEditor('occupation')">
							<text class="form-label">职业</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.occupation }">{{ formData.occupation || '产品经理' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 公司 -->
						<view class="form-row" @tap="showFieldEditor('company')">
							<text class="form-label">公司</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.company }">{{ formData.company || '字节跳动' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 收入 -->
						<view class="form-row" @tap="showFieldEditor('income')">
							<text class="form-label">收入</text>
							<view class="form-right">
								<text class="form-value" :class="{ 'placeholder': !formData.income }">{{ formData.income || '30-50万' }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- MBTI -->
						<view class="form-row" @tap="openEmotionLab">
							<text class="form-label">MBTI</text>
							<view class="form-right">
								<view class="mbti-value-wrap">
									<text class="form-value" :class="{ 'placeholder': !formData.mbti }">{{ formData.mbti || '未设置' }}</text>
									<text v-if="mbtiSourceLabel.length > 0" class="field-source">{{ mbtiSourceLabel }}</text>
								</view>
								<text class="form-arrow">›</text>
							</view>
						</view>
						<view class="form-divider"></view>

						<!-- 微信号 -->
						<view class="form-row" @tap="showFieldEditor('wechat')">
							<text class="form-label">微信号</text>
							<view class="form-right">
								<text class="form-value placeholder" v-if="!formData.wechat">仅作为紧急联系</text>
								<text class="form-value" v-else>{{ formData.wechat }}</text>
								<text class="form-arrow">›</text>
							</view>
						</view>
					</view>

					<!-- 底部留白 -->
					<view class="sheet-bottom-spacer"></view>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { getEmotionLabSummary } from '@/api'

	// 表单数据
	const formData = ref({
		avatar: '/static/portraits/profile-woman-main.webp',
		coverBg: '/static/portraits/profile-woman-alt.webp',
		photos: [
			'/static/portraits/profile-woman-main.webp',
			'/static/portraits/profile-woman-alt.webp'
		] as string[],
		nickname: '苏晚晴',
		gender: 2,
		genderLabel: '女',
		birthday: '1998-05-15',
		height: 165,
		weight: 48,
		location: '北京',
		hometown: '杭州',
		education: '本科 · 北京大学',
		occupation: '产品经理',
		company: '字节跳动',
		income: '30-50万',
		maritalStatus: '未婚',
		mbti: '',
		goal: '希望在2年内遇到对的人',
		wechat: '',
		introduction: '',
		requirement: ''
	})

	// 基础信息编辑 sheet 可见性
	const basicInfoEditVisible = ref(false)
	const mbtiProfileSource = ref('')
	const mbtiSourceLabel = computed(() => {
		if (mbtiProfileSource.value == 'assessment') return '来自测试结果'
		if (mbtiProfileSource.value == 'self_reported') return '手动设置'
		return ''
	})

	const loadConfirmedMbti = async () => {
		try {
			const result = await getEmotionLabSummary()
			if (result == null || result.success != true || result.data == null) return
			const source = result.data.profileSource
			if (source == null || source.mbtiType == null) return
			const sourceType = source.source != null ? String(source.source) : ''
			if (sourceType != 'assessment' && sourceType != 'self_reported') return
			formData.value.mbti = String(source.mbtiType)
			mbtiProfileSource.value = sourceType
		} catch (error) {
			// Keep the existing profile value when the optional lab summary is unavailable.
		}
	}

	onShow(() => {
		loadConfirmedMbti()
	})

	// 资料完整度
	const completeness = computed(() => {
		let score = 0
		let total = 7
		if (formData.value.avatar) score++
		if (formData.value.photos.length >= 1) score++
		if (formData.value.location) score++
		if (formData.value.occupation) score++
		if (formData.value.introduction) score++
		if (selectedTags.value.length >= 3) score++
		if (loveQuestions.value.some(q => q.answer)) score++
		return Math.round((score / total) * 100)
	})

	// 认证数据
	const completedCerts = computed(() => certs.value.filter(c => c.done).length)
	const certs = ref([
		{ key: 'realname', label: '实名认证', desc: '已通过平台实名认证', icon: '🛡', done: true },
		{ key: 'education', label: '学历认证', desc: '学历信息已核验', icon: '🎓', done: true },
		{ key: 'avatar', label: '头像认证', desc: '上传真实本人照片', icon: '📷', done: false },
		{ key: 'marriage', label: '婚况认证', desc: '提交婚况证明材料', icon: '💍', done: false }
	])

	// 标签数据
	const allTags = [
		'文艺青年', '旅行达人', '美食控', '健身',
		'摄影', '音乐', '宠物', '户外',
		'游戏', '宅', '读书', '咖啡控'
	]
	const tagRows = computed(() => {
		const rows: string[][] = []
		for (let i = 0; i < allTags.length; i += 4) {
			rows.push(allTags.slice(i, i + 4))
		}
		return rows
	})
	const selectedTags = ref<string[]>([
		'旅行达人', '文艺青年', '健身', '摄影', '宠物'
	])

	const toggleTag = (tag: string) => {
		const idx = selectedTags.value.indexOf(tag)
		if (idx >= 0) {
			selectedTags.value.splice(idx, 1)
		} else if (selectedTags.value.length < 10) {
			selectedTags.value.push(tag)
		}
	}

	const addCustomTag = () => {
		uni.navigateTo({ url: '/pagesSub/userExtra/mytags/edit' })
	}

	// 关于我 问答
	const loveQuestions = ref([
		{ id: 1, question: '你理想中的另一半是什么样的', answer: '' },
		{ id: 2, question: '喜欢什么运动', answer: '' },
		{ id: 3, question: '你期待的爱情是什么样子的', answer: '' }
	])

	const editQA = (q: any) => {
		uni.showToast({ title: '问答编辑功能开发中', icon: 'none' })
	}

	// 更换背景
	const changeBackground = () => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				formData.value.coverBg = res.tempFilePaths[0]
				uni.showToast({ title: '背景已更换', icon: 'success' })
			}
		})
	}

	// 头像
	const chooseAvatar = () => {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				formData.value.avatar = res.tempFilePaths[0]
			}
		})
	}

	// 相册
	const addPhoto = () => {
		const remaining = 9 - formData.value.photos.length
		uni.chooseImage({
			count: remaining,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				formData.value.photos.push(...res.tempFilePaths)
			}
		})
	}

	const deletePhoto = (index: number) => {
		uni.showModal({
			title: '提示',
			content: '确定删除这张照片吗？',
			success: (res) => {
				if (res.confirm) {
					formData.value.photos.splice(index, 1)
				}
			}
		})
	}

	// 基础信息编辑器
	const openBasicInfoEditor = () => {
		basicInfoEditVisible.value = true
	}

	const closeBasicInfoEditor = () => {
		basicInfoEditVisible.value = false
	}

	// 字段编辑
	const showFieldEditor = (field: string) => {
		uni.showToast({ title: '选择器开发中', icon: 'none' })
	}

	const openEmotionLab = () => {
		basicInfoEditVisible.value = false
		uni.navigateTo({ url: '/pages/emotion-lab/emotion-lab' })
	}

	// 认证跳转
	const goCertification = (key: string) => {
		uni.navigateTo({ url: '/pages/profile/certification?type=' + key })
	}

	const onPreview = () => {
		uni.navigateTo({ url: '/pages/user/detail?own=true' })
	}

	const onCancel = () => {
		uni.navigateBack({ delta: 1 })
	}

	// 输入
	const onIntroInput = (e: InputEvent) => {
		formData.value.introduction = e.detail.value
	}

	// 保存
	const handleSave = () => {
		if (!formData.value.nickname) {
			uni.showToast({ title: '请输入昵称', icon: 'none' })
			return
		}
		if (formData.value.gender === 0) {
			uni.showToast({ title: '请选择性别', icon: 'none' })
			return
		}
		uni.showToast({ title: '保存成功', icon: 'success' })
		setTimeout(() => {
			uni.navigateBack()
		}, 1500)
	}
</script>

