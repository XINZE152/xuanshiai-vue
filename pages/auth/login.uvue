<template>
	<view class="login-page">
		<view class="login-orb orb-one"></view>
		<view class="login-orb orb-two"></view>

		<view class="brand-block">
			<view class="brand-mark">
				<image src="/static/logo.png" mode="aspectFit"></image>
			</view>
			<text class="brand-name text-serif">宣誓爱</text>
			<text class="brand-subtitle">认真认识一个人，慢慢走进一段关系</text>
		</view>

		<view class="login-card">
			<view class="card-heading">
				<text class="card-title">欢迎回来</text>
				<text class="card-copy">用手机号登录，继续你的认真相遇</text>
			</view>

			<view class="field-group">
				<text class="field-label">手机号</text>
				<view class="field-shell">
					<text class="field-prefix">+86</text>
					<input
						class="field-input"
						type="number"
						placeholder="请输入手机号"
						:value="phone"
						maxlength="11"
						@input="onPhoneInput"
					/>
				</view>
			</view>

			<view class="field-group code-group">
				<text class="field-label">验证码</text>
				<view class="field-shell">
					<input
						class="field-input"
						type="number"
						placeholder="请输入6位验证码"
						:value="code"
						maxlength="6"
						@input="onCodeInput"
					/>
					<button class="code-button" :disabled="codeButtonDisabled" @click="sendCode">
						{{ codeButtonText }}
					</button>
				</view>
			</view>

			<button class="login-button" :disabled="authLoading || !agreementChecked" @click="handlePhoneLogin">
				{{ authLoading ? '正在登录…' : '手机号验证码登录' }}
			</button>

			<!-- #ifdef MP-WEIXIN -->
			<button class="wechat-button" :disabled="authLoading || !agreementChecked" @click="handleWechatLogin">
				<text class="wechat-dot">W</text>
				<text>微信一键登录</text>
			</button>
			<!-- #endif -->

			<!-- #ifndef MP-WEIXIN -->
			<button class="phone-auth-button" :disabled="authLoading || !agreementChecked" @click="handleNonWechatLogin">
				手机号验证码登录
			</button>
			<!-- #endif -->

			<button class="demo-login-button" :disabled="authLoading || !agreementChecked" @click="handleDemoLogin">演示登录，选择身份</button>
			<button class="first-login-button" :disabled="authLoading || !agreementChecked" @click="handleFirstLogin">首次登录</button>
			<view class="agreement-row">
				<checkbox-group @change="handleAgreementChange">
					<label class="agreement-check">
						<checkbox value="agreed" :checked="agreementChecked" color="#38988D" />
						<text>我已阅读并同意</text>
					</label>
				</checkbox-group>
				<text class="agreement-link" @click="openAgreement('terms')">《用户协议》</text>
				<text class="agreement-copy">和</text>
				<text class="agreement-link" @click="openAgreement('privacy')">《隐私政策》</text>
			</view>
		</view>

		<view class="secondary-actions">
			<button class="debug-login-button" :disabled="authLoading || !agreementChecked" @click="handleDebugLogin(debugAccountPhones[0])">账号一 19730552884</button>
			<button class="debug-login-button" :disabled="authLoading || !agreementChecked" @click="handleDebugLogin(debugAccountPhones[1])">账号二 13000000000</button>
			<text class="secondary-divider">|</text>
			<text class="secondary-link" @click="handleFirstLogin">首次登录引导</text>
		</view>

		<view class="login-footer">
			<view class="footer-line"></view>
			<text class="footer-text">真实相遇，不负期待</text>
			<view class="footer-line"></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getProfileCompletion } from '@/api/auth.uts'
	import { loginByExistingAccount, loginByPhone, loginByWechat, sendSms } from '@/api'
	import { CURRENT_USER_ID_KEY, setAuthTokens } from '@/api/config.uts'

	const authLoading = ref(false)
	const agreementChecked = ref(uni.getStorageSync('xsa_login_agreed') == true)
	const phone = ref('')
	const code = ref('')
	const countdown = ref(0)
	const codeButtonDisabled = ref(false)
	const codeButtonText = ref('获取验证码')
	const debugAccountPhones = ['19730552884', '13000000000']
	const debugAccountPassword = 'password123'

	const goHome = () => {
		uni.setStorageSync('xsa_skip_welcome_once', true)
		uni.switchTab({ url: '/pages/index/index' })
	}

	const shouldStartOnboarding = async (data: any): Promise<boolean> => {
		if (data != null && data.need_bind_phone === true) return true
		const completion = await getProfileCompletion()
		if (!completion.success || completion.data == null) return false
		const score = completion.data.score != null ? Number(completion.data.score) : 100
		return score < 30
	}

	const routeAfterLogin = async (data: any = null, forceRoleSelection: boolean = false) => {
		if (forceRoleSelection) {
			uni.removeStorageSync('xsa_onboarding_mode')
			uni.removeStorageSync('xsa_onboarding_completed')
			uni.reLaunch({ url: '/pagesSub/userExtra/onboarding/profile' })
			return
		}
		const storedMode = uni.getStorageSync('xsa_onboarding_mode')
		if (storedMode != null && String(storedMode) == 'parent') {
			uni.reLaunch({ url: '/pages/parent/parent' })
			return
		}
		let needsOnboarding = false
		try {
			needsOnboarding = await shouldStartOnboarding(data)
		} catch (e) {
			needsOnboarding = data != null && data.need_bind_phone === true
		}
		if (needsOnboarding || uni.getStorageSync('xsa_onboarding_completed') != true) {
			uni.navigateTo({ url: '/pagesSub/userExtra/onboarding/profile' })
			return
		}
		goHome()
	}

	const finishLogin = async (data: any = null) => {
		uni.setStorageSync('xsa_login_agreed', true)
		if (data != null && data.user_id != null) uni.setStorageSync('xsa_user_id', data.user_id)
		uni.showToast({ title: '登录成功', icon: 'success' })
		setTimeout(() => {
			routeAfterLogin(data, false)
		}, 500)
	}

	const responseMessage = (res: any, fallback: string): string => {
		if (res != null && res.data != null && res.data.message != null) return '' + res.data.message
		if (res != null && res.message != null && res.message != '') return '' + res.message
		return fallback
	}

	const handleAgreementChange = (e: any) => {
		const values = e.detail != null && e.detail.value != null ? (e.detail.value as string[]) : []
		agreementChecked.value = values.indexOf('agreed') >= 0
	}

	const openAgreement = (type: string) => {
		const url = type == 'privacy' ? '/pagesSub/about/article?type=privacy' : '/pagesSub/about/article?type=terms'
		uni.navigateTo({ url })
	}

	const onPhoneInput = (e: any) => { phone.value = e.detail.value }
	const onCodeInput = (e: any) => { code.value = e.detail.value }

	const startCountdown = () => {
		codeButtonDisabled.value = true
		countdown.value = 60
		codeButtonText.value = '60秒后重试'
		const timer = setInterval(() => {
			countdown.value--
			if (countdown.value > 0) {
				codeButtonText.value = countdown.value + '秒后重试'
			} else {
				clearInterval(timer)
				codeButtonDisabled.value = false
				codeButtonText.value = '获取验证码'
			}
		}, 1000)
	}

	const sendCode = async () => {
		if (!/^1[3-9][0-9]{9}$/.test(phone.value)) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}
		try {
			const res = await sendSms(phone.value, 'login')
			if (!res.success) {
				uni.showToast({ title: responseMessage(res, '验证码发送失败'), icon: 'none' })
				return
			}
			startCountdown()
			uni.showToast({ title: responseMessage(res, '验证码已发送'), icon: 'success' })
		} catch (e) {
			uni.showToast({ title: '网络异常，请稍后重试', icon: 'none' })
		}
	}

	const handlePhoneLogin = async () => {
		if (authLoading.value) return
		if (!/^1[3-9][0-9]{9}$/.test(phone.value)) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}
		if (!/^[0-9]{6}$/.test(code.value)) {
			uni.showToast({ title: '请输入6位验证码', icon: 'none' })
			return
		}
		authLoading.value = true
		try {
			const res = await loginByPhone(phone.value, code.value)
			if (!res.success || res.data == null || res.data.access_token == null) {
				uni.showToast({ title: responseMessage(res, '登录失败，请重试'), icon: 'none' })
				return
			}
			await finishLogin(res.data)
		} catch (e) {
			uni.showToast({ title: '网络异常，请稍后重试', icon: 'none' })
		} finally {
			authLoading.value = false
		}
	}

	const getWechatLoginCode = (): Promise<string> => {
		return new Promise((resolve) => {
			uni.login({
				provider: 'weixin',
				success: (res: any) => resolve(res.code != null ? String(res.code) : ''),
				fail: (error: any) => { console.error('wechat login failed', error); resolve('') }
			})
		})
	}

	const handleWechatLogin = async () => {
		if (authLoading.value || !agreementChecked.value) return
		authLoading.value = true
		try {
			const codeValue = await getWechatLoginCode()
			if (codeValue == '') {
				uni.showToast({ title: '无法获取微信登录凭证', icon: 'none' })
				return
			}
			const res = await loginByWechat(codeValue)
			if (!res.success || res.data == null || res.data.access_token == null) {
				uni.showToast({ title: responseMessage(res, '微信登录失败，请重试'), icon: 'none' })
				return
			}
			await finishLogin(res.data)
		} catch (e) {
			uni.showToast({ title: '网络异常，请稍后重试', icon: 'none' })
		} finally {
			authLoading.value = false
		}
	}

	const handleNonWechatLogin = () => {
		if (!agreementChecked.value) return
		uni.navigateTo({ url: '/pages/auth/register' })
	}

	const startLocalDemoSession = (): boolean => {
		try {
			setAuthTokens('local_demo_access_token', 'local_demo_refresh_token')
			uni.setStorageSync(CURRENT_USER_ID_KEY, 1)
			uni.setStorageSync('xsa_login_agreed', true)
			return true
		} catch (error) {
			console.error('demo login session setup failed', error)
			return false
		}
	}

	const handleDemoLogin = async () => {
		if (authLoading.value || !agreementChecked.value) return
		authLoading.value = true
		try {
			if (!startLocalDemoSession()) {
				uni.showToast({ title: '演示登录失败，请重试', icon: 'none' })
				return
			}
			uni.showToast({ title: '登录成功，请选择身份', icon: 'success' })
			setTimeout(() => {
				routeAfterLogin(null, true)
			}, 300)
		} finally {
			authLoading.value = false
		}
	}

	const handleDebugLogin = async (debugPhone: string) => {
		if (authLoading.value || !agreementChecked.value) return
		authLoading.value = true
		try {
			const res = await loginByExistingAccount(debugPhone, debugAccountPassword)
			if (!res.success || res.data == null || res.data.access_token == null) {
				uni.showToast({ title: responseMessage(res, '调试账号登录失败，请检查后端账号'), icon: 'none' })
				return
			}
			await finishLogin(res.data)
		} catch (e) {
			uni.showToast({ title: '网络异常，请稍后重试', icon: 'none' })
		} finally {
			authLoading.value = false
		}
	}

	const handleFirstLogin = () => {
		if (!agreementChecked.value) return
		uni.navigateTo({ url: '/pages/auth/register' })
	}
</script>

<style scoped>
	.login-page { position: relative; min-height: 100vh; overflow: hidden; padding: 72px 22px calc(28px + env(safe-area-inset-bottom)); box-sizing: border-box; background: var(--canvas); color: var(--ink); }
	.login-orb { position: absolute; border-radius: 999px; opacity: .5; pointer-events: none; }
	.orb-one { width: 230px; height: 230px; top: -96px; right: -78px; background: var(--accent-bg); }
	.orb-two { width: 150px; height: 150px; bottom: 90px; left: -78px; background: var(--sage-soft); opacity: .35; }
	.brand-block { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; margin-bottom: 32px; }
	.brand-mark { width: 60px; height: 60px; padding: 8px; margin-bottom: 13px; box-sizing: border-box; border: 1px solid rgba(255,255,255,.8); border-radius: 20px; background: rgba(255,255,255,.78); box-shadow: var(--shadow-md); }
	.brand-mark image { width: 100%; height: 100%; }
	.brand-name { color: var(--accent2); font-size: 32px; font-weight: 800; line-height: 1.2; }
	.brand-subtitle { margin-top: 8px; color: var(--muted); font-size: 13px; }
	.login-card { position: relative; z-index: 1; width: 100%; max-width: 390px; padding: 26px 22px 20px; box-sizing: border-box; border: 1px solid rgba(211,217,216,.9); border-radius: 24px; background: rgba(255,255,255,.92); box-shadow: var(--shadow-lg); }
	.card-heading { display: flex; flex-direction: column; margin-bottom: 22px; }
	.card-title { color: var(--ink); font-size: 24px; font-weight: 800; line-height: 1.25; }
	.card-copy { margin-top: 6px; color: var(--muted); font-size: 13px; }
	.field-group { margin-top: 15px; }
	.field-label { display: block; margin-bottom: 8px; color: var(--ink2); font-size: 13px; font-weight: 700; }
	.field-shell { display: flex; flex-direction: row; align-items: center; min-height: 52px; padding: 0 12px; box-sizing: border-box; border: 1px solid var(--line); border-radius: 13px; background: var(--paper); }
	.field-shell:focus-within { border-color: var(--accent); background: var(--surface); }
	.field-prefix { padding-right: 12px; margin-right: 12px; border-right: 1px solid var(--line); color: var(--ink2); font-size: 14px; }
	.field-input { flex: 1; min-width: 0; height: 50px; color: var(--ink); font-size: 16px; }
	.code-button { flex-shrink: 0; width: 88px; height: 34px; padding: 0; border: 0; border-radius: 9px; background: var(--accent-bg); color: var(--accent2); font-size: 12px; line-height: 34px; }
	.code-button[disabled] { opacity: .55; }
	.login-button, .wechat-button { width: 100%; height: 50px; margin-top: 22px; border: 0; border-radius: 13px; font-size: 16px; font-weight: 800; line-height: 50px; }
	.login-button { background: var(--accent2); color: var(--text-invert); box-shadow: 0 7px 16px rgba(0,117,101,.18); }
	.login-button[disabled], .wechat-button[disabled] { opacity: .55; }
	.wechat-button { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8px; background: var(--surface); color: var(--accent2); border: 1px solid var(--accent-bg); }
	.wechat-dot { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: var(--sage); color: var(--text-invert); font-size: 12px; font-weight: 800; line-height: 22px; }
	.agreement-row { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: center; gap: 2px; margin-top: 18px; color: var(--muted); font-size: 11px; line-height: 1.7; }
	.agreement-check { display: flex; flex-direction: row; align-items: center; }
	.agreement-check checkbox { transform: scale(.72); }
	.agreement-link { color: var(--accent2); }
	.agreement-copy { color: var(--muted); }
	.secondary-actions { position: relative; z-index: 1; display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px; margin-top: 22px; }
	.demo-login-button { width: auto; min-width: 124px; height: 36px; margin: 0; padding: 0 10px; box-sizing: border-box; border: 1px solid var(--accent); border-radius: 18px; background: var(--surface); color: var(--accent2); font-size: 11px; font-weight: 700; line-height: 34px; box-shadow: var(--shadow-sm); }
	.demo-login-button:active { background: var(--accent-bg); }
	.demo-login-button[disabled] { opacity: .55; }
	.debug-login-button { width: auto; min-width: 124px; height: 36px; margin: 0; padding: 0 10px; box-sizing: border-box; border: 1px solid var(--accent); border-radius: 18px; background: var(--surface); color: var(--accent2); font-size: 11px; font-weight: 700; line-height: 34px; box-shadow: var(--shadow-sm); }
	.debug-login-button:active { background: var(--accent-bg); }
	.debug-login-button[disabled] { opacity: .55; }
	.secondary-divider { color: var(--line); font-size: 12px; }
	.secondary-link { color: var(--accent2); font-size: 12px; }
	.login-footer { position: relative; z-index: 1; display: flex; flex-direction: row; align-items: center; width: 100%; max-width: 390px; gap: 12px; margin-top: 38px; }
	.footer-line { flex: 1; height: 1px; background: var(--line); }
	.footer-text { flex-shrink: 0; color: var(--muted); font-size: 11px; }
</style>
